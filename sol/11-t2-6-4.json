[[{"n":"1","s":[["\\log_{a} \\frac{5}{6} = \\log_{a} 5 - \\log_{a} 6","قانون القسمة"],["\\approx 0.699 - 0.778 = -0.079","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\approx -0.079\"></span>","o":""},{"n":"2","s":[["\\frac{\\log_{a} 5}{\\log_{a} 6} \\approx \\frac{0.699}{0.778}","بالتعويض (لا يوجد قانون يبسّط قسمة لوغاريتمين هنا)"],["\\approx 0.898",""]],"a":"<span class=\"tx\" data-t=\"\\approx 0.898\"></span>","o":""},{"n":"3","s":[["\\log_{a} \\frac{1}{6} = \\log_{a} 1 - \\log_{a} 6","قانون القسمة"],["= 0 - 0.778 = -0.778","لأنّ <span class=\"tx\" data-t=\"\\log_a 1 = 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\approx -0.778\"></span>","o":""},{"n":"4","s":[["900 = 6^{2} \\times 5^{2}","تحليل <span class=m dir=ltr>900</span>"],["\\log_{a} 900 = 2\\log_{a} 6 + 2\\log_{a} 5","قانونا الضرب والقوة"],["\\approx 2(0.778) + 2(0.699) = 2.954","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.954\"></span>","o":""},{"n":"5","s":[["\\frac{18}{15} = \\frac{6}{5}","بالتبسيط"],["\\log_{a} \\frac{6}{5} = \\log_{a} 6 - \\log_{a} 5","قانون القسمة"],["\\approx 0.778 - 0.699 = 0.079","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.079\"></span>","o":""},{"n":"6","s":[["\\log_{a}(6a^{2}) = \\log_{a} 6 + 2\\log_{a} a","قانونا الضرب والقوة"],["\\approx 0.778 + 2(1) = 2.778","لأنّ <span class=\"tx\" data-t=\"\\log_a a = 1\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.778\"></span>","o":""},{"n":"7","s":[["\\sqrt[4]{25} = 25^{\\frac{1}{4}} = 5^{\\frac{1}{2}}","بكتابة الجذر على صورة أس"],["\\log_{a} 5^{\\frac{1}{2}} = \\frac{1}{2}\\log_{a} 5","قانون القوة"],["\\approx \\frac{1}{2}(0.699) = 0.3495","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.3495\"></span>","o":""},{"n":"8","s":[["(\\log_{a} 5)(\\log_{a} 6) \\approx (0.699)(0.778)","بالتعويض"],["\\approx 0.5438",""]],"a":"<span class=\"tx\" data-t=\"\\approx 0.544\"></span>","o":""}],[{"n":"9","s":[["\\log_{a} x^{2} = 2\\log_{a} x","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"2\\log_{a} x\"></span>","o":""},{"n":"10","s":[["\\log_{a}\\left(\\frac{a}{bc}\\right) = \\log_{a} a - \\log_{a}(bc)","قانون القسمة"],["= 1 - (\\log_{a} b + \\log_{a} c)","قانون الضرب، و <span class=\"tx\" data-t=\"\\log_a a = 1\"></span>"],["= 1 - \\log_{a} b - \\log_{a} c",""]],"a":"<span class=\"tx\" data-t=\"1 - \\log_{a} b - \\log_{a} c\"></span>","o":""},{"n":"11","s":[["\\log_{a}(\\sqrt{x}\\sqrt{y}) = \\log_{a} x^{\\frac{1}{2}} + \\log_{a} y^{\\frac{1}{2}}","قانون الضرب"],["= \\frac{1}{2}\\log_{a} x + \\frac{1}{2}\\log_{a} y","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\log_{a} x + \\frac{1}{2}\\log_{a} y\"></span>","o":""},{"n":"12","s":[["\\log_{a} \\frac{1}{x^{2}y^{2}} = \\log_{a} 1 - \\log_{a}(x^{2}y^{2})","قانون القسمة"],["= 0 - (2\\log_{a} x + 2\\log_{a} y)","قانونا الضرب والقوة"],["= -2\\log_{a} x - 2\\log_{a} y",""]],"a":"<span class=\"tx\" data-t=\"-2\\log_{a} x - 2\\log_{a} y\"></span>","o":""},{"n":"13","s":[["\\log_{a} \\sqrt[5]{32x^{5}} = \\frac{1}{5}\\log_{a}(32x^{5})","قانون القوة"],["= \\frac{1}{5}(\\log_{a} 32 + 5\\log_{a} x)","قانونا الضرب والقوة"],["= \\frac{1}{5}\\log_{a} 2^{5} + \\log_{a} x = \\log_{a} 2 + \\log_{a} x","لأنّ <span class=\"tx\" data-t=\"32 = 2^5\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\log_{a} 2 + \\log_{a} x\"></span>","o":""},{"n":"14","s":[["\\frac{(x^{2}y^{3})^{2}}{(x^{2}y^{3})^{3}} = (x^{2}y^{3})^{-1}","بقوانين الأسس"],["\\log_{a}(x^{2}y^{3})^{-1} = -(\\log_{a} x^{2} + \\log_{a} y^{3})","قانونا القوة والضرب"],["= -2\\log_{a} x - 3\\log_{a} y","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"-2\\log_{a} x - 3\\log_{a} y\"></span>","o":""},{"n":"15","s":[["\\log_{a}(x + y - z)^{7} = 7\\log_{a}(x + y - z)","قانون القوة (لا يمكن فكّ لوغاريتم المجموع)"]],"a":"<span class=\"tx\" data-t=\"7\\log_{a}(x + y - z)\"></span>","o":""},{"n":"16","s":[["\\sqrt{\\frac{x^{12}y}{y^{3}z^{4}}} = \\left(\\frac{x^{12}}{y^{2}z^{4}}\\right)^{\\frac{1}{2}}","بالتبسيط"],["= \\frac{1}{2}\\left(12\\log_{a} x - 2\\log_{a} y - 4\\log_{a} z\\right)","قوانين القوة والقسمة والضرب"],["= 6\\log_{a} x - \\log_{a} y - 2\\log_{a} z","بالتوزيع"]],"a":"<span class=\"tx\" data-t=\"6\\log_{a} x - \\log_{a} y - 2\\log_{a} z\"></span>","o":""}],[{"n":"17","s":[["\\log_{a} x + \\log_{a} y = \\log_{a}(xy)","قانون الضرب"]],"a":"<span class=\"tx\" data-t=\"\\log_{a}(xy)\"></span>","o":""},{"n":"18","s":[["\\log_{b}(x + y) - \\log_{b}(x - y) = \\log_{b} \\frac{x + y}{x - y}","قانون القسمة"]],"a":"<span class=\"tx\" data-t=\"\\log_{b} \\frac{x + y}{x - y}\"></span>","o":""},{"n":"19","s":[["\\log_{a} \\frac{1}{\\sqrt{x}} - \\log_{a} \\sqrt{x} = \\log_{a} \\frac{\\frac{1}{\\sqrt{x}}}{\\sqrt{x}}","قانون القسمة"],["= \\log_{a} \\frac{1}{x}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\log_{a} \\frac{1}{x}\"></span> (أو <span class=\"tx\" data-t=\"-\\log_{a} x\"></span>)","o":""},{"n":"20","s":[["\\log_{a}(x^{2} - 4) - \\log_{a}(x + 2) = \\log_{a} \\frac{x^{2} - 4}{x + 2}","قانون القسمة"],["= \\log_{a} \\frac{(x - 2)(x + 2)}{x + 2} = \\log_{a}(x - 2)","بتحليل فرق مربعين والاختصار"]],"a":"<span class=\"tx\" data-t=\"\\log_{a}(x - 2)\"></span>","o":""},{"n":"21","s":[["= \\log_{b} x^{2} - \\log_{b} y^{3} + \\log_{b} z^{\\frac{1}{3}}","قانون القوة"],["= \\log_{b} \\frac{x^{2}\\sqrt[3]{z}}{y^{3}}","قانونا الضرب والقسمة"]],"a":"<span class=\"tx\" data-t=\"\\log_{b} \\frac{x^{2}\\sqrt[3]{z}}{y^{3}}\"></span>","o":""},{"n":"22","s":[["\\log_{b} 1 + 2\\log_{b} b = \\log_{b}(1 \\cdot b^{2})","قانونا القوة والضرب"],["= \\log_{b} b^{2} = 2","خاصية: <span class=\"tx\" data-t=\"\\log_b b^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\log_{b} b^{2} = 2\"></span>","o":""}],[{"n":"23","s":[["f(10) = 29 + 48.8\\log_{6}(10 + 2) = 29 + 48.8\\log_{6} 12","بالتعويض <span class=m dir=ltr>x = 10</span>"],["\\log_{6} 12 = \\log_{6}(6 \\times 2) = \\log_{6} 6 + \\log_{6} 2","قانون الضرب"],["\\approx 1 + 0.3869 = 1.3869","بالتعويض"],["f(10) \\approx 29 + 48.8(1.3869) \\approx 96.68",""]],"a":"النسبة المئوية <span class=\"tx\" data-t=\"\\approx 96.68\\%\"></span>","o":""}],[{"n":"24","s":[["216 = 6^{3},\\quad 36 = 6^{2}","بكتابة العددين قوى للعدد <span class=m dir=ltr>6</span>"],["\\frac{\\log_{a} 216}{\\log_{a} 36} = \\frac{\\log_{a} 6^{3}}{\\log_{a} 6^{2}}","بالتعويض"],["= \\frac{3\\log_{a} 6}{2\\log_{a} 6}","قانون القوة"],["= \\frac{3}{2}","باختصار <span class=\"tx\" data-t=\"\\log_a 6 \\ne 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{\\log_{a} 216}{\\log_{a} 36} = \\frac{3}{2}\"></span> وهو المطلوب","o":""}],[{"n":"25","s":[["\\log_{2} 5x \\ne (\\log_{2} 5)(\\log_{2} x)","الخطأ: جعل لوغاريتم حاصل الضرب حاصل ضرب لوغاريتمين"],["\\log_{2} 5x = \\log_{2} 5 + \\log_{2} x","التصحيح: قانون الضرب (لوغاريتم الضرب <span class=m dir=ltr>=</span> مجموع اللوغاريتمات)"]],"a":"<span class=\"tx\" data-t=\"\\log_{2} 5x = \\log_{2} 5 + \\log_{2} x\"></span>","o":""}],[{"n":"26","s":[["= \\log_{b} \\frac{(b - 3)(b^{2} + 3b)}{b^{2} - 9}","قانونا الضرب والقسمة"],["= \\log_{b} \\frac{(b - 3) \\cdot b(b + 3)}{(b - 3)(b + 3)}","بالتحليل"],["= \\log_{b} b = 1","بالاختصار، و <span class=\"tx\" data-t=\"\\log_b b = 1\"></span>"]],"a":"المقدار يساوي <span class=\"tx\" data-t=\"1\"></span> وهو المطلوب","o":"الشرط <span class=\"tx\" data-t=\"b &gt; 3\"></span> يضمن أنّ <span class=\"tx\" data-t=\"b - 3 &gt; 0\"></span> و <span class=\"tx\" data-t=\"b^2 - 9 &gt; 0\"></span>، فتكون جميع اللوغاريتمات معرّفة."}],[{"n":"3","s":[["\\log (0.1)^2 = \\log 0.01","<span class=\"tx\" data-t=\"(0.1)^2 = 0.01\"></span>"],["= \\log 10^{-2} = -2","خاصية <span class=\"tx\" data-t=\"\\log 10^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"-2\"></span>، الإجابة <span class=m dir=ltr>a</span>","o":""}],[{"n":"4","s":[["\\log_a 27 - \\log_a 9 + \\log_a 3 = \\log_a \\frac{27 \\times 3}{9}","قانونا القسمة والضرب"],["= \\log_a 9","<span class=\"tx\" data-t=\"\\frac{81}{9} = 9\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\log_a 9\"></span>، الإجابة <span class=m dir=ltr>c</span>","o":""}],[{"n":"5","s":[["\\log_a \\frac{a x^5}{y^3} = \\log_a a + \\log_a x^5 - \\log_a y^3","قانونا الضرب والقسمة"],["= 1 + 5\\log_a x - 3\\log_a y","قانون القوة و <span class=\"tx\" data-t=\"\\log_a a = 1\"></span>"]],"a":"<span class=\"tx\" data-t=\"5\\log_a x - 3\\log_a y + 1\"></span>، الإجابة <span class=m dir=ltr>a</span>","o":""}],[{"n":"10","s":[["\\log_5 16 = \\log_5 4^2","<span class=\"tx\" data-t=\"16 = 4^2\"></span>"],["= 2\\log_5 4 = 2k","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"\\log_5 16 = 2k\"></span>","o":""},{"n":"11","s":[["\\log_5 256 = \\log_5 4^4","<span class=\"tx\" data-t=\"256 = 4^4\"></span>"],["= 4\\log_5 4 = 4k","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"\\log_5 256 = 4k\"></span>","o":""}],[{"n":"1","s":[["\\log_a \\frac{3}{7} = \\log_a 3 - \\log_a 7 \\approx 0.528 - 0.936","قانون القسمة"]],"a":"<span class=\"tx\" data-t=\"\\approx -0.408\"></span>","o":""},{"n":"2","s":[["\\log_a 21 = \\log_a 3 + \\log_a 7 \\approx 0.528 + 0.936","قانون الضرب"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.464\"></span>","o":""},{"n":"3","s":[["\\frac{\\log_a 3}{\\log_a 7} \\approx \\frac{0.528}{0.936}","بالتعويض مباشرة"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.564\"></span>","o":""},{"n":"4","s":[["\\log_a \\frac{1}{7} = \\log_a 7^{-1} = -\\log_a 7","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"\\approx -0.936\"></span>","o":""},{"n":"5","s":[["\\log_a 441 = \\log_a 21^2 = 2(\\log_a 3 + \\log_a 7)","<span class=\"tx\" data-t=\"441 = 21^2 = 3^2 \\times 7^2\"></span>"],["\\approx 2(1.464)",""]],"a":"<span class=\"tx\" data-t=\"\\approx 2.928\"></span>","o":""},{"n":"6","s":[["\\log_a \\frac{49}{27} = 2\\log_a 7 - 3\\log_a 3","<span class=\"tx\" data-t=\"49 = 7^2,\\ 27 = 3^3\"></span> وقانونا القسمة والقوة"],["\\approx 2(0.936) - 3(0.528) = 1.872 - 1.584",""]],"a":"<span class=\"tx\" data-t=\"\\approx 0.288\"></span>","o":""},{"n":"7","s":[["\\log_a (7a^2) = \\log_a 7 + 2\\log_a a \\approx 0.936 + 2","قانونا الضرب والقوة و <span class=\"tx\" data-t=\"\\log_a a = 1\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.936\"></span>","o":""},{"n":"8","s":[["\\log_a \\sqrt[4]{81} = \\log_a 3","<span class=\"tx\" data-t=\"\\sqrt[4]{81} = 3\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.528\"></span>","o":""},{"n":"9","s":[["(\\log_a 3)(\\log_a 7) \\approx 0.528 \\times 0.936","بالتعويض مباشرة"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.494\"></span>","o":""}],[{"n":"10","s":[["\\log_a x^7 = 7\\log_a x","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"7\\log_a x\"></span>","o":""},{"n":"11","s":[["\\log_a \\frac{ac}{b} = \\log_a a + \\log_a c - \\log_a b","قانونا الضرب والقسمة"]],"a":"<span class=\"tx\" data-t=\"1 + \\log_a c - \\log_a b\"></span>","o":""},{"n":"12","s":[["\\log_a \\sqrt{x} = \\log_a x^{\\frac{1}{2}} = \\frac{1}{2}\\log_a x","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\log_a x\"></span>","o":""},{"n":"13","s":[["\\log_a \\frac{\\sqrt{xy}}{z} = \\log_a (xy)^{\\frac{1}{2}} - \\log_a z","قانون القسمة"],["= \\frac{1}{2}\\log_a x + \\frac{1}{2}\\log_a y - \\log_a z","قانونا القوة والضرب"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\log_a x + \\frac{1}{2}\\log_a y - \\log_a z\"></span>","o":""},{"n":"14","s":[["\\log_a \\frac{1}{x^3 y^4} = \\log_a 1 - \\log_a x^3 - \\log_a y^4","قانونا القسمة والضرب"],["= -3\\log_a x - 4\\log_a y","<span class=\"tx\" data-t=\"\\log_a 1 = 0\"></span> وقانون القوة"]],"a":"<span class=\"tx\" data-t=\"-3\\log_a x - 4\\log_a y\"></span>","o":""},{"n":"15","s":[["\\sqrt[7]{128x^7} = (2^7 x^7)^{\\frac{1}{7}} = 2x","<span class=\"tx\" data-t=\"128 = 2^7\"></span>"],["\\log_a 2x = \\log_a 2 + \\log_a x","قانون الضرب"]],"a":"<span class=\"tx\" data-t=\"\\log_a 2 + \\log_a x\"></span>","o":""},{"n":"16","s":[["\\frac{(x^{-1}y^2)^4}{(x^5 y^{-2})^3} = \\frac{x^{-4}y^{8}}{x^{15}y^{-6}} = x^{-19}y^{14}","بقوانين الأسس"],["\\log_a x^{-19}y^{14} = -19\\log_a x + 14\\log_a y","قانونا الضرب والقوة"]],"a":"<span class=\"tx\" data-t=\"-19\\log_a x + 14\\log_a y\"></span>","o":""},{"n":"17","s":[["\\log_a \\left(\\frac{x^2y^3}{z^3}\\right)^{\\frac{1}{2}} = \\frac{1}{2}\\left(2\\log_a x + 3\\log_a y - 3\\log_a z\\right)","قوانين القوة والضرب والقسمة"],["= \\log_a x + \\frac{3}{2}\\log_a y - \\frac{3}{2}\\log_a z","بالتوزيع"]],"a":"<span class=\"tx\" data-t=\"\\log_a x + \\frac{3}{2}\\log_a y - \\frac{3}{2}\\log_a z\"></span>","o":""},{"n":"18","s":[["y - x < z \\Rightarrow x - y + z > 0","المقدار داخل اللوغاريتم موجب"],["\\log_a (x - y + z)^9 = 9\\log_a (x - y + z)","قانون القوة"]],"a":"<span class=\"tx\" data-t=\"9\\log_a (x - y + z)\"></span>","o":"لا يوجد قانون لتجزئة لوغاريتم المجموع أو الفرق."}],[{"n":"19","s":[["\\log_a x - \\log_a y = \\log_a \\frac{x}{y}","قانون القسمة"]],"a":"<span class=\"tx\" data-t=\"\\log_a \\frac{x}{y}\"></span>","o":""},{"n":"20","s":[["\\log_b (b-1) + \\log_b b^2","قانون القوة"],["= \\log_b b^2(b-1) = \\log_b (b^3 - b^2)","قانون الضرب"]],"a":"<span class=\"tx\" data-t=\"\\log_b (b^3 - b^2)\"></span>","o":""},{"n":"21","s":[["\\log_a \\sqrt{x} - \\log_a \\frac{1}{\\sqrt{x}} = \\log_a \\frac{\\sqrt{x}}{\\frac{1}{\\sqrt{x}}}","قانون القسمة"],["= \\log_a x","<span class=\"tx\" data-t=\"\\sqrt{x} \\times \\sqrt{x} = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\log_a x\"></span>","o":""},{"n":"22","s":[["\\log_a \\frac{x^2 - 25}{x + 5} = \\log_a \\frac{(x-5)(x+5)}{x+5}","قانون القسمة وتحليل الفرق بين مربعين"],["= \\log_a (x - 5)","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"\\log_a (x - 5)\"></span>","o":""},{"n":"23","s":[["3\\log_b 1 - \\log_b b = 3(0) - 1","<span class=\"tx\" data-t=\"\\log_b 1 = 0,\\ \\log_b b = 1\"></span>"],["= -1 = \\log_b \\frac{1}{b}",""]],"a":"<span class=\"tx\" data-t=\"\\log_b \\frac{1}{b} = -1\"></span>","o":""},{"n":"24","s":[["\\log_b x^8 + \\log_b y^4 - \\log_b z^{\\frac{1}{2}}","قانون القوة"],["= \\log_b \\frac{x^8 y^4}{\\sqrt{z}}","قانونا الضرب والقسمة"]],"a":"<span class=\"tx\" data-t=\"\\log_b \\frac{x^8 y^4}{\\sqrt{z}}\"></span>","o":""}],[{"n":"25","s":[["T(11) = 10 + 20\\log_6 (11 + 1) = 10 + 20\\log_6 12","بتعويض <span class=\"tx\" data-t=\"a = 11\"></span>"],["\\log_6 12 = \\log_6 6 + \\log_6 2 \\approx 1 + 0.3869 = 1.3869","قانون الضرب"],["T(11) \\approx 10 + 20(1.3869) = 37.738",""]],"a":"الإيرادات <span class=\"tx\" data-t=\"\\approx 37.738\"></span> ألف دينار، أي <span class=\"tx\" data-t=\"37738\"></span> <span class=m dir=ltr>JD</span> تقريبًا","o":""}]]