[[{"n":"1","s":[["\\vec{a}\\cdot\\vec{b}=v_1w_1+v_2w_2","صيغة الضرب القياسي"],["=6\\times4+8\\times(-3)","بالتعويض"],["=24-24=0","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{b}=0\"></span>","o":""},{"n":"2","s":[["\\vec{u}\\cdot\\vec{v}=u_1v_1+u_2v_2","صيغة الضرب القياسي"],["=(-3)(-9)+11\\times4","بالتعويض"],["=27+44=71","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{u}\\cdot\\vec{v}=71\"></span>","o":""},{"n":"3","s":[["\\vec{c}\\cdot\\vec{v}=c_1v_1+c_2v_2","صيغة الضرب القياسي"],["=(-12)(22)+43\\times14","بالتعويض"],["=-264+602=338","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{c}\\cdot\\vec{v}=338\"></span>","o":""},{"n":"4","s":[["\\vec{d}\\cdot\\vec{e}=d_1e_1+d_2e_2","صيغة الضرب القياسي"],["=21(-21)+32\\times25","بالتعويض"],["=-441+800=359","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{d}\\cdot\\vec{e}=359\"></span>","o":""}],[{"n":"5","s":[["\\vec{a}\\cdot\\vec{b}=|\\vec{a}||\\vec{b}|\\cos\\theta","الضرب القياسي بدلالة الزاوية"],["=9\\times6\\times\\cos42^\\circ","بالتعويض"],["=54\\times0.7431\\approx 40.13","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{b}\\approx 40.13\"></span>","o":""}],[{"n":"6","s":[["\\vec{a}\\cdot\\vec{b}=|\\vec{a}||\\vec{b}|\\cos\\theta","الضرب القياسي بدلالة الزاوية"],["=34\\times76\\times\\cos120^\\circ","بالتعويض"],["=2584\\times\\left(-\\frac{1}{2}\\right)=-1292","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{b}=-1292\"></span>","o":""}],[{"n":"7","s":[["\\vec{a}\\cdot\\vec{b}=7\\times4+10\\times(-10)=28-100=-72","صيغة الضرب القياسي"],["|\\vec{a}|=\\sqrt{49+100}=\\sqrt{149},\\quad |\\vec{b}|=\\sqrt{16+100}=\\sqrt{116}","صيغة مقدار المتجه"],["\\cos\\theta=\\frac{\\vec{a}\\cdot\\vec{b}}{|\\vec{a}||\\vec{b}|}=\\frac{-72}{\\sqrt{149}\\sqrt{116}}\\approx-0.5477","بالتعويض"],["\\theta=\\cos^{-1}(-0.5477)\\approx 123.2^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\theta\\approx 123.2^\\circ\"></span>","o":""}],[{"n":"8","s":[["\\vec{c}\\cdot\\vec{d}=2(-24)+4\\times12=-48+48=0","صيغة الضرب القياسي"],["\\cos\\theta=\\frac{0}{|\\vec{c}||\\vec{d}|}=0","بالتعويض"],["\\theta=\\cos^{-1}(0)=90^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\vec{c}\\cdot\\vec{d}=0\"></span> ، <span class=\"tx\" data-t=\"\\theta=90^\\circ\"></span> (المتجهان متعامدان)","o":""},{"n":"9","s":[["\\vec{a}\\cdot\\vec{k}=4\\times8+16(-2)=32-32=0","صيغة الضرب القياسي"],["\\cos\\theta=\\frac{0}{|\\vec{a}||\\vec{k}|}=0","بالتعويض"],["\\theta=\\cos^{-1}(0)=90^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{k}=0\"></span> ، <span class=\"tx\" data-t=\"\\theta=90^\\circ\"></span> (المتجهان متعامدان)","o":""}],[{"n":"10","s":[["\\vec{e}\\cdot\\vec{a}=3\\times11+4\\times(-8)","صيغة الضرب القياسي"],["=33-32=1\\ne0","بالتبسيط"]],"a":"المتجهان غير متعامدين؛ لأن ناتج ضربهما القياسي <span class=\"tx\" data-t=\"1\\ne0\"></span>","o":""}],[{"n":"11","s":[["\\vec{r}\\cdot\\vec{s}=0","المتجهان المتعامدان ضربهما القياسي صفر"],["3b+(-4)(b+2)=0","صيغة الضرب القياسي"],["3b-4b-8=0\\ \\Rightarrow\\ -b=8","بالتبسيط"],["b=-8","بقسمة الطرفين على <span class=m dir=ltr>−1</span>"]],"a":"<span class=\"tx\" data-t=\"b=-8\"></span>","o":"تحقق: <span class=\"tx\" data-t=\"\\vec{s}=\\langle -8,-6\\rangle\"></span> و <span class=\"tx\" data-t=\"3(-8)+(-4)(-6)=-24+24=0\"></span>"}],[{"n":"12","s":[["W=|\\vec{F}||\\vec{d}|\\cos\\theta","الشغل <span class=m dir=ltr>=</span> الضرب القياسي للقوة والإزاحة"],["46=34\\times12\\times\\cos\\theta","بالتعويض"],["\\cos\\theta=\\frac{46}{408}\\approx 0.1127","بقسمة الطرفين على <span class=m dir=ltr>408</span>"],["\\theta=\\cos^{-1}(0.1127)\\approx 83.5^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\theta\\approx 83.5^\\circ\"></span>","o":"بالتعويض المباشر بالأعداد كما في أمثلة الكتاب؛ أما إذا حُوِّلت المسافة إلى أمتار <span class=m dir=ltr>(12000 m)</span> فإن <span class=\"tx\" data-t=\"\\cos\\theta\\approx0.0001\"></span> و <span class=\"tx\" data-t=\"\\theta\\approx 90^\\circ\"></span>"}],[{"n":"13","s":[["\\theta=180^\\circ-60^\\circ=120^\\circ","<span class=m dir=ltr>a</span> و <span class=m dir=ltr>c</span> على استقامة واحدة، فالزاوية بين <span class=m dir=ltr>a</span> و <span class=m dir=ltr>b</span> مكملة لـ <span class=m dir=ltr>60°</span>"],["\\vec{a}\\cdot\\vec{b}=|\\vec{a}||\\vec{b}|\\cos\\theta=2\\times4\\times\\cos120^\\circ","بالتعويض"],["=8\\times\\left(-\\frac{1}{2}\\right)=-4","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{b}=-4\"></span>","o":""},{"n":"14","s":[["\\vec{b}\\cdot\\vec{c}=|\\vec{b}||\\vec{c}|\\cos60^\\circ","الزاوية بين <span class=m dir=ltr>b</span> و <span class=m dir=ltr>c</span> هي <span class=m dir=ltr>60°</span>"],["=4\\times5\\times\\frac{1}{2}=10","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{b}\\cdot\\vec{c}=10\"></span>","o":""},{"n":"15","s":[["\\theta=180^\\circ","<span class=m dir=ltr>a</span> و <span class=m dir=ltr>c</span> في اتجاهين متعاكسين على المستقيم نفسه"],["\\vec{a}\\cdot\\vec{c}=2\\times5\\times\\cos180^\\circ=10\\times(-1)=-10","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\cdot\\vec{c}=-10\"></span>","o":""}],[{"n":"16","s":[["W=|\\vec{F}||\\vec{d}|\\cos\\theta","مسألة اليوم: <span class=m dir=ltr>F = 70 N</span> ، <span class=m dir=ltr>d = 18 m</span> ، θ <span class=m dir=ltr>= 54°</span>"],["W=70\\times18\\times\\cos54^\\circ","بالتعويض"],["=1260\\times0.5878\\approx 740.6","باستعمال الآلة الحاسبة"]],"a":"الشغل <span class=\"tx\" data-t=\"W\\approx 740.6\"></span> <span class=m dir=ltr>J</span>","o":""}],[{"n":"17","s":[["\\vec{a}=\\langle a_1,a_2\\rangle,\\ \\vec{b}=\\langle b_1,b_2\\rangle","ليكن المتجهان بالصورة الإحداثية"],["\\vec{a}\\bullet\\vec{b}=a_1b_1+a_2b_2","تعريف الضرب القياسي"],["=b_1a_1+b_2a_2","خاصية الإبدال لضرب الأعداد الحقيقية"],["=\\vec{b}\\bullet\\vec{a}","تعريف الضرب القياسي"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\bullet\\vec{b}=\\vec{b}\\bullet\\vec{a}\"></span> (خاصية الإبدال)","o":""},{"n":"18","s":[["\\vec{b}+\\vec{c}=\\langle b_1+c_1,\\ b_2+c_2\\rangle","حيث <span class=\"tx\" data-t=\"\\vec{c}=\\langle c_1,c_2\\rangle\"></span>، جمع المتجهات"],["\\vec{a}\\bullet(\\vec{b}+\\vec{c})=a_1(b_1+c_1)+a_2(b_2+c_2)","تعريف الضرب القياسي"],["=a_1b_1+a_1c_1+a_2b_2+a_2c_2","خاصية التوزيع للأعداد الحقيقية"],["=(a_1b_1+a_2b_2)+(a_1c_1+a_2c_2)","بإعادة الترتيب والتجميع"],["=\\vec{a}\\bullet\\vec{b}+\\vec{a}\\bullet\\vec{c}","تعريف الضرب القياسي"]],"a":"<span class=\"tx\" data-t=\"\\vec{a}\\bullet(\\vec{b}+\\vec{c})=\\vec{a}\\bullet\\vec{b}+\\vec{a}\\bullet\\vec{c}\"></span> (خاصية التوزيع)","o":""},{"n":"19","s":[["\\vec{0}=\\langle 0,0\\rangle","المتجه الصفري"],["\\vec{0}\\bullet\\vec{a}=0\\times a_1+0\\times a_2","تعريف الضرب القياسي"],["=0+0=0",""]],"a":"<span class=\"tx\" data-t=\"\\vec{0}\\bullet\\vec{a}=0\"></span>","o":""}],[{"n":"20","s":[["\\vec{p}=\\langle x,y\\rangle,\\ \\ \\vec{p}\\bullet\\vec{q}=6x+2y=30","نفرض المتجه ونطبّق تعريف الضرب القياسي"],["x=5,\\ y=0","نختار قيمتين تحققان المعادلة"],["\\langle 5,0\\rangle\\bullet\\langle 6,2\\rangle=30+0=30","تحقق"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\vec{p}=\\langle 5,0\\rangle\"></span> (وأيضًا <span class=\"tx\" data-t=\"\\langle 3,6\\rangle\"></span> أو أي <span class=\"tx\" data-t=\"\\langle x,y\\rangle\"></span> يحقق <span class=\"tx\" data-t=\"6x+2y=30\"></span>)","o":""}],[{"n":"21","s":[["\\vec{v}=\\langle x,y\\rangle,\\ \\ \\vec{a}\\bullet\\vec{v}=-8x-2y=0","المتجهان متعامدان إذا كان ضربهما القياسي صفرًا"],["y=-4x","بحل المعادلة"],["x=1\\Rightarrow \\vec{v}=\\langle 1,-4\\rangle","نختار <span class=\"tx\" data-t=\"x=1\"></span>"],["\\langle -8,-2\\rangle\\bullet\\langle 1,-4\\rangle=-8+8=0","تحقق"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\langle 1,-4\\rangle\"></span> (أو أي مضاعف له مثل <span class=\"tx\" data-t=\"\\langle -1,4\\rangle\"></span>)","o":""}],[{"n":"22","s":[["A(-4,-2),\\ B(1,5),\\ C(6,-2)","نسمّي الرؤوس"],["\\overrightarrow{AB}=\\langle 5,7\\rangle,\\ \\overrightarrow{BC}=\\langle 5,-7\\rangle,\\ \\overrightarrow{AC}=\\langle 10,0\\rangle","طرح إحداثيات البداية من النهاية"],["|\\overrightarrow{AB}|=\\sqrt{25+49}=\\sqrt{74},\\ |\\overrightarrow{BC}|=\\sqrt{74},\\ |\\overrightarrow{AC}|=10","مقدار المتجه؛ <span class=\"tx\" data-t=\"AB=BC\"></span> إذن المثلث متطابق الضلعين"],["\\cos A=\\frac{\\overrightarrow{AB}\\bullet\\overrightarrow{AC}}{|\\overrightarrow{AB}||\\overrightarrow{AC}|}=\\frac{50}{10\\sqrt{74}}\\approx 0.5812\\Rightarrow \\angle A\\approx 54.5^\\circ","الزاوية بين متجهين"],["\\angle C=\\angle A\\approx 54.5^\\circ","زاويتا القاعدة في المثلث متطابق الضلعين متطابقتان"],["\\angle B=180^\\circ-2(54.46^\\circ)\\approx 71.1^\\circ","مجموع زوايا المثلث <span class=\"tx\" data-t=\"180^\\circ\"></span>"]],"a":"المثلث متطابق الضلعين لأن <span class=\"tx\" data-t=\"AB=BC=\\sqrt{74}\"></span>؛ وزواياه: <span class=\"tx\" data-t=\"\\angle A=\\angle C\\approx 54.5^\\circ\"></span>، <span class=\"tx\" data-t=\"\\angle B\\approx 71.1^\\circ\"></span>","o":""}],[{"n":"23","s":[["\\vec{a}=k\\vec{b}","المتجهان متوازيان إذا كان أحدهما مضاعفًا للآخر"],["\\langle -1,r\\rangle=\\langle 2k,-3k\\rangle","بالتعويض"],["-1=2k\\Rightarrow k=-\\frac{1}{2}","بمساواة المركبتين الأفقيتين"],["r=-3k=-3\\left(-\\frac{1}{2}\\right)=\\frac{3}{2}","بمساواة المركبتين الرأسيتين"]],"a":"<span class=\"tx\" data-t=\"r=\\frac{3}{2}=1.5\"></span>","o":""}],[{"n":"8","s":[["2\\vec{b}=\\langle 6,8\\rangle",""],["\\vec{a}\\bullet 2\\vec{b}=2(6)+(-3)(8)=12-24=-12","تعريف الضرب القياسي"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"-12\"></span>","o":""}],[{"n":"13","s":[["\\vec{u}\\bullet\\vec{v}=u_1v_1+u_2v_2=v_1u_1+v_2u_2=\\vec{v}\\bullet\\vec{u}","خاصية الإبدال في الضرب القياسي"]],"a":"العبارة صحيحة","o":""}],[{"n":"18","s":[["\\vec{v}-\\vec{w}=\\langle 2-4,\\ -1+2\\rangle=\\langle -2,1\\rangle",""],["-3\\langle -2,1\\rangle=\\langle 6,-3\\rangle","ضرب متجه في عدد"]],"a":"<span class=\"tx\" data-t=\"\\langle 6,-3\\rangle\"></span>","o":""},{"n":"19","s":[["2\\vec{u}=\\langle -2,10\\rangle",""],["\\vec{v}\\bullet 2\\vec{u}=2(-2)+(-1)(10)=-14","تعريف الضرب القياسي"]],"a":"<span class=\"tx\" data-t=\"-14\"></span>","o":""},{"n":"20","s":[["\\vec{u}+\\frac{1}{2}\\vec{w}=\\langle -1+2,\\ 5-1\\rangle=\\langle 1,4\\rangle",""],["\\vec{w}\\bullet\\langle 1,4\\rangle=4(1)+(-2)(4)=-4",""]],"a":"<span class=\"tx\" data-t=\"-4\"></span>","o":""},{"n":"21","s":[["\\vec{v}\\bullet\\vec{w}=8+2=10,\\ |\\vec{v}|=\\sqrt{5},\\ |\\vec{w}|=\\sqrt{20}",""],["\\cos\\theta=\\frac{10}{\\sqrt{5}\\sqrt{20}}=\\frac{10}{10}=1","الزاوية بين متجهين"],["\\theta=0^\\circ","لاحظ أن <span class=\"tx\" data-t=\"\\vec{w}=2\\vec{v}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\theta=0^\\circ\"></span> (المتجهان متوازيان في الاتجاه نفسه)","o":""}],[{"n":"22","s":[["W=|\\vec{F}||\\vec{d}|\\cos\\theta","الشغل <span class=m dir=ltr>=</span> الضرب القياسي للقوة والإزاحة"],["\\theta=45^\\circ","الزاوية بين القوة والإزاحة الأفقية"],["W=78\\times 12\\times\\cos 45^\\circ=468\\sqrt{2}","بالتعويض"],["W\\approx 661.9\\ \\text{J}",""]],"a":"<span class=\"tx\" data-t=\"W=468\\sqrt{2}\\approx 661.9\\ \\text{J}\"></span>","o":""}],[{"n":"25","s":[["\\vec{a}\\bullet\\vec{b}=6(4)+8(-3)=24-24=0","حساب الضرب القياسي"],["\\vec{a}\\perp\\vec{b}","الضرب القياسي صفر يعني التعامد"]],"a":"نعم، المساران متعامدان لأن <span class=\"tx\" data-t=\"\\vec{a}\\bullet\\vec{b}=0\"></span>","o":""}],[{"n":"26","s":[["\\vec{p}\\bullet\\vec{q}=5(-2)+(-1)(3)=-13",""],["|\\vec{p}|=\\sqrt{26},\\ |\\vec{q}|=\\sqrt{13}",""],["\\cos\\theta=\\frac{-13}{\\sqrt{26}\\sqrt{13}}=\\frac{-13}{13\\sqrt{2}}=-\\frac{1}{\\sqrt{2}}","صيغة الزاوية بين متجهين"],["\\theta=135^\\circ",""]],"a":"<span class=\"tx\" data-t=\"\\theta=135^\\circ\"></span>","o":""}],[{"n":"1","s":[["\\vec{a}\\bullet\\vec{b}=(-1)(-6)+(5)(-2)=6-10=-4","تعريف الضرب القياسي"]],"a":"<span class=\"tx\" data-t=\"-4\"></span>","o":""},{"n":"2","s":[["\\vec{u}\\bullet\\vec{v}=3(6)+9(5)=18+45=63",""]],"a":"<span class=\"tx\" data-t=\"63\"></span>","o":""},{"n":"3","s":[["\\langle 8,4\\rangle\\bullet\\langle -7,-9\\rangle=-56-36=-92","من الرسم"]],"a":"<span class=\"tx\" data-t=\"-92\"></span>","o":""},{"n":"4","s":[["\\langle 0,9\\rangle\\bullet\\langle 5,-7\\rangle=0-63=-63","من الرسم"]],"a":"<span class=\"tx\" data-t=\"-63\"></span>","o":""}],[{"n":"5","s":[["\\vec{u}\\bullet\\vec{v}=4(-9)+(-9)(4)=-72\\ne 0","ليسا متعامدين"],["\\frac{4}{-9}\\ne\\frac{-9}{4}","ليس أحدهما مضاعفًا للآخر، فليسا متوازيين"]],"a":"غير ذلك (ليسا متوازيين ولا متعامدين)","o":""},{"n":"6","s":[["\\vec{u}\\bullet\\vec{v}=(-5)(-10)+2(25)=100\\ne 0","ليسا متعامدين"],["\\frac{-10}{-5}=2,\\ \\frac{25}{2}=12.5","النسبتان مختلفتان فليسا متوازيين"]],"a":"غير ذلك (ليسا متوازيين ولا متعامدين)","o":""}],[{"n":"7","s":[["\\vec{u}=\\langle -2,2\\rangle,\\ \\vec{v}=\\langle 8,-1\\rangle","من الرسم"],["\\vec{u}\\bullet\\vec{v}=-16-2=-18",""],["|\\vec{u}|=\\sqrt{8},\\ |\\vec{v}|=\\sqrt{65}",""],["\\cos\\theta=\\frac{-18}{\\sqrt{8}\\sqrt{65}}=\\frac{-18}{\\sqrt{520}}\\approx -0.7894","صيغة الزاوية بين متجهين"],["\\theta\\approx 142.1^\\circ",""]],"a":"<span class=\"tx\" data-t=\"\\theta\\approx 142.1^\\circ\"></span>","o":""},{"n":"8","s":[["\\vec{u}=\\langle 3,6\\rangle,\\ \\vec{v}=\\langle 4,-10\\rangle","من الرسم"],["\\vec{u}\\bullet\\vec{v}=12-60=-48",""],["|\\vec{u}|=\\sqrt{45},\\ |\\vec{v}|=\\sqrt{116}",""],["\\cos\\theta=\\frac{-48}{\\sqrt{45}\\sqrt{116}}\\approx -0.6644",""],["\\theta\\approx 131.6^\\circ",""]],"a":"<span class=\"tx\" data-t=\"\\theta\\approx 131.6^\\circ\"></span>","o":""}],[{"n":"9","s":[["d=20\\ \\text{cm}=0.2\\ \\text{m}","نحوّل المسافة إلى متر"],["W=|\\vec{F}||\\vec{d}|\\cos\\theta=45\\times 0.2\\times\\cos 30^\\circ","الشغل <span class=m dir=ltr>=</span> الضرب القياسي"],["W=4.5\\sqrt{3}\\approx 7.79\\ \\text{J}",""]],"a":"<span class=\"tx\" data-t=\"W=4.5\\sqrt{3}\\approx 7.79\\ \\text{J}\"></span>","o":""}]]