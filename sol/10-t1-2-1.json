[[{"n":"1","s":[["\\overline{OR},\\ \\overline{OM}","قطعتان تصلان المركز <span class=\"tx\" data-t=\"O\"></span> بنقطتين على الدائرة"]],"a":"نصفا قطرين: <span class=\"tx\" data-t=\"\\overline{OR}\"></span> و <span class=\"tx\" data-t=\"\\overline{OM}\"></span>","o":""},{"n":"2","s":[["\\overline{LM},\\ \\overline{RS}","قطعتان طرفاهما على الدائرة"]],"a":"وتران: <span class=\"tx\" data-t=\"\\overline{LM}\"></span> و <span class=\"tx\" data-t=\"\\overline{RS}\"></span> (ويمكن أيضًا <span class=\"tx\" data-t=\"\\overline{RM}\"></span> وهو قطر)","o":""},{"n":"3","s":[["\\overleftrightarrow{KP},\\ \\overleftrightarrow{KT}","كل منهما يلاقي الدائرة في نقطة واحدة فقط (<span class=\"tx\" data-t=\"L\"></span> و <span class=\"tx\" data-t=\"M\"></span>)"]],"a":"مماسّان: <span class=\"tx\" data-t=\"\\overleftrightarrow{KP}\"></span> (نقطة التماس <span class=\"tx\" data-t=\"L\"></span>) و <span class=\"tx\" data-t=\"\\overleftrightarrow{KT}\"></span> (نقطة التماس <span class=\"tx\" data-t=\"M\"></span>)","o":""},{"n":"4","s":[["\\overleftrightarrow{PT}","يقطع الدائرة في نقطتين <span class=\"tx\" data-t=\"R\"></span> و <span class=\"tx\" data-t=\"S\"></span>"]],"a":"قاطع: <span class=\"tx\" data-t=\"\\overleftrightarrow{PT}\"></span>","o":""}],[{"n":"5","s":[["OA = OB","نصفا قطرين في الدائرة نفسها"]],"a":"المثلث <span class=\"tx\" data-t=\"AOB\"></span> متطابق الضلعين؛ لأنّ <span class=\"tx\" data-t=\"OA = OB\"></span> (نصفا قطر)","o":""},{"n":"6","s":[["OA = OD,\\ OB = OC","أنصاف أقطار"],["AB = CD","معطى"],["\\triangle AOB \\cong \\triangle DOC","بالتطابق بثلاثة أضلاع <span class=m dir=ltr>(SSS)</span>"]],"a":"نعم، المثلثان متطابقان بثلاثة أضلاع <span class=m dir=ltr>(SSS)</span>","o":""},{"n":"7","s":[["m\\angle OBA = m\\angle OAB = 65^\\circ","زاويتا القاعدة في المثلث المتطابق الضلعين"],["m\\angle AOB = 180^\\circ - 2(65^\\circ) = 50^\\circ","مجموع زوايا المثلث"],["m\\angle COD = m\\angle AOB = 50^\\circ","زاويتان متناظرتان في مثلثين متطابقين"]],"a":"<span class=\"tx\" data-t=\"m\\angle COD = 50^\\circ\"></span>","o":"","k":[{"e":"50","a":null}]}],[{"n":"8","s":[["OD = OE","الوتران المتطابقان يبعدان البعد نفسه عن المركز"],["3x - 7 = x + 9","بالتعويض"],["2x = 16","بطرح <span class=\"tx\" data-t=\"x\"></span> وإضافة <span class=m dir=ltr>7</span> للطرفين"],["x = 8","بقسمة الطرفين على <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"x = 8\"></span>","o":"","k":[{"e":"8","a":null}]}],[{"n":"9","s":[["OE = OF","نصفا قطر"],["EM = FM","<span class=\"tx\" data-t=\"M\"></span> منتصف الوتر"],["OM = OM","ضلع مشترك"],["\\triangle EOM \\cong \\triangle FOM","بالتطابق بثلاثة أضلاع <span class=m dir=ltr>(SSS)</span>"]],"a":"نعم، المثلثان متطابقان <span class=m dir=ltr>(SSS)</span>","o":""},{"n":"10","s":[["m\\angle EMO = m\\angle FMO","من تطابق المثلثين"],["m\\angle EMO + m\\angle FMO = 180^\\circ","زاويتان على مستقيم"],["m\\angle EMO = 90^\\circ","بقسمة <span class=m dir=ltr>180</span> على <span class=m dir=ltr>2</span>"]],"a":"نعم، <span class=\"tx\" data-t=\"\\angle EMO\"></span> قائمة؛ فالقطعة الواصلة من المركز إلى منتصف الوتر عمودية عليه","o":""},{"n":"11","s":[["m\\angle MOE = m\\angle MOF = 72^\\circ","من تطابق المثلثين"],["m\\angle MEO = 180^\\circ - 90^\\circ - 72^\\circ","مجموع زوايا المثلث <span class=\"tx\" data-t=\"EMO\"></span>"],["m\\angle MEO = 18^\\circ",""]],"a":"<span class=\"tx\" data-t=\"m\\angle MEO = 18^\\circ\"></span>","o":"","k":[{"e":"18","a":null}]}],[{"n":"12","s":[["\\overline{OX} \\perp \\overleftrightarrow{PX}","المماس يتعامد مع نصف القطر عند نقطة التماس"]],"a":"نعم، <span class=\"tx\" data-t=\"m\\angle PXO = 90^\\circ\"></span>","o":"","k":[{"e":"90","a":null}]},{"n":"13","s":[["m\\angle PXO = m\\angle PYO = 90^\\circ","المماس يعامد نصف القطر"],["OX = OY","نصفا قطر"],["PO = PO","وتر مشترك"],["\\triangle XPO \\cong \\triangle YPO","بالتطابق بوتر وضلع قائمة <span class=m dir=ltr>(RHS)</span>"]],"a":"المثلثان <span class=\"tx\" data-t=\"XPO\"></span> و <span class=\"tx\" data-t=\"YPO\"></span> متطابقان (وتر وضلع في مثلثين قائمين)","o":""},{"n":"14","s":[["m\\angle XOP = 180^\\circ - 90^\\circ - 17^\\circ = 73^\\circ","مجموع زوايا المثلث <span class=\"tx\" data-t=\"XPO\"></span>"],["m\\angle YOP = 73^\\circ","من تطابق المثلثين"],["m\\angle XOY = 73^\\circ + 73^\\circ = 146^\\circ","بالجمع"]],"a":"<span class=\"tx\" data-t=\"m\\angle XOY = 146^\\circ\"></span>","o":"","k":[{"e":"146","a":null}]}],[{"n":"15","s":[["AC = \\frac{6}{2} = 3\\ \\text{cm}","العمود من المركز على الوتر ينصّفه"],["(OA)^2 = (AC)^2 + (OC)^2","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle ACO\"></span>"],["(OA)^2 = 3^2 + 4^2 = 25","بالتعويض"],["OA = 5","بأخذ الجذر التربيعي"]],"a":"طول نصف القطر <span class=\"tx\" data-t=\"5\\ \\text{cm}\"></span>","o":"","k":[{"e":"5","a":null}]}],[{"n":"16","s":[["\\text{chords } \\overline{AB},\\ \\overline{CD}","يرسم عبير وترين غير متوازيين على حافة الطاولة"],["\\ell_1 \\perp \\overline{AB},\\ \\ell_2 \\perp \\overline{CD}","يرسم العمود المنصِّف لكل وتر"],["\\ell_1 \\cap \\ell_2 = O","العمود المنصِّف لأيّ وتر يمرّ بالمركز"]],"a":"مركز الطاولة هو نقطة تقاطع العمودين المنصِّفين لوترين غير متوازيين","o":"مسألة اليوم: إيجاد مركز طاولة دائرية لتثبيت عمود المظلّة."}],[{"n":"17","s":[["ZX = ZY","المماسان المرسومان من نقطة خارج الدائرة متطابقان"],["m\\angle ZXY = m\\angle ZYX = \\frac{180^\\circ - 80^\\circ}{2} = 50^\\circ","زاويتا القاعدة في مثلث متطابق الضلعين"],["m\\angle OYZ = 90^\\circ","المماس يعامد نصف القطر"],["a = 90^\\circ - 50^\\circ = 40^\\circ","بالطرح"]],"a":"<span class=\"tx\" data-t=\"a = 40\"></span>","o":"","k":[{"e":"40","a":null}]}],[{"n":"18","s":[["x + 78^\\circ = 90^\\circ","المماس يعامد نصف القطر عند نقطة التماس"],["x = 12^\\circ","بطرح <span class=m dir=ltr>78</span> من الطرفين"],["y = 180^\\circ - 2(12^\\circ)","المثلث متطابق الضلعين (نصفا قطر)، فزاويتا قاعدته متساويتان"],["y = 156^\\circ",""]],"a":"<span class=\"tx\" data-t=\"x = 12^\\circ,\\ y = 156^\\circ\"></span>","o":"","k":[{"e":"12","a":null},{"e":"156","a":null}]},{"n":"19","s":[["x = 180^\\circ - 2(50^\\circ) = 80^\\circ","المثلث متطابق الضلعين (نصفا قطر)"],["y + 50^\\circ = 90^\\circ","المماس يعامد نصف القطر، وزاوية القاعدة الأخرى <span class=\"tx\" data-t=\"50^\\circ\"></span>"],["y = 40^\\circ",""]],"a":"<span class=\"tx\" data-t=\"x = 80^\\circ,\\ y = 40^\\circ\"></span>","o":"","k":[{"e":"80","a":null},{"e":"40","a":null}]}],[{"n":"20","s":[["m\\angle OCD = m\\angle ODC = \\frac{180^\\circ - 64^\\circ}{2} = 58^\\circ","<span class=\"tx\" data-t=\"OC = OD\"></span> نصفا قطر"],["m\\angle OCB = 90^\\circ","المماس يعامد نصف القطر"],["m\\angle DCB = 90^\\circ - 58^\\circ = 32^\\circ","بالطرح"],["m\\angle DCB = m\\angle DBC = 32^\\circ","إذن زاويتان متساويتان في <span class=\"tx\" data-t=\"\\triangle BCD\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\triangle BCD\"></span> متطابق الضلعين (<span class=\"tx\" data-t=\"DC = DB\"></span>) لأنّ <span class=\"tx\" data-t=\"m\\angle DCB = m\\angle DBC = 32^\\circ\"></span>","o":""}],[{"n":"21","s":[["1","من نقطة على الدائرة: مماس واحد عمودي على نصف القطر عندها"],["2","من نقطة خارجها: مماسّان متطابقان"],["0","من نقطة داخلها: أيّ مستقيم يمرّ بها يقطع الدائرة في نقطتين"]],"a":"مماس واحد من نقطة عليها، مماسّان من نقطة خارجها، ولا يوجد مماس من نقطة داخلها","o":""}],[{"n":"22","s":[["AP = \\frac{14}{2} = 7","<span class=\"tx\" data-t=\"\\overline{ON}\"></span> عمودي على الوتر المشترك فينصّفه"],["OP = \\sqrt{18^2 - 7^2} = \\sqrt{275} \\approx 16.58","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle APO\"></span>"],["PN = \\sqrt{12^2 - 7^2} = \\sqrt{95} \\approx 9.75","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle APN\"></span>"],["ON = OP + PN = \\sqrt{275} + \\sqrt{95} \\approx 26.33","بالجمع"]],"a":"<span class=\"tx\" data-t=\"ON = 5\\sqrt{11} + \\sqrt{95} \\approx 26.3\\ \\text{cm}\"></span>","o":"","k":[{"e":"26.3","a":true}]}],[{"n":"23","s":[["\\overline{NE} \\perp \\overline{AB},\\ \\overline{NF} \\perp \\overline{CD}","نرسم العمودين من المركز على الوترين"],["AE = \\tfrac{1}{2}AB = \\tfrac{1}{2}CD = CF","العمود من المركز ينصّف الوتر، و <span class=\"tx\" data-t=\"AB = CD\"></span>"],["NA = NC","نصفا قطر"],["\\triangle NEA \\cong \\triangle NFC","وتر وضلع في مثلثين قائمين <span class=m dir=ltr>(RHS)</span>"],["NE = NF","ضلعان متناظران"]],"a":"الوتران المتساويان على البعد نفسه عن المركز: <span class=\"tx\" data-t=\"NE = NF\"></span>","o":""}],[{"n":"24","s":[["m\\angle NAB = 90^\\circ","المماس يعامد نصف القطر، فالوتر هو <span class=\"tx\" data-t=\"\\overline{BN}\"></span>"],["(BN)^2 = (BA)^2 + (AN)^2","نظرية فيثاغورس"],["(BN)^2 = 25 + 9 = 34","بالتعويض"],["BN = \\sqrt{34} \\approx 5.83",""]],"a":"قول سارة غير صحيح؛ أخطأت حين عدّت <span class=\"tx\" data-t=\"\\overline{BA}\"></span> وترًا، والصحيح <span class=\"tx\" data-t=\"BN = \\sqrt{34} \\approx 5.8\\ \\text{cm}\"></span>","o":""}],[{"n":"1","s":[["OS=OT=3\\ \\text{cm}","علامتا التطابق في الشكل"],["AB=CB","الوتران المتساويان في البُعد عن المركز متطابقان"],["AB=2AS=2(4)=8","العمود من المركز على الوتر ينصّفه"],["BC=8\\ \\text{cm}",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"8\"></span>","o":"","k":[{"e":"8","a":null}]}],[{"n":"2","s":[["CL=CD=2+3=5","أنصاف أقطار"],["LN=\\sqrt{CL^2-CN^2}=\\sqrt{25-9}=4","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle CNL\"></span>"],["LM=2LN=8","القطر العمودي على الوتر ينصّفه"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"8\"></span>","o":"","k":[{"e":"8","a":null}]}],[{"n":"3","s":[["(x+8)^2=x^2+16^2","نظرية فيثاغورس (<span class=\"tx\" data-t=\"\\overline{AT}\"></span> مماس عمودي على <span class=\"tx\" data-t=\"\\overline{OT}\"></span>)"],["x^2+16x+64=x^2+256","بفكّ الأقواس"],["16x=192\\Rightarrow x=12","بطرح <span class=\"tx\" data-t=\"x^2+64\"></span> من الطرفين ثم القسمة على <span class=m dir=ltr>16</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"12\"></span>","o":"","k":[{"e":"12","a":null}]}],[{"n":"12","s":[["OS=6360+640=7000\\ \\text{km}","بُعد القمر عن مركز الأرض <span class=\"tx\" data-t=\"O\"></span>"],["\\overline{OA}\\perp\\overline{SA}","المماس عمودي على نصف القطر عند نقطة التماس"],["SA^2=OS^2-OA^2=7000^2-6360^2","نظرية فيثاغورس"],["=49000000-40449600=8550400",""],["SA=\\sqrt{8550400}\\approx2924.1\\ \\text{km}","بأخذ الجذر التربيعي"]],"a":"المسافة <span class=\"tx\" data-t=\"\\approx 2924.1\\ \\text{km}\"></span> (وهي طول المماس <span class=\"tx\" data-t=\"SA\"></span>)","o":""}],[{"n":"1","s":[["JK=LM\\Rightarrow NQ=NP","الوتران المتطابقان على البُعد نفسه من المركز"],["NQ=9\\ \\text{cm}",""]],"a":"<span class=\"tx\" data-t=\"NQ=9\\ \\text{cm}\"></span>","o":"","k":[{"e":"9","a":null}]},{"n":"2","s":[["JP=\\frac{24}{2}=12","العمود من المركز على الوتر ينصّفه"],["NJ=\\sqrt{12^2+9^2}=\\sqrt{225}=15","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle NPJ\"></span>"]],"a":"<span class=\"tx\" data-t=\"r=15\\ \\text{cm}\"></span>","o":"","k":[{"e":"15","a":null}]}],[{"n":"3","s":[["SB=SA","المماسّان المرسومان من نقطة خارجية متطابقان"],["3x+12=7x-4",""],["16=4x\\Rightarrow x=4","بطرح <span class=\"tx\" data-t=\"3x\"></span> وإضافة <span class=m dir=ltr>4</span> للطرفين ثم القسمة على <span class=m dir=ltr>4</span>"]],"a":"<span class=\"tx\" data-t=\"x=4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"4","s":[["SB=3(4)+12=24","بالتعويض"],["QS^2=QB^2+SB^2=10^2+24^2=676","نظرية فيثاغورس (<span class=\"tx\" data-t=\"\\overline{QB}\\perp\\overline{SB}\"></span>)"],["QS=\\sqrt{676}=26",""]],"a":"<span class=\"tx\" data-t=\"QS=26\\ \\text{cm}\"></span>","o":"","k":[{"e":"26","a":null}]}],[{"n":"5","s":[["MA=MB","المماسّان المرسومان من نقطة خارجية متطابقان"],["5x-25=2x+8",""],["3x=33\\Rightarrow x=11",""]],"a":"<span class=\"tx\" data-t=\"x=11\"></span>","o":"","k":[{"e":"11","a":null}]},{"n":"6","s":[["MA=5(11)-25=30","بالتعويض"],["NA^2=MN^2-MA^2=34^2-30^2=1156-900=256","نظرية فيثاغورس (<span class=\"tx\" data-t=\"\\overline{NA}\\perp\\overline{MA}\"></span>)"],["NA=16",""]],"a":"<span class=\"tx\" data-t=\"r=16\\ \\text{cm}\"></span>","o":"","k":[{"e":"16","a":null}]}],[{"n":"7","s":[["\\angle OTX=90^\\circ","المماس عمودي على نصف القطر عند نقطة التماس <span class=\"tx\" data-t=\"T\"></span>"],["x=180^\\circ-90^\\circ-52^\\circ=38^\\circ","مجموع زوايا المثلث القائم"],["OT=OP","أنصاف أقطار، فالمثلث <span class=\"tx\" data-t=\"OTP\"></span> متطابق الضلعين (<span class=\"tx\" data-t=\"P\"></span> نقطة تقاطع الضلع المائل مع الدائرة)"],["y=\\frac{180^\\circ-52^\\circ}{2}=64^\\circ","زاويتا القاعدة متساويتان"]],"a":"<span class=\"tx\" data-t=\"x=38^\\circ,\\ y=64^\\circ\"></span>","o":"","k":[{"e":"38","a":null},{"e":"64","a":null}]}],[{"n":"8","s":[["\\text{half chord}=\\frac{240}{2}=120,\\quad d=r-45","العمود من المركز على الوتر (الضلع العلوي) ينصّفه، وبُعد المركز عن الوتر <span class=\"tx\" data-t=\"r-45\"></span>"],["r^2=120^2+(r-45)^2","نظرية فيثاغورس"],["r^2=14400+r^2-90r+2025","بفكّ الأقواس"],["90r=16425\\Rightarrow r=182.5","بالتبسيط والقسمة على <span class=m dir=ltr>90</span>"]],"a":"طول نصف القطر <span class=\"tx\" data-t=\"182.5\\ \\text{cm}\"></span>","o":"","k":[{"e":"182.5","a":true}]}],[{"n":"9","s":[["r=\\frac{15}{2}=7.5\\ \\text{cm}","نصف قطر الكرة"],["x^2=40^2+7.5^2","خط البصر مماسّ للكرة وعمودي على نصف القطر عند نقطة التماس (نظرية فيثاغورس)"],["x^2=1600+56.25=1656.25",""],["x=\\sqrt{1656.25}\\approx40.70",""]],"a":"<span class=\"tx\" data-t=\"x\\approx 40.70\\ \\text{cm}\"></span>","o":"اعتبرنا <span class=\"tx\" data-t=\"x\"></span> المسافة من عين آلاء إلى مركز الكرة؛ وأبعد نقطة تُرى هي نقطة التماس.","k":[{"e":"40.7","a":true}]}],[{"n":"1","s":[["16\\times1.3=20.8\\to21","أصغر قطر <span class=m dir=ltr>16</span>، والتالي يزيد <span class=m dir=ltr>30%</span> على الأقل ويكون عددًا كليًّا"],["21\\times1.3=27.3\\to28",""],["28\\times1.3=36.4\\to37",""],["37\\times1.3=48.1>40","لا يمكن إضافة شعار آخر"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"16,\\ 21,\\ 28,\\ 37\\ \\text{mm}\"></span> — وهي أكبر مجموعة ممكنة؛ لا يمكن تكوين <span class=m dir=ltr>5</span> أقطار تحقّق الشروط معًا لأنّ <span class=\"tx\" data-t=\"16\\times1.3^4\\approx45.7&gt;40\"></span>","o":"إن قُصد أمثلة لأقطار مقبولة منفردة فأي عدد كلّي من <span class=m dir=ltr>16</span> إلى <span class=m dir=ltr>40 (</span>مثل <span class=m dir=ltr>16, 20, 25, 30, 40)</span> مقبول."},{"n":"2","s":[["28\\times1.3=36.4\\Rightarrow d\\ge37","القطر الأكبر عدد كلّي لا يقل عن <span class=m dir=ltr>36.4</span> ولا يزيد على <span class=m dir=ltr>40</span>"],["d\\times1.3\\le28\\Rightarrow d\\le\\frac{28}{1.3}\\approx21.5\\Rightarrow d\\le21","القطر الأصغر عدد كلّي لا يقل عن <span class=m dir=ltr>16</span>"]],"a":"إجابة ممكنة: قطر أكبر <span class=\"tx\" data-t=\"37\\ \\text{mm}\"></span> (أي قيمة من <span class=m dir=ltr>37</span> إلى <span class=m dir=ltr>40)</span>، وقطر أصغر <span class=\"tx\" data-t=\"21\\ \\text{mm}\"></span> (أي قيمة من <span class=m dir=ltr>16</span> إلى <span class=m dir=ltr>21)</span>","o":""}]]