[[{"n":"1","s":[["A=\\int_{-1}^{1}\\left(x^2-(-2x^4)\\right)dx","<span class=\"tx\" data-t=\"y=x^2\"></span> فوق <span class=\"tx\" data-t=\"y=-2x^4\"></span> في <span class=\"tx\" data-t=\"[-1,1]\"></span>"],["=\\int_{-1}^{1}(x^2+2x^4)\\,dx=\\left[\\frac{x^3}{3}+\\frac{2x^5}{5}\\right]_{-1}^{1}",""],["=\\left(\\tfrac13+\\tfrac25\\right)-\\left(-\\tfrac13-\\tfrac25\\right)=\\frac{22}{15}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{22}{15}\\approx 1.467\"></span> وحدة مربعة","o":""},{"n":"2","s":[["x^3-3x=x\\Rightarrow x(x^2-4)=0\\Rightarrow x=-2,\\,0,\\,2","نقاط التقاطع"],["A=\\int_{-2}^{0}\\left((x^3-3x)-x\\right)dx+\\int_{0}^{2}\\left(x-(x^3-3x)\\right)dx","في <span class=\"tx\" data-t=\"[-2,0]\"></span> المنحنى فوق المستقيم، وفي <span class=\"tx\" data-t=\"[0,2]\"></span> العكس"],["\\int_{-2}^{0}(x^3-4x)\\,dx=\\left[\\frac{x^4}{4}-2x^2\\right]_{-2}^{0}=0-(4-8)=4",""],["\\int_{0}^{2}(4x-x^3)\\,dx=\\left[2x^2-\\frac{x^4}{4}\\right]_0^2=8-4=4",""],["A=4+4=8",""]],"a":"المساحة <span class=\"tx\" data-t=\"=8\"></span> وحدات مربعة","o":""}],[{"n":"3","s":[["A=\\int_0^3\\left(e^{0.5x}-e^{-0.5x}\\right)dx","المنحنيان يتقاطعان عند <span class=\"tx\" data-t=\"(0,1)\"></span>، و <span class=\"tx\" data-t=\"f\"></span> فوق <span class=\"tx\" data-t=\"h\"></span> في <span class=\"tx\" data-t=\"[0,3]\"></span>"],["=\\left[2e^{0.5x}+2e^{-0.5x}\\right]_0^3",""],["=\\left(2e^{1.5}+2e^{-1.5}\\right)-(2+2)","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=2e^{1.5}+2e^{-1.5}-4\\approx 5.410\"></span> وحدة مربعة","o":""},{"n":"4","s":[["A=\\int_0^{\\pi/4}\\left(\\sec^2x-\\sin x\\right)dx","<span class=\"tx\" data-t=\"\\sec^2x\"></span> فوق <span class=\"tx\" data-t=\"\\sin x\"></span> في <span class=\"tx\" data-t=\"[0,\\frac{\\pi}{4}]\"></span>"],["=\\left[\\tan x+\\cos x\\right]_0^{\\pi/4}",""],["=\\left(1+\\tfrac{\\sqrt2}{2}\\right)-(0+1)","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{\\sqrt2}{2}\\approx 0.707\"></span> وحدة مربعة","o":""}],[{"n":"5","s":[["\\frac12x^2+6=2x^2\\Rightarrow \\frac32x^2=6\\Rightarrow x=\\pm2","نقاط التقاطع"],["A=\\int_{-2}^{2}\\left(\\frac12x^2+6-2x^2\\right)dx=\\int_{-2}^{2}\\left(6-\\frac32x^2\\right)dx","<span class=\"tx\" data-t=\"f\"></span> فوق <span class=\"tx\" data-t=\"g\"></span> بين نقطتي التقاطع (مثلًا <span class=\"tx\" data-t=\"f(0)=6&gt;g(0)=0\"></span>)"],["=\\left[6x-\\frac{x^3}{2}\\right]_{-2}^{2}=(12-4)-(-12+4)","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=16\"></span> وحدة مربعة","o":""}],[{"n":"6","s":[["4^x=3^x\\Rightarrow x=0","نقطة التقاطع <span class=\"tx\" data-t=\"(0,1)\"></span> على المحور <span class=\"tx\" data-t=\"y\"></span>"],["A=\\int_0^1\\left(4^x-3^x\\right)dx","<span class=\"tx\" data-t=\"4^x\\ge3^x\"></span> عندما <span class=\"tx\" data-t=\"x\\ge0\"></span>"],["=\\left[\\frac{4^x}{\\ln4}-\\frac{3^x}{\\ln3}\\right]_0^1=\\left(\\frac{4}{\\ln4}-\\frac{3}{\\ln3}\\right)-\\left(\\frac{1}{\\ln4}-\\frac{1}{\\ln3}\\right)","<span class=\"tx\" data-t=\"\\int a^xdx=\\frac{a^x}{\\ln a}\"></span>"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{3}{\\ln4}-\\frac{2}{\\ln3}\\approx 0.344\"></span> وحدة مربعة","o":""}],[{"n":"7","s":[["e^0=\\cos0=1","المنحنيان يتقاطعان عند <span class=\"tx\" data-t=\"(0,1)\"></span>"],["A=\\int_0^{\\pi/2}\\left(e^x-\\cos x\\right)dx","<span class=\"tx\" data-t=\"e^x\\ge\\cos x\"></span> في <span class=\"tx\" data-t=\"[0,\\frac{\\pi}{2}]\"></span>"],["=\\left[e^x-\\sin x\\right]_0^{\\pi/2}=\\left(e^{\\pi/2}-1\\right)-(1-0)","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=e^{\\pi/2}-2\\approx 2.810\"></span> وحدة مربعة","o":""}],[{"n":"8","s":[["f(x)-g(x)=3x^3-12x=3x(x-2)(x+2)","الفرق بين الاقترانين"],["f(x)=g(x)\\Rightarrow x=-2,\\,0,\\,2","نقاط التقاطع"],["A=\\int_{-2}^{0}(3x^3-12x)\\,dx+\\int_{0}^{2}(12x-3x^3)\\,dx","<span class=\"tx\" data-t=\"f\"></span> فوق <span class=\"tx\" data-t=\"g\"></span> في <span class=\"tx\" data-t=\"[-2,0]\"></span>، و <span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\"></span> في <span class=\"tx\" data-t=\"[0,2]\"></span>"],["\\int_{-2}^{0}(3x^3-12x)\\,dx=\\left[\\tfrac34x^4-6x^2\\right]_{-2}^{0}=-(12-24)=12",""],["\\int_{0}^{2}(12x-3x^3)\\,dx=\\left[6x^2-\\tfrac34x^4\\right]_0^2=24-12=12",""]],"a":"المساحة <span class=\"tx\" data-t=\"=12+12=24\"></span> وحدة مربعة","o":""}],[{"n":"9","s":[["g(x)-f(x)=4x+12-4+x^2=x^2+4x+8=(x+2)^2+4>0","<span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\"></span> دائمًا"],["A=\\int_{-1}^{2}(x^2+4x+8)\\,dx=\\left[\\frac{x^3}{3}+2x^2+8x\\right]_{-1}^{2}",""],["=\\left(\\tfrac83+8+16\\right)-\\left(-\\tfrac13+2-8\\right)=\\frac{80}{3}+\\frac{19}{3}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=33\"></span> وحدة مربعة","o":""}],[{"n":"10","s":[["\\frac12x^2=4\\sqrt x\\Rightarrow x^4=64x\\Rightarrow x(x^3-64)=0\\Rightarrow x=0,\\ 4","نقاط التقاطع (بتربيع الطرفين)"],["A=\\int_0^4\\left(4\\sqrt x-\\frac12x^2\\right)dx","<span class=\"tx\" data-t=\"h\"></span> فوق <span class=\"tx\" data-t=\"f\"></span> في <span class=\"tx\" data-t=\"[0,4]\"></span>"],["=\\left[\\frac83x^{3/2}-\\frac{x^3}{6}\\right]_0^4=\\frac{64}{3}-\\frac{64}{6}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{32}{3}\\approx 10.667\"></span> وحدة مربعة","o":""}],[{"n":"11","s":[["B(-a,a^2),\\ C(-a,0),\\ D(a,0)","بالتماثل حول المحور <span class=\"tx\" data-t=\"y\"></span> (نفرض <span class=\"tx\" data-t=\"a&gt;0\"></span>)"],["A_{\\text{region}}=\\int_{-a}^{a}(a^2-x^2)\\,dx=\\left[a^2x-\\frac{x^3}{3}\\right]_{-a}^{a}=\\frac{4a^3}{3}","المستقيم <span class=\"tx\" data-t=\"y=a^2\"></span> فوق المنحنى"],["A_{ABCD}=2a\\times a^2=2a^3","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["\\frac{4a^3/3}{2a^3}=\\frac23","النسبة"]],"a":"مساحة المنطقة <span class=\"tx\" data-t=\"=\\frac23\"></span> مساحة المستطيل <span class=\"tx\" data-t=\"ABCD\"></span> (تمّ الإثبات)","o":""}],[{"n":"12","s":[["A\\left(\\tfrac12,\\,8.5\\right),\\ B(2,\\,2.5)","<span class=\"tx\" data-t=\"f(\\frac12)=8+\\frac12\"></span>، <span class=\"tx\" data-t=\"f(2)=\\frac12+2\"></span>"],["m=\\frac{2.5-8.5}{2-0.5}=-4\\Rightarrow y=-4x+10.5","معادلة المستقيم <span class=\"tx\" data-t=\"AB\"></span>"],["A=\\int_{1/2}^{2}\\left(-4x+10.5-\\frac{2}{x^2}-x\\right)dx=\\int_{1/2}^{2}\\left(10.5-5x-2x^{-2}\\right)dx","المستقيم فوق المنحنى"],["=\\left[10.5x-\\frac52x^2+\\frac2x\\right]_{1/2}^{2}=(21-10+1)-(5.25-0.625+4)","بالتعويض بحدّي التكامل"],["=12-8.625=3.375",""]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{27}{8}=3.375\"></span> وحدة مربعة","o":""}],[{"n":"13","s":[["\\int_0^1v\\,dt=\\tfrac12(1)(2)=1","مثلث فوق المحور <span class=\"tx\" data-t=\"t\"></span>"],["\\int_1^4v\\,dt=-\\left(\\tfrac12(1)(2)+1\\times2+\\tfrac12(1)(2)\\right)=-4","شبه منحرف تحت المحور <span class=\"tx\" data-t=\"t\"></span>"],["\\int_4^8v\\,dt=\\tfrac12(4)(4)=8","مثلث فوق المحور <span class=\"tx\" data-t=\"t\"></span>"],["\\Delta x=\\int_0^8v\\,dt=1-4+8=5",""]],"a":"الإزاحة <span class=\"tx\" data-t=\"=5\\ \\text{m}\"></span>","o":""},{"n":"14","s":[["d=\\int_0^8|v|\\,dt=1+4+8","نجمع المساحات دون إشارة"]],"a":"المسافة <span class=\"tx\" data-t=\"=13\\ \\text{m}\"></span>","o":""},{"n":"15","s":[["x(8)=x(0)+\\int_0^8v\\,dt=5+5","الموقع الابتدائي <span class=m dir=ltr>+</span> الإزاحة"]],"a":"الموقع النهائي <span class=\"tx\" data-t=\"x=10\\ \\text{m}\"></span>","o":""}],[{"n":"16","s":[["x^2-10x+25=5+4x-x^2\\Rightarrow 2x^2-14x+20=0","بمساواة الاقترانين"],["x^2-7x+10=0\\Rightarrow (x-2)(x-5)=0\\Rightarrow x=2,\\ 5",""],["f(2)=9,\\quad f(5)=0","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"A(2,9)\"></span>، <span class=\"tx\" data-t=\"B(5,0)\"></span>","o":""},{"n":"17","s":[["V=\\pi\\int_2^5\\left(g^2(x)-f^2(x)\\right)dx","طريقة الحلقات: <span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\\ge0\"></span> في <span class=\"tx\" data-t=\"[2,5]\"></span>"],["g^2-f^2=(g-f)(g+f)=(-2x^2+14x-20)(30-6x)","فرق مربعين"],["=12x^3-144x^2+540x-600","بالتوزيع"],["V=\\pi\\left[3x^4-48x^3+270x^2-600x\\right]_2^5=\\pi\\left((-375)-(-456)\\right)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"V=81\\pi\\approx 254.47\"></span> وحدة مكعبة","o":""}],[{"n":"18","s":[["V=\\pi\\int_0^{\\pi}\\left(\\sqrt{\\sin x}\\right)^2dx=\\pi\\int_0^{\\pi}\\sin x\\,dx","حجم الدوران حول المحور <span class=\"tx\" data-t=\"x\"></span>"],["=\\pi\\left[-\\cos x\\right]_0^{\\pi}=\\pi(1+1)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"V=2\\pi\\approx 6.283\"></span> وحدة مكعبة","o":""}],[{"n":"19","s":[["\\sqrt x=x^3\\Rightarrow x=x^6\\Rightarrow x=0,\\ 1","نقاط التقاطع"],["V=\\pi\\int_0^1\\left((\\sqrt x)^2-(x^3)^2\\right)dx=\\pi\\int_0^1(x-x^6)\\,dx","<span class=\"tx\" data-t=\"\\sqrt x\\ge x^3\"></span> في <span class=\"tx\" data-t=\"[0,1]\"></span> (طريقة الحلقات)"],["=\\pi\\left[\\frac{x^2}{2}-\\frac{x^7}{7}\\right]_0^1=\\pi\\left(\\frac12-\\frac17\\right)",""]],"a":"<span class=\"tx\" data-t=\"V=\\frac{5\\pi}{14}\\approx 1.122\"></span> وحدة مكعبة","o":""}],[{"n":"20","s":[["f\\left(\\pm\\tfrac{\\pi}{3}\\right)=1+2=3,\\quad f(x)\\le3","المستقيم <span class=\"tx\" data-t=\"y=3\"></span> هو نصف القطر الخارجي"],["V=\\pi\\int_{-\\pi/3}^{\\pi/3}\\left(9-(1+\\sec x)^2\\right)dx=\\pi\\int_{-\\pi/3}^{\\pi/3}\\left(8-2\\sec x-\\sec^2x\\right)dx","طريقة الحلقات"],["=\\pi\\left[8x-2\\ln|\\sec x+\\tan x|-\\tan x\\right]_{-\\pi/3}^{\\pi/3}",""],["=\\pi\\left[\\frac{16\\pi}{3}-2\\ln\\frac{2+\\sqrt3}{2-\\sqrt3}-2\\sqrt3\\right]=\\pi\\left[\\frac{16\\pi}{3}-4\\ln(2+\\sqrt3)-2\\sqrt3\\right]","لأنّ <span class=\"tx\" data-t=\"\\frac{1}{2-\\sqrt3}=2+\\sqrt3\"></span>"]],"a":"<span class=\"tx\" data-t=\"V=\\pi\\left(\\frac{16\\pi}{3}-2\\sqrt3-4\\ln(2+\\sqrt3)\\right)\\approx 25.21\"></span> وحدة مكعبة","o":""}],[{"n":"21","s":[["y=\\sqrt{2x-2}\\Rightarrow x=\\frac{y^2}{2}+1","نكتب <span class=\"tx\" data-t=\"x\"></span> بدلالة <span class=\"tx\" data-t=\"y\"></span>"],["A=\\int_0^4\\left(\\frac{y^2}{2}+1\\right)dy","المنطقة بين المحور <span class=\"tx\" data-t=\"y\"></span> والمنحنى من <span class=\"tx\" data-t=\"y=0\"></span> إلى <span class=\"tx\" data-t=\"y=4\"></span>"],["=\\left[\\frac{y^3}{6}+y\\right]_0^4=\\frac{64}{6}+4",""]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{44}{3}\\approx 14.667\"></span> وحدة مربعة","o":"تحقق: مساحة المستطيل <span class=\"tx\" data-t=\"OAPB=36\"></span> ناقص مساحة السؤال <span class=m dir=ltr>22 (</span><span class=\"tx\" data-t=\"\\frac{64}{3}\"></span>) <span class=\"tx\" data-t=\"=\\frac{44}{3}\"></span>."},{"n":"22","s":[["A=\\int_1^9\\sqrt{2x-2}\\,dx","المنحنى يبدأ من <span class=\"tx\" data-t=\"(1,0)\"></span>"],["=\\left[\\frac13(2x-2)^{3/2}\\right]_1^9=\\frac13(16)^{3/2}-0","قاعدة القوة مع القسمة على <span class=m dir=ltr>2</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{64}{3}\\approx 21.333\"></span> وحدة مربعة","o":""}],[{"n":"23","s":[["V_1=\\pi\\int_0^6 5^2\\,dx=150\\pi","حجم الأسطوانة الناتجة من دوران المستطيل تحت <span class=\"tx\" data-t=\"y=5\"></span>"],["V_2=\\pi\\int_2^6\\left(2\\sqrt{x-2}\\right)^2dx=\\pi\\int_2^6 4(x-2)\\,dx","حجم المجسم الناتج من دوران المنطقة تحت <span class=\"tx\" data-t=\"f\"></span> (تبدأ عند <span class=\"tx\" data-t=\"x=2\"></span>)"],["=4\\pi\\left[\\frac{(x-2)^2}{2}\\right]_2^6=32\\pi",""],["V=V_1-V_2=150\\pi-32\\pi","طريقة الحلقات: نصف القطر الخارجي <span class=m dir=ltr>5</span> والداخلي <span class=\"tx\" data-t=\"f(x)\"></span>"]],"a":"<span class=\"tx\" data-t=\"V=118\\pi\\approx 370.7\"></span> وحدة مكعبة","o":"التبرير: المنطقة المظللة <span class=m dir=ltr>=</span> المستطيل <span class=\"tx\" data-t=\"[0,6]\\times[0,5]\"></span> مطروحًا منه المنطقة تحت المنحنى، فالحجم <span class=m dir=ltr>=</span> حجم الأسطوانة <span class=m dir=ltr>−</span> حجم المجسم الناتج من دوران المنطقة تحت <span class=\"tx\" data-t=\"f\"></span>."}],[{"n":"24","s":[["\\cos x=\\sin x\\Rightarrow\\tan x=1\\Rightarrow x=\\frac{\\pi}{4}","في الفترة <span class=\"tx\" data-t=\"[0,\\frac{\\pi}{2}]\"></span>"],["y=\\cos\\frac{\\pi}{4}=\\frac{\\sqrt2}{2}",""]],"a":"<span class=\"tx\" data-t=\"A\\left(\\frac{\\pi}{4},\\frac{\\sqrt2}{2}\\right)\"></span>","o":""},{"n":"25","s":[["R_1=\\int_0^{\\pi/4}(\\cos x-\\sin x)\\,dx=\\left[\\sin x+\\cos x\\right]_0^{\\pi/4}=\\sqrt2-1","بين المنحنيين"],["R_2=\\int_0^{\\pi/4}\\sin x\\,dx+\\int_{\\pi/4}^{\\pi/2}\\cos x\\,dx=\\left(1-\\tfrac{\\sqrt2}{2}\\right)+\\left(1-\\tfrac{\\sqrt2}{2}\\right)=2-\\sqrt2","تحت المنحنى الأدنى"],["R_3=\\int_{\\pi/4}^{\\pi}\\sin x\\,dx-\\int_{\\pi/4}^{\\pi/2}\\cos x\\,dx=\\left(1+\\tfrac{\\sqrt2}{2}\\right)-\\left(1-\\tfrac{\\sqrt2}{2}\\right)=\\sqrt2","تحت <span class=\"tx\" data-t=\"h\"></span> وفوق <span class=\"tx\" data-t=\"f\"></span> والمحور <span class=\"tx\" data-t=\"x\"></span>"]],"a":"<span class=\"tx\" data-t=\"R_1=\\sqrt2-1\\approx0.414\"></span>، <span class=\"tx\" data-t=\"R_2=2-\\sqrt2\\approx0.586\"></span>، <span class=\"tx\" data-t=\"R_3=\\sqrt2\\approx1.414\"></span>","o":""},{"n":"26","s":[["\\frac{R_1}{R_2}=\\frac{\\sqrt2-1}{2-\\sqrt2}=\\frac{\\sqrt2-1}{\\sqrt2(\\sqrt2-1)}=\\frac{1}{\\sqrt2}","بإخراج <span class=\"tx\" data-t=\"\\sqrt2\"></span> عاملًا مشتركًا"],["\\frac{1}{\\sqrt2}=\\frac{\\sqrt2}{2}","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"R_1:R_2=\\sqrt2:2\"></span> (تمّ الإثبات)","o":""}],[{"n":"27","s":[["f'(x)=2x-4\\Rightarrow f'(1)=-2","ميل المماس عند <span class=\"tx\" data-t=\"(1,3)\"></span>"],["m_{\\perp}=\\frac12\\Rightarrow y-3=\\frac12(x-1)\\Rightarrow y=\\frac x2+\\frac52","معادلة العمودي على المماس"],["x^2-4x+6=\\frac x2+\\frac52\\Rightarrow 2x^2-9x+7=0\\Rightarrow(2x-7)(x-1)=0","بمساواة المعادلتين"],["x=\\frac72\\Rightarrow y=\\frac74+\\frac52=\\frac{17}{4}",""]],"a":"<span class=\"tx\" data-t=\"P\\left(\\frac72,\\frac{17}{4}\\right)=(3.5,\\,4.25)\"></span>","o":""},{"n":"28","s":[["A=\\int_1^{7/2}\\left(\\frac x2+\\frac52-(x^2-4x+6)\\right)dx=\\int_1^{7/2}\\left(-x^2+\\frac92x-\\frac72\\right)dx","العمودي فوق المنحنى بين نقطتي التقاطع"],["=\\left[-\\frac{x^3}{3}+\\frac94x^2-\\frac72x\\right]_1^{7/2}",""],["=\\left(-\\tfrac{343}{24}+\\tfrac{441}{16}-\\tfrac{49}{4}\\right)-\\left(-\\tfrac13+\\tfrac94-\\tfrac72\\right)=\\frac{49}{48}+\\frac{19}{12}","بالتعويض بحدّي التكامل"],["=\\frac{125}{48}\\approx2.604",""]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{125}{48}\\approx 2.604\"></span> وحدة مربعة","o":""}],[{"n":"29","s":[["k(1-x^2) \\ge 2k(x^2-1) \\text{ on } [-1,1]","من الشكل: القطع الأخضر هو الأعلى في الفترة"],["A=\\int_{-1}^{1}\\left[k(1-x^2)-2k(x^2-1)\\right]dx=\\int_{-1}^{1}3k(1-x^2)\\,dx","مساحة المنطقة بين منحنيين"],["=3k\\left[x-\\frac{x^3}{3}\\right]_{-1}^{1}=3k\\left(\\frac{2}{3}+\\frac{2}{3}\\right)=4k","بإيجاد التكامل المحدود"],["4k=8 \\Rightarrow k=2","المساحة تساوي <span class=m dir=ltr>8</span> وحدات مربعة"]],"a":"<span class=\"tx\" data-t=\"k=2\"></span>","o":""}],[{"n":"2","s":[["x^3-3x^2+4 \\ge x^2-x-2 \\text{ on } [-1,2]","من الشكل: منحنى الاقتران التكعيبي هو الأعلى"],["A=\\int_{-1}^{2}\\left[(x^3-3x^2+4)-(x^2-x-2)\\right]dx","المساحة <span class=m dir=ltr>=</span> تكامل (الأعلى <span class=m dir=ltr>−</span> الأسفل)"],["=\\int_{-1}^{2}(x^3-4x^2+x+6)\\,dx","بالتبسيط"]],"a":"الإجابة <span class=m dir=ltr>a</span>","o":""}],[{"n":"36","s":[["\\int_0^2 v\\,dt=\\frac{1}{2}(2)(4)=4","مساحة المثلث فوق المحور"],["\\int_2^4 v\\,dt=-\\frac{1}{2}(2)(4)=-4","مساحة المثلث تحت المحور (سالبة)"],["\\int_4^{10} v\\,dt=\\frac{1}{2}(6+3)(4)=18","مساحة شبه المنحرف: القاعدتان <span class=m dir=ltr>6</span> و <span class=m dir=ltr>3 (</span>من <span class=m dir=ltr>5</span> إلى <span class=m dir=ltr>8)</span>"],["4-4+18=18","الإزاحة <span class=m dir=ltr>=</span> مجموع التكاملات"]],"a":"الإزاحة <span class=\"tx\" data-t=\"=18\"></span> <span class=m dir=ltr>m</span>","o":""},{"n":"37","s":[["\\int_0^{10}|v|\\,dt=4+4+18","المسافة <span class=m dir=ltr>=</span> مجموع المساحات (كلها موجبة)"]],"a":"المسافة <span class=\"tx\" data-t=\"=26\"></span> <span class=m dir=ltr>m</span>","o":""},{"n":"38","s":[["x(10)=x(0)+\\int_0^{10}v\\,dt=0+18","الموقع النهائي <span class=m dir=ltr>=</span> الموقع الابتدائي <span class=m dir=ltr>+</span> الإزاحة"]],"a":"الموقع النهائي <span class=\"tx\" data-t=\"x=18\"></span> <span class=m dir=ltr>m (</span>يمين نقطة الأصل)","o":""}],[{"n":"39","s":[["\\sqrt{x}=x^2 \\Rightarrow x=x^4 \\Rightarrow x(x^3-1)=0 \\Rightarrow x=0,\\ x=1","نقاط التقاطع"],["\\sqrt{x}\\ge x^2 \\text{ on } [0,1]","مثلًا <span class=m dir=ltr>x = 0.25</span>: <span class=m dir=ltr>0.5 &gt; 0.0625</span>"],["A=\\int_0^1(\\sqrt{x}-x^2)\\,dx=\\left[\\frac{2}{3}x^{3/2}-\\frac{x^3}{3}\\right]_0^1=\\frac{2}{3}-\\frac{1}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span> وحدة مربعة","o":""}],[{"n":"40","s":[["x^3=x \\Rightarrow x(x-1)(x+1)=0 \\Rightarrow x=-1,0,1","نقاط التقاطع"],["A=\\int_{-1}^{0}(x^3-x)\\,dx+\\int_0^1(x-x^3)\\,dx","في <span class=m dir=ltr>[−1, 0]</span>: <span class=m dir=ltr>f</span> أعلى، وفي <span class=m dir=ltr>[0, 1]</span>: <span class=m dir=ltr>g</span> أعلى"],["=\\left[\\frac{x^4}{4}-\\frac{x^2}{2}\\right]_{-1}^{0}+\\left[\\frac{x^2}{2}-\\frac{x^4}{4}\\right]_0^1=\\frac{1}{4}+\\frac{1}{4}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\"></span> وحدة مربعة","o":""}],[{"n":"41","s":[["g(x)-f(x)=x^2+x+2","بالطرح"],["\\Delta=1-8<0 \\Rightarrow x^2+x+2>0","لا يتقاطع المنحنيان، و <span class=m dir=ltr>g</span> أعلى دائمًا"],["A=\\int_{-2}^{2}(x^2+x+2)\\,dx=\\left[\\frac{x^3}{3}+\\frac{x^2}{2}+2x\\right]_{-2}^{2}",""],["=\\left(\\frac{8}{3}+2+4\\right)-\\left(-\\frac{8}{3}+2-4\\right)=\\frac{40}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{40}{3}\\approx 13.33\"></span> وحدة مربعة","o":""}],[{"n":"43","s":[["s=\\int_1^{10}(t^2-4t)\\,dt=\\left[\\frac{t^3}{3}-2t^2\\right]_1^{10}","الإزاحة <span class=m dir=ltr>=</span> تكامل السرعة"],["=\\left(\\frac{1000}{3}-200\\right)-\\left(\\frac{1}{3}-2\\right)=333-198",""]],"a":"الإزاحة <span class=\"tx\" data-t=\"=135\"></span> <span class=m dir=ltr>m</span>","o":""},{"n":"44","s":[["t^2-4t=0 \\Rightarrow t=0,\\ t=4","أصفار السرعة؛ <span class=m dir=ltr>v &lt; 0</span> في <span class=m dir=ltr>(1, 4)</span> و <span class=m dir=ltr>v &gt; 0</span> في <span class=m dir=ltr>(4, 10)</span>"],["\\int_1^4(t^2-4t)\\,dt=\\left[\\frac{t^3}{3}-2t^2\\right]_1^4=-\\frac{32}{3}+\\frac{5}{3}=-9",""],["\\int_4^{10}(t^2-4t)\\,dt=\\frac{400}{3}+\\frac{32}{3}=144",""],["d=|-9|+144=153","المسافة <span class=m dir=ltr>=</span> مجموع القيم المطلقة"]],"a":"المسافة الكلية <span class=\"tx\" data-t=\"=153\"></span> <span class=m dir=ltr>m</span>","o":""}],[{"n":"45","s":[["(1+\\sin 2x)^2=0 \\Rightarrow \\sin 2x=-1","<span class=m dir=ltr>A</span> نقطة تقاطع المنحنى مع المحور <span class=m dir=ltr>x</span>"],["2x=\\frac{3\\pi}{2} \\Rightarrow x=\\frac{3\\pi}{4}","لأن <span class=m dir=ltr>0 ≤ 2x ≤ 3π/2</span>"]],"a":"<span class=\"tx\" data-t=\"A\\left(\\frac{3\\pi}{4}, 0\\right)\"></span>","o":""},{"n":"46","s":[["(1+\\sin 2x)^2=1+2\\sin 2x+\\sin^2 2x=\\frac{3}{2}+2\\sin 2x-\\frac{1}{2}\\cos 4x","بفك المربع ومتطابقة ضعف الزاوية"],["R=\\int_0^{3\\pi/4}\\left(\\frac{3}{2}+2\\sin 2x-\\frac{1}{2}\\cos 4x\\right)dx=\\left[\\frac{3x}{2}-\\cos 2x-\\frac{\\sin 4x}{8}\\right]_0^{3\\pi/4}",""],["=\\left(\\frac{9\\pi}{8}-\\cos\\frac{3\\pi}{2}-\\frac{\\sin 3\\pi}{8}\\right)-(0-1-0)=\\frac{9\\pi}{8}+1",""]],"a":"<span class=\"tx\" data-t=\"\\frac{9\\pi}{8}+1\\approx 4.534\"></span> وحدة مربعة","o":""}],[{"n":"47","s":[["x^2\\ln 2x=0 \\Rightarrow 2x=1 \\Rightarrow x=\\frac{1}{2}","نقطة التقاطع مع المحور <span class=m dir=ltr>x</span>"],["\\int x^2\\ln 2x\\,dx=\\frac{x^3}{3}\\ln 2x-\\int\\frac{x^2}{3}\\,dx=\\frac{x^3}{3}\\ln 2x-\\frac{x^3}{9}","بالأجزاء: <span class=m dir=ltr>u = ln 2x</span> ، <span class=m dir=ltr>dv = x² dx</span>"],["A=\\left[\\frac{x^3}{3}\\ln 2x-\\frac{x^3}{9}\\right]_{1/2}^{1}=\\left(\\frac{\\ln 2}{3}-\\frac{1}{9}\\right)-\\left(0-\\frac{1}{72}\\right)",""],["=\\frac{\\ln 2}{3}-\\frac{7}{72}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\\ln 2-\\frac{7}{72}\\approx 0.1338\"></span> وحدة مربعة","o":""},{"n":"48","s":[["\\frac{1}{16}x^3=2\\sqrt{x} \\Rightarrow \\frac{x^6}{256}=4x \\Rightarrow x^5=1024 \\Rightarrow x=4","نقطة التقاطع (بالإضافة إلى <span class=m dir=ltr>x = 0)</span>"],["A=\\int_0^4\\left(2\\sqrt{x}-\\frac{1}{16}x^3\\right)dx","<span class=m dir=ltr>g</span> أعلى في الفترة"],["=\\left[\\frac{4}{3}x^{3/2}-\\frac{x^4}{64}\\right]_0^4=\\frac{32}{3}-4=\\frac{20}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{20}{3}\\approx 6.67\"></span> وحدة مربعة","o":""}],[{"n":"49","s":[["x^4+2=x^2+14 \\Rightarrow x^4-x^2-12=0","بمساواة الاقترانين"],["(x^2-4)(x^2+3)=0 \\Rightarrow x^2=4 \\Rightarrow x=\\pm 2","<span class=m dir=ltr>x² + 3 ≠ 0</span>"],["f(2)=4+14=18",""]],"a":"<span class=\"tx\" data-t=\"A(-2, 18)\"></span> ، <span class=\"tx\" data-t=\"B(2, 18)\"></span>","o":""},{"n":"50","s":[["V=\\pi\\int_0^2\\left[(x^2+14)^2-(x^4+2)^2\\right]dx","طريقة الحلقات: <span class=m dir=ltr>f</span> الخارجي و <span class=m dir=ltr>g</span> الداخلي"],["(x^2+14)^2-(x^4+2)^2=-x^8-3x^4+28x^2+192","بالفك والتبسيط"],["V=\\pi\\left[-\\frac{x^9}{9}-\\frac{3x^5}{5}+\\frac{28x^3}{3}+192x\\right]_0^2",""],["=\\pi\\left(-\\frac{512}{9}-\\frac{96}{5}+\\frac{224}{3}+384\\right)=\\frac{17216\\pi}{45}",""]],"a":"<span class=\"tx\" data-t=\"V=\\frac{17216\\pi}{45}\\approx 1201.9\"></span> وحدة مكعبة","o":""}],[{"n":"51","s":[["V=\\pi\\int_1^2\\left(\\sqrt{xe^{-x}}\\right)^2dx=\\pi\\int_1^2 xe^{-x}\\,dx","حجم المجسم الدوراني"],["\\int xe^{-x}\\,dx=-xe^{-x}-e^{-x}","بالأجزاء: <span class=m dir=ltr>u = x</span> ، <span class=m dir=ltr>dv = e^(−x) dx</span>"],["V=\\pi\\left[-xe^{-x}-e^{-x}\\right]_1^2=\\pi\\left(-3e^{-2}+2e^{-1}\\right)",""]],"a":"<span class=\"tx\" data-t=\"V=\\pi\\left(\\frac{2}{e}-\\frac{3}{e^2}\\right)\\approx 1.036\"></span> وحدة مكعبة","o":""}],[{"n":"1","s":[["1+\\cos2x=2\\Rightarrow\\cos2x=1\\Rightarrow x=0,\\ \\pi","نقاط التقاطع"],["A=\\int_0^{\\pi}\\left(2-(1+\\cos2x)\\right)dx=\\int_0^{\\pi}(1-\\cos2x)dx","المستقيم <span class=\"tx\" data-t=\"y=2\"></span> فوق المنحنى"],["=\\left.\\left(x-\\frac{1}{2}\\sin2x\\right)\\right|_0^{\\pi}=\\pi","بالتكامل والتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\pi\\approx3.14\"></span> وحدة مربعة","o":""},{"n":"2","s":[["1+10x-2x^2=1+5x-x^2\\Rightarrow5x-x^2=0\\Rightarrow x=0,\\ 5","نقاط التقاطع"],["A=\\int_0^5\\left[(1+10x-2x^2)-(1+5x-x^2)\\right]dx=\\int_0^5(5x-x^2)dx","الاقتران الأعلى ناقص الأدنى"],["=\\left.\\left(\\frac{5x^2}{2}-\\frac{x^3}{3}\\right)\\right|_0^5=\\frac{125}{2}-\\frac{125}{3}=\\frac{125}{6}","بالتكامل والتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{125}{6}\\approx20.83\"></span> وحدة مربعة","o":""}],[{"n":"3","s":[["3x-x^2=x\\Rightarrow x(2-x)=0\\Rightarrow x=0,\\ 2","نقاط التقاطع"],["A=\\int_0^2\\left[(3x-x^2)-x\\right]dx=\\int_0^2(2x-x^2)dx","المنحنى فوق المستقيم"],["=\\left.\\left(x^2-\\frac{x^3}{3}\\right)\\right|_0^2=4-\\frac{8}{3}=\\frac{4}{3}","بالتكامل والتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{4}{3}\"></span> وحدة مربعة","o":""},{"n":"4","s":[["A=\\int_{-1}^{2}\\left[(x^2+1)-(2x-2)\\right]dx=\\int_{-1}^{2}(x^2-2x+3)dx","المنحنى فوق المستقيم في <span class=\"tx\" data-t=\"[-1,2]\"></span>"],["=\\left.\\left(\\frac{x^3}{3}-x^2+3x\\right)\\right|_{-1}^{2}=\\left(\\frac{8}{3}-4+6\\right)-\\left(-\\frac{1}{3}-1-3\\right)","بالتكامل والتعويض"],["=\\frac{14}{3}+\\frac{13}{3}=9","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"=9\"></span> وحدات مربعة","o":""}],[{"n":"5","s":[["x^2=2-x\\Rightarrow x^2+x-2=0\\Rightarrow(x+2)(x-1)=0\\Rightarrow x=-2,\\ 1","نقاط التقاطع"],["g(0)=2>f(0)=0","إذن <span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\"></span> في <span class=\"tx\" data-t=\"[-2,1]\"></span>"],["A=\\int_{-2}^{1}(2-x-x^2)dx=\\left.\\left(2x-\\frac{x^2}{2}-\\frac{x^3}{3}\\right)\\right|_{-2}^{1}","بالتكامل"],["=\\left(2-\\frac{1}{2}-\\frac{1}{3}\\right)-\\left(-4-2+\\frac{8}{3}\\right)=\\frac{7}{6}+\\frac{10}{3}=\\frac{9}{2}","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{9}{2}=4.5\"></span> وحدة مربعة","o":""}],[{"n":"6","s":[["\\frac{1}{x}=\\frac{1}{x^2}\\Rightarrow x=1","نقطة التقاطع"],["\\frac{1}{x}\\ge\\frac{1}{x^2}\\ \\text{ في }\\ [1,2]","مثلًا عند <span class=\"tx\" data-t=\"x=2\"></span>: <span class=\"tx\" data-t=\"\\frac{1}{2}&gt;\\frac{1}{4}\"></span>"],["A=\\int_1^2\\left(\\frac{1}{x}-\\frac{1}{x^2}\\right)dx=\\left.\\left(\\ln x+\\frac{1}{x}\\right)\\right|_1^2","بالتكامل"],["=\\left(\\ln2+\\frac{1}{2}\\right)-(0+1)=\\ln2-\\frac{1}{2}","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\ln2-\\frac{1}{2}\\approx0.193\"></span> وحدة مربعة","o":""}],[{"n":"7","s":[["\\cos x=1-\\cos x\\Rightarrow\\cos x=\\frac{1}{2}\\Rightarrow x=\\frac{\\pi}{3}","نقطة التقاطع في <span class=\"tx\" data-t=\"[0,\\pi]\"></span>"],["A=\\int_0^{\\pi/3}(2\\cos x-1)dx+\\int_{\\pi/3}^{\\pi}(1-2\\cos x)dx","<span class=\"tx\" data-t=\"f\"></span> فوق <span class=\"tx\" data-t=\"g\"></span> ثم <span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\"></span>"],["\\int_0^{\\pi/3}(2\\cos x-1)dx=\\left.(2\\sin x-x)\\right|_0^{\\pi/3}=\\sqrt3-\\frac{\\pi}{3}","بالتكامل والتعويض"],["\\int_{\\pi/3}^{\\pi}(1-2\\cos x)dx=\\left.(x-2\\sin x)\\right|_{\\pi/3}^{\\pi}=\\pi-\\left(\\frac{\\pi}{3}-\\sqrt3\\right)=\\frac{2\\pi}{3}+\\sqrt3","بالتكامل والتعويض"],["A=2\\sqrt3+\\frac{\\pi}{3}","بالجمع"]],"a":"المساحة <span class=\"tx\" data-t=\"=2\\sqrt3+\\frac{\\pi}{3}\\approx4.511\"></span> وحدة مربعة","o":""}],[{"n":"8","s":[["3\\sqrt x-x\\sqrt x+4=4-\\frac{x}{2}\\Rightarrow\\sqrt x\\left(3-x+\\frac{\\sqrt x}{2}\\right)=0","بمساواة الاقترانين"],["\\text{بفرض } s=\\sqrt x:\\ 3-s^2+\\frac{s}{2}=0\\Rightarrow2s^2-s-6=0\\Rightarrow(2s+3)(s-2)=0","بالتحليل"],["s=2\\Rightarrow x=4,\\quad y=4-\\frac{4}{2}=2","<span class=\"tx\" data-t=\"s=\\sqrt x\\ge0\"></span>، ونرفض <span class=\"tx\" data-t=\"s=-\\frac{3}{2}\"></span>"]],"a":"<span class=\"tx\" data-t=\"A(4,2)\"></span>","o":""},{"n":"9","s":[["A=\\int_0^4\\left[(3\\sqrt x-x^{3/2}+4)-\\left(4-\\frac{x}{2}\\right)\\right]dx=\\int_0^4\\left(3x^{1/2}-x^{3/2}+\\frac{x}{2}\\right)dx","المنحنى فوق المستقيم في <span class=\"tx\" data-t=\"[0,4]\"></span>"],["=\\left.\\left(2x^{3/2}-\\frac{2}{5}x^{5/2}+\\frac{x^2}{4}\\right)\\right|_0^4","بالتكامل"],["=16-\\frac{64}{5}+4=\\frac{36}{5}","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{36}{5}=7.2\"></span> وحدات مربعة","o":""}],[{"n":"10","s":[["\\int_0^1v\\,dt=-\\frac{1}{2}(1)(2)=-1","مساحة المثلث تحت المحور (إشارة سالبة)"],["\\int_1^5v\\,dt=\\frac{1}{2}(1)(2)+(1)(2)+\\frac{1}{2}(2)(2)=1+2+2=5","مثلث <span class=m dir=ltr>+</span> مستطيل <span class=m dir=ltr>+</span> مثلث فوق المحور"],["\\int_5^7v\\,dt=-\\frac{1}{2}(2)(1)=-1","مثلث تحت المحور"],["\\text{الإزاحة}=\\int_0^7v\\,dt=-1+5-1=3","بالجمع"]],"a":"الإزاحة <span class=\"tx\" data-t=\"=3\\ \\text{m}\"></span>","o":"قراءة الشكل: الرؤوس <span class=\"tx\" data-t=\"(0,-2),(2,2),(3,2),(5,0),(6,-1),(7,0)\"></span>؛ المنحنى يقطع المحور <span class=\"tx\" data-t=\"t\"></span> عند <span class=\"tx\" data-t=\"t=1\"></span> و <span class=\"tx\" data-t=\"t=5\"></span> (اعتبرنا <span class=\"tx\" data-t=\"v(6)=-1\"></span> امتدادًا للقطعة نفسها)."},{"n":"11","s":[["\\text{المسافة}=\\int_0^7|v|\\,dt=|-1|+5+|-1|","مجموع المساحات (كلها موجبة)"],["=1+5+1=7","بالجمع"]],"a":"المسافة <span class=\"tx\" data-t=\"=7\\ \\text{m}\"></span>","o":""},{"n":"12","s":[["x(7)=x(0)+\\int_0^7v\\,dt","الموقع النهائي <span class=m dir=ltr>=</span> الموقع الابتدائي <span class=m dir=ltr>+</span> الإزاحة"],["x(7)=2+3=5","بالتعويض"]],"a":"الموقع النهائي: <span class=\"tx\" data-t=\"x=5\\ \\text{m}\"></span>","o":""}],[{"n":"13","s":[["\\frac{1}{2}x^2=\\frac{1}{2}x+3\\Rightarrow x^2-x-6=0\\Rightarrow(x-3)(x+2)=0","نقاط التقاطع"],["x=3","المنطقة المظللة بين <span class=\"tx\" data-t=\"x=0\"></span> و <span class=\"tx\" data-t=\"x=3\"></span>، و <span class=\"tx\" data-t=\"g\"></span> فوق <span class=\"tx\" data-t=\"f\"></span>"],["V=\\pi\\int_0^3\\left[\\left(\\frac{1}{2}x+3\\right)^2-\\left(\\frac{1}{2}x^2\\right)^2\\right]dx=\\pi\\int_0^3\\left(\\frac{x^2}{4}+3x+9-\\frac{x^4}{4}\\right)dx","طريقة الحلقات"],["=\\pi\\left.\\left(\\frac{x^3}{12}+\\frac{3x^2}{2}+9x-\\frac{x^5}{20}\\right)\\right|_0^3=\\pi\\left(\\frac{9}{4}+\\frac{27}{2}+27-\\frac{243}{20}\\right)","بالتكامل والتعويض"],["=\\frac{153\\pi}{5}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"V=\\frac{153\\pi}{5}\\approx96.13\"></span> وحدة مكعبة","o":""}],[{"n":"14","s":[["V=\\pi\\int_e^{e^3}\\left(\\sqrt{\\ln x}\\right)^2dx=\\pi\\int_e^{e^3}\\ln x\\,dx","صيغة الحجم الدوراني <span class=\"tx\" data-t=\"V=\\pi\\int_a^b(f(x))^2dx\"></span>"],["\\int\\ln x\\,dx=x\\ln x-x","التكامل بالأجزاء"],["V=\\pi\\left.(x\\ln x-x)\\right|_e^{e^3}=\\pi\\left[(3e^3-e^3)-(e-e)\\right]=2\\pi e^3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"V=2\\pi e^3\\approx126.20\"></span> وحدة مكعبة","o":""}],[{"n":"15","s":[["\\sqrt{8x}=x^2\\Rightarrow8x=x^4\\Rightarrow x(x^3-8)=0\\Rightarrow x=0,\\ 2","نقاط التقاطع"],["\\sqrt{8x}\\ge x^2\\ \\text{ في }\\ [0,2]","مثلًا عند <span class=\"tx\" data-t=\"x=1\"></span>: <span class=\"tx\" data-t=\"\\sqrt8&gt;1\"></span>"],["V=\\pi\\int_0^2\\left[(\\sqrt{8x})^2-(x^2)^2\\right]dx=\\pi\\int_0^2(8x-x^4)dx","طريقة الحلقات"],["=\\pi\\left.\\left(4x^2-\\frac{x^5}{5}\\right)\\right|_0^2=\\pi\\left(16-\\frac{32}{5}\\right)=\\frac{48\\pi}{5}","بالتكامل والتعويض"]],"a":"<span class=\"tx\" data-t=\"V=\\frac{48\\pi}{5}\\approx30.16\"></span> وحدة مكعبة","o":""}],[{"n":"16","s":[["x^2+4^2=25\\Rightarrow x=\\pm3","نقاط تقاطع المستقيم <span class=\"tx\" data-t=\"y=4\"></span> مع الدائرة"],["y=\\sqrt{25-x^2}","النصف العلوي للدائرة (الحد الخارجي للمنطقة)"],["V=\\pi\\int_{-3}^{3}\\left[(25-x^2)-4^2\\right]dx=\\pi\\int_{-3}^{3}(9-x^2)dx","طريقة الحلقات: نصف القطر الخارجي <span class=\"tx\" data-t=\"\\sqrt{25-x^2}\"></span> والداخلي <span class=m dir=ltr>4</span>"],["=\\pi\\left.\\left(9x-\\frac{x^3}{3}\\right)\\right|_{-3}^{3}=\\pi\\left[(27-9)-(-27+9)\\right]=36\\pi","بالتكامل والتعويض"]],"a":"<span class=\"tx\" data-t=\"V=36\\pi\\approx113.10\"></span> وحدة مكعبة","o":"التبرير: عند الدوران حول المحور <span class=\"tx\" data-t=\"x\"></span> يكون كل مقطع عمودي حلقة دائرية نصف قطرها الخارجي المسافة إلى الدائرة <span class=\"tx\" data-t=\"\\sqrt{25-x^2}\"></span> والداخلي المسافة إلى المستقيم <span class=\"tx\" data-t=\"y=4\"></span>، لذلك نطرح <span class=\"tx\" data-t=\"\\pi(4)^2\"></span> من <span class=\"tx\" data-t=\"\\pi(25-x^2)\"></span> ونكامل من <span class=\"tx\" data-t=\"-3\"></span> إلى <span class=\"tx\" data-t=\"3\"></span>."}]]