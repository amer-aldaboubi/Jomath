[[{"n":"1","s":[["f'(x)=9x^2-8x+5",""],["f''(x)=18x-8",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=18x-8\"></span>","o":""},{"n":"2","s":[["f'(x)=-6x^{-4}",""],["f''(x)=24x^{-5}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=\\frac{24}{x^5}\"></span>","o":""},{"n":"3","s":[["f(x)=x^3-5x^{-1}",""],["f'(x)=3x^2+5x^{-2}",""],["f''(x)=6x-10x^{-3}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=6x-\\frac{10}{x^3}\"></span>","o":""},{"n":"4","s":[["f(x)=x^{\\frac12}",""],["f'(x)=\\frac12x^{-\\frac12}",""],["f''(x)=-\\frac14x^{-\\frac32}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=-\\frac{1}{4\\sqrt{x^3}}\"></span>","o":""},{"n":"5","s":[["f'(x)=-4+2x-3x^2",""],["f''(x)=2-6x",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=2-6x\"></span>","o":""}],[{"n":"6","s":[["f'(x)=24x^2-3-4x^{-2}",""],["f''(x)=48x+8x^{-3}",""],["f''(-2)=-96+\\frac{8}{-8}=-97","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(-2)=-97\"></span>","o":""},{"n":"7","s":[["f(x)=x^{\\frac32}",""],["f'(x)=\\frac32x^{\\frac12},\\quad f''(x)=\\frac34x^{-\\frac12}",""],["f''(4)=\\frac34\\times\\frac12=\\frac38",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(4)=\\frac38\"></span>","o":""}],[{"n":"8","s":[["y'=4x^3-4x=4x(x-1)(x+1)",""],["x=0,\\ x=\\pm1","النقاط الحرجة"],["y''=12x^2-4",""],["y''(0)=-4<0;\\quad y''(\\pm1)=8>0","اختبار المشتقة الثانية"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"0\"></span> عند <span class=\"tx\" data-t=\"x=0\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-1\"></span> عند <span class=\"tx\" data-t=\"x=\\pm1\"></span>","o":""},{"n":"9","s":[["f'(x)=12x^3-24x^2+12x=12x(x-1)^2",""],["x=0,\\ x=1","النقاط الحرجة"],["f''(x)=36x^2-48x+12",""],["f''(0)=12>0","صغرى محلية عند <span class=m dir=ltr>x = 0</span>"],["f''(1)=0","الاختبار يفشل؛ <span class=m dir=ltr>f&#x27;</span> موجبة على جانبي <span class=m dir=ltr>1</span> فلا قيمة قصوى"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"f(0)=0\"></span>، ولا قيمة قص