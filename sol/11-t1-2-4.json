 dir=ltr>v = 0</span>"]],"a":"<span class=\"tx\" data-t=\"t=4\"></span> ثوانٍ","o":""}],[{"n":"19","s":[["y=x^2-x^{-1}",""],["\\frac{dy}{dx}=2x+x^{-2},\\quad \\frac{d^2y}{dx^2}=2-2x^{-3}",""],["x\\frac{d^2y}{dx^2}+2\\frac{dy}{dx}=2x-2x^{-2}+4x+2x^{-2}","بالتعويض"],["=6x",""]],"a":"تم الإثبات","o":""}],[{"n":"20","s":[["f(x)=-x^3+6x^2","إجابة ممكنة"],["f''(x)=-6x+12=6(2-x)",""],["f''(2)=0",""],["x>2:\\ f''<0;\\quad x<2:\\ f''>0",""]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"f(x)=-x^3+6x^2\"></span>","o":""}],[{"n":"21","s":[["2^4-3(2)^2+2(2)-8=0","<span class=m dir=ltr>x − 2</span> عامل من عوامل البسط"],["f(x)=x^3+2x^2+x+4,\\ x\\ne2","بالقسمة"],["f''(x)=6x+4=0\\Rightarrow x=-\\frac23",""],["f\\left(-\\tfrac23\\right)=-\\frac{8}{27}+\\frac89-\\frac23+4=\\frac{106}{27}",""]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(-\\frac23,\\frac{106}{27}\\right)\"></span>","o":""}],[{"n":"22","s":[["f'(-1)=0,\\ f'(4)=0","عند القيمتين العظمى والصغرى"],["x<-1\\ \\text{or}\\ x>4:\\ f'>0","<span class=m dir=ltr>f</span> متزايد"],["-1<x<4:\\ f'<0","<span class=m dir=ltr>f</span> متناقص"]],"a":"منحنى <span class=\"tx\" data-t=\"f&#x27;\"></span> قطع مكافئ مفتوح للأعلى يقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"-1\"></span> و <span class=\"tx\" data-t=\"4\"></span>، ورأسه عند <span class=\"tx\" data-t=\"x=1.5\"></span> تحت المحور","o":"يكون <span class=\"tx\" data-t=\"f&#x27;\"></span> فوق محور <span class=m dir=ltr>x</span> قبل <span class=m dir=ltr>−1</span> وبعد <span class=m dir=ltr>4</span>، وتحته بينهما"}],[{"n":"23","s":[["v(t)=3t^2-12,\\quad a(t)=6t",""],["6t=0\\Rightarrow t=0","التسارع صفر"],["v(0)=-12",""]],"a":"<span class=\"tx\" data-t=\"-12\\ \\text{m/s}\"></span> (يتحرك في الاتجاه السالب بمقدار <span class=m dir=ltr>12)</span>","o":""}],[{"n":"24","s":[["v(t)=6t^2-24=0\\Rightarrow t^2=4\\Rightarrow t=2","<span class=m dir=ltr>t ≥ 0</span>"],["a(t)=12t",""],["a(2)=24",""]],"a":"<span class=\"tx\" data-t=\"24\\ \\text{m/s}^2\"></span>","o":""}],[{"n":"5","s":[["f'(x) = 3(1-x)^2\\times(-1) = -3(1-x)^2","قاعدة السلسلة"],["f''(x) = -3\\times 2(1-x)\\times(-1) = 6(1-x)","باشتقاق <span class=\"tx\" data-t=\"f&#x27;(x)\"></span> مرة أخرى"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"6(1-x)\"></span>","o":""}],[{"n":"23","s":[["f'(x) = 24-6x^2 = 0 \\Rightarrow x^2 = 4 \\Rightarrow x = \\pm 2","النقاط الحرجة"],["f''(x) = -12x","المشتقة الثانية"],["f''(2) = -24 < 0,\\quad f(2) = 9+48-16 = 41","قيمة عظمى محلية"],["f''(-2) = 24 > 0,\\quad f(-2) = 9-48+16 = -23","قيمة صغرى محلية"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"41\"></span> عند <span class=\"tx\" data-t=\"x=2\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-23\"></span> عند <span class=\"tx\" data-t=\"x=-2\"></span>","o":""},{"n":"24","s":[["f'(x) = 3(3x-2)^2(3)-9 = 9(3x-2)^2-9","قاعدة السلسلة"],["(3x-2)^2 = 1 \\Rightarrow 3x-2 = \\pm 1 \\Rightarrow x = 1 \\text{ or } x = \\frac{1}{3}","نجعل المشتقة صفرًا"],["f''(x) = 54(3x-2)","المشتقة الثانية"],["f''(1) = 54 > 0,\\quad f(1) = 1-9 = -8","قيمة صغرى محلية"],["f''\\left(\\tfrac{1}{3}\\right) = -54 < 0,\\quad f\\left(\\tfrac{1}{3}\\right) = (-1)^3-3 = -4","قيمة عظمى محلية"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"-4\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{1}{3}\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-8\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>","o":""},{"n":"25","s":[["f'(x) = 20x^4-20x = 20x(x^3-1) = 0","نجعل المشتقة صفرًا"],["x = 0 \\text{ or } x = 1","النقاط الحرجة"],["f''(x) = 80x^3-20","المشتقة الثانية"],["f''(0) = -20 < 0,\\quad f(0) = 0","قيمة عظمى محلية"],["f''(1) = 60 > 0,\\quad f(1) = 4-10 = -6","قيمة صغرى محلية"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"0\"></span> عند <span class=\"tx\" data-t=\"x=0\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-6\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>","o":""}],[{"n":"32","s":[["v(t) = s'(t) = 6-t","السرعة المتجهة هي مشتقة الموقع"],["v(10) = 6-10 = -4 \\text{ m/s}","بالتعويض <span class=\"tx\" data-t=\"t=10\"></span>"],["|v(10)| = 4 \\text{ m/s}","السرعة القياسية هي القيمة المطلقة للسرعة المتجهة"]],"a":"سرعة السيارة بعد <span class=m dir=ltr>10</span> ثوانٍ <span class=\"tx\" data-t=\"4\\ \\text{m/s}\"></span> (السرعة المتجهة <span class=\"tx\" data-t=\"-4\\ \\text{m/s}\"></span>، أي تتحرك في الاتجاه السالب)","o":""}],[{"n":"1","s":[["f'(x) = 15x^2+4","المشتقة الأولى"],["f''(x) = 30x","باشتقاق <span class=\"tx\" data-t=\"f&#x27;(x)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x) = 30x\"></span>","o":""},{"n":"2","s":[["f(x) = x^{\\frac{1}{3}} \\Rightarrow f'(x) = \\frac{1}{3}x^{-\\frac{2}{3}}","قاعدة القوة"],["f''(x) = \\frac{1}{3}\\times\\left(-\\frac{2}{3}\\right)x^{-\\frac{5}{3}} = -\\frac{2}{9}x^{-\\frac{5}{3}}","باشتقاق <span class=\"tx\" data-t=\"f&#x27;(x)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x) = -\\frac{2}{9}x^{-\\frac{5}{3}} = -\\frac{2}{9\\sqrt[3]{x^5}}\"></span>","o":""},{"n":"3","s":[["f(x) = 2x^2+x-3","بالتوزيع"],["f'(x) = 4x+1","المشتقة الأولى"],["f''(x) = 4","المشتقة الثانية"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x) = 4\"></span>","o":""}],[{"n":"4","s":[["f(x) = \\frac{4}{3}x^{-1}","بكتابة الكسر على صورة أُس سالب"],["f'(x) = -\\frac{4}{3}x^{-2},\\quad f''(x) = \\frac{8}{3}x^{-3} = \\frac{8}{3x^3}","قاعدة القوة مرتين"],["f''(2) = \\frac{8}{3(8)} = \\frac{1}{3}","بالتعويض <span class=\"tx\" data-t=\"x=2\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(2) = \\frac{1}{3}\"></span>","o":""},{"n":"5","s":[["f'(x) = -14x","المشتقة الأولى"],["f''(x) = -14","المشتقة الثانية ثابتة"],["f''(-3) = -14",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(-3) = -14\"></span>","o":""}],[{"n":"6","s":[["f'(x) = 4ax^3-6x","المشتقة الأولى"],["f''(x) = 12ax^2-6","المشتقة الثانية"],["12a(2)^2-6 = 42 \\Rightarrow 48a = 48","بالتعويض <span class=\"tx\" data-t=\"x=2\"></span>"],["a = 1","بقسمة الطرفين على <span class=m dir=ltr>48</span>"]],"a":"<span class=\"tx\" data-t=\"a = 1\"></span>","o":""}],[{"n":"7","s":[["(x-1)^2(x+2) = 0","عند نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span> يكون <span class=\"tx\" data-t=\"f(x)=0\"></span>"],["x = 1 \\text{ or } x = -2","خاصية الضرب الصفري"]],"a":"النقطتان <span class=\"tx\" data-t=\"(1, 0)\"></span> و <span class=\"tx\" data-t=\"(-2, 0)\"></span>","o":""},{"n":"8","s":[["f(x) = (x^2-2x+1)(x+2) = x^3-3x+2","بالتوزيع والتبسيط"],["f'(x) = 3x^2-3 = 0 \\Rightarrow x = \\pm 1","النقاط الحرجة"],["f''(x) = 6x","المشتقة الثانية"],["f''(1) = 6 > 0,\\quad f(1) = 0","صغرى محلية"],["f''(-1) = -6 < 0,\\quad f(-1) = -1+3+2 = 4","عظمى محلية"]],"a":"<span class=\"tx\" data-t=\"(1, 0)\"></span> نقطة صغرى محلية، و <span class=\"tx\" data-t=\"(-1, 4)\"></span> نقطة عظمى محلية","o":""}],[{"n":"9","s":[["f'(x) = 4x+4 = 0 \\Rightarrow x = -1","النقطة الحرجة"],["f''(x) = 4 > 0","صغرى محلية"],["f(-1) = 2-4-3 = -5","بالتعويض"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-5\"></span> عند <span class=\"tx\" data-t=\"x=-1\"></span>، ولا توجد قيمة عظمى محلية","o":""},{"n":"10","s":[["f(x) = x^4-2x^3,\\quad f'(x) = 4x^3-6x^2 = 2x^2(2x-3)","بالتوزيع ثم الاشتقاق"],["f'(x) = 0 \\Rightarrow x = 0 \\text{ or } x = \\frac{3}{2}","النقاط الحرجة"],["f''(x) = 12x^2-12x,\\quad f''\\left(\\tfrac{3}{2}\\right) = 27-18 = 9 > 0","صغرى محلية عند <span class=\"tx\" data-t=\"x=\\frac{3}{2}\"></span>"],["f\\left(\\tfrac{3}{2}\\right) = \\frac{81}{16}-\\frac{27}{4} = -\\frac{27}{16}","قيمة الصغرى المحلية"],["f''(0) = 0","الاختبار يفشل؛ وإشارة <span class=\"tx\" data-t=\"f&#x27;\"></span> سالبة قبل <span class=m dir=ltr>0</span> وبعده، فلا توجد قيمة قصوى عند <span class=\"tx\" data-t=\"x=0\"></span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-\\frac{27}{16}\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{3}{2}\"></span> فقط","o":""},{"n":"11","s":[["f'(x) = 3x^2-10x+3 = (3x-1)(x-3) = 0","نجعل المشتقة صفرًا"],["x = \\frac{1}{3} \\text{ or } x = 3","النقاط الحرجة"],["f''(x) = 6x-10","المشتقة الثانية"],["f''\\left(\\tfrac{1}{3}\\right) = -8 < 0,\\quad f\\left(\\tfrac{1}{3}\\right) = \\frac{40}{27}","قيمة عظمى محلية"],["f''(3) = 8 > 0,\\quad f(3) = 27-45+9+1 = -8","قيمة صغرى محلية"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"\\frac{40}{27}\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{1}{3}\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-8\"></span> عند <span class=\"tx\" data-t=\"x=3\"></span>","o":""}],[{"n":"12","s":[["v(t) = s'(t) = 12t-2","السرعة هي مشتقة الموقع"],["v(5) = 60-2 = 58","بالتعويض <span class=\"tx\" data-t=\"t=5\"></span>"]],"a":"<span class=\"tx\" data-t=\"58\\ \\text{m/s}\"></span>","o":""},{"n":"13","s":[["a(t) = v'(t) = 12","التسارع هو مشتقة السرعة"],["a(5) = 12","التسارع ثابت"]],"a":"<span class=\"tx\" data-t=\"12\\ \\text{m/s}^2\"></span>","o":""},{"n":"14","s":[["v(t) = 0 \\Rightarrow 12t-2 = 0","في السكون اللحظي تكون السرعة صفرًا"],["t = \\frac{2}{12} = \\frac{1}{6}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"t = \\frac{1}{6}\\ \\text{s}\"></span>","o":""}]]