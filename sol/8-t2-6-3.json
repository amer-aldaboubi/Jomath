r>−2</span>"]],"a":"الحل <span class=\"tx\" data-t=\"(-2, -5)\"></span>","o":"","k":[{"p":["-2","-5"]}]},{"n":"26","s":[["5x + 5y = 15,\\quad 2x + y = 3","بترتيب المعادلتين"],["x + y = 3","بقسمة المعادلة الأولى على <span class=m dir=ltr>5</span>"],["(2x + y) - (x + y) = 3 - 3 \\Rightarrow x = 0","بالطرح لحذف <span class=\"tx\" data-t=\"y\"></span>"],["0 + y = 3 \\Rightarrow y = 3","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(0, 3)\"></span>","o":"","k":[{"p":["0","3"]}]}],[{"n":"32","s":[["(2x - 3y) + (-x + 3y) = -9 + 6","بجمع المعادلتين لحذف <span class=\"tx\" data-t=\"y\"></span>"],["x = -3","بالتبسيط"],["-(-3) + 3y = 6 \\Rightarrow 3y = 3","بالتعويض في المعادلة الثانية"],["y = 1","بقسمة الطرفين على <span class=m dir=ltr>3</span>"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"(-3, 1)\"></span>","o":"","k":[{"p":["-3","1"]}]}],[{"n":"1","s":[["5x = 25 \\Rightarrow x = 5","بجمع المعادلتين لحذف <span class=\"tx\" data-t=\"y\"></span>"],["3(5) + 2y = 11 \\Rightarrow y = -2","بالتعويض في الأولى"]],"a":"الحل <span class=\"tx\" data-t=\"(5, -2)\"></span>","o":"","k":[{"p":["5","-2"]}]},{"n":"2","s":[["2x = 14 \\Rightarrow x = 7","بطرح الثانية من الأولى لحذف <span class=\"tx\" data-t=\"y\"></span>"],["7 - 4y = 3 \\Rightarrow y = 1","بالتعويض في الثانية"]],"a":"الحل <span class=\"tx\" data-t=\"(7, 1)\"></span>","o":"","k":[{"p":["7","1"]}]},{"n":"3","s":[["3x + 2y = 16,\\quad x - 2y = 4","بترتيب المعادلة الأولى"],["4x = 20 \\Rightarrow x = 5","بالجمع لحذف <span class=\"tx\" data-t=\"y\"></span>"],["5 - 2y = 4 \\Rightarrow y = \\frac{1}{2}","بالتعويض في الثانية"]],"a":"الحل <span class=\"tx\" data-t=\"(5, 0.5)\"></span>","o":"","k":[{"p":["5","0.5"]}]},{"n":"4","s":[["2x + y = 11","بإعادة ترتيب الثانية"],["4y = 26 \\Rightarrow y = 6.5","بطرح الثانية من الأولى لحذف <span class=\"tx\" data-t=\"x\"></span>"],["2x + 6.5 = 11 \\Rightarrow x = 2.25","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"\\left(\\frac{9}{4}, \\frac{13}{2}\\right) = (2.25, 6.5)\"></span>","o":""},{"n":"5","s":[["x + 3y = 13","بإعادة ترتيب الثانية"],["5x = 20 \\Rightarrow x = 4","بجمع المعادلتين لحذف <span class=\"tx\" data-t=\"y\"></span>"],["4 + 3y = 13 \\Rightarrow y = 3","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(4, 3)\"></span>","o":"","k":[{"p":["4","3"]}]},{"n":"6","s":[["x - y = 2","بإعادة ترتيب الثانية"],["3x = 15 \\Rightarrow x = 5","بطرح الثانية من الأولى لحذف <span class=\"tx\" data-t=\"y\"></span>"],["5 - y = 2 \\Rightarrow y = 3","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(5, 3)\"></span>","o":"","k":[{"p":["5","3"]}]},{"n":"7","s":[["2x + 4y = 14","بضرب الثانية في <span class=m dir=ltr>2</span>"],["-y = -1 \\Rightarrow y = 1","بطرحها من الأولى لحذف <span class=\"tx\" data-t=\"x\"></span>"],["x + 2(1) = 7 \\Rightarrow x = 5","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(5, 1)\"></span>","o":"","k":[{"p":["5","1"]}]},{"n":"8","s":[["3x - 3y = -3 \\Rightarrow x - y = -1","بترتيب الأولى ثم القسمة على <span class=m dir=ltr>3</span>"],["2x - 2y = -2","بالضرب في <span class=m dir=ltr>2</span>"],["-4y = 4 \\Rightarrow y = -1","بطرحها من <span class=\"tx\" data-t=\"2x - 6y = 2\"></span> لحذف <span class=\"tx\" data-t=\"x\"></span>"],["x - (-1) = -1 \\Rightarrow x = -2","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(-2, -1)\"></span>","o":"","k":[{"p":["-2","-1"]}]},{"n":"9","s":[["2x - 4y = 6,\\quad 3x + 7y = 9","بترتيب المعادلتين"],["6x - 12y = 18,\\quad 6x + 14y = 18","بضرب الأولى في <span class=m dir=ltr>3</span> والثانية في <span class=m dir=ltr>2</span>"],["-26y = 0 \\Rightarrow y = 0","بالطرح لحذف <span class=\"tx\" data-t=\"x\"></span>"],["2x = 6 \\Rightarrow x = 3","بالتعويض في الأولى"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 0)\"></span>","o":"","k":[{"p":["3","0"]}]}],[{"n":"10","s":[["g + s = 32","<span class=\"tx\" data-t=\"g\"></span> الذهبية و <span class=\"tx\" data-t=\"s\"></span> الفضية"],["2s - g = 4","مثلا الفضية يزيد <span class=m dir=ltr>4</span> عن الذهبية"],["3s = 36 \\Rightarrow s = 12","بجمع المعادلتين لحذف <span class=\"tx\" data-t=\"g\"></span>"],["g = 32 - 12 = 20","بالتعويض"],["2(12) - 20 = 4 \\checkmark","التحقق"]],"a":"<span class=\"tx\" data-t=\"20\"></span> ميدالية ذهبية و <span class=\"tx\" data-t=\"12\"></span> ميدالية فضية","o":"","k":[{"e":"20","a":null},{"e":"12","a":null}]}],[{"n":"11","s":[["\\frac{4x - 2y}{2} = \\frac{8}{2} \\Rightarrow 2x - y = 4","بقسمة المعادلة الأولى على <span class=m dir=ltr>2</span> تنتج المعادلة الثانية نفسها"],["0 = 0","عند الحذف تختفي المتغيرات وتنتج عبارة صحيحة دائمًا: المستقيمان منطبقان"],["2(5) - 6 = 4,\\quad 2(6) - 8 = 4","مثلًا <span class=\"tx\" data-t=\"(5, 6)\"></span> و <span class=\"tx\" data-t=\"(6, 8)\"></span> كلاهما حل للنظام"]],"a":"المعادلتان متكافئتان (المستقيمان منطبقان)، فللنظام عدد لا نهائي من الحلول؛ <span class=\"tx\" data-t=\"(5, 6)\"></span> حلٌّ لكنه ليس الحل الوحيد","o":""}],[{"n":"12","s":[["6x - 2y = 5,\\quad 6x - 2y = 6","بضرب المعادلة <span class=\"tx\" data-t=\"3x - y = 3\"></span> في <span class=m dir=ltr>2</span>"],["0 = -1","بالطرح: عبارة خاطئة، فلا يوجد حل (مستقيمان متوازيان)"],["(2, -1),\\ (-2, 2),\\ (4, 1)","حلول الأنظمة الثلاثة الأخرى على الترتيب: لكلٍّ منها حل واحد"]],"a":"النظام المختلف هو <span class=\"tx\" data-t=\"6x - 2y = 5,\\ 3x - y = 3\"></span> لأنه لا حل له، بينما لكلٍّ من الأنظمة الأخرى حل واحد","o":""}]]