an> ↔ <span class=\"tx\" data-t=\"5x+2y=1\"></span> و <span class=\"tx\" data-t=\"3x-y=5\"></span> ؛ <span class=\"tx\" data-t=\"(-1,3)\"></span> ↔ <span class=\"tx\" data-t=\"5x+2y=1\"></span> و <span class=\"tx\" data-t=\"3x+2y=3\"></span> ؛ <span class=\"tx\" data-t=\"(2,1)\"></span> ↔ <span class=\"tx\" data-t=\"4x+y=9\"></span> و <span class=\"tx\" data-t=\"3x-y=5\"></span> ؛ <span class=\"tx\" data-t=\"(3,-3)\"></span> ↔ <span class=\"tx\" data-t=\"4x+y=9\"></span> و <span class=\"tx\" data-t=\"3x+2y=3\"></span>","o":""}],[{"n":"15","s":[["3x-y=-3","<span class=m dir=ltr>x</span> العدد الأول، <span class=m dir=ltr>y</span> العدد الآخر"],["x+y=11",""],["4x=8\\Rightarrow x=2","بجمع المعادلتين"],["2+y=11\\Rightarrow y=9","بالتعويض"]],"a":"العددان: <span class=m dir=ltr>2</span> و <span class=m dir=ltr>9</span>","o":""}],[{"n":"16","s":[["3s+4r=12","<span class=m dir=ltr>s</span> كتلة كيس السكر، <span class=m dir=ltr>r</span> كتلة كيس الأرز <span class=m dir=ltr>(kg)</span>"],["5s+2r=13",""],["10s+4r=26\\Rightarrow 7s=14\\Rightarrow s=2","بضرب الثانية في <span class=m dir=ltr>2</span> وطرح الأولى"],["6+4r=12\\Rightarrow r=1.5","بالتعويض"],["2(2)+5(1.5)=4+7.5=11.5","المطلوب"]],"a":"كتلة كيسين من السكر وخمسة أكياس من الأرز <span class=\"tx\" data-t=\"11.5\\,\\text{kg}\"></span>","o":""}],[{"n":"17","s":[["x+y=21.6","<span class=m dir=ltr>x</span> ارتفاع المبنى، <span class=m dir=ltr>y</span> طول السارية <span class=m dir=ltr>(m)</span>"],["x-y=10.4",""],["2x=32\\Rightarrow x=16","بجمع المعادلتين"],["16+y=21.6\\Rightarrow y=5.6","بالتعويض"]],"a":"ارتفاع المبنى <span class=\"tx\" data-t=\"16\\,\\text{m}\"></span> ، وطول السارية <span class=\"tx\" data-t=\"5.6\\,\\text{m}\"></span>","o":"","k":[{"e":"16","a":null},{"e":"5.6","a":true}]}],[{"n":"18","s":[["x+y=40","<span class=m dir=ltr>x</span> دقائق الإطالة، <span class=m dir=ltr>y</span> دقائق التمارين الهوائية"],["4x+11y=335","السعرات"],["4x+4y=160\\Rightarrow 7y=175\\Rightarrow y=25","بضرب الأولى في <span class=m dir=ltr>4</span> والطرح"],["x=40-25=15","بالتعويض"],["4(15)+11(25)=60+275=335","التحقق"]],"a":"<span class=m dir=ltr>15</span> دقيقة تمارين إطالة و <span class=m dir=ltr>25</span> دقيقة تمارين هوائية","o":"مسألة أستكشف ص<span class=m dir=ltr>56</span>"}],[{"n":"19","s":[["-4(x-2y)=-4(-13)\\Rightarrow -4x+8y=52","الخطأ: لم يُضرب الطرف الأيمن في <span class=m dir=ltr>−4</span>"],["11y=60\\Rightarrow y=\\frac{60}{11}","بجمع المعادلتين"],["x=-13+2\\left(\\frac{60}{11}\\right)=-\\frac{23}{11}","بالتعويض في <span class=\"tx\" data-t=\"x=2y-13\"></span>"],["4\\left(-\\frac{23}{11}\\right)+3\\left(\\frac{60}{11}\\right)=\\frac{88}{11}=8","التحقق"]],"a":"الحل الصحيح: <span class=\"tx\" data-t=\"\\left(-\\frac{23}{11},\\ \\frac{60}{11}\\right)\"></span>","o":"","k":[{"p":["-23/11","60/11"]}]}],[{"n":"20","s":[["a=1:\\ x+3y=4","أختار <span class=\"tx\" data-t=\"a=1\"></span>"],["(x+3y)-(x+y)=4-4\\Rightarrow 2y=0\\Rightarrow y=0","بالطرح"],["x=4","بالتعويض"],["a=3\\Rightarrow 3x+3y=4,\\ 3x+3y=12","إذا كانت <span class=\"tx\" data-t=\"a=3\"></span> يتوازى المستقيمان فلا حل"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"a=1\"></span> فيكون الحل <span class=\"tx\" data-t=\"(4,0)\"></span>؛ أي قيمة <span class=\"tx\" data-t=\"a\\ne 3\"></span> تجعل للنظام حلًّا وحيدًا لأن الميلين يختلفان","o":""}],[{"n":"21","s":[["t + u = 8","نفرض رقم العشرات <span class=\"tx\" data-t=\"t\"></span> ورقم الآحاد <span class=\"tx\" data-t=\"u\"></span>: مجموع الرقمين <span class=m dir=ltr>8</span>"],["u + 2t = 10","رقم الآحاد مضافًا إلى مثلَي رقم العشرات"],["(u + 2t) - (t + u) = 10 - 8 \\Rightarrow t = 2","بطرح المعادلة الأولى من الثانية (حذف <span class=\"tx\" data-t=\"u\"></span>)"],["2 + u = 8 \\Rightarrow u = 6","بالتعويض في المعادلة الأولى"],["6 + 2(2) = 10 \\checkmark","التحقق"]],"a":"العدد هو <span class=\"tx\" data-t=\"26\"></span>","o":"","k":[{"e":"26","a":null}]}],[{"n":"22","s":[["ax + by = c","أرتّب المعادلتين بهذه الصورة بحيث تكون المتغيرات متقابلة"],["a_1 = a_2 \\Rightarrow (-),\\quad