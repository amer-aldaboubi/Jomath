[[{"n":"1","s":[["(2, 6),\\ (-3, 6)","عنصران مختلفان لهما الصورة نفسها <span class=m dir=ltr>6</span>"]],"a":"<span class=\"tx\" data-t=\"f\"></span> ليس واحدًا لواحد، إذن ليس له اقتران عكسي","o":""},{"n":"2","s":[["0, 1, 16, 81","صور مختلفة لعناصر مختلفة؛ فهو واحد لواحد"],["h^{-1} = \\{(0,0), (1,1), (16,2), (81,3)\\}","بتبديل مسقطي كل زوج"]],"a":"له اقتران عكسي: <span class=\"tx\" data-t=\"h^{-1} = \\{(0,0),(1,1),(16,2),(81,3)\\}\"></span>","o":""},{"n":"3","s":[["4\\to7,\\ 5\\to9,\\ 7\\to13,\\ 8\\to15","لكل عنصر صورة مختلفة؛ فهو واحد لواحد"],["f^{-1} = \\{(7,4), (9,5), (13,7), (15,8)\\}","بعكس الأسهم"]],"a":"له اقتران عكسي: <span class=\"tx\" data-t=\"f^{-1} = \\{(7,4),(9,5),(13,7),(15,8)\\}\"></span>","o":""},{"n":"4","s":[["g(-3) = 3,\\ g(3) = 3","عنصران مختلفان لهما الصورة نفسها"]],"a":"<span class=\"tx\" data-t=\"g\"></span> ليس واحدًا لواحد، إذن ليس له اقتران عكسي","o":""}],[{"n":"5","s":[["f(-2) = 3\\left(\\frac{-2}{2} + 4\\right) = 3(3) = 9",""]],"a":"<span class=\"tx\" data-t=\"f(-2) = 9\"></span>","o":""},{"n":"6","s":[["f(4) = 3\\left(\\frac{4}{2} + 4\\right) = 3(6) = 18",""]],"a":"<span class=\"tx\" data-t=\"f(4) = 18\"></span>","o":""},{"n":"7","s":[["f(x) = 9 \\Rightarrow 3\\left(\\frac{x}{2} + 4\\right) = 9","<span class=\"tx\" data-t=\"f^{-1}(9)\"></span> هو العدد الذي صورته <span class=m dir=ltr>9</span>"],["\\frac{x}{2} + 4 = 3 \\Rightarrow x = -2",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(9) = -2\"></span>","o":""},{"n":"8","s":[["f(x) = 18 \\Rightarrow \\frac{x}{2} + 4 = 6 \\Rightarrow x = 4","من الفرع <span class=m dir=ltr>6</span>: <span class=\"tx\" data-t=\"f(4)=18\"></span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(18) = 4\"></span>","o":""}],[{"n":"9","s":[["y = x + 7 \\Rightarrow x = y - 7","بطرح <span class=m dir=ltr>7</span> من الطرفين"],["f^{-1}(x) = x - 7","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = x-7\"></span>","o":""},{"n":"10","s":[["y = 8x \\Rightarrow x = \\frac{y}{8}","بقسمة الطرفين على <span class=m dir=ltr>8</span>"],["f^{-1}(x) = \\frac{x}{8}",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = \\frac{x}{8}\"></span>","o":""},{"n":"11","s":[["y = \\frac{x}{2} + 6 \\Rightarrow y - 6 = \\frac{x}{2}","بطرح <span class=m dir=ltr>6</span> من الطرفين"],["x = 2y - 12","بضرب الطرفين في <span class=m dir=ltr>2</span>"],["f^{-1}(x) = 2x - 12",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = 2x-12\"></span>","o":""},{"n":"12","s":[["y = \\frac{3x - 6}{5} \\Rightarrow 5y = 3x - 6","بضرب الطرفين في <span class=m dir=ltr>5</span>"],["x = \\frac{5y + 6}{3}","بإضافة <span class=m dir=ltr>6</span> ثم القسمة على <span class=m dir=ltr>3</span>"],["f^{-1}(x) = \\frac{5x + 6}{3}",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = \\frac{5x+6}{3}\"></span>","o":""},{"n":"13","s":[["y = 4x^3 \\Rightarrow x^3 = \\frac{y}{4}","بقسمة الطرفين على <span class=m dir=ltr>4</span>"],["x = \\sqrt[3]{\\frac{y}{4}}","بأخذ الجذر التكعيبي"],["f^{-1}(x) = \\sqrt[3]{\\frac{x}{4}}",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = \\sqrt[3]{\\frac{x}{4}}\"></span>","o":""},{"n":"14","s":[["y = 4 + \\sqrt{6 - 3x},\\ y \\ge 4","مدى <span class=\"tx\" data-t=\"g\"></span> هو <span class=\"tx\" data-t=\"y \\ge 4\"></span>"],["(y - 4)^2 = 6 - 3x","بطرح <span class=m dir=ltr>4</span> ثم تربيع الطرفين"],["x = \\frac{6 - (y-4)^2}{3} = 2 - \\frac{(y-4)^2}{3}",""],["g^{-1}(x) = 2 - \\frac{(x-4)^2}{3},\\ x \\ge 4","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"g^{-1}(x) = 2-\\frac{(x-4)^2}{3}\"></span> ، حيث <span class=\"tx\" data-t=\"x \\ge 4\"></span>","o":""},{"n":"15","s":[["y = \\frac{8 - 3x}{5x} \\Rightarrow 5xy = 8 - 3x","بضرب الطرفين في <span class=\"tx\" data-t=\"5x\"></span>"],["5xy + 3x = 8 \\Rightarrow x(5y + 3) = 8","بإخراج <span class=\"tx\" data-t=\"x\"></span> عاملًا مشتركًا"],["x = \\frac{8}{5y + 3}",""],["g^{-1}(x) = \\frac{8}{5x + 3},\\ x \\ne -\\frac{3}{5}","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"g^{-1}(x) = \\frac{8}{5x+3}\"></span> ، حيث <span class=\"tx\" data-t=\"x \\ne -\\frac{3}{5}\"></span>","o":""},{"n":"16","s":[["y = (x-2)^2 + 4,\\ x \\ge 2,\\ y \\ge 4","مدى <span class=\"tx\" data-t=\"j\"></span> هو <span class=\"tx\" data-t=\"y \\ge 4\"></span>"],["(x-2)^2 = y - 4 \\Rightarrow x - 2 = \\sqrt{y - 4}","نأخذ الجذر الموجب لأن <span class=\"tx\" data-t=\"x \\ge 2\"></span>"],["j^{-1}(x) = 2 + \\sqrt{x - 4},\\ x \\ge 4","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"j^{-1}(x) = 2+\\sqrt{x-4}\"></span> ، حيث <span class=\"tx\" data-t=\"x \\ge 4\"></span>","o":""}],[{"n":"17","s":[["(f\\circ g)(x) = \\left(-3 + \\sqrt{x-2} + 3\\right)^2 + 2","بالتعويض"],["= \\left(\\sqrt{x-2}\\right)^2 + 2 = x - 2 + 2 = x,\\ x \\ge 2",""],["(g\\circ f)(x) = -3 + \\sqrt{(x+3)^2 + 2 - 2} = -3 + |x+3|","بالتعويض"],["= -3 + x + 3 = x,\\ x \\ge -3","لأن <span class=\"tx\" data-t=\"x+3 \\ge 0\"></span>"]],"a":"بما أن <span class=\"tx\" data-t=\"(f\\circ g)(x) = (g\\circ f)(x) = x\"></span> فكل منهما اقتران عكسي للآخر","o":""}],[{"n":"18","s":[["(f\\circ f)(x) = \\frac{\\frac{x}{x-1}}{\\frac{x}{x-1} - 1}","بالتعويض"],["\\frac{x}{x-1} - 1 = \\frac{x - (x-1)}{x-1} = \\frac{1}{x-1}","تبسيط المقام"],["(f\\circ f)(x) = \\frac{x}{x-1} \\times \\frac{x-1}{1} = x",""]],"a":"بما أن <span class=\"tx\" data-t=\"(f\\circ f)(x) = x\"></span> فإن <span class=\"tx\" data-t=\"f^{-1}(x) = f(x)\"></span>، أي أن <span class=\"tx\" data-t=\"f\"></span> اقتران عكسي لنفسه","o":""}],[{"n":"19","s":[["C(x) = 23000 \\Leftrightarrow C^{-1}(23000) = x","الاقتران العكسي يعطي عدد الوحدات بدلالة التكلفة"]],"a":"<span class=\"tx\" data-t=\"C^{-1}(23000)\"></span> يمثل عدد مصابيح الإنارة التي تكون تكلفة إنتاجها <span class=m dir=ltr>23000</span> دينار","o":""}],[{"n":"20","s":[["f:\\ (0,6),\\ (2,4),\\ (3,1.5),\\ (4,-2)","نقاط من منحنى <span class=\"tx\" data-t=\"f\"></span>"],["f^{-1}:\\ (6,0),\\ (4,2),\\ (1.5,3),\\ (-2,4)","بتبديل الإحداثيين (انعكاس حول المستقيم <span class=\"tx\" data-t=\"y = x\"></span>)"],["f:\\ D = [0, 4],\\ R = [-2, 6]","من الشكل"],["f^{-1}:\\ D = [-2, 6],\\ R = [0, 4]","مجال <span class=\"tx\" data-t=\"f^{-1}\"></span> <span class=m dir=ltr>=</span> مدى <span class=\"tx\" data-t=\"f\"></span> ومداه <span class=m dir=ltr>=</span> مجال <span class=\"tx\" data-t=\"f\"></span>"]],"a":"مجال <span class=\"tx\" data-t=\"f\"></span>: <span class=\"tx\" data-t=\"[0,4]\"></span> ومداه <span class=\"tx\" data-t=\"[-2,6]\"></span>؛ مجال <span class=\"tx\" data-t=\"f^{-1}\"></span>: <span class=\"tx\" data-t=\"[-2,6]\"></span> ومداه <span class=\"tx\" data-t=\"[0,4]\"></span>","o":"نرسم منحنى <span class=\"tx\" data-t=\"f^{-1}\"></span> بانعكاس منحنى <span class=\"tx\" data-t=\"f\"></span> حول المستقيم <span class=\"tx\" data-t=\"y=x\"></span>: يبدأ من <span class=\"tx\" data-t=\"(-2,4)\"></span> ويمر بـ <span class=\"tx\" data-t=\"(0,\\approx3.46)\"></span> و <span class=\"tx\" data-t=\"(4,2)\"></span> وينتهي عند <span class=\"tx\" data-t=\"(6,0)\"></span>"}],[{"n":"21","s":[["f(x) = (x^2 - 2x + 1) + 4 = (x-1)^2 + 4","بإكمال المربع"],["f(-3) = 20,\\ f(1) = 4 \\Rightarrow R = [4, 20]","مدى <span class=\"tx\" data-t=\"f\"></span>"],["y - 4 = (x-1)^2 \\Rightarrow x - 1 = -\\sqrt{y-4}","نأخذ الجذر السالب لأن <span class=\"tx\" data-t=\"x \\le 1\"></span>"],["f^{-1}(x) = 1 - \\sqrt{x-4},\\ 4 \\le x \\le 20","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = 1-\\sqrt{x-4}\"></span> ، حيث <span class=\"tx\" data-t=\"4 \\le x \\le 20\"></span>","o":"نقاط <span class=\"tx\" data-t=\"f\"></span>: <span class=\"tx\" data-t=\"(-3,20), (-2,13), (-1,8), (0,5), (1,4)\"></span>؛ ونقاط <span class=\"tx\" data-t=\"f^{-1}\"></span>: <span class=\"tx\" data-t=\"(20,-3), (13,-2), (8,-1), (5,0), (4,1)\"></span>، والمنحنيان متماثلان حول <span class=\"tx\" data-t=\"y=x\"></span>"}],[{"n":"22","s":[["C(100 + n) = 25 + 0.6n","بضرب الطرفين في <span class=\"tx\" data-t=\"(100+n)\"></span>"],["100C + Cn - 0.6n = 25 \\Rightarrow n(C - 0.6) = 25 - 100C",""],["n(C) = \\frac{25 - 100C}{C - 0.6}","بقسمة الطرفين على <span class=\"tx\" data-t=\"(C-0.6)\"></span>"],["n(0.5) = \\frac{25 - 50}{0.5 - 0.6} = \\frac{-25}{-0.1} = 250","بالتعويض <span class=\"tx\" data-t=\"C = 50\\% = 0.5\"></span>"]],"a":"<span class=\"tx\" data-t=\"n = \\frac{25-100C}{C-0.6}\"></span>، ويجب إضافة <span class=\"tx\" data-t=\"250\\ \\text{mL}\"></span> ليصبح التركيز <span class=\"tx\" data-t=\"50\\%\"></span>","o":""}],[{"n":"23","s":[["l = 0.5w + 3 \\Rightarrow l - 3 = 0.5w","بطرح <span class=m dir=ltr>3</span> من الطرفين"],["w = 2(l - 3) = 2l - 6","بضرب الطرفين في <span class=m dir=ltr>2</span>"]],"a":"نعم، الاقتران العكسي <span class=\"tx\" data-t=\"w = 2l-6\"></span> يعطي كتلة الجسم بدلالة طول الزنبرك","o":"مسألة اليوم (ص <span class=m dir=ltr>32)</span>: الاقتران <span class=\"tx\" data-t=\"l = 0.5w+3\"></span> يعطي طول الزنبرك بدلالة الكتلة"}],[{"n":"24","s":[["A = 2\\pi(r^2 + 40r) = 2\\pi\\left((r+20)^2 - 400\\right)","بإكمال المربع"],["(r+20)^2 = \\frac{A}{2\\pi} + 400",""],["r(A) = \\sqrt{\\frac{A}{2\\pi} + 400} - 20","نأخذ الجذر الموجب لأن <span class=\"tx\" data-t=\"r &gt; 0\"></span>"],["r(2000) = \\sqrt{\\frac{1000}{\\pi} + 400} - 20 \\approx 26.80 - 20 = 6.80","بالتعويض <span class=\"tx\" data-t=\"A = 2000\"></span>"]],"a":"<span class=\"tx\" data-t=\"r(A) = \\sqrt{\\frac{A}{2\\pi}+400}-20\"></span>، ونصف القطر <span class=\"tx\" data-t=\"\\approx 6.80\\ \\text{cm}\"></span>","o":""}],[{"n":"25","s":[["y = \\sqrt[3]{x} \\Rightarrow x = y^3","بتكعيب الطرفين"],["f^{-1}(x) = x^3","بتبديل <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span>"],["f:\\ (-8,-2),(-1,-1),(0,0),(1,1),(8,2)","نقاط للتمثيل"],["f^{-1}:\\ (-2,-8),(-1,-1),(0,0),(1,1),(2,8)",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x) = x^3\"></span>","o":"المنحنيان متماثلان حول المستقيم <span class=\"tx\" data-t=\"y=x\"></span> ويتقاطعان عند <span class=\"tx\" data-t=\"(-1,-1), (0,0), (1,1)\"></span>"}],[{"n":"26","s":[["f(4) = 0 \\Rightarrow f^{-1}(0) = 4","تبديل الإحداثيين"],["(4, 0) \\to (0, 4)",""]],"a":"منحنى <span class=\"tx\" data-t=\"f^{-1}\"></span> يقطع محور <span class=\"tx\" data-t=\"y\"></span> عند النقطة <span class=\"tx\" data-t=\"(0,4)\"></span>، أي أن مقطعه <span class=\"tx\" data-t=\"y\"></span> يساوي <span class=m dir=ltr>4</span>","o":""}],[{"n":"27","s":[["f(x) = 2x + 1,\\quad f^{-1}(x) = \\frac{x-1}{2}","إجابة ممكنة"],["(f\\circ f^{-1})(x) = 2\\left(\\frac{x-1}{2}\\right) + 1 = x",""],["(f^{-1}\\circ f)(x) = \\frac{2x + 1 - 1}{2} = x",""]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"f(x) = 2x+1\"></span> و <span class=\"tx\" data-t=\"f^{-1}(x) = \\frac{x-1}{2}\"></span>؛ وكلاهما عكسي للآخر لأن التركيبين يساويان <span class=\"tx\" data-t=\"x\"></span>","o":""}],[{"n":"28","s":[["g^{-1}(x) = \\frac{x+1}{5} \\Rightarrow g^{-1}(34) = \\frac{35}{5} = 7","إيجاد الاقتران العكسي لـ <span class=\"tx\" data-t=\"g\"></span>"],["(f\\circ g)(x) = (5x-1)^2 + 3",""],["(5x-1)^2 + 3 = 7 \\Rightarrow (5x-1)^2 = 4",""],["5x - 1 = \\pm 2 \\Rightarrow x = \\frac{3}{5} \\text{ or } x = -\\frac{1}{5}","بأخذ الجذر التربيعي"],["x = \\frac{3}{5}","لأن <span class=\"tx\" data-t=\"x &gt; 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = \\frac{3}{5} = 0.6\"></span>","o":""}],[{"n":"6","s":[["f^{-1}(4)=x \\Leftrightarrow f(x)=4","تعريف الاقتران العكسي"],["8-2x=4 \\Rightarrow x=2","بحل المعادلة"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"2\"></span>","o":""}],[{"n":"21","s":[["4-x\\ge 0 \\Rightarrow D_f=\\{x\\mid x\\le 4\\},\\ R_f=\\{y\\mid y\\ge 0\\}","مجال <span class=m dir=ltr>f</span> ومداه"],["y=\\sqrt{4-x} \\Rightarrow y^2=4-x","بتربيع الطرفين"],["x=4-y^2",""],["f^{-1}(x)=4-x^2,\\ x\\ge 0","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["D_{f^{-1}}=\\{x\\mid x\\ge 0\\},\\ R_{f^{-1}}=\\{y\\mid y\\le 4\\}","مجال العكسي <span class=m dir=ltr>=</span> مدى <span class=m dir=ltr>f</span>، ومداه <span class=m dir=ltr>=</span> مجال <span class=m dir=ltr>f</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=4-x^2,\\ x\\ge 0\"></span>؛ مجال <span class=\"tx\" data-t=\"f\"></span>: <span class=\"tx\" data-t=\"x\\le 4\"></span> ومداه <span class=\"tx\" data-t=\"y\\ge 0\"></span>؛ مجال <span class=\"tx\" data-t=\"f^{-1}\"></span>: <span class=\"tx\" data-t=\"x\\ge 0\"></span> ومداه <span class=\"tx\" data-t=\"y\\le 4\"></span>","o":""}],[{"n":"1","s":[["g(9)=80-\\frac{100}{10}=70","بالتعويض <span class=m dir=ltr>x = 9</span>"]],"a":"<span class=\"tx\" data-t=\"70\"></span>","o":""},{"n":"2","s":[["g(4)=80-\\frac{100}{5}=60","بالتعويض <span class=m dir=ltr>x = 4</span>"]],"a":"<span class=\"tx\" data-t=\"60\"></span>","o":""},{"n":"3","s":[["g(9)=70 \\Rightarrow g^{-1}(70)=9","من الفرع <span class=m dir=ltr>1</span>"]],"a":"<span class=\"tx\" data-t=\"9\"></span>","o":""},{"n":"4","s":[["g(4)=60 \\Rightarrow g^{-1}(60)=4","من الفرع <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":""}],[{"n":"5","s":[["f(3)=8 \\Rightarrow f^{-1}(8)=3","الاقتران واحد لواحد فله اقتران عكسي"]],"a":"نستنتج أن <span class=\"tx\" data-t=\"f^{-1}(8)=3\"></span>، أي أن النقطة <span class=\"tx\" data-t=\"(8,3)\"></span> تقع على منحنى <span class=\"tx\" data-t=\"f^{-1}\"></span>","o":""}],[{"n":"6","s":[["f(x)=2540 \\Leftrightarrow x=f^{-1}(2540)","الاقتران العكسي يعطي المدخلة (عدد الساعات) لمخرجة معيّنة"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(2540)\"></span> يمثّل عدد ساعات العمل اللازمة لإنتاج <span class=m dir=ltr>2540</span> وحدة من المنتج","o":""}],[{"n":"7","s":[["y=3x-5 \\Rightarrow x=\\frac{y+5}{3}",""],["f^{-1}(x)=\\frac{x+5}{3}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{x+5}{3}\"></span>؛ المجال والمدى: جميع الأعداد الحقيقية","o":""},{"n":"8","s":[["y=4-7x \\Rightarrow x=\\frac{4-y}{7}",""],["f^{-1}(x)=\\frac{4-x}{7}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{4-x}{7}\"></span>؛ المجال والمدى: جميع الأعداد الحقيقية","o":""},{"n":"9","s":[["D_f=\\{x\\ge 0\\},\\ R_f=\\{y\\ge 3\\}",""],["y=x^2+3 \\Rightarrow x=\\sqrt{y-3}","<span class=m dir=ltr>x ≥ 0</span> فنأخذ الجذر الموجب"],["f^{-1}(x)=\\sqrt{x-3}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\sqrt{x-3}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\ge 3\"></span>، المدى <span class=\"tx\" data-t=\"y\\ge 0\"></span>","o":""},{"n":"10","s":[["D_f=\\{x\\ge 0\\},\\ R_f=\\{y\\le 5\\}",""],["y=5-9x^2 \\Rightarrow x^2=\\frac{5-y}{9}",""],["x=\\frac{\\sqrt{5-y}}{3}","<span class=m dir=ltr>x ≥ 0</span>"],["f^{-1}(x)=\\frac{\\sqrt{5-x}}{3}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{\\sqrt{5-x}}{3}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\le 5\"></span>، المدى <span class=\"tx\" data-t=\"y\\ge 0\"></span>","o":""},{"n":"11","s":[["y(2x+6)=x \\Rightarrow 2xy-x=-6y","بالضرب التبادلي"],["x(2y-1)=-6y \\Rightarrow x=\\frac{6y}{1-2y}",""],["f^{-1}(x)=\\frac{6x}{1-2x}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["D_f=\\{x\\ne -3\\},\\ R_f=\\{y\\ne \\tfrac{1}{2}\\}","خطا التقارب لـ <span class=m dir=ltr>f</span>: <span class=m dir=ltr>x = −3</span> و <span class=m dir=ltr>y = 1/2</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{6x}{1-2x}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\ne \\frac{1}{2}\"></span>، المدى <span class=\"tx\" data-t=\"y\\ne -3\"></span>","o":""},{"n":"12","s":[["y(8-4x)=x \\Rightarrow 8y=x+4xy","بالضرب التبادلي"],["x(1+4y)=8y \\Rightarrow x=\\frac{8y}{1+4y}",""],["f^{-1}(x)=\\frac{8x}{1+4x}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["D_f=\\{x\\ne 2\\},\\ R_f=\\{y\\ne -\\tfrac{1}{4}\\}",""]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{8x}{1+4x}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\ne -\\frac{1}{4}\"></span>، المدى <span class=\"tx\" data-t=\"y\\ne 2\"></span>","o":""},{"n":"13","s":[["D_f=\\{x\\ge \\tfrac{1}{2}\\},\\ R_f=\\{y\\ge 3\\}",""],["y-3=\\sqrt{2x-1} \\Rightarrow (y-3)^2=2x-1","بتربيع الطرفين"],["x=\\frac{(y-3)^2+1}{2}",""],["f^{-1}(x)=\\frac{(x-3)^2+1}{2},\\ x\\ge 3","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{(x-3)^2+1}{2}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\ge 3\"></span>، المدى <span class=\"tx\" data-t=\"y\\ge \\frac{1}{2}\"></span>","o":""},{"n":"14","s":[["D_f=\\{x\\ge -\\tfrac{2}{3}\\},\\ R_f=\\{y\\ge -5\\}",""],["(y+5)^2=3x+2","بإضافة <span class=m dir=ltr>5</span> ثم التربيع"],["x=\\frac{(y+5)^2-2}{3}",""],["f^{-1}(x)=\\frac{(x+5)^2-2}{3},\\ x\\ge -5","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{(x+5)^2-2}{3}\"></span>؛ المجال <span class=\"tx\" data-t=\"x\\ge -5\"></span>، المدى <span class=\"tx\" data-t=\"y\\ge -\\frac{2}{3}\"></span>","o":""},{"n":"15","s":[["y+1=\\sqrt[3]{3x-2} \\Rightarrow (y+1)^3=3x-2","بتكعيب الطرفين"],["x=\\frac{(y+1)^3+2}{3}",""],["f^{-1}(x)=\\frac{(x+1)^3+2}{3}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{(x+1)^3+2}{3}\"></span>؛ المجال والمدى: جميع الأعداد الحقيقية","o":""},{"n":"16","s":[["y-1=\\sqrt[3]{3-4x} \\Rightarrow (y-1)^3=3-4x","بتكعيب الطرفين"],["x=\\frac{3-(y-1)^3}{4}",""],["f^{-1}(x)=\\frac{3-(x-1)^3}{4}","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{3-(x-1)^3}{4}\"></span>؛ المجال والمدى: جميع الأعداد الحقيقية","o":""}],[{"n":"17","s":[["(f\\circ h)(x)=2(5x+2)-5=10x-1",""],["10x-1\\ne x",""]],"a":"لا، ليسا اقترانين عكسيين لأن <span class=\"tx\" data-t=\"(f\\circ h)(x)\\ne x\"></span>","o":""},{"n":"18","s":[["(f\\circ h)(x)=\\frac{2\\cdot\\frac{5x}{2-3x}}{3\\cdot\\frac{5x}{2-3x}+5}=\\frac{10x}{15x+10-15x}=x","بضرب البسط والمقام في <span class=m dir=ltr>2 − 3x</span>"],["(h\\circ f)(x)=\\frac{5\\cdot\\frac{2x}{3x+5}}{2-3\\cdot\\frac{2x}{3x+5}}=\\frac{10x}{6x+10-6x}=x","بضرب البسط والمقام في <span class=m dir=ltr>3x + 5</span>"]],"a":"نعم، كلٌّ منهما اقتران عكسي للآخر لأن <span class=\"tx\" data-t=\"(f\\circ h)(x)=(h\\circ f)(x)=x\"></span>","o":""}],[{"n":"19","s":[["D_f=\\{x\\ge -2\\},\\ R_f=\\{y\\ge 0\\}","<span class=m dir=ltr>6 + 3x ≥ 0</span>"],["y^2=6+3x \\Rightarrow x=\\frac{y^2-6}{3}","بتربيع الطرفين"],["f^{-1}(x)=\\frac{x^2-6}{3},\\ x\\ge 0","بتبديل <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["f:\\ (-2,0),\\ (1,3),\\ (10,6)","نقاط على منحنى <span class=m dir=ltr>f</span>"],["f^{-1}:\\ (0,-2),\\ (3,1),\\ (6,10)","بتبديل الإحداثيات"]],"a":"<span class=\"tx\" data-t=\"f^{-1}(x)=\\frac{x^2-6}{3},\\ x\\ge 0\"></span>","o":"نرسم المنحنيين متماثلين حول المستقيم <span class=\"tx\" data-t=\"y=x\"></span>؛ منحنى <span class=\"tx\" data-t=\"f\"></span> يبدأ عند <span class=\"tx\" data-t=\"(-2,0)\"></span> ومنحنى <span class=\"tx\" data-t=\"f^{-1}\"></span> (نصف قطع مكافئ) يبدأ عند <span class=\"tx\" data-t=\"(0,-2)\"></span>."}],[{"n":"20","s":[["A=\\pi r^2 \\Rightarrow r^2=\\frac{A}{\\pi}",""],["r(A)=\\sqrt{\\frac{A}{\\pi}},\\ A\\ge 0","<span class=m dir=ltr>r</span> موجب"],["r(250)=\\sqrt{\\frac{250}{\\pi}}\\approx 8.92","بالتعويض <span class=m dir=ltr>A = 250</span>"]],"a":"<span class=\"tx\" data-t=\"r(A)=\\sqrt{\\frac{A}{\\pi}}\"></span>، و <span class=\"tx\" data-t=\"r\\approx 8.92\\ \\text{cm}\"></span>","o":""}],[{"n":"21","s":[["\\frac{T}{2\\pi}=\\sqrt{\\frac{\\ell}{9.8}}","بقسمة الطرفين على <span class=m dir=ltr>2π</span>"],["\\frac{T^2}{4\\pi^2}=\\frac{\\ell}{9.8}","بتربيع الطرفين"],["\\ell(T)=\\frac{9.8\\,T^2}{4\\pi^2}",""],["\\ell(3)=\\frac{9.8(9)}{4\\pi^2}=\\frac{88.2}{4\\pi^2}\\approx 2.23","بالتعويض <span class=m dir=ltr>T = 3</span>"]],"a":"<span class=\"tx\" data-t=\"\\ell(T)=\\frac{9.8T^2}{4\\pi^2}\"></span>، وطول البندول <span class=\"tx\" data-t=\"\\approx 2.23\\ \\text{m}\"></span>","o":""}]]