[[{"n":"1","s":[["K = \\frac{1}{2}(7)(8)\\sin 59^\\circ","مساحة المثلث <span class=\"tx\" data-t=\"K=\\frac12 ab\\sin C\"></span>"],["K \\approx 24.0",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"24.0\\text{ cm}^2\"></span>","o":""},{"n":"2","s":[["K = \\frac{1}{2}(6.7)(8)\\sin 85^\\circ","الزاوية محصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>AC</span>"],["K \\approx 26.7",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"26.7\\text{ cm}^2\"></span>","o":""},{"n":"3","s":[["K = \\frac{1}{2}(27)(19)\\sin 109^\\circ","الزاوية <span class=m dir=ltr>R</span> محصورة بين <span class=m dir=ltr>QR</span> و <span class=m dir=ltr>PR</span>"],["K \\approx 242.5",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"242.5\\text{ cm}^2\"></span>","o":""},{"n":"4","s":[["K = \\frac{1}{2}(231)(191)\\sin 73^\\circ","الزاوية <span class=m dir=ltr>X</span> محصورة بين <span class=m dir=ltr>XY</span> و <span class=m dir=ltr>XZ</span>"],["K \\approx 21096.6",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"21096.6\\text{ cm}^2\"></span>","o":""},{"n":"5","s":[["K = \\frac{1}{2}(63)(39)\\sin 85^\\circ","الزاوية <span class=m dir=ltr>L</span> محصورة بين <span class=m dir=ltr>LN</span> و <span class=m dir=ltr>LM</span>"],["K \\approx 1223.8",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"1223.8\\text{ cm}^2\"></span>","o":""}],[{"n":"6","s":[["27 = \\frac{1}{2}(14)(AC)\\sin 115^\\circ","الزاوية <span class=m dir=ltr>C</span> محصورة بين <span class=m dir=ltr>BC</span> و <span class=m dir=ltr>AC</span>"],["AC = \\frac{54}{14\\sin 115^\\circ}","بحل المعادلة"],["AC \\approx 4.26",""]],"a":"<span class=\"tx\" data-t=\"AC \\approx 4.26\\text{ cm}\"></span>","o":""}],[{"n":"7","s":[["133 = \\frac{1}{2}(16)(21)\\sin M","الزاوية <span class=m dir=ltr>M</span> محصورة بين <span class=m dir=ltr>LM</span> و <span class=m dir=ltr>MN</span>"],["\\sin M = \\frac{133}{168} \\approx 0.7917 \\Rightarrow \\angle LMN \\approx 52.3^\\circ","الزاوية حادة"],["LN^2 = 16^2 + 21^2 - 2(16)(21)\\cos 52.3^\\circ \\approx 286.4","قانون جيوب التمام"],["LN \\approx 16.92","بأخذ الجذر التربيعي"],["\\sin N = \\frac{16\\sin 52.3^\\circ}{16.92} \\Rightarrow \\angle MNL \\approx 48.5^\\circ","قانون الجيوب"]],"a":"<span class=\"tx\" data-t=\"\\angle LMN \\approx 52.3^\\circ\"></span> ، <span class=\"tx\" data-t=\"\\angle MNL \\approx 48.5^\\circ\"></span>","o":""}],[{"n":"8","s":[["\\cos C = \\frac{60^2 + 70^2 - 80^2}{2(60)(70)} = 0.25","قانون جيوب التمام لإيجاد الزاوية المقابلة للضلع <span class=m dir=ltr>80</span>"],["C \\approx 75.5^\\circ","معكوس جيب التمام"],["K = \\frac{1}{2}(60)(70)\\sin 75.5^\\circ","مساحة المثلث"],["K \\approx 2033.3",""]],"a":"مساحة اللوحة تقريبًا <span class=\"tx\" data-t=\"2033.3\\text{ cm}^2\"></span>","o":""}],[{"n":"9","s":[["PX = 6,\\ QX = 7,\\ PQ = 9","<span class=m dir=ltr>X</span> على الدائرتين: بعده عن كل مركز يساوي نصف قطرها"],["\\cos P = \\frac{6^2 + 9^2 - 7^2}{2(6)(9)} = \\frac{68}{108}","قانون جيوب التمام"],["P \\approx 51.0^\\circ","معكوس جيب التمام"],["K = \\frac{1}{2}(6)(9)\\sin 51.0^\\circ \\approx 20.98","مساحة المثلث"]],"a":"مساحة المثلث <span class=\"tx\" data-t=\"PXQ\"></span> تقريبًا <span class=\"tx\" data-t=\"21.0\\text{ cm}^2\"></span>","o":"النتيجة نفسها إذا كان نصف قطر الدائرة <span class=m dir=ltr>P</span> يساوي <span class=m dir=ltr>7</span> و <span class=m dir=ltr>Q</span> يساوي <span class=m dir=ltr>6</span>."}],[{"n":"10","s":[["25,\\ 40,\\ 60","القطر الرأسي يقسم الطائرة إلى مثلثين متطابقين أضلاعهما <span class=m dir=ltr>25</span> و <span class=m dir=ltr>40</span> و <span class=m dir=ltr>60</span>"],["\\cos\\theta = \\frac{25^2 + 40^2 - 60^2}{2(25)(40)} = -0.6875","قانون جيوب التمام: θ الزاوية بين <span class=m dir=ltr>25</span> و <span class=m dir=ltr>40</span>"],["\\theta \\approx 133.4^\\circ","معكوس جيب التمام"],["K = 2 \\times \\frac{1}{2}(25)(40)\\sin 133.4^\\circ","مساحة المثلثين"],["K \\approx 726.2",""]],"a":"المساحة اللازمة تقريبًا <span class=\"tx\" data-t=\"726.2\"></span> وحدة مربعة","o":""}],[{"n":"11","s":[["\\angle BAC = (360^\\circ - 324^\\circ) + 42^\\circ = 78^\\circ","<span class=m dir=ltr>B</span> غرب الشمال بـ <span class=\"tx\" data-t=\"36^\\circ\"></span> و <span class=m dir=ltr>C</span> شرق الشمال بـ <span class=\"tx\" data-t=\"42^\\circ\"></span>"],["K = \\frac{1}{2}(21.5)(14.2)\\sin 78^\\circ","مساحة المثلث"],["K \\approx 149.3",""]],"a":"مساحة المتنزّه تقريبًا <span class=\"tx\" data-t=\"149.3\"></span> وحدة مربعة","o":""}],[{"n":"12","s":[["BD^2 = 25^2 + 73^2 - 2(25)(73)\\cos 65^\\circ","قانون جيوب التمام في المثلث <span class=m dir=ltr>ABD</span>"],["BD^2 \\approx 4411.44","بالتبسيط"],["BD \\approx 66.4 \\approx 66","بأخذ الجذر والتقريب لأقرب متر"]],"a":"<span class=\"tx\" data-t=\"BD \\approx 66\\text{ m}\"></span> ✓","o":""},{"n":"13","s":[["\\cos C = \\frac{35^2 + 42^2 - BD^2}{2(35)(42)}","قانون جيوب التمام في المثلث <span class=m dir=ltr>BCD</span>"],["\\cos C = \\frac{2989 - 4411.44}{2940} \\approx -0.4838","باستعمال <span class=\"tx\" data-t=\"BD^2 \\approx 4411.44\"></span>"],["C \\approx 118.9^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\angle C \\approx 118.9^\\circ\"></span>","o":"إذا استُعمل <span class=\"tx\" data-t=\"BD = 66\"></span> تمامًا نحصل على <span class=\"tx\" data-t=\"C \\approx 117.7^\\circ\"></span>."},{"n":"14","s":[["K_1 = \\frac{1}{2}(25)(73)\\sin 65^\\circ \\approx 827.0","مساحة المثلث <span class=m dir=ltr>ABD</span>"],["K_2 = \\frac{1}{2}(35)(42)\\sin 118.9^\\circ \\approx 643.2","مساحة المثلث <span class=m dir=ltr>BCD</span>"],["K = 827.0 + 643.2 \\approx 1470.3","مساحة الحقل <span class=m dir=ltr>=</span> مجموع المساحتين"]],"a":"مساحة الحقل تقريبًا <span class=\"tx\" data-t=\"1470\\text{ m}^2\"></span>","o":"باستعمال <span class=\"tx\" data-t=\"BD=66\"></span> و <span class=\"tx\" data-t=\"C \\approx 117.7^\\circ\"></span> تكون المساحة نحو <span class=\"tx\" data-t=\"1478\\text{ m}^2\"></span>."}],[{"n":"15","s":[["K = \\frac{1}{2}(84)(110)\\sin 145^\\circ","مساحة الأرض"],["K \\approx 2649.9","بالتبسيط"],["2649.9 \\times 0.15 \\approx 397.5","كمية الدرنات <span class=m dir=ltr>=</span> المساحة <span class=m dir=ltr>× 0.15</span>"]],"a":"يحتاج المزارع تقريبًا <span class=\"tx\" data-t=\"397.5\\text{ kg}\"></span> من درنات البطاطا","o":"مسألة اليوم: ضلعان <span class=m dir=ltr>84 m</span> و <span class=m dir=ltr>110 m</span> والزاوية بينهما <span class=\"tx\" data-t=\"145^\\circ\"></span>، ويلزم <span class=m dir=ltr>0.15 kg</span> لكل متر مربع."}],[{"n":"16","s":[["AC = \\sqrt{5^2 + 12^2} = 13","نظرية فيثاغورس"],["5 + 12 + 13 = 30","محيط المثلث <span class=m dir=ltr>ABC</span>"],["30 \\div 3 = 10","طول ضلع المثلث متطابق الأضلاع <span class=m dir=ltr>DEF</span>"],["K = \\frac{1}{2}(10)(10)\\sin 60^\\circ = 25\\sqrt{3}","زوايا المثلث متطابق الأضلاع <span class=\"tx\" data-t=\"60^\\circ\"></span>"],["K \\approx 43.3",""]],"a":"مساحة المثلث <span class=\"tx\" data-t=\"DEF\"></span> هي <span class=\"tx\" data-t=\"25\\sqrt{3} \\approx 43.3\"></span> وحدة مربعة","o":""}],[{"n":"17","s":[["\\cos M = \\frac{1674^2 + 1645^2 - 1544^2}{2(1674)(1645)}","قانون جيوب التمام لزاوية ميامي (بين الضلعين <span class=m dir=ltr>1674</span> و <span class=m dir=ltr>1645)</span>"],["\\cos M \\approx 0.5673 \\Rightarrow M \\approx 55.44^\\circ","معكوس جيب التمام"],["K = \\frac{1}{2}(1674)(1645)\\sin 55.44^\\circ","مساحة المثلث"],["K \\approx 1133867",""]],"a":"مساحة مثلث برمودا تقريبًا <span class=\"tx\" data-t=\"1133867\\text{ km}^2\"></span> (نحو <span class=\"tx\" data-t=\"1.13\"></span> مليون <span class=\"tx\" data-t=\"\\text{km}^2\"></span>)","o":""}],[{"n":"18","s":[["\\angle C = 180^\\circ - 70^\\circ - 60^\\circ = 50^\\circ","مجموع زوايا المثلث"],["BC = \\frac{4\\sin 70^\\circ}{\\sin 50^\\circ} \\approx 4.907","قانون الجيوب: <span class=m dir=ltr>BC</span> يقابل <span class=m dir=ltr>A</span>، و <span class=m dir=ltr>AB</span> يقابل <span class=m dir=ltr>C</span>"],["K = \\frac{1}{2}(4)(4.907)\\sin 60^\\circ","الزاوية <span class=m dir=ltr>B</span> محصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>BC</span>"],["K \\approx 8.5",""]],"a":"المساحة تقريبًا <span class=\"tx\" data-t=\"8.5\\text{ cm}^2\"></span>","o":""}],[{"n":"19","s":[["\\text{الخطأ: الزاوية } 30^\\circ \\text{ ليست محصورة بين } AB \\text{ و } BC","الزاوية <span class=m dir=ltr>A</span> محصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>AC</span>، فلا يجوز ضربها مع <span class=m dir=ltr>8</span> و <span class=m dir=ltr>9</span>"],["\\sin C = \\frac{9\\sin 30^\\circ}{8} = 0.5625 \\Rightarrow C \\approx 34.2^\\circ","قانون الجيوب: <span class=m dir=ltr>AB</span> يقابل <span class=m dir=ltr>C</span>، و <span class=m dir=ltr>BC</span> يقابل <span class=m dir=ltr>A</span>"],["\\angle B = 180^\\circ - 30^\\circ - 34.2^\\circ \\approx 115.8^\\circ","الزاوية المحصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>BC</span>"],["K = \\frac{1}{2}(9)(8)\\sin 115.8^\\circ \\approx 32.4","مساحة المثلث"]],"a":"المساحة الصحيحة تقريبًا <span class=\"tx\" data-t=\"32.4\\text{ cm}^2\"></span>","o":"إذا كانت <span class=m dir=ltr>C</span> منفرجة (<span class=\"tx\" data-t=\"145.8^\\circ\"></span>) يكون <span class=\"tx\" data-t=\"B \\approx 4.2^\\circ\"></span> والمساحة نحو <span class=\"tx\" data-t=\"2.7\\text{ cm}^2\"></span>؛ والإجابة المعتادة <span class=\"tx\" data-t=\"32.4\\text{ cm}^2\"></span>."}],[{"n":"4","s":[["\\text{Area}=\\frac{1}{2}ab\\sin C","المساحة <span class=m dir=ltr>=</span> نصف حاصل ضرب ضلعين <span class=m dir=ltr>×</span> جيب الزاوية المحصورة بينهما"],["\\angle C:\\ a\\ \\text{and}\\ b","الزاوية <span class=m dir=ltr>C</span> هي المحصورة بين الضلعين <span class=m dir=ltr>a</span> و <span class=m dir=ltr>b</span>"]],"a":"<span class=m dir=ltr>(b)</span> <span class=\"tx\" data-t=\"\\frac{1}{2}ab\\sin C\"></span>","o":""}],[{"n":"11","s":[["\\text{Area}=\\frac{1}{2}(PQ)(RQ)\\sin Q","الزاوية <span class=m dir=ltr>Q</span> محصورة بين <span class=m dir=ltr>PQ</span> و <span class=m dir=ltr>RQ</span>"],["68=\\frac{1}{2}(18)(15)\\sin Q","بالتعويض"],["\\sin Q=\\frac{68}{135}\\approx 0.5037","بقسمة الطرفين على <span class=m dir=ltr>135</span>"],["Q=\\sin^{-1}(0.5037)\\approx 30.2^\\circ","الزاوية حادة"]],"a":"<span class=\"tx\" data-t=\"m\\angle PQR\\approx 30.2^\\circ\"></span>","o":""}],[{"n":"12","s":[["DB^2=5^2+4^2-2(5)(4)\\cos 95^\\circ","قانون جيوب التمام في المثلث <span class=m dir=ltr>ABD</span>"],["DB^2=41+3.49=44.49","لأن <span class=m dir=ltr>cos 95°</span> سالب"],["DB\\approx 6.67","بأخذ الجذر التربيعي"]],"a":"<span class=\"tx\" data-t=\"DB\\approx 6.67\"></span>","o":""},{"n":"13","s":[["m\\angle DBC=180^\\circ-32^\\circ-48^\\circ","مجموع زوايا المثلث <span class=m dir=ltr>DBC</span>"],["m\\angle DBC=100^\\circ",""]],"a":"<span class=\"tx\" data-t=\"m\\angle DBC=100^\\circ\"></span>","o":""},{"n":"14","s":[["\\frac{CD}{\\sin 100^\\circ}=\\frac{DB}{\\sin 48^\\circ}","قانون الجيوب في المثلث <span class=m dir=ltr>DBC</span>"],["CD=\\frac{6.67\\sin 100^\\circ}{\\sin 48^\\circ}\\approx 8.84","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"CD\\approx 8.84\"></span>","o":""},{"n":"15","s":[["A_1=\\frac{1}{2}(5)(4)\\sin 95^\\circ\\approx 9.96","مساحة المثلث <span class=m dir=ltr>ABD</span>"],["A_2=\\frac{1}{2}(DB)(CD)\\sin 32^\\circ=\\frac{1}{2}(6.67)(8.84)\\sin 32^\\circ\\approx 15.62","مساحة المثلث <span class=m dir=ltr>DBC</span>"],["A=9.96+15.62\\approx 25.58","مساحة الشكل الرباعي <span class=m dir=ltr>=</span> مجموع المساحتين"]],"a":"مساحة <span class=\"tx\" data-t=\"ABCD\\approx 25.58\"></span> وحدة مربعة","o":""}],[{"n":"22","s":[["A_1=\\frac{1}{2}(100)(125)\\sin 50^\\circ\\approx 4787.8","المثلث الأيسر (الزاوية <span class=m dir=ltr>50°</span> محصورة بين <span class=m dir=ltr>100</span> و <span class=m dir=ltr>125)</span>"],["A_2=\\frac{1}{2}(70)(50)\\sin 100^\\circ\\approx 1723.4","المثلث الأيمن (الزاوية <span class=m dir=ltr>100°</span> محصورة بين <span class=m dir=ltr>70</span> و <span class=m dir=ltr>50)</span>"],["d_1^2=100^2+125^2-2(100)(125)\\cos 50^\\circ\\Rightarrow d_1\\approx 97.75","طول القطر الأول (قانون جيوب التمام)"],["d_2^2=70^2+50^2-2(70)(50)\\cos 100^\\circ\\Rightarrow d_2\\approx 92.82","طول القطر الثاني"],["\\cos\\theta=\\frac{97.75^2+92.82^2-50^2}{2(97.75)(92.82)}\\Rightarrow \\theta\\approx 30.3^\\circ,\\ A_3=\\frac{1}{2}(97.75)(92.82)\\sin 30.3^\\circ\\approx 2287.5","المثلث الأوسط (أضلاعه <span class=m dir=ltr>97.75</span> و <span class=m dir=ltr>92.82</span> و <span class=m dir=ltr>50)</span>"],["A=4787.8+1723.4+2287.5\\approx 8798.7","مجموع مساحات المثلثات الثلاثة"]],"a":"مساحة الحقل التقريبية <span class=\"tx\" data-t=\"\\approx 8799\\ \\text{m}^2\"></span>","o":"نقسم الخماسي بالقطرين المتقطعين المرسومين من الرأس العلوي إلى ثلاثة مثلثات"}],[{"n":"1","s":[["\\text{Area}=\\frac{1}{2}(AB)(AC)\\sin A","الزاوية <span class=m dir=ltr>A</span> محصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>AC</span>"],["=\\frac{1}{2}(8)(11)\\sin 67^\\circ\\approx 40.5","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 40.5\\ \\text{cm}^2\"></span>","o":""},{"n":"2","s":[["\\text{Area}=\\frac{1}{2}(30)(22)\\sin 120^\\circ","الزاوية <span class=m dir=ltr>P</span> محصورة بين <span class=m dir=ltr>PQ</span> و <span class=m dir=ltr>PR</span>"],["=165\\sqrt{3}\\approx 285.8","لأن <span class=m dir=ltr>sin 120° = √3/2</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"=165\\sqrt{3}\\approx 285.8\\ \\text{cm}^2\"></span>","o":""},{"n":"3","s":[["\\cos X=\\frac{12^2+15^2-10^2}{2(12)(15)}=\\frac{269}{360}\\approx 0.7472","قانون جيوب التمام لإيجاد الزاوية <span class=m dir=ltr>X</span> بين <span class=m dir=ltr>XY</span> و <span class=m dir=ltr>XZ</span>"],["X\\approx 41.6^\\circ","باستعمال الآلة الحاسبة"],["\\text{Area}=\\frac{1}{2}(12)(15)\\sin 41.6^\\circ\\approx 59.8","صيغة المساحة"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 59.8\\ \\text{cm}^2\"></span>","o":""},{"n":"4","s":[["\\cos L=\\frac{25^2+14^2-18^2}{2(25)(14)}=\\frac{497}{700}=0.71","قانون جيوب التمام لإيجاد الزاوية <span class=m dir=ltr>L</span> بين <span class=m dir=ltr>LM</span> و <span class=m dir=ltr>LN</span>"],["L\\approx 44.8^\\circ","باستعمال الآلة الحاسبة"],["\\text{Area}=\\frac{1}{2}(25)(14)\\sin 44.8^\\circ\\approx 123.2","صيغة المساحة"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 123.2\\ \\text{cm}^2\"></span>","o":""}],[{"n":"5","s":[["84=\\frac{1}{2}(15)(AC)\\sin 120^\\circ","الزاوية <span class=m dir=ltr>C</span> محصورة بين <span class=m dir=ltr>BC</span> و <span class=m dir=ltr>AC</span>"],["84=6.495\\,AC","بالتبسيط"],["AC=\\frac{84}{6.495}\\approx 12.93","بقسمة الطرفين على <span class=m dir=ltr>6.495</span>"]],"a":"<span class=\"tx\" data-t=\"AC\\approx 12.93\\ \\text{cm}\"></span>","o":""}],[{"n":"6","s":[["100=\\frac{1}{2}(14)(EF)\\sin 64^\\circ","الزاوية <span class=m dir=ltr>E</span> محصورة بين <span class=m dir=ltr>DE</span> و <span class=m dir=ltr>EF</span>"],["100=6.292\\,EF","بالتبسيط"],["EF=\\frac{100}{6.292}\\approx 15.89","بقسمة الطرفين على <span class=m dir=ltr>6.292</span>"]],"a":"<span class=\"tx\" data-t=\"EF\\approx 15.89\\ \\text{cm}\"></span>","o":""}],[{"n":"7","s":[["m\\angle P=180^\\circ-60^\\circ-75^\\circ=45^\\circ","مجموع زوايا المثلث"],["\\frac{QR}{\\sin 45^\\circ}=\\frac{12}{\\sin 75^\\circ}\\Rightarrow QR\\approx 8.78","قانون الجيوب: <span class=m dir=ltr>PQ</span> تقابل <span class=m dir=ltr>R</span> و <span class=m dir=ltr>QR</span> تقابل <span class=m dir=ltr>P</span>"],["\\text{Area}=\\frac{1}{2}(PQ)(QR)\\sin Q=\\frac{1}{2}(12)(8.78)\\sin 60^\\circ\\approx 45.6","الزاوية <span class=m dir=ltr>Q</span> محصورة بين <span class=m dir=ltr>PQ</span> و <span class=m dir=ltr>QR</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 45.6\\ \\text{cm}^2\"></span>","o":""}],[{"n":"8","s":[["m\\angle G=180^\\circ-63^\\circ-45^\\circ=72^\\circ","مجموع زوايا المثلث"],["\\frac{EG}{\\sin 45^\\circ}=\\frac{46}{\\sin 72^\\circ}\\Rightarrow EG\\approx 34.20","قانون الجيوب: <span class=m dir=ltr>EF</span> تقابل <span class=m dir=ltr>G</span> و <span class=m dir=ltr>EG</span> تقابل <span class=m dir=ltr>F</span>"],["\\text{Area}=\\frac{1}{2}(EF)(EG)\\sin E=\\frac{1}{2}(46)(34.20)\\sin 63^\\circ\\approx 700.9","الزاوية <span class=m dir=ltr>E</span> محصورة بين <span class=m dir=ltr>EF</span> و <span class=m dir=ltr>EG</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 700.9\\ \\text{cm}^2\"></span>","o":""}],[{"n":"9","s":[["m\\angle PQR=90^\\circ","الزاوية المحيطية المرسومة في نصف دائرة قائمة"],["QR=\\sqrt{26^2-24^2}=10","نظرية فيثاغورس"],["A_{\\triangle}=\\frac{1}{2}(24)(10)\\sin 90^\\circ=120","مساحة المثلث <span class=m dir=ltr>PQR</span>"],["A_{\\text{semicircle}}=\\frac{1}{2}\\pi(13)^2=84.5\\pi\\approx 265.46","نصف القطر <span class=m dir=ltr>13</span>"],["A=84.5\\pi-120\\approx 145.46","المساحة المظللة <span class=m dir=ltr>=</span> نصف الدائرة <span class=m dir=ltr>−</span> المثلث"]],"a":"المساحة المظللة <span class=\"tx\" data-t=\"=84.5\\pi-120\\approx 145.5\"></span> وحدة مربعة","o":""}],[{"n":"10","s":[["A_1=2\\times 1.2=2.4","مساحة المستطيل"],["\\cos\\theta=\\frac{1.6^2+1.6^2-2^2}{2(1.6)(1.6)}=0.21875\\Rightarrow\\theta\\approx 77.4^\\circ","قانون جيوب التمام لإيجاد زاوية رأس المثلث"],["A_2=\\frac{1}{2}(1.6)(1.6)\\sin 77.4^\\circ\\approx 1.25","مساحة المثلث"],["A=2.4+1.25\\approx 3.65","مساحة النافذة"]],"a":"مساحة النافذة <span class=\"tx\" data-t=\"\\approx 3.65\"></span> وحدة مربعة","o":""}],[{"n":"11","s":[["\\sin M=\\frac{25\\sin 40^\\circ}{18}\\approx 0.8928","قانون الجيوب: <span class=m dir=ltr>LN=25</span> تقابل <span class=m dir=ltr>M</span> و <span class=m dir=ltr>MN=18</span> تقابل <span class=m dir=ltr>L</span>"],["M=180^\\circ-63.2^\\circ=116.8^\\circ","الزاوية <span class=m dir=ltr>M</span> منفرجة كما في الشكل"],["N=180^\\circ-40^\\circ-116.8^\\circ=23.2^\\circ","مجموع زوايا المثلث"],["\\text{Area}=\\frac{1}{2}(25)(18)\\sin 23.2^\\circ\\approx 88.7","الزاوية <span class=m dir=ltr>N</span> محصورة بين <span class=m dir=ltr>LN</span> و <span class=m dir=ltr>MN</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 88.7\"></span> وحدة مربعة","o":""},{"n":"12","s":[["\\sin C=\\frac{24.1\\sin 93^\\circ}{32.6}\\approx 0.7383\\Rightarrow C\\approx 47.6^\\circ","قانون الجيوب"],["A=180^\\circ-93^\\circ-47.6^\\circ=39.4^\\circ","مجموع زوايا المثلث"],["\\text{Area}=\\frac{1}{2}(24.1)(32.6)\\sin 39.4^\\circ\\approx 249.4","الزاوية <span class=m dir=ltr>A</span> محصورة بين <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>AC</span>"]],"a":"المساحة <span class=\"tx\" data-t=\"\\approx 249.4\"></span> وحدة مربعة","o":""}],[{"n":"6","s":[["A_1=7.5\\times 3.09=23.175","مساحة المستطيل"],["A_2=\\frac{1}{2}(5)(5)\\sin 30^\\circ=6.25","مساحة المثلث"],["A=23.175+6.25\\approx 29.4",""]],"a":"<span class=m dir=ltr>(C)</span> <span class=\"tx\" data-t=\"29.4\\ \\text{cm}^2\"></span>","o":""}],[{"n":"7","s":[["\\frac{360^\\circ}{6}=60^\\circ","السداسي المنتظم يتكون من <span class=m dir=ltr>6</span> مثلثات متطابقة عند المركز"],["A_1=\\frac{1}{2}(2)(2)\\sin 60^\\circ=\\sqrt{3}","مساحة المثلث الواحد"],["A=6\\sqrt{3}\\approx 10.4",""]],"a":"<span class=m dir=ltr>(D)</span> <span class=\"tx\" data-t=\"10.4\\ \\text{m}^2\"></span>","o":""}]]