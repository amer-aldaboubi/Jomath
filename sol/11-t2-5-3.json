[[{"n":"1","s":[["\\int_{-1}^{3}3x^{2}\\,dx=\\left.x^{3}\\right|_{-1}^{3}","بالتكامل"],["=(3)^{3}-(-1)^{3}=27+1=28","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"28\"></span>","o":""},{"n":"2","s":[["\\int_{-3}^{-2}6\\,dx=\\left.6x\\right|_{-3}^{-2}","بالتكامل"],["=6(-2)-6(-3)=-12+18=6","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"6\"></span>","o":""},{"n":"3","s":[["\\int_{0}^{2}(3x^{2}+4x+3)\\,dx=\\left.(x^{3}+2x^{2}+3x)\\right|_{0}^{2}","بالتكامل"],["=(8+8+6)-0=22","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"22\"></span>","o":""},{"n":"4","s":[["\\int_{1}^{8}8x^{\\frac{1}{3}}\\,dx=\\left.8\\cdot\\frac{3}{4}x^{\\frac{4}{3}}\\right|_{1}^{8}=\\left.6x^{\\frac{4}{3}}\\right|_{1}^{8}","بالتكامل"],["=6(16)-6(1)=90","<span class=\"tx\" data-t=\"8^{\\frac{4}{3}}=16\"></span>"]],"a":"<span class=\"tx\" data-t=\"90\"></span>","o":""},{"n":"5","s":[["\\int_{1}^{9}\\left(x^{\\frac{1}{2}}-4x^{-\\frac{1}{2}}\\right)dx=\\left.\\left(\\frac{2}{3}x^{\\frac{3}{2}}-8\\sqrt{x}\\right)\\right|_{1}^{9}","بالتكامل"],["=(18-24)-\\left(\\frac{2}{3}-8\\right)=-6+\\frac{22}{3}=\\frac{4}{3}","بالتعويض بالحدين، <span class=\"tx\" data-t=\"9^{\\frac{3}{2}}=27\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{4}{3}\"></span>","o":""},{"n":"6","s":[["\\left.\\left(-\\frac{x^{3}}{3}+2x^{2}-5x\\right)\\right|_{-2}^{3}","بالتكامل"],["=(-9+18-15)-\\left(\\frac{8}{3}+8+10\\right)","بالتعويض بالحدين"],["=-6-\\frac{62}{3}=-\\frac{80}{3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{80}{3}\"></span>","o":""},{"n":"7","s":[["\\int_{1}^{3}(x^{2}-4)\\,dx=\\left.\\left(\\frac{x^{3}}{3}-4x\\right)\\right|_{1}^{3}","بالضرب (فرق بين مربعين) ثم التكامل"],["=(9-12)-\\left(\\frac{1}{3}-4\\right)=-3+\\frac{11}{3}=\\frac{2}{3}","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>","o":""},{"n":"8","s":[["\\left.\\left(9x-\\frac{x^{3}}{3}\\right)\\right|_{-3}^{3}","بالتكامل"],["=(27-9)-(-27+9)=18+18=36","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"36\"></span>","o":""},{"n":"9","s":[["\\frac{2+\\sqrt{x}}{x^{2}}=2x^{-2}+x^{-\\frac{3}{2}}","بقسمة كل حد على <span class=\"tx\" data-t=\"x^{2}\"></span>"],["\\left.\\left(-\\frac{2}{x}-\\frac{2}{\\sqrt{x}}\\right)\\right|_{1}^{4}","بالتكامل"],["=\\left(-\\frac{1}{2}-1\\right)-(-2-2)=-\\frac{3}{2}+4=\\frac{5}{2}","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{2}=2.5\"></span>","o":""},{"n":"10","s":[["x^{3}\\left(\\sqrt{x}+\\frac{1}{x}\\right)=x^{\\frac{7}{2}}+x^{2}","بالتوزيع"],["\\left.\\left(\\frac{2}{9}x^{\\frac{9}{2}}+\\frac{x^{3}}{3}\\right)\\right|_{1}^{4}","بالتكامل"],["=\\left(\\frac{1024}{9}+\\frac{64}{3}\\right)-\\left(\\frac{2}{9}+\\frac{1}{3}\\right)=\\frac{1211}{9}","بالتعويض بالحدين، <span class=\"tx\" data-t=\"4^{\\frac{9}{2}}=512\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1211}{9}\\approx 134.56\"></span>","o":""},{"n":"11","s":[["\\left.\\left(\\frac{3}{4}x^{\\frac{4}{3}}-\\frac{3}{2}x^{\\frac{2}{3}}\\right)\\right|_{1}^{8}","بالتكامل"],["=\\left(\\frac{3}{4}(16)-\\frac{3}{2}(4)\\right)-\\left(\\frac{3}{4}-\\frac{3}{2}\\right)","بالتعويض بالحدين"],["=6+\\frac{3}{4}=\\frac{27}{4}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{27}{4}=6.75\"></span>","o":""},{"n":"12","s":[["(2+\\sqrt{x})^{2}=4+4x^{\\frac{1}{2}}+x","بفك مربع المجموع"],["\\left.\\left(4x+\\frac{8}{3}x^{\\frac{3}{2}}+\\frac{x^{2}}{2}\\right)\\right|_{1}^{9}","بالتكامل"],["=\\left(36+72+\\frac{81}{2}\\right)-\\left(4+\\frac{8}{3}+\\frac{1}{2}\\right)=\\frac{424}{3}","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"\\frac{424}{3}\\approx 141.33\"></span>","o":""}],[{"n":"13","s":[["|6-3x|=\\begin{cases}6-3x, & x\\le 2\\\\ 3x-6, & x>2\\end{cases}","بإعادة التعريف دون قيمة مطلقة (صفر المقدار <span class=\"tx\" data-t=\"x=2\"></span>)"],["\\int_{-1}^{2}(6-3x)\\,dx+\\int_{2}^{4}(3x-6)\\,dx","بتجزئة التكامل عند <span class=\"tx\" data-t=\"x=2\"></span>"],["=\\left.\\left(6x-\\frac{3}{2}x^{2}\\right)\\right|_{-1}^{2}+\\left.\\left(\\frac{3}{2}x^{2}-6x\\right)\\right|_{2}^{4}","بالتكامل"],["=(6+7.5)+(0+6)=19.5","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"\\frac{39}{2}=19.5\"></span>","o":""},{"n":"14","s":[["|x+2|=-(x+2),\\ -5\\le x\\le -3","لأن <span class=\"tx\" data-t=\"x+2&lt;0\"></span> في هذه الفترة"],["\\int_{-5}^{-3}-(x+2)\\,dx=-\\left.\\left(\\frac{x^{2}}{2}+2x\\right)\\right|_{-5}^{-3}","بالتكامل"],["=-\\left[\\left(\\frac{9}{2}-6\\right)-\\left(\\frac{25}{2}-10\\right)\\right]=-(-1.5-2.5)=4","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":""},{"n":"15","s":[["\\frac{x^{2}-1}{x+1}=x-1","بتحليل البسط والاختصار (<span class=\"tx\" data-t=\"x\\ne-1\"></span>)"],["\\int_{2}^{3}(x-1)\\,dx=\\left.\\left(\\frac{x^{2}}{2}-x\\right)\\right|_{2}^{3}","بالتكامل"],["=\\left(\\frac{9}{2}-3\\right)-(2-2)=\\frac{3}{2}","بالتعويض بالحدين"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{2}\"></span>","o":""}],[{"n":"16","s":[["\\int_{0}^{4}f(x)\\,dx=\\int_{0}^{3}(2x+1)\\,dx+\\int_{3}^{4}(10-x)\\,dx","بتجزئة التكامل عند <span class=\"tx\" data-t=\"x=3\"></span>"],["=\\left.(x^{2}+x)\\right|_{0}^{3}+\\left.\\left(10x-\\frac{x^{2}}{2}\\right)\\right|_{3}^{4}","بالتكامل"],["=12+\\left[(40-8)-(30-4.5)\\right]=12+6.5","بالتعويض بالحدين"],["=18.5","بالجمع"]],"a":"<span class=\"tx\" data-t=\"\\frac{37}{2}=18.5\"></span>","o":""}],[{"n":"17","s":[["\\int_{2}^{2}g(x)\\,dx=0","التكامل على فترة حداها متساويان يساوي صفرًا"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"18","s":[["\\int_{5}^{1}(g(x)-2)\\,dx=-\\int_{1}^{5}(g(x)-2)\\,dx","بتبديل حدي التكامل"],["=-\\left(\\int_{1}^{5}g(x)\\,dx-\\int_{1}^{5}2\\,dx\\right)=-(8-8)","خاصية الفرق، <span class=\"tx\" data-t=\"\\int_{1}^{5}2\\,dx=2(5-1)=8\"></span>"],["=0",""]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"19","s":[["3\\int_{1}^{2}f(x)\\,dx+\\int_{1}^{2}x\\,dx","خاصية المجموع والضرب في ثابت"],["=3(-4)+\\left.\\frac{x^{2}}{2}\\right|_{1}^{2}=-12+\\frac{3}{2}","بالتعويض"],["=-10.5","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{21}{2}=-10.5\"></span>","o":""},{"n":"20","s":[["\\int_{1}^{5}f\\,dx=\\int_{1}^{2}f\\,dx+\\int_{2}^{5}f\\,dx","خاصية تجزئة الفترة"],["6=-4+\\int_{2}^{5}f(x)\\,dx","بالتعويض"],["\\int_{2}^{5}f(x)\\,dx=10","بإضافة <span class=m dir=ltr>4</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"10\"></span>","o":""},{"n":"21","s":[["\\int_{1}^{5}f(x)\\,dx-\\int_{1}^{5}g(x)\\,dx=6-8=-2","خاصية الفرق"]],"a":"<span class=\"tx\" data-t=\"-2\"></span>","o":""},{"n":"22","s":[["4\\int_{1}^{5}f(x)\\,dx+\\int_{1}^{5}g(x)\\,dx=4(6)+8=32","خاصية المجموع والضرب في ثابت"]],"a":"<span class=\"tx\" data-t=\"32\"></span>","o":""}],[{"n":"23","s":[["\\left.(3x^{2}-10x)\\right|_{1}^{m}=4","بالتكامل"],["(3m^{2}-10m)-(3-10)=4\\Rightarrow 3m^{2}-10m+3=0","بالتعويض بالحدين"],["(3m-1)(m-3)=0","بالتحليل"],["m=\\frac{1}{3},\\quad m=3","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"m=3\"></span> أو <span class=\"tx\" data-t=\"m=\\frac{1}{3}\"></span>","o":""}],[{"n":"24","s":[["\\left.\\left(\\frac{a}{2}x^{2}+3x\\right)\\right|_{-1}^{2}=30","بالتكامل"],["(2a+6)-\\left(\\frac{a}{2}-3\\right)=30\\Rightarrow \\frac{3}{2}a+9=30","بالتعويض بالحدين"],["\\frac{3}{2}a=21\\Rightarrow a=14","بطرح <span class=m dir=ltr>9</span> ثم الضرب في <span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>"]],"a":"<span class=\"tx\" data-t=\"a=14\"></span>","o":""}],[{"n":"25","s":[["C(20)-C(10)=\\int_{10}^{20}(6x+1)\\,dx","مقدار التغير <span class=m dir=ltr>=</span> التكامل المحدود للمعدل"],["=\\left.(3x^{2}+x)\\right|_{10}^{20}=(1200+20)-(300+10)","بالتكامل والتعويض"],["=910","بالطرح"]],"a":"تزداد التكلفة بمقدار <span class=m dir=ltr>910</span> دنانير","o":""}],[{"n":"26","s":[["\\int_{0}^{4}280t^{\\frac{3}{2}}\\,dt=\\left.280\\cdot\\frac{2}{5}t^{\\frac{5}{2}}\\right|_{0}^{4}=\\left.112t^{\\frac{5}{2}}\\right|_{0}^{4}","كمية التغير <span class=m dir=ltr>=</span> تكامل المعدل"],["=112(32)-0=3584","<span class=\"tx\" data-t=\"4^{\\frac{5}{2}}=32\"></span>"]],"a":"يدخل البحيرة <span class=\"tx\" data-t=\"3584\\ \\text{kg}\"></span> من الملوثات","o":""}],[{"n":"27","s":[["\\left.F(x)\\right|_{a}^{b}=F(b)-F(a)","الخطأ: خالد طرح قيمة الحد العلوي من قيمة الحد السفلي (عكس الترتيب)"],["=\\left(\\frac{1}{3}(2)^{3}+\\frac{1}{2}(2)^{2}\\right)-\\left(\\frac{1}{3}(0)^{3}+\\frac{1}{2}(0)^{2}\\right)","التصحيح: الحد العلوي أولًا"],["=\\frac{8}{3}+2-0=\\frac{14}{3}","بالتبسيط"]],"a":"الناتج الصحيح <span class=\"tx\" data-t=\"\\frac{14}{3}\"></span>","o":""}],[{"n":"28","s":[["\\int_{0}^{1}(x^{n}-x^{n+1})\\,dx","بالتوزيع"],["=\\left.\\left(\\frac{x^{n+1}}{n+1}-\\frac{x^{n+2}}{n+2}\\right)\\right|_{0}^{1}","قاعدة القوة (<span class=\"tx\" data-t=\"n&gt;0\"></span>)"],["=\\frac{1}{n+1}-\\frac{1}{n+2}-0","بالتعويض بالحدين"],["=\\frac{(n+2)-(n+1)}{(n+1)(n+2)}=\\frac{1}{(n+1)(n+2)}","بتوحيد المقامات"]],"a":"تم الإثبات: <span class=\"tx\" data-t=\"\\int_{0}^{1}x^{n}(1-x)\\,dx=\\frac{1}{(n+1)(n+2)}\"></span>","o":""}],[{"n":"29","s":[["\\left.(ax^{2}+7x)\\right|_{1}^{5}=4a^{2}","بالتكامل"],["(25a+35)-(a+7)=4a^{2}\\Rightarrow 24a+28=4a^{2}","بالتعويض بالحدين"],["a^{2}-6a-7=0","بالقسمة على <span class=m dir=ltr>4</span> والترتيب"],["(a-7)(a+1)=0\\Rightarrow a=7,\\quad a=-1","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"a=7\"></span> أو <span class=\"tx\" data-t=\"a=-1\"></span>","o":""}],[{"n":"1","s":[["\\int_{1}^{4} x^{-\\frac{1}{2}}\\,dx = \\left[2x^{\\frac{1}{2}}\\right]_{1}^{4}","بكتابة المُكامَل على صورة قوة ثم تكامل اقتران القوة"],["= 2\\sqrt{4} - 2\\sqrt{1} = 4 - 2 = 2","بالتعويض بحدّي التكامل"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"2\"></span>","o":""}],[{"n":"5","s":[["\\int_{0}^{2} kx\\,dx = \\left[\\frac{k}{2}x^2\\right]_{0}^{2} = 2k","بإيجاد التكامل"],["2k = 6 \\Rightarrow k = 3","بقسمة الطرفين على <span class=m dir=ltr>2</span>"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"k = 3\"></span>","o":""}],[{"n":"6","s":[["\\int_{0}^{3}(-x^2 + 3x)\\,dx = \\left[-\\frac{x^3}{3} + \\frac{3x^2}{2}\\right]_{0}^{3}","قاعدة تكامل اقتران القوة"],["= \\left(-9 + \\frac{27}{2}\\right) - 0 = \\frac{9}{2} = 4\\frac{1}{2}","بالتعويض بحدّي التكامل"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"4\\frac{1}{2}\"></span>","o":""}],[{"n":"7","s":[["\\int_{2}^{4} 10x^3\\,dx = \\left[\\frac{10x^4}{4}\\right]_{2}^{4} = \\left[\\frac{5}{2}x^4\\right]_{2}^{4}","قاعدة تكامل اقتران القوة"],["= \\frac{5}{2}(256 - 16) = \\frac{5}{2}(240) = 600","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"600\"></span>","o":""},{"n":"8","s":[["\\int_{1}^{4} 2x^{\\frac{1}{2}}\\,dx = \\left[\\frac{4}{3}x^{\\frac{3}{2}}\\right]_{1}^{4}","بكتابة الجذر على صورة أُس"],["= \\frac{4}{3}(8 - 1) = \\frac{28}{3}","<span class=\"tx\" data-t=\"4^{\\frac{3}{2}} = 8\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{28}{3} \\approx 9.33\"></span>","o":""},{"n":"9","s":[["\\int_{9}^{16} 20x^{-\\frac{1}{2}}\\,dx = \\left[40x^{\\frac{1}{2}}\\right]_{9}^{16}","قاعدة تكامل اقتران القوة"],["= 40(4 - 3) = 40","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"40\"></span>","o":""},{"n":"10","s":[["\\int_{3}^{4}(6x^2 - 4x)\\,dx = \\left[2x^3 - 2x^2\\right]_{3}^{4}","قاعدة تكامل اقتران القوة"],["= (128 - 32) - (54 - 18) = 96 - 36 = 60","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"60\"></span>","o":""},{"n":"11","s":[["\\int_{0}^{1}(x^3 - x)\\,dx = \\left[\\frac{x^4}{4} - \\frac{x^2}{2}\\right]_{0}^{1}","قاعدة تكامل اقتران القوة"],["= \\frac{1}{4} - \\frac{1}{2} - 0 = -\\frac{1}{4}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{4}\"></span>","o":""},{"n":"12","s":[["\\frac{x + 1}{x^3} = x^{-2} + x^{-3}","بتوزيع المقام"],["\\int_{-3}^{-1}(x^{-2} + x^{-3})\\,dx = \\left[-\\frac{1}{x} - \\frac{1}{2x^2}\\right]_{-3}^{-1}","قاعدة تكامل اقتران القوة"],["= \\left(1 - \\frac{1}{2}\\right) - \\left(\\frac{1}{3} - \\frac{1}{18}\\right) = \\frac{1}{2} - \\frac{5}{18}","بالتعويض بحدّي التكامل"],["= \\frac{4}{18} = \\frac{2}{9}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{9}\"></span>","o":""}],[{"n":"1","s":[["\\int_{1}^{5} 10x^{-2}\\,dx = \\left[-\\frac{10}{x}\\right]_{1}^{5}","قاعدة تكامل اقتران القوة"],["= -2 - (-10) = 8","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"8\"></span>","o":""},{"n":"2","s":[["\\int_{0}^{2}(2x^3 - 4x + 5)\\,dx = \\left[\\frac{x^4}{2} - 2x^2 + 5x\\right]_{0}^{2}","قاعدة تكامل اقتران القوة"],["= (8 - 8 + 10) - 0 = 10","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"10\"></span>","o":""},{"n":"3","s":[["\\frac{x^3 + 2x^2}{\\sqrt{x}} = x^{\\frac{5}{2}} + 2x^{\\frac{3}{2}}","بتوزيع المقام"],["\\int_{1}^{4} = \\left[\\frac{2}{7}x^{\\frac{7}{2}} + \\frac{4}{5}x^{\\frac{5}{2}}\\right]_{1}^{4}","قاعدة تكامل اقتران القوة"],["= \\left(\\frac{256}{7} + \\frac{128}{5}\\right) - \\left(\\frac{2}{7} + \\frac{4}{5}\\right)","<span class=\"tx\" data-t=\"4^{\\frac{7}{2}} = 128,\\; 4^{\\frac{5}{2}} = 32\"></span>"],["= \\frac{254}{7} + \\frac{124}{5} = \\frac{2138}{35}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2138}{35} \\approx 61.09\"></span>","o":""},{"n":"4","s":[["\\left(x - \\frac{3}{x}\\right)^2 = x^2 - 6 + 9x^{-2}","بفك المربع"],["\\int_{3}^{6} = \\left[\\frac{x^3}{3} - 6x - \\frac{9}{x}\\right]_{3}^{6}","قاعدة تكامل اقتران القوة"],["= (72 - 36 - 1.5) - (9 - 18 - 3) = 34.5 + 12 = 46.5","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{93}{2} = 46.5\"></span>","o":""},{"n":"5","s":[["0 \\le x \\le 5 \\Rightarrow x + 3 > 0 \\Rightarrow |x + 3| = x + 3","بإعادة تعريف القيمة المطلقة على الفترة"],["\\int_{0}^{5}(x + 3 - 5)\\,dx = \\int_{0}^{5}(x - 2)\\,dx = \\left[\\frac{x^2}{2} - 2x\\right]_{0}^{5}","بالتبسيط"],["= 12.5 - 10 = 2.5","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{2}\"></span>","o":""},{"n":"6","s":[["\\int_{0}^{6}(6x - x^2)\\,dx = \\left[3x^2 - \\frac{x^3}{3}\\right]_{0}^{6}","بالتوزيع ثم التكامل"],["= 108 - 72 = 36","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"36\"></span>","o":""},{"n":"7","s":[["\\int_{1}^{2}(6x - 12x^{-4} + 3)\\,dx = \\left[3x^2 + \\frac{4}{x^3} + 3x\\right]_{1}^{2}","قاعدة تكامل اقتران القوة"],["= \\left(12 + \\frac{1}{2} + 6\\right) - (3 + 4 + 3) = 18.5 - 10 = 8.5","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{17}{2}\"></span>","o":""},{"n":"8","s":[["|2x - 1| = \\begin{cases} 1 - 2x, & x < \\frac{1}{2} \\\\ 2x - 1, & x \\ge \\frac{1}{2} \\end{cases}","بإعادة تعريف القيمة المطلقة"],["\\int_{0}^{\\frac{1}{2}}(1 - 2x)\\,dx = \\left[x - x^2\\right]_{0}^{\\frac{1}{2}} = \\frac{1}{4}","تجزئة فترة التكامل"],["\\int_{\\frac{1}{2}}^{7}(2x - 1)\\,dx = \\left[x^2 - x\\right]_{\\frac{1}{2}}^{7} = 42 - \\left(-\\frac{1}{4}\\right) = 42\\frac{1}{4}",""],["\\frac{1}{4} + 42\\frac{1}{4} = 42.5","بالجمع"]],"a":"<span class=\"tx\" data-t=\"\\frac{85}{2} = 42.5\"></span>","o":""},{"n":"9","s":[["|6 - 2x| = \\begin{cases} 6 - 2x, & x \\le 3 \\\\ 2x - 6, & x > 3 \\end{cases}","بإعادة تعريف القيمة المطلقة"],["\\int_{-3}^{3}(6 - 2x)\\,dx = \\left[6x - x^2\\right]_{-3}^{3} = 9 - (-27) = 36","تجزئة فترة التكامل"],["\\int_{3}^{4}(2x - 6)\\,dx = \\left[x^2 - 6x\\right]_{3}^{4} = -8 - (-9) = 1",""],["36 + 1 = 37","بالجمع"]],"a":"<span class=\"tx\" data-t=\"37\"></span>","o":""},{"n":"10","s":[["\\frac{x^2 + x^3}{x} = x + x^2","بتوزيع المقام"],["\\int_{1}^{2}(x + x^2)\\,dx = \\left[\\frac{x^2}{2} + \\frac{x^3}{3}\\right]_{1}^{2}","قاعدة تكامل اقتران القوة"],["= \\left(2 + \\frac{8}{3}\\right) - \\left(\\frac{1}{2} + \\frac{1}{3}\\right) = \\frac{23}{6}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{23}{6}\"></span>","o":""},{"n":"11","s":[["\\int_{3}^{4}(6x^2 - 4x)\\,dx = \\left[2x^3 - 2x^2\\right]_{3}^{4}","قاعدة تكامل اقتران القوة"],["= (128 - 32) - (54 - 18) = 60","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"60\"></span>","o":""},{"n":"12","s":[["\\int_{a}^{a} f(x)\\,dx = 0","حدّا التكامل متساويان"]],"a":"<span class=\"tx\" data-t=\"\\int_{10}^{10}\\frac{x + 1}{x^2}\\,dx = 0\"></span>","o":""}],[{"n":"13","s":[["\\int_{a}^{a} f(x)\\,dx = 0","حدّا التكامل متساويان"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"14","s":[["\\int_{1}^{2} f(x)\\,dx = \\int_{-3}^{2} f(x)\\,dx - \\int_{-3}^{1} f(x)\\,dx = 5 - 4 = 1","خاصية تجزئة فترة التكامل"],["\\int_{1}^{2}(f(x) - 5)\\,dx = 1 - [5x]_{1}^{2} = 1 - 5 = -4","تكامل الفرق <span class=m dir=ltr>=</span> الفرق بين التكاملين"]],"a":"<span class=\"tx\" data-t=\"-4\"></span>","o":""},{"n":"15","s":[["= -2\\int_{-3}^{2} f(x)\\,dx + 5\\int_{-3}^{2} g(x)\\,dx","خصائص التكامل المحدود"],["= -2(5) + 5(-2) = -20","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"-20\"></span>","o":""},{"n":"16","s":[["\\int_{2}^{-3} g(x)\\,dx = -\\int_{-3}^{2} g(x)\\,dx = 2","عكس حدّي التكامل يغيّر الإشارة"],["\\int_{2}^{-3} 2x\\,dx = \\left[x^2\\right]_{2}^{-3} = 9 - 4 = 5",""],["2 + 5 = 7","تكامل المجموع <span class=m dir=ltr>=</span> مجموع التكاملين"]],"a":"<span class=\"tx\" data-t=\"7\"></span>","o":""},{"n":"17","s":[["\\int_{2}^{-3}(f(x) + g(x))\\,dx = -\\left(\\int_{-3}^{2} f(x)\\,dx + \\int_{-3}^{2} g(x)\\,dx\\right)","عكس حدّي التكامل"],["= -(5 + (-2)) = -3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"-3\"></span>","o":""},{"n":"18","s":[["= 4\\int_{-3}^{2} f(x)\\,dx - 3\\int_{-3}^{2} g(x)\\,dx","خصائص التكامل المحدود"],["= 4(5) - 3(-2) = 20 + 6 = 26","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"26\"></span>","o":""}],[{"n":"19","s":[["\\int_{-3}^{6} f(x)\\,dx = \\int_{-3}^{2} x^2\\,dx + \\int_{2}^{6}(8 - x)\\,dx","تجزئة الفترة عند نقطة التشعب <span class=\"tx\" data-t=\"x = 2\"></span>"],["\\int_{-3}^{2} x^2\\,dx = \\left[\\frac{x^3}{3}\\right]_{-3}^{2} = \\frac{8}{3} + 9 = \\frac{35}{3}",""],["\\int_{2}^{6}(8 - x)\\,dx = \\left[8x - \\frac{x^2}{2}\\right]_{2}^{6} = 30 - 14 = 16",""],["\\frac{35}{3} + 16 = \\frac{83}{3}","بالجمع"]],"a":"<span class=\"tx\" data-t=\"\\frac{83}{3} \\approx 27.67\"></span>","o":""}],[{"n":"20","s":[["P(8) - P(0) = \\int_{0}^{8}\\left(5 + 3t^{\\frac{2}{3}}\\right)dt","مقدار التغير <span class=m dir=ltr>=</span> تكامل معدل التغير"],["= \\left[5t + \\frac{9}{5}t^{\\frac{5}{3}}\\right]_{0}^{8}","قاعدة تكامل اقتران القوة"],["= 40 + \\frac{9}{5}(32) - 0 = 40 + 57.6 = 97.6","<span class=\"tx\" data-t=\"8^{\\frac{5}{3}} = 32\"></span>"]],"a":"تزداد القرية بنحو <span class=\"tx\" data-t=\"97.6 \\approx 98\"></span> نسمة خلال الأشهر الثمانية القادمة","o":""}],[{"n":"21","s":[["\\int_{2}^{3}(x^2 - a)\\,dx = \\left[\\frac{x^3}{3} - ax\\right]_{2}^{3}","بإيجاد التكامل"],["= (9 - 3a) - \\left(\\frac{8}{3} - 2a\\right) = \\frac{19}{3} - a","بالتعويض بحدّي التكامل"],["\\frac{19}{3} - a = 5 \\Rightarrow a = \\frac{4}{3}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"a = \\frac{4}{3}\"></span>","o":""}]]