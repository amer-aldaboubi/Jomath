[[{"n":"1","s":[["f'(x)=\\frac{(2x-1)(3x^{2})-x^{3}(2)}{(2x-1)^{2}}","مشتقة القسمة"],["=\\frac{6x^{3}-3x^{2}-2x^{3}}{(2x-1)^{2}}","بالتوزيع"],["=\\frac{4x^{3}-3x^{2}}{(2x-1)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{4x^{3}-3x^{2}}{(2x-1)^{2}}=\\frac{x^{2}(4x-3)}{(2x-1)^{2}}\"></span>","o":""},{"n":"2","s":[["f'(x)=3x^{2}\\sec x+x^{3}\\sec x\\tan x","مشتقة الضرب، ومشتقة <span class=\"tx\" data-t=\"\\sec x\"></span> هي <span class=\"tx\" data-t=\"\\sec x\\tan x\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3x^{2}\\sec x+x^{3}\\sec x\\tan x\"></span>","o":""},{"n":"3","s":[["f'(x)=\\frac{\\cos x(1)-(x+1)(-\\sin x)}{\\cos^{2}x}","مشتقة القسمة"],["=\\frac{\\cos x+(x+1)\\sin x}{\\cos^{2}x}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{\\cos x+(x+1)\\sin x}{\\cos^{2}x}\"></span>","o":""},{"n":"4","s":[["f'(x)=e^{x}(\\tan x-x)+e^{x}(\\sec^{2}x-1)","مشتقة الضرب"],["=e^{x}(\\tan x-x+\\tan^{2}x)","المتطابقة <span class=\"tx\" data-t=\"\\sec^{2}x-1=\\tan^{2}x\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=e^{x}(\\tan^{2}x+\\tan x-x)\"></span>","o":""},{"n":"5","s":[["f'(x)=\\frac{e^{x}(\\cos x-\\sin x)-(\\sin x+\\cos x)e^{x}}{(e^{x})^{2}}","مشتقة القسمة"],["=\\frac{e^{x}(-2\\sin x)}{e^{2x}}","بإخراج <span class=\"tx\" data-t=\"e^{x}\"></span> عاملًا مشتركًا"],["=-\\frac{2\\sin x}{e^{x}}","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{2\\sin x}{e^{x}}=-2e^{-x}\\sin x\"></span>","o":""},{"n":"6","s":[["f'(x)=(3x^{2}\\sin x+x^{3}\\cos x)+(2x\\cos x-x^{2}\\sin x)","مشتقة الضرب لكل حدّ"],["=x^{3}\\cos x+2x^{2}\\sin x+2x\\cos x","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=x^{3}\\cos x+2x^{2}\\sin x+2x\\cos x\"></span>","o":""},{"n":"7","s":[["f(x)=x^{\\frac{1}{3}}\\left(x^{\\frac{1}{2}}+3\\right)","بكتابة الجذور بصورة أسّية"],["f'(x)=\\frac{1}{3}x^{-\\frac{2}{3}}\\left(x^{\\frac{1}{2}}+3\\right)+x^{\\frac{1}{3}}\\cdot\\frac{1}{2}x^{-\\frac{1}{2}}","مشتقة الضرب"],["=\\frac{1}{3}x^{-\\frac{1}{6}}+x^{-\\frac{2}{3}}+\\frac{1}{2}x^{-\\frac{1}{6}}","بالتوزيع وقوانين الأسس"],["=\\frac{5}{6}x^{-\\frac{1}{6}}+x^{-\\frac{2}{3}}","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{5}{6\\sqrt[6]{x}}+\\frac{1}{\\sqrt[3]{x^{2}}}\"></span>","o":""},{"n":"8","s":[["f'(x)=\\frac{(1-\\sec x)\\sec x\\tan x-(1+\\sec x)(-\\sec x\\tan x)}{(1-\\sec x)^{2}}","مشتقة القسمة"],["=\\frac{\\sec x\\tan x\\,[(1-\\sec x)+(1+\\sec x)]}{(1-\\sec x)^{2}}","بإخراج <span class=\"tx\" data-t=\"\\sec x\\tan x\"></span> عاملًا مشتركًا"],["=\\frac{2\\sec x\\tan x}{(1-\\sec x)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2\\sec x\\tan x}{(1-\\sec x)^{2}}\"></span>","o":""},{"n":"9","s":[["f(x)=\\frac{2-\\frac{1}{x}}{x-3}=\\frac{2x-1}{x^{2}-3x}","بضرب البسط والمقام في <span class=\"tx\" data-t=\"x\"></span>"],["f'(x)=\\frac{(x^{2}-3x)(2)-(2x-1)(2x-3)}{(x^{2}-3x)^{2}}","مشتقة القسمة"],["=\\frac{2x^{2}-6x-(4x^{2}-8x+3)}{(x^{2}-3x)^{2}}","بالتوزيع"],["=\\frac{-2x^{2}+2x-3}{(x^{2}-3x)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{-2x^{2}+2x-3}{(x^{2}-3x)^{2}}\"></span>","o":""},{"n":"10","s":[["(uvw)'=u'vw+uv'w+uvw'","مشتقة ضرب ثلاثة اقترانات"],["f'(x)=(3x^{2}-1)(x^{2}+2)(x^{2}+x+1)+(x^{3}-x)(2x)(x^{2}+x+1)+(x^{3}-x)(x^{2}+2)(2x+1)","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=(3x^{2}-1)(x^{2}+2)(x^{2}+x+1)+2x(x^{3}-x)(x^{2}+x+1)+(x^{3}-x)(x^{2}+2)(2x+1)\"></span>","o":"بعد الفك يمكن كتابتها: <span class=\"tx\" data-t=\"f&#x27;(x)=7x^{6}+6x^{5}+10x^{4}+4x^{3}-3x^{2}-4x-2\"></span>"},{"n":"11","s":[["f(x)=\\frac{1}{\\csc x+\\cot x}","تعريف الأس <span class=\"tx\" data-t=\"-1\"></span>"],["f'(x)=\\frac{0-(-\\csc x\\cot x-\\csc^{2}x)}{(\\csc x+\\cot x)^{2}}","مشتقة القسمة"],["=\\frac{\\csc x(\\cot x+\\csc x)}{(\\csc x+\\cot x)^{2}}","بإخراج <span class=\"tx\" data-t=\"\\csc x\"></span> عاملًا مشتركًا"],["=\\frac{\\csc x}{\\csc x+\\cot x}=\\frac{1}{1+\\cos x}","بالاختصار، ثم بالضرب في <span class=\"tx\" data-t=\"\\sin x\"></span> بسطًا ومقامًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{\\csc x}{\\csc x+\\cot x}=\\frac{1}{1+\\cos x}\"></span>","o":""}],[{"n":"12","s":[["(fg)'(0)=f'(0)g(0)+f(0)g'(0)","مشتقة الضرب"],["=(-3)(-1)+(5)(2)=3+10=13","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"(fg)&#x27;(0)=13\"></span>","o":""},{"n":"13","s":[["\\left(\\frac{f}{g}\\right)'(0)=\\frac{g(0)f'(0)-f(0)g'(0)}{(g(0))^{2}}","مشتقة القسمة"],["=\\frac{(-1)(-3)-(5)(2)}{(-1)^{2}}=\\frac{3-10}{1}=-7","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\left(\\frac{f}{g}\\right)&#x27;(0)=-7\"></span>","o":""},{"n":"14","s":[["(7f-2fg)'(0)=7f'(0)-2(fg)'(0)","مشتقة الفرق ومضاعف الثابت"],["=7(-3)-2(13)","من السؤال <span class=m dir=ltr>12</span>"],["=-21-26=-47",""]],"a":"<span class=\"tx\" data-t=\"(7f-2fg)&#x27;(0)=-47\"></span>","o":""}],[{"n":"15","s":[["f(x)=1-\\frac{8}{x^{2}+4}","بكتابة البسط <span class=\"tx\" data-t=\"x^{2}+4-8\"></span>"],["f'(x)=\\frac{16x}{(x^{2}+4)^{2}}","مشتقة القسمة"],["f''(x)=\\frac{16(x^{2}+4)^{2}-16x\\cdot2(x^{2}+4)(2x)}{(x^{2}+4)^{4}}=\\frac{16(4-3x^{2})}{(x^{2}+4)^{3}}","مشتقة القسمة مرّة أخرى ثم الاختصار"],["f''(-2)=\\frac{16(4-12)}{8^{3}}=\\frac{-128}{512}=-\\frac{1}{4}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(-2)=-\\frac{1}{4}\"></span>","o":""},{"n":"16","s":[["1+x=(1+\\sqrt[3]{x})(1-\\sqrt[3]{x}+\\sqrt[3]{x^{2}})","تحليل مجموع مكعبين"],["f(x)=1-x^{\\frac{1}{3}}+x^{\\frac{2}{3}}","بالاختصار"],["f'(x)=-\\frac{1}{3}x^{-\\frac{2}{3}}+\\frac{2}{3}x^{-\\frac{1}{3}}","المشتقة الأولى"],["f''(x)=\\frac{2}{9}x^{-\\frac{5}{3}}-\\frac{2}{9}x^{-\\frac{4}{3}}","المشتقة الثانية"],["f''(8)=\\frac{2}{9}\\cdot\\frac{1}{32}-\\frac{2}{9}\\cdot\\frac{1}{16}=-\\frac{1}{144}","بالتعويض <span class=\"tx\" data-t=\"8^{\\frac{1}{3}}=2\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(8)=-\\frac{1}{144}\"></span>","o":"يمكن الحل بقاعدة مشتقة القسمة مباشرة، والنتيجة نفسها."},{"n":"17","s":[["1-x=(1-\\sqrt{x})(1+\\sqrt{x})","تحليل الفرق بين مربعين"],["f(x)=1-\\sqrt{x}=1-x^{\\frac{1}{2}}","بالاختصار"],["f'(x)=-\\frac{1}{2}x^{-\\frac{1}{2}},\\quad f''(x)=\\frac{1}{4}x^{-\\frac{3}{2}}","المشتقتان الأولى والثانية"],["f''(4)=\\frac{1}{4}\\cdot\\frac{1}{8}=\\frac{1}{32}","بالتعويض <span class=\"tx\" data-t=\"4^{\\frac{3}{2}}=8\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(4)=\\frac{1}{32}\"></span>","o":""}],[{"n":"18","s":[["f'(x)=\\frac{(1+e^{x})(1)-(1+x)e^{x}}{(1+e^{x})^{2}}","مشتقة القسمة"],["f'(0)=\\frac{2-1}{4}=\\frac{1}{4}","ميل المماس عند <span class=\"tx\" data-t=\"x=0\"></span>"],["y-\\frac{1}{2}=\\frac{1}{4}(x-0)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{1}{4}x+\\frac{1}{2}\"></span>","o":""},{"n":"19","s":[["f'(x)=e^{x}\\cos x-e^{x}\\sin x+\\cos x","مشتقة الضرب"],["f'(0)=1-0+1=2","الميل عند <span class=\"tx\" data-t=\"x=0\"></span>"],["y-1=2(x-0)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=2x+1\"></span>","o":""}],[{"n":"20","s":[["\\cot x=\\frac{\\cos x}{\\sin x}","تعريف"],["\\frac{d}{dx}(\\cot x)=\\frac{\\sin x(-\\sin x)-\\cos x(\\cos x)}{\\sin^{2}x}","مشتقة القسمة"],["=\\frac{-(\\sin^{2}x+\\cos^{2}x)}{\\sin^{2}x}=\\frac{-1}{\\sin^{2}x}","المتطابقة <span class=\"tx\" data-t=\"\\sin^{2}x+\\cos^{2}x=1\"></span>"],["=-\\csc^{2}x",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d}{dx}(\\cot x)=-\\csc^{2}x\"></span> ✓","o":""},{"n":"21","s":[["\\sec x=\\frac{1}{\\cos x}","تعريف"],["\\frac{d}{dx}(\\sec x)=\\frac{\\cos x(0)-1(-\\sin x)}{\\cos^{2}x}=\\frac{\\sin x}{\\cos^{2}x}","مشتقة القسمة"],["=\\frac{1}{\\cos x}\\cdot\\frac{\\sin x}{\\cos x}=\\sec x\\tan x",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d}{dx}(\\sec x)=\\sec x\\tan x\"></span> ✓","o":""},{"n":"22","s":[["\\csc x=\\frac{1}{\\sin x}","تعريف"],["\\frac{d}{dx}(\\csc x)=\\frac{\\sin x(0)-1(\\cos x)}{\\sin^{2}x}=\\frac{-\\cos x}{\\sin^{2}x}","مشتقة القسمة"],["=-\\frac{1}{\\sin x}\\cdot\\frac{\\cos x}{\\sin x}=-\\csc x\\cot x",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d}{dx}(\\csc x)=-\\csc x\\cot x\"></span> ✓","o":""}],[{"n":"23","s":[["f''(x)=2-2x^{-1}","بكتابة الكسر بأس سالب"],["f'''(x)=0+2x^{-2}=\\frac{2}{x^{2}}","المشتقة الثالثة هي مشتقة الثانية"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;&#x27;(x)=\\frac{2}{x^{2}}\"></span>","o":""},{"n":"24","s":[["f'''(x)=2x^{\\frac{1}{2}}","بالصورة الأسّية"],["f^{(4)}(x)=2\\cdot\\frac{1}{2}x^{-\\frac{1}{2}}=\\frac{1}{\\sqrt{x}}","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"f^{(4)}(x)=\\frac{1}{\\sqrt{x}}\"></span>","o":""},{"n":"25","s":[["f^{(5)}(x)=2","مشتقة <span class=\"tx\" data-t=\"2x+1\"></span>"],["f^{(6)}(x)=0","مشتقة الثابت"]],"a":"<span class=\"tx\" data-t=\"f^{(6)}(x)=0\"></span>","o":""}],[{"n":"26","s":[["h'(t)=\\frac{(4+t^{2})(6t)-3t^{2}(2t)}{(4+t^{2})^{2}}","مشتقة القسمة"],["=\\frac{24t+6t^{3}-6t^{3}}{(4+t^{2})^{2}}","بالتوزيع"],["=\\frac{24t}{(4+t^{2})^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"h&#x27;(t)=\\frac{24t}{(4+t^{2})^{2}}\"></span> متر لكل شهر","o":""}],[{"n":"27","s":[["\\frac{dy}{dx}=e^{x}\\sin x+e^{x}\\cos x=e^{x}(\\sin x+\\cos x)","مشتقة الضرب"],["\\frac{d^{2}y}{dx^{2}}=e^{x}(\\sin x+\\cos x)+e^{x}(\\cos x-\\sin x)","مشتقة الضرب مرّة أخرى"],["=2e^{x}\\cos x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=e^{x}(\\sin x+\\cos x)\"></span>، <span class=\"tx\" data-t=\"\\frac{d^{2}y}{dx^{2}}=2e^{x}\\cos x\"></span>","o":""},{"n":"28","s":[["2\\frac{dy}{dx}-2y=2e^{x}\\sin x+2e^{x}\\cos x-2e^{x}\\sin x","بالتعويض من السؤال <span class=m dir=ltr>27</span> في الطرف الأيمن"],["=2e^{x}\\cos x","بالتبسيط"],["=\\frac{d^{2}y}{dx^{2}}","من السؤال <span class=m dir=ltr>27</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^{2}y}{dx^{2}}=2\\frac{dy}{dx}-2y\"></span> ✓","o":""}],[{"n":"29","s":[["\\sin\\theta=\\frac{r}{r+h}","في المثلث القائم: الضلع المقابل <span class=\"tx\" data-t=\"r\"></span> والوتر <span class=\"tx\" data-t=\"r+h\"></span>"],["r+h=\\frac{r}{\\sin\\theta}=r\\csc\\theta","بضرب الطرفين في <span class=\"tx\" data-t=\"(r+h)\"></span> وقسمتهما على <span class=\"tx\" data-t=\"\\sin\\theta\"></span>"],["h=r\\csc\\theta-r=r(\\csc\\theta-1)","بطرح <span class=\"tx\" data-t=\"r\"></span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"h=r(\\csc\\theta-1)\"></span> ✓","o":""},{"n":"30","s":[["\\frac{dh}{d\\theta}=r(-\\csc\\theta\\cot\\theta)=-r\\csc\\theta\\cot\\theta","مشتقة <span class=\"tx\" data-t=\"\\csc\\theta\"></span> (<span class=\"tx\" data-t=\"r\"></span> ثابت)"],["\\csc\\frac{\\pi}{6}=2,\\quad\\cot\\frac{\\pi}{6}=\\sqrt{3}","قيم النسب المثلثية"],["\\frac{dh}{d\\theta}=-6371(2)(\\sqrt{3})=-12742\\sqrt{3}\\approx-22069.8","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{dh}{d\\theta}=-12742\\sqrt{3}\\approx-22069.8\\ \\text{km/rad}\"></span>","o":""}],[{"n":"31","s":[["v(t)=2te^{t}+t^{2}e^{t}=e^{t}(t^{2}+2t)","مشتقة الضرب"],["a(t)=e^{t}(t^{2}+2t)+e^{t}(2t+2)","مشتقة الضرب للسرعة"],["a(t)=e^{t}(t^{2}+4t+2)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"v(t)=e^{t}(t^{2}+2t)\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(t)=e^{t}(t^{2}+4t+2)\\ \\text{m/s}^2\"></span>","o":""},{"n":"32","s":[["v(1)=e(1+2)=3e\\approx8.15","بالتعويض <span class=\"tx\" data-t=\"t=1\"></span>"],["a(1)=e(1+4+2)=7e\\approx19.03",""]],"a":"<span class=\"tx\" data-t=\"v(1)=3e\\approx8.15\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(1)=7e\\approx19.03\\ \\text{m/s}^2\"></span>","o":""}],[{"n":"33","s":[["v(t)=\\frac{9(9+t^{2})-9t(2t)}{(9+t^{2})^{2}}=\\frac{81-9t^{2}}{(9+t^{2})^{2}}","مشتقة القسمة"],["a(t)=\\frac{(9+t^{2})^{2}(-18t)-(81-9t^{2})\\cdot2(9+t^{2})(2t)}{(9+t^{2})^{4}}","مشتقة القسمة للسرعة"],["=\\frac{-18t(9+t^{2})-4t(81-9t^{2})}{(9+t^{2})^{3}}=\\frac{18t^{3}-486t}{(9+t^{2})^{3}}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(9+t^{2})\"></span> والتبسيط"]],"a":"<span class=\"tx\" data-t=\"v(t)=\\frac{81-9t^{2}}{(9+t^{2})^{2}}\"></span>، <span class=\"tx\" data-t=\"a(t)=\\frac{18t(t^{2}-27)}{(9+t^{2})^{3}}\"></span>","o":""},{"n":"34","s":[["v(2)=\\frac{81-36}{13^{2}}=\\frac{45}{169}\\approx0.266","بالتعويض <span class=\"tx\" data-t=\"t=2\"></span>"],["a(2)=\\frac{18(2)(4-27)}{13^{3}}=\\frac{-828}{2197}\\approx-0.377",""]],"a":"<span class=\"tx\" data-t=\"v(2)=\\frac{45}{169}\\approx0.266\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(2)=-\\frac{828}{2197}\\approx-0.377\\ \\text{m/s}^2\"></span>","o":""}],[{"n":"35","s":[["f(x)=9\\ln x+\\frac{1}{2}x^{-2}","بالصورة الأسّية"],["f'(x)=\\frac{9}{x}-x^{-3}=\\frac{9}{x}-\\frac{1}{x^{3}}","باشتقاق كل حدّ"],["=\\frac{9x^{2}-1}{x^{3}}","بتوحيد المقامات"],["=\\frac{(3x-1)(3x+1)}{x^{3}}","الفرق بين مربعين"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{(3x-1)(3x+1)}{x^{3}}\"></span> ✓","o":""}],[{"n":"36","s":[["M'(t)=\\frac{5.8(t+1.9)-5.8t(1)}{(t+1.9)^{2}}=\\frac{11.02}{(t+1.9)^{2}}","مشتقة القسمة"],["M'(5)=\\frac{11.02}{(6.9)^{2}}=\\frac{11.02}{47.61}\\approx0.23","بالتعويض <span class=\"tx\" data-t=\"t=5\"></span>"]],"a":"معدّل تغيّر الكتلة بعد <span class=m dir=ltr>5</span> ثوانٍ <span class=\"tx\" data-t=\"\\approx0.23\\ \\text{g/s}\"></span>","o":""}],[{"n":"37","s":[["P'(t)=\\frac{(4t+80)(0)-2000(4)}{(4t+80)^{2}}","مشتقة القسمة"],["=\\frac{-8000}{(4t+80)^{2}}",""]],"a":"<span class=\"tx\" data-t=\"P&#x27;(t)=-\\frac{8000}{(4t+80)^{2}}\"></span> غزال لكل شهر","o":""},{"n":"38","s":[["P'(10)=\\frac{-8000}{(120)^{2}}=\\frac{-8000}{14400}=-\\frac{5}{9}\\approx-0.56","بالتعويض <span class=\"tx\" data-t=\"t=10\"></span>"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(10)=-\\frac{5}{9}\\approx-0.56\"></span>: أي أنّ عدد الغزلان يتناقص بمعدّل نحو <span class=m dir=ltr>0.56</span> غزال لكل شهر بعد <span class=m dir=ltr>10</span> أشهر","o":""}],[{"n":"39","s":[["m'(t)=(1)\\ln t+t\\cdot\\frac{1}{t}+0","مشتقة الضرب"],["m'(t)=\\ln t+1","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"m&#x27;(t)=\\ln t+1\"></span> لكل سنة","o":""}],[{"n":"40","s":[["P'(2)=F'(2)G(2)+F(2)G'(2)","مشتقة الضرب"],["F(2)=3,\\ F'(2)=0,\\ G(2)=2,\\ G'(2)=\\frac{1}{2}","من الشكل: لـ <span class=\"tx\" data-t=\"F\"></span> قيمة صغرى عند <span class=\"tx\" data-t=\"(2,3)\"></span> فالمماس أفقي، و<span class=\"tx\" data-t=\"G\"></span> مستقيم يمرّ بـ <span class=\"tx\" data-t=\"(0,1)\"></span> و<span class=\"tx\" data-t=\"(4,3)\"></span>"],["P'(2)=0(2)+3\\left(\\frac{1}{2}\\right)=\\frac{3}{2}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(2)=\\frac{3}{2}\"></span>","o":""},{"n":"41","s":[["Q'(7)=\\frac{G(7)F'(7)-F(7)G'(7)}{(G(7))^{2}}","مشتقة القسمة"],["F(7)=5,\\ F'(7)=\\frac{1}{4},\\ G(7)=1,\\ G'(7)=-\\frac{2}{3}","من الشكل: <span class=\"tx\" data-t=\"F\"></span> مستقيم بين <span class=\"tx\" data-t=\"(3,4)\"></span> و<span class=\"tx\" data-t=\"(7,5)\"></span>، و<span class=\"tx\" data-t=\"G\"></span> مستقيم بين <span class=\"tx\" data-t=\"(4,3)\"></span> و<span class=\"tx\" data-t=\"(7,1)\"></span>"],["Q'(7)=\\frac{1\\left(\\frac{1}{4}\\right)-5\\left(-\\frac{2}{3}\\right)}{1^{2}}=\\frac{1}{4}+\\frac{10}{3}=\\frac{43}{12}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"Q&#x27;(7)=\\frac{43}{12}\\approx3.58\"></span>","o":""}],[{"n":"42","s":[["\\frac{dy}{dx}=\\frac{(1+e^{-x})(e^{-x})-(1-e^{-x})(-e^{-x})}{(1+e^{-x})^{2}}","مشتقة القسمة"],["=\\frac{2e^{-x}}{(1+e^{-x})^{2}}","بالتبسيط"],["\\left.\\frac{dy}{dx}\\right|_{x=0}=\\frac{2}{(2)^{2}}=\\frac{1}{2}","بالتعويض <span class=\"tx\" data-t=\"x=0\"></span>"]],"a":"ميل المماس عند نقطة الأصل <span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>","o":""},{"n":"43","s":[["\\frac{dy}{dx}=\\frac{2e^{-x}}{(1+e^{-x})^{2}}","من السؤال <span class=m dir=ltr>42</span>"],["e^{-x}>0\\Rightarrow\\frac{dy}{dx}>0","البسط والمقام موجبان دائمًا"]],"a":"لا يوجد مماس أفقي؛ لأنّ <span class=\"tx\" data-t=\"\\frac{dy}{dx}\\ne0\"></span> لأي قيمة <span class=\"tx\" data-t=\"x\"></span> (المشتقة موجبة دائمًا)","o":""}],[{"n":"44","s":[["\\frac{dy}{dx}=\\frac{(x-1)(1)-(x+1)(1)}{(x-1)^{2}}","مشتقة القسمة"],["=\\frac{-2}{(x-1)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{2}{(x-1)^{2}}\"></span>","o":""},{"n":"45","s":[["y(x-1)=x+1\\Rightarrow xy-y=x+1","بالضرب التبادلي"],["x(y-1)=y+1\\Rightarrow x=\\frac{y+1}{y-1}","بتجميع حدود <span class=\"tx\" data-t=\"x\"></span>"],["\\frac{dx}{dy}=\\frac{(y-1)-(y+1)}{(y-1)^{2}}=\\frac{-2}{(y-1)^{2}}","مشتقة القسمة بالنسبة إلى <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{y+1}{y-1}\"></span>، <span class=\"tx\" data-t=\"\\frac{dx}{dy}=-\\frac{2}{(y-1)^{2}}\"></span>","o":""},{"n":"46","s":[["y-1=\\frac{x+1}{x-1}-1=\\frac{2}{x-1}","بالتعويض عن <span class=\"tx\" data-t=\"y\"></span>"],["\\frac{dx}{dy}=\\frac{-2}{\\left(\\frac{2}{x-1}\\right)^{2}}=\\frac{-2(x-1)^{2}}{4}=-\\frac{(x-1)^{2}}{2}","بالتعويض في نتيجة السؤال <span class=m dir=ltr>45</span>"],["\\frac{1}{\\frac{dy}{dx}}=\\frac{1}{\\frac{-2}{(x-1)^{2}}}=-\\frac{(x-1)^{2}}{2}","مقلوب نتيجة السؤال <span class=m dir=ltr>44</span>"]],"a":"الطرفان متساويان، إذن <span class=\"tx\" data-t=\"\\frac{dx}{dy}=\\frac{1}{\\frac{dy}{dx}}\"></span> ✓","o":""}],[{"n":"47","s":[["f'(x)=\\frac{x^{2}\\cdot\\frac{1}{x}-\\ln x\\cdot2x}{x^{4}}=\\frac{1-2\\ln x}{x^{3}}","مشتقة القسمة ثم القسمة على <span class=\"tx\" data-t=\"x\"></span>"],["f''(x)=\\frac{x^{3}\\left(-\\frac{2}{x}\\right)-(1-2\\ln x)(3x^{2})}{x^{6}}","مشتقة القسمة مرّة أخرى"],["=\\frac{-2x^{2}-3x^{2}+6x^{2}\\ln x}{x^{6}}=\\frac{6\\ln x-5}{x^{4}}","بالتبسيط والقسمة على <span class=\"tx\" data-t=\"x^{2}\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=\\frac{6\\ln x-5}{x^{4}}\"></span> ✓","o":""},{"n":"48","s":[["x^{4}f''(x)=6\\ln x-5","من السؤال <span class=m dir=ltr>47</span>"],["4x^{3}f'(x)=4(1-2\\ln x)=4-8\\ln x","بالتعويض"],["2x^{2}f(x)=2\\ln x",""],["(6\\ln x-5)+(4-8\\ln x)+2\\ln x+1=0","بالجمع"]],"a":"قيمة المقدار <span class=\"tx\" data-t=\"=0\"></span>","o":""}],[{"n":"2","s":[["y'=u'v+uv'","مشتقة الضرب"],["y'(1)=3(-1)+2(1)=-1",""]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"-1\"></span>","o":""}],[{"n":"3","s":[["f'(x)=1+x^{-2}",""],["f''(x)=-2x^{-3}=-\\frac{2}{x^3}",""]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"-\\frac{2}{x^3}\"></span>","o":""}],[{"n":"9","s":[["f'(x)=e^x\\left(x+x^{\\frac32}\\right)+e^x\\left(1+\\frac32x^{\\frac12}\\right)","مشتقة الضرب"],["=e^x\\left(x+x\\sqrt x+1+\\frac32\\sqrt x\\right)",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=e^x\\left(x+x\\sqrt{x}+1+\\frac{3}{2}\\sqrt{x}\\right)\"></span>","o":""},{"n":"10","s":[["f'(x)=\\frac{\\tan x\\cdot1-x\\sec^2x}{\\tan^2x}","مشتقة القسمة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{\\tan x-x\\sec^2x}{\\tan^2x}\"></span>","o":""},{"n":"11","s":[["f(x)=x^{-1}-12\\sec x",""],["f'(x)=-x^{-2}-12\\sec x\\tan x",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{1}{x^2}-12\\sec x\\tan x\"></span>","o":""},{"n":"12","s":[["f'(x)=\\frac{e^x\\ln x-e^x\\cdot\\frac1x}{(\\ln x)^2}","مشتقة القسمة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{e^x\\left(\\ln x-\\frac{1}{x}\\right)}{(\\ln x)^2}\"></span>","o":""},{"n":"13","s":[["f'(x)=\\frac{x^4\\cdot\\frac1x-4x^3\\ln x}{x^8}","مشتقة القسمة"],["=\\frac{x^3(1-4\\ln x)}{x^8}=\\frac{1-4\\ln x}{x^5}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1-4\\ln x}{x^5}\"></span>","o":""},{"n":"14","s":[["f'(x)=5^{2-x}\\ln5\\cdot(-1)","مشتقة الاقتران الأسي مع قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-5^{2-x}\\ln 5\"></span>","o":""}],[{"n":"18","s":[["(fg)'(2)=f'(2)g(2)+f(2)g'(2)","مشتقة الضرب"],["=(-4)(1)+(3)(2)=2",""]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":""},{"n":"19","s":[["\\left(\\frac fg\\right)'(2)=\\frac{f'(2)g(2)-f(2)g'(2)}{(g(2))^2}","مشتقة القسمة"],["=\\frac{(-4)(1)-(3)(2)}{1^2}=-10",""]],"a":"<span class=\"tx\" data-t=\"-10\"></span>","o":""},{"n":"20","s":[["(3f-4fg)'(2)=3f'(2)-4(fg)'(2)",""],["=3(-4)-4(2)=-20","من السؤال <span class=m dir=ltr>18</span>"]],"a":"<span class=\"tx\" data-t=\"-20\"></span>","o":""}],[{"n":"21","s":[["f'(x)=7x^6\\ln x+x^7\\cdot\\frac1x=7x^6\\ln x+x^6","مشتقة الضرب"],["f''(x)=42x^5\\ln x+7x^5+6x^5",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=42x^5\\ln x+13x^5\"></span>","o":""},{"n":"22","s":[["f'(x)=\\frac{-x\\sin x-\\cos x}{x^2}","مشتقة القسمة"],["f''(x)=\\frac{x^2(-\\sin x-x\\cos x+\\sin x)-2x(-x\\sin x-\\cos x)}{x^4}","مشتقة القسمة"],["=\\frac{-x^2\\cos x+2x\\sin x+2\\cos x}{x^3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=\\frac{-x^2\\cos x+2x\\sin x+2\\cos x}{x^3}\"></span>","o":""},{"n":"23","s":[["f'(x)=\\frac{(1+\\sqrt x)-x\\cdot\\frac{1}{2\\sqrt x}}{(1+\\sqrt x)^2}=\\frac{2+\\sqrt x}{2(1+\\sqrt x)^2}","مشتقة القسمة"],["f''(x)=\\frac{\\frac{1}{2\\sqrt x}\\cdot2(1+\\sqrt x)^2-(2+\\sqrt x)\\cdot4(1+\\sqrt x)\\cdot\\frac{1}{2\\sqrt x}}{4(1+\\sqrt x)^4}","مشتقة القسمة وقاعدة السلسلة"],["=\\frac{(1+\\sqrt x)-2(2+\\sqrt x)}{4\\sqrt x(1+\\sqrt x)^3}=\\frac{-(3+\\sqrt x)}{4\\sqrt x(1+\\sqrt x)^3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=-\\frac{3+\\sqrt{x}}{4\\sqrt{x}\\,(1+\\sqrt{x})^3}\"></span>","o":""},{"n":"24","s":[["f'(x)=\\frac{-2x(1+x^2)-2x(1-x^2)}{(1+x^2)^2}=\\frac{-4x}{(1+x^2)^2}","مشتقة القسمة"],["f''(x)=\\frac{-4(1+x^2)^2+4x\\cdot2(1+x^2)(2x)}{(1+x^2)^4}",""],["=\\frac{-4(1+x^2)+16x^2}{(1+x^2)^3}=\\frac{12x^2-4}{(1+x^2)^3}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=\\frac{12x^2-4}{(1+x^2)^3}\"></span>","o":""}],[{"n":"27","s":[["y'=\\ln x+x\\cdot\\frac1x=\\ln x+1","مشتقة الضرب"],["y'(1)=0+1=1",""],["y-0=1(x-1)\\Rightarrow y=x-1",""]],"a":"<span class=\"tx\" data-t=\"y=x-1\"></span>","o":""},{"n":"28","s":[["\\ln x+1=2\\Rightarrow\\ln x=1\\Rightarrow x=e",""],["y=e\\ln e=e",""]],"a":"النقطة <span class=\"tx\" data-t=\"(e,\\,e)\"></span>","o":""}],[{"n":"36","s":[["p'(x)=f'(x)g(x)+f(x)g'(x)","مشتقة الضرب"],["f(1)=2,\\ f'(1)=\\frac{0-8}{2-(-2)}=-2","من الشكل: <span class=m dir=ltr>f</span> قطعة مستقيمة من <span class=m dir=ltr>(−2, 8)</span> إلى <span class=m dir=ltr>(2, 0)</span>"],["g(1)=3,\\ g'(1)=\\frac{4-0}{2-(-2)}=1","من الشكل: <span class=m dir=ltr>g</span> قطعة مستقيمة من <span class=m dir=ltr>(−2, 0)</span> إلى <span class=m dir=ltr>(2, 4)</span>"],["p'(1)=(-2)(3)+(2)(1)=-4","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"p&#x27;(1)=-4\"></span>","o":""},{"n":"37","s":[["f(4)=1,\\ f'(4)=\\frac{2-0}{6-2}=\\frac{1}{2}","من الشكل: <span class=m dir=ltr>f</span> قطعة مستقيمة من <span class=m dir=ltr>(2, 0)</span> إلى <span class=m dir=ltr>(6, 2)</span>"],["g(4)=8,\\ g'(4)=0","<span class=m dir=ltr>g</span> لها قمة (مماس أفقي) عند <span class=m dir=ltr>(4, 8)</span>"],["p'(4)=f'(4)g(4)+f(4)g'(4)=\\frac{1}{2}(8)+1(0)=4","مشتقة الضرب بالتعويض"]],"a":"<span class=\"tx\" data-t=\"p&#x27;(4)=4\"></span>","o":""},{"n":"38","s":[["q'(x)=\\frac{f'(x)g(x)-f(x)g'(x)}{(g(x))^{2}}","مشتقة القسمة"],["f(7)=4,\\ f'(7)=\\frac{10-2}{10-6}=2","من الشكل: <span class=m dir=ltr>f</span> قطعة مستقيمة من <span class=m dir=ltr>(6, 2)</span> إلى <span class=m dir=ltr>(10, 10)</span>"],["g(7)=4,\\ g'(7)=\\frac{1-5}{10-6}=-1","من الشكل: <span class=m dir=ltr>g</span> قطعة مستقيمة من <span class=m dir=ltr>(6, 5)</span> إلى <span class=m dir=ltr>(10, 1)</span>"],["q'(7)=\\frac{(2)(4)-(4)(-1)}{4^{2}}=\\frac{12}{16}=\\frac{3}{4}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"q&#x27;(7)=\\frac{3}{4}\"></span>","o":""}],[{"n":"1","s":[["f'(x)=\\frac{x\\cdot\\cos x-\\sin x\\cdot 1}{x^{2}}","مشتقة القسمة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{x\\cos x-\\sin x}{x^{2}}\"></span>","o":""},{"n":"2","s":[["f'(x)=-(-\\csc x\\cot x)-\\cos x","مشتقة <span class=m dir=ltr>csc x</span> هي <span class=m dir=ltr>−csc x cot x</span>"],["f'(x)=\\csc x\\cot x-\\cos x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\csc x\\cot x-\\cos x\"></span>","o":""},{"n":"3","s":[["f(x)=\\frac{x+c}{\\frac{x^{2}+c}{x}}=\\frac{x^{2}+cx}{x^{2}+c}","بضرب البسط والمقام في <span class=m dir=ltr>x</span>"],["f'(x)=\\frac{(2x+c)(x^{2}+c)-(x^{2}+cx)(2x)}{(x^{2}+c)^{2}}","مشتقة القسمة"],["=\\frac{2x^{3}+2cx+cx^{2}+c^{2}-2x^{3}-2cx^{2}}{(x^{2}+c)^{2}}","بفك الأقواس"],["f'(x)=\\frac{c^{2}+2cx-cx^{2}}{(x^{2}+c)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{c(c+2x-x^{2})}{(x^{2}+c)^{2}}\"></span>","o":""},{"n":"4","s":[["f'(x)=1\\cdot\\cot x+x(-\\csc^{2}x)","مشتقة الضرب"],["f'(x)=\\cot x-x\\csc^{2}x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\cot x-x\\csc^{2}x\"></span>","o":""},{"n":"5","s":[["f'(x)=4-\\left(2x\\tan x+x^{2}\\sec^{2}x\\right)","مشتقة الضرب للحد <span class=m dir=ltr>x² tan x</span>"],["f'(x)=4-2x\\tan x-x^{2}\\sec^{2}x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=4-2x\\tan x-x^{2}\\sec^{2}x\"></span>","o":""},{"n":"6","s":[["f'(x)=\\frac{x^{2}(-\\sin x)-\\cos x\\,(2x)}{x^{4}}","مشتقة القسمة"],["f'(x)=\\frac{-x(x\\sin x+2\\cos x)}{x^{4}}=-\\frac{x\\sin x+2\\cos x}{x^{3}}","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا والاختصار"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{x\\sin x+2\\cos x}{x^{3}}\"></span>","o":""},{"n":"7","s":[["f(x)=x-\\frac{4x}{x+3}","بالتوزيع"],["f'(x)=1-\\frac{4(x+3)-4x(1)}{(x+3)^{2}}","مشتقة القسمة"],["f'(x)=1-\\frac{12}{(x+3)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=1-\\frac{12}{(x+3)^{2}}\"></span>","o":""},{"n":"8","s":[["f'(x)=\\frac{3}{2}\\cdot\\frac{\\cos x(-\\cos x)-(1-\\sin x)(-\\sin x)}{\\cos^{2}x}","مشتقة القسمة <span class=m dir=ltr>(3/2</span> ثابت)"],["=\\frac{3}{2}\\cdot\\frac{-\\cos^{2}x+\\sin x-\\sin^{2}x}{\\cos^{2}x}=\\frac{3(\\sin x-1)}{2\\cos^{2}x}","المتطابقة <span class=m dir=ltr>sin²x + cos²x = 1</span>"],["=\\frac{3(\\sin x-1)}{2(1-\\sin x)(1+\\sin x)}=\\frac{-3}{2(1+\\sin x)}","<span class=m dir=ltr>cos²x = (1 − sin x)(1 + sin x)</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{3(\\sin x-1)}{2\\cos^{2}x}=-\\frac{3}{2(1+\\sin x)}\"></span>","o":""},{"n":"9","s":[["f'(x)=1\\cdot e^{x}+(x+1)e^{x}","مشتقة الضرب"],["f'(x)=(x+2)e^{x}","بإخراج <span class=m dir=ltr>e^x</span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=(x+2)e^{x}\"></span>","o":""}],[{"n":"10","s":[["f'(x)=2x\\cos x-x^{2}\\sin x","مشتقة الضرب"],["f'\\left(\\frac{\\pi}{2}\\right)=2\\cdot\\frac{\\pi}{2}(0)-\\frac{\\pi^{2}}{4}(1)=-\\frac{\\pi^{2}}{4}","الميل عند <span class=m dir=ltr>x = π/2</span>"],["y-0=-\\frac{\\pi^{2}}{4}\\left(x-\\frac{\\pi}{2}\\right)","معادلة المماس"],["y=-\\frac{\\pi^{2}}{4}x+\\frac{\\pi^{3}}{8}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{\\pi^{2}}{4}x+\\frac{\\pi^{3}}{8}\"></span>","o":""},{"n":"11","s":[["f'(x)=\\frac{\\cos x\\cos x-(1+\\sin x)(-\\sin x)}{\\cos^{2}x}","مشتقة القسمة"],["f'(x)=\\frac{\\cos^{2}x+\\sin^{2}x+\\sin x}{\\cos^{2}x}=\\frac{1+\\sin x}{\\cos^{2}x}","المتطابقة <span class=m dir=ltr>sin²x + cos²x = 1</span>"],["f'(\\pi)=\\frac{1+0}{(-1)^{2}}=1","الميل عند <span class=m dir=ltr>x = π</span>"],["y-(-1)=1(x-\\pi)\\Rightarrow y=x-\\pi-1","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=x-\\pi-1\"></span>","o":""}],[{"n":"12","s":[["f'(x)=\\frac{2x^{2}-(2x-1)(2x)}{x^{4}}=\\frac{-2x^{2}+2x}{x^{4}}=\\frac{2(1-x)}{x^{3}}","مشتقة القسمة والتبسيط"],["f'(x)=0\\Rightarrow 1-x=0\\Rightarrow x=1","المماس الأفقي ميله صفر"],["f(1)=\\frac{2-1}{1}=1","بالتعويض"]],"a":"النقطة <span class=\"tx\" data-t=\"(1,\\,1)\"></span>","o":""},{"n":"13","s":[["h'(x)=\\frac{2x(x^{2}+1)-x^{2}(2x)}{(x^{2}+1)^{2}}=\\frac{2x}{(x^{2}+1)^{2}}","مشتقة القسمة والتبسيط"],["h'(x)=0\\Rightarrow 2x=0\\Rightarrow x=0","المماس الأفقي ميله صفر"],["h(0)=\\frac{0}{1}=0","بالتعويض"]],"a":"النقطة <span class=\"tx\" data-t=\"(0,\\,0)\"></span>","o":""},{"n":"14","s":[["g'(x)=\\frac{8e^{x}-8(x-2)e^{x}}{e^{2x}}=\\frac{8(3-x)}{e^{x}}","مشتقة القسمة والتبسيط"],["g'(x)=0\\Rightarrow 3-x=0\\Rightarrow x=3","<span class=m dir=ltr>e^x</span> لا يساوي صفرًا"],["g(3)=\\frac{8(1)}{e^{3}}=\\frac{8}{e^{3}}","بالتعويض"]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(3,\\,\\frac{8}{e^{3}}\\right)\\approx(3,\\,0.398)\"></span>","o":""}],[{"n":"15","s":[["u'(x)=f'(x)g(x)+f(x)g'(x)","مشتقة الضرب"],["f(1)=2,\\ f'(1)=\\frac{1}{3}","من الشكل: <span class=m dir=ltr>f</span> مستقيم يمر بالنقطتين <span class=m dir=ltr>(1, 2)</span> و <span class=m dir=ltr>(4, 3)</span>، ميله <span class=m dir=ltr>1/3</span>"],["g(1)=3,\\ g'(1)=1","من الشكل: <span class=m dir=ltr>g</span> مستقيم يمر بالنقطتين <span class=m dir=ltr>(0, 2)</span> و <span class=m dir=ltr>(2, 4)</span>"],["u'(1)=\\frac{1}{3}(3)+2(1)=3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"u&#x27;(1)=3\"></span>","o":"قيم مقروءة من الشكل: <span class=m dir=ltr>f</span> يمر بالنقاط <span class=m dir=ltr>(1, 2)</span> و <span class=m dir=ltr>(4, 3)</span> و <span class=m dir=ltr>(7, 4)</span>؛ <span class=m dir=ltr>g(x) = x + 2</span> قرب <span class=m dir=ltr>x = 1</span>"},{"n":"16","s":[["v'(x)=\\frac{f'(x)g(x)-f(x)g'(x)}{(g(x))^{2}}","مشتقة القسمة"],["f(4)=3,\\ f'(4)=\\frac{1}{3}","من الشكل"],["g(4)=2,\\ g'(4)=1","من الشكل: <span class=m dir=ltr>g</span> مستقيم من <span class=m dir=ltr>(3, 1)</span> إلى <span class=m dir=ltr>(7, 5)</span>"],["v'(4)=\\frac{\\frac{1}{3}(2)-3(1)}{2^{2}}=\\frac{-\\frac{7}{3}}{4}=-\\frac{7}{12}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"v&#x27;(4)=-\\frac{7}{12}\"></span>","o":""}],[{"n":"17","s":[["f'(x)=1\\cdot\\sec x+x\\cdot\\sec x\\tan x","مشتقة الضرب، ومشتقة <span class=m dir=ltr>sec x</span> هي <span class=m dir=ltr>sec x tan x</span>"],["f'(x)=\\sec x(1+x\\tan x)","بإخراج <span class=m dir=ltr>sec x</span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\sec x\\,(1+x\\tan x)\"></span> وهو المطلوب","o":""}],[{"n":"18","s":[["f'(x)=\\frac{x\\cdot\\frac{1}{x}-\\ln x\\cdot 1}{x^{2}}=\\frac{1-\\ln x}{x^{2}}","مشتقة القسمة"],["f''(x)=\\frac{x^{2}\\left(-\\frac{1}{x}\\right)-(1-\\ln x)(2x)}{x^{4}}","مشتقة القسمة مرة ثانية"],["=\\frac{-x-2x+2x\\ln x}{x^{4}}=\\frac{2\\ln x-3}{x^{3}}","بالتبسيط والقسمة على <span class=m dir=ltr>x</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1-\\ln x}{x^{2}}\"></span>، <span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=\\frac{2\\ln x-3}{x^{3}}\"></span>","o":""}],[{"n":"19","s":[["a(t)=v'(t)=\\frac{(2t+15)(0)-10(2)}{(2t+15)^{2}}=\\frac{-20}{(2t+15)^{2}}","التسارع مشتقة السرعة (مشتقة القسمة)"],["a(5)=\\frac{-20}{(25)^{2}}=\\frac{-20}{625}=-0.032","بالتعويض <span class=m dir=ltr>t = 5</span>"]],"a":"<span class=\"tx\" data-t=\"a(5)=-0.032\\ \\text{ft/s}^2\"></span>","o":""},{"n":"20","s":[["a(20)=\\frac{-20}{(55)^{2}}=\\frac{-20}{3025}=-\\frac{4}{605}","بالتعويض <span class=m dir=ltr>t = 20</span>"],["a(20)\\approx -0.0066","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"a(20)=-\\frac{4}{605}\\approx -0.0066\\ \\text{ft/s}^2\"></span>","o":""}],[{"n":"21","s":[["A(t)=(6t+5)\\sqrt{t}","المساحة <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["A'(t)=6\\sqrt{t}+(6t+5)\\cdot\\frac{1}{2\\sqrt{t}}","مشتقة الضرب"],["A'(t)=\\frac{12t+6t+5}{2\\sqrt{t}}=\\frac{18t+5}{2\\sqrt{t}}","بتوحيد المقامات"]],"a":"<span class=\"tx\" data-t=\"\\frac{dA}{dt}=\\frac{18t+5}{2\\sqrt{t}}\\ \\text{cm}^2\\text{/s}\"></span>","o":""}],[{"n":"22","s":[["S'(t)=\\frac{2000(4+0.3t)-2000t(0.3)}{(4+0.3t)^{2}}","مشتقة القسمة"],["S'(t)=\\frac{8000}{(4+0.3t)^{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"S&#x27;(t)=\\frac{8000}{(4+0.3t)^{2}}\"></span> ألف دينار لكل سنة","o":""},{"n":"23","s":[["t=2030-2020=10","عدد السنوات بعد <span class=m dir=ltr>2020</span>"],["S'(10)=\\frac{8000}{(4+3)^{2}}=\\frac{8000}{49}\\approx 163.27","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"S&#x27;(10)\\approx 163.27\"></span>: في عام <span class=m dir=ltr>2030</span> تتزايد المبيعات بمعدّل <span class=m dir=ltr>163.27</span> ألف دينار تقريبًا لكل سنة","o":""}],[{"n":"24","s":[["P'(t)=12\\left[4t(t+20)+(2t^{2}+100)(1)\\right]","مشتقة الضرب"],["P'(t)=12(6t^{2}+80t+100)","بالتبسيط"],["P'(t)=72t^{2}+960t+1200","بالتوزيع"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(t)=72t^{2}+960t+1200\"></span> نسمة لكل سنة","o":""},{"n":"25","s":[["P'(6)=72(36)+960(6)+1200","بالتعويض <span class=m dir=ltr>t = 6</span>"],["P'(6)=2592+5760+1200=9552","بالجمع"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(6)=9552\"></span>: بعد <span class=m dir=ltr>6</span> سنوات يتزايد عدد السكان بمعدّل <span class=m dir=ltr>9552</span> نسمة لكل سنة","o":""}]]