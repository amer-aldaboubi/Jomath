[[{"n":"1","s":[["x=-2<-1","نستعمل القاعدة الأولى لأن <span class=\"tx\" data-t=\"-2&lt;-1\"></span>"],["f(-2)=3(-2)^2=3(4)","بالتعويض"],["f(-2)=12","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f(-2)=12\"></span>","o":""},{"n":"2","s":[["-1\\le -1\\le 4","نستعمل القاعدة الثانية"],["f(-1)=4(-1)-3","بالتعويض"],["f(-1)=-7","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f(-1)=-7\"></span>","o":""},{"n":"3","s":[["-1\\le 0\\le 4","نستعمل القاعدة الثانية"],["f(0)=4(0)-3=-3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f(0)=-3\"></span>","o":""},{"n":"4","s":[["-1\\le 4\\le 4","نستعمل القاعدة الثانية"],["f(4)=4(4)-3=13","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f(4)=13\"></span>","o":""},{"n":"5","s":[["8>4","نستعمل القاعدة الثالثة"],["f(8)=2","الاقتران ثابت في هذه الفترة"]],"a":"<span class=\"tx\" data-t=\"f(8)=2\"></span>","o":""},{"n":"6","s":[["5>4","نستعمل القاعدة الثالثة"],["f(5)=2","الاقتران ثابت في هذه الفترة"]],"a":"<span class=\"tx\" data-t=\"f(5)=2\"></span>","o":""}],[{"n":"7","s":[["3x-6=0\\Rightarrow x=2","نجد صفر المقدار داخل القيمة المطلقة"],["x\\ge 2:\\ |3x-6|=3x-6","المقدار غير سالب"],["x<2:\\ |3x-6|=-(3x-6)=-3x+6","المقدار سالب فنضربه في <span class=\"tx\" data-t=\"-1\"></span>"],["f(x)=\\begin{cases}3x-6 &, x\\ge 2\\\\ -3x+6 &, x<2\\end{cases}","إعادة التعريف"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\begin{cases}3x-6 &amp;, x\\ge 2\\\\ -3x+6 &amp;, x&lt;2\\end{cases}\"></span>","o":""},{"n":"8","s":[["7x-5=0\\Rightarrow x=\\frac{5}{7}","صفر المقدار داخل القيمة المطلقة"],["x\\ge \\tfrac{5}{7}:\\ f(x)=7x-5+3=7x-2","المقدار غير سالب"],["x<\\tfrac{5}{7}:\\ f(x)=-(7x-5)+3=-7x+8","المقدار سالب"],["f(x)=\\begin{cases}7x-2 &, x\\ge \\frac{5}{7}\\\\ -7x+8 &, x<\\frac{5}{7}\\end{cases}","إعادة التعريف"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\begin{cases}7x-2 &amp;, x\\ge \\frac{5}{7}\\\\ -7x+8 &amp;, x&lt;\\frac{5}{7}\\end{cases}\"></span>","o":""}],[{"n":"9","s":[["x<-1:\\ y=3-2x,\\ (-1,5)\\ \\text{open},\\ (-2,7),\\ (-3,9)","القطعة الأولى: نصف مستقيم، د