-2)}{2-(-2)}=1,\\ y=x","قطعة مستقيمة تمر بنقطة الأصل وميلها <span class=m dir=ltr>1</span>"],["x>2:\\ y=2","نصف مستقيم أفقي على يمين <span class=\"tx\" data-t=\"x=2\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\begin{cases}-2 &amp;, x&lt;-2\\\\ x &amp;, -2\\le x\\le 2\\\\ 2 &amp;, x&gt;2\\end{cases}\"></span>","o":""},{"n":"16","s":[["-4\\le x\\le -1:\\ y=1","قطعة أفقية بين نقطتين مظللتين"],["m=\\frac{-1-2}{2-(-1)}=-1","ميل القطعة الوسطى من <span class=\"tx\" data-t=\"(-1,2)\"></span> إلى <span class=\"tx\" data-t=\"(2,-1)\"></span>"],["y-2=-1(x+1)\\Rightarrow y=-x+1","صيغة الميل ونقطة"],["2<x\\le 5:\\ y=-2","قطعة أفقية تبدأ بدائرة مفرغة عند <span class=\"tx\" data-t=\"(2,-2)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\begin{cases}1 &amp;, -4\\le x\\le -1\\\\ -x+1 &amp;, -1&lt;x\\le 2\\\\ -2 &amp;, 2&lt;x\\le 5\\end{cases}\"></span>","o":""},{"n":"17","s":[["m=\\frac{0-2}{2-0}=-1","ميل المستقيم المار بالنقطتين <span class=\"tx\" data-t=\"(0,2)\"></span> و <span class=\"tx\" data-t=\"(2,0)\"></span>"],["y=-x+2","المقطع <span class=\"tx\" data-t=\"y\"></span> يساوي <span class=m dir=ltr>2</span>"],["x=1:\\ (1,1)\\ \\text{open},\\ (1,3)","عند <span class=\"tx\" data-t=\"x=1\"></span> تكون قيمة الاقتران <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\begin{cases}-x+2 &amp;, x\\ne 1\\\\ 3 &amp;, x=1\\end{cases}\"></span>","o":""}],[{"n":"18","s":[["(h,k)=(0,-2)","رأس المنحنى"],["a=\\frac{0-(-2)}{2-0}=1","ميل الضلع الأيمن من الرأس إلى <span class=\"tx\" data-t=\"(2,0)\"></span>، والمنحنى مفتوح إلى الأعلى"],["f(x)=a|x-h|+k=|x|-2","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f(x)=|x|-2\"></span>","o":""},{"n":"19","s":[["(h,k)=(0,0)","رأس المنحنى"],["(1,-3)\\Rightarrow a=-3","المنحنى مفتوح إلى الأسفل ويمر بالنقطة <span class=\"tx\" data-t=\"(1,-3)\"></span>"],["f(x)=-3|x|","بالتعويض في <span class=\"tx\" data-t=\"f(x)=a|x-h|+k\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=-3|x|\"></span>","o":""},{"n":"20","s":[["(h,k)=(2,6)",