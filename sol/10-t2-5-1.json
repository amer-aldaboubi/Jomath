[[{"n":"1","s":[["4 - x = -x + 4","بالترتيب تنازليًّا حسب الأسس"],["a_1 = -1,\\ n = 1,\\ a_0 = 4","المعامل الرئيس والدرجة والحد الثابت"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"-x+4\"></span>، المعامل الرئيس <span class=\"tx\" data-t=\"-1\"></span>، الدرجة <span class=\"tx\" data-t=\"1\"></span>، الحد الثابت <span class=\"tx\" data-t=\"4\"></span>","o":""},{"n":"2","s":[["\\frac{5x^2+2x}{x}","يوجد متغير في المقام"],["x \\ne 0","المقدار غير معرَّف عند الصفر"]],"a":"ليس كثير حدود؛ لأنه قسمة على متغير (يوجد <span class=\"tx\" data-t=\"x\"></span> في المقام)","o":""},{"n":"3","s":[["3x(4x-7) + 2x - 12 = 12x^2 - 21x + 2x - 12","خاصية التوزيع"],["= 12x^2 - 19x - 12","بجمع الحدود المتشابهة"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"12x^2-19x-12\"></span>، المعامل الرئيس <span class=\"tx\" data-t=\"12\"></span>، الدرجة <span class=\"tx\" data-t=\"2\"></span>، الحد الثابت <span class=\"tx\" data-t=\"-12\"></span>","o":""},{"n":"4","s":[["3x^2 + 5.3x^3 - 2x = 5.3x^3 + 3x^2 - 2x","بالترتيب تنازليًّا حسب الأسس"],["a_0 = 0","لا يوجد حد ثابت"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"5.3x^3+3x^2-2x\"></span>، المعامل الرئيس <span class=\"tx\" data-t=\"5.3\"></span>، الدرجة <span class=\"tx\" data-t=\"3\"></span>، الحد الثابت <span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"5","s":[["\\sqrt{7}\\,t - 16t^2 = -16t^2 + \\sqrt{7}\\,t","الأسس أعداد صحيحة غير سالبة، والمعاملات أعداد حقيقية"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"-16t^2+\\sqrt{7}\\,t\"></span>، المعامل الرئيس <span class=\"tx\" data-t=\"-16\"></span>، الدرجة <span class=\"tx\" data-t=\"2\"></span>، الحد الثابت <span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"6","s":[["5x^{\\frac{3}{2}}","الأس <span class=\"tx\" data-t=\"\\frac{3}{2}\"></span> ليس عددًا صحيحًا"]],"a":"ليس كثير حدود؛ لأن أحد الأسس كسر (<span class=\"tx\" data-t=\"\\frac{3}{2}\"></span>)","o":""},{"n":"7","s":[["13(2)^x","المتغير في الأس"]],"a":"ليس كثير حدود؛ لأن المتغير <span class=\"tx\" data-t=\"x\"></span> يظهر في الأس","o":""},{"n":"8","s":[["(4-y^2)^2 = 16 - 8y^2 + y^4","مربع ذي الحدين"],["y^3(16 - 8y^2 + y^4) = 16y^3 - 8y^5 + y^7","خاصية التوزيع"],["= y^7 - 8y^5 + 16y^3","بالترتيب تنازليًّا"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"y^7-8y^5+16y^3\"></span>، المعامل الرئيس <span class=\"tx\" data-t=\"1\"></span>، الدرجة <span class=\"tx\" data-t=\"7\"></span>، الحد الثابت <span class=\"tx\" data-t=\"0\"></span>","o":""}],[{"n":"9","s":[["x:\\ -1,\\ 0,\\ 1,\\ 1.5,\\ 2,\\ 3,\\ 4,\\ 5","جدول قيم"],["f(x):\\ 0,\\ -4,\\ -6,\\ -6.25,\\ -6,\\ -4,\\ 0,\\ 6","بالتعويض في القاعدة"],["x = -\\frac{b}{2a} = \\frac{3}{2},\\ f(1.5) = -6.25","الرأس (قطع مكافئ مفتوح للأعلى لأن <span class=\"tx\" data-t=\"a&gt;0\"></span>)"],["\\text{Domain: } [-1, 5],\\ \\text{Range: } [-6.25, 6]",""]],"a":"المجال <span class=\"tx\" data-t=\"-1 \\le x \\le 5\"></span>، المدى <span class=\"tx\" data-t=\"-6.25 \\le y \\le 6\"></span>","o":"نعيّن النقاط ونصلها بمنحنى قطع مكافئ رأسه <span class=\"tx\" data-t=\"(1.5,-6.25)\"></span>، ويقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"-1\"></span> و <span class=\"tx\" data-t=\"4\"></span>، ويبدأ من <span class=\"tx\" data-t=\"(-1,0)\"></span> وينتهي عند <span class=\"tx\" data-t=\"(5,6)\"></span>"},{"n":"10","s":[["x:\\ 0,\\ 0.5,\\ 1,\\ 1.5,\\ 2,\\ 3","جدول قيم"],["f(x):\\ 3,\\ 6,\\ 7,\\ 6,\\ 3,\\ -9","بالتعويض في القاعدة"],["x = -\\frac{8}{2(-4)} = 1,\\ f(1) = 7","الرأس (قطع مكافئ مفتوح للأسفل لأن <span class=\"tx\" data-t=\"a&lt;0\"></span>)"],["\\text{Domain: } [0, 3],\\ \\text{Range: } [-9, 7]",""]],"a":"المجال <span class=\"tx\" data-t=\"0 \\le x \\le 3\"></span>، المدى <span class=\"tx\" data-t=\"-9 \\le y \\le 7\"></span>","o":"منحنى قطع مكافئ مفتوح للأسفل رأسه <span class=\"tx\" data-t=\"(1,7)\"></span>، يبدأ من <span class=\"tx\" data-t=\"(0,3)\"></span> وينتهي عند <span class=\"tx\" data-t=\"(3,-9)\"></span>، ويقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"x \\approx 2.32\"></span>"},{"n":"11","s":[["x:\\ -2,\\ -1,\\ 0,\\ 1,\\ 2,\\ 3","جدول قيم"],["y:\\ 0,\\ 8,\\ 4,\\ 0,\\ 8,\\ 40","بالتعويض في القاعدة"],["\\text{Domain: } [-2, 3],\\ \\text{Range: } [0, 40]","أصغر قيمة <span class=m dir=ltr>0</span> وأكبر قيمة <span class=m dir=ltr>40</span>"]],"a":"المجال <span class=\"tx\" data-t=\"-2 \\le x \\le 3\"></span>، المدى <span class=\"tx\" data-t=\"0 \\le y \\le 40\"></span>","o":"نعيّن النقاط ونصلها بمنحنى متصل: يصعد من <span class=\"tx\" data-t=\"(-2,0)\"></span> إلى <span class=\"tx\" data-t=\"(-1,8)\"></span> ثم ينزل إلى <span class=\"tx\" data-t=\"(1,0)\"></span> ثم يصعد حتى <span class=\"tx\" data-t=\"(3,40)\"></span>"},{"n":"12","s":[["x:\\ -3,\\ -2,\\ -1,\\ 0,\\ 1,\\ 2,\\ 3,\\ 4","جدول قيم"],["y:\\ 23,\\ -2,\\ -9,\\ -4,\\ 7,\\ 18,\\ 23,\\ 16","بالتعويض في القاعدة"],["\\text{Domain: } [-3, 4],\\ \\text{Range: } [-9, 23]","أصغر قيمة <span class=\"tx\" data-t=\"-9\"></span> وأكبر قيمة <span class=\"tx\" data-t=\"23\"></span>"]],"a":"المجال <span class=\"tx\" data-t=\"-3 \\le x \\le 4\"></span>، المدى <span class=\"tx\" data-t=\"-9 \\le y \\le 23\"></span>","o":"نعيّن النقاط ونصلها بمنحنى متصل: ينزل من <span class=\"tx\" data-t=\"(-3,23)\"></span> إلى <span class=\"tx\" data-t=\"(-1,-9)\"></span> ثم يصعد إلى <span class=\"tx\" data-t=\"(3,23)\"></span> ثم ينزل إلى <span class=\"tx\" data-t=\"(4,16)\"></span>"}],[{"n":"13","s":[["(x^4 - 5x^2 + 3x - 6) + (-2x^3 + 5x^2 + 4)","نكتب الاقترانين"],["= x^4 - 2x^3 + (-5+5)x^2 + 3x + (-6+4)","بتجميع الحدود المتشابهة"],["= x^4 - 2x^3 + 3x - 2",""]],"a":"<span class=\"tx\" data-t=\"h(x)+g(x) = x^4-2x^3+3x-2\"></span>","o":""},{"n":"14","s":[["(-2x^3 + 5x^2 + 4) - (x^4 - 5x^2 + 3x - 6)","نكتب الاقترانين"],["= -2x^3 + 5x^2 + 4 - x^4 + 5x^2 - 3x + 6","بتوزيع إشارة السالب"],["= -x^4 - 2x^3 + 10x^2 - 3x + 10","بتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"g(x)-h(x) = -x^4-2x^3+10x^2-3x+10\"></span>","o":""},{"n":"15","s":[["(2x+1)(x^4 - 5x^2 + 3x - 6)","نكتب الاقترانين"],["= 2x^5 - 10x^3 + 6x^2 - 12x + x^4 - 5x^2 + 3x - 6","خاصية التوزيع"],["= 2x^5 + x^4 - 10x^3 + x^2 - 9x - 6","بتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"f(x)\\cdot h(x) = 2x^5+x^4-10x^3+x^2-9x-6\"></span>","o":""},{"n":"16","s":[["x(2x+1) = 2x^2 + x","خاصية التوزيع"],["2x^2 + x + x^4 - 5x^2 + 3x - 6","بإضافة <span class=\"tx\" data-t=\"h(x)\"></span>"],["= x^4 - 3x^2 + 4x - 6","بتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"x(f(x))+h(x) = x^4-3x^2+4x-6\"></span>","o":""},{"n":"17","s":[["(2x+1)^2 = 4x^2 + 4x + 1","مربع ذي الحدين"],["4x^2 + 4x + 1 - (-2x^3 + 5x^2 + 4)","بطرح <span class=\"tx\" data-t=\"g(x)\"></span>"],["= 2x^3 - x^2 + 4x - 3","بتوزيع السالب وتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"(f(x))^2-g(x) = 2x^3-x^2+4x-3\"></span>","o":""},{"n":"18","s":[["x(g(x)) = -2x^4 + 5x^3 + 4x","خاصية التوزيع"],["x^4 - 5x^2 + 3x - 6 - (-2x^4 + 5x^3 + 4x)","بالطرح من <span class=\"tx\" data-t=\"h(x)\"></span>"],["= 3x^4 - 5x^3 - 5x^2 - x - 6","بتوزيع السالب وتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"h(x)-x(g(x)) = 3x^4-5x^3-5x^2-x-6\"></span>","o":""}],[{"n":"19","s":[["s(0) = 0^3 - 3(0)^2 + 2(0) - 6 = -6","بالتعويض <span class=\"tx\" data-t=\"t=0\"></span> لحظة بدء الحركة"]],"a":"موقع الجسم عند بدء الحركة <span class=\"tx\" data-t=\"-6\\ \\text{m}\"></span> (أي <span class=m dir=ltr>6</span> أمتار في الجهة السالبة من نقطة الأصل)","o":""},{"n":"20","s":[["s(4) = 4^3 - 3(4)^2 + 2(4) - 6","بالتعويض <span class=\"tx\" data-t=\"t=4\"></span>"],["= 64 - 48 + 8 - 6 = 18",""]],"a":"موقع الجسم بعد <span class=m dir=ltr>4</span> ثوانٍ: <span class=\"tx\" data-t=\"18\\ \\text{m}\"></span>","o":""},{"n":"21","s":[["t^3 - 3t^2 + 2t - 6 = 0","الجسم عند نقطة الأصل عندما <span class=\"tx\" data-t=\"s(t)=0\"></span>"],["t^2(t-3) + 2(t-3) = 0","بالتحليل بالتجميع"],["(t-3)(t^2+2) = 0","بإخراج العامل المشترك"],["t = 3","لأن <span class=\"tx\" data-t=\"t^2+2&gt;0\"></span> دائمًا (لا صفر له)"]],"a":"يكون الجسم عند نقطة الأصل بعد <span class=\"tx\" data-t=\"3\"></span> ثوانٍ من بدء الحركة","o":""},{"n":"22","s":[["s(t) = -6","الموقع الابتدائي <span class=\"tx\" data-t=\"s(0)=-6\"></span>"],["t^3 - 3t^2 + 2t - 6 = -6 \\Rightarrow t^3 - 3t^2 + 2t = 0","بإضافة <span class=m dir=ltr>6</span> إلى الطرفين"],["t(t-1)(t-2) = 0","بالتحليل"],["t = 0,\\ t = 1,\\ t = 2","خاصية الضرب الصفري"]],"a":"نعم، يعود الجسم إلى نقطة البداية مرتين: بعد ثانية واحدة وبعد ثانيتين","o":""}],[{"n":"23","s":[["V_{cube} = (2x+1)^3 = 8x^3 + 12x^2 + 6x + 1","حجم المكعب <span class=m dir=ltr>= (</span>طول الضلع)<span class=\"tx\" data-t=\"^3\"></span>"],["V_{hole} = x \\cdot x \\cdot (2x+1) = 2x^3 + x^2","حجم التجويف (منشور قاعدته مربع طول ضلعه <span class=\"tx\" data-t=\"x\"></span> وطوله <span class=\"tx\" data-t=\"2x+1\"></span>)"],["V(x) = 8x^3 + 12x^2 + 6x + 1 - (2x^3 + x^2)","الحجم المتبقي <span class=m dir=ltr>=</span> حجم المكعب <span class=m dir=ltr>−</span> حجم التجويف"],["V(x) = 6x^3 + 11x^2 + 6x + 1","بتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"V(x) = 6x^3+11x^2+6x+1\\ \\text{cm}^3\"></span>","o":""}],[{"n":"24","s":[["R(x) = x(150 - 0.3x) = 150x - 0.3x^2","الإيراد <span class=m dir=ltr>=</span> عدد الثريات <span class=m dir=ltr>×</span> سعر الواحدة"],["P(x) = R(x) - C(x)","الربح <span class=m dir=ltr>=</span> الإيراد <span class=m dir=ltr>−</span> التكلفة"],["P(x) = 150x - 0.3x^2 - (6300 + 60x - 0.1x^2)","بالتعويض"],["P(x) = -0.2x^2 + 90x - 6300,\\ 0 \\le x \\le 350","بتجميع الحدود المتشابهة"]],"a":"ربح المصنع: <span class=\"tx\" data-t=\"P(x) = -0.2x^2+90x-6300\"></span> دينارًا، حيث <span class=\"tx\" data-t=\"0 \\le x \\le 350\"></span>","o":"مسألة اليوم (ص <span class=m dir=ltr>8)</span>: مصنع ينتج <span class=\"tx\" data-t=\"x\"></span> ثريا أسبوعيًّا ويبيع الواحدة بسعر <span class=\"tx\" data-t=\"(150-0.3x)\"></span> دينارًا، وتكلفة الإنتاج <span class=\"tx\" data-t=\"(6300+60x-0.1x^2)\"></span> دينارًا"}],[{"n":"25","s":[["s(t) > 0","الجسم في الجهة الموجبة عندما يكون المنحنى فوق محور <span class=\"tx\" data-t=\"t\"></span>"],["s(1) = 0,\\ s(3) = 0","المنحنى يقطع محور <span class=\"tx\" data-t=\"t\"></span> عند <span class=m dir=ltr>1</span> و <span class=m dir=ltr>3</span>"]],"a":"يكون الجسم في الجهة الموجبة في الفترتين: <span class=\"tx\" data-t=\"0 \\le t &lt; 1\"></span> و <span class=\"tx\" data-t=\"t &gt; 3\"></span>","o":""},{"n":"26","s":[["s(0) = 6","نقطة تقاطع المنحنى مع محور <span class=\"tx\" data-t=\"s(t)\"></span> عند <span class=\"tx\" data-t=\"t=0\"></span>"]],"a":"الموقع الابتدائي للجسم <span class=\"tx\" data-t=\"6\\ \\text{m}\"></span> في الجهة الموجبة","o":""},{"n":"27","s":[["(2, -2)","أدنى نقطة على المنحنى (الرأس)"],["|-2| = 2",""]],"a":"أبعد موقع في الجهة السالبة هو <span class=\"tx\" data-t=\"-2\"></span>، أي على بعد <span class=\"tx\" data-t=\"2\\ \\text{m}\"></span> من نقطة الأصل، عند <span class=\"tx\" data-t=\"t = 2\"></span> ثانية","o":""}],[{"n":"28","s":[["f(x) = x + 1,\\quad g(x) = x^2 - x + 1","ذو حدين وثلاثي حدود"],["f(x)\\cdot g(x) = x^3 - x^2 + x + x^2 - x + 1","خاصية التوزيع"],["= x^3 + 1","بتجميع الحدود المتشابهة (تُحذف الحدود الوسطى)"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"(x+1)(x^2-x+1) = x^3+1\"></span> وهو ذو حدين","o":""}],[{"n":"29","s":[["x^3 - x^2 - 4x + 4 = 0","أصفار الاقتران تحقق <span class=\"tx\" data-t=\"f(x)=0\"></span>"],["x^2(x-1) - 4(x-1) = 0","بالتحليل بالتجميع"],["(x-1)(x^2-4) = 0","بإخراج العامل المشترك"],["(x-1)(x-2)(x+2) = 0","فرق بين مربعين"],["x = 1,\\ x = 2,\\ x = -2","خاصية الضرب الصفري"]],"a":"أصفار الاقتران: <span class=\"tx\" data-t=\"-2, 1, 2\"></span>","o":""}],[{"n":"30","s":[["\\deg f = m,\\ \\deg g = n","نفرض درجتي الاقترانين"],["\\deg(f \\pm g) \\le \\max(m, n)","عند الجمع أو الطرح نجمع معاملات الحدود المتشابهة فقط، ولا ترتفع الأسس"],["m \\ne n \\Rightarrow \\deg(f \\pm g) = \\max(m, n)","إذا تساوت الدرجتان وتعاكس المعاملان الرئيسان قد تقل الدرجة، مثل <span class=\"tx\" data-t=\"(x^2+1)+(-x^2+x)=x+1\"></span>"],["\\deg(f \\cdot g) = m + n","عند الضرب: <span class=\"tx\" data-t=\"x^m \\cdot x^n = x^{m+n}\"></span> وحاصل ضرب المعاملين الرئيسين لا يساوي صفرًا"]],"a":"درجة <span class=\"tx\" data-t=\"f+g\"></span> ودرجة <span class=\"tx\" data-t=\"f-g\"></span> أقل من أو تساوي أكبر الدرجتين، ودرجة <span class=\"tx\" data-t=\"f\\cdot g\"></span> تساوي مجموع الدرجتين","o":""}],[{"n":"2","s":[["f(-2)=3(-2)^2+5(-2)+7","بالتعويض <span class=m dir=ltr>x = −2</span>"],["=12-10+7=9",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"9\"></span>","o":""}],[{"n":"3","s":[["(2x^3-4x^2+6)-(5x^2-7x+4)",""],["=2x^3-4x^2-5x^2+7x+6-4","بتوزيع إشارة السالب"],["=2x^3-9x^2+7x+2","بجمع الحدود المتشابهة"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"2x^3-9x^2+7x+2\"></span>","o":""}],[{"n":"10","s":[["x^2f(x)=2x^4-4x^3+x^2","بالتوزيع"],["x^2f(x)+g(x)=2x^4-4x^3+x^2+6x^3-7x+3",""],["=2x^4+2x^3+x^2-7x+3","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"2x^4+2x^3+x^2-7x+3\"></span>","o":""}],[{"n":"11","s":[["(3x^2-4x)(4x^3+2x+5)",""],["=12x^5+6x^3+15x^2-16x^4-8x^2-20x","خاصية التوزيع"],["=12x^5-16x^4+6x^3+7x^2-20x","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"h(x)\\cdot j(x)=12x^5-16x^4+6x^3+7x^2-20x\"></span>","o":""}],[{"n":"22","s":[["(0,200),\\ (6,-100)","نقطتان على المستقيم"],["m=\\frac{-100-200}{6-0}=-50","الميل"],["s(t)=-50t+200","المقطع الصادي <span class=m dir=ltr>200</span>"]],"a":"<span class=\"tx\" data-t=\"s(t)=200-50t\"></span>","o":""},{"n":"23","s":[["200-50t=0","عند نقطة الأصل <span class=m dir=ltr>s = 0</span>"],["t=4",""]],"a":"<span class=\"tx\" data-t=\"4\"></span> ثوانٍ","o":""}],[{"n":"1","s":[["2x^{-1}","أس المتغير سالب"]],"a":"ليس كثير حدود","o":""},{"n":"2","s":[["3\\tfrac{1}{5}x^2=\\frac{16}{5}x^2","تحويل العدد الكسري"],["-5x^3+\\frac{16}{5}x^2+7x-1","الصورة القياسية"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"-5x^3+\\frac{16}{5}x^2+7x-1\"></span>؛ الدرجة <span class=m dir=ltr>3</span>، المعامل الرئيس <span class=\"tx\" data-t=\"-5\"></span>، الحد الثابت <span class=\"tx\" data-t=\"-1\"></span>","o":""},{"n":"3","s":[["\\frac{8(3-2x)}{5}=\\frac{24-16x}{5}","خاصية التوزيع"],["=-\\frac{16}{5}x+\\frac{24}{5}","الصورة القياسية"]],"a":"كثير حدود: <span class=\"tx\" data-t=\"-\\frac{16}{5}x+\\frac{24}{5}\"></span>؛ الدرجة <span class=m dir=ltr>1</span>، المعامل الرئيس <span class=\"tx\" data-t=\"-\\frac{16}{5}\"></span>، الحد الثابت <span class=\"tx\" data-t=\"\\frac{24}{5}\"></span>","o":""},{"n":"4","s":[["\\sqrt{x^2+16}","المتغير داخل الجذر"]],"a":"ليس كثير حدود","o":""}],[{"n":"5","s":[["f(-2)=-21,\\ f(-1)=-7,\\ f(0)=-5,\\ f(1)=-3,\\ f(2)=11,\\ f(3)=49","جدول قيم"],["D=[-2,\\,3]","المجال المعطى"],["R=[-21,\\,49]","الاقتران متزايد، فالمدى من <span class=m dir=ltr>f(−2)</span> إلى <span class=m dir=ltr>f(3)</span>"]],"a":"المجال <span class=\"tx\" data-t=\"-2\\le x\\le 3\"></span>، المدى <span class=\"tx\" data-t=\"-21\\le y\\le 49\"></span>","o":"نصل النقاط بمنحنى أملس متزايد يبدأ عند <span class=\"tx\" data-t=\"(-2,-21)\"></span> وينتهي عند <span class=\"tx\" data-t=\"(3,49)\"></span>."},{"n":"6","s":[["r(-2)=19,\\ r(-1)=7.5,\\ r(0)=5,\\ r(1)=5.5,\\ r(2)=3","جدول قيم"],["D=[-2,\\,2]","المجال المعطى"],["R=[3,\\,19]","أصغر قيمة <span class=m dir=ltr>r(2) = 3</span> وأكبر قيمة <span class=m dir=ltr>r(−2) = 19</span>"]],"a":"المجال <span class=\"tx\" data-t=\"-2\\le x\\le 2\"></span>، المدى <span class=\"tx\" data-t=\"3\\le y\\le 19\"></span>","o":"المنحنى ينزل من <span class=\"tx\" data-t=\"(-2,19)\"></span> إلى قيمة صغرى محلية <span class=\"tx\" data-t=\"(0,5)\"></span> ثم يصعد إلى قيمة عظمى محلية <span class=\"tx\" data-t=\"(1,5.5)\"></span> ثم ينزل إلى <span class=\"tx\" data-t=\"(2,3)\"></span>."},{"n":"7","s":[["g(x)=-(x^2+4x)+12=-(x+2)^2+16","بإكمال المربع"],["\\text{vertex}=(-2,16)","رأس القطع (مفتوح للأسفل)"],["x^2+4x-12=0 \\Rightarrow (x+6)(x-2)=0","المقاطع السينية: <span class=m dir=ltr>x = −6, x = 2</span>"],["g(0)=12","المقطع الصادي"],["D=\\mathbb{R},\\ R=\\{y\\mid y\\le 16\\}",""]],"a":"المجال: جميع الأعداد الحقيقية، المدى: <span class=\"tx\" data-t=\"y\\le 16\"></span>","o":"قطع مكافئ مفتوح للأسفل رأسه <span class=\"tx\" data-t=\"(-2,16)\"></span> يمر بـ <span class=\"tx\" data-t=\"(-6,0)\"></span> و <span class=\"tx\" data-t=\"(2,0)\"></span> و <span class=\"tx\" data-t=\"(0,12)\"></span>."},{"n":"8","s":[["\\text{vertex}:\\ 2x-5=0 \\Rightarrow (2.5,\\,-10)","أصغر قيمة عندما يكون المربع صفرًا"],["h(0)=25-10=15","المقطع الصادي"],["(2x-5)^2=10 \\Rightarrow x=\\frac{5\\pm\\sqrt{10}}{2}\\approx 0.92,\\ 4.08","المقاطع السينية"],["D=\\mathbb{R},\\ R=\\{y\\mid y\\ge -10\\}",""]],"a":"المجال: جميع الأعداد الحقيقية، المدى: <span class=\"tx\" data-t=\"y\\ge -10\"></span>","o":"قطع مكافئ مفتوح للأعلى رأسه <span class=\"tx\" data-t=\"(2.5,-10)\"></span> يمر بـ <span class=\"tx\" data-t=\"(0,15)\"></span> و <span class=\"tx\" data-t=\"(5,15)\"></span>."}],[{"n":"9","s":[["(-4x^3+2x^2+5x-1)+(x^3+5x^2-7)",""],["=-3x^3+7x^2+5x-8","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"-3x^3+7x^2+5x-8\"></span>","o":""},{"n":"10","s":[["(-4x^3+2x^2+5x-1)-(x^3+5x^2-7)",""],["=-5x^3-3x^2+5x+6","بتوزيع إشارة السالب وجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"-5x^3-3x^2+5x+6\"></span>","o":""},{"n":"11","s":[["x\\,h(x)=2x^2-4x",""],["(x^3+5x^2-7)-(2x^2-4x)=x^3+3x^2+4x-7",""]],"a":"<span class=\"tx\" data-t=\"x^3+3x^2+4x-7\"></span>","o":""},{"n":"12","s":[["(2x-4)(-4x^3+2x^2+5x-1)",""],["=-8x^4+4x^3+10x^2-2x+16x^3-8x^2-20x+4","خاصية التوزيع"],["=-8x^4+20x^3+2x^2-22x+4",""]],"a":"<span class=\"tx\" data-t=\"-8x^4+20x^3+2x^2-22x+4\"></span>","o":""},{"n":"13","s":[["(2x-4)^2=4x^2-16x+16","مربع ذي الحدين"],["4x^2-16x+16-4x^3+2x^2+5x-1",""],["=-4x^3+6x^2-11x+15",""]],"a":"<span class=\"tx\" data-t=\"-4x^3+6x^2-11x+15\"></span>","o":""},{"n":"14","s":[["(-4x^3+2x^2+5x-1)(x^3+5x^2-7)",""],["=-4x^6-20x^5+28x^3+2x^5+10x^4-14x^2+5x^4+25x^3-35x-x^3-5x^2+7","خاصية التوزيع"],["=-4x^6-18x^5+15x^4+52x^3-19x^2-35x+7","بجمع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"-4x^6-18x^5+15x^4+52x^3-19x^2-35x+7\"></span>","o":""}],[{"n":"15","s":[["h(-2)=-(-2)^4-5(-2)^3+7(-2)-10","بالتعويض <span class=m dir=ltr>x = −2</span>"],["=-16+40-14-10=0",""]],"a":"نعم، <span class=\"tx\" data-t=\"-2\"></span> صفر للاقتران لأن <span class=\"tx\" data-t=\"h(-2)=0\"></span>","o":""}],[{"n":"16","s":[["(x-1)^3-3(x-1)^2=0","نساوي الاقتران بالصفر"],["(x-1)^2\\big[(x-1)-3\\big]=0","بإخراج العامل المشترك"],["(x-1)^2(x-4)=0",""],["x=1,\\ x=4","خاصية الضرب الصفري"]],"a":"أصفار الاقتران: <span class=\"tx\" data-t=\"x=1\"></span> و <span class=\"tx\" data-t=\"x=4\"></span>","o":""}],[{"n":"17","s":[["s(0)=2(0)-20(0)+5(0)-50=-50","بالتعويض <span class=m dir=ltr>t = 0</span>"]],"a":"<span class=\"tx\" data-t=\"-50\\ \\text{m}\"></span>","o":""},{"n":"18","s":[["s(2)=2(8)-20(4)+5(2)-50","بالتعويض <span class=m dir=ltr>t = 2</span>"],["=16-80+10-50=-104",""]],"a":"<span class=\"tx\" data-t=\"-104\\ \\text{m}\"></span>","o":""},{"n":"19","s":[["2t^3-20t^2+5t-50=0","عند نقطة الأصل <span class=m dir=ltr>s = 0</span>"],["2t^2(t-10)+5(t-10)=0","التحليل بالتجميع"],["(t-10)(2t^2+5)=0",""],["t=10","لأن <span class=m dir=ltr>2t² + 5 &gt; 0</span> دائمًا"]],"a":"بعد <span class=\"tx\" data-t=\"10\"></span> ثوانٍ","o":""},{"n":"20","s":[["2t^3-20t^2+5t-50=-50","نقطة البداية <span class=m dir=ltr>s = −50</span>"],["t(2t^2-20t+5)=0","بإضافة <span class=m dir=ltr>50</span> للطرفين وإخراج <span class=m dir=ltr>t</span>"],["t=\\frac{20\\pm\\sqrt{400-40}}{4}=\\frac{10\\pm 3\\sqrt{10}}{2}","القانون العام"],["t\\approx 0.26,\\ t\\approx 9.74",""]],"a":"نعم، يعود الجسم إلى موقع البداية <span class=\"tx\" data-t=\"-50\\ \\text{m}\"></span> عند <span class=\"tx\" data-t=\"t\\approx 0.26\\ \\text{s}\"></span> وعند <span class=\"tx\" data-t=\"t\\approx 9.74\\ \\text{s}\"></span>","o":""}]]