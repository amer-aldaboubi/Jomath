[[{"n":"1","s":[["3(2)+(-2)=6-2=4","بالتعويض في المعادلة الأولى: صحيحة"],["(2)-3(-2)=2+6=8","بالتعويض في المعادلة الثانية: صحيحة"]],"a":"نعم، <span class=\"tx\" data-t=\"(2,-2)\"></span> حلٌّ للنظام لأنه يحقق المعادلتين","o":""},{"n":"2","s":[["-7(-1)-4=7-4=3","بالتعويض في المعادلة الأولى: صحيحة"],["8(-1)+5=-3\\ne 3","بالتعويض في المعادلة الثانية: غير صحيحة"]],"a":"لا، <span class=\"tx\" data-t=\"(-1,3)\"></span> ليس حلًّا للنظام لأنه لا يحقق المعادلة الثانية","o":""}],[{"n":"3","s":[["(2,\\,2)","نقطة تقاطع المستقيم الأخضر <span class=\"tx\" data-t=\"y=x\"></span> مع الأحمر <span class=\"tx\" data-t=\"2x+y=6\"></span>"],["2=2,\\quad 2(2)+2=6","التحقق بالتعويض في المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(2,2)\"></span>","o":"","k":[{"p":["2","2"]}]},{"n":"4","s":[["(3,\\,0)","نقطة تقاطع المستقيم الأزرق مع الأحمر (على محور <span class=m dir=ltr>x)</span>"],["2(0)+3=3,\\quad 2(3)+0=6","التحقق بالتعويض في المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(3,0)\"></span>","o":"","k":[{"p":["3","0"]}]},{"n":"5","s":[["(-3,\\,-3)","نقطة تقاطع المستقيم الأزرق مع الأخضر"],["2(-3)+3=-3,\\quad -3=-3","التحقق بالتعويض في المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(-3,-3)\"></span>","o":"","k":[{"p":["-3","-3"]}]}],[{"n":"6","s":[["y=4x+2","المقطع <span class=m dir=ltr>2</span> والميل <span class=m dir=ltr>4</span>"],["y=-2x-4","المقطع <span class=m dir=ltr>−4</span> والميل <span class=m dir=ltr>−2</span>"],["4x+2=-2x-4\\Rightarrow x=-1,\\ y=-2","يتقاطع المستقيمان في النقطة <span class=m dir=ltr>(−1, −2)</span>"],["4(-1)+2=-2,\\quad -2(-1)-4=-2","التحقق"]],"a":"الحل: <span class=\"tx\" data-t=\"(-1,-2)\"></span>","o":"أمثّل المستقيم الأول بالنقطتين <span class=\"tx\" data-t=\"(0,2)\"></span> و<span class=\"tx\" data-t=\"(1,6)\"></span>، والثاني بالنقطتين <span class=\"tx\" data-t=\"(0,-4)\"></span> و<span class=\"tx\" data-t=\"(-2,0)\"></span>، فيتقاطعان في <span class=\"tx\" data-t=\"(-1,-2)\"></span>","k":[{"p":["-1","-2"]}]},{"n":"7","s":[["m_1=1,\\ b_1=-6","المستقيم الأول"],["m_2=1,\\ b_2=2","المستقيم الثاني"],["m_1=m_2,\\ b_1\\ne b_2","الميلان متساويان والمقطعان مختلفان: مستقيمان متوازيان"]],"a":"لا يوجد حل للنظام (المستقيمان متوازيان)","o":"المستقيم الأول يمر بـ <span class=\"tx\" data-t=\"(0,-6)\"></span> و<span class=\"tx\" data-t=\"(6,0)\"></span>، والثاني يمر بـ <span class=\"tx\" data-t=\"(0,2)\"></span> و<span class=\"tx\" data-t=\"(-2,0)\"></span>"},{"n":"8","s":[["y=-3","مستقيم أفقي يمر بالنقطة <span class=m dir=ltr>(0, −3)</span>"],["y=x-3","المقطع <span class=m dir=ltr>−3</span> والميل <span class=m dir=ltr>1</span>"],["-3=x-3\\Rightarrow x=0","نقطة التقاطع"]],"a":"الحل: <span class=\"tx\" data-t=\"(0,-3)\"></span>","o":"المستقيمان يتقاطعان على محور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"(0,-3)\"></span>","k":[{"p":["0","-3"]}]},{"n":"9","s":[["3x+3y=12\\Rightarrow x+y=4","بقسمة طرفي المعادلة الثانية على <span class=m dir=ltr>3</span>"],["y=-x+4","المعادلتان تمثلان المستقيم نفسه"]],"a":"عدد لانهائي من الحلول (المستقيمان منطبقان)","o":"المستقيم يمر بالنقطتين <span class=\"tx\" data-t=\"(0,4)\"></span> و<span class=\"tx\" data-t=\"(4,0)\"></span>"},{"n":"10","s":[["2x+3y=12:\\ (0,4),\\ (6,0)","المقطعان للمستقيم الأول"],["2x-y=4:\\ (0,-4),\\ (2,0)","المقطعان للمستقيم الثاني"],["(3,\\,2)","نقطة التقاطع من التمثيل البياني"],["2(3)+3(2)=12,\\quad 2(3)-2=4","التحقق"]],"a":"الحل: <span class=\"tx\" data-t=\"(3,2)\"></span>","o":"","k":[{"p":["3","2"]}]},{"n":"11","s":[["y=6x+3,\\ y=2x+3","المقطع نفسه <span class=m dir=ltr>3</span> والميلان مختلفان"],["(0,\\,3)","يتقاطع المستقيمان عند المقطع <span class=m dir=ltr>y</span>"]],"a":"الحل: <span class=\"tx\" data-t=\"(0,3)\"></span>","o":"","k":[{"p":["0","3"]}]},{"n":"12","s":[["8x-4y=16\\Rightarrow y=2x-4","بحل المعادلة الأولى بالنسبة إلى <span class=m dir=ltr>y</span>"],["-5x-5y=5\\Rightarrow y=-x-1","بحل المعادلة الثانية بالنسبة إلى <span class=m dir=ltr>y</span>"],["(1,\\,-2)","نقطة التقاطع من التمثيل البياني"],["8(1)-4(-2)=16,\\quad -5(1)-5(-2)=5","التحقق"]],"a":"الحل: <span class=\"tx\" data-t=\"(1,-2)\"></span>","o":"المستقيم الأول يمر بـ <span class=\"tx\" data-t=\"(0,-4)\"></span> و<span class=\"tx\" data-t=\"(2,0)\"></span>، والثاني يمر بـ <span class=\"tx\" data-t=\"(0,-1)\"></span> و<span class=\"tx\" data-t=\"(-1,0)\"></span>","k":[{"p":["1","-2"]}]},{"n":"13","s":[["-2x+3y=-6\\ \\xrightarrow{\\times(-2)}\\ 4x-6y=12","بضرب المعادلة الثانية في <span class=m dir=ltr>−2</span> تصبح مثل الأولى"],["y=\\frac{2}{3}x-2","المستقيمان منطبقان"]],"a":"عدد لانهائي من الحلول (المستقيمان منطبقان)","o":"المستقيم يمر بالنقطتين <span class=\"tx\" data-t=\"(0,-2)\"></span> و<span class=\"tx\" data-t=\"(3,0)\"></span>"},{"n":"14","s":[["3x+2y=1\\Rightarrow y=-\\frac{3}{2}x+\\frac{1}{2}","بضرب المعادلة الأولى في <span class=m dir=ltr>4</span>"],["4x+y=3\\Rightarrow y=-4x+3","بضرب المعادلة الثانية في <span class=m dir=ltr>6</span>"],["(1,\\,-1)","نقطة التقاطع من التمثيل البياني"],["\\frac{3}{4}-\\frac{1}{2}=\\frac{1}{4},\\quad \\frac{2}{3}-\\frac{1}{6}=\\frac{1}{2}","التحقق"]],"a":"الحل: <span class=\"tx\" data-t=\"(1,-1)\"></span>","o":"المستقيم الأول يمر بـ <span class=\"tx\" data-t=\"(1,-1)\"></span> و<span class=\"tx\" data-t=\"(-1,2)\"></span>، والثاني يمر بـ <span class=\"tx\" data-t=\"(0,3)\"></span> و<span class=\"tx\" data-t=\"(1,-1)\"></span>","k":[{"p":["1","-1"]}]}],[{"n":"15","s":[["y=x+26","<span class=m dir=ltr>x</span> عمر نوال، <span class=m dir=ltr>y</span> عمر والدتها"],["x+y=50","مجموع العمرين"],["x+(x+26)=50\\Rightarrow 2x=24\\Rightarrow x=12","بالتعويض ثم الحل"],["y=12+26=38","بالتعويض في المعادلة الأولى"]],"a":"عمر نوال <span class=m dir=ltr>12</span> عامًا، وعمر والدتها <span class=m dir=ltr>38</span> عامًا","o":"بيانيًا: يتقاطع المستقيمان <span class=\"tx\" data-t=\"y=x+26\"></span> و<span class=\"tx\" data-t=\"y=-x+50\"></span> في النقطة <span class=\"tx\" data-t=\"(12,38)\"></span>"}],[{"n":"16","s":[["y=1+0.5x","الموقع الأول: <span class=m dir=ltr>x</span> عدد الأعوام بعد <span class=m dir=ltr>2018</span>، <span class=m dir=ltr>y</span> عدد الزيارات بالملايين"],["y=10-x","الموقع الثاني"]],"a":"النظام: <span class=\"tx\" data-t=\"y=0.5x+1\"></span> و <span class=\"tx\" data-t=\"y=-x+10\"></span>","o":"","k":[{"e":"0.5*x + 1","a":true},{"e":"10 - x","a":null}]},{"n":"17","s":[["0.5x+1=-x+10","نساوي المعادلتين (أو نقطة تقاطع المستقيمين)"],["1.5x=9\\Rightarrow x=6","بجمع <span class=m dir=ltr>x</span> وطرح <span class=m dir=ltr>1</span> من الطرفين ثم القسمة على <span class=m dir=ltr>1.5</span>"],["y=10-6=4","بالتعويض"],["2018+6=2024","السنة"]],"a":"يتساوى عدد الزيارات عام <span class=m dir=ltr>2024</span>م، ويكون <span class=m dir=ltr>4</span> ملايين زيارة لكل موقع","o":""}],[{"n":"18","s":[["12x-3y=4y+3\\Rightarrow 12x-7y=3","الضلعان المتقابلان (العلوي والسفلي) متساويان"],["5x+2=3x+2y\\Rightarrow y=x+1","الضلعان المتقابلان (الأيسر والأيمن) متساويان"],["12x-7(x+1)=3\\Rightarrow 5x=10\\Rightarrow x=2","بالتعويض"],["y=2+1=3","بالتعويض في <span class=\"tx\" data-t=\"y=x+1\"></span>"],["12(2)-3(3)=15=4(3)+3,\\quad 5(2)+2=12=3(2)+2(3)","التحقق"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span> ، <span class=\"tx\" data-t=\"y=3\"></span> (أبعاد المستطيل <span class=\"tx\" data-t=\"15\"></span> و <span class=\"tx\" data-t=\"12\"></span>)","o":"","k":[{"e":"2","a":null},{"e":"3","a":null},{"e":"15","a":null},{"e":"12","a":null}]}],[{"n":"19","s":[["y=0.3x+0.6","الشجرة الأولى: <span class=m dir=ltr>x</span> عدد السنوات، <span class=m dir=ltr>y</span> الطول بالمتر"],["y=0.15x+1.8","الشجرة الثانية"],["0.3x+0.6=0.15x+1.8\\Rightarrow 0.15x=1.2","نقطة تقاطع المستقيمين"],["x=8,\\quad y=0.3(8)+0.6=3","بالقسمة على <span class=m dir=ltr>0.15</span> ثم التعويض"]],"a":"بعد <span class=m dir=ltr>8</span> سنوات يصبح طول كل من الشجرتين <span class=\"tx\" data-t=\"3\\,\\text{m}\"></span>","o":"مسألة أستكشف ص<span class=m dir=ltr>40</span>: يتقاطع المستقيمان في النقطة <span class=\"tx\" data-t=\"(8,3)\"></span>"}],[{"n":"20","s":[["","المستقيمان المختلفان يتقاطعان في نقطة واحدة على الأكثر"],["","إذا اشترك مستقيمان في نقطتين مختلفتين فهما المستقيم نفسه، فيكون للنظام عدد لانهائي من الحلول"]],"a":"لا، لا يمكن أن يكون للنظام حلّان فقط؛ فإما حل واحد، أو لا يوجد حل، أو عدد لانهائي من الحلول","o":""}],[{"n":"21","s":[["2(3)-3(-1)=9\\ne 3","النقطة <span class=m dir=ltr>(3, −1)</span> لا تحقق المعادلة الثانية، فالخطأ في تمثيل المستقيم الثاني"],["(2x-3y)-(x-3y)=3-6\\Rightarrow x=-3","بطرح المعادلة الأولى من الثانية"],["-3-3y=6\\Rightarrow y=-3","بالتعويض في المعادلة الأولى"],["-3-3(-3)=6,\\quad 2(-3)-3(-3)=3","التحقق"]],"a":"الحل الصحيح هو <span class=\"tx\" data-t=\"(-3,-3)\"></span>","o":"الخطأ: المستقيم <span class=\"tx\" data-t=\"2x-3y=3\"></span> مُثّل بشكل غير صحيح؛ يجب أن يمر بالنقطتين <span class=\"tx\" data-t=\"(0,-1)\"></span> و<span class=\"tx\" data-t=\"(1.5,0)\"></span>، والمستقيم <span class=\"tx\" data-t=\"x-3y=6\"></span> يمر بـ <span class=\"tx\" data-t=\"(0,-2)\"></span> و<span class=\"tx\" data-t=\"(6,0)\"></span>، فيتقاطعان في <span class=\"tx\" data-t=\"(-3,-3)\"></span>","k":[{"p":["-3","-3"]}]}],[{"n":"22","s":[["y=2x+1,\\quad y=2x+5","نظام ليس له حل: الميل نفسه والمقطعان مختلفان (متوازيان)"],["y=x+2,\\quad 2y=2x+4","نظام له عدد لانهائي من الحلول: المعادلة الثانية مضاعف الأولى (منطبقان)"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\{y=2x+1,\\ y=2x+5\\}\"></span> ليس له حل، و <span class=\"tx\" data-t=\"\\{y=x+2,\\ 2y=2x+4\\}\"></span> له عدد لانهائي من الحلول","o":""}],[{"n":"23","s":[["","أمثّل المعادلتين في المستوى الإحداثي نفسه (بالميل والمقطع أو بالمقطعين)"],["","أحدد نقطة تقاطع المستقيمين، فهي حل النظام"],["","أتحقق بتعويض النقطة في المعادلتين"],["","إذا توازى المستقيمان فلا حل، وإذا انطبقا فعدد لانهائي من الحلول"]],"a":"أمثّل المستقيمين بيانيًا، ونقطة تقاطعهما هي حل النظام","o":""}],[{"n":"3","s":[["-3y = -6x + 18 \\Rightarrow y = 2x - 6","بقسمة طرفي المعادلة الثانية في <span class=m dir=ltr>c</span> على <span class=m dir=ltr>−3</span>"],["2x - y = 6 \\Rightarrow y = 2x - 6","بحل المعادلة الأولى في <span class=m dir=ltr>c</span> بالنسبة إلى <span class=\"tx\" data-t=\"y\"></span>"],["m = 2,\\ b = -6","المعادلتان متكافئتان: الميل نفسه والمقطع نفسه، فالمستقيمان منطبقان"]],"a":"<span class=m dir=ltr>c)</span> النظام له عدد لا نهائي من الحلول","o":"في <span class=m dir=ltr>a</span> و <span class=m dir=ltr>d</span> المستقيمان متقاطعان (حل واحد)، وفي <span class=m dir=ltr>b</span> متوازيان (الميل <span class=m dir=ltr>2</span> والمقطعان مختلفان) فلا حل"}],[{"n":"4","s":[["\\frac{4x + 8y}{4} = \\frac{12}{4}","بقسمة طرفي المعادلة على <span class=m dir=ltr>4</span>"],["x + 2y = 3","معادلة مكافئة، لها التمثيل البياني نفسه"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"x + 2y = 3\"></span>","o":"","k":[{"q":"x + 2*y - 3"}]}],[{"n":"5","s":[["y = 2x - 5:\\ (0, -5),\\ (3, 1)","أمثّل المستقيم الأول بنقطتين"],["y = -2x + 7:\\ (0, 7),\\ (3, 1)","أمثّل المستقيم الثاني بنقطتين"],["2(3) - 5 = 1,\\quad -2(3) + 7 = 1","التحقق من نقطة التقاطع"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 1)\"></span>","o":"المستقيمان يتقاطعان في النقطة <span class=\"tx\" data-t=\"(3, 1)\"></span>","k":[{"p":["3","1"]}]},{"n":"6","s":[["y = x + 4:\\ (0, 4),\\ (3, 7)","المستقيم الأول"],["y = 2x + 1:\\ (0, 1),\\ (3, 7)","المستقيم الثاني"],["3 + 4 = 7,\\quad 2(3) + 1 = 7","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 7)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(3, 7)\"></span>","k":[{"p":["3","7"]}]},{"n":"7","s":[["x + 2y = 3:\\ (3, 0),\\ (1, 1)","المستقيم الأول (المقطع <span class=\"tx\" data-t=\"x\"></span> هو <span class=m dir=ltr>3)</span>"],["y = 4x - 3:\\ (0, -3),\\ (1, 1)","المستقيم الثاني"],["1 + 2(1) = 3,\\quad 4(1) - 3 = 1","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(1, 1)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(1, 1)\"></span>","k":[{"p":["1","1"]}]},{"n":"8","s":[["y = 4 - x:\\ (0, 4),\\ (4, 0)","المستقيم الأول"],["y = x - 4:\\ (0, -4),\\ (4, 0)","المستقيم الثاني"],["4 - 4 = 0,\\quad 4 - 4 = 0","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(4, 0)\"></span>","o":"المستقيمان يتقاطعان على المحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(4, 0)\"></span>","k":[{"p":["4","0"]}]},{"n":"9","s":[["y = 0.5x + 10:\\ (0, 10),\\ (4, 12)","المستقيم الأول"],["y = 4x - 4:\\ (0, -4),\\ (4, 12)","المستقيم الثاني"],["0.5(4) + 10 = 12,\\quad 4(4) - 4 = 12","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(4, 12)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(4, 12)\"></span>","k":[{"p":["4","12"]}]},{"n":"10","s":[["y + x = 0 \\Rightarrow y = -x:\\ (0, 0),\\ (-3, 3)","المستقيم الأول"],["3y + 6x = -9 \\Rightarrow y = -2x - 3:\\ (0, -3),\\ (-3, 3)","بقسمة الطرفين على <span class=m dir=ltr>3</span>، ثم أمثّل"],["3 + (-3) = 0,\\quad 3(3) + 6(-3) = -9","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(-3, 3)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(-3, 3)\"></span>","k":[{"p":["-3","3"]}]},{"n":"11","s":[["7x + 2y = 13 \\Rightarrow y = \\frac{13 - 7x}{2}:\\ (1, 3),\\ (3, -4)","المستقيم الأول"],["3y - 2x = -3 \\Rightarrow y = \\frac{2x - 3}{3}:\\ (0, -1),\\ (3, 1)","المستقيم الثاني"],["(1.8,\\ 0.2)","نقطة التقاطع ليست عند نقطة شبكة؛ تُقدَّر من الرسم وتُتحقَّق جبريًّا"],["7(1.8) + 2(0.2) = 13,\\quad 3(0.2) - 2(1.8) = -3","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"\\left(\\frac{9}{5}, \\frac{1}{5}\\right) = (1.8, 0.2)\"></span>","o":"يتقاطع المستقيمان قرب النقطة <span class=\"tx\" data-t=\"(2, 0)\"></span>؛ القيمة الدقيقة <span class=\"tx\" data-t=\"(1.8, 0.2)\"></span>"},{"n":"12","s":[["y - x = 17 \\Rightarrow y = x + 17:\\ (0, 17),\\ (5, 22)","المستقيم الأول"],["y = 4x + 2:\\ (0, 2),\\ (5, 22)","المستقيم الثاني"],["22 - 5 = 17,\\quad 4(5) + 2 = 22","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(5, 22)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(5, 22)\"></span> (يُستعمل مقياس مناسب على المحور <span class=\"tx\" data-t=\"y\"></span>)","k":[{"p":["5","22"]}]}],[{"n":"13","s":[["x = -3,\\quad y = 2x + 1","مستقيم رأسي ومستقيم ميله <span class=m dir=ltr>2</span>: يتقاطعان في الرسم"],["y = 2(-3) + 1 = -5","نقطة التقاطع <span class=\"tx\" data-t=\"(-3, -5)\"></span>"]],"a":"حل واحد: <span class=\"tx\" data-t=\"(-3, -5)\"></span>","o":"","k":[{"p":["-3","-5"]}]},{"n":"14","s":[["m_1 = 2,\\quad m_2 = 2","الميلان متساويان"],["b_1 = 1 \\ne b_2 = -4","المقطعان مختلفان، فالمستقيمان متوازيان"]],"a":"لا يوجد حل","o":""},{"n":"15","s":[["y + x = -2 \\Rightarrow y = -x - 2","بطرح <span class=\"tx\" data-t=\"x\"></span> من الطرفين"],["y = -x - 2","المعادلتان متطابقتان، فالمستقيمان منطبقان"]],"a":"عدد لا نهائي من الحلول","o":""},{"n":"16","s":[["2y - 4x = 2 \\Rightarrow y = 2x + 1","بإضافة <span class=\"tx\" data-t=\"4x\"></span> ثم القسمة على <span class=m dir=ltr>2</span>"],["m_1 = m_2 = 2,\\quad 1 \\ne -4","ميل متساوٍ ومقطع مختلف: متوازيان"]],"a":"لا يوجد حل","o":""},{"n":"17","s":[["m_1 = -3 \\ne m_2 = 2","الميلان مختلفان، فالمستقيمان متقاطعان"],["-3x + 6 = 2x - 4 \\Rightarrow x = 2,\\ y = 0","نقطة التقاطع من الرسم <span class=\"tx\" data-t=\"(2, 0)\"></span>"]],"a":"حل واحد: <span class=\"tx\" data-t=\"(2, 0)\"></span>","o":"","k":[{"p":["2","0"]}]},{"n":"18","s":[["2y - 4x = 2 \\Rightarrow y = 2x + 1","الصورة المكافئة للمعادلة الأولى"],["m_1 = 2 \\ne m_2 = -3","الميلان مختلفان: متقاطعان"],["2x + 1 = -3x + 6 \\Rightarrow x = 1,\\ y = 3","نقطة التقاطع <span class=\"tx\" data-t=\"(1, 3)\"></span>"]],"a":"حل واحد: <span class=\"tx\" data-t=\"(1, 3)\"></span>","o":"","k":[{"p":["1","3"]}]}],[{"n":"30","s":[["y - 3x = 6 \\Rightarrow y = 3x + 6","بإضافة <span class=\"tx\" data-t=\"3x\"></span> إلى الطرفين: الميل <span class=m dir=ltr>3</span>"],["y = 3x - 2:\\ m = 3,\\ b = -2 \\ne 6","الميل نفسه والمقطع مختلف، فالمستقيمان متوازيان"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"y = 3x - 2\"></span>","o":"","k":[{"e":"3*x - 2","a":null}]}],[{"n":"31","s":[["y = -4x + 7,\\quad y = 3x","بكتابة المعادلتين بصيغة الميل والمقطع"],["m_1 = -4 \\ne m_2 = 3","الميلان مختلفان، فالمستقيمان متقاطعان في نقطة واحدة"],["7x = 7 \\Rightarrow x = 1,\\ y = 3","بجمع المعادلتين: الحل <span class=\"tx\" data-t=\"(1, 3)\"></span>"]],"a":"<span class=m dir=ltr>b)</span> حل واحد فقط","o":""}],[{"n":"1","s":[["(2, 2)","نقطة تقاطع المستقيمين <span class=\"tx\" data-t=\"y = x\"></span> و <span class=\"tx\" data-t=\"y = 6 - 2x\"></span> من الرسم"],["2 = 2,\\quad 6 - 2(2) = 2","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(2, 2)\"></span>","o":"","k":[{"p":["2","2"]}]},{"n":"2","s":[["(3, 0)","نقطة تقاطع المستقيمين على المحور <span class=\"tx\" data-t=\"x\"></span>"],["2(3) + 3(0) = 6,\\quad 6 - 2(3) = 0","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 0)\"></span>","o":"","k":[{"p":["3","0"]}]},{"n":"3","s":[["y = -2x + 6,\\quad y = -2x - 2","بكتابة المعادلتين بصيغة الميل والمقطع"],["m_1 = m_2 = -2,\\quad 6 \\ne -2","الميل نفسه والمقطع مختلف: المستقيمان متوازيان لا يتقاطعان"]],"a":"لا يوجد حل","o":""},{"n":"4","s":[["(-3, 4)","نقطة تقاطع المستقيمين من الرسم"],["2(-3) + 3(4) = 6,\\quad 4 + 2(-3) = -2","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(-3, 4)\"></span>","o":"","k":[{"p":["-3","4"]}]}],[{"n":"5","s":[["y = -x + 4:\\ (0, 4),\\ (4, 0)","المستقيم الأول"],["y = 2x - 8:\\ (0, -8),\\ (4, 0)","المستقيم الثاني"],["-4 + 4 = 0,\\quad 2(4) - 8 = 0","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(4, 0)\"></span>","o":"يتقاطع المستقيمان على المحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(4, 0)\"></span>","k":[{"p":["4","0"]}]},{"n":"6","s":[["y = 3x - 1:\\ (0, -1),\\ (2, 5)","المستقيم الأول"],["y = 7 - x:\\ (0, 7),\\ (2, 5)","المستقيم الثاني"],["3(2) - 1 = 5,\\quad 7 - 2 = 5","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(2, 5)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(2, 5)\"></span>","k":[{"p":["2","5"]}]},{"n":"7","s":[["y = 5x - 5:\\ (0, -5),\\ (1, 0)","المستقيم الأول"],["y = 5x + 3:\\ (0, 3),\\ (-1, -2)","المستقيم الثاني"],["m_1 = m_2 = 5,\\quad -5 \\ne 3","متوازيان لا يتقاطعان"]],"a":"لا يوجد حل","o":"مستقيمان متوازيان"},{"n":"8","s":[["2x + y = -3 \\Rightarrow y = -2x - 3:\\ (0, -3),\\ (2, -7)","المستقيم الأول"],["2x - y = 11 \\Rightarrow y = 2x - 11:\\ (0, -11),\\ (2, -7)","المستقيم الثاني"],["2(2) + (-7) = -3,\\quad 2(2) - (-7) = 11","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(2, -7)\"></span>","o":"نقطة التقاطع <span class=\"tx\" data-t=\"(2, -7)\"></span>","k":[{"p":["2","-7"]}]},{"n":"9","s":[["6x + 3y = 15 \\Rightarrow y = -2x + 5:\\ (0, 5),\\ (2.5, 0)","بقسمة الطرفين على <span class=m dir=ltr>3</span> ثم أمثّل"],["2x - y = 5 \\Rightarrow y = 2x - 5:\\ (0, -5),\\ (2.5, 0)","المستقيم الثاني"],["6(2.5) + 0 = 15,\\quad 2(2.5) - 0 = 5","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(2.5, 0)\"></span>","o":"يتقاطع المستقيمان على المحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(2.5, 0)\"></span>","k":[{"p":["2.5","0"]}]},{"n":"10","s":[["y = 3x + 3:\\ (0, 3),\\ (-1, 0)","المستقيم الأول"],["y = x + 3:\\ (0, 3),\\ (-3, 0)","المستقيم الثاني"],["3(0) + 3 = 3,\\quad 0 + 3 = 3","التحقق"]],"a":"الحل <span class=\"tx\" data-t=\"(0, 3)\"></span>","o":"يتقاطع المستقيمان على المحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"(0, 3)\"></span>","k":[{"p":["0","3"]}]}],[{"n":"11","s":[["2y = x - 3 \\Rightarrow y = \\frac{1}{2}x - \\frac{3}{2}","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["(3, 0),\\ (1, -1),\\ (5, 1)","نقاط على المستقيم: المقطع <span class=\"tx\" data-t=\"x\"></span> هو <span class=m dir=ltr>3</span> والمقطع <span class=\"tx\" data-t=\"y\"></span> هو <span class=\"tx\" data-t=\"-1.5\"></span>"]],"a":"مستقيم ميله <span class=\"tx\" data-t=\"\\frac{1}{2}\"></span> يمر بالنقطتين <span class=\"tx\" data-t=\"(1, -1)\"></span> و <span class=\"tx\" data-t=\"(3, 0)\"></span>","o":"أصل بين النقاط وأمدّ المستقيم ليقطع المستقيم المرسوم","k":[{"e":"1/2","a":null},{"p":["1","-1"]},{"p":["3","0"]}]},{"n":"12","s":[["x = 2y + 3","من المعادلة الثانية"],["2(2y + 3) + 3y = 13 \\Rightarrow 7y + 6 = 13","بالتعويض ف