ss=\"tx\" data-t=\"4\"></span> من جدول المجموع (<span class=\"tx\" data-t=\"36\"></span> خانة)"],["P=\\frac{3}{36}=\\frac{1}{12}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac{1}{12}\"></span>","o":""},{"n":"11","s":[["(1,6),(2,5),(3,4),(4,3),(5,2),(6,1)","النواتج التي مجموعها <span class=\"tx\" data-t=\"7\"></span>"],["P=\\frac{6}{36}=\\frac16","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac16\"></span>","o":""},{"n":"12","s":[["(1,1),(1,2),(2,1)","المجموع <span class=\"tx\" data-t=\"2\"></span> أو <span class=\"tx\" data-t=\"3\"></span>"],["P=\\frac{3}{36}=\\frac{1}{12}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac{1}{12}\"></span>","o":""},{"n":"13","s":[["2,4,6,8,10,12","المجاميع الزوجية؛ وعدد خاناتها في الجدول <span class=\"tx\" data-t=\"1+3+5+5+3+1=18\"></span>"],["P=\\frac{18}{36}=\\frac12","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac12\"></span>","o":""},{"n":"14","s":[["3,6,9,12","المجاميع من مضاعفات <span class=m dir=ltr>3</span>؛ عدد خاناتها <span class=\"tx\" data-t=\"2+5+4+1=12\"></span>"],["P=\\frac{12}{36}=\\frac13","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac13\"></span>","o":""},{"n":"15","s":[["4,\\ 9","المجاميع التي هي مربعات كاملة (بين <span class=\"tx\" data-t=\"2\"></span> و <span class=\"tx\" data-t=\"12\"></span>)"],["3+4=7","المجموع <span class=\"tx\" data-t=\"4\"></span> في <span class=\"tx\" data-t=\"3\"></span> خانات، والمجموع <span class=\"tx\" data-t=\"9\"></span> في <span class=\"tx\" data-t=\"4\"></span> خانات"],["P=\\frac{7}{36}",""]],"a":"<span class=\"tx\" data-t=\"P=\\frac{7}{36}\"></span>","o":""}],[{"n":"16","s":[["3\\times3=9","الشكل <span class=m dir=ltr>(1)</span>: <span class=\"tx\" data-t=\"A,B,C\"></span>، والشكل <span class=m dir=ltr>(2)</span>: <span class=\"tx\" data-t=\"B,C,D\"></span> (أجزاء متطابقة)"],["(B,B),\\ (C,C)","النواتج التي يتوقف فيها المؤشران على الحرف نفسه"],["P=\\frac{2}{9}",""]],"a":"احتمال الحصول على نقطة <span class=\"tx\" data-t=\"\\frac29\"></span>","o":""}],[{"n":"17","s":[["\\text{نرمز: } M_1, M_2 \\text{ (مربى)}, C \\text{ (شوكولاتة)}, K \\text{ (كريمة)}","نسمي حبات الكعك"],["4 \\times 3 = 12","عدد النواتج في الجدول (لا تُرجع الكعكة الأولى، فلا يتكرر الصف مع العمود نفسه)"],["(M_1, M_2),\\ (M_2, M_1)","النواتج التي تكون فيها الحبتان بالمربى"],["P = \\frac{2}{12} = \\frac{1}{6}","عدد النواتج المرغوبة <span class=m dir=ltr>÷</span> عدد النواتج الكلي"]],"a":"<span class=\"tx\" data-t=\"P(\\text{مربى، مربى}) = \\frac{1}{6}\"></span>","o":"الجدول <span class=m dir=ltr>4×4</span> تُشطب منه خانات القطر (الكعكة نفسها مرتين) فيبقى <span class=m dir=ltr>12</span> ناتجًا."},{"n":"18","s":[["(K,M_1),(K,M_2),(K,C),(M_1,K),(M_2,K),(C,K)","النواتج التي تحوي حبة الكريمة"],["6","عدد النواتج المرغوبة"],["P = \\frac{6}{12} = \\frac{1}{2}","من <span class=m dir=ltr>12</span> ناتجًا ممكنًا"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{2}\"></span>","o":""},{"n":"19","s":[["\\text{توجد حبة شوكولاتة واحدة فقط}","لا يمكن أخذها مرتين"],["P = \\frac{0}{12} = 0","حادث مستحيل"]],"a":"<span class=\"tx\" data-t=\"P = 0\"></span> (حادث مستحيل)","o":""}],[{"n":"20","s":[["4 \\times 4 = 16","عدد النواتج في جدول حاصل الضرب"],["1 \\times 4,\\ 4 \\times 1,\\ 2 \\times 2","النواتج التي حاصل ضربها <span class=m dir=ltr>4</span>"],["P = \\frac{3}{16}","<span class=m dir=ltr>3</span> نواتج من <span class=m dir=ltr>16</span>"]],"a":"<span class=\"tx\" data-t=\"P(4) = \\frac{3}{16}\"></span>","o":""},{"n":"21","s":[["1 \\times 3,\\ 3 \\times 1","النواتج التي حاصل ضربها <span class=m dir=ltr>3</span>"],["P = \\frac{2}{16} = \\frac{1}{8}","<span class=m dir=ltr>2</span> من <span class=m dir=ltr>16</span> بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(3) = \\frac{1}{8}\"></span>","o":""}],[{"n":"22","s":[["8 \\times 8 = 64","عدد النواتج في الجدول"],["4,\\ 16,\\ 36,\\ 64","المربعات الكاملة الزوجية الممكنة (أكبر ناتج هو <span class=m dir=ltr>64)</span>"],["4: (1,4),(4,1),(2,2)","<span class=m dir=ltr>3</span> نواتج"],["16: (2,8),(8,2),(4,4)","<span class=m dir=ltr>3</span> نواتج"],["36: (6,6) \\quad 64: (8,8)","ناتجان"],["P = \\frac{3+3+1+1}{64} = \\frac{8}{64} = \\frac{1}{8}","مجموع النواتج المرغوبة <span class=m dir=ltr>÷ 64</span>"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{8}\"></span>","o":"التبرير: نكوّن جدولًا <span class=m dir=ltr>8×8</span> لحاصل الضرب، ثم نعدّ الخانات التي فيها مربع كامل زوجي <span class=m dir=ltr>(4</span>، <span class=m dir=ltr>16</span>، <span class=m dir=ltr>36</span>، <span class=m dir=ltr>64)</span> فنجدها <span class=m dir=ltr>8</span> خانات من <span class=m dir=ltr>64</span>."}],[{"n":"23","s":[["6 \\times 6 = 36","عدد النواتج في جدول حاصل الضرب"],["20,\\ 24,\\ 25,\\ 30","حواصل الضرب الممكنة بين <span class=m dir=ltr>19</span> و <span class=m dir=ltr>35</span>"],["(4,5),(5,4),(4,6),(6,4),(5,5),(5,6),(6,5)","<span class=m dir=ltr>7</span> نواتج"],["P(\\text{بين 19 و 35}) = \\frac{7}{36}",""],["P(\\text{ليس بينهما}) = 1 - \\frac{7}{36} = \\frac{29}{36}","احتمال المتممة"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{29}{36}\"></span>","o":"التبرير: الحادث «ألّا يكون الناتج بين <span class=m dir=ltr>19</span> و<span class=m dir=ltr>35</span>» متمم للحادث «أن يكون بينهما»، لذا نطرح احتماله من <span class=m dir=ltr>1</span>."}],[{"n":"24","s":[["\\text{رمي قطعة نقد ثم رمي حجر نرد}","التجربة العشوائية (إجابة ممكنة)"],["2 \\times 6 = 12","عدد النواتج"],["(H,2),(H,4),(H,6)","الحادث المركب: ظهور صورة وعدد زوجي"],["P = \\frac{3}{12} = \\frac{1}{4}",""]],"a":"إجابة ممكنة: احتمال ظهور صورة وعدد زوجي <span class=\"tx\" data-t=\"= \\frac{1}{4}\"></span>","o":""}],[{"n":"25","s":[["\\text{1) أرسم فروعًا لنواتج المرحلة الأولى}",""],["\\text{2) من كل فرع أرسم فروعًا لنواتج المرحلة الثانية}",""],["\\text{3) أعدّ المسارات (النواتج الكلية)}","كل مسار من البداية إلى النهاية ناتج واحد"],["P = \\frac{\\text{عدد المسارات المرغوبة}}{\\text{عدد المسارات الكلي}}","أعدّ المسارات التي تحقق الحادث"]],"a":"أرسم مخطط الشجرة لجميع مراحل التجربة، فيكون كل مسار ناتجًا، ثم أقسم عدد المسارات التي تحقق الحادث المركب على عدد المسارات الكلي.","o":"مثال: رمي قطعتي نقد: <span class=m dir=ltr>4</span> مسارات، ومسار واحد (صورة، صورة)، فالاحتمال <span class=\"tx\" data-t=\"\\frac{1}{4}\"></span>."}],[{"n":"11","s":[["6 \\times 6 = 36","عدد النواتج في الجدول"],["(5,5),(5,6),(6,5),(6,6)","كلا العددين أكبر من <span class=m dir=ltr>4</span>"],["P = \\frac{4}{36} = \\frac{1}{9}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{9}\"></span>","o":""},{"n":"12","s":[["\\{2, 4, 6\\} \\times \\{2, 4, 6\\}","كلا العددين زوجي"],["3 \\times 3 = 9","عدد النواتج المرغوبة"],["P = \\frac{9}{36} = \\frac{1}{4}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{4}\"></span>","o":""}],[{"n":"15","s":[["5 \\times 5 = 25","عدد النقاط في مخطط الاحتمال؛ نكتب عند كل نقطة <span class=m dir=ltr>(x, y)</span> المجموع <span class=m dir=ltr>x + y</span>"],["(1,4),(2,3),(3,2),(4,1)","النواتج التي مجموعها <span class=m dir=ltr>5</span>"],["P = \\frac{4}{25}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{4}{25}\"></span>","o":"إكمال المخطط: العمود <span class=m dir=ltr>x = 1</span> يحوي <span class=m dir=ltr>2, 3, 4, 5, 6</span> من الأسفل للأعلى، وكل عمود تالٍ يزيد بمقدار <span class=m dir=ltr>1</span>، حتى النقطة <span class=m dir=ltr>(5, 5)</span> وعندها <span class=m dir=ltr>10</span>."},{"n":"16","s":[["x + y \\text{ زوجي} \\iff x, y \\text{ كلاهما فردي أو كلاهما زوجي}",""],["3 \\times 3 + 2 \\times 2 = 9 + 4 = 13","فرديان من <span class=m dir=ltr>{1,3,5}</span> أو زوجيان من <span class=m dir=ltr>{2,4}</span>"],["P = \\frac{13}{25}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{13}{25}\"></span>","o":""},{"n":"17","s":[["2: 1,\\ 3: 2,\\ 4: 3,\\ 5: 4,\\ 6: 5","عدد النقاط لكل مجموع أقل من <span class=m dir=ltr>7</span>"],["1 + 2 + 3 + 4 + 5 = 15",""],["P = \\frac{15}{25} = \\frac{3}{5}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{3}{5}\"></span>","o":""}],[{"n":"21","s":[["P(2) = \\frac{1}{4}","في السحب الأول"],["P(2) = \\frac{1}{4}","في السحب الثاني (بعد إرجاع البطاقة)"],["P = \\frac{1}{4} \\times \\frac{1}{4} = \\frac{1}{16}","من مخطط الشجرة: مسار واحد من <span class=m dir=ltr>16</span>"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\frac{1}{16}\"></span>","o":""}],[{"n":"1","s":[["3 + 3 = 6","مثلث من <span class=m dir=ltr>A</span> فقط <span class=m dir=ltr>(3</span> خانات) أو من <span class=m dir=ltr>B</span> فقط <span class=m dir=ltr>(3</span> خانات)، دون خانة المثلثين"],["P = \\frac{6}{16} = \\frac{3}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{3}{8}\"></span>","o":""},{"n":"2","s":[["A:\\ \\bigcirc,\\ \\text{سداسي أبيض};\\quad B:\\ \\square","الأشكال البيضاء"],["2 \\times 1 = 2",""],["P = \\frac{2}{16} = \\frac{1}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{8}\"></span>","o":""},{"n":"3","s":[["A:\\ 2 \\text{ (مربع، مثلث)};\\quad B:\\ 3 \\text{ (دائرة، سداسي، مثلث)}","الأشكال السوداء"],["2 \\times 3 = 6",""],["P = \\frac{6}{16} = \\frac{3}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{3}{8}\"></span>","o":""},{"n":"4","s":[["3 \\times 3 = 9","نستبعد صف الدائرة وعمود الدائرة"],["P = \\frac{9}{16}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{9}{16}\"></span>","o":""},{"n":"5","s":[["\\text{دائرة } 0,\\ \\text{مربع } 4,\\ \\text{سداسي } 6,\\ \\text{مثلث } 3","عدد الأضلاع"],["0+0,\\ 0+4,\\ 4+0,\\ 0+3,\\ 3+0","النواتج التي مجموعها أقل من <span class=m dir=ltr>5 (5</span> نواتج)"],["16 - 5 = 11",""],["P = \\frac{11}{16}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{11}{16}\"></span>","o":""}],[{"n":"6","s":[["4 \\times 4 = 16","عدد النواتج <span class=m dir=ltr>(A</span>: <span class=m dir=ltr>R,B,G,R</span> و <span class=m dir=ltr>B</span>: <span class=m dir=ltr>R,B,B,G)</span>"],["RR: 2 \\times 1 = 2,\\quad BB: 1 \\times 2 = 2,\\quad GG: 1 \\times 1 = 1",""],["P = \\frac{2+2+1}{16} = \\frac{5}{16}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{5}{16}\"></span>","o":""},{"n":"7","s":[["\\text{لا أحمر: } 2 \\times 3 = 6","غير أحمر من <span class=m dir=ltr>A (2)</span> ومن <span class=m dir=ltr>B (3)</span>"],["P = 1 - \\frac{6}{16} = \\frac{10}{16} = \\frac{5}{8}","احتمال المتممة"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{5}{8}\"></span>","o":""}],[{"n":"8","s":[["4 \\times 2 = 8","<span class=m dir=ltr>A</span>: <span class=m dir=ltr>1, 2, 3, 5</span> و <span class=m dir=ltr>B</span>: <span class=m dir=ltr>1, 3</span>"],["2,4,4,6,3,5,6,8","المجاميع: <span class=m dir=ltr>(1,1),(1,3),(3,1),(3,3),(2,1),(2,3),(5,1),(5,3)</span>"],["P(5) = \\frac{1}{8}","الناتج <span class=m dir=ltr>(2,3)</span> فقط"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{8}\"></span>","o":""},{"n":"9","s":[["(3,3)=6,\\ (5,1)=6,\\ (5,3)=8","المجاميع الأكبر من <span class=m dir=ltr>5</span>"],["P = \\frac{3}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{3}{8}\"></span>","o":""}],[{"n":"10","s":[["2 \\times 2 \\times 2 = 8","عدد مسارات مخطط الشجرة"],["TTT","المسار الوحيد بلا صورة"],["P = 1 - \\frac{1}{8} = \\frac{7}{8}","احتمال المتممة"]],"a":"<span class=\"tx\" data-t=\"P = \\frac{7}{8}\"></span>","o":""},{"n":"11","s":[["TTH,\\ THT,\\ HTT","كتابة مرتين فقط"],["P = \\frac{3}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{3}{8}\"></span>","o":""},{"n":"12","s":[["HHH","عدم ظهور كتابة"],["P = \\frac{1}{8}",""]],"a":"<span class=\"tx\" data-t=\"P = \\frac{1}{8}\"></span>","o":""}]]