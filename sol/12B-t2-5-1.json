[[{"n":"1","s":[["\\text{trials: } n=25 \\text{ (fixed)}","عدد المحاولات (الأسئلة) ثابت ومحدَّد مسبقًا"],["X=\\text{number of correct answers}","المتغيّر يعدّ النجاحات من بين <span class=m dir=ltr>25</span>، ولا يتوقف عند أوّل نجاح"]],"a":"لا، لا تُمثِّل تجربة هندسية؛ لأن التجربة لا تستمر حتى أوّل نجاح، بل عدد المحاولات ثابت (<span class=\"tx\" data-t=\"25\"></span>) ونَعُدّ النجاحات (هي تجربة ذات حدّين <span class=\"tx\" data-t=\"p=\\frac{1}{5}\"></span>).","o":""}],[{"n":"2","s":[["\\text{success: scoring},\\ p=0.3","لكل رمية نتيجتان فقط: إحراز (نجاح) أو عدم إحراز (فشل)"],["q=1-p=0.7","الرميات مستقلة واحتمال النجاح ثابت"],["X\\sim Geo(0.3)","التجربة تتكرّر حتى أوّل نجاح ثم تتوقف"]],"a":"نعم، تُمثِّل تجربة احتمالية هندسية، و <span class=\"tx\" data-t=\"X\\sim Geo(0.3)\"></span> حيث <span class=\"tx\" data-t=\"X\"></span> عدد الرميات حتى أوّل إحراز.","o":""}],[{"n":"3","s":[["P(X=x)=p(1-p)^{x-1}","صيغة التوزيع الاحتمالي للمتغيّر الهندسي"],["P(X=2)=(0.2)(0.8)^{1}","بتعويض <span class=\"tx\" data-t=\"x=2,\\ p=0.2\"></span>"],["=0.160","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=2)=0.160\"></span>","o":"","k":[{"e":"0.16","a":true}]},{"n":"4","s":[["P(X\\le 3)=1-P(X>3)","احتمال المتمّمة"],["=1-(1-p)^{3}=1-(0.8)^{3}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)=(1-p)^x\"></span>"],["=1-0.512=0.488","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 3)=0.488\"></span>","o":""},{"n":"5","s":[["P(X\\ge 3)=P(X>2)","لأن <span class=\"tx\" data-t=\"X\"></span> يأخذ قيمًا صحيحة"],["=(0.8)^{2}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)=(1-p)^x\"></span>"],["=0.640","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 3)=0.640\"></span>","o":""},{"n":"6","s":[["P(3\\le X\\le 5)=P(X=3)+P(X=4)+P(X=5)","احتمال الحوادث المتنافية"],["=0.2(0.8)^2+0.2(0.8)^3+0.2(0.8)^4","صيغة التوزيع الهندسي"],["=0.128+0.1024+0.08192","بالتبسيط"],["=0.31232\\approx 0.312","بالتقريب لأقرب <span class=m dir=ltr>3</span> منازل"]],"a":"<span class=\"tx\" data-t=\"P(3\\le X\\le 5)\\approx 0.312\"></span>","o":"","k":[{"e":"0.312","a":true}]},{"n":"7","s":[["P(X<4)=P(X\\le 3)","لأن <span class=\"tx\" data-t=\"X\"></span> يأخذ قيمًا صحيحة"],["=1-(0.8)^{3}","احتمال المتمّمة"],["=0.488","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;4)=0.488\"></span>","o":""},{"n":"8","s":[["P(X>4)=(1-p)^{4}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)\"></span> في التوزيع الهندسي"],["=(0.8)^{4}=0.4096","بالتعويض"],["\\approx 0.410","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;4)\\approx 0.410\"></span>","o":"","k":[{"e":"0.41","a":true}]},{"n":"9","s":[["P(1<X<3)=P(X=2)","القيمة الصحيحة الوحيدة بين <span class=m dir=ltr>1</span> و <span class=m dir=ltr>3</span>"],["=(0.2)(0.8)^{1}=0.160","صيغة التوزيع الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(1&lt;X&lt;3)=0.160\"></span>","o":""},{"n":"10","s":[["P(4<X\\le 6)=P(X=5)+P(X=6)","احتمال الحوادث المتنافية"],["=0.2(0.8)^4+0.2(0.8)^5","صيغة التوزيع الهندسي"],["=0.08192+0.065536=0.147456","بالتبسيط"],["\\approx 0.147","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(4&lt;X\\le 6)\\approx 0.147\"></span>","o":"","k":[{"e":"0.147","a":true}]},{"n":"11","s":[["x\\in\\{1,2,3,\\dots\\}","أصغر قيمة للمتغيّر الهندسي هي <span class=m dir=ltr>1</span>"],["P(X<1)=0","حادث مستحيل"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;1)=0\"></span>","o":""}],[{"n":"12","s":[["p=\\frac{1}{8},\\ X\\sim Geo\\left(\\frac{1}{8}\\right)","احتمال ظهور <span class=m dir=ltr>7</span> في كل رمية، والتوقف عند أوّل ظهور"],["P(X=x)=p(1-p)^{x-1}","صيغة التوزيع الهندسي"],["P(X=6)=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^{5}","بتعويض <span class=\"tx\" data-t=\"x=6\"></span>"],["=\\frac{16807}{262144}\\approx 0.0641","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=6)=\\frac{16807}{262144}\\approx 0.0641\"></span>","o":"","k":[{"e":"0.0641","a":true}]}],[{"n":"13","s":[["E(X)=\\frac{1}{p}","توقّع المتغيّر الهندسي"],["=\\frac{1}{0.3}=\\frac{10}{3}\\approx 3.33","بتعويض <span class=\"tx\" data-t=\"p=0.3\"></span>"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{10}{3}\\approx 3.33\"></span>","o":"","k":[{"e":"3.33","a":true}]},{"n":"14","s":[["E(X)=\\frac{1}{p}","توقّع المتغيّر الهندسي"],["=\\frac{1}{3/7}=\\frac{7}{3}\\approx 2.33","بتعويض <span class=\"tx\" data-t=\"p=\\frac{3}{7}\"></span>"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{7}{3}\\approx 2.33\"></span>","o":"","k":[{"e":"2.33","a":true}]},{"n":"15","s":[["E(X)=\\frac{1}{p}","توقّع المتغيّر الهندسي"],["=\\frac{1}{0.45}=\\frac{20}{9}\\approx 2.22","بتعويض <span class=\"tx\" data-t=\"p=0.45\"></span>"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{20}{9}\\approx 2.22\"></span>","o":"","k":[{"e":"2.22","a":true}]}],[{"n":"16","s":[["X\\sim Geo(0.2)","<span class=\"tx\" data-t=\"X\"></span>: عدد الأسهم حتى أوّل إصابة"],["E(X)=\\frac{1}{p}=\\frac{1}{0.2}","توقّع المتغيّر الهندسي"],["=5","بالتبسيط"]],"a":"يُتوقَّع أن تُطلق لينا <span class=\"tx\" data-t=\"5\"></span> أسهم.","o":"","k":[{"e":"5","a":null}]}],[{"n":"17","s":[["P(X>3)=(1-p)^{3}=0.512","قانون <span class=\"tx\" data-t=\"P(X&gt;x)\"></span>"],["1-p=\\sqrt[3]{0.512}=0.8","بأخذ الجذر التكعيبي للطرفين"],["p=0.2","بحل المعادلة"],["E(X)=\\frac{1}{p}=\\frac{1}{0.2}=5","توقّع المتغيّر الهندسي"]],"a":"<span class=\"tx\" data-t=\"E(X)=5\"></span>","o":"","k":[{"e":"5","a":null}]}],[{"n":"18","s":[["E(X)=\\frac{1}{p}=8\\ \\Rightarrow\\ p=\\frac{1}{8}","توقّع المتغيّر الهندسي"],["P(X<4)=P(X\\le 3)=1-(1-p)^{3}","احتمال المتمّمة"],["=1-\\left(\\frac{7}{8}\\right)^{3}=1-\\frac{343}{512}","بالتعويض"],["=\\frac{169}{512}\\approx 0.330","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;4)=\\frac{169}{512}\\approx 0.330\"></span>","o":"","k":[{"e":"0.33","a":true}]}],[{"n":"19","s":[["X\\sim Geo(0.1)","<span class=\"tx\" data-t=\"p=0.10\"></span> احتمال أن تكون الوحدة معيبة"],["P(X=5)=(0.1)(0.9)^{4}","صيغة التوزيع الهندسي بتعويض <span class=\"tx\" data-t=\"x=5\"></span>"],["=0.06561","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=5)=0.06561\\approx 0.0656\"></span>","o":"","k":[{"e":"0.0656","a":true}]},{"n":"20","s":[["P(X>4)=(1-p)^{4}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)\"></span>"],["=(0.9)^{4}=0.6561","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;4)=0.6561\"></span>","o":""},{"n":"21","s":[["E(X)=\\frac{1}{p}=\\frac{1}{0.1}","توقّع المتغيّر الهندسي"],["=10","بالتبسيط"]],"a":"العدد المتوقَّع <span class=\"tx\" data-t=\"10\"></span> وحدات إنارة.","o":"","k":[{"e":"10","a":null}]}],[{"n":"22","s":[["p=\\frac{1}{4},\\ X\\sim Geo\\left(\\frac{1}{4}\\right)","القطاعات الأربعة متطابقة، والأخضر واحد منها"],["P(X=3)=\\frac{1}{4}\\left(\\frac{3}{4}\\right)^{2}","صيغة التوزيع الهندسي"],["=\\frac{9}{64}\\approx 0.1406","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=3)=\\frac{9}{64}\\approx 0.1406\"></span>","o":"","k":[{"e":"0.1406","a":true}]},{"n":"23","s":[["P(X\\le 4)=1-P(X>4)","احتمال المتمّمة"],["=1-\\left(\\frac{3}{4}\\right)^{4}=1-\\frac{81}{256}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)=(1-p)^x\"></span>"],["=\\frac{175}{256}\\approx 0.6836","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 4)=\\frac{175}{256}\\approx 0.6836\"></span>","o":"","k":[{"e":"0.6836","a":true}]},{"n":"24","s":[["P(X\\ge 3)=P(X>2)","ثلاث مرات على الأقل"],["=\\left(\\frac{3}{4}\\right)^{2}=\\frac{9}{16}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)=(1-p)^x\"></span>"],["=0.5625","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 3)=\\frac{9}{16}=0.5625\"></span>","o":""}],[{"n":"25","s":[["X\\sim Geo\\left(\\frac{1}{6}\\right)","احتمال ظهور <span class=m dir=ltr>6</span> في كل رمية"],["P(X=3)=\\frac{1}{6}\\left(\\frac{5}{6}\\right)^{2}","صيغة التوزيع الهندسي"],["=\\frac{25}{216}\\approx 0.1157","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=3)=\\frac{25}{216}\\approx 0.1157\"></span>","o":"","k":[{"e":"0.1157","a":true}]},{"n":"26","s":[["P(X>3)=\\left(1-\\frac{1}{6}\\right)^{3}","قانون <span class=\"tx\" data-t=\"P(X&gt;x)=(1-p)^x\"></span>"],["=\\left(\\frac{5}{6}\\right)^{3}=\\frac{125}{216}","بالتبسيط"],["\\approx 0.5787","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;3)=\\frac{125}{216}\\approx 0.5787\"></span>","o":"","k":[{"e":"0.5787","a":true}]}],[{"n":"27","s":[["P(X=x)=p(1-p)^{x-1}","الصيغة الصحيحة: أُس <span class=\"tx\" data-t=\"(1-p)\"></span> هو <span class=\"tx\" data-t=\"x-1\"></span>"],["P(X=2)=\\frac{2}{5}\\left(1-\\frac{2}{5}\\right)^{2-1}","بتعويض <span class=\"tx\" data-t=\"x=2,\\ p=\\frac{2}{5}\"></span>"],["=\\frac{2}{5}\\times\\frac{3}{5}=\\frac{6}{25}","بالتبسيط"]],"a":"الخطأ: استعملت لانا الأُس <span class=\"tx\" data-t=\"2\"></span> بدل <span class=\"tx\" data-t=\"x-1=1\"></span> (أي اعتبرت فشلين قبل النجاح). الصحيح: <span class=\"tx\" data-t=\"P(X=2)=\\frac{6}{25}=0.24\"></span>","o":"ظهور الصورة أوّل مرة في الرمية الثانية يعني فشلًا واحدًا ثم نجاحًا."}],[{"n":"28","s":[["P(X>3)=1-P(X\\le 3)","الحادثان <span class=\"tx\" data-t=\"X&gt;3\"></span> و <span class=\"tx\" data-t=\"X\\le 3\"></span> متمّمان"],["=1-\\frac{819}{1331}","بالتعويض"],["=\\frac{512}{1331}","بالتبسيط"],["(1-p)^{3}=\\frac{512}{1331}\\Rightarrow 1-p=\\frac{8}{11}","تحقّق: <span class=\"tx\" data-t=\"p=\\frac{3}{11}\"></span>"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;3)=\\frac{512}{1331}\\approx 0.385\"></span>؛ لأن مجموع احتمالي الحادث ومتمّمته يساوي <span class=m dir=ltr>1</span>.","o":""}],[{"n":"29","s":[["P(X=2)=p(1-p)=0.21","صيغة التوزيع الهندسي بتعويض <span class=\"tx\" data-t=\"x=2\"></span>"],["p^{2}-p+0.21=0","بإعادة الترتيب"],["(p-0.7)(p-0.3)=0","بالتحليل"],["p=0.7","لأن <span class=\"tx\" data-t=\"p&gt;0.5\"></span>"],["P(X=4)=0.7(0.3)^{3}=0.0189","صيغة التوزيع الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(X=4)=0.0189\"></span>","o":"","k":[{"e":"0.0189","a":true}]}],[{"n":"7","s":[["P(X=x)=p(1-p)^{x-1}","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"],["P(X=4)=(0.3)(0.7)^3","بالتعويض <span class=\"tx\" data-t=\"x=4,\\ p=0.3\"></span>"],["=0.1029","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=4)=0.1029\"></span>","o":"","k":[{"e":"0.1029","a":true}]},{"n":"8","s":[["P(3<X\\le5)=P(X=4)+P(X=5)","احتمال الحوادث المتنافية"],["=(0.3)(0.7)^3+(0.3)(0.7)^4","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"],["=0.1029+0.07203=0.17493","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(3&lt;X\\le5)\\approx0.1749\"></span>","o":"","k":[{"e":"0.1749","a":true}]},{"n":"9","s":[["P(X>4)=1-P(X\\le4)","احتمال المتممة"],["=1-\\left(0.3+0.21+0.147+0.1029\\right)","<span class=\"tx\" data-t=\"P(X=1)+P(X=2)+P(X=3)+P(X=4)\"></span>"],["=1-0.7599=0.2401","أو مباشرة: <span class=\"tx\" data-t=\"(0.7)^4=0.2401\"></span>"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;4)=0.2401\"></span>","o":""},{"n":"10","s":[["E(X)=\\frac{1}{p}","توقع المتغير الهندسي"],["=\\frac{1}{0.3}=\\frac{10}{3}\\approx3.33","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{10}{3}\\approx 3.33\"></span>","o":"","k":[{"e":"3.33","a":true}]}],[{"n":"26","s":[["X\\sim Geo(0.1)","<span class=\"tx\" data-t=\"X\"></span>: عدد السيارات حتى أول سيارة زرقاء"],["P(X>5)=1-P(X\\le5)","المطلوب: أول <span class=m dir=ltr>5</span> سيارات ليست زرقاء"],["=(1-0.1)^5=(0.9)^5","احتمال فشل <span class=m dir=ltr>5</span> محاولات متتالية"],["=0.59049","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;5)\\approx0.5905\"></span>","o":"","k":[{"e":"0.5905","a":true}]},{"n":"27","s":[["P(X>3)=1-\\left(P(X=1)+P(X=2)+P(X=3)\\right)","احتمال المتممة"],["=1-(0.1+0.09+0.081)","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"],["=1-0.271=0.729","أو: <span class=\"tx\" data-t=\"(0.9)^3=0.729\"></span>"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;3)=0.729\"></span>","o":""}],[{"n":"1","s":[["P(X=x)=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^{x-1}","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي بتعويض <span class=\"tx\" data-t=\"p=\\frac{1}{8}\"></span>"],["P(X=4)=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^3=\\frac{343}{4096}","بالتعويض"],["\\approx0.084","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(X=4)\\approx0.084\"></span>","o":"","k":[{"e":"0.084","a":true}]},{"n":"2","s":[["P(X\\le4)=1-P(X>4)","احتمال المتممة"],["=1-\\left(\\frac{7}{8}\\right)^4","<span class=\"tx\" data-t=\"P(X&gt;4)\"></span> <span class=m dir=ltr>=</span> احتمال فشل أول <span class=m dir=ltr>4</span> محاولات"],["=1-\\frac{2401}{4096}=\\frac{1695}{4096}\\approx0.414","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\le4)\\approx0.414\"></span>","o":"","k":[{"e":"0.414","a":true}]},{"n":"3","s":[["P(X\\ge2)=1-P(X=1)","احتمال المتممة"],["=1-\\frac{1}{8}=\\frac{7}{8}=0.875","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge2)=0.875\"></span>","o":""},{"n":"4","s":[["P(3\\le X<5)=P(X=3)+P(X=4)","احتمال الحوادث المتنافية"],["=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^2+\\frac{1}{8}\\left(\\frac{7}{8}\\right)^3","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"],["=\\frac{392+343}{4096}=\\frac{735}{4096}\\approx0.179","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\approx0.179\"></span>","o":"","k":[{"e":"0.179","a":true}]},{"n":"5","s":[["P(X<2)=P(X=1)",""],["=\\frac{1}{8}=0.125","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;2)=0.125\"></span>","o":""},{"n":"6","s":[["P(X>5)=\\left(\\frac{7}{8}\\right)^5","فشل أول <span class=m dir=ltr>5</span> محاولات"],["=\\frac{16807}{32768}\\approx0.513","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;5)\\approx0.513\"></span>","o":"","k":[{"e":"0.513","a":true}]},{"n":"7","s":[["P(1<X<3)=P(X=2)",""],["=\\frac{1}{8}\\left(\\frac{7}{8}\\right)=\\frac{7}{64}\\approx0.109","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"]],"a":"<span class=\"tx\" data-t=\"\\approx0.109\"></span>","o":"","k":[{"e":"0.109","a":true}]},{"n":"8","s":[["P(4<X\\le6)=P(X=5)+P(X=6)","احتمال الحوادث المتنافية"],["=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^4+\\frac{1}{8}\\left(\\frac{7}{8}\\right)^5","صيغة التوزيع الاحتمالي للمتغير العشوائي الهندسي"],["\\approx0.0733+0.0641\\approx0.137","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\approx0.137\"></span>","o":"","k":[{"e":"0.137","a":true}]},{"n":"9","s":[["P(2<X\\le4)=P(X=3)+P(X=4)","اح