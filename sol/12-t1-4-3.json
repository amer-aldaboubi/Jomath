[[{"n":"1","s":[["|z-0|=10",""],["|z-z_1|=r:\\ z_1=0,\\ r=10","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["x^2+y^2=100","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(0,0)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"10\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"x^2+y^2=100\"></span>","o":""},{"n":"2","s":[["|z-9|=4",""],["|z-z_1|=r:\\ z_1=9,\\ r=4","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["(x-9)^2+y^2=16","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(9,0)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"4\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"(x-9)^2+y^2=16\"></span>","o":""},{"n":"3","s":[["|z-(-2i)|=8",""],["|z-z_1|=r:\\ z_1=-2i,\\ r=8","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["x^2+(y+2)^2=64","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(0,-2)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"8\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"x^2+(y+2)^2=64\"></span>","o":""},{"n":"4","s":[["|z-(5-6i)|=2",""],["|z-z_1|=r:\\ z_1=5-6i,\\ r=2","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["(x-5)^2+(y+6)^2=4","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(5,-6)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"2\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"(x-5)^2+(y+6)^2=4\"></span>","o":""},{"n":"5","s":[["|z-(-\\sqrt2-i\\sqrt2)|=2",""],["|z-z_1|=r:\\ z_1=-\\sqrt2-i\\sqrt2,\\ r=2","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["(x+\\sqrt2)^2+(y+\\sqrt2)^2=4","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(-\\sqrt2,-\\sqrt2)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"2\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"(x+\\sqrt2)^2+(y+\\sqrt2)^2=4\"></span>","o":""},{"n":"6","s":[["|z-(-6+i)|=7",""],["|z-z_1|=r:\\ z_1=-6+i,\\ r=7","المسافة بين <span class=\"tx\" data-t=\"z\"></span> ونقطة ثابتة ثابتة: دائرة"],["(x+6)^2+(y-1)^2=49","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(-6,1)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"7\"></span> ؛ معادلتها: <span class=\"tx\" data-t=\"(x+6)^2+(y-1)^2=49\"></span>","o":""},{"n":"7","s":[["|z-z_1|=|z-z_2|:\\ z_1=5,\\ z_2=3i","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["(x-5)^2+y^2=x^2+(y-3)^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=\\frac{5}{3}x-\\frac{8}{3}","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=\\frac{5}{3}x-\\frac{8}{3}\"></span>","o":"نرسم المستقيم المار بالنقطتين <span class=\"tx\" data-t=\"(1,-1)\"></span> و<span class=\"tx\" data-t=\"(4,4)\"></span> ، وهو عمودي على القطعة من <span class=\"tx\" data-t=\"(5,0)\"></span> إلى <span class=\"tx\" data-t=\"(0,3)\"></span> ومارّ بمنتصفها <span class=\"tx\" data-t=\"(2.5,1.5)\"></span>."},{"n":"8","s":[["|z-z_1|=|z-z_2|:\\ z_1=-3i,\\ z_2=7i","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["x^2+(y+3)^2=x^2+(y-7)^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=2","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=2\"></span>","o":"مستقيم أفقي يمر بالنقطة <span class=\"tx\" data-t=\"(0,2)\"></span> منتصف القطعة بين <span class=\"tx\" data-t=\"(0,-3)\"></span> و<span class=\"tx\" data-t=\"(0,7)\"></span>."},{"n":"9","s":[["|z-z_1|=|z-z_2|:\\ z_1=-5-2i,\\ z_2=7","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["(x+5)^2+(y+2)^2=(x-7)^2+y^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=-6x+5","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=-6x+5\"></span>","o":"يمر بمنتصف القطعة <span class=\"tx\" data-t=\"(1,-1)\"></span> ومقطعه الصادي <span class=\"tx\" data-t=\"5\"></span> وميله <span class=\"tx\" data-t=\"-6\"></span>."},{"n":"10","s":[["|z-z_1|=|z-z_2|:\\ z_1=3,\\ z_2=2+i","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["(x-3)^2+y^2=(x-2)^2+(y-1)^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=x-2","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=x-2\"></span>","o":"يمر بمنتصف القطعة <span class=\"tx\" data-t=\"(2.5,0.5)\"></span> وبالنقطة <span class=\"tx\" data-t=\"(2,0)\"></span> وميله <span class=\"tx\" data-t=\"1\"></span>."},{"n":"11","s":[["|z-z_1|=|z-z_2|:\\ z_1=-6+i,\\ z_2=10+5i","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["(x+6)^2+(y-1)^2=(x-10)^2+(y-5)^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=-4x+11","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=-4x+11\"></span>","o":"المعادلة تكافئ <span class=\"tx\" data-t=\"|z+6-i|=|z-10-5i|\"></span> ؛ يمر بمنتصف القطعة <span class=\"tx\" data-t=\"(2,3)\"></span> وميله <span class=\"tx\" data-t=\"-4\"></span>."},{"n":"12","s":[["|z-z_1|=|z-z_2|:\\ z_1=-7-2i,\\ z_2=4+3i","بُعد <span class=\"tx\" data-t=\"z\"></span> عن نقطتين متساوٍ: المنصِّف العمودي للقطعة الواصلة بينهما"],["(x+7)^2+(y+2)^2=(x-4)^2+(y-3)^2","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["y=-\\frac{11}{5}x-\\frac{14}{5}","بالتبسيط"]],"a":"المنصّف العمودي للقطعة الواصلة بين النقطتين؛ معادلته: <span class=\"tx\" data-t=\"y=-\\frac{11}{5}x-\\frac{14}{5}\"></span>","o":"أي <span class=\"tx\" data-t=\"11x+5y=-14\"></span> ؛ يمر بمنتصف القطعة <span class=\"tx\" data-t=\"(-1.5,0.5)\"></span> وميله <span class=\"tx\" data-t=\"-\\frac{11}{5}\"></span>."}],[{"n":"13","s":[["\\text{Arg}(z-(-2+5i))=\\frac{\\pi}{4}","نكتبها بالصورة <span class=\"tx\" data-t=\"\\text{Arg}(z-z_1)=\\theta\"></span>"],["y-5=\\tan\\frac{\\pi}{4}\\,(x+2)\\Rightarrow y=x+7,\\ x>-2","معادلة نصف المستقيم"]],"a":"نصف مستقيم يبدأ من النقطة <span class=\"tx\" data-t=\"(-2,5)\"></span> (دائرة مفرغة، غير مشمولة) ويصنع زاوية <span class=\"tx\" data-t=\"\\frac{\\pi}{4}\"></span> مع الاتجاه الموجب للمحور الحقيقي: <span class=\"tx\" data-t=\"y=x+7,\\ x&gt;-2\"></span>","o":"نرسمه من <span class=\"tx\" data-t=\"(-2,5)\"></span> مارًّا بالنقطة <span class=\"tx\" data-t=\"(-1,6)\"></span> و<span class=\"tx\" data-t=\"(0,7)\"></span> نحو الأعلى يمينًا."},{"n":"14","s":[["\\text{Arg}(z-(1-i\\sqrt3))=\\frac{2\\pi}{3}","البداية <span class=\"tx\" data-t=\"(1,-\\sqrt3)\"></span>"],["y+\\sqrt3=\\tan\\frac{2\\pi}{3}\\,(x-1)=-\\sqrt3(x-1)","الميل <span class=\"tx\" data-t=\"-\\sqrt3\"></span>"],["y=-\\sqrt3\\,x,\\ x<1","الزاوية في الربع الثاني فالاتجاه نحو اليسار والأعلى"]],"a":"نصف مستقيم يبدأ من <span class=\"tx\" data-t=\"(1,-\\sqrt3)\"></span> (غير مشمولة) ويتجه للأعلى يسارًا بزاوية <span class=\"tx\" data-t=\"\\frac{2\\pi}{3}\"></span>: <span class=\"tx\" data-t=\"y=-\\sqrt3x,\\ x&lt;1\"></span>","o":"يمر بنقطة الأصل <span class=\"tx\" data-t=\"(0,0)\"></span> و<span class=\"tx\" data-t=\"(-1,\\sqrt3)\"></span>."},{"n":"15","s":[["\\text{Arg}(z-4i)=-\\frac{3\\pi}{4}","البداية <span class=\"tx\" data-t=\"(0,4)\"></span>"],["y-4=\\tan\\left(-\\frac{3\\pi}{4}\\right)x=x","الميل <span class=m dir=ltr>1</span>"],["y=x+4,\\ x<0","الاتجاه نحو الأسفل يسارًا (الربع الثالث)"]],"a":"نصف مستقيم يبدأ من <span class=\"tx\" data-t=\"(0,4)\"></span> (غير مشمولة) ويتجه للأسفل يسارًا: <span class=\"tx\" data-t=\"y=x+4,\\ x&lt;0\"></span>","o":"يمر بالنقطتين <span class=\"tx\" data-t=\"(-1,3)\"></span> و<span class=\"tx\" data-t=\"(-4,0)\"></span>."}],[{"n":"16","s":[["|z-2|=|z+2|\\Rightarrow x=0","الحد: المنصّف العمودي للقطعة بين <span class=\"tx\" data-t=\"2\"></span> و<span class=\"tx\" data-t=\"-2\"></span> وهو المحور التخيلي"],["(x-2)^2+y^2<(x+2)^2+y^2\\Rightarrow -8x<0\\Rightarrow x>0","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span>"]],"a":"المنطقة يمين المحور التخيلي: <span class=\"tx\" data-t=\"x&gt;0\"></span>","o":"نرسم المحور التخيلي متقطعًا (غير مشمول) ونظلّل نصف المستوى الأيمن (الأقرب إلى العدد <span class=m dir=ltr>2)</span>."},{"n":"17","s":[["|z-(4+2i)|\\le2","دائرة مركزها <span class=\"tx\" data-t=\"(4,2)\"></span> ونصف قطرها <span class=m dir=ltr>2</span>"],["(x-4)^2+(y-2)^2\\le4",""]],"a":"قرص دائري: الدائرة وداخلها","o":"نرسم الدائرة بخط متصل (الحد مشمول) ونظلّل داخلها."},{"n":"18","s":[["|z-4|=|z-6|\\Rightarrow x=5","الحد: المنصّف العمودي للقطعة بين <span class=m dir=ltr>4</span> و<span class=m dir=ltr>6</span>"],["(x-4)^2>(x-6)^2\\Rightarrow 4x>20\\Rightarrow x>5","بالتعويض والتبسيط"]],"a":"المنطقة <span class=\"tx\" data-t=\"x&gt;5\"></span> (يمين المستقيم <span class=\"tx\" data-t=\"x=5\"></span>)","o":"نرسم المستقيم الرأسي <span class=\"tx\" data-t=\"x=5\"></span> متقطعًا ونظلّل يمينه (الأقرب إلى <span class=m dir=ltr>6)</span>."},{"n":"19","s":[["0<\\text{Arg}(z-(2+2i))<\\frac{\\pi}{4}","رأس المنطقة النقطة <span class=\"tx\" data-t=\"(2,2)\"></span>"],["y=2,\\ x>2","نصف المستقيم عند الزاوية <span class=m dir=ltr>0</span>"],["y=x,\\ x>2","نصف المستقيم عند الزاوية <span class=\"tx\" data-t=\"\\frac{\\pi}{4}\"></span>"]],"a":"المنطقة المحصورة بين نصفي المستقيمين <span class=\"tx\" data-t=\"y=2\"></span> و<span class=\"tx\" data-t=\"y=x\"></span> (يمين <span class=\"tx\" data-t=\"x=2\"></span>)","o":"نرسم نصفي المستقيمين متقطعين والنقطة <span class=\"tx\" data-t=\"(2,2)\"></span> دائرة مفرغة، ونظلّل الزاوية بينهما."},{"n":"20","s":[["-\\frac{\\pi}{4}\\le\\text{Arg}(z-(3-4i))\\le\\frac{\\pi}{4}","رأس المنطقة <span class=\"tx\" data-t=\"(3,-4)\"></span>"],["y=-x-1,\\ x>3","نصف المستقيم عند <span class=\"tx\" data-t=\"-\\frac{\\pi}{4}\"></span>"],["y=x-7,\\ x>3","نصف المستقيم عند <span class=\"tx\" data-t=\"\\frac{\\pi}{4}\"></span>"]],"a":"المنطقة الزاوية بين نصفي المستقيمين (قياسها <span class=\"tx\" data-t=\"\\frac{\\pi}{2}\"></span>) والمتجهة نحو اليمين","o":"نرسم نصفي المستقيمين بخط متصل (مشمولان)، والرأس <span class=\"tx\" data-t=\"(3,-4)\"></span> دائرة مفرغة، ونظلّل بينهما."},{"n":"21","s":[["|z-(3+4i)|=2,\\quad |z-(3+4i)|=4","دائرتان متحدتا المركز <span class=\"tx\" data-t=\"(3,4)\"></span>"],["4\\le(x-3)^2+(y-4)^2\\le16",""]],"a":"حلقة دائرية بين الدائرتين اللتين نصفا قطريهما <span class=m dir=ltr>2</span> و<span class=m dir=ltr>4</span> ومركزهما <span class=\"tx\" data-t=\"(3,4)\"></span>، مع الحدين","o":"نرسم الدائرتين بخط متصل ونظلّل المنطقة بينهما. لاحظ أن الدائرة الكبرى تمر بنقطة الأصل."}],[{"n":"22","s":[["|z-(3-2i)|=\\sqrt{10}\\Rightarrow(x-3)^2+(y+2)^2=10","دائرة مركزها <span class=\"tx\" data-t=\"(3,-2)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"\\sqrt{10}\"></span>"],["x^2+(y-6)^2=(x-7)^2+(y+1)^2\\Rightarrow y=x-1","المنصّف العمودي للقطعة بين <span class=\"tx\" data-t=\"(0,6)\"></span> و<span class=\"tx\" data-t=\"(7,-1)\"></span>"],["(x-3)^2+(x+1)^2=10\\Rightarrow 2x^2-4x=0","بالتعويض <span class=\"tx\" data-t=\"y=x-1\"></span>"],["x=0\\Rightarrow y=-1;\\quad x=2\\Rightarrow y=1","خاصية الضرب الصفري"]],"a":"العددان: <span class=\"tx\" data-t=\"z=-i\"></span> و <span class=\"tx\" data-t=\"z=2+i\"></span>","o":"نرسم الدائرة والمستقيم <span class=\"tx\" data-t=\"y=x-1\"></span> على المستوى نفسه، ونقطتا تقاطعهما <span class=\"tx\" data-t=\"(0,-1)\"></span> و<span class=\"tx\" data-t=\"(2,1)\"></span>."}],[{"n":"23","s":[["(x-3)^2+y^2=x^2+(y+2)^2\\Rightarrow 6x+4y=5","المحل الأول: منصّف عمودي"],["(x+3)^2+(y-1)^2=(x-1)^2+(y+5)^2\\Rightarrow 2x-3y=4","المحل الثاني: منصّف عمودي"],["y=\\frac{2x-4}{3}\\Rightarrow 6x+\\frac{8x-16}{3}=5","بالتعويض"],["26x=31\\Rightarrow x=\\frac{31}{26},\\ y=-\\frac{7}{13}",""]],"a":"<span class=\"tx\" data-t=\"z=\\frac{31}{26}-\\frac{7}{13}i\\approx1.19-0.54i\"></span>","o":""}],[{"n":"24","s":[["z_1=-2+5i","النقطة المشتركة في المحال الثلاثة"],["y=x+7,\\ x>-2","<span class=\"tx\" data-t=\"\\text{Arg}=\\frac{\\pi}{4}\"></span>: نصف مستقيم للأعلى يمينًا"],["x=-2,\\ y<5","<span class=\"tx\" data-t=\"\\text{Arg}=-\\frac{\\pi}{2}\"></span>: نصف مستقيم رأسي نحو الأسفل"],["(x+2)^2+(y-5)^2=29","دائرة مركزها <span class=\"tx\" data-t=\"(-2,5)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"\\sqrt{29}\"></span>"]],"a":"نصفا مستقيمين يبدآن من <span class=\"tx\" data-t=\"(-2,5)\"></span> (دائرة مفرغة) ودائرة مركزها النقطة نفسها","o":"الدائرة تمر بنقطة الأصل لأن <span class=\"tx\" data-t=\"\\sqrt{2^2+5^2}=\\sqrt{29}\"></span>؛ ونصف المستقيم الرأسي يقطعها عند <span class=\"tx\" data-t=\"(-2,5-\\sqrt{29})\\approx(-2,-0.39)\"></span>."}],[{"n":"25","s":[["|z-3|>|z+2i|\\Rightarrow 6x+4y<5","النقاط الأقرب إلى <span class=\"tx\" data-t=\"-2i\"></span> منها إلى <span class=m dir=ltr>3</span>"],["|z+3-i|<|z-1+5i|\\Rightarrow 2x-3y<4","النقاط الأقرب إلى <span class=\"tx\" data-t=\"-3+i\"></span> منها إلى <span class=\"tx\" data-t=\"1-5i\"></span>"],["\\left(\\frac{31}{26},-\\frac{7}{13}\\right)","نقطة تقاطع المستقيمين الحدّيين"]],"a":"المنطقة تحت المستقيم <span class=\"tx\" data-t=\"6x+4y=5\"></span> وفوق المستقيم <span class=\"tx\" data-t=\"2x-3y=4\"></span> (يسار نقطة تقاطعهما)","o":"المستقيمان متقطعان (غير مشمولين)؛ مثال على نقطة في المنطقة: <span class=\"tx\" data-t=\"(-5,-2)\"></span>."}],[{"n":"26","s":[["|z-(-2+5i)|<\\sqrt{29}","داخل الدائرة التي مركزها <span class=\"tx\" data-t=\"(-2,5)\"></span> ونصف قطرها <span class=\"tx\" data-t=\"\\sqrt{29}\"></span>"],["-\\frac{\\pi}{2}<\\text{Arg}(z-(-2+5i))<\\frac{\\pi}{4}","بين نصف المستقيم الرأسي للأسفل ونصف المستقيم <span class=\"tx\" data-t=\"y=x+7\"></span>"],["\\frac{\\pi}{4}-\\left(-\\frac{\\pi}{2}\\right)=\\frac{3\\pi}{4}","زاوية القطاع"]],"a":"قطاع دائري مركزه <span class=\"tx\" data-t=\"(-2,5)\"></span> ونصف قطره <span class=\"tx\" data-t=\"\\sqrt{29}\"></span> وزاويته <span class=\"tx\" data-t=\"\\frac{3\\pi}{4}\"></span> ، يقع يمين المركز وأسفله","o":"جميع الحدود متقطعة (المتباينات تامة)."}],[{"n":"27","s":[["-\\frac{\\pi}{4}\\le\\text{Arg}(z-2i)\\le\\frac{\\pi}{3}","رأس الزاوية <span class=\"tx\" data-t=\"(0,2)\"></span>"],["y=-x+2,\\ x>0;\\quad y=\\sqrt3x+2,\\ x>0","نصفا المستقيمين الحدّيين (متصلان)"],["2<|z-(3-i)|\\le5","حلقة مركزها <span class=\"tx\" data-t=\"(3,-1)\"></span>"],["4<(x-3)^2+(y+1)^2\\le25","الدائرة الداخلية متقطعة والخارجية متصلة"]],"a":"المنطقة المشتركة بين الزاوية (التي رأسها <span class=\"tx\" data-t=\"(0,2)\"></span>) والحلقة الدائرية بين نصفي القطرين <span class=m dir=ltr>2</span> و<span class=m dir=ltr>5</span>","o":"الرأس <span class=\"tx\" data-t=\"(0,2)\"></span> يبعد <span class=\"tx\" data-t=\"\\sqrt{18}\\approx4.24\"></span> عن المركز، أي يقع داخل الحلقة."}],[{"n":"28","s":[["z_1=1+i,\\quad r=3","من الشكل: المركز <span class=\"tx\" data-t=\"(1,1)\"></span> وتمر الدائرة بـ <span class=\"tx\" data-t=\"(4,1)\"></span> و<span class=\"tx\" data-t=\"(1,4)\"></span>"],["|z-(1+i)|=3",""]],"a":"<span class=\"tx\" data-t=\"|z-1-i|=3\"></span>","o":""},{"n":"29","s":[["z_1=-1,\\quad z_2=3+2i","المستقيم منصّف عمودي للقطعة بين النقطتين"],["M(1,1),\\ m=-2","تحقق: المستقيم <span class=\"tx\" data-t=\"y=-2x+3\"></span> يمر بـ <span class=\"tx\" data-t=\"(1,1)\"></span>"],["|z+1|=|z-3-2i|",""]],"a":"<span class=\"tx\" data-t=\"|z+1|=|z-3-2i|\"></span>","o":""}],[{"n":"30","s":[["a=-1+2i","نقطة البداية (دائرة مفرغة)"],["\\theta=-\\frac{3\\pi}{4}","الزاوية مقيسة باتجاه عقارب الساعة من الاتجاه الموجب"],["\\text{Arg}(z+1-2i)=-\\frac{3\\pi}{4}",""]],"a":"<span class=\"tx\" data-t=\"\\text{Arg}(z-(-1+2i))=-\\frac{3\\pi}{4}\"></span>","o":""}],[{"n":"31","s":[["z_1=4+i,\\ r=8-1=7","المركز ونصف القطر من الشكل"],["|z-4-i|\\ge7","المنطقة المظللة خارج الدائرة والحد متصل"]],"a":"<span class=\"tx\" data-t=\"|z-4-i|\\ge7\"></span>","o":""},{"n":"32","s":[["a=-2+i","رأس المنطقة"],["\\theta=0,\\quad \\theta=-\\frac{\\pi}{4}","الحد الأفقي (<span class=\"tx\" data-t=\"\\theta=0\"></span>) متقطع غير مشمول، والمائل متصل مشمول"],["-\\frac{\\pi}{4}\\le\\text{Arg}(z+2-i)<0",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{\\pi}{4}\\le\\text{Arg}(z+2-i)&lt;0\"></span>","o":""}],[{"n":"33","s":[["|z+1+2i|\\le3","دائرة مركزها <span class=\"tx\" data-t=\"(-1,-2)\"></span> ونصف قطرها <span class=m dir=ltr>3</span> والمنطقة داخلها"],["z_1=-6,\\ z_2=-4i","المستقيم منصّف عمودي للقطعة بين النقطتين"],["(x+6)^2+y^2=x^2+(y+4)^2\\Rightarrow y=\\frac32x+\\frac52","تحقق من المستقيم المرسوم"],["|z+4i|\\le|z+6|","المنطقة في جهة النقطة <span class=\"tx\" data-t=\"-4i\"></span>"]],"a":"<span class=\"tx\" data-t=\"|z+1+2i|\\le3\"></span> و <span class=\"tx\" data-t=\"|z+4i|\\le|z+6|\"></span>","o":""}],[{"n":"34","s":[["|z-(3-4i)|=2","دائرة مركزها <span class=\"tx\" data-t=\"(3,-4)\"></span> ونصف قطرها <span class=m dir=ltr>2</span>"],["|3-4i|=\\sqrt{9+16}=5","بُعد المركز عن نقطة الأصل"],["|z|_{\\max}=5+2=7","النقطة الأبعد على امتداد الخط من الأصل عبر المركز"],["|z|_{\\min}=5-2=3","النقطة الأقرب"]],"a":"أكبر قيمة لـ <span class=\"tx\" data-t=\"|z|\"></span> هي <span class=\"tx\" data-t=\"7\"></span> ، وأقل قيمة هي <span class=\"tx\" data-t=\"3\"></span>","o":"التبرير: <span class=\"tx\" data-t=\"|z|\"></span> بُعد النقطة عن الأصل، والأصل خارج الدائرة؛ فأبعد وأقرب نقطتين تقعان على المستقيم المار بالأصل والمركز."}],[{"n":"35","s":[["(x-6)^2+y^2=4\\left[(x+6)^2+(y-9)^2\\right]","بتعويض <span class=\"tx\" data-t=\"z=x+iy\"></span> وتربيع الطرفين"],["x^2-12x+36+y^2=4x^2+48x+144+4y^2-72y+324",""],["3x^2+60x+3y^2-72y+432=0","بالتجميع"],["x^2+20x+y^2-24y+144=0","بالقسمة على <span class=m dir=ltr>3</span>"],["(x+10)^2+(y-12)^2=100","بإكمال المربع"]],"a":"المعادلة تمثّل دائرة مركزها <span class=\"tx\" data-t=\"(-10,12)\"></span> أي <span class=\"tx\" data-t=\"-10+12i\"></span> ، ونصف قطرها <span class=\"tx\" data-t=\"10\"></span>","o":""}],[{"n":"36","s":[["\\text{Arg}(z-(2-3i))=\\frac{\\pi}{8}","البداية <span class=\"tx\" data-t=\"(2,-3)\"></span>"],["\\text{a)}:\\ (2,3)","خطأ: نقطة البداية ليست <span class=\"tx\" data-t=\"(2,-3)\"></span>"],["\\text{c)}:\\ \\bullet\\,(2,-3)","خطأ: نقطة البداية مظللة مع أنها لا تنتمي للمحل"],["\\text{d)}:\\ \\theta=-\\frac{\\pi}{8}","خطأ: الاتجاه نحو الأسفل"]],"a":"<span class=m dir=ltr>b</span>","o":"التبرير: في <span class=m dir=ltr>b</span> يبدأ نصف المستقيم من <span class=\"tx\" data-t=\"(2,-3)\"></span> بدائرة مفرغة (لأن <span class=\"tx\" data-t=\"\\text{Arg}(0)\"></span> غير معرّفة) ويصنع زاوية <span class=\"tx\" data-t=\"\\frac{\\pi}{8}\"></span> فوق الاتجاه الموجب."}],[{"n":"6","s":[["A(3,4),\\quad B(-1,2)","النقطتان في الشكل"],["\\text{line}\\ \\perp\\ \\overline{AB}","الخط المتقطع هو المنصف العمودي للقطعة <span class=m dir=ltr>AB (</span>حدّ غير مشمول)"],["|z-(3+4i)|<|z-(-1+2i)|","المنطقة المظللة في جهة <span class=m dir=ltr>A</span>، فنقاطها أقرب إلى <span class=m dir=ltr>A</span> منها إلى <span class=m dir=ltr>B</span>"],["|z+1-2i|>|z-3-4i|","بكتابة المتباينة بالصورة الموجودة في البدائل"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"|z+1-2i|&gt;|z-3-4i|\"></span>","o":""}],[{"n":"12","s":[["|z-6|\\le3","المسافة بين <span class=m dir=ltr>z</span> والنقطة <span class=m dir=ltr>(6, 0)</span> أقل من أو تساوي <span class=m dir=ltr>3</span>"],["\\text{center }(6,0),\\ r=3","دائرة مركزها <span class=m dir=ltr>6</span> ونصف قطرها <span class=m dir=ltr>3</span>"]],"a":"قرص دائري مغلق: الدائرة <span class=\"tx\" data-t=\"(x-6)^2+y^2=9\"></span> وداخلها","o":"نرسم الدائرة بخط متصل (مركزها <span class=m dir=ltr>(6, 0)</span> وتمر بـ <span class=m dir=ltr>(3, 0)</span> و <span class=m dir=ltr>(9, 0)</span> و <span class=m dir=ltr>(6</span>, ±<span class=m dir=ltr>3))</span> ونظلل داخلها."},{"n":"13","s":[["\\text{Arg}(z-2)=\\frac{\\pi}{4},\\quad \\text{Arg}(z-2)=\\frac{2\\pi}{3}","الحدّان شعاعان يبدآن من النقطة <span class=m dir=ltr>(2, 0)</span>"],["y=x-2\\ (x>2),\\quad y=-\\sqrt3(x-2)\\ (x<2)","معادلتا الشعاعين"]],"a":"المنطقة المحصورة بين الشعاعين (بما فيها الشعاعان) من النقطة <span class=m dir=ltr>(2, 0)</span>","o":"دائرة مفرغة عند <span class=m dir=ltr>(2, 0)</span>؛ شعاع متصل بزاوية <span class=\"tx\" data-t=\"45^\\circ\"></span> مع الاتجاه الموجب للمحور الحقيقي وآخر بزاوية <span class=\"tx\" data-t=\"120^\\circ\"></span>، ونظلل المنطقة بينهما (تحتوي مثلًا النقطة <span class=\"tx\" data-t=\"2+2i\"></span>)."},{"n":"14","s":[["|z-(-1-i)|>|z-(3+3i)|","النقاط الأقرب إلى <span class=\"tx\" data-t=\"3+3i\"></span> منها إلى <span class=\"tx\" data-t=\"-1-i\"></span>"],["(x+1)^2+(y+1)^2>(x-3)^2+(y-3)^2","بكتابة <span class=m dir=ltr>z = x + iy</span>"],["2x+2y+2>-6x-6y+18","بالفك والتبسيط"],["8x+8y>16\\Rightarrow x+y>2","بالتبسيط"]],"a":"نصف المستوى <span class=\"tx\" data-t=\"x+y&gt;2\"></span> (فوق المستقيم <span class=\"tx\" data-t=\"y=-x+2\"></span>)","o":"نرسم المنصف العمودي <span class=\"tx\" data-t=\"y=-x+2\"></span> بخط متقطع (يمر بـ <span class=m dir=ltr>(0, 2)</span> و <span class=m dir=ltr>(2, 0)</span> و <span class=m dir=ltr>(1, 1))</span> ونظلل الجهة التي فيها <span class=\"tx\" data-t=\"3+3i\"></span>."}],[{"n":"18","s":[["|z-8|>|z+2i|","النقاط الأقرب إلى <span class=\"tx\" data-t=\"-2i\"></span> منها إلى <span class=m dir=ltr>8</span>"],["(x-8)^2+y^2>x^2+(y+2)^2\\Rightarrow 4x+y<15","بالفك والتبسيط: الحد هو المستقيم <span class=\"tx\" data-t=\"y=-4x+15\"></span> (متقطع)"],["-\\frac{\\pi}{4}<\\text{Arg}(z-(-3+6i))<\\frac{\\pi}{4}","منطقة بين شعاعين يبدآن من <span class=m dir=ltr>(−3, 6)</span>"],["y=x+9\\ (x>-3),\\quad y=3-x\\ (x>-3)","الشعاعان (متقطعان) بزاويتي <span class=\"tx\" data-t=\"45^\\circ\"></span> و <span class=\"tx\" data-t=\"-45^\\circ\"></span>"],["(1.2,\\ 10.2),\\quad (4,\\ -1)","نقطتا تقاطع المستقيم <span class=\"tx\" data-t=\"4x+y=15\"></span> مع الشعاعين"]],"a":"المنطقة المطلوبة هي داخل المثلث الذي رؤوسه <span class=\"tx\" data-t=\"(-3,6)\"></span> و <span class=\"tx\" data-t=\"(1.2,10.2)\"></span> و <span class=\"tx\" data-t=\"(4,-1)\"></span> (الحدود غير مشمولة)","o":"نرسم الشعاعين من <span class=m dir=ltr>(−3, 6)</span> بخط متقطع ودائرة مفرغة عند رأسهما، والمستقيم <span class=\"tx\" data-t=\"y=-4x+15\"></span> بخط متقطع، ونظلل الجزء من الزاوية الواقع في جهة نقطة الأصل من المستقيم."}],[{"n":"23","s":[["z_0=3i","رأس الشعاعين النقطة <span class=m dir=ltr>(0, 3)</span> وهي دائرة مفرغة (غير مشمولة)"],["\\text{Arg}(z-3i)=0","الشعاع الأفقي يوازي المحور الحقيقي"],["\\text{Arg}(z-3i)=\\frac{\\pi}{3}","الشعاع المائل"],["0\\le\\text{Arg}(z-3i)\\le\\frac{\\pi}{3}","المنطقة المظللة بين الشعاعين والحدود متصلة"]],"a":"<span class=\"tx\" data-t=\"0\\le\\text{Arg}(z-3i)\\le\\frac{\\pi}{3}\"></span>","o":""}],[{"n":"27","s":[["|z-2i|\\le2","قرص مركزه <span class=m dir=ltr>(0, 2)</span> ونصف قطره <span class=m dir=ltr>2 (</span>يمر بنقطة الأصل)"],["\\frac{\\pi}{2}\\le\\text{Arg}(z)\\le\\frac{2\\pi}{3}","منطقة بين شعاعين من نقطة الأصل: المحور التخيلي الموجب والشعاع بزاوية <span class=\"tx\" data-t=\"120^\\circ\"></span>"],["(0,4),\\quad (-\\sqrt3,3)","نقطتا تقاطع الشعاعين مع الدائرة"]],"a":"المنطقة المظللة: جزء القرص المحصور بين القطعة من <span class=m dir=ltr>O</span> إلى <span class=\"tx\" data-t=\"(0,4)\"></span> والقطعة من <span class=m dir=ltr>O</span> إلى <span class=\"tx\" data-t=\"(-\\sqrt3,3)\"></span> والقوس الواصل بينهما","o":"الحدود متصلة، ودائرة مفرغة عند نقطة الأصل لأن سعة الصفر غير معرّفة."}],[{"n":"1","s":[["|z+5i|=4\\Rightarrow|z-(-5i)|=4","بإضافة <span class=m dir=ltr>3</span> للطرفين"],["x^2+(y+5)^2=16","<span class=m dir=ltr>z = x + iy</span>"]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(0,-5)\"></span> ونصف قطرها <span class=m dir=ltr>4</span>: <span class=\"tx\" data-t=\"x^2+(y+5)^2=16\"></span>","o":""},{"n":"2","s":[["|z-(2-8i)|=13",""],["(x-2)^2+(y+8)^2=169",""]],"a":"دائرة مركزها <span class=\"tx\" data-t=\"(2,-8)\"></span> ونصف قطرها <span class=m dir