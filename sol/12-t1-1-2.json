+40=A(x^2+5x+25)+(Bx+C)(x-5)",""],["x=5:\\ 75=75A \\Rightarrow A=1","بالتعويض"],["x^2:\\ 1=A+B \\Rightarrow B=0;\\quad \\text{const}:\\ 40=25-5C \\Rightarrow C=-3","بمقارنة المعاملات"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{x-5}-\\frac{3}{x^2+5x+25}\"></span>","o":"","k":[{"e":"-3/(x^2 + 5*x + 25) + 1/(x - 5)","a":null}]},{"n":"16","s":[["\\frac{-2x^3-30x^2+36x+216}{x^3+216}=-2+\\frac{-30x^2+36x+648}{x^3+216}","درجة البسط <span class=m dir=ltr>=</span> درجة المقام، فنقسم أولًا"],["x^3+216=(x+6)(x^2-6x+36)","مجموع مكعبين"],["-30x^2+36x+648=A(x^2-6x+36)+(Bx+C)(x+6)",""],["x=-6:\\ -648=108A \\Rightarrow A=-6","بالتعويض"],["x^2:\\ -30=A+B \\Rightarrow B=-24;\\quad \\text{const}:\\ 648=36A+6C \\Rightarrow C=144","بمقارنة المعاملات"]],"a":"<span class=\"tx\" data-t=\"-2-\\frac{6}{x+6}+\\frac{144-24x}{x^2-6x+36}\"></span>","o":"","k":[{"e":"(144 - 24*x)/(x^2 - 6*x + 36) - 2 - 6/(x + 6)","a":null}]},{"n":"17","s":[["\\frac{x^3+12x^2+33x+2}{x^2+8x+15}=x+4+\\frac{-14x-58}{(x+3)(x+5)}","بالقسمة أولًا"],["-14x-58=A(x+5)+B(x+3)",""],["x=-3:\\ -16=2A \\Rightarrow A=-8,\\qquad x=-5:\\ 12=-2B \\Rightarrow B=-6","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"x+4-\\frac{8}{x+3}-\\frac{6}{x+5}\"></span>","o":"","k":[{"e":"x + 4 - 6/(x + 5) - 8/(x + 3)","a":null}]},{"n":"18","s":[["x^3-2x^2+x-2=x^2(x-2)+(x-2)=(x-2)(x^2+1)","بالتجميع"],["\\frac{x^5-2x^4+x^3+x+5}{x^3-2x^2+x-2}=x^2+\\frac{2x^2+x+5}{(x-2)(x^2+1)}","بالقسمة أولًا"],["2x^2+x+5=A(x^2+1)+(Bx+C)(x-2)",""],["x=2:\\ 15=5A \\Rightarrow A=3","بالتعويض"],["x^2:\\ 2=3+B \\Rightarrow B=-1;\\quad \\text{const}:\\ 5=3-2C \\Rightarrow C=-1","بمقارنة المعاملات"]],"a":"<span class=\"tx\" data-t=\"x^2+\\frac{3}{x-2}-\\frac{x+1}{x^2+1}\"></span>","o":"","k":[{"e":"x^2 - (x + 1)/(x^2 + 1) + 3/(x - 2)","a":null}]}],[{"n":"19","s":[["\\frac{1}{x^2-a^2}=\\frac{1}{(x-a)(x+a)}=\\frac{A}{x-a}+\\frac{B}{x+a}","الفرق بين مربعين"],["1=A(x+a)+B(x-a)",""],["x=a:\\ 1=2aA \\Rightarrow A=\\frac{1}{2a}","بالتعويض، <span class=\"tx\" data-t=\"a\\ne0\"></span>"],["x=-a:\\ 1=-2aB \\Rightarrow B=-\\frac{1}{2a}",""],["\\frac{1}{x^2-a^2}=\\frac{1}{2a(x-a)}-\\frac{1}{2a(x+a)}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{x^2-a^2}=\\frac{1}{2a(x-a)}-\\frac{1}{2a(x+a)}\"></span> (وهو المطلوب)","o":""}],[{"n":"20","s":[["3(x^2+8x+7)=(px+11)(x-1)-(2p+10)(x^2+2)","بضرب الطرفين في <span class=\"tx\" data-t=\"3(x-1)(x^2+2)\"></span>"],["x=1:\\ 3(16)=0-(2p+10)(3)","بالتعويض"],["2p+10=-16 \\Rightarrow p=-13",""],["(-13x+11)(x-1)+16(x^2+2)=3x^2+24x+21","تحقق: يساوي <span class=\"tx\" data-t=\"3(x^2+8x+7)\"></span>"]],"a":"<span class=\"tx\" data-t=\"p=-13\"></span>","o":"","k":[{"e":"-13","a":null}]}],[{"n":"21","s":[["\\frac{2000(4-3x)}{(11-7x)(7-4x)}=\\frac{A}{11-7x}+\\frac{B}{7-4x}",""],["2000(4-3x)=A(7-4x)+B(11-7x)",""],["x=\\tfrac{11}{7}:\\ -\\tfrac{10000}{7}=\\tfrac57A \\Rightarrow A=-2000","بالتعويض"],["x=\\tfrac74:\\ -2500=-\\tfrac54B \\Rightarrow B=2000",""]],"a":"<span class=\"tx\" data-t=\"R(x)=\\frac{2000}{7-4x}-\\frac{2000}{11-7x}\"></span>","o":"","k":[{"e":"-2000/(11 - 7*x) + 2000/(7 - 4*x)","a":null}]},{"n":"22","s":[["R(x)=\\frac{2000}{7-4x}-\\frac{2000}{11-7x}","من السؤال السابق"],["(11-7x)-(7-4x)=4-3x>0,\\ 0\\le x\\le1","إذن <span class=\"tx\" data-t=\"11-7x&gt;7-4x&gt;0\"></span>"],["\\frac{2000}{7-4x}>\\frac{2000}{11-7x}","المقام الأصغر يعطي قيمة أكبر"]],"a":"اقتران أعلى درجة حرارة: <span class=\"tx\" data-t=\"\\frac{2000}{7-4x}\"></span>، واقتران أقل درجة حرارة: <span class=\"tx\" data-t=\"\\frac{2000}{11-7x}\"></span>","o":""}],[{"n":"23","s":[["v=\\frac{t^2-5t+6}{(t+2)(t^2-1)}=\\frac{A}{t+2}+\\frac{Bt+C}{t^2-1}","مسألة اليوم (ص <span class=m dir=ltr>21)</span>"],["t^2-5t+6=A(t^2-1)+(Bt+C)(t+2)",""],["t=-2:\\ 20=3A \\Rightarrow A=\\tfrac{20}{3}","بالتعويض"],["t^2:\\ 1=A+B \\Rightarrow B=-\\tfrac{17}{3};\\quad \\text{const}:\\ 6=-A+2C \\Rightarrow C=\\tfrac{19}{3}","بمقارنة المعاملات"],["v=\\frac{20}{3(t+2)}+\\frac{19-17t}{3(t^2-1)}",""]],"a":"نعم، يمكن: <span class=\"tx\" data-t=\"v=\\frac{20}{3(t+2)}+\\f