[[{"n":"1","s":[["\\begin{bmatrix}6 & 10\\end{bmatrix}","المصفوفة فيها صف واحد وعمودان"],["1 \\times 2","الرتبة <span class=m dir=ltr>=</span> عدد الصفوف <span class=m dir=ltr>×</span> عدد الأعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"1 \\times 2\"></span> (صف واحد، عمودان)","o":""},{"n":"2","s":[["\\begin{bmatrix}2 & 5 & -4 \\\\ 1 & 7 & 3 \\\\ 6 & 8 & 1\\end{bmatrix}","فيها <span class=m dir=ltr>3</span> صفوف و <span class=m dir=ltr>3</span> أعمدة"],["3 \\times 3","عدد الصفوف <span class=m dir=ltr>×</span> عدد الأعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"3 \\times 3\"></span> <span class=m dir=ltr>(3</span> صفوف، <span class=m dir=ltr>3</span> أعمدة)","o":""},{"n":"3","s":[["\\begin{bmatrix}3 \\\\ 5 \\\\ 8 \\\\ -4\\end{bmatrix}","فيها <span class=m dir=ltr>4</span> صفوف وعمود واحد"],["4 \\times 1","عدد الصفوف <span class=m dir=ltr>×</span> عدد الأعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"4 \\times 1\"></span> <span class=m dir=ltr>(4</span> صفوف، عمود واحد)","o":""},{"n":"4","s":[["\\begin{bmatrix}10\\end{bmatrix}","صف واحد وعمود واحد"],["1 \\times 1","عدد الصفوف <span class=m dir=ltr>×</span> عدد الأعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"1 \\times 1\"></span>","o":""}],[{"n":"5","s":[["a_{31}","العنصر الواقع في الصف <span class=m dir=ltr>3</span> والعمود <span class=m dir=ltr>1</span>"],["a_{31} = 7","من الصف الثالث: <span class=m dir=ltr>7, −3, 5, 12</span>"]],"a":"<span class=\"tx\" data-t=\"a_{31} = 7\"></span>","o":""},{"n":"6","s":[["a_{23}","العنصر الواقع في الصف <span class=m dir=ltr>2</span> والعمود <span class=m dir=ltr>3</span>"],["a_{23} = 9","من الصف الثاني: <span class=m dir=ltr>1, 0, 9, 8</span>"]],"a":"<span class=\"tx\" data-t=\"a_{23} = 9\"></span>","o":""},{"n":"7","s":[["a_{14}","العنصر الواقع في الصف <span class=m dir=ltr>1</span> والعمود <span class=m dir=ltr>4</span>"],["a_{14} = -2","من الصف الأول: <span class=m dir=ltr>2, 4, 3, −2</span>"]],"a":"<span class=\"tx\" data-t=\"a_{14} = -2\"></span>","o":""}],[{"n":"8","s":[["\\begin{bmatrix} 6 & 8 & 0 \\end{bmatrix}","العدد <span class=m dir=ltr>8</span> موجود في الصف الثالث"],["6,\\; \\boxed{8},\\; 0","وهو العنصر الثاني في هذا الصف، أي في العمود <span class=m dir=ltr>2</span>"],["b_{32} = 8","نكتب رقم الصف أولًا ثم رقم العمود"]],"a":"يقع العنصر <span class=m dir=ltr>8</span> في الصف <span class=m dir=ltr>3</span> والعمود <span class=m dir=ltr>2</span>، ويُرمَز إليه بالرمز <span class=\"tx\" data-t=\"b_{32}\"></span>","o":""}],[{"n":"9","s":[["C","عدد الصفوف <span class=m dir=ltr>=</span> عدد الأعمدة <span class=m dir=ltr>= 4</span>"],["4 \\times 4","الرتبة"]],"a":"مصفوفة مربعة من الرتبة <span class=\"tx\" data-t=\"4 \\times 4\"></span> (أو من الرتبة <span class=m dir=ltr>4)</span>","o":""},{"n":"10","s":[["A","فيها عمود واحد و <span class=m dir=ltr>3</span> صفوف"],["3 \\times 1","الرتبة"]],"a":"مصفوفة عمود من الرتبة <span class=\"tx\" data-t=\"3 \\times 1\"></span>","o":""},{"n":"11","s":[["\\begin{bmatrix}0 & 3 & 5 & 2\\end{bmatrix}","فيها صف واحد و <span class=m dir=ltr>4</span> أعمدة"],["1 \\times 4","الرتبة"]],"a":"مصفوفة صف من الرتبة <span class=\"tx\" data-t=\"1 \\times 4\"></span>","o":""},{"n":"12","s":[["\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}","جميع عناصرها أصفار، وعدد صفوفها <span class=m dir=ltr>=</span> عدد أعمدتها"],["2 \\times 2","الرتبة"]],"a":"مصفوفة صفرية (وهي أيضًا مربعة) من الرتبة <span class=\"tx\" data-t=\"2 \\times 2\"></span>","o":""}],[{"n":"13","s":[["3x - 11 = 4","بمساواة العنصرين المتناظرين في الموقع <span class=m dir=ltr>21</span>"],["3x = 15 \\Rightarrow x = 5","بإضافة <span class=m dir=ltr>11</span> للطرفين ثم القسمة على <span class=m dir=ltr>3</span>"],["x + 2y = -1","بمساواة العنصرين المتناظرين في الموقع <span class=m dir=ltr>12</span>"],["5 + 2y = -1 \\Rightarrow 2y = -6 \\Rightarrow y = -3","بالتعويض <span class=m dir=ltr>x = 5</span>"],["z = 2","بمساواة العنصرين المتناظرين في الموقع <span class=m dir=ltr>22</span>"]],"a":"<span class=\"tx\" data-t=\"x = 5\"></span>، <span class=\"tx\" data-t=\"y = -3\"></span>، <span class=\"tx\" data-t=\"z = 2\"></span>","o":""}],[{"n":"14","s":[["x^2 = 2x + 3","بمساواة العنصرين المتناظرين في الموقع <span class=m dir=ltr>12</span>"],["x^2 - 2x - 3 = 0","بنقل الحدود إلى طرف واحد"],["(x - 3)(x + 1) = 0","بالتحليل إلى العوامل"],["x = 3 \\text{ or } x = -1","خاصية الضرب الصفري"],["2 - y = -5 \\Rightarrow y = 7","بمساواة العنصرين المتناظرين في الموقع <span class=m dir=ltr>21</span>"]],"a":"<span class=\"tx\" data-t=\"x = 3\"></span> أو <span class=\"tx\" data-t=\"x = -1\"></span>، و <span class=\"tx\" data-t=\"y = 7\"></span>","o":""}],[{"n":"15","s":[["B: 13,\\; C: 9,\\; A: 7","ترتيب الحملات تنازليًّا حسب عدد عمليات الشراء"],["S = \\begin{bmatrix}11 & 25 & 13 \\\\ 14 & 20 & 9 \\\\ 8 & 15 & 7\\end{bmatrix}","الصفوف: <span class=m dir=ltr>B</span> ثم <span class=m dir=ltr>C</span> ثم <span class=m dir=ltr>A</span>، والأعمدة: الإعلانات، زوار الموقع، عمليات الشراء"],["s_{32} = 15","العنصر في الصف <span class=m dir=ltr>3 (</span>الحملة <span class=m dir=ltr>A)</span> والعمود <span class=m dir=ltr>2 (</span>زوار الموقع)"]],"a":"<span class=\"tx\" data-t=\"s_{32} = 15\"></span>، وهو عدد زوار الموقع في الحملة <span class=\"tx\" data-t=\"A\"></span>","o":"رتّبنا الأعمدة كما تظهر في الجدول من اليسار (الإعلانات، الزوار، الشراء)؛ قيمة <span class=\"tx\" data-t=\"s_{32}\"></span> هي <span class=m dir=ltr>15</span> مهما كان ترتيب الأعمدة لأن عمود الزوار في الوسط."},{"n":"16","s":[["14 + 20 + 9 = 43","مجموع عناصر الصف الثاني (الحملة <span class=m dir=ltr>C)</span>"]],"a":"المجموع <span class=m dir=ltr>43</span>، وليس له معنى؛ لأنه يجمع كميات مختلفة (إعلانات <span class=m dir=ltr>+</span> زوار <span class=m dir=ltr>+</span> عمليات شراء)","o":""},{"n":"17","s":[["13 + 9 + 7 = 29","مجموع عناصر العمود الثالث (عمليات الشراء)"]],"a":"المجموع <span class=m dir=ltr>29</span>، ويمثّل العدد الكلي لعمليات الشراء في الحملات الثلاث","o":"إذا رُتّبت الأعمدة بالترتيب العكسي (الشراء، الزوار، الإعلانات) يصبح العمود الثالث هو الإعلانات ومجموعه <span class=\"tx\" data-t=\"8 + 11 + 14 = 33\"></span> <span class=m dir=ltr>=</span> العدد الكلي للإعلانات."}],[{"n":"18","s":[["b_{23} = 0","لم تُذكر شاشات في مستودع المدينة الثانية، فعددها <span class=m dir=ltr>0</span>"],["\\begin{bmatrix}200 & 380 & 250 & 300 \\\\ 160 & 540 & 0 & 290 \\\\ 120 & 280 & 400 & 470\\end{bmatrix}","الصفوف: المدن <span class=m dir=ltr>1</span>، <span class=m dir=ltr>2</span>، <span class=m dir=ltr>3</span>، والأعمدة: ثلاجة، غسالة، شاشة، مروحة"],["3 \\times 4","<span class=m dir=ltr>3</span> صفوف و <span class=m dir=ltr>4</span> أعمدة"]],"a":"المصفوفة من الرتبة <span class=\"tx\" data-t=\"3 \\times 4\"></span>","o":""},{"n":"19","s":[["200 + 380 + 250 + 300 = 1130","الصف الأول"],["160 + 540 + 0 + 290 = 990","الصف الثاني"],["120 + 280 + 400 + 470 = 1270","الصف الثالث"]],"a":"<span class=m dir=ltr>1130</span>، <span class=m dir=ltr>990</span>، <span class=m dir=ltr>1270</span>، وكل مجموع يمثّل العدد الكلي للأجهزة الكهربائية في مستودع كل مدينة","o":""},{"n":"20","s":[["200 + 160 + 120 = 480","عمود الثلاجات"],["380 + 540 + 280 = 1200","عمود الغسالات"],["250 + 0 + 400 = 650","عمود الشاشات"],["300 + 290 + 470 = 1060","عمود المراوح"]],"a":"<span class=m dir=ltr>480</span>، <span class=m dir=ltr>1200</span>، <span class=m dir=ltr>650</span>، <span class=m dir=ltr>1060</span>، وكل مجموع يمثّل العدد الكلي لكل نوع من الأجهزة في المستودعات الثلاثة","o":""}],[{"n":"21","s":[["88,\\; 324,\\; 408","المسافات المعطاة <span class=m dir=ltr>(km)</span>؛ نرتّب الصفوف والأعمدة: إربد، عمّان، العقبة"],["\\begin{bmatrix}0 & 88 & 408 \\\\ 88 & 0 & 324 \\\\ 408 & 324 & 0\\end{bmatrix}","كل عنصر هو المسافة بين مدينة الصف ومدينة العمود <span class=m dir=ltr>(km)</span>"]],"a":"المصفوفة <span class=\"tx\" data-t=\"\\begin{bmatrix}0 &amp; 88 &amp; 408 \\\\ 88 &amp; 0 &amp; 324 \\\\ 408 &amp; 324 &amp; 0\\end{bmatrix}\"></span>","o":"التبرير: عناصر القطر الرئيس أصفار لأن المسافة بين المدينة ونفسها <span class=m dir=ltr>0</span>، والمصفوفة متماثلة (<span class=\"tx\" data-t=\"a_{ij} = a_{ji}\"></span>) لأن المسافة من إربد إلى عمّان تساوي المسافة من عمّان إلى إربد."}],[{"n":"22","s":[["2 \\times 4","مسألة اليوم: مدينتان (الصفوف <span class=m dir=ltr>A, B)</span> و <span class=m dir=ltr>4</span> مصادر تدفئة (الأعمدة: الغاز، الكهرباء، الكاز، أخرى كما في الجدول من اليسار)"],["\\begin{bmatrix}3256 & 1678 & 4589 & 1253 \\\\ 4560 & 978 & 5874 & 2564\\end{bmatrix}","مصفوفة من الرتبة <span class=m dir=ltr>2 × 4</span>"]],"a":"يمكن عرض البيانات بصورة مختصرة في مصفوفة رتبتها <span class=\"tx\" data-t=\"2 \\times 4\"></span>: <span class=\"tx\" data-t=\"\\begin{bmatrix}3256 &amp; 1678 &amp; 4589 &amp; 1253 \\\\ 4560 &amp; 978 &amp; 5874 &amp; 2564\\end{bmatrix}\"></span>","o":""}],[{"n":"23","s":[["A = \\begin{bmatrix}1 & 2\\end{bmatrix},\\; B = \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}","مثال: لكلٍّ منهما عنصران"],["A \\ne B","لأن الرتبتين مختلفتان <span class=m dir=ltr>(1 × 2</span> و <span class=m dir=ltr>2 × 1)</span>"],["A = \\begin{bmatrix}1 & 2\\end{bmatrix},\\; B = \\begin{bmatrix}1 & 2\\end{bmatrix} \\Rightarrow A = B","وقد تتساويان إذا تساوت الرتبة والعناصر المتناظرة"]],"a":"العبارة صحيحة أحيانًا؛ فتساوي عدد العناصر لا يكفي، بل يجب أن تكون للمصفوفتين الرتبة نفسها وأن تتساوى عناصرهما المتناظرة","o":""}],[{"n":"24","s":[["a_{ij} = a_{ji}","العنصر في الموقع <span class=m dir=ltr>ij</span> يساوي العنصر في الموقع <span class=m dir=ltr>ji (</span>تماثل حول القطر الرئيس)"],["A = \\begin{bmatrix}1 & 2 & 3 \\\\ 2 & 4 & 5 \\\\ 3 & 5 & 6\\end{bmatrix}","نختار عناصر القطر بحرية ثم نكرّر العناصر بشكل متماثل"],["a_{12} = a_{21} = 2,\\; a_{13} = a_{31} = 3,\\; a_{23} = a_{32} = 5","تحقق"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"A = \\begin{bmatrix}1 &amp; 2 &amp; 3 \\\\ 2 &amp; 4 &amp; 5 \\\\ 3 &amp; 5 &amp; 6\\end{bmatrix}\"></span>","o":""}],[{"n":"25","s":[["m \\times n = p","عدد العناصر <span class=m dir=ltr>=</span> عدد الصفوف <span class=m dir=ltr>×</span> عدد الأعمدة، حيث <span class=m dir=ltr>p</span> عدد أولي"],["p = 1 \\times p = p \\times 1","العدد الأولي له عاملان فقط: <span class=m dir=ltr>1</span> ونفسه"],["m = 1, n = p \\;\\text{ or }\\; m = p, n = 1","إذن أحد البعدين يساوي <span class=m dir=ltr>1</span>"]],"a":"رتبتها <span class=\"tx\" data-t=\"1 \\times p\"></span> (مصفوفة صف) أو <span class=\"tx\" data-t=\"p \\times 1\"></span> (مصفوفة عمود)، حيث <span class=\"tx\" data-t=\"p\"></span> عدد عناصرها؛ فمثلًا إذا كان عدد العناصر <span class=m dir=ltr>5</span> فالرتبة <span class=\"tx\" data-t=\"1 \\times 5\"></span> أو <span class=\"tx\" data-t=\"5 \\times 1\"></span>","o":""}],[{"n":"26","s":[["b_{ij} = 2i - j","القاعدة المعطاة، <span class=m dir=ltr>B</span> من الرتبة <span class=m dir=ltr>3 × 4</span>"],["b_{11} = 2(1) - 1 = 1,\\; b_{12} = 0,\\; b_{13} = -1,\\; b_{14} = -2","الصف الأول <span class=m dir=ltr>(i = 1)</span>"],["b_{21} = 2(2) - 1 = 3,\\; b_{22} = 2,\\; b_{23} = 1,\\; b_{24} = 0","الصف الثاني <span class=m dir=ltr>(i = 2)</span>"],["b_{31} = 2(3) - 1 = 5,\\; b_{32} = 4,\\; b_{33} = 3,\\; b_{34} = 2","الصف الثالث <span class=m dir=ltr>(i = 3)</span>"]],"a":"<span class=\"tx\" data-t=\"B = \\begin{bmatrix}1 &amp; 0 &amp; -1 &amp; -2 \\\\ 3 &amp; 2 &amp; 1 &amp; 0 \\\\ 5 &amp; 4 &amp; 3 &amp; 2\\end{bmatrix}\"></span>","o":""}],[{"n":"27","s":[["x + 2y = 13,\\quad x - y = 7","بمساواة العناصر المتناظرة في الصف الأول"],["3y = 6 \\Rightarrow y = 2","بطرح المعادلة الثانية من الأولى"],["x - 2 = 7 \\Rightarrow x = 9","بالتعويض في المعادلة الثانية"],["x + y + 3z = 2","بمساواة العنصرين في الموقع <span class=m dir=ltr>21</span>"],["9 + 2 + 3z = 2 \\Rightarrow 3z = -9 \\Rightarrow z = -3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"x = 9\"></span>، <span class=\"tx\" data-t=\"y = 2\"></span>، <span class=\"tx\" data-t=\"z = -3\"></span>","o":""}],[{"n":"1","s":[["a_{21}=9,\\ a_{32}=6","<span class=\"tx\" data-t=\"a_{21}\"></span>: الصف <span class=m dir=ltr>2</span> العمود <span class=m dir=ltr>1</span>، و<span class=\"tx\" data-t=\"a_{32}\"></span>: الصف <span class=m dir=ltr>3</span> العمود <span class=m dir=ltr>2</span>"],["a_{21}+a_{32}=9+6=15","بالجمع"]],"a":"الإجابة <span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"15\"></span>","o":""}],[{"n":"13","s":[["P=\\begin{bmatrix}71 & 66 \\\\ 68 & 59 \\\\ 32 & 22 \\\\ 11 & 14\\end{bmatrix}","الصفوف: فئات العمر، العمود الأول: الذكور، العمود الثاني: الإناث"],["4\\times2","<span class=m dir=ltr>4</span> صفوف وعمودان"]],"a":"<span class=\"tx\" data-t=\"P=\\begin{bmatrix}71 &amp; 66\\\\ 68 &amp; 59\\\\ 32 &amp; 22\\\\ 11 &amp; 14\\end{bmatrix}\"></span>، رتبتها <span class=\"tx\" data-t=\"4\\times2\"></span>","o":"الأرقام بالآلاف"}],[{"n":"1","s":[["2\\times3","صفّان و<span class=m dir=ltr>3</span> أعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"2\\times3\"></span>","o":""},{"n":"2","s":[["3\\times1","<span class=m dir=ltr>3</span> صفوف وعمود واحد (مصفوفة عمود)"]],"a":"الرتبة <span class=\"tx\" data-t=\"3\\times1\"></span>","o":""},{"n":"3","s":[["2\\times2","صفّان وعمودان (مصفوفة مربعة)"]],"a":"الرتبة <span class=\"tx\" data-t=\"2\\times2\"></span>","o":""},{"n":"4","s":[["1\\times3","صف واحد و<span class=m dir=ltr>3</span> أعمدة (مصفوفة صف)"]],"a":"الرتبة <span class=\"tx\" data-t=\"1\\times3\"></span>","o":""},{"n":"5","s":[["3\\times3","<span class=m dir=ltr>3</span> صفوف و<span class=m dir=ltr>3</span> أعمدة (مصفوفة مربعة)"]],"a":"الرتبة <span class=\"tx\" data-t=\"3\\times3\"></span>","o":""},{"n":"6","s":[["4\\times3","<span class=m dir=ltr>4</span> صفوف و<span class=m dir=ltr>3</span> أعمدة"]],"a":"الرتبة <span class=\"tx\" data-t=\"4\\times3\"></span>","o":""}],[{"n":"7","s":[["P=\\begin{bmatrix}40 & 60 & 75 \\\\ 30 & 40 & 55 \\\\ 50 & 70 & 90 \\\\ 65 & 90 & 125\\end{bmatrix}","الصفوف: غازي، شاي، قهوة، عصير. الأعمدة: صغير، وسط، كبير"]],"a":"<span class=\"tx\" data-t=\"P=\\begin{bmatrix}40 &amp; 60 &amp; 75\\\\ 30 &amp; 40 &amp; 55\\\\ 50 &amp; 70 &amp; 90\\\\ 65 &amp; 90 &amp; 125\\end{bmatrix}\"></span> رتبتها <span class=\"tx\" data-t=\"4\\times3\"></span>","o":""},{"n":"8","s":[["