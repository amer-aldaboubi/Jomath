[[{"n":"1","s":[["\\mu=\\frac{\\sum x}{n}=\\frac{18+20+11+13+5+12+14}{7}=\\frac{93}{7}","صيغة الوسط الحسابي، بالتعويض"],["\\sum x^2=324+400+121+169+25+144+196=1379","أنشئ جدولًا أحسب فيه مربع كل مشاهدة"],["\\sigma^2=\\frac{\\sum x^2}{n}-\\mu^2=\\frac{1379}{7}-\\left(\\frac{93}{7}\\right)^2","الصيغة الثانية للتباين (لأن الوسط عدد غير صحيح)"],["=\\frac{1004}{49}\\approx 20.49","باستعمال الآلة الحاسبة"]],"a":"التباين <span class=\"tx\" data-t=\"\\sigma^2=\\frac{1004}{49}\\approx 20.49\"></span>","o":""},{"n":"2","s":[["\\sigma=\\sqrt{\\sigma^2}=\\sqrt{\\frac{1004}{49}}","الانحراف المعياري هو الجذر التربيعي للتباين"],["\\approx 4.53","باستعمال الآلة الحاسبة"]],"a":"الانحراف المعياري <span class=\"tx\" data-t=\"\\sigma\\approx 4.53\"></span> يوم","o":""}],[{"n":"3","s":[["\\mu=\\frac{61+54+44+57+38}{5}=\\frac{254}{5}=50.8","صيغة الوسط الحسابي"],["x-\\mu:\\ 10.2,\\ 3.2,\\ -6.8,\\ 6.2,\\ -12.8","انحراف كل مشاهدة عن الوسط"],["\\sum(x-\\mu)^2=104.04+10.24+46.24+38.44+163.84=362.8","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{\\sum(x-\\mu)^2}{n}=\\frac{362.8}{5}=72.56","صيغة التباين"]],"a":"التباين <span class=\"tx\" data-t=\"\\sigma^2=72.56\"></span>","o":""},{"n":"4","s":[["\\sigma=\\sqrt{72.56}\\approx 8.52","الانحراف المعياري هو الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 8.52\"></span> هدفًا","o":""}],[{"n":"5","s":[["\\mu=\\frac{27+43+29+34+53+37+19+58}{8}=\\frac{300}{8}=37.5","صيغة الوسط الحسابي"],["x-\\mu:\\ -10.5,\\ 5.5,\\ -8.5,\\ -3.5,\\ 15.5,\\ -0.5,\\ -18.5,\\ 20.5","انحراف كل مشاهدة عن الوسط"],["\\sum(x-\\mu)^2=1228","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{1228}{8}=153.5","صيغة التباين"],["\\sigma=\\sqrt{153.5}\\approx 12.39","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2=153.5\"></span> ، <span class=\"tx\" data-t=\"\\sigma\\approx 12.39\"></span>","o":""},{"n":"6","s":[["\\mu=\\frac{12+15+18+16+7+9+14}{7}=\\frac{91}{7}=13","صيغة الوسط الحسابي"],["x-\\mu:\\ -1,\\ 2,\\ 5,\\ 3,\\ -6,\\ -4,\\ 1","انحراف كل مشاهدة عن الوسط"],["\\sum(x-\\mu)^2=1+4+25+9+36+16+1=92","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{92}{7}\\approx 13.14","صيغة التباين"],["\\sigma=\\sqrt{\\frac{92}{7}}\\approx 3.63","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 13.14\"></span> ، <span class=\"tx\" data-t=\"\\sigma\\approx 3.63\"></span>","o":""}],[{"n":"7","s":[["x\\times f:\\ 0,\\ 12,\\ 18,\\ 12,\\ 12,\\ 5\\ \\Rightarrow\\ \\sum(x\\times f)=59","أضيف عمود <span class=m dir=ltr>x × f</span> إلى الجدول"],["x^2\\times f:\\ 0,\\ 12,\\ 36,\\ 36,\\ 48,\\ 25\\ \\Rightarrow\\ \\sum(x^2\\times f)=157","أضيف عمود <span class=m dir=ltr>x² × f</span>"],["\\mu=\\frac{\\sum(x\\times f)}{\\sum f}=\\frac{59}{35}","صيغة الوسط الحسابي، مجموع التكرارات <span class=m dir=ltr>35</span>"],["\\sigma^2=\\frac{\\sum(x^2\\times f)}{\\sum f}-\\mu^2=\\frac{157}{35}-\\left(\\frac{59}{35}\\right)^2","الصيغة الثانية للتباين"],["\\approx 1.644","باستعمال الآلة الحاسبة"]],"a":"التباين <span class=\"tx\" data-t=\"\\sigma^2\\approx 1.644\"></span>","o":""},{"n":"8","s":[["\\sigma=\\sqrt{1.644}\\approx 1.28","الجذر التربيعي للتباين"]],"a":"الانحراف المعياري <span class=\"tx\" data-t=\"\\sigma\\approx 1.28\"></span> طفل","o":""}],[{"n":"9","s":[["x\\times f:\\ 150,\\ 550,\\ 1080,\\ 1430,\\ 1190,\\ 750\\ \\Rightarrow\\ \\sum(x\\times f)=5150","أضيف عمود <span class=m dir=ltr>x × f</span>، ومجموع التكرارات <span class=m dir=ltr>80</span>"],["\\sum(x^2\\times f)=7500+30250+64800+92950+83300+56250=335050","أضيف عمود <span class=m dir=ltr>x² × f</span>"],["\\mu=\\frac{5150}{80}=64.375","صيغة الوسط الحسابي"],["\\sigma^2=\\frac{335050}{80}-(64.375)^2","الصيغة الثانية للتباين"],["\\approx 43.98","باستعمال الآلة الحاسبة"]],"a":"التباين <span class=\"tx\" data-t=\"\\sigma^2\\approx 43.98\"></span>","o":""},{"n":"10","s":[["\\sigma=\\sqrt{43.98}\\approx 6.63","الجذر التربيعي للتباين"]],"a":"الانحراف المعياري <span class=\"tx\" data-t=\"\\sigma\\approx 6.63\\ \\text{kg}\"></span>","o":""}],[{"n":"11","s":[["y=10x-500:\\ 36,\\ 27,\\ 54,\\ 54,\\ 72,\\ 99,\\ 126","أحوّل كل طول باستعمال العلاقة"],["\\mu_y=\\frac{\\sum y}{n}=\\frac{468}{7}\\approx 66.86","صيغة الوسط الحسابي"],["\\sum y^2=38718","مجموع مربعات القيم بعد التحويل"],["\\sigma_y=\\sqrt{\\frac{\\sum y^2}{n}-\\mu_y^2}=\\sqrt{\\frac{38718}{7}-\\left(\\frac{468}{7}\\right)^2}","الصيغة الثانية للانحراف المعياري"],["\\approx 32.58","باستعمال الآلة الحاسبة"]],"a":"بعد التحويل: <span class=\"tx\" data-t=\"\\mu_y\\approx 66.86\"></span> ، <span class=\"tx\" data-t=\"\\sigma_y\\approx 32.58\"></span>","o":""},{"n":"12","s":[["\\mu_y=a\\mu_x+b\\ \\Rightarrow\\ \\frac{468}{7}=10\\mu_x-500","صيغة تحويل الوسط الحسابي، حيث <span class=m dir=ltr>a = 10</span> و <span class=m dir=ltr>b = −500</span>"],["10\\mu_x=\\frac{468}{7}+500=\\frac{3968}{7}","بجمع <span class=m dir=ltr>500</span> إلى طرفي المعادلة"],["\\mu_x=\\frac{396.8}{7}\\approx 56.69","بقسمة الطرفين على <span class=m dir=ltr>10</span>"],["\\sigma_y=|a|\\sigma_x\\ \\Rightarrow\\ 32.58\\approx 10\\,\\sigma_x","صيغة تحويل الانحراف المعياري"],["\\sigma_x\\approx 3.258","بقسمة الطرفين على <span class=m dir=ltr>10</span>"]],"a":"قبل التحويل: <span class=\"tx\" data-t=\"\\mu_x\\approx 56.69\\ \\text{cm}\"></span> ، <span class=\"tx\" data-t=\"\\sigma_x\\approx 3.26\\ \\text{cm}\"></span>","o":""}],[{"n":"13","s":[["\\mu_y=\\frac{\\sum y}{n}=\\frac{314}{97}\\approx 3.237","الوسط الحسابي بعد التحويل، <span class=m dir=ltr>n = 97</span>"],["\\mu_y=\\mu_x-5","صيغة تحويل الوسط، حيث <span class=m dir=ltr>a = 1</span> و <span class=m dir=ltr>b = −5</span>"],["\\mu_x=\\mu_y+5\\approx 3.237+5=8.237","بجمع <span class=m dir=ltr>5</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"\\mu_x\\approx 8.24\\ \\text{kg}\"></span>","o":""},{"n":"14","s":[["\\sigma_y^2=\\frac{\\sum y^2}{n}-\\mu_y^2=\\frac{1623}{97}-\\left(\\frac{314}{97}\\right)^2","الصيغة الثانية للتباين"],["\\approx 6.253","باستعمال الآلة الحاسبة"],["\\sigma_y=\\sqrt{6.253}\\approx 2.501","الجذر التربيعي للتباين"],["\\sigma_x=\\frac{\\sigma_y}{|a|}=\\frac{2.501}{1}=2.501","صيغة تحويل الانحراف المعياري و <span class=m dir=ltr>a = 1 (</span>طرح عدد لا يؤثر في التشتت)"],["\\sigma_x^2=\\sigma_y^2\\approx 6.253",""]],"a":"التباين <span class=\"tx\" data-t=\"\\approx 6.25\"></span> ، الانحراف المعياري <span class=\"tx\" data-t=\"\\approx 2.50\\ \\text{kg}\"></span>","o":""}],[{"n":"15","s":[["\\mu=\\frac{\\sum x}{n}=\\frac{6400}{40}=160","صيغة الوسط الحسابي"],["\\sigma^2=\\frac{\\sum x^2}{n}-\\mu^2=\\frac{1400000}{40}-160^2","الصيغة الثانية للتباين"],["=35000-25600=9400","بالتبسيط"],["\\sigma=\\sqrt{9400}\\approx 96.95","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 96.95\"></span>","o":""}],[{"n":"16","s":[["\\sum(x-\\mu)=0","مجموع انحرافات المشاهدات عن وسطها الحسابي يساوي صفرًا"],["4-2+3+3-1+k-5+2=0","بالتعويض"],["4+k=0","بالتبسيط"],["k=-4","بطرح <span class=m dir=ltr>4</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"k=-4\"></span>","o":""},{"n":"17","s":[["\\sum(x-\\mu)^2=16+4+9+9+1+16+25+4=84","مجموع مربعات الانحرافات <span class=m dir=ltr>(k = −4)</span>"],["\\sigma^2=\\frac{\\sum(x-\\mu)^2}{n}=\\frac{84}{8}=10.5","صيغة التباين"],["\\sigma=\\sqrt{10.5}\\approx 3.24","الجذر التربيعي للتباين"]],"a":"التباين <span class=\"tx\" data-t=\"10.5\\ \\text{cm}^2\"></span> ، الانحراف المعياري <span class=\"tx\" data-t=\"\\approx 3.24\\ \\text{cm}\"></span>","o":""}],[{"n":"18","s":[["\\mu=\\frac{3+3+2+4+3+4+2+6+3+6}{10}=\\frac{36}{10}=3.6","الوسط الحسابي لعدد الأكواب"],["x-\\mu:\\ -0.6,\\ -0.6,\\ -1.6,\\ 0.4,\\ -0.6,\\ 0.4,\\ -1.6,\\ 2.4,\\ -0.6,\\ 2.4","انحراف كل مشاهدة عن الوسط"],["\\sum(x-\\mu)^2=18.4","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{18.4}{10}=1.84","<span class=m dir=ltr>1)</span> التباين"],["\\sigma=\\sqrt{1.84}\\approx 1.36","<span class=m dir=ltr>2)</span> الانحراف المعياري"]],"a":"التباين <span class=\"tx\" data-t=\"1.84\"></span> ، الانحراف المعياري <span class=\"tx\" data-t=\"\\approx 1.36\"></span> كوب","o":"مسألة اليوم: عدد أكواب الماء التي شربتها أميرة في <span class=m dir=ltr>10</span> أيام: <span class=m dir=ltr>3, 3, 2, 4, 3, 4, 2, 6, 3, 6</span>"}],[{"n":"19","s":[["(a):\\ 4,4,4,4,\\ 5\\ (\\times 7),\\ 6,6,6,6","القيم في <span class=m dir=ltr>(a)</span> بين <span class=m dir=ltr>4</span> و <span class=m dir=ltr>6</span> فقط، ومعظمها عند الوسط <span class=m dir=ltr>5</span>"],["(b):\\ 2\\ \\text{to}\\ 8","القيم في <span class=m dir=ltr>(b)</span> منتشرة من <span class=m dir=ltr>2</span> إلى <span class=m dir=ltr>8</span> وبعيدة عن الوسط <span class=m dir=ltr>5</span>"]],"a":"التمثيل <span class=\"tx\" data-t=\"(a)\"></span> انحرافه المعياري أصغر؛ لأن بياناته متجمّعة قريبًا من وسطها الحسابي ومداها أصغر <span class=\"tx\" data-t=\"(6-4=2)\"></span>، أما <span class=\"tx\" data-t=\"(b)\"></span> فبياناته أكثر تشتّتًا <span class=\"tx\" data-t=\"(8-2=6)\"></span>","o":""}],[{"n":"20","s":[["\\sum(3x-1)=3\\sum x-\\sum 1=3\\sum x-n","خصائص رمز المجموع"],["3\\sum x-10=53","بالتعويض <span class=m dir=ltr>n = 10</span>"],["3\\sum x=63","بجمع <span class=m dir=ltr>10</span> إلى الطرفين"],["\\sum x=21","بقسمة الطرفين على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"\\sum x=21\"></span>","o":""}],[{"n":"21","s":[["5,\\ 5,\\ 5,\\ 5\\ \\Rightarrow\\ \\mu=5","مثال: جميع القيم متساوية"],["\\sigma^2=\\frac{0+0+0+0}{4}=0\\ \\Rightarrow\\ \\sigma=0","جميع الانحرافات أصفار"]],"a":"نعم، يكون الانحراف المعياري صفرًا عندما تكون جميع قيم البيانات متساوية؛ لأن انحراف كل قيمة عن الوسط الحسابي يساوي صفرًا، فلا يوجد تشتّت","o":""}],[{"n":"22","s":[["\\sigma^2=(10\\sqrt2)^2=200","التباين مربع الانحراف المعياري؛ نفرض نقاط المرحلة السابعة <span class=m dir=ltr>p</span>"],["\\sum x=230+p,\\quad \\sum x^2=9302+p^2,\\quad n=7","مجاميع المراحل الست ثم إضافة <span class=m dir=ltr>p</span>"],["\\frac{9302+p^2}{7}-\\left(\\frac{230+p}{7}\\right)^2=200","الصيغة الثانية للتباين"],["7(9302+p^2)-(230+p)^2=9800\\ \\Rightarrow\\ 3p^2-230p+1207=0","بضرب الطرفين في <span class=m dir=ltr>49</span> والتبسيط"],["p=\\frac{230\\pm\\sqrt{38416}}{6}=\\frac{230\\pm196}{6}","القانون العام"],["p=71\\quad \\text{or}\\quad p=\\frac{17}{3}","عدد النقاط عدد صحيح، فنرفض <span class=m dir=ltr>17/3</span>"]],"a":"يجب أن يحرز يوسف <span class=\"tx\" data-t=\"71\"></span> نقطة (تحقق: الوسط <span class=\"tx\" data-t=\"43\"></span> والانحراف المعياري <span class=\"tx\" data-t=\"10\\sqrt2\\approx 14.14\"></span>)","o":""}],[{"n":"1","s":[["\\mu=\\frac{11+13+14+16+18}{5}=\\frac{72}{5}=14.4","الوسط الحسابي"],["\\sum(x-\\mu)^2=11.56+1.96+0.16+2.56+12.96=29.2","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{29.2}{5}=5.84\\approx 5.8","صيغة التباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 5.8\"></span>، رمز الإجابة: <span class=m dir=ltr>a</span>","o":""}],[{"n":"2","s":[["\\sigma_y=|a|\\sigma_x","صيغة تحويل الانحراف المعياري"],["\\sigma_y=|2|(3)=6","بالتعويض <span class=m dir=ltr>a = 2</span>، والثابت <span class=m dir=ltr>-15</span> لا يؤثر"]],"a":"<span class=\"tx\" data-t=\"\\sigma_y=6\"></span>، رمز الإجابة: <span class=m dir=ltr>d</span>","o":""}],[{"n":"5","s":[["\\sum f=35,\\ \\sum xf=1256,\\ \\sum x^2f=45124","من الجدول"],["\\mu=\\frac{\\sum xf}{\\sum f}=\\frac{1256}{35}\\approx 35.886","الوسط الحسابي"],["\\sigma^2=\\frac{\\sum x^2f}{\\sum f}-\\mu^2=\\frac{45124}{35}-\\left(\\frac{1256}{35}\\right)^2","الصيغة الثانية للتباين"],["\\sigma^2\\approx 1.473","باستعمال الآلة الحاسبة"]],"a":"التباين <span class=\"tx\" data-t=\"\\sigma^2\\approx 1.47\"></span>","o":""},{"n":"6","s":[["\\sigma=\\sqrt{\\sigma^2}=\\sqrt{1.473}","الانحراف المعياري هو الجذر التربيعي للتباين"],["\\sigma\\approx 1.21","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 1.21\"></span>","o":""}],[{"n":"7","s":[["\\mu_y=\\frac{\\sum y}{n}=\\frac{-135}{50}=-2.7","الوسط الحسابي بعد التحويل"],["\\mu_y=\\mu_x-70","صيغة تحويل الوسط الحسابي"],["\\mu_x=-2.7+70=67.3","بجمع <span class=m dir=ltr>70</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"\\mu_x=67.3\"></span>","o":""},{"n":"8","s":[["\\sigma_y=\\sqrt{\\frac{\\sum y^2}{n}-\\mu_y^2}=\\sqrt{\\frac{2567}{50}-(-2.7)^2}","الصيغة الثانية للانحراف المعياري"],["\\sigma_y=\\sqrt{51.34-7.29}=\\sqrt{44.05}\\approx 6.637","باستعمال الآلة الحاسبة"],["\\sigma_y=|1|\\sigma_x\\Rightarrow\\sigma_x\\approx 6.637","صيغة تحويل الانحراف المعياري <span class=m dir=ltr>(a = 1)</span>"]],"a":"<span class=\"tx\" data-t=\"\\sigma_x\\approx 6.64\"></span>","o":""}],[{"n":"31","s":[["\\mu=\\frac{1425}{8}=178.125","الوسط الحسابي"],["\\sum x^2=254307","مجموع مربعات المشاهدات"],["\\sigma^2=\\frac{254307}{8}-(178.125)^2\\approx 59.86","الصيغة الثانية للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 59.86\\ \\text{cm}^2\"></span>","o":""},{"n":"32","s":[["\\sigma=\\sqrt{59.86}\\approx 7.74","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 7.74\\ \\text{cm}\"></span>","o":""}],[{"n":"1","s":[["\\sum f=200,\\ \\sum xf=6924","من الجدول"],["\\mu=\\frac{6924}{200}=34.62","الوسط الحسابي"],["\\sum x^2f=242344","مجموع <span class=m dir=ltr>x²f</span>"],["\\sigma^2=\\frac{242344}{200}-(34.62)^2=1211.72-1198.5444","الصيغة الثانية للتباين"],["\\sigma^2\\approx 13.18","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 13.18\"></span>","o":""},{"n":"2","s":[["\\sigma=\\sqrt{13.1756}\\approx 3.63","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 3.63\"></span> دقيقة","o":""}],[{"n":"3","s":[["y:\\ 2,\\ 20,\\ -15,\\ 52,\\ 87,\\ -9,\\ 17,\\ -15,\\ 42,\\ -1,\\ 64,\\ 7","بتطبيق <span class=m dir=ltr>y = 10x - 3300</span> على كل قيمة"],["\\sum y=251,\\ \\sum y^2=17407","المجموعان"],["\\mu_y=\\frac{251}{12}\\approx 20.917","الوسط الحسابي بعد التحويل"],["\\sigma_y=\\sqrt{\\frac{17407}{12}-(20.917)^2}\\approx 31.83","الصيغة الثانية للانحراف المعياري"]],"a":"<span class=\"tx\" data-t=\"\\sigma_y\\approx 31.83\"></span>","o":""},{"n":"4","s":[["\\sigma_y=|a|\\sigma_x\\Rightarrow 31.83=10\\sigma_x","صيغة تحويل الانحراف المعياري"],["\\sigma_x\\approx 3.183","بقسمة الطرفين على <span class=m dir=ltr>10</span>"],["\\sigma_x^2\\approx(3.183)^2\\approx 10.13","التباين مربع الانحراف المعياري"]],"a":"<span class=\"tx\" data-t=\"\\sigma_x^2\\approx 10.13\\ (\\text{cm}^3)^2\"></span>","o":""}],[{"n":"5","s":[["x:\\ 4,5,6,7,8,9,10,11,12","المدة (دقيقة)"],["f:\\ 1,4,16,9,7,4,4,3,2","التكرار، والمجموع <span class=m dir=ltr>50</span>"]],"a":"جدول تكراري: <span class=m dir=ltr>4</span>→<span class=m dir=ltr>1</span>، <span class=m dir=ltr>5</span>→<span class=m dir=ltr>4</span>، <span class=m dir=ltr>6</span>→<span class=m dir=ltr>16</span>، <span class=m dir=ltr>7</span>→<span class=m dir=ltr>9</span>، <span class=m dir=ltr>8</span>→<span class=m dir=ltr>7</span>، <span class=m dir=ltr>9</span>→<span class=m dir=ltr>4</span>، <span class=m dir=ltr>10</span>→<span class=m dir=ltr>4</span>، <span class=m dir=ltr>11</span>→<span class=m dir=ltr>3</span>، <span class=m dir=ltr>12</span>→<span class=m dir=ltr>2</span>","o":""},{"n":"6","s":[["\\mu=\\frac{\\sum xf}{\\sum f}=\\frac{372}{50}=7.44","الوسط الحسابي"],["\\sigma^2=\\frac{\\sum x^2f}{\\sum f}-\\mu^2=\\frac{2956}{50}-(7.44)^2","الصيغة الثانية للتباين"],["\\sigma^2=59.12-55.3536=3.7664","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 3.77\"></span>","o":""},{"n":"7","s":[["\\sigma=\\sqrt{3.7664}\\approx 1.94","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 1.94\"></span> دقيقة","o":""}],[{"n":"8","s":[["\\sum(x-\\mu)=0","مجموع انحرافات المشاهدات عن وسطها الحسابي يساوي صفرًا"],["2+3-4+(2b+1)+1-2+1-1=0","بالتعويض"],["2b+1=0\\Rightarrow b=-\\frac{1}{2}","بالحل"]],"a":"<span class=\"tx\" data-t=\"b=-0.5\"></span>","o":""},{"n":"9","s":[["\\text{deviations: }2,3,-4,0,1,-2,1,-1","بالتعويض <span class=m dir=ltr>b = -0.5</span>"],["\\sum(x-\\mu)^2=4+9+16+0+1+4+1+1=36","مجموع مربعات الانحرافات"],["\\sigma^2=\\frac{36}{8}=4.5","صيغة التباين"],["\\sigma=\\sqrt{4.5}\\approx 2.12","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2=4.5,\\ \\sigma\\approx 2.12\"></span>","o":""}],[{"n":"10","s":[["\\mu=\\frac{\\sum x}{n}=\\frac{208}{20}=10.4","الوسط الحسابي"],["\\sigma=\\sqrt{\\frac{\\sum x^2}{n}-\\mu^2}=\\sqrt{\\frac{2200}{20}-(10.4)^2}","الصيغة الثانية للانحراف المعياري"],["\\sigma=\\sqrt{110-108.16}=\\sqrt{1.84}\\approx 1.36","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 1.36\"></span>","o":""}],[{"n":"11","s":[["y=\\frac{x-3}{7}:\\ 7,10,4,10,5,11,2,3","بتحويل كل قيمة"],["\\mu_y=\\frac{52}{8}=6.5","الوسط الحسابي بعد التحويل"],["\\sigma_y=\\sqrt{\\frac{424}{8}-(6.5)^2}=\\sqrt{10.75}\\approx 3.28","الصيغة الثانية للانحراف المعياري"]],"a":"<span class=\"tx\" data-t=\"\\mu_y=6.5,\\ \\sigma_y\\approx 3.28\"></span>","o":""},{"n":"12","s":[["y=\\frac{1}{7}x-\\frac{3}{7}\\Rightarrow a=\\frac{1}{7}","معامل <span class=m dir=ltr>x</span> في علاقة التحويل"],["6.5=\\frac{\\mu_x-3}{7}\\Rightarrow\\mu_x=7(6.5)+3=48.5","صيغة تحويل الوسط الحسابي"],["\\sigma_y=\\frac{1}{7}\\sigma_x\\Rightarrow\\sigma_x=7\\sqrt{10.75}\\approx 22.95","صيغة تحويل الانحراف المعياري"]],"a":"<span class=\"tx\" data-t=\"\\mu_x=48.5,\\ \\sigma_x\\approx 22.95\"></span>","o":""}],[{"n":"13","s":[["\\mu_y=\\frac{124}{20}=6.2","الوسط الحسابي بعد التحويل"],["\\mu_y=\\mu_x-25\\Rightarrow\\mu_x=6.2+25=31.2","صيغة تحويل الوسط الحسابي"]],"a":"<span class=\"tx\" data-t=\"\\mu_x=31.2\"></span>","o":""},{"n":"14","s":[["\\sigma_y=\\sqrt{\\frac{3531}{20}-(6.2)^2}=\\sqrt{176.55-38.44}","الصيغة الثانية للانحراف المعياري"],["\\sigma_y=\\sqrt{138.11}\\approx 11.75","باستعمال الآلة الحاسبة"],["\\sigma_x=\\sigma_y\\approx 11.75","لأن <span class=m dir=ltr>a = 1</span>"]],"a":"<span class=\"tx\" data-t=\"\\sigma_x\\approx 11.75\"></span>","o":""}],[{"n":"15","s":[["\\sum x=n\\mu","من صيغة الوسط الحسابي"],["\\text{(A)}: 20\\times 14=280,\\quad\\text{(B)}: 15\\times 18=270","بالتعويض"]],"a":"مجموع علامات الشعبة (أ) <span class=\"tx\" data-t=\"=280\"></span>، والشعبة (ب) <span class=\"tx\" data-t=\"=270\"></span>","o":""},{"n":"16","s":[["\\sigma^2=\\frac{\\sum x^2}{n}-\\mu^2\\Rightarrow\\sum x^2=n(\\sigma^2+\\mu^2)","من الصيغة الثانية للتباين"],["\\text{(A)}: 20(10+196)=4120","الشعبة (أ)"],["\\text{(B)}: 15(6+324)=4950","الشعبة (ب)"]],"a":"<span class=\"tx\" data-t=\"4120\"></span> للشعبة (أ)، و<span class=\"tx\" data-t=\"4950\"></span> للشعبة (ب)","o":""},{"n":"17","s":[["\\mu=\\frac{280+270}{20+15}=\\frac{550}{35}\\approx 15.71","مجموع العلامات <span class=m dir=ltr>÷</span> عدد الطلبة"]],"a":"<span class=\"tx\" data-t=\"\\mu\\approx 15.71\"></span>","o":""},{"n":"18","s":[["\\sum x^2=4120+4950=9070,\\ n=35","للشعبتين معًا"],["\\sigma^2=\\frac{9070}{35}-\\left(\\frac{550}{35}\\right)^2\\approx 259.143-246.939","الصيغة الثانية للتباين"],["\\sigma^2\\approx 12.20","بالتبسيط"],["\\sigma=\\sqrt{12.20}\\approx 3.49","الجذر التربيعي للتباين"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2\\approx 12.20,\\ \\sigma\\approx 3.49\"></span>","o":""}]]