[[{"n":"1","s":[["f'(x)=e^{4x+2}\\cdot\\frac{d}{dx}(4x+2)","قاعدة السلسلة"],["f'(x)=4e^{4x+2}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=4e^{4x+2}\"></span>","o":""},{"n":"2","s":[["f'(x)=50e^{2x-10}\\cdot(2)","قاعدة السلسلة"],["f'(x)=100e^{2x-10}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=100e^{2x-10}\"></span>","o":""},{"n":"3","s":[["f'(x)=-\\sin(x^{2}-3x-4)\\cdot(2x-3)","قاعدة السلسلة: مشتقة <span class=\"tx\" data-t=\"\\cos u\"></span> هي <span class=\"tx\" data-t=\"-\\sin u\\cdot u&#x27;\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-(2x-3)\\sin(x^{2}-3x-4)\"></span>","o":""},{"n":"4","s":[["f'(x)=20x\\,e^{-x^{2}}+10x^{2}\\cdot e^{-x^{2}}(-2x)","مشتقة الضرب، وقاعدة السلسلة لـ <span class=\"tx\" data-t=\"e^{-x^{2}}\"></span>"],["=20xe^{-x^{2}}-20x^{3}e^{-x^{2}}=20xe^{-x^{2}}(1-x^{2})","بإخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=20x(1-x^{2})e^{-x^{2}}\"></span>","o":""},{"n":"5","s":[["f(x)=\\left(1+\\frac{1}{x}\\right)^{\\frac{1}{2}}","بتبسيط ما داخل الجذر"],["f'(x)=\\frac{1}{2}\\left(1+\\frac{1}{x}\\right)^{-\\frac{1}{2}}\\cdot\\left(-\\frac{1}{x^{2}}\\right)","قاعدة السلسلة (قوة اقتران)"],["=-\\frac{1}{2x^{2}\\sqrt{\\frac{x+1}{x}}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{1}{2x^{2}}\\sqrt{\\frac{x}{x+1}}\"></span>","o":""},{"n":"6","s":[["f'(x)=2x\\tan\\frac{1}{x}+x^{2}\\sec^{2}\\frac{1}{x}\\cdot\\left(-\\frac{1}{x^{2}}\\right)","مشتقة الضرب، وقاعدة السلسلة لـ <span class=\"tx\" data-t=\"\\tan\\frac{1}{x}\"></span>"],["=2x\\tan\\frac{1}{x}-\\sec^{2}\\frac{1}{x}","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=2x\\tan\\frac{1}{x}-\\sec^{2}\\frac{1}{x}\"></span>","o":""},{"n":"7","s":[["f(x)=3x-5\\cos(\\pi^{2}x^{2})","قراءة المقدار <span class=\"tx\" data-t=\"(\\pi x)^{2}\"></span> زاويةً لجيب التمام"],["f'(x)=3+5\\sin(\\pi^{2}x^{2})\\cdot(2\\pi^{2}x)","قاعدة السلسلة"],["=3+10\\pi^{2}x\\sin(\\pi^{2}x^{2})",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3+10\\pi^{2}x\\sin(\\pi^{2}x^{2})\"></span>","o":"إذا قُصِد بها <span class=\"tx\" data-t=\"\\cos^{2}(\\pi x)\"></span> فإنّ <span class=\"tx\" data-t=\"f&#x27;(x)=3+10\\pi\\sin(\\pi x)\\cos(\\pi x)=3+5\\pi\\sin(2\\pi x)\"></span>."},{"n":"8","s":[["f(x)=\\ln(1+e^{x})-\\ln(1-e^{x})","قانون القسمة في اللوغاريتمات"],["f'(x)=\\frac{e^{x}}{1+e^{x}}-\\frac{-e^{x}}{1-e^{x}}","مشتقة <span class=\"tx\" data-t=\"\\ln u\"></span> هي <span class=\"tx\" data-t=\"\\frac{u&#x27;}{u}\"></span>"],["=\\frac{e^{x}(1-e^{x})+e^{x}(1+e^{x})}{1-e^{2x}}=\\frac{2e^{x}}{1-e^{2x}}","بتوحيد المقامات"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2e^{x}}{1-e^{2x}}\"></span>","o":""},{"n":"9","s":[["f'(x)=4(\\ln x)^{3}\\cdot\\frac{1}{x}","قاعدة السلسلة (قوة اقتران)"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{4(\\ln x)^{3}}{x}\"></span>","o":""},{"n":"10","s":[["f(x)=\\sin\\left(x^{\\frac{1}{3}}\\right)+(\\sin x)^{\\frac{1}{3}}","بالصورة الأسّية"],["f'(x)=\\cos\\left(x^{\\frac{1}{3}}\\right)\\cdot\\frac{1}{3}x^{-\\frac{2}{3}}+\\frac{1}{3}(\\sin x)^{-\\frac{2}{3}}\\cos x","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{\\cos\\sqrt[3]{x}}{3\\sqrt[3]{x^{2}}}+\\frac{\\cos x}{3\\sqrt[3]{\\sin^{2}x}}\"></span>","o":""},{"n":"11","s":[["f(x)=(x^{2}+8x)^{\\frac{1}{5}}","بالصورة الأسّية"],["f'(x)=\\frac{1}{5}(x^{2}+8x)^{-\\frac{4}{5}}(2x+8)","قاعدة السلسلة (قوة اقتران)"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2x+8}{5\\sqrt[5]{(x^{2}+8x)^{4}}}\"></span>","o":""},{"n":"12","s":[["\\frac{d}{dx}\\left(3^{2x}\\right)=3^{2x}\\ln 3\\cdot2","مشتقة <span class=\"tx\" data-t=\"a^{u}\"></span> هي <span class=\"tx\" data-t=\"a^{u}\\ln a\\cdot u&#x27;\"></span>"],["f'(x)=\\frac{x\\cdot2\\ln3\\cdot3^{2x}-3^{2x}(1)}{x^{2}}","مشتقة القسمة"],["=\\frac{3^{2x}(2x\\ln3-1)}{x^{2}}","بإخراج <span class=\"tx\" data-t=\"3^{2x}\"></span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{3^{2x}(2x\\ln 3-1)}{x^{2}}\"></span>","o":""},{"n":"13","s":[["f'(x)=\\left(-2^{-x}\\ln2\\right)\\cos\\pi x+2^{-x}(-\\pi\\sin\\pi x)","مشتقة الضرب وقاعدة السلسلة"],["=-2^{-x}(\\ln2\\cos\\pi x+\\pi\\sin\\pi x)","بإخراج <span class=\"tx\" data-t=\"-2^{-x}\"></span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-2^{-x}(\\ln 2\\cos\\pi x+\\pi\\sin\\pi x)\"></span>","o":""},{"n":"14","s":[["f(x)=\\frac{10}{\\ln4}\\cdot\\frac{\\ln x}{x}","تغيير الأساس: <span class=\"tx\" data-t=\"\\log_{4}x=\\frac{\\ln x}{\\ln 4}\"></span>"],["f'(x)=\\frac{10}{\\ln4}\\cdot\\frac{x\\cdot\\frac{1}{x}-\\ln x}{x^{2}}","مشتقة القسمة"],["=\\frac{10(1-\\ln x)}{x^{2}\\ln4}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{10(1-\\ln x)}{x^{2}\\ln 4}\"></span>","o":""},{"n":"15","s":[["u=\\frac{\\sin x}{1+\\cos x}\\Rightarrow u'=\\frac{\\cos x(1+\\cos x)+\\sin^{2}x}{(1+\\cos x)^{2}}=\\frac{1+\\cos x}{(1+\\cos x)^{2}}=\\frac{1}{1+\\cos x}","مشتقة القسمة و <span class=\"tx\" data-t=\"\\sin^{2}x+\\cos^{2}x=1\"></span>"],["f'(x)=2u\\cdot u'=2\\cdot\\frac{\\sin x}{1+\\cos x}\\cdot\\frac{1}{1+\\cos x}","قاعدة السلسلة (قوة اقتران)"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2\\sin x}{(1+\\cos x)^{2}}\"></span>","o":""},{"n":"16","s":[["\\frac{d}{dx}\\log_{3}u=\\frac{u'}{u\\ln3}","مشتقة اللوغاريتم للأساس <span class=m dir=ltr>3</span>"],["u=1+x\\ln x\\Rightarrow u'=\\ln x+1","مشتقة الضرب"],["f'(x)=\\frac{\\ln x+1}{(1+x\\ln x)\\ln3}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1+\\ln x}{(1+x\\ln x)\\ln 3}\"></span>","o":""},{"n":"17","s":[["\\frac{d}{dx}e^{\\sin2x}=e^{\\sin2x}\\cdot2\\cos2x","قاعدة السلسلة"],["\\frac{d}{dx}\\sin(e^{2x})=\\cos(e^{2x})\\cdot2e^{2x}","قاعدة السلسلة"],["f'(x)=2\\cos2x\\,e^{\\sin2x}+2e^{2x}\\cos(e^{2x})","بالجمع"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=2\\cos 2x\\,e^{\\sin 2x}+2e^{2x}\\cos(e^{2x})\"></span>","o":""},{"n":"18","s":[["f'(x)=4\\tan^{3}(\\sec(\\cos x))\\cdot\\frac{d}{dx}\\tan(\\sec(\\cos x))","قاعدة السلسلة (قوة اقتران)"],["=4\\tan^{3}(\\sec(\\cos x))\\sec^{2}(\\sec(\\cos x))\\cdot\\frac{d}{dx}\\sec(\\cos x)","مشتقة <span class=\"tx\" data-t=\"\\tan u\"></span>"],["=4\\tan^{3}(\\sec(\\cos x))\\sec^{2}(\\sec(\\cos x))\\sec(\\cos x)\\tan(\\cos x)\\cdot(-\\sin x)","مشتقة <span class=\"tx\" data-t=\"\\sec u\"></span> ثم مشتقة <span class=\"tx\" data-t=\"\\cos x\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-4\\sin x\\,\\tan^{3}(\\sec(\\cos x))\\,\\sec^{2}(\\sec(\\cos x))\\,\\sec(\\cos x)\\tan(\\cos x)\"></span>","o":""}],[{"n":"19","s":[["f(-2)=4e^{-0.5(4)}=4e^{-2}","إحداثي <span class=\"tx\" data-t=\"y\"></span> للنقطة"],["f'(x)=4e^{-0.5x^{2}}\\cdot(-x)=-4xe^{-0.5x^{2}}","قاعدة السلسلة"],["f'(-2)=8e^{-2}","الميل"],["y-4e^{-2}=8e^{-2}(x+2)\\Rightarrow y=8e^{-2}x+20e^{-2}","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=8e^{-2}x+20e^{-2}\\approx1.083x+2.707\"></span>","o":""},{"n":"20","s":[["f(0)=0+\\cos0=1","النقطة <span class=\"tx\" data-t=\"(0,1)\"></span>"],["f'(x)=1-2\\sin2x\\Rightarrow f'(0)=1","الميل"],["y-1=1(x-0)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=x+1\"></span>","o":""},{"n":"21","s":[["f(0)=2^{0}=1","النقطة <span class=\"tx\" data-t=\"(0,1)\"></span>"],["f'(x)=2^{x}\\ln2\\Rightarrow f'(0)=\\ln2","الميل"],["y-1=\\ln2\\,(x-0)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=(\\ln 2)x+1\"></span>","o":""},{"n":"22","s":[["f(3)=\\sqrt{4}\\sin\\frac{3\\pi}{2}=2(-1)=-2","النقطة <span class=\"tx\" data-t=\"(3,-2)\"></span>"],["f'(x)=\\frac{1}{2\\sqrt{x+1}}\\sin\\frac{\\pi x}{2}+\\sqrt{x+1}\\cdot\\frac{\\pi}{2}\\cos\\frac{\\pi x}{2}","مشتقة الضرب وقاعدة السلسلة"],["f'(3)=\\frac{1}{4}(-1)+2\\cdot\\frac{\\pi}{2}(0)=-\\frac{1}{4}","الميل"],["y+2=-\\frac{1}{4}(x-3)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{1}{4}x-\\frac{5}{4}\"></span>","o":""}],[{"n":"23","s":[["A'(x)=f'(g(x))\\cdot g'(x)","قاعدة السلسلة"],["A'(5)=f'(g(5))\\cdot g'(5)=f'(-2)\\cdot6","بالتعويض <span class=\"tx\" data-t=\"g(5)=-2\"></span>"],["=4\\times6=24",""]],"a":"<span class=\"tx\" data-t=\"A&#x27;(5)=24\"></span>","o":""}],[{"n":"24","s":[["f'(x)=\\frac{\\sqrt{x^{2}+1}-x\\cdot\\frac{2x}{2\\sqrt{x^{2}+1}}}{x^{2}+1}","مشتقة القسمة وقاعدة السلسلة"],["=\\frac{\\frac{(x^{2}+1)-x^{2}}{\\sqrt{x^{2}+1}}}{x^{2}+1}","بتوحيد المقامات في البسط"],["=\\frac{1}{(x^{2}+1)\\sqrt{x^{2}+1}}=\\frac{1}{\\sqrt{(x^{2}+1)^{3}}}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1}{\\sqrt{(x^{2}+1)^{3}}}\"></span> ✓","o":""}],[{"n":"25","s":[["A'(t)=Ne^{0.1t}\\cdot0.1=0.1Ne^{0.1t}","قاعدة السلسلة"],["A'(3)=0.1Ne^{0.3}\\approx0.135N","بالتعويض <span class=\"tx\" data-t=\"t=3\"></span>"]],"a":"<span class=\"tx\" data-t=\"A&#x27;(3)=0.1Ne^{0.3}\\approx0.135N\"></span> خلية لكل ساعة","o":""},{"n":"26","s":[["0.1Ne^{0.1k}=0.2","معدّل النمو بعد <span class=\"tx\" data-t=\"k\"></span> ساعة"],["e^{0.1k}=\\frac{2}{N}","بقسمة الطرفين على <span class=\"tx\" data-t=\"0.1N\"></span>"],["0.1k=\\ln\\frac{2}{N}\\Rightarrow k=10\\ln\\frac{2}{N}","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"k=10\\ln\\frac{2}{N}\"></span>","o":""}],[{"n":"27","s":[["f'(x)=\\pi\\cos\\pi x","قاعدة السلسلة"],["f''(x)=-\\pi^{2}\\sin\\pi x",""],["f'''(x)=-\\pi^{3}\\cos\\pi x",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;&#x27;(x)=-\\pi^{3}\\cos\\pi x\"></span>","o":""},{"n":"28","s":[["f'(x)=-2\\sin(2x+1),\\quad f''(x)=-4\\cos(2x+1)","قاعدة السلسلة"],["f'''(x)=8\\sin(2x+1),\\quad f^{(4)}(x)=16\\cos(2x+1)",""],["f^{(5)}(x)=-32\\sin(2x+1)",""]],"a":"<span class=\"tx\" data-t=\"f^{(5)}(x)=-32\\sin(2x+1)\"></span>","o":""},{"n":"29","s":[["f'(x)=-\\sin x^{2}\\cdot2x=-2x\\sin x^{2}","قاعدة السلسلة"],["f''(x)=-2\\sin x^{2}-2x\\cos x^{2}\\cdot2x","مشتقة الضرب وقاعدة السلسلة"],["f''(x)=-2\\sin x^{2}-4x^{2}\\cos x^{2}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=-2\\sin x^{2}-4x^{2}\\cos x^{2}\"></span>","o":""}],[{"n":"30","s":[["\\frac{dy}{dx}=e^{\\sin x}\\cdot\\cos x","قاعدة السلسلة"],["\\left.\\frac{dy}{dx}\\right|_{x=0}=e^{0}\\cos0=1","بالتعويض <span class=\"tx\" data-t=\"x=0\"></span>"]],"a":"ميل المماس عند <span class=\"tx\" data-t=\"(0,1)\"></span> يساوي <span class=\"tx\" data-t=\"1\"></span>","o":""}],[{"n":"31","s":[["A'(t)=20\\left(\\frac{1}{2}\\right)^{\\frac{t}{140}}\\ln\\frac{1}{2}\\cdot\\frac{1}{140}","مشتقة <span class=\"tx\" data-t=\"a^{u}\"></span> وقاعدة السلسلة"],["=-\\frac{\\ln2}{7}\\left(\\frac{1}{2}\\right)^{\\frac{t}{140}}","<span class=\"tx\" data-t=\"\\ln\\frac{1}{2}=-\\ln 2\"></span>"],["A'(2)=-\\frac{\\ln2}{7}\\left(\\frac{1}{2}\\right)^{\\frac{1}{70}}\\approx-0.098","بالتعويض <span class=\"tx\" data-t=\"t=2\"></span>"]],"a":"<span class=\"tx\" data-t=\"A&#x27;(2)\\approx-0.098\\ \\text{g/day}\"></span>، أي أنّ البلوتونيوم يتحلّل بمعدّل نحو <span class=\"tx\" data-t=\"0.098\"></span> غرام يوميًّا","o":""}],[{"n":"32","s":[["s(t)=(3+t-t^{2})^{\\frac{3}{2}}","بالصورة الأسّية"],["v(t)=\\frac{3}{2}(3+t-t^{2})^{\\frac{1}{2}}(1-2t)","قاعدة السلسلة"],["a(t)=\\frac{3}{4}(3+t-t^{2})^{-\\frac{1}{2}}(1-2t)^{2}-3(3+t-t^{2})^{\\frac{1}{2}}","مشتقة الضرب وقاعدة السلسلة"],["a(t)=\\frac{3(1-2t)^{2}-12(3+t-t^{2})}{4\\sqrt{3+t-t^{2}}}=\\frac{24t^{2}-24t-33}{4\\sqrt{3+t-t^{2}}}","بتوحيد المقامات"]],"a":"<span class=\"tx\" data-t=\"v(t)=\\frac{3}{2}(1-2t)\\sqrt{3+t-t^{2}}\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(t)=\\frac{24t^{2}-24t-33}{4\\sqrt{3+t-t^{2}}}\\ \\text{m/s}^2\"></span>","o":""},{"n":"33","s":[["s(0)=\\sqrt{3^{3}}=\\sqrt{27}=3\\sqrt{3}","بالتعويض <span class=\"tx\" data-t=\"t=0\"></span>"]],"a":"الموقع الابتدائي <span class=\"tx\" data-t=\"3\\sqrt{3}\\approx5.20\\ \\text{m}\"></span>","o":""},{"n":"34","s":[["v(1)=\\frac{3}{2}\\sqrt{3+1-1}\\,(1-2)=-\\frac{3\\sqrt{3}}{2}","بالتعويض <span class=\"tx\" data-t=\"t=1\"></span>"],["v(1)<0","السرعة سالبة"]],"a":"عند <span class=\"tx\" data-t=\"t=1\"></span> يتحرّك الجسم في الاتجاه السالب (نحو اليسار)؛ لأنّ <span class=\"tx\" data-t=\"v(1)=-\\frac{3\\sqrt{3}}{2}&lt;0\"></span>","o":""}],[{"n":"35","s":[["P'(t)=20\\cos(2\\pi t)\\cdot2\\pi","قاعدة السلسلة"],["P'(t)=40\\pi\\cos2\\pi t",""]],"a":"<span class=\"tx\" data-t=\"P&#x27;(t)=40\\pi\\cos 2\\pi t\"></span> ملّيمتر زئبق لكل ثانية","o":""}],[{"n":"36","s":[["N=10000\\left(1-e^{-0.15d}\\right)","<span class=\"tx\" data-t=\"P=10000\"></span>"],["\\frac{dN}{dd}=10000\\left(0-e^{-0.15d}\\cdot(-0.15)\\right)","قاعدة السلسلة"],["=1500e^{-0.15d}",""]],"a":"<span class=\"tx\" data-t=\"N&#x27;(d)=1500e^{-0.15d}\"></span> شخص لكل يوم","o":""}],[{"n":"37","s":[["x=1+2=3,\\quad y=1-1=0","النقطة <span class=\"tx\" data-t=\"(3,0)\"></span>"],["\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}=\\frac{2t}{1}=2","مشتقة المعادلات الوسيطية عند <span class=\"tx\" data-t=\"t=1\"></span>"],["y-0=2(x-3)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=2x-6\"></span>","o":""},{"n":"38","s":[["x=-\\frac{1}{2},\\quad y=1-4=-3","النقطة <span class=\"tx\" data-t=\"\\left(-\\frac{1}{2},-3\\right)\"></span>"],["\\frac{dy}{dx}=\\frac{2t}{\\frac{1}{2}}=4t=-4","عند <span class=\"tx\" data-t=\"t=-1\"></span>"],["y+3=-4\\left(x+\\frac{1}{2}\\right)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=-4x-5\"></span>","o":""},{"n":"39","s":[["x=\\frac{\\pi}{3}-\\frac{\\sqrt{3}}{2},\\quad y=1-\\frac{1}{2}=\\frac{1}{2}","النقطة عند <span class=\"tx\" data-t=\"t=\\frac{\\pi}{3}\"></span>"],["\\frac{dy}{dx}=\\frac{\\sin t}{1-\\cos t}=\\frac{\\frac{\\sqrt{3}}{2}}{\\frac{1}{2}}=\\sqrt{3}","مشتقة المعادلات الوسيطية"],["y-\\frac{1}{2}=\\sqrt{3}\\left(x-\\frac{\\pi}{3}+\\frac{\\sqrt{3}}{2}\\right)","صيغة الميل ونقطة"],["y=\\sqrt{3}x-\\frac{\\sqrt{3}\\pi}{3}+2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt{3}x+2-\\frac{\\sqrt{3}\\pi}{3}\"></span>","o":""},{"n":"40","s":[["x=\\sec^{2}\\left(-\\frac{\\pi}{4}\\right)-1=2-1=1,\\quad y=\\tan\\left(-\\frac{\\pi}{4}\\right)=-1","النقطة <span class=\"tx\" data-t=\"(1,-1)\"></span>"],["\\frac{dx}{dt}=2\\sec^{2}t\\tan t=2(2)(-1)=-4,\\quad\\frac{dy}{dt}=\\sec^{2}t=2","عند <span class=\"tx\" data-t=\"t=-\\frac{\\pi}{4}\"></span>"],["\\frac{dy}{dx}=\\frac{2}{-4}=-\\frac{1}{2}",""],["y+1=-\\frac{1}{2}(x-1)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{1}{2}x-\\frac{1}{2}\"></span>","o":""}],[{"n":"41","s":[["D'(t)=0+400\\cos(0.4t)\\cdot0.4","قاعدة السلسلة"],["D'(t)=160\\cos0.4t",""]],"a":"<span class=\"tx\" data-t=\"D&#x27;(t)=160\\cos 0.4t\"></span> غزال لكل سنة","o":""}],[{"n":"42","s":[["\\frac{dx}{dt}=2(1-\\cos t),\\quad\\frac{dy}{dt}=2\\sin t","باشتقاق كل معادلة"],["\\frac{dy}{dx}=\\frac{\\sin t}{1-\\cos t}","مشتقة المعادلات الوسيطية"],["t=\\frac{\\pi}{4}:\\ \\frac{dy}{dx}=\\frac{\\frac{\\sqrt{2}}{2}}{1-\\frac{\\sqrt{2}}{2}}=\\frac{\\sqrt{2}}{2-\\sqrt{2}}=\\frac{\\sqrt{2}(2+\\sqrt{2})}{2}=\\sqrt{2}+1","بالتعويض وإنطاق المقام"],["m_{\\text{normal}}=-\\frac{1}{1+\\sqrt{2}}=-\\frac{\\sqrt{2}-1}{(\\sqrt{2}+1)(\\sqrt{2}-1)}=1-\\sqrt{2}","ميل العمودي"]],"a":"ميل المماس <span class=\"tx\" data-t=\"1+\\sqrt{2}\"></span>، وميل العمودي <span class=\"tx\" data-t=\"1-\\sqrt{2}\"></span> ✓","o":""}],[{"n":"43","s":[["h'(1)=f'(g(1))\\cdot g'(1)","قاعدة السلسلة"],["g(1)=4,\\quad g'(1)=-1","من الشكل: <span class=\"tx\" data-t=\"g\"></span> مستقيم بين <span class=\"tx\" data-t=\"(0,5)\"></span> و<span class=\"tx\" data-t=\"(3,2)\"></span>"],["f'(4)=-\\frac{1}{3}","من الشكل: <span class=\"tx\" data-t=\"f\"></span> مستقيم بين <span class=\"tx\" data-t=\"(2,4)\"></span> و<span class=\"tx\" data-t=\"(5,3)\"></span>"],["h'(1)=\\left(-\\frac{1}{3}\\right)(-1)=\\frac{1}{3}",""]],"a":"<span class=\"tx\" data-t=\"h&#x27;(1)=\\frac{1}{3}\"></span>","o":""},{"n":"44","s":[["p'(1)=g'(f(1))\\cdot f'(1)","قاعدة السلسلة"],["f(1)=2,\\quad f'(1)=2","من الشكل: <span class=\"tx\" data-t=\"f\"></span> مستقيم بين <span class=\"tx\" data-t=\"(0,0)\"></span> و<span class=\"tx\" data-t=\"(2,4)\"></span>"],["g'(2)=-1","ميل <span class=\"tx\" data-t=\"g\"></span> بين <span class=\"tx\" data-t=\"(0,5)\"></span> و<span class=\"tx\" data-t=\"(3,2)\"></span>"],["p'(1)=(-1)(2)=-2",""]],"a":"<span class=\"tx\" data-t=\"p&#x27;(1)=-2\"></span>","o":""}],[{"n":"45","s":[["y'=\\frac{a}{ax+b}","قاعدة السلسلة"],["\\frac{a}{ax+b}=1\\Rightarrow ax+b=a","الميل عند <span class=\"tx\" data-t=\"P\"></span> يساوي <span class=m dir=ltr>1</span>"],["x=\\frac{a-b}{a}=1-\\frac{b}{a}","بحل المعادلة"],["\\frac{b}{a}>0\\Rightarrow x<1","لأنّ <span class=\"tx\" data-t=\"a,b\"></span> موجبان"]],"a":"الإحداثي <span class=\"tx\" data-t=\"x\"></span> للنقطة <span class=\"tx\" data-t=\"P\"></span> هو <span class=\"tx\" data-t=\"1-\\frac{b}{a}&lt;1\"></span> ✓","o":""},{"n":"46","s":[["2=\\ln(a\\cdot0+b)=\\ln b\\Rightarrow b=e^{2}","النقطة <span class=\"tx\" data-t=\"(0,2)\"></span> تقع على المنحنى"],["y'(0)=\\frac{a}{b}=1\\Rightarrow a=b","الميل عند <span class=\"tx\" data-t=\"P\"></span> يساوي <span class=m dir=ltr>1</span>"],["a=e^{2}",""]],"a":"<span class=\"tx\" data-t=\"a=e^{2},\\ b=e^{2}\"></span>","o":"التبرير: النقطة تحقق معادلة الاقتران فنجد <span class=\"tx\" data-t=\"b\"></span>، والميل عندها <span class=m dir=ltr>1</span> فنجد <span class=\"tx\" data-t=\"a\"></span>."},{"n":"47","s":[["y=\\ln(e^{2}x+e^{2})=2+\\ln(x+1)","بالتعويض وقوانين اللوغاريتمات"],["y'=\\frac{1}{x+1}=\\frac{1}{2}","الميل المطلوب"],["x+1=2\\Rightarrow x=1","بالضرب التبادلي"],["y=2+\\ln2","بالتعويض"]],"a":"النقطة <span class=\"tx\" data-t=\"(1,\\ 2+\\ln 2)\\approx(1,\\ 2.69)\"></span>","o":""}],[{"n":"48","s":[["\\frac{dx}{dt}=2t,\\quad\\frac{dy}{dt}=2","باشتقاق كل معادلة"],["\\frac{dy}{dx}=\\frac{2}{2t}=\\frac{1}{t}","مشتقة المعادلات الوسيطية"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{1}{t}\"></span>","o":""},{"n":"49","s":[["t=a","النقطة <span class=\"tx\" data-t=\"(a^{2},2a)\"></span> تقابل <span class=\"tx\" data-t=\"t=a\"></span>"],["m_{\\text{tangent}}=\\frac{1}{a}\\Rightarrow m_{\\text{normal}}=-a","ميل العمودي"],["y-2a=-a(x-a^{2})","صيغة الميل ونقطة"],["y=-ax+a^{3}+2a",""]],"a":"<span class=\"tx\" data-t=\"y=-ax+a^{3}+2a\"></span>","o":""},{"n":"50","s":[["x=0\\Rightarrow y=a^{3}+2a=a(a^{2}+2)","المقطع <span class=\"tx\" data-t=\"y\"></span> للعمودي"],["y=0\\Rightarrow x=\\frac{a^{3}+2a}{a}=a^{2}+2","المقطع <span class=\"tx\" data-t=\"x\"></span> للعمودي (<span class=\"tx\" data-t=\"a\\ne0\"></span>)"],["\\text{Area}=\\frac{1}{2}\\,|a^{2}+2|\\,|a(a^{2}+2)|","مساحة المثلث القائم <span class=\"tx\" data-t=\"=\\frac{1}{2}\\times\"></span> القاعدة <span class=\"tx\" data-t=\"\\times\"></span> الارتفاع"],["=\\frac{1}{2}|a|(2+a^{2})^{2}","لأنّ <span class=\"tx\" data-t=\"a^{2}+2&gt;0\"></span>"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{1}{2}|a|(2+a^{2})^{2}\"></span> ✓","o":""}],[{"n":"51","s":[["y=\\left(\\sin x^{\\frac{1}{2}}\\right)^{\\frac{1}{2}}","بالصورة الأسّية"],["\\frac{dy}{dx}=\\frac{1}{2}\\left(\\sin\\sqrt{x}\\right)^{-\\frac{1}{2}}\\cdot\\cos\\sqrt{x}\\cdot\\frac{1}{2\\sqrt{x}}","قاعدة السلسلة مرّتين"],["=\\frac{\\cos\\sqrt{x}}{4\\sqrt{x}\\sqrt{\\sin\\sqrt{x}}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{\\cos\\sqrt{x}}{4\\sqrt{x}\\,\\sqrt{\\sin\\sqrt{x}}}\"></span>","o":""},{"n":"52","s":[["\\frac{dy}{dx}=e^{x}\\sin^{2}x\\cos x+e^{x}(2\\sin x\\cos x)\\cos x+e^{x}\\sin^{2}x(-\\sin x)","مشتقة ضرب ثلاثة اقترانات، وقاعدة السلسلة لـ <span class=\"tx\" data-t=\"\\sin^{2}x\"></span>"],["=e^{x}\\sin x\\left(\\sin x\\cos x+2\\cos^{2}x-\\sin^{2}x\\right)","بإخراج <span class=\"tx\" data-t=\"e^{x}\\sin x\"></span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=e^{x}\\sin x\\left(\\sin x\\cos x+2\\cos^{2}x-\\sin^{2}x\\right)\"></span>","o":""}],[{"n":"53","s":[["\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}=\\frac{3\\cos 3t}{2\\cos 2t}","مشتقة المعادلة الوسيطية"],["3\\cos 3t=0","المماس أفقي عندما يكون البسط صفرًا"],["3t=\\frac{\\pi}{2}\\Rightarrow t=\\frac{\\pi}{6}","القيمة التي تعطي نقطة في الربع الأول"],["x=\\sin\\frac{\\pi}{3}=\\frac{\\sqrt{3}}{2},\\ y=\\sin\\frac{\\pi}{2}=1","بالتعويض في المعادلة الوسيطية"]],"a":"<span class=\"tx\" data-t=\"A\\left(\\frac{\\sqrt{3}}{2},\\,1\\right)\"></span>","o":""},{"n":"54","s":[["2\\cos 2t=0","المماس رأسي (موازٍ للمحور <span class=m dir=ltr>y)</span> عندما يكون المقام صفرًا"],["2t=\\frac{\\pi}{2}\\Rightarrow t=\\frac{\\pi}{4}","القيمة التي تعطي النقطة <span class=m dir=ltr>B</span> في الربع الأول"],["x=\\sin\\frac{\\pi}{2}=1,\\ y=\\sin\\frac{3\\pi}{4}=\\frac{\\sqrt{2}}{2}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"B\\left(1,\\,\\frac{\\sqrt{2}}{2}\\right)\"></span>","o":""},{"n":"55","s":[["\\sin 2t=0,\\ \\sin 3t=0","عند نقطة الأصل <span class=m dir=ltr>x = 0</span> و <span class=m dir=ltr>y = 0</span>"],["t=0,\\ \\pi,\\ 2\\pi","قيم <span class=m dir=ltr>t</span> المشتركة في الفترة"],["t=0:\\ \\frac{dy}{dx}=\\frac{3\\cos 0}{2\\cos 0}=\\frac{3}{2}",""],["t=\\pi:\\ \\frac{dy}{dx}=\\frac{3\\cos 3\\pi}{2\\cos 2\\pi}=\\frac{-3}{2}",""]],"a":"ميلا المماسين عند نقطة الأصل: <span class=\"tx\" data-t=\"\\frac{3}{2}\"></span> و <span class=\"tx\" data-t=\"-\\frac{3}{2}\"></span>","o":"<span class=m dir=ltr>t = 2π</span> تعطي الفرع نفسه الذي تعطيه <span class=m dir=ltr>t = 0</span>"}],[{"n":"56","s":[["v(t)=s'(t)=\\frac{2t-2}{t^2-2t+1.9}","مشتقة اقتران اللوغاريتم الطبيعي مع قاعدة السلسلة"],["a(t)=\\frac{2(t^2-2t+1.9)-(2t-2)(2t-2)}{(t^2-2t+1.9)^2}","مشتقة القسمة"],["a(t)=\\frac{-2t^2+4t-0.2}{(t^2-2t+1.9)^2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"v(t)=\\frac{2t-2}{t^2-2t+1.9}\\ \\text{m/s}\"></span> ، <span class=\"tx\" data-t=\"a(t)=\\frac{-2t^2+4t-0.2}{(t^2-2t+1.9)^2}\\ \\text{m/s}^2\"></span>","o":""},{"n":"57","s":[["2t-2=0\\Rightarrow t=1","السرعة صفر"],["s(1)=\\ln(1-2+1.9)=\\ln 0.9\\approx -0.1054","الموقع"],["a(1)=\\frac{-2+4-0.2}{(0.9)^2}=\\frac{1.8}{0.81}=\\frac{20}{9}\\approx 2.22","التسارع"]],"a":"الموقع <span class=\"tx\" data-t=\"\\ln 0.9\\approx -0.105\\ \\text{m}\"></span> ، والتسارع <span class=\"tx\" data-t=\"\\frac{20}{9}\\approx 2.22\\ \\text{m/s}^2\"></span>","o":""},{"n":"58","s":[["s(0)=\\ln 1.9","الموقع الابتدائي"],["\\ln(t^2-2t+1.9)=\\ln 1.9\\Rightarrow t^2-2t=0","بمساواة الموقع بالموقع الابتدائي"],["t(t-2)=0\\Rightarrow t=0\\ \\text{or}\\ t=2","خاصية الضرب الصفري"]],"a":"يعود الجسيم إلى موقعه الابتدائي بعد <span class=\"tx\" data-t=\"t=2\"></span> ثانية","o":""}],[{"n":"4","s":[["\\frac{dy}{dt}=\\sec^2(4t)\\cdot4","قاعدة السلسلة"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"4\\sec^2(4t)\"></span>","o":""}],[{"n":"6","s":[["f'(x)=\\frac{1}{(2x-3)\\ln10}\\cdot2","مشتقة اللوغاريتم للأساس <span class=m dir=ltr>10</span> مع قاعدة السلسلة"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"\\frac{2}{(2x-3)\\ln 10}\"></span>","o":""}],[{"n":"7","s":[["\\frac{dy}{dx}=2^{1-x}\\ln2\\cdot(-1)",""],["x=2:\\ -2^{-1}\\ln2=-\\frac{\\ln2}{2}",""]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"-\\frac{\\ln 2}{2}\"></span>","o":""}],[{"n":"15","s":[["f'(x)=10\\cos(0.5x)\\cdot0.5","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=5\\cos 0.5x\"></span>","o":""},{"n":"16","s":[["u=\\left(\\tfrac1x+\\tfrac1{x^2}\\right)^3,\\ u'=3\\left(\\tfrac1x+\\tfrac1{x^2}\\right)^2\\left(-\\tfrac1{x^2}-\\tfrac2{x^3}\\right)","قاعدة السلسلة"],["v=\\left(x+\\tfrac1x\\right)^2,\\ v'=2\\left(x+\\tfrac1x\\right)\\left(1-\\tfrac1{x^2}\\right)",""],["f'(x)=u'v+uv'","مشتقة الضرب"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3\\left(\\frac1x+\\frac1{x^2}\\right)^2\\left(-\\frac1{x^2}-\\frac2{x^3}\\right)\\left(x+\\frac1x\\right)^2+2\\left(\\frac1x+\\frac1{x^2}\\right)^3\\left(x+\\frac1x\\right)\\left(1-\\frac1{x^2}\\right)\"></span>","o":""},{"n":"17","s":[["f'(x)=-1.5e^{-1.5x}\\cos x^2+e^{-1.5x}\\left(-\\sin x^2\\cdot2x\\right)","مشتقة الضرب وقاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-e^{-1.5x}\\left(1.5\\cos x^2+2x\\sin x^2\\right)\"></span>","o":""}],[{"n":"25","s":[["x=16,\\ y=6","عند <span class=m dir=ltr>t = 4</span>"],["\\frac{dy}{dx}=\\frac{1}{2t}=\\frac18",""],["y-6=\\frac18(x-16)\\Rightarrow y=\\frac18x+4",""]],"a":"<span class=\"tx\" data-t=\"y=\\frac{1}{8}x+4\"></span>","o":""},{"n":"26","s":[["x=4\\cdot\\frac{\\sqrt2}{2}=2\\sqrt2,\\ y=\\frac{3\\sqrt2}{2}","عند <span class=m dir=ltr>t = π/4</span>"],["\\frac{dy}{dx}=\\frac{3\\cos t}{-4\\sin t}=-\\frac34",""],["y-\\frac{3\\sqrt2}{2}=-\\frac34(x-2\\sqrt2)\\Rightarrow y=-\\frac34x+3\\sqrt2",""]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{3}{4}x+3\\sqrt{2}\"></span>","o":""}],[{"n":"1","s":[["f'(x)=100e^{-0.1x}\\cdot(-0.1)=-10e^{-0.1x}","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-10e^{-0.1x}\"></span>","o":""},{"n":"2","s":[["f'(x)=\\cos(x^{2}+1)\\cdot 2x","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=2x\\cos(x^{2}+1)\"></span>","o":""},{"n":"3","s":[["f'(x)=2\\cos x\\cdot(-\\sin x)","قاعدة القوة مع السلسلة"],["f'(x)=-2\\sin x\\cos x=-\\sin 2x","متطابقة ضعف الزاوية"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\sin 2x\"></span>","o":""},{"n":"4","s":[["f'(x)=-\\sin 2x\\cdot 2-2(-\\sin x)","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-2\\sin 2x+2\\sin x\"></span>","o":""},{"n":"5","s":[["f(x)=\\log_{3}x+\\frac{1}{2}\\log_{3}(x-1)-\\log_{3}2","قوانين اللوغاريتمات"],["f'(x)=\\frac{1}{x\\ln 3}+\\frac{1}{2(x-1)\\ln 3}","مشتقة <span class=m dir=ltr>log_b u</span> هي <span class=m dir=ltr>u&#x27;/(u ln b)</span>"],["f'(x)=\\frac{3x-2}{2x(x-1)\\ln 3}","بتوحيد المقامات"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{3x-2}{2x(x-1)\\ln 3}\"></span>","o":""},{"n":"6","s":[["f'(x)=4\\cot(\\pi x+2)\\cdot\\left(-\\csc^{2}(\\pi x+2)\\right)\\cdot\\pi","قاعدة السلسلة مرتين"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-4\\pi\\cot(\\pi x+2)\\csc^{2}(\\pi x+2)\"></span>","o":""},{"n":"7","s":[["f'(x)=\\frac{2}{2x\\ln 10}=\\frac{1}{x\\ln 10}","مشتقة <span class=m dir=ltr>log u = u&#x27;/(u ln 10)</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1}{x\\ln 10}\"></span>","o":""},{"n":"8","s":[["f'(x)=\\frac{3x^{2}}{x^{3}+2}","مشتقة <span class=m dir=ltr>ln u</span> هي <span class=m dir=ltr>u&#x27;/u</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{3x^{2}}{x^{3}+2}\"></span>","o":""},{"n":"9","s":[["f'(x)=2\\left(\\frac{x^{2}}{x^{3}+2}\\right)\\cdot\\frac{2x(x^{3}+2)-x^{2}(3x^{2})}{(x^{3}+2)^{2}}","قاعدة السلسلة ثم مشتقة القسمة"],["=\\frac{2x^{2}(4x-x^{4})}{(x^{3}+2)^{3}}=\\frac{2x^{3}(4-x^{3})}{(x^{3}+2)^{3}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2x^{3}(4-x^{3})}{(x^{3}+2)^{3}}\"></span>","o":""},{"n":"10","s":[["f'(x)=2x\\sqrt{20-x}+x^{2}\\cdot\\frac{-1}{2\\sqrt{20-x}}","مشتقة الضرب مع السلسلة"],["=\\frac{4x(20-x)-x^{2}}{2\\sqrt{20-x}}=\\frac{80x-5x^{2}}{2\\sqrt{20-x}}","بتوحيد المقامات"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{80x-5x^{2}}{2\\sqrt{20-x}}\"></span>","o":""},{"n":"11","s":[["f'(x)=\\frac{e^{x^{2}}\\cdot 2\\cos(2x+1)-\\sin(2x+1)\\cdot 2xe^{x^{2}}}{\\left(e^{x^{2}}\\right)^{2}}","مشتقة القسمة مع السلسلة"],["f'(x)=\\frac{2\\cos(2x+1)-2x\\sin(2x+1)}{e^{x^{2}}}","بقسمة البسط والمقام على <span class=m dir=ltr>e^{x²}</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2\\cos(2x+1)-2x\\sin(2x+1)}{e^{x^{2}}}\"></span>","o":""},{"n":"12","s":[["f'(x)=3^{\\cot x}\\ln 3\\cdot(-\\csc^{2}x)","مشتقة <span class=m dir=ltr>a^u</span> هي <span class=m dir=ltr>a^u ln a · u&#x27;</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-3^{\\cot x}\\ln 3\\,\\csc^{2}x\"></span>","o":""}],[{"n":"13","s":[["y\\left(\\frac{\\pi}{2}\\right)=2\\sin\\frac{5\\pi}{2}-4\\cos\\frac{3\\pi}{2}=2(1)-0=2","نقطة التماس"],["y'=10\\cos 5x+12\\sin 3x","قاعدة السلسلة"],["y'\\left(\\frac{\\pi}{2}\\right)=10(0)+12(-1)=-12","الميل"],["y-2=-12\\left(x-\\frac{\\pi}{2}\\right)\\Rightarrow y=-12x+6\\pi+2","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=-12x+6\\pi+2\"></span>","o":""},{"n":"14","s":[["f(-1)=(1+2)^{3}=27","نقطة التماس"],["f'(x)=3(x^{2}+2)^{2}\\cdot 2x=6x(x^{2}+2)^{2}","قاعدة السلسلة"],["f'(-1)=6(-1)(9)=-54","الميل"],["y-27=-54(x+1)\\Rightarrow y=-54x-27","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=-54x-27\"></span>","o":""},{"n":"15","s":[["f\\left(\\frac{\\pi}{4}\\right)=\\tan\\frac{3\\pi}{4}=-1","نقطة التماس"],["f'(x)=3\\sec^{2}3x","قاعدة السلسلة"],["f'\\left(\\frac{\\pi}{4}\\right)=3\\sec^{2}\\frac{3\\pi}{4}=3(2)=6","الميل"],["y+1=6\\left(x-\\frac{\\pi}{4}\\right)\\Rightarrow y=6x-\\frac{3\\pi}{2}-1","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=6x-\\frac{3\\pi}{2}-1\"></span>","o":""}],[{"n":"16","s":[["f'(x)=3\\cos x-3\\sin^{2}x\\cos x","قاعدة السلسلة للحد <span class=m dir=ltr>sin³x</span>"],["=3\\cos x(1-\\sin^{2}x)","بإخراج <span class=m dir=ltr>3cos x</span> عاملًا مشتركًا"],["=3\\cos x\\cdot\\cos^{2}x=3\\cos^{3}x","المتطابقة <span class=m dir=ltr>1 − sin²x = cos²x</span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3\\cos^{3}x\"></span> وهو المطلوب","o":""},{"n":"17","s":[["f''(x)=9\\cos^{2}x\\cdot(-\\sin x)","اشتقاق <span class=m dir=ltr>3cos³x</span> بقاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=-9\\sin x\\cos^{2}x\"></span>","o":""}],[{"n":"18","s":[["\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}=\\frac{b\\cos t}{-a\\sin t}","مشتقة المعادلة الوسيطية"],["\\frac{dy}{dx}\\Big|_{t=\\frac{\\pi}{4}}=-\\frac{b}{a}","<span class=m dir=ltr>cos(π/4) = sin(π/4)</span>"],["\\left(\\frac{a}{\\sqrt{2}},\\frac{b}{\\sqrt{2}}\\right)","نقطة التماس عند <span class=m dir=ltr>t = π/4</span>"],["y-\\frac{b}{\\sqrt{2}}=-\\frac{b}{a}\\left(x-\\frac{a}{\\sqrt{2}}\\right)","معادلة المماس"],["x=0\\Rightarrow y=\\frac{b}{\\sqrt{2}}+\\frac{b}{\\sqrt{2}}=\\sqrt{2}\\,b","المقطع <span class=m dir=ltr>y</span> نجده بتعويض <span class=m dir=ltr>x = 0</span>"]],"a":"المقطع <span class=\"tx\" data-t=\"y\"></span> للمماس هو <span class=\"tx\" data-t=\"\\sqrt{2}\\,b\"></span>","o":""}],[{"n":"19","s":[["\\frac{dy}{dx}=ae^{ax}","قاعدة السلسلة"],["ae^{ax}=1\\Rightarrow e^{ax}=\\frac{1}{a}","الميل يساوي <span class=m dir=ltr>1</span>"],["x=\\frac{1}{a}\\ln\\frac{1}{a}=-\\frac{\\ln a}{a},\\quad y=e^{ax}=\\frac{1}{a}","بأخذ <span class=m dir=ltr>ln</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"P\\left(-\\frac{\\ln a}{a},\\ \\frac{1}{a}\\right)\"></span>","o":""},{"n":"20","s":[["m_{\\perp}=-\\frac{1}{1}=-1","ميل العمودي على المماس"],["y-\\frac{1}{a}=-1\\left(x+\\frac{\\ln a}{a}\\right)","معادلة العمودي عند <span class=m dir=ltr>P</span>"],["x+y=\\frac{1}{a}-\\frac{\\ln a}{a}","بالترتيب"]],"a":"معادلة العمودي <span class=\"tx\" data-t=\"x+y=k\"></span> حيث <span class=\"tx\" data-t=\"k=\\frac{1-\\ln a}{a}\"></span>","o":""}],[{"n":"21","s":[["h'(x)=\\frac{3f'(x)}{2\\sqrt{4+3f(x)}}","قاعدة السلسلة"],["h'(1)=\\frac{3(4)}{2\\sqrt{4+3(7)}}=\\frac{12}{2\\sqrt{25}}=\\frac{12}{10}","بالتعويض <span class=m dir=ltr>f(1) = 7, f&#x27;(1) = 4</span>"]],"a":"<span class=\"tx\" data-t=\"h&#x27;(1)=\\frac{6}{5}=1.2\"></span>","o":""}],[{"n":"22","s":[["f'(x)=2e^{2x}-2e^{-2x}","قاعدة السلسلة"],["f''(x)=4e^{2x}+4e^{-2x}","الاشتقاق مرة ثانية"],["f''(x)=4\\left(e^{2x}+e^{-2x}\\right)=4f(x)","بإخراج <span class=m dir=ltr>4</span> عاملًا مشتركًا"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)=4f(x)\"></span> وهو المطلوب","o":""}],[{"n":"23","s":[["f'(x)=4\\cos 4x-4\\sin 4x","قاعدة السلسلة"],["f''(x)=-16\\sin 4x-16\\cos 4x=-16f(x)","الاشتقاق مرة ثانية"],["f''(x)+16f(x)=-16f(x)+16f(x)=0","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;&#x27;(x)+16f(x)=0\"></span> وهو المطلوب","o":""}],[{"n":"24","s":[["v(t)=-3\\pi\\sin\\pi t,\\quad a(t)=-3\\pi^{2}\\cos\\pi t","السرعة والتسارع"],["v\\left(\\frac{2}{3}\\right)=-3\\pi\\cdot\\frac{\\sqrt{3}}{2}=-\\frac{3\\sqrt{3}\\pi}{2}\\approx -8.16","بالتعويض"],["a\\left(\\frac{2}{3}\\right)=-3\\pi^{2}\\left(-\\frac{1}{2}\\right)=\\frac{3\\pi^{2}}{2}\\approx 14.80","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"v=-\\frac{3\\sqrt{3}\\pi}{2}\\approx -8.16\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a=\\frac{3\\pi^{2}}{2}\\approx 14.80\\ \\text{m/s}^2\"></span>","o":""},{"n":"25","s":[["v(t)=-3\\pi\\sin\\pi t=0\\Rightarrow \\sin\\pi t=0","السكون اللحظي: السرعة صفر"],["\\pi t=\\pi\\Rightarrow t=1","أول قيمة <span class=m dir=ltr>t &gt; 0</span>"],["s(1)=3\\cos\\pi=-3","موقع الجسم"]],"a":"<span class=\"tx\" data-t=\"s(1)=-3\\ \\text{m}\"></span>","o":""},{"n":"26","s":[["v\\left(\\frac{5}{4}\\right)=-3\\pi\\sin\\frac{5\\pi}{4}=-3\\pi\\left(-\\frac{\\sqrt{2}}{2}\\right)=\\frac{3\\sqrt{2}\\pi}{2}>0","بالتعويض"]],"a":"السرعة موجبة (<span class=\"tx\" data-t=\"\\approx 6.66\\ \\text{m/s}\"></span>)، إذن يتحرّك الجسم في الاتجاه الموجب","o":""},{"n":"27","s":[["s(0)=3\\cos 0=3","الموقع الابتدائي"],["3\\cos\\pi t=3\\Rightarrow\\cos\\pi t=1","نساوي الموقع بـ <span class=m dir=ltr>3</span>"],["\\pi t=2\\pi\\Rightarrow t=2","أول قيمة <span class=m dir=ltr>t &gt; 0</span>"]],"a":"يعود الجسم إلى موقعه الابتدائي أوّل مرة عندما <span class=\"tx\" data-t=\"t=2\\ \\text{s}\"></span>","o":""}],[{"n":"28","s":[["P'(t)=50e^{-0.004t}\\cdot(-0.004)=-0.2e^{-0.004t}","قاعدة السلسلة"],["P'(500)=-0.2e^{-2}\\approx -0.0271","بالتعويض <span class=m dir=ltr>t = 500</span>"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(500)\\approx -0.0271\"></span> واط/يوم: بعد <span class=m dir=ltr>500</span> يوم تتناقص الطاقة المتبقّية بمعدّل <span class=m dir=ltr>0.0271</span> واط تقريبًا لكل يوم","o":""}],[{"n":"29","s":[["H'(t)=2.4\\cos\\left(\\frac{2\\pi}{365}(t-80)\\right)\\cdot\\frac{2\\pi}{365}","قاعدة السلسلة"],["H'(t)=\\frac{4.8\\pi}{365}\\cos\\left(\\frac{2\\pi}{365}(t-80)\\right)\\approx 0.0413\\cos\\left(\\frac{2\\pi}{365}(t-80)\\right)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"H&#x27;(t)=\\frac{4.8\\pi}{365}\\cos\\left(\\frac{2\\pi}{365}(t-80)\\right)\"></span> ساعة لكل يوم","o":""}],[{"n":"30","s":[["h'(t)=85\\cos\\left(\\frac{\\pi}{20}(t-10)\\right)\\cdot\\frac{\\pi}{20}","قاعدة السلسلة"],["h'(t)=\\frac{17\\pi}{4}\\cos\\left(\\frac{\\pi}{20}(t-10)\\right)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"h&#x27;(t)=\\frac{17\\pi}{4}\\cos\\left(\\frac{\\pi}{20}(t-10)\\right)\"></span> قدم لكل ثانية","o":""}],[{"n":"31","s":[["h'(t)=4\\cos\\left(\\frac{\\pi}{6}t\\right)\\cdot\\frac{\\pi}{6}","قاعدة السلسلة"],["h'(t)=\\frac{2\\pi}{3}\\cos\\left(\\frac{\\pi}{6}t\\right)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"h&#x27;(t)=\\frac{2\\pi}{3}\\cos\\left(\\frac{\\pi}{6}t\\right)\"></span> قدم لكل ساعة","o":""}],[{"n":"32","s":[["\\frac{dx}{d\\theta}=2\\sin\\theta\\cos\\theta,\\quad \\frac{dy}{d\\theta}=-2\\sin\\theta","قاعدة السلسلة"],["\\frac{dy}{dx}=\\frac{-2\\sin\\theta}{2\\sin\\theta\\cos\\theta}=-\\frac{1}{\\cos\\theta}=-\\sec\\theta","بالقسمة، حيث <span class=m dir=ltr>sin</span> θ <span class=m dir=ltr>≠ 0</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\sec\\theta\"></span>","o":""},{"n":"33","s":[["-\\sec\\theta=\\sqrt{2}\\Rightarrow\\cos\\theta=-\\frac{1}{\\sqrt{2}}","نساوي الميل بـ <span class=m dir=ltr>√2</span>"],["\\theta=\\frac{3\\pi}{4}\\ \\text{or}\\ \\theta=\\frac{5\\pi}{4}","في الفترة <span class=m dir=ltr>[0, 2π]</span>"],["x=\\sin^{2}\\theta=\\frac{1}{2},\\quad y=2\\cos\\theta=-\\sqrt{2}","القيمتان تعطيان النقطة نفسها"],["y+\\sqrt{2}=\\sqrt{2}\\left(x-\\frac{1}{2}\\right)\\Rightarrow y=\\sqrt{2}x-\\frac{3\\sqrt{2}}{2}","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt{2}\\,x-\\frac{3\\sqrt{2}}{2}\"></span>","o":""},{"n":"34","s":[["\\frac{dx}{d\\theta}=2\\sin\\theta\\cos\\theta=0,\\quad \\frac{dy}{d\\theta}\\ne 0","المماس الرأسي: البسط لا يساوي صفرًا والمقام صفر"],["\\sin\\theta\\ne 0\\Rightarrow\\cos\\theta=0\\Rightarrow\\theta=\\frac{\\pi}{2},\\frac{3\\pi}{2}","بالحل"],["x=\\sin^{2}\\frac{\\pi}{2}=1,\\quad y=2\\cos\\frac{\\pi}{2}=0","بالتعويض (θ <span class=m dir=ltr>= 3π/2</span> تعطي النقطة نفسها)"]],"a":"النقطة <span class=\"tx\" data-t=\"(1,\\,0)\"></span>","o":""}],[{"n":"35","s":[["a(t)=v'(t)=15e^{-0.05t^{2}}+15t\\cdot e^{-0.05t^{2}}(-0.1t)","مشتقة الضرب مع السلسلة"],["a(t)=15e^{-0.05t^{2}}(1-0.1t^{2})=0","بإخراج العامل المشترك"],["1-0.1t^{2}=0\\Rightarrow t^{2}=10\\Rightarrow t=\\sqrt{10}","<span class=m dir=ltr>e^u</span> لا يساوي صفرًا، و <span class=m dir=ltr>t ≥ 0</span>"],["v(\\sqrt{10})=15\\sqrt{10}\\,e^{-0.5}\\approx 28.77","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"v=15\\sqrt{10}\\,e^{-0.5}\\approx 28.77\\ \\text{m/s}\"></span>","o":""}],[{"n":"36","s":[["(f\\circ g)'(x)=f'(g(x))\\cdot g'(x)=5u^{4}\\cdot\\frac{1}{2\\sqrt{x}}","قاعدة السلسلة"],["x=1\\Rightarrow u=\\sqrt{1}=1","قيمة <span class=m dir=ltr>u</span>"],["(f\\circ g)'(1)=5(1)^{4}\\cdot\\frac{1}{2}=\\frac{5}{2}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"(f\\circ g)&#x27;(1)=\\frac{5}{2}\"></span>","o":""},{"n":"37","s":[["f(u)=u+\\sec^{2}u\\Rightarrow f'(u)=1+2\\sec^{2}u\\tan u","<span class=m dir=ltr>1/cos²u = sec²u</span>، وقاعدة السلسلة"],["x=\\frac{1}{4}\\Rightarrow u=\\frac{\\pi}{4},\\quad g'(x)=\\pi","قيمة <span class=m dir=ltr>u</span>"],["f'\\left(\\frac{\\pi}{4}\\right)=1+2(2)(1)=5","<span class=m dir=ltr>sec²(π/4) = 2, tan(π/4) = 1</span>"],["(f\\circ g)'\\left(\\frac{1}{4}\\right)=5\\cdot\\pi=5\\pi","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"(f\\circ g)&#x27;\\left(\\frac{1}{4}\\right)=5\\pi\"></span>","o":""}],[{"n":"38","s":[["\\frac{dx}{dt}=10\\cos t,\\quad \\frac{dy}{dt}=-4\\sin 2t","الاشتقاق بالنسبة إلى <span class=m dir=ltr>t</span>"],["\\frac{dy}{dx}=\\frac{-4\\sin 2t}{10\\cos t}=\\frac{-8\\sin t\\cos t}{10\\cos t}=-\\frac{4}{5}\\sin t","<span class=m dir=ltr>sin 2t = 2 sin t cos t</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{4}{5}\\sin t\"></span>","o":""},{"n":"39","s":[["-\\frac{4}{5}\\sin t=0\\Rightarrow\\sin t=0\\Rightarrow t=0","عند أعلى نقطة يكون المماس أفقيًّا، و <span class=m dir=ltr>−π/2 ≤ t ≤ π/2</span>"],["x=10\\sin 0=0,\\quad y=2+2\\cos 0=4","التحقق: النقطة <span class=m dir=ltr>(0, 4)</span> هي القمة في الشكل"]],"a":"<span class=\"tx\" data-t=\"t=0\"></span> (أعلى نقطة <span class=\"tx\" data-t=\"(0,\\,4)\"></span>)","o":""}],[{"n":"40","s":[["x=0\\Rightarrow\\sin 2t=0,\\quad y=0\\Rightarrow\\cos t=0","المنحنى يمر بنقطة الأصل"],["t=\\frac{\\pi}{2}\\ \\text{or}\\ t=\\frac{3\\pi}{2}","قيمتان لـ <span class=m dir=ltr>t</span> في <span class=m dir=ltr>[0, 2π]</span>"],["\\frac{dy}{dx}=\\frac{-3\\sin t}{4\\cos 2t}","<span class=m dir=ltr>dy/dt ÷ dx/dt</span>"],["t=\\frac{\\pi}{2}:\\ \\frac{-3(1)}{4(-1)}=\\frac{3}{4};\\quad t=\\frac{3\\pi}{2}:\\ \\frac{-3(-1)}{4(-1)}=-\\frac{3}{4}","بالتعويض"]],"a":"يوجد مماسان عند نقطة الأصل: ميل أحدهما <span class=\"tx\" data-t=\"\\frac{3}{4}\"></span> والآخر <span class=\"tx\" data-t=\"-\\frac{3}{4}\"></span>","o":"التبرير: المنحنى (على شكل ∞ رأسي) يمر بنقطة الأصل مرتين عند <span class=m dir=ltr>t = π/2</span> و <span class=m dir=ltr>t = 3π/2</span>، فيتقاطع مع نفسه فيها، ولكل مرور مماس مختلف."}]]