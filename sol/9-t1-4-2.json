[[{"n":"1","s":[["m=\\frac{-4-0}{1-(-6)}=-\\frac{4}{7},\\quad y=-\\frac{4}{7}x-\\frac{24}{7}","الخطوة <span class=m dir=ltr>1</span>: معادلة المستقيم <span class=m dir=ltr>l</span>"],["m_w=\\frac{7}{4},\\quad y=\\frac{7}{4}x-\\frac{5}{2}","الخطوة <span class=m dir=ltr>2</span>: المستقيم العمودي المار بـ <span class=m dir=ltr>P(2,1)</span>؛ حاصل ضرب الميلين <span class=m dir=ltr>−1</span>"],["-\\frac{4}{7}x-\\frac{24}{7}=\\frac{7}{4}x-\\frac{5}{2}","الخطوة <span class=m dir=ltr>3</span>: نقطة التقاطع"],["-16x-96=49x-70 \\Rightarrow x=-\\frac{2}{5},\\ y=-\\frac{16}{5}","بضرب الطرفين في <span class=m dir=ltr>28</span> والحل"],["d=\\sqrt{\\left(2+\\frac{2}{5}\\right)^2+\\left(1+\\frac{16}{5}\\right)^2}=\\sqrt{\\frac{585}{25}}","الخطوة <span class=m dir=ltr>4</span>: صيغة المسافة"],["=\\frac{3\\sqrt{65}}{5}\\approx 4.84","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{3\\sqrt{65}}{5}\\approx 4.84\"></span> وحدة","o":""},{"n":"2","s":[["m=\\frac{3-8}{-2-2}=\\frac{5}{4},\\quad y=\\frac{5}{4}x+\\frac{11}{2}","الخطوة <span class=m dir=ltr>1</span>: معادلة المستقيم <span class=m dir=ltr>l</span>"],["m_w=-\\frac{4}{5},\\quad y=-\\frac{4}{5}x-\\frac{26}{5}","الخطوة <span class=m dir=ltr>2</span>: العمودي المار بـ <span class=m dir=ltr>P(-9,2)</span>"],["\\frac{5}{4}x+\\frac{11}{2}=-\\frac{4}{5}x-\\frac{26}{5}","الخطوة <span class=m dir=ltr>3</span>: نقطة التقاطع"],["25x+110=-16x-104 \\Rightarrow x=-\\frac{214}{41},\\ y=-\\frac{42}{41}","بضرب الطرفين في <span class=m dir=ltr>20</span> والحل"],["d=\\sqrt{\\left(-9+\\frac{214}{41}\\right)^2+\\left(2+\\frac{42}{41}\\right)^2}=\\sqrt{\\frac{961}{41}}","الخطوة <span class=m dir=ltr>4</span>: صيغة المسافة"],["=\\frac{31}{\\sqrt{41}}\\approx 4.84","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{31}{\\sqrt{41}}\\approx 4.84\"></span> وحدة","o":""},{"n":"3","s":[["m=\\frac{4-(-3)}{-7-1}=-\\frac{7}{8},\\quad y=-\\frac{7}{8}x-\\frac{17}{8}","الخطوة <span class=m dir=ltr>1</span>: معادلة المستقيم <span class=m dir=ltr>l</span>"],["m_w=\\frac{8}{7},\\quad y=\\frac{8}{7}x-\\frac{4}{7}","الخطوة <span class=m dir=ltr>2</span>: العمودي المار بـ <span class=m dir=ltr>P(4,4)</span>"],["-\\frac{7}{8}x-\\frac{17}{8}=\\frac{8}{7}x-\\frac{4}{7}","الخطوة <span class=m dir=ltr>3</span>: نقطة التقاطع"],["-49x-119=64x-32 \\Rightarrow x=-\\frac{87}{113},\\ y=-\\frac{164}{113}","بضرب الطرفين في <span class=m dir=ltr>56</span> والحل"],["d=\\sqrt{\\left(4+\\frac{87}{113}\\right)^2+\\left(4+\\frac{164}{113}\\right)^2}=\\sqrt{\\frac{5929}{113}}","الخطوة <span class=m dir=ltr>4</span>: صيغة المسافة"],["=\\frac{77}{\\sqrt{113}}\\approx 7.24","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{77}{\\sqrt{113}}\\approx 7.24\"></span> وحدة","o":""}],[{"n":"4","s":[["m=\\frac{1-1}{0-(-2)}=0 \\Rightarrow y=1","معادلة المستقيم <span class=m dir=ltr>l (</span>أفقي)"],["0x+y-1=0,\\ A=0,B=1,C=-1","على الصورة <span class=m dir=ltr>Ax+By+C=0</span>"],["d=\\frac{|0(5)+1(7)-1|}{\\sqrt{0^2+1^2}}","بالتعويض في صيغة البعد"],["=6","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=6\"></span> وحدات","o":""},{"n":"5","s":[["x=4","المستقيم رأسي لأن للنقطتين الإحداثي <span class=m dir=ltr>x</span> نفسه"],["x+0y-4=0,\\ A=1,B=0,C=-4","على الصورة <span class=m dir=ltr>Ax+By+C=0</span>"],["d=\\frac{|1(1)+0(-9)-4|}{\\sqrt{1^2+0^2}}","بالتعويض في صيغة البعد"],["=3","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=3\"></span> وحدات","o":""},{"n":"6","s":[["m=\\frac{-1-1}{-8-3}=\\frac{2}{11}","ميل المستقيم <span class=m dir=ltr>l</span>"],["y-1=\\frac{2}{11}(x-3)","صيغة الميل ونقطة"],["2x-11y+5=0","بالضرب في <span class=m dir=ltr>11</span> والترتيب"],["d=\\frac{|2(-3)-11(-10)+5|}{\\sqrt{2^2+(-11)^2}}","بالتعويض في صيغة البعد"],["=\\frac{109}{\\sqrt{125}}\\approx 9.75","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{109}{\\sqrt{125}}\\approx 9.75\"></span> وحدة","o":""}],[{"n":"7","s":[["x-6y-36=0","بضرب المعادلة في <span class=m dir=ltr>−6</span>؛ <span class=m dir=ltr>A=1, B=−6, C=−36</span>"],["d=\\frac{|Ax_1+By_1+C|}{\\sqrt{A^2+B^2}}","صيغة البعد بين نقطة ومستقيم"],["=\\frac{|1(-6)-6(5)-36|}{\\sqrt{1^2+(-6)^2}}","بالتعويض <span class=m dir=ltr>P(-6,5)</span>"],["=\\frac{72}{\\sqrt{37}}\\approx 11.84","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{72}{\\sqrt{37}}\\approx 11.84\"></span> وحدة","o":""},{"n":"8","s":[["x-y+2=0","<span class=m dir=ltr>A=1, B=−1, C=2</span>"],["d=\\frac{|1(2)-1(4)+2|}{\\sqrt{1^2+(-1)^2}}","بالتعويض <span class=m dir=ltr>Q(2,4)</span>"],["=\\frac{0}{\\sqrt{2}}=0","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=0\"></span>؛ أي إن النقطة <span class=\"tx\" data-t=\"Q\"></span> تقع على المستقيم","o":""},{"n":"9","s":[["x+4y-4=0","بضرب الطرفين في <span class=m dir=ltr>4</span>؛ <span class=m dir=ltr>A=1, B=4, C=−4</span>"],["d=\\frac{|1(4)+4(3)-4|}{\\sqrt{1^2+4^2}}","بالتعويض <span class=m dir=ltr>S(4,3)</span>"],["=\\frac{12}{\\sqrt{17}}\\approx 2.91","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{12}{\\sqrt{17}}\\approx 2.91\"></span> وحدة","o":""},{"n":"10","s":[["0x+y+3=0","<span class=m dir=ltr>A=0, B=1, C=3</span>"],["d=\\frac{|0(5)+1(2)+3|}{\\sqrt{0^2+1^2}}","بالتعويض <span class=m dir=ltr>T(5,2)</span>"],["=5","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=5\"></span> وحدات","o":""},{"n":"11","s":[["x+0y-4=0","<span class=m dir=ltr>A=1, B=0, C=−4</span>"],["d=\\frac{|1(-2)+0(5)-4|}{\\sqrt{1^2+0^2}}","بالتعويض <span class=m dir=ltr>K(-2,5)</span>"],["=|-6|=6","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=6\"></span> وحدات","o":""},{"n":"12","s":[["-x+y=0","<span class=m dir=ltr>A=−1, B=1, C=0</span>"],["d=\\frac{|-1(5)+1(3)+0|}{\\sqrt{(-1)^2+1^2}}","بالتعويض <span class=m dir=ltr>R(5,3)</span>"],["=\\frac{2}{\\sqrt{2}}=\\sqrt{2}\\approx 1.41","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\sqrt{2}\\approx 1.41\"></span> وحدة","o":""}],[{"n":"13","s":[["4(0)-y+1=0 \\Rightarrow y=1","الخطوة <span class=m dir=ltr>1</span>: بتعويض <span class=m dir=ltr>x=0</span> في المستقيم الأول؛ النقطة <span class=m dir=ltr>(0,1)</span>"],["d=\\frac{|4(0)-1(1)-8|}{\\sqrt{4^2+(-1)^2}}","الخطوة <span class=m dir=ltr>2</span>: البعد بين <span class=m dir=ltr>(0,1)</span> والمستقيم الثاني"],["=\\frac{9}{\\sqrt{17}}\\approx 2.18","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{9}{\\sqrt{17}}\\approx 2.18\"></span> وحدة","o":""},{"n":"14","s":[["12(0)+5y-3=0 \\Rightarrow y=\\frac{3}{5}","الخطوة <span class=m dir=ltr>1</span>: النقطة <span class=m dir=ltr>(0, 3/5)</span> على المستقيم الأول"],["d=\\frac{|12(0)+5\\left(\\frac{3}{5}\\right)+7|}{\\sqrt{12^2+5^2}}","الخطوة <span class=m dir=ltr>2</span>: البعد عن المستقيم الثاني"],["=\\frac{10}{13}\\approx 0.77","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{10}{13}\\approx 0.77\"></span> وحدة","o":""},{"n":"15","s":[["2x-3y+15=0","بضرب المعادلة الثانية في <span class=m dir=ltr>3</span> وترتيبها"],["2x-3(0)+4=0 \\Rightarrow x=-2","النقطة <span class=m dir=ltr>(−2,0)</span> على المستقيم الأول"],["d=\\frac{|2(-2)-3(0)+15|}{\\sqrt{2^2+(-3)^2}}","البعد عن المستقيم الثاني"],["=\\frac{11}{\\sqrt{13}}\\approx 3.05","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{11}{\\sqrt{13}}\\approx 3.05\"></span> وحدة","o":""}],[{"n":"16","s":[["m=\\frac{3-0}{5-1}=\\frac{3}{4}","ميل <span class=m dir=ltr>m</span> من النقطتين <span class=m dir=ltr>(1,0), (5,3)</span> على الشكل"],["l:\\ y=\\frac{3}{4}x+\\frac{15}{4} \\Rightarrow 3x-4y+15=0","<span class=m dir=ltr>l</span> يمر بـ <span class=m dir=ltr>(−1,3), (3,6)</span> ويوازي <span class=m dir=ltr>m</span>"],["(1,0)\\in m","نقطة على المستقيم <span class=m dir=ltr>m</span>"],["d=\\frac{|3(1)-4(0)+15|}{\\sqrt{3^2+(-4)^2}}=\\frac{18}{5}=3.6","البعد بين النقطة والمستقيم <span class=m dir=ltr>l</span>"],["3.6\\times 10=36","كل وحدة تمثل <span class=m dir=ltr>10 m</span>"]],"a":"عرض النهر <span class=\"tx\" data-t=\"=36\\ \\text{m}\"></span>","o":"قراءة الشكل: <span class=\"tx\" data-t=\"l\"></span> يمر بالنقطتين <span class=\"tx\" data-t=\"(-1,3),(3,6)\"></span> و <span class=\"tx\" data-t=\"m\"></span> يمر بالنقطتين <span class=\"tx\" data-t=\"(1,0),(5,3)\"></span>."}],[{"n":"17","s":[["P(-4,4),\\ R(5,-1)","من الشكل؛ كل وحدة تمثل <span class=m dir=ltr>100 m</span>"],["PR=\\sqrt{(5-(-4))^2+(-1-4)^2}","صيغة المسافة"],["=\\sqrt{81+25}=\\sqrt{106}\\approx 10.3","بالتبسيط"],["10.3\\times 100\\approx 1030","بالتحويل إلى أمتار"]],"a":"طول الطريق <span class=\"tx\" data-t=\"=\\sqrt{106}\\approx 10.3\"></span> وحدة <span class=\"tx\" data-t=\"\\approx 1030\\ \\text{m}\"></span>","o":""},{"n":"18","s":[["M=\\left(\\frac{-4+5}{2},\\frac{4+(-1)}{2}\\right)","صيغة نقطة المنتصف"],["=(0.5,\\ 1.5)","بالتبسيط"]],"a":"المنتصف <span class=\"tx\" data-t=\"(0.5,\\ 1.5)\"></span>","o":""},{"n":"19","s":[["m=\\frac{-1-4}{5-(-4)}=-\\frac{5}{9}","ميل الطريق <span class=m dir=ltr>PR</span>"],["y-4=-\\frac{5}{9}(x+4) \\Rightarrow 5x+9y-16=0","معادلة الطريق على الصورة <span class=m dir=ltr>Ax+By+C=0</span>"],["d=\\frac{|5(0)+9(0)-16|}{\\sqrt{5^2+9^2}}=\\frac{16}{\\sqrt{106}}","البعد بين نقطة الأصل والمستقيم"],["\\approx 1.554\\times 100\\approx 155.4","بالتحويل إلى أمتار"]],"a":"أقصر مسافة <span class=\"tx\" data-t=\"\\approx 1.55\"></span> وحدة <span class=\"tx\" data-t=\"\\approx 155.4\\ \\text{m}\"></span>","o":""}],[{"n":"20","s":[["2x+y-8=0 \\Rightarrow A=2,\\ B=1,\\ C=-8","الخطأ: عكس عمران قيمتي <span class=m dir=ltr>A</span> و <span class=m dir=ltr>B</span> في البسط، واستعمل <span class=m dir=ltr>B=−1</span> في المقام"],["d=\\frac{|2(1)+1(-1)+(-8)|}{\\sqrt{2^2+1^2}}","التعويض الصحيح <span class=m dir=ltr>P(1,−1)</span>"],["=\\frac{|-7|}{\\sqrt{5}}=\\frac{7}{\\sqrt{5}}","بالتبسيط"],["\\approx 3.13","باستعمال الآلة الحاسبة"]],"a":"الخطأ في تحديد <span class=\"tx\" data-t=\"A\"></span> و <span class=\"tx\" data-t=\"B\"></span>؛ الصحيح <span class=\"tx\" data-t=\"A=2,\\ B=1\"></span> والبعد <span class=\"tx\" data-t=\"=\\frac{7}{\\sqrt{5}}\\approx 3.13\"></span> وحدة","o":""}],[{"n":"21","s":[["A(1,4),\\ B(6,1),\\ C(3,0)","إحداثيات الرؤوس من الشكل"],["CB=\\sqrt{(6-3)^2+(1-0)^2}=\\sqrt{10}","طول القاعدة <span class=m dir=ltr>CB</span>"],["m=\\frac{1}{3}:\\ y=\\frac{1}{3}(x-3) \\Rightarrow x-3y-3=0","معادلة المستقيم <span class=m dir=ltr>CB</span>"],["h=\\frac{|1-3(4)-3|}{\\sqrt{1^2+(-3)^2}}=\\frac{14}{\\sqrt{10}}","الارتفاع <span class=m dir=ltr>=</span> بعد <span class=m dir=ltr>A</span> عن المستقيم <span class=m dir=ltr>CB</span>"],["\\text{Area}=\\frac{1}{2}\\times\\sqrt{10}\\times\\frac{14}{\\sqrt{10}}=7","مساحة المثلث <span class=m dir=ltr>=</span> ½ <span class=m dir=ltr>×</span> القاعدة <span class=m dir=ltr>×</span> الارتفاع"]],"a":"مساحة المثلث <span class=\"tx\" data-t=\"=7\"></span> وحدات مربعة","o":"التبرير: الارتفاع المناظر للقاعدة <span class=\"tx\" data-t=\"\\overline{CB}\"></span> هو البعد العمودي بين الرأس <span class=m dir=ltr>A</span> والمستقيم <span class=m dir=ltr>CB</span>."}],[{"n":"22","s":[["4x+3y-12=0","بضرب الطرفين في <span class=m dir=ltr>12</span> والترتيب"],["(a,0)","النقطة المطلوبة على المحور <span class=m dir=ltr>x</span>"],["\\frac{|4a+3(0)-12|}{\\sqrt{4^2+3^2}}=4","صيغة البعد"],["|4a-12|=20","بضرب الطرفين في <span class=m dir=ltr>5</span>"],["4a-12=20\\ \\text{or}\\ 4a-12=-20","تعريف القيمة المطلقة"],["a=8\\ \\text{or}\\ a=-2","بحل المعادلتين"]],"a":"النقطتان <span class=\"tx\" data-t=\"(8,\\ 0)\"></span> و <span class=\"tx\" data-t=\"(-2,\\ 0)\"></span>","o":""}],[{"n":"11","s":[["x+y-2=0","<span class=m dir=ltr>A=1, B=1, C=−2</span>"],["d=\\frac{|8+4-2|}{\\sqrt{1^2+1^2}}","بالتعويض <span class=m dir=ltr>P(8,4)</span>"],["=\\frac{10}{\\sqrt{2}}=5\\sqrt{2}\\approx 7.07","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=5\\sqrt{2}\\approx 7.07\"></span> وحدة","o":""},{"n":"12","s":[["A=1,\\ B=-3,\\ C=9","المعادلة على الصورة العامة"],["d=\\frac{|-13-3(6)+9|}{\\sqrt{1^2+(-3)^2}}","بالتعويض <span class=m dir=ltr>Q(−13,6)</span>"],["=\\frac{22}{\\sqrt{10}}\\approx 6.96","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{22}{\\sqrt{10}}\\approx 6.96\"></span> وحدة","o":""},{"n":"13","s":[["5x-y+1=0","بالترتيب؛ <span class=m dir=ltr>A=5, B=−1, C=1</span>"],["d=\\frac{|5(3)-3+1|}{\\sqrt{5^2+(-1)^2}}","بالتعويض <span class=m dir=ltr>S(3,3)</span>"],["=\\frac{13}{\\sqrt{26}}\\approx 2.55","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{13}{\\sqrt{26}}=\\frac{\\sqrt{26}}{2}\\approx 2.55\"></span> وحدة","o":""}],[{"n":"15","s":[["x+2(0)-3=0 \\Rightarrow x=3","النقطة <span class=m dir=ltr>(3,0)</span> على المستقيم الأول"],["d=\\frac{|3+2(0)+4|}{\\sqrt{1^2+2^2}}","البعد عن المستقيم الثاني"],["=\\frac{7}{\\sqrt{5}}\\approx 3.13","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{7}{\\sqrt{5}}\\approx 3.13\"></span> وحدة","o":""},{"n":"16","s":[["9(0)+12y+10=0 \\Rightarrow y=-\\frac{5}{6}","النقطة <span class=m dir=ltr>(0, −5/6)</span> على المستقيم الأول"],["d=\\frac{|9(0)+12\\left(-\\frac{5}{6}\\right)-20|}{\\sqrt{9^2+12^2}}","البعد عن المستقيم الثاني"],["=\\frac{30}{15}=2","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=2\"></span> وحدة","o":""}],[{"n":"17","s":[["y=2","المستقيم <span class=m dir=ltr>MN</span> أفقي يمر بـ <span class=m dir=ltr>M(1,2), N(5,2)</span>"],["H(4,5)","من الشكل"],["d=|5-2|=3","البعد العمودي <span class=m dir=ltr>=</span> الفرق في الإحداثي <span class=m dir=ltr>y</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"3\"></span>","o":""}],[{"n":"1","s":[["m=\\frac{2-(-1)}{1-(-3)}=\\frac{3}{4}","ميل المستقيم <span class=m dir=ltr>l</span>"],["y-2=\\frac{3}{4}(x-1) \\Rightarrow 3x-4y+5=0","معادلة <span class=m dir=ltr>l</span> على الصورة العامة"],["d=\\frac{|3(5)-4(8)+5|}{\\sqrt{3^2+(-4)^2}}","صيغة البعد مع <span class=m dir=ltr>P(5,8)</span>"],["=\\frac{12}{5}=2.4","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=2.4\"></span> وحدة","o":""}],[{"n":"2","s":[["m=\\frac{3-1}{-1-(-4)}=\\frac{2}{3}","ميل المستقيم <span class=m dir=ltr>l</span>"],["y-1=\\frac{2}{3}(x+4) \\Rightarrow 2x-3y+11=0","معادلة <span class=m dir=ltr>l</span> على الصورة العامة"],["d=\\frac{|2(1)-3(7)+11|}{\\sqrt{2^2+(-3)^2}}","صيغة البعد مع <span class=m dir=ltr>P(1,7)</span>"],["=\\frac{8}{\\sqrt{13}}\\approx 2.22","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{8}{\\sqrt{13}}\\approx 2.22\"></span> وحدة","o":""}],[{"n":"3","s":[["3x-y-4=0","<span class=m dir=ltr>A=3, B=−1, C=−4</span>"],["d=\\frac{|3(0)-0-4|}{\\sqrt{3^2+(-1)^2}}","بالتعويض <span class=m dir=ltr>P(0,0)</span>"],["=\\frac{4}{\\sqrt{10}}\\approx 1.26","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{4}{\\sqrt{10}}\\approx 1.26\"></span> وحدة","o":""},{"n":"4","s":[["2x+y-5=0","<span class=m dir=ltr>A=2, B=1, C=−5</span>"],["d=\\frac{|2(1)+\\left(-\\frac{1}{2}\\right)-5|}{\\sqrt{2^2+1^2}}","بالتعويض <span class=m dir=ltr>P(1, −1/2)</span>"],["=\\frac{3.5}{\\sqrt{5}}\\approx 1.57","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=\\frac{7}{2\\sqrt{5}}\\approx 1.57\"></span> وحدة","o":""},{"n":"5","s":[["x+\\frac{1}{2}=0","<span class=m dir=ltr>A=1, B=0, C=1/2</span>"],["d=\\frac{|\\frac{1}{2}+\\frac{1}{2}|}{\\sqrt{1^2+0^2}}","بالتعويض <span class=m dir=ltr>P(1/2, 1/2)</span>"],["=1","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=1\"></span> وحدة","o":""}],[{"n":"6","s":[["x-y-11=0,\\quad x-y-7=0","المعادلتان على الصورة العامة"],["(0,-11)","نقطة على المستقيم الأول"],["d=\\frac{|0-(-11)-7|}{\\sqrt{1^2+(-1)^2}}=\\frac{4}{\\sqrt{2}}","البعد عن المستقيم الثاني"],["=2\\sqrt{2}\\approx 2.83","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=2\\sqrt{2}\\approx 2.83\"></span> وحدة","o":""},{"n":"7","s":[["2x+y-1=0,\\quad 2x+y-16=0","المعادلتان على الصورة العامة"],["(0,1)","نقطة على المستقيم الأول"],["d=\\frac{|2(0)+1-16|}{\\sqrt{2^2+1^2}}=\\frac{15}{\\sqrt{5}}","البعد عن المستقيم الثاني"],["=3\\sqrt{5}\\approx 6.71","بالتبسيط"]],"a":"البعد <span class=\"tx\" data-t=\"=3\\sqrt{5}\\approx 6.71\"></span> وحدة","o":""},{"n":"8","s":[["(1,1)","نقطة على المستقيم الأول: <span class=m dir=ltr>2(1)+5(1)−7=0</span>"],["d=\\frac{|5(1)+2(1)-11|}{\\sqrt{5^2+2^2}}","البعد عن المس