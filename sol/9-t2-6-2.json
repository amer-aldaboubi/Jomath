[[{"n":"1","s":[["\\sqrt{4x^6}=\\sqrt{2^2\\times(x^3)^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=2|x^3|","الدليل زوجي، فنأخذ القيمة المطلقة"]],"a":"<span class=\"tx\" data-t=\"2|x^3|\"></span>","o":""},{"n":"2","s":[["\\sqrt[3]{a^3b^6}=\\sqrt[3]{a^3\\times(b^2)^3}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=ab^2","الدليل فردي، فلا حاجة للقيمة المطلقة"]],"a":"<span class=\"tx\" data-t=\"ab^2\"></span>","o":""},{"n":"3","s":[["\\sqrt{144x^3y^4z^5}=\\sqrt{12^2\\times x^2\\times x\\times(y^2)^2\\times(z^2)^2\\times z}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=12\\,x\\,y^2z^2\\sqrt{xz}","خاصية ضرب الجذور، و <span class=\"tx\" data-t=\"x&gt;0,\\ z&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"12xy^2z^2\\sqrt{xz}\"></span>","o":""},{"n":"4","s":[["\\sqrt[3]{-24x^{13}y^6}=\\sqrt[3]{(-2)^3\\times3\\times(x^4)^3\\times x\\times(y^2)^3}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=-2x^4y^2\\sqrt[3]{3x}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"-2x^4y^2\\sqrt[3]{3x}\"></span>","o":""},{"n":"5","s":[["\\sqrt[4]{625u^5v^8}=\\sqrt[4]{5^4\\times u^4\\times u\\times(v^2)^4}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=5uv^2\\sqrt[4]{u}","خاصية ضرب الجذور، <span class=\"tx\" data-t=\"u&gt;0\"></span> و <span class=\"tx\" data-t=\"v^2\\ge0\"></span>"]],"a":"<span class=\"tx\" data-t=\"5uv^2\\sqrt[4]{u}\"></span>","o":""},{"n":"6","s":[["\\sqrt[6]{25r^6q^8}=\\sqrt[6]{r^6\\times q^6\\times25q^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=|r|\\,|q|\\sqrt[6]{25q^2}","الدليل زوجي، فنأخذ القيمة المطلقة"]],"a":"<span class=\"tx\" data-t=\"|rq|\\sqrt[6]{25q^2}\"></span>","o":""},{"n":"7","s":[["\\sqrt[5]{160x^8z^4}=\\sqrt[5]{2^5\\times5\\times x^5\\times x^3z^4}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=2x\\sqrt[5]{5x^3z^4}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"2x\\sqrt[5]{5x^3z^4}\"></span>","o":""},{"n":"8","s":[["\\sqrt{121(z-2)^{14}}=\\sqrt{11^2\\times\\left((z-2)^7\\right)^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=11\\left|(z-2)^7\\right|","الدليل زوجي، فنأخذ القيمة المطلقة"]],"a":"<span class=\"tx\" data-t=\"11|(z-2)^7|\"></span>","o":""},{"n":"9","s":[["\\sqrt[3]{37(2x-5)^{15}}=\\sqrt[3]{37\\times\\left((2x-5)^5\\right)^3}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=(2x-5)^5\\sqrt[3]{37}","الدليل فردي"]],"a":"<span class=\"tx\" data-t=\"(2x-5)^5\\sqrt[3]{37}\"></span>","o":""}],[{"n":"10","s":[["\\frac{\\sqrt[3]{192x^8}}{\\sqrt[3]{3x}}=\\sqrt[3]{\\frac{192x^8}{3x}}","خاصية قسمة الجذور"],["=\\sqrt[3]{64x^7}=\\sqrt[3]{4^3(x^2)^3x}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=4x^2\\sqrt[3]{x}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"4x^2\\sqrt[3]{x}\"></span>","o":""},{"n":"11","s":[["\\frac{5}{\\sqrt[3]{9a^2}}\\times\\frac{\\sqrt[3]{3a}}{\\sqrt[3]{3a}}","لجعل ما تحت الجذر في المقام مكعبًا كاملًا <span class=\"tx\" data-t=\"27a^3\"></span>"],["=\\frac{5\\sqrt[3]{3a}}{\\sqrt[3]{27a^3}}","خاصية ضرب الجذور"],["=\\frac{5\\sqrt[3]{3a}}{3a}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{5\\sqrt[3]{3a}}{3a}\"></span>","o":""},{"n":"12","s":[["\\frac{\\sqrt6}{\\sqrt{9z}}=\\frac{\\sqrt6}{3\\sqrt z}","بالتبسيط"],["=\\frac{\\sqrt6}{3\\sqrt z}\\times\\frac{\\sqrt z}{\\sqrt z}","بإنطاق المقام"],["=\\frac{\\sqrt{6z}}{3z}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{\\sqrt{6z}}{3z}\"></span>","o":""},{"n":"13","s":[["\\sqrt{\\frac{5x^4}{2x^2y^3}}=\\sqrt{\\frac{5x^2}{2y^3}}","خاصية قسمة القوى"],["=\\frac{x\\sqrt5}{y\\sqrt{2y}}","خاصية قسمة الجذور"],["=\\frac{x\\sqrt5}{y\\sqrt{2y}}\\times\\frac{\\sqrt{2y}}{\\sqrt{2y}}","بإنطاق المقام"],["=\\frac{x\\sqrt{10y}}{2y^2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{x\\sqrt{10y}}{2y^2}\"></span>","o":""},{"n":"14","s":[["\\sqrt[4]{\\frac{16t^4}{y^4}}=\\frac{\\sqrt[4]{2^4t^4}}{\\sqrt[4]{y^4}}","خاصية قسمة الجذور"],["=\\frac{2t}{y}","المتغيرات موجبة"]],"a":"<span class=\"tx\" data-t=\"\\frac{2t}{y}\"></span>","o":""},{"n":"15","s":[["\\sqrt[5]{\\frac{3}{y}}=\\frac{\\sqrt[5]{3}}{\\sqrt[5]{y}}","خاصية قسمة الجذور"],["=\\frac{\\sqrt[5]{3}}{\\sqrt[5]{y}}\\times\\frac{\\sqrt[5]{y^4}}{\\sqrt[5]{y^4}}","بإنطاق المقام"],["=\\frac{\\sqrt[5]{3y^4}}{y}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{\\sqrt[5]{3y^4}}{y}\"></span>","o":""}],[{"n":"16","s":[["\\sqrt8+\\sqrt{50}-\\sqrt2=2\\sqrt2+5\\sqrt2-\\sqrt2","بتبسيط كل جذر"],["=(2+5-1)\\sqrt2=6\\sqrt2","بجمع الجذور المتشابهة"]],"a":"<span class=\"tx\" data-t=\"6\\sqrt2\"></span>","o":""},{"n":"17","s":[["5\\sqrt[3]{16}+\\sqrt[3]{54}=5\\sqrt[3]{8\\times2}+\\sqrt[3]{27\\times2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=10\\sqrt[3]{2}+3\\sqrt[3]{2}","بالتبسيط"],["=13\\sqrt[3]{2}","بجمع الجذور المتشابهة"]],"a":"<span class=\"tx\" data-t=\"13\\sqrt[3]{2}\"></span>","o":""},{"n":"18","s":[["\\sqrt[3]{54xy^3}-y\\sqrt[3]{128x}=\\sqrt[3]{27y^3\\times2x}-y\\sqrt[3]{64\\times2x}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=3y\\sqrt[3]{2x}-4y\\sqrt[3]{2x}","بالتبسيط"],["=-y\\sqrt[3]{2x}","بطرح الجذور المتشابهة"]],"a":"<span class=\"tx\" data-t=\"-y\\sqrt[3]{2x}\"></span>","o":""},{"n":"19","s":[["\\sqrt[4]{5w^{10}}=\\sqrt[4]{(w^2)^4\\times5w^2}=w^2\\sqrt[4]{5w^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["6\\sqrt[4]{405w^6}=6\\sqrt[4]{3^4w^4\\times5w^2}=18w\\sqrt[4]{5w^2}","<span class=\"tx\" data-t=\"405=81\\times5\"></span>"],["w^2\\sqrt[4]{5w^2}-18w\\sqrt[4]{5w^2}=(w^2-18w)\\sqrt[4]{5w^2}","بطرح الجذور المتشابهة"]],"a":"<span class=\"tx\" data-t=\"(w^2-18w)\\sqrt[4]{5w^2}\"></span>","o":""},{"n":"20","s":[["5\\sqrt{2xy^6}\\times2\\sqrt{2x^3y}=10\\sqrt{4x^4y^7}","خاصية ضرب الجذور"],["=10\\times2x^2y^3\\sqrt y","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=20x^2y^3\\sqrt y","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"20x^2y^3\\sqrt y\"></span>","o":""},{"n":"21","s":[["(3+\\sqrt7)(2+\\sqrt6)=6+3\\sqrt6+2\\sqrt7+\\sqrt{42}","خاصية التوزيع"]],"a":"<span class=\"tx\" data-t=\"6+3\\sqrt6+2\\sqrt7+\\sqrt{42}\"></span>","o":""},{"n":"22","s":[["\\sqrt[5]{8xy^7}\\times\\sqrt[5]{6x^6}=\\sqrt[5]{48x^7y^7}","خاصية ضرب الجذور"],["=\\sqrt[5]{x^5y^5\\times48x^2y^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=xy\\sqrt[5]{48x^2y^2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"xy\\sqrt[5]{48x^2y^2}\"></span>","o":""},{"n":"23","s":[["\\frac{2\\sqrt x\\times\\sqrt{x^3}}{\\sqrt{9x^{10}}}=\\frac{2\\sqrt{x^4}}{3x^5}","خاصية ضرب الجذور"],["=\\frac{2x^2}{3x^5}","بالتبسيط"],["=\\frac{2}{3x^3}","خاصية قسمة القوى"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3x^3}\"></span>","o":""},{"n":"24","s":[["\\frac{\\sqrt[3]{y^6}}{\\sqrt[3]{27y}\\times\\sqrt[3]{y^{11}}}=\\frac{y^2}{\\sqrt[3]{27y^{12}}}","خاصية ضرب الجذور"],["=\\frac{y^2}{3y^4}","بالتبسيط"],["=\\frac{1}{3y^2}","خاصية قسمة القوى"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3y^2}\"></span>","o":""},{"n":"25","s":[["\\frac{1}{1+\\sqrt2}\\times\\frac{1-\\sqrt2}{1-\\sqrt2}","بضرب البسط والمقام في مرافق المقام"],["=\\frac{1-\\sqrt2}{1-2}","<span class=\"tx\" data-t=\"(a+b)(a-b)=a^2-b^2\"></span>"],["=\\sqrt2-1","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sqrt2-1\"></span>","o":""},{"n":"26","s":[["\\frac{4}{3-\\sqrt3}\\times\\frac{3+\\sqrt3}{3+\\sqrt3}","بضرب البسط والمقام في مرافق المقام"],["=\\frac{4(3+\\sqrt3)}{9-3}=\\frac{4(3+\\sqrt3)}{6}","<span class=\"tx\" data-t=\"(a-b)(a+b)=a^2-b^2\"></span>"],["=\\frac{6+2\\sqrt3}{3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{6+2\\sqrt3}{3}\"></span>","o":""},{"n":"27","s":[["\\frac{2\\sqrt x-3}{\\sqrt x-1}\\times\\frac{\\sqrt x+1}{\\sqrt x+1}","بضرب البسط والمقام في مرافق المقام"],["=\\frac{2x+2\\sqrt x-3\\sqrt x-3}{x-1}","خاصية التوزيع"],["=\\frac{2x-\\sqrt x-3}{x-1}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2x-\\sqrt x-3}{x-1}\"></span> حيث <span class=\"tx\" data-t=\"x\\ne1\"></span>","o":""}],[{"n":"28","s":[["BQ^2=AB^2+AQ^2=3^2+(\\sqrt5)^2=14","نظرية فيثاغورس في <span class=\"tx\" data-t=\"\\triangle ABQ\"></span>"],["BQ=\\sqrt{14}\\ \\text{cm}","بأخذ الجذر التربيعي"],["\\triangle BQP:\\ \\angle BQP=90^\\circ,\\ \\angle QBP=30^\\circ","مثلث ثلاثيني ستيني"],["BQ=\\sqrt3\\,PQ\\ \\Rightarrow\\ PQ=\\frac{\\sqrt{14}}{\\sqrt3}","الضلع المقابل للزاوية <span class=\"tx\" data-t=\"60^\\circ\"></span> يساوي <span class=\"tx\" data-t=\"\\sqrt3\"></span> مثل المقابل للزاوية <span class=\"tx\" data-t=\"30^\\circ\"></span>"],["PQ=\\frac{\\sqrt{14}}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}=\\frac{\\sqrt{42}}{3}","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"PQ=\\frac{\\sqrt{42}}{3}\\ \\text{cm}\\approx2.16\\ \\text{cm}\"></span>","o":"يمكن أيضًا: <span class=\"tx\" data-t=\"\\tan30^\\circ=\\frac{PQ}{BQ}\"></span> فيكون <span class=\"tx\" data-t=\"PQ=\\sqrt{14}\\times\\frac{1}{\\sqrt3}\"></span>."}],[{"n":"29","s":[["A=\\frac{1}{2}bh\\ \\Rightarrow\\ 20=\\frac{1}{2}(5-\\sqrt{10})h","مساحة المثلث، بالتعويض"],["h=\\frac{40}{5-\\sqrt{10}}","بضرب الطرفين في <span class=m dir=ltr>2</span> ثم القسمة على <span class=\"tx\" data-t=\"5-\\sqrt{10}\"></span>"],["=\\frac{40}{5-\\sqrt{10}}\\times\\frac{5+\\sqrt{10}}{5+\\sqrt{10}}=\\frac{40(5+\\sqrt{10})}{25-10}","بضرب البسط والمقام في مرافق المقام"],["=\\frac{40(5+\\sqrt{10})}{15}=\\frac{40+8\\sqrt{10}}{3}","بالتبسيط"]],"a":"ارتفاع المثلث <span class=\"tx\" data-t=\"\\frac{40+8\\sqrt{10}}{3}\\ \\text{cm}\\approx21.77\\ \\text{cm}\"></span>","o":"مسألة اليوم: مثلث مساحته <span class=\"tx\" data-t=\"20\\ \\text{cm}^2\"></span> وقاعدته <span class=\"tx\" data-t=\"5-\\sqrt{10}\\ \\text{cm}\"></span>."}],[{"n":"30","s":[["\\sqrt[5]{7yx^8}=\\sqrt[5]{x^5\\times7x^3y}=x\\sqrt[5]{7x^3y}","<span class=\"tx\" data-t=\"x^8\"></span> يحوي عاملًا قوته <span class=m dir=ltr>5 (</span>دليل الجذر)"],["\\frac{\\sqrt{xy}}{y^3},\\ \\sqrt[4]{xy^3},\\ \\sqrt{5yx}","لا يحوي أي منها عاملًا قوته <span class=m dir=ltr>≥</span> الدليل، ولا كسرًا تحت الجذر، ولا جذرًا في المقام"]],"a":"المختلف هو <span class=\"tx\" data-t=\"\\sqrt[5]{7yx^8}\"></span>؛ لأنه ليس في أبسط صورة، أما الثلاثة الأخرى فهي في أبسط صورة","o":""}],[{"n":"31","s":[["\\sqrt[6]{g^6}=|g|","الخطأ: الدليل زوجي، فيجب كتابة <span class=\"tx\" data-t=\"|g|\"></span> لا <span class=\"tx\" data-t=\"g\"></span>"],["\\sqrt[6]{64h^{12}g^6}=\\sqrt[6]{2^6}\\times\\sqrt[6]{(h^2)^6}\\times\\sqrt[6]{g^6}","خاصية ضرب الجذور"],["=2h^2|g|","<span class=\"tx\" data-t=\"h^2\\ge0\"></span> فلا حاجة لقيمتها المطلقة"]],"a":"الناتج الصحيح <span class=\"tx\" data-t=\"2h^2|g|\"></span>","o":""}],[{"n":"32","s":[["8|x|y^2=\\sqrt{(8|x|y^2)^2}","الجذر التربيعي لمربع عدد غير سالب"],["=\\sqrt{64x^2y^4}","قوة الناتج"],["\\sqrt{64x^2y^4}=8|x|\\,y^2","تحقق: الدليل زوجي فنأخذ <span class=\"tx\" data-t=\"|x|\"></span>، و <span class=\"tx\" data-t=\"y^2\\ge0\"></span>"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\sqrt{64x^2y^4}\"></span>","o":"إجابة أخرى ممكنة: <span class=\"tx\" data-t=\"\\sqrt[4]{4096x^4y^8}\"></span>"}],[{"n":"33","s":[["\\frac{\\sqrt7}{3+\\sqrt7}\\times\\frac{3-\\sqrt7}{3-\\sqrt7}=\\frac{3\\sqrt7-7}{9-7}=\\frac{3\\sqrt7-7}{2}","إنطاق المقام الأول بالمرافق"],["\\frac{3}{2\\sqrt7-1}\\times\\frac{2\\sqrt7+1}{2\\sqrt7+1}=\\frac{3(2\\sqrt7+1)}{28-1}=\\frac{2\\sqrt7+1}{9}","إنطاق المقام الثاني بالمرافق"],["\\frac{3\\sqrt7-7}{2}-\\frac{2\\sqrt7+1}{9}=\\frac{9(3\\sqrt7-7)-2(2\\sqrt7+1)}{18}","بتوحيد المقامات"],["=\\frac{27\\sqrt7-63-4\\sqrt7-2}{18}=\\frac{23\\sqrt7-65}{18}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{23\\sqrt7-65}{18}\\approx-0.23\"></span>","o":""}],[{"n":"2","s":[["\\sqrt[3]{-24a^5}=\\sqrt[3]{(-2)^3a^3\\times3a^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=-2a\\sqrt[3]{3a^2}","خاصية ضرب الجذور"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"-2a\\sqrt[3]{3a^2}\"></span>","o":""}],[{"n":"3","s":[["\\sqrt[4]{\\frac{16t^4}{y^8}}=\\frac{\\sqrt[4]{2^4t^4}}{\\sqrt[4]{(y^2)^4}}","خاصية قسمة الجذور"],["=\\frac{2|t|}{y^2}","الدليل زوجي، و <span class=\"tx\" data-t=\"y^2&gt;0\"></span>"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\frac{2|t|}{y^2}\"></span>","o":""}],[{"n":"4","s":[["\\sqrt{20x^3}+\\sqrt{45x^3}=\\sqrt{4x^2\\times5x}+\\sqrt{9x^2\\times5x}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=2|x|\\sqrt{5x}+3|x|\\sqrt{5x}","خاصية ضرب الجذور"],["=5|x|\\sqrt{5x}","بجمع الجذور المتشابهة"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"5|x|\\sqrt{5x}\"></span>","o":"بما أن <span class=\"tx\" data-t=\"x^3\\ge0\"></span> تحت الجذر فإن <span class=\"tx\" data-t=\"x\\ge0\"></span>، أي أن <span class=\"tx\" data-t=\"|x|=x\"></span>."}],[{"n":"17","s":[["\\sqrt[3]{64y^6}=\\sqrt[3]{4^3(y^2)^3}=4y^2","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"]],"a":"<span class=\"tx\" data-t=\"4y^2\"></span>","o":""},{"n":"18","s":[["\\sqrt[5]{4a^8b^{14}c^5}=\\sqrt[5]{a^5(b^2)^5c^5\\times4a^3b^4}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=ab^2c\\sqrt[5]{4a^3b^4}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"ab^2c\\sqrt[5]{4a^3b^4}\"></span>","o":""},{"n":"19","s":[["\\frac{x}{\\sqrt[3]{y^8}}=\\frac{x}{y^2\\sqrt[3]{y^2}}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=\\frac{x}{y^2\\sqrt[3]{y^2}}\\times\\frac{\\sqrt[3]{y}}{\\sqrt[3]{y}}=\\frac{x\\sqrt[3]{y}}{y^3}","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"\\frac{x\\sqrt[3]{y}}{y^3}\"></span>","o":""},{"n":"20","s":[["\\sqrt[3]{\\frac{3a}{4b^4c}}=\\frac{\\sqrt[3]{3a}}{\\sqrt[3]{4b^4c}}","خاصية قسمة الجذور"],["=\\frac{\\sqrt[3]{3a}}{\\sqrt[3]{4b^4c}}\\times\\frac{\\sqrt[3]{2b^2c^2}}{\\sqrt[3]{2b^2c^2}}","لجعل المقام مكعبًا كاملًا <span class=\"tx\" data-t=\"8b^6c^3\"></span>"],["=\\frac{\\sqrt[3]{6ab^2c^2}}{2b^2c}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{\\sqrt[3]{6ab^2c^2}}{2b^2c}\"></span>","o":""},{"n":"21","s":[["\\sqrt[4]{1024x^9y^{12}}=\\sqrt[4]{4^4(x^2)^4(y^3)^4\\times4x}","<span class=\"tx\" data-t=\"1024=256\\times4\"></span>"],["=4x^2y^3\\sqrt[4]{4x}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"4x^2y^3\\sqrt[4]{4x}\"></span>","o":""},{"n":"22","s":[["\\sqrt{45x^2y^5z^8}=\\sqrt{9x^2(y^2)^2(z^4)^2\\times5y}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=3xy^2z^4\\sqrt{5y}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"3xy^2z^4\\sqrt{5y}\"></span>","o":""},{"n":"23","s":[["\\sqrt[4]{16(y+x)^4}=\\sqrt[4]{2^4(y+x)^4}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=2(y+x)","المتغيرات موجبة"]],"a":"<span class=\"tx\" data-t=\"2(y+x)\"></span>","o":""},{"n":"24","s":[["3\\sqrt[4]{x^4y^8}=3\\sqrt[4]{x^4(y^2)^4}=3xy^2","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"]],"a":"<span class=\"tx\" data-t=\"3xy^2\"></span>","o":""},{"n":"25","s":[["\\sqrt[3]{125r^4s^9t^7}=\\sqrt[3]{5^3r^3(s^3)^3(t^2)^3\\times rt}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["=5rs^3t^2\\sqrt[3]{rt}","خاصية ضرب الجذور"]],"a":"<span class=\"tx\" data-t=\"5rs^3t^2\\sqrt[3]{rt}\"></span>","o":""},{"n":"26","s":[["\\sqrt[3]{\\frac{250f^7g^3}{2f^2g}}=\\sqrt[3]{125f^5g^2}","خاصية قسمة القوى"],["=\\sqrt[3]{5^3f^3\\times f^2g^2}=5f\\sqrt[3]{f^2g^2}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"]],"a":"<span class=\"tx\" data-t=\"5f\\sqrt[3]{f^2g^2}\"></span>","o":""},{"n":"27","s":[["\\frac{\\sqrt[5]{64x^6}}{\\sqrt[5]{2x}}=\\sqrt[5]{32x^5}","خاصية قسمة الجذور"],["=2x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2x\"></span>","o":""},{"n":"28","s":[["\\sqrt[3]{12}\\times\\sqrt[3]{4}=\\sqrt[3]{48}=\\sqrt[3]{8\\times6}","خاصية ضرب الجذور"],["=2\\sqrt[3]{6}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2\\sqrt[3]{6}\"></span>","o":""},{"n":"29","s":[["\\sqrt{x^5y^5}\\times3\\sqrt{2x^7y^6}=3\\sqrt{2x^{12}y^{11}}","خاصية ضرب الجذور"],["=3\\sqrt{(x^6)^2(y^5)^2\\times2y}=3x^6y^5\\sqrt{2y}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"]],"a":"<span class=\"tx\" data-t=\"3x^6y^5\\sqrt{2y}\"></span>","o":""},{"n":"30","s":[["4\\sqrt[3]{81}=4\\sqrt[3]{27\\times3}=12\\sqrt[3]{3}","بالتحليل إلى عوامل مرفوعة إلى أس يساوي دليل الجذر"],["2\\sqrt[3]{72}=2\\sqrt[3]{8\\times9}=4\\sqrt[3]{9},\\quad \\sqrt[3]{24}=\\sqrt[3]{8\\times3}=2\\