[[{"n":"1","s":[["\\vec{a}=\\overrightarrow{OA}","ضلع أفقي واحد نحو اليمين"],["\\overrightarrow{AC}=\\overrightarrow{BD}=\\overrightarrow{EH}=\\vec{a}","لها المقدار نفسه والاتجاه نفسه"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\overrightarrow{AC},\\ \\overrightarrow{BD},\\ \\overrightarrow{EH}\"></span> (ومنها أيضًا <span class=\"tx\" data-t=\"\\overrightarrow{CF},\\overrightarrow{DG},\\overrightarrow{GI},\\overrightarrow{HJ},\\overrightarrow{JK}\"></span>)","o":"من الشكل: كل ضلع أفقي صغير يمثل <span class=\"tx\" data-t=\"\\vec{a}\"></span> وكل ضلع مائل صغير يمثل <span class=\"tx\" data-t=\"\\vec{b}\"></span>"},{"n":"2","s":[["\\vec{b}=\\overrightarrow{OB}","ضلع مائل واحد نحو الأعلى"],["\\overrightarrow{AD}\\parallel\\vec{b},\\ \\overrightarrow{CG}\\parallel\\vec{b},\\ \\overrightarrow{BE}\\parallel\\vec{b}","تقع على مستقيمات موازية لـ <span class=m dir=ltr>OB</span>"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\overrightarrow{AD},\\ \\overrightarrow{CG},\\ \\overrightarrow{BE}\"></span> (ومنها <span class=\"tx\" data-t=\"\\overrightarrow{FI},\\overrightarrow{DH},\\overrightarrow{BO}\"></span>)","o":""},{"n":"3","s":[["-\\vec{a}","المتجه المعاكس: المقدار نفسه والاتجاه المعاكس (نحو اليسار)"],["\\overrightarrow{AO}=\\overrightarrow{CA}=\\overrightarrow{DB}=-\\vec{a}",""]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\overrightarrow{AO},\\ \\overrightarrow{CA},\\ \\overrightarrow{DB}\"></span>","o":""},{"n":"4","s":[["\\overrightarrow{OD}=\\vec{a}+\\vec{b}","قطر متوازي أضلاع صغير"],["\\overrightarrow{AG}=\\overrightarrow{CI}=\\overrightarrow{BH}=\\vec{a}+\\vec{b}","أقطار موازية ومساوية له"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\overrightarrow{AG},\\ \\overrightarrow{CI},\\ \\overrightarrow{BH}\"></span> (ومنها <span class=\"tx\" data-t=\"\\overrightarrow{DJ},\\overrightarrow{GK}\"></span>)","o":""},{"n":"5","s":[["\\overrightarrow{OG}=2\\vec{a}+\\vec{b}","ضلعان أفقيان ثم ضلع مائل"],["\\overrightarrow{AI}=\\overrightarrow{BJ}=\\overrightarrow{DK}=2\\vec{a}+\\vec{b}",""]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AI},\\ \\overrightarrow{BJ},\\ \\overrightarrow{DK}\"></span>","o":""}],[{"n":"6","s":[["\\overrightarrow{OC}=\\overrightarrow{OA}+\\overrightarrow{AC}=\\vec{a}+\\vec{a}","قاعدة المثلث"],["=2\\vec{a}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OC}=2\\vec{a}\"></span>","o":""},{"n":"7","s":[["\\overrightarrow{OE}=\\overrightarrow{OB}+\\overrightarrow{BE}=\\vec{b}+\\vec{b}","متجه الموقع يبدأ من <span class=m dir=ltr>O</span>"],["=2\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OE}=2\\vec{b}\"></span>","o":""},{"n":"8","s":[["\\overrightarrow{OF}=\\overrightarrow{OA}+\\overrightarrow{AC}+\\overrightarrow{CF}","متجه الموقع للنقطة <span class=m dir=ltr>F</span>"],["=3\\vec{a}","ثلاثة أضلاع أفقية"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OF}=3\\vec{a}\"></span>","o":""},{"n":"9","s":[["\\overrightarrow{OG}=\\overrightarrow{OC}+\\overrightarrow{CG}","قاعدة المثلث"],["=2\\vec{a}+\\vec{b}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OG}=2\\vec{a}+\\vec{b}\"></span>","o":""},{"n":"10","s":[["\\overrightarrow{AG}=\\overrightarrow{AC}+\\overrightarrow{CG}","قاعدة المثلث"],["=\\vec{a}+\\vec{b}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AG}=\\vec{a}+\\vec{b}\"></span>","o":""},{"n":"11","s":[["\\overrightarrow{OK}=\\overrightarrow{OF}+\\overrightarrow{FK}","قاعدة المثلث"],["=3\\vec{a}+2\\vec{b}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OK}=3\\vec{a}+2\\vec{b}\"></span>","o":""}],[{"n":"12","s":[["\\vec{a}+\\vec{c}=\\langle 34+9,\\ -86+(-1)\\rangle","جمع المركبات المتناظرة"],["=\\langle 43,-87\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle 43,-87\\rangle\"></span>","o":""},{"n":"13","s":[["\\vec{b}-\\vec{a}=\\langle -65-34,\\ 17-(-86)\\rangle","طرح المركبات المتناظرة"],["=\\langle -99,103\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -99,103\\rangle\"></span>","o":""},{"n":"14","s":[["3\\vec{c}=\\langle 27,-3\\rangle","ضرب المتجه في عدد ثابت"],["3\\vec{c}+\\vec{b}=\\langle 27+(-65),\\ -3+17\\rangle","جمع المركبات"],["=\\langle -38,14\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -38,14\\rangle\"></span>","o":""},{"n":"15","s":[["2\\vec{c}=\\langle 18,-2\\rangle","ضرب المتجه في عدد ثابت"],["\\vec{a}+\\vec{b}-2\\vec{c}=\\langle 34-65-18,\\ -86+17+2\\rangle","جمع المركبات وطرحها"],["=\\langle -49,-67\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -49,-67\\rangle\"></span>","o":""}],[{"n":"16","s":[["\\overrightarrow{OC}=2\\vec{a}+3\\vec{b}","من <span class=m dir=ltr>O</span> نتحرك ضلعين أفقيين نحو اليمين ثم <span class=m dir=ltr>3</span> أضلاع مائلة نحو الأعلى"]],"a":"<span class=m dir=ltr>C</span> على الخط العلوي للشبكة، عند ثالث نقطة من اليسار (بعد ضلعين من الزاوية العلوية اليسرى)","o":""},{"n":"17","s":[["\\overrightarrow{OD}=2\\vec{a}+\\vec{b}","ضلعان أفقيان ثم ضلع مائل واحد"]],"a":"<span class=m dir=ltr>D</span> على الخط الذي يمر بـ <span class=m dir=ltr>B</span>، عند ثالث نقطة من اليسار (بعد ضلعين من <span class=m dir=ltr>B)</span>","o":""},{"n":"18","s":[["\\overrightarrow{OE}=4\\vec{a}","أربعة أضلاع أفقية على الخط السفلي"]],"a":"<span class=m dir=ltr>E</span> على الخط السفلي عند الزاوية اليمنى السفلى للشكل (بعد <span class=m dir=ltr>4</span> أضلاع من <span class=m dir=ltr>O)</span>","o":""},{"n":"19","s":[["\\overrightarrow{OF}=4\\vec{a}+2\\vec{b}","أربعة أضلاع أفقية ثم ضلعان مائلان"]],"a":"<span class=m dir=ltr>F</span> على الخط الثالث من الأسفل (الخط الثاني من الأعلى) عند طرفه الأيمن","o":""}],[{"n":"20","s":[["3x-y=7,\\quad y-x^2=-5","المتجهان المتساويان مركباتهما المتناظرة متساوية"],["y=x^2-5","من المعادلة الثانية"],["3x-(x^2-5)=7\\ \\Rightarrow\\ x^2-3x+2=0","بالتعويض في المعادلة الأولى والتبسيط"],["(x-1)(x-2)=0\\ \\Rightarrow\\ x=1\\ \\text{or}\\ x=2","بالتحليل وخاصية الضرب الصفري"],["x=1\\Rightarrow y=-4,\\quad x=2\\Rightarrow y=-1","بالتعويض في <span class=m dir=ltr>y = x² − 5</span>"]],"a":"<span class=\"tx\" data-t=\"x=1,\\ y=-4\"></span> أو <span class=\"tx\" data-t=\"x=2,\\ y=-1\"></span>","o":"تحقق: <span class=\"tx\" data-t=\"\\langle 3(1)+4,\\ -4-1\\rangle=\\langle 7,-5\\rangle\"></span> و <span class=\"tx\" data-t=\"\\langle 6+1,\\ -1-4\\rangle=\\langle 7,-5\\rangle\"></span>"}],[{"n":"21","s":[["\\vec{e}+\\vec{f}=\\langle -3+2,\\ -2+4\\rangle","إجراء العملية على المركبات"],["=\\langle -1,2\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -1,2\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"\\vec{e}\"></span> من الأصل إلى <span class=\"tx\" data-t=\"(-3,-2)\"></span> ثم <span class=\"tx\" data-t=\"\\vec{f}\"></span> من رأسه إلى <span class=\"tx\" data-t=\"(-1,2)\"></span>؛ المحصلة سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(-1,2)\"></span>"},{"n":"22","s":[["3\\vec{f}=\\langle 3\\times2,\\ 3\\times4\\rangle","إجراء العملية على المركبات"],["=\\langle 6,12\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle 6,12\\rangle\"></span>","o":"سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(6,12)\"></span>، باتجاه <span class=\"tx\" data-t=\"\\vec{f}\"></span> نفسه وطوله <span class=m dir=ltr>3</span> أمثال طوله"},{"n":"23","s":[["\\vec{e}-\\vec{f}=\\vec{e}+(-\\vec{f})=\\langle -3-2,\\ -2-4\\rangle","إجراء العملية على المركبات"],["=\\langle -5,-6\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -5,-6\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"\\vec{e}\"></span> ثم <span class=\"tx\" data-t=\"-\\vec{f}=\\langle -2,-4\\rangle\"></span> من رأسه؛ المحصلة سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(-5,-6)\"></span>"},{"n":"24","s":[["\\vec{f}-\\vec{e}=\\langle 2-(-3),\\ 4-(-2)\\rangle","إجراء العملية على المركبات"],["=\\langle 5,6\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle 5,6\\rangle\"></span>","o":"سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(5,6)\"></span>؛ وهو معاكس لـ <span class=\"tx\" data-t=\"\\vec{e}-\\vec{f}\"></span>"},{"n":"25","s":[["4\\vec{e}=\\langle 4\\times(-3),\\ 4\\times(-2)\\rangle","إجراء العملية على المركبات"],["=\\langle -12,-8\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle -12,-8\\rangle\"></span>","o":"سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(-12,-8)\"></span>، باتجاه <span class=\"tx\" data-t=\"\\vec{e}\"></span> نفسه"},{"n":"26","s":[["2\\vec{f}+\\vec{e}=\\langle 4+(-3),\\ 8+(-2)\\rangle","إجراء العملية على المركبات"],["=\\langle 1,6\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\langle 1,6\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"2\\vec{f}=\\langle 4,8\\rangle\"></span> ثم <span class=\"tx\" data-t=\"\\vec{e}\"></span> من رأسه؛ المحصلة سهم من <span class=\"tx\" data-t=\"(0,0)\"></span> إلى <span class=\"tx\" data-t=\"(1,6)\"></span>"}],[{"n":"27","s":[["4\\vec{d}-3\\vec{e}=\\langle 20-33,\\ 36-(-24)\\rangle=\\langle -13,60\\rangle","ضرب المتجهين في عددين ثم الطرح"],["|4\\vec{d}-3\\vec{e}|=\\sqrt{(-13)^2+60^2}=\\sqrt{169+3600}=\\sqrt{3769}\\approx 61.39","صيغة مقدار المتجه"],["\\frac{1}{3}\\vec{e}=\\left\\langle \\frac{11}{3},-\\frac{8}{3}\\right\\rangle","ضرب المتجه في عدد"],["\\left|\\frac{1}{3}\\vec{e}\\right|=\\sqrt{\\frac{121}{9}+\\frac{64}{9}}=\\frac{\\sqrt{185}}{3}\\approx 4.53","صيغة مقدار المتجه"]],"a":"<span class=\"tx\" data-t=\"|4\\vec{d}-3\\vec{e}|=\\sqrt{3769}\\approx 61.39\"></span> ، <span class=\"tx\" data-t=\"|\\frac{1}{3}\\vec{e}|=\\frac{\\sqrt{185}}{3}\\approx 4.53\"></span>","o":""}],[{"n":"28","s":[["\\overrightarrow{OF}=\\overrightarrow{OC}+\\overrightarrow{CF}","قاعدة المثلث"],["=3\\vec{a}+2\\vec{b}","لأن <span class=m dir=ltr>CF</span> يوازي <span class=m dir=ltr>OD</span> ويساويه"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OF}=3\\vec{a}+2\\vec{b}\"></span>","o":"من الشكل: <span class=\"tx\" data-t=\"\\overrightarrow{OC}=3\\vec{a}\"></span> ، <span class=\"tx\" data-t=\"\\overrightarrow{OD}=2\\vec{b}\"></span> ، <span class=\"tx\" data-t=\"\\overrightarrow{OE}=\\vec{a}+2\\vec{b}\"></span> ، <span class=\"tx\" data-t=\"\\overrightarrow{OG}=3\\vec{a}+\\vec{b}\"></span>"},{"n":"29","s":[["\\overrightarrow{OG}=\\overrightarrow{OC}+\\overrightarrow{CG}","قاعدة المثلث"],["=3\\vec{a}+\\vec{b}","لأن <span class=m dir=ltr>CG</span> يساوي <span class=m dir=ltr>OB</span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OG}=3\\vec{a}+\\vec{b}\"></span>","o":""},{"n":"30","s":[["\\overrightarrow{EG}=\\overrightarrow{OG}-\\overrightarrow{OE}","طرح متجهي الموقع"],["=(3\\vec{a}+\\vec{b})-(\\vec{a}+2\\vec{b})","بالتعويض"],["=2\\vec{a}-\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{EG}=2\\vec{a}-\\vec{b}\"></span>","o":""},{"n":"31","s":[["\\overrightarrow{CE}=\\overrightarrow{OE}-\\overrightarrow{OC}","طرح متجهي الموقع"],["=(\\vec{a}+2\\vec{b})-3\\vec{a}","بالتعويض"],["=-2\\vec{a}+2\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CE}=2\\vec{b}-2\\vec{a}\"></span>","o":""}],[{"n":"32","s":[["\\overrightarrow{BC}=\\overrightarrow{OC}-\\overrightarrow{OB}=3\\vec{a}-\\vec{b}","طرح متجهي الموقع"],["\\overrightarrow{DG}=\\overrightarrow{OG}-\\overrightarrow{OD}=(3\\vec{a}+\\vec{b})-2\\vec{b}=3\\vec{a}-\\vec{b}","طرح متجهي الموقع"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{BC}\"></span> و <span class=\"tx\" data-t=\"\\overrightarrow{DG}\"></span> ، كلٌّ منهما يساوي <span class=\"tx\" data-t=\"3\\vec{a}-\\vec{b}\"></span>","o":""}],[{"n":"33","s":[["\\vec{u}=\\langle 0,-40\\rangle,\\quad \\vec{v}=\\langle 70,0\\rangle","الشرق اتجاه <span class=m dir=ltr>x</span> الموجب والجنوب اتجاه <span class=m dir=ltr>y</span> السالب"],["\\vec{u}+\\vec{v}=\\langle 0+70,\\ -40+0\\rangle=\\langle 70,-40\\rangle","جمع المتجهات"],["|\\vec{u}+\\vec{v}|=\\sqrt{70^2+(-40)^2}=\\sqrt{6500}","صيغة مقدار المتجه"],["=10\\sqrt{65}\\approx 80.62","بالتبسيط"]],"a":"المحصلة <span class=\"tx\" data-t=\"\\langle 70,-40\\rangle\"></span> ، وبُعد القارب عن نقطة انطلاقه <span class=\"tx\" data-t=\"\\approx 80.62\"></span> <span class=m dir=ltr>km</span>","o":""}],[{"n":"34","s":[["\\overrightarrow{OC}=2\\vec{a}-\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>C</span>: من <span class=m dir=ltr>O</span> ضلعان نحو اليمين ثم ضلع مائل نحو الأسفل؛ أي على الخط الأفقي الثالث من الأعلى، عند النقطة الثانية من اليمين","o":"خط <span class=m dir=ltr>O</span> هو الخط الأفقي الثاني من الأعلى، و<span class=m dir=ltr>O</span> تقع عند النقطة الوسطى منه؛ الشبكة تمتد من <span class=\"tx\" data-t=\"-2\\vec{a}\"></span> إلى <span class=\"tx\" data-t=\"2\\vec{a}\"></span> ومن <span class=\"tx\" data-t=\"-2\\vec{b}\"></span> إلى <span class=\"tx\" data-t=\"\\vec{b}\"></span>"},{"n":"35","s":[["\\overrightarrow{OD}=2\\vec{a}+\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>D</span>: ضلعان نحو اليمين ثم ضلع مائل نحو الأعلى؛ أي الزاوية العلوية اليمنى للشكل","o":""},{"n":"36","s":[["\\overrightarrow{OE}=\\vec{a}-2\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>E</span>: ضلع نحو اليمين ثم ضلعان مائلان نحو الأسفل؛ على الخط السفلي، عند النقطة الثانية من اليمين","o":""},{"n":"37","s":[["\\overrightarrow{OF}=-2\\vec{a}+\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>F</span>: ضلعان نحو اليسار ثم ضلع مائل نحو الأعلى؛ أي الزاوية العلوية اليسرى للشكل","o":""},{"n":"38","s":[["\\overrightarrow{OG}=-\\vec{a}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>G</span>: على خط <span class=m dir=ltr>O</span> نفسه، ضلع واحد يسار <span class=m dir=ltr>O</span>","o":""},{"n":"39","s":[["\\overrightarrow{OH}=-\\vec{a}-2\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>H</span>: ضلع نحو اليسار ثم ضلعان مائلان نحو الأسفل؛ على الخط السفلي، عند النقطة الثانية من اليسار","o":""},{"n":"40","s":[["\\overrightarrow{OI}=2\\vec{a}-2\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>I</span>: ضلعان نحو اليمين ثم ضلعان مائلان نحو الأسفل؛ أي الزاوية السفلية اليمنى للشكل","o":""},{"n":"41","s":[["\\overrightarrow{OJ}=-\\vec{a}+\\vec{b}","نبدأ من <span class=m dir=ltr>O</span> ونتحرك حسب معاملي <span class=m dir=ltr>a (</span>أفقيًا) و <span class=m dir=ltr>b (</span>على الأضلاع المائلة)"]],"a":"<span class=m dir=ltr>J</span>: على الخط العلوي، ضلع واحد يسار <span class=m dir=ltr>B (</span>النقطة الثانية من اليسار)","o":""}],[{"n":"42","s":[["\\overrightarrow{AB}=\\overrightarrow{AO}+\\overrightarrow{OB}","قاعدة المثلث"],["=-\\vec{a}+\\vec{b}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\vec{b}-\\vec{a}\"></span>","o":""},{"n":"43","s":[["AC:CB=2:5\\ \\Rightarrow\\ \\overrightarrow{AC}=\\frac{2}{7}\\overrightarrow{AB}","<span class=m dir=ltr>C</span> تقسم <span class=m dir=ltr>AB</span> بنسبة <span class=m dir=ltr>2</span>:<span class=m dir=ltr>5</span>"],["=\\frac{2}{7}(\\vec{b}-\\vec{a})","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AC}=\\frac{2}{7}\\vec{b}-\\frac{2}{7}\\vec{a}\"></span>","o":""},{"n":"44","s":[["\\overrightarrow{OC}=\\overrightarrow{OA}+\\overrightarrow{AC}","قاعدة المثلث"],["=\\vec{a}+\\frac{2}{7}(\\vec{b}-\\vec{a})","بالتعويض"],["=\\frac{5}{7}\\vec{a}+\\frac{2}{7}\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OC}=\\frac{5}{7}\\vec{a}+\\frac{2}{7}\\vec{b}\"></span>","o":""}],[{"n":"45","s":[["\\overrightarrow{PQ}=\\overrightarrow{OQ}-\\overrightarrow{OP}=\\vec{b}-\\vec{a}","طرح متجهي الموقع"],["\\overrightarrow{OR}=\\overrightarrow{OP}+\\frac{2}{3}\\overrightarrow{PQ}=\\vec{a}+\\frac{2}{3}(\\vec{b}-\\vec{a})=\\frac{1}{3}\\vec{a}+\\frac{2}{3}\\vec{b}","<span class=m dir=ltr>R</span> تقسم <span class=m dir=ltr>PQ</span> بنسبة <span class=m dir=ltr>2</span>:<span class=m dir=ltr>1</span>"],["\\overrightarrow{OS}=\\frac{3}{2}\\overrightarrow{OR}=\\frac{1}{2}\\vec{a}+\\vec{b}","<span class=m dir=ltr>R</span> تقسم <span class=m dir=ltr>OS</span> بنسبة <span class=m dir=ltr>2</span>:<span class=m dir=ltr>1</span> أي <span class=m dir=ltr>OR =</span> ⅔ <span class=m dir=ltr>OS</span>"],["\\overrightarrow{QS}=\\overrightarrow{OS}-\\overrightarrow{OQ}=\\frac{1}{2}\\vec{a}+\\vec{b}-\\vec{b}=\\frac{1}{2}\\vec{a}","طرح متجهي الموقع"],["\\overrightarrow{QS}=\\frac{1}{2}\\overrightarrow{OP}","أحدهما مضاعف عددي للآخر"]],"a":"بما أن <span class=\"tx\" data-t=\"\\overrightarrow{QS}=\\frac{1}{2}\\overrightarrow{OP}\"></span> فإن المتجهين متوازيان (وطول <span class=m dir=ltr>QS</span> نصف طول <span class=m dir=ltr>OP)</span>","o":""}],[{"n":"46","s":[["\\overrightarrow{AB}=\\overrightarrow{AO}+\\overrightarrow{OB}","قاعدة المثلث"],["=-\\vec{a}+\\vec{b}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\vec{b}-\\vec{a}\"></span>","o":""},{"n":"47","s":[["\\overrightarrow{ON}=\\vec{a}+\\frac{1}{2}(\\vec{b}-\\vec{a})=\\frac{1}{2}(\\vec{a}+\\vec{b})","<span class=m dir=ltr>N</span> منتصف <span class=m dir=ltr>AB</span>"],["M\\in\\overline{ON}","في المثلث المتطابق الأضلاع العمود من <span class=m dir=ltr>O</span> على <span class=m dir=ltr>AB</span> يمر بالمركز <span class=m dir=ltr>M</span> وبمنتصف <span class=m dir=ltr>AB</span>"],["\\overrightarrow{OM}=\\frac{2}{3}\\overrightarrow{ON}","المركز يقسم القطعة من الرأس بنسبة <span class=m dir=ltr>2</span>:<span class=m dir=ltr>1</span>"],["=\\frac{2}{3}\\times\\frac{1}{2}(\\vec{a}+\\vec{b})=\\frac{1}{3}(\\vec{a}+\\vec{b})","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OM}=\\frac{1}{3}(\\vec{a}+\\vec{b})\"></span> وهو المطلوب","o":""}],[{"n":"5","s":[["\\vec{v}-\\vec{u}=\\langle 1-(-3),\\ 5-(-1)\\rangle=\\langle 4,6\\rangle","طرح المتجهات"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"\\langle 4,6\\rangle\"></span>","o":""},{"n":"6","s":[["\\vec{p}=\\langle -3,-1\\rangle+2\\langle 1,5\\rangle=\\langle -1,9\\rangle","ضرب متجه في عدد ثم الجمع"],["|\\vec{p}|=\\sqrt{1+81}=\\sqrt{82}","صيغة مقدار المتجه"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\sqrt{82}\"></span>","o":""},{"n":"7","s":[["\\vec{u}+\\vec{v}=\\langle -2,4\\rangle","جمع المتجهات"],["-(\\vec{u}+\\vec{v})=\\langle 2,-4\\rangle","المعكوس: نضرب في <span class=\"tx\" data-t=\"-1\"></span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"\\langle 2,-4\\rangle\"></span>","o":""}],[{"n":"9","s":[["\\overrightarrow{AB}=\\langle 2-4,\\ -3-(-1)\\rangle=\\langle -2,-2\\rangle",""],["\\overrightarrow{AC}=-2\\langle -2,-2\\rangle=\\langle 4,4\\rangle",""],["C=(4+4,\\ -1+4)=(8,3)","إحداثيات <span class=\"tx\" data-t=\"C\"></span> <span class=m dir=ltr>=</span> إحداثيات <span class=\"tx\" data-t=\"A\"></span> <span class=m dir=ltr>+</span> مركبتا <span class=\"tx\" data-t=\"\\overrightarrow{AC}\"></span>"]],"a":"<span class=\"tx\" data-t=\"C(8,3)\"></span>","o":""},{"n":"10","s":[["\\overrightarrow{DB}=\\langle 2-7,\\ -3-1\\rangle=\\langle -5,-4\\rangle",""],["\\overrightarrow{DC}=\\frac{1}{3}\\langle -5,-4\\rangle=\\left\\langle -\\frac{5}{3},-\\frac{4}{3}\\right\\rangle",""],["C=\\left(7-\\frac{5}{3},\\ 1-\\frac{4}{3}\\right)=\\left(\\frac{16}{3},-\\frac{1}{3}\\right)","إحداثيات <span class=\"tx\" data-t=\"D\"></span> <span class=m dir=ltr>+</span> مركبتا <span class=\"tx\" data-t=\"\\overrightarrow{DC}\"></span>"]],"a":"<span class=\"tx\" data-t=\"C\\left(\\frac{16}{3},-\\frac{1}{3}\\right)\"></span>","o":""}],[{"n":"11","s":[["\\vec{u}=\\vec{v}\\Rightarrow |\\vec{u}|=|\\vec{v}|","المتجهان المتساويان لهما المقدار نفسه والاتجاه نفسه"]],"a":"العبارة صحيحة","o":""},{"n":"12","s":[["\\vec{u}\\parallel\\vec{v}\\iff \\vec{u}=k\\vec{v}","التوازي يعني أن أحدهما مضاعف للآخر"],["\\langle 1,2\\rangle\\parallel\\langle 2,4\\rangle,\\ \\ \\sqrt{5}\\ne 2\\sqrt{5}","مثال مضاد"]],"a":"العبارة خاطئة؛ والصواب: المتجهان المتوازيان لهما الاتجاه نفسه أو اتجاهان متعاكسان، وقد يختلف مقدارهما (المتجهان المتساويان هما اللذان لهما المقدار والاتجاه نفسهما)","o":""}],[{"n":"14","s":[["A(1,2),\\ B(3,3),\\ C(6,3)","من الرسم"],["\\overrightarrow{AB}=\\langle 2,1\\rangle,\\ \\ \\overrightarrow{AE}=2\\overrightarrow{AB}=\\langle 4,2\\rangle",""],["E=(1+4,\\ 2+2)=(5,4)",""]],"a":"<span class=\"tx\" data-t=\"E(5,4)\"></span>","o":""},{"n":"15","s":[["\\overrightarrow{CD}=-2\\langle 2,1\\rangle=\\langle -4,-2\\rangle",""],["D=(6-4,\\ 3-2)=(2,1)",""]],"a":"<span class=\"tx\" data-t=\"D(2,1)\"></span>","o":""},{"n":"16","s":[["\\overrightarrow{AM}=\\frac{1}{2}\\overrightarrow{AB}=\\left\\langle 1,\\frac{1}{2}\\right\\rangle","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["M=\\left(2,\\ 2.5\\right)","<span class=\"tx\" data-t=\"M\"></span> منتصف <span class=\"tx\" data-t=\"\\overline{AB}\"></span>"]],"a":"<span class=\"tx\" data-t=\"M(2,\\ 2.5)\"></span>","o":""},{"n":"17","s":[["\\overrightarrow{DC}=\\langle 6-2,\\ 3-1\\rangle=\\langle 4,2\\rangle",""],["\\langle 4,2\\rangle=k\\left\\langle 1,\\frac{1}{2}\\right\\rangle\\Rightarrow k=4","بمقارنة المركبات"]],"a":"<span class=\"tx\" data-t=\"k=4\"></span>","o":""}],[{"n":"23","s":[["\\vec{v}_1=\\langle 5,0\\rangle","سرعة حسام الأفقية"],["\\vec{v}_2=\\langle 20\\cos 38^\\circ,\\ 20\\sin 38^\\circ\\rangle\\approx\\langle 15.76,\\ 12.31\\rangle","سرعة القذف بالصورة الإحداثية"],["\\vec{v}=\\vec{v}_1+\\vec{v}_2\\approx\\langle 20.76,\\ 12.31\\rangle","المحصلة <span class=m dir=ltr>=</span> مجموع المتجهين"],["|\\vec{v}|=\\sqrt{20.76^2+12.31^2}\\approx 24.1\\ \\text{m/s}","مقدار المحصلة"],["\\theta=\\tan^{-1}\\frac{12.31}{20.76}\\approx 30.7^\\circ","اتجاه المحصلة مع الأفقي"]],"a":"محصلة سرعة الكرة <span class=\"tx\" data-t=\"\\approx\\langle 20.76,\\ 12.31\\rangle\"></span>؛ مقدارها <span class=\"tx\" data-t=\"\\approx 24.1\\ \\text{m/s}\"></span> بزاوية <span class=\"tx\" data-t=\"\\approx 30.7^\\circ\"></span> مع الأفقي","o":""}],[{"n":"27","s":[["\\overrightarrow{AB}=\\overrightarrow{AO}+\\overrightarrow{OB}","قاعدة المثلث"],["=-\\vec{a}+\\vec{b}",""]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\vec{b}-\\vec{a}\"></span>","o":""},{"n":"28","s":[["\\overrightarrow{OM}=\\overrightarrow{OA}+\\overrightarrow{AM}","قاعدة المثلث"],["\\overrightarrow{AM}=\\frac{1}{2}\\overrightarrow{AB}=\\frac{1}{2}(\\vec{b}-\\vec{a})","<span class=\"tx\" data-t=\"M\"></span> منتصف <span class=\"tx\" data-t=\"\\overline{AB}\"></span>"],["\\overrightarrow{OM}=\\vec{a}+\\frac{1}{2}\\vec{b}-\\frac{1}{2}\\vec{a}=\\frac{1}{2}(\\vec{a}+\\vec{b})","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OM}=\\frac{1}{2}(\\vec{a}+\\vec{b})\"></span> وهو المطلوب","o":""}],[{"n":"29","s":[["\\overrightarrow{AB}=\\overrightarrow{AO}+\\overrightarrow{OB}=-\\vec{a}+\\vec{b}","قاعدة المثلث"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\vec{b}-\\vec{a}\"></span>","o":""},{"n":"30","s":[["\\overrightarrow{OC}=\\overrightarrow{OB}+\\overrightarrow{BC}=\\vec{b}+\\overrightarrow{AO}=\\vec{b}-\\vec{a}","في السداسي المنتظم <span class=\"tx\" data-t=\"\\overrightarrow{BC}=\\overrightarrow{AO}\"></span>"],["BK=2AB\\Rightarrow \\overrightarrow{AK}=3\\overrightarrow{AB}=3(\\vec{b}-\\vec{a})","<span class=\"tx\" data-t=\"K\"></span> على امتداد <span class=\"tx\" data-t=\"\\overline{AB}\"></span>"],["\\overrightarrow{OK}=\\vec{a}+3\\vec{b}-3\\vec{a}=3\\vec{b}-2\\vec{a}",""],["\\overrightarrow{CK}=\\overrightarrow{OK}-\\overrightarrow{OC}=(3\\vec{b}-2\\vec{a})-(\\vec{b}-\\vec{a})",""]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CK}=2\\vec{b}-\\vec{a}\"></span>","o":""}],[{"n":"1","s":[["\\vec{a}=\\langle 1,2\\rangle,\\ \\vec{b}=\\langle 2,1\\rangle,\\ \\vec{c}=\\langle 0,3\\rangle","من الشبكة"],["\\vec{a}+\\vec{b}=\\langle 3,3\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle 3,3\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"\\vec{a}\"></span> ثم نرسم <span class=\"tx\" data-t=\"\\vec{b}\"></span> من رأسه، والمحصلة من ذيل <span class=\"tx\" data-t=\"\\vec{a}\"></span> إلى رأس <span class=\"tx\" data-t=\"\\vec{b}\"></span>: <span class=m dir=ltr>3</span> وحدات يمينًا و<span class=m dir=ltr>3</span> لأعلى"},{"n":"2","s":[["-\\vec{a}=\\langle -1,-2\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle -1,-2\\rangle\"></span>","o":"متجه بطول <span class=\"tx\" data-t=\"\\vec{a}\"></span> نفسه وعكس اتجاهه: وحدة يسارًا ووحدتان لأسفل"},{"n":"3","s":[["\\vec{a}-\\vec{c}=\\vec{a}+(-\\vec{c})=\\langle 1,-1\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle 1,-1\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"\\vec{a}\"></span> ثم <span class=\"tx\" data-t=\"-\\vec{c}\"></span> <span class=m dir=ltr>(3</span> وحدات لأسفل) من رأسه: المحصلة وحدة يمينًا ووحدة لأسفل"},{"n":"4","s":[["\\vec{b}-\\vec{a}=\\vec{b}+(-\\vec{a})=\\langle 1,-1\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle 1,-1\\rangle\"></span>","o":"نرسم <span class=\"tx\" data-t=\"\\vec{b}\"></span> ثم <span class=\"tx\" data-t=\"-\\vec{a}\"></span> من رأسه: المحصلة وحدة يمينًا ووحدة لأسفل"},{"n":"5","s":[["-\\vec{c}=\\langle 0,-3\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle 0,-3\\rangle\"></span>","o":"سهم رأسي طوله <span class=m dir=ltr>3</span> وحدات نحو الأسفل"},{"n":"6","s":[["-\\vec{a}-\\vec{b}=-(\\vec{a}+\\vec{b})=\\langle -3,-3\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\langle -3,-3\\rangle\"></span>","o":"<span class=m dir=ltr>3</span> وحدات يسارًا و<span class=m dir=ltr>3</span> لأسفل (معكوس <span class=\"tx\" data-t=\"\\vec{a}+\\vec{b}\"></span>)"}],[{"n":"7","s":[["\\overrightarrow{OH}=-\\overrightarrow{OB}","قاعدة المثلث، وكل ضلع أفقي صغير يمثّل <span class=\"tx\" data-t=\"\\vec{a}\"></span> وكل ضلع مائل صغير يمثّل <span class=\"tx\" data-t=\"\\vec{b}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OH}=-\\vec{b}\"></span>","o":"بأخذ <span class=\"tx\" data-t=\"O\"></span> أصلًا: <span class=\"tx\" data-t=\"A=\\vec{a}, F=2\\vec{a}, G=3\\vec{a}\"></span>، <span class=\"tx\" data-t=\"B=\\vec{b}, C=\\vec{a}+\\vec{b}, D=2\\vec{a}+\\vec{b}, E=3\\vec{a}+\\vec{b}\"></span>، <span class=\"tx\" data-t=\"H=-\\vec{b}, I=\\vec{a}-\\vec{b}, J=2\\vec{a}-\\vec{b}, K=3\\vec{a}-\\vec{b}\"></span>"},{"n":"8","s":[["\\overrightarrow{OK}=\\overrightarrow{OG}+\\overrightarrow{GK}=3\\vec{a}-\\vec{b}","قاعدة المثلث، وكل ضلع أفقي صغير يمثّل <span class=\"tx\" data-t=\"\\vec{a}\"></span> وكل ضلع مائل صغير يمثّل <span class=\"tx\" data-t=\"\\vec{b}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OK}=3\\vec{a}-\\vec{b}\"></span>","o":""},{"n":"9","s":[["\\overrightarrow{OJ}=\\overrightarrow{OF}+\\overrightarrow{FJ}=2\\vec{a}-\\vec{b}","قاعدة المثلث، وكل ضلع أفقي صغير يمثّل <span class=\"tx\" data-t=\"\\vec{a}\"></span> وكل ضلع مائل صغير يمثّل <span class=\"tx\" data-t=\"\\vec{b}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OJ}=2\\vec{a}-\\vec{b}\"></span>","o":""},{"n":"10","s":[["\\overrightarrow{OI}=\\overrightarrow{OA}+\\overrightarrow{AI}=\\vec{a}-\\vec{b}","قاعدة المثلث، وكل ضلع أفقي صغير يمثّل <span class=\"tx\" data-t=\"\\vec{a}\"></span> وكل ضلع مائل صغير يمثّل <span class=\"tx\" data-t=\"\\vec{b}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OI}=\\vec{a}-\\vec{b}\"></span>","o":""},{"n":"11","s":[["\\overrightarrow{O