[[{"n":"1","s":[["\\mu = 36","العبارة الرياضية للادّعاء (تحتوي على رمز المساواة)"],["H_0: \\mu = 36 \\quad H_1: \\mu \\ne 36","الفرضيتان"]],"a":"<span class=\"tx\" data-t=\"H_0: \\mu = 36\"></span> (الادّعاء)، <span class=\"tx\" data-t=\"H_1: \\mu \\ne 36\"></span>؛ الفرضية الصفرية تمثّل الادّعاء.","o":""},{"n":"2","s":[["\\mu \\ge 74","لا يقلّ عن <span class=m dir=ltr>74 (</span>تحتوي على رمز المساواة)"],["H_0: \\mu \\ge 74 \\quad H_1: \\mu < 74","الفرضيتان"]],"a":"<span class=\"tx\" data-t=\"H_0: \\mu \\ge 74\"></span> (الادّعاء)، <span class=\"tx\" data-t=\"H_1: \\mu &lt; 74\"></span>؛ الفرضية الصفرية تمثّل الادّعاء.","o":""},{"n":"3","s":[["\\mu < 10","أقل من <span class=m dir=ltr>10 (</span>لا تحتوي على رمز المساواة)"],["H_0: \\mu \\ge 10 \\quad H_1: \\mu < 10","الفرضيتان"]],"a":"<span class=\"tx\" data-t=\"H_0: \\mu \\ge 10\"></span>، <span class=\"tx\" data-t=\"H_1: \\mu &lt; 10\"></span> (الادّعاء)؛ الفرضية البديلة تمثّل الادّعاء.","o":""}],[{"n":"4","s":[["\\text{رفض } H_0: \\mu = 75 \\text{ وهي صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>I</span>"]],"a":"الخطأ من النوع <span class=m dir=ltr>I</span>: أن نستنتج أن العقار الجديد يُحدِث تغييرًا في الوسط الحسابي لمعدّل نبضات القلب (أي <span class=\"tx\" data-t=\"\\mu \\ne 75\"></span>)، في حين أنه في الحقيقة لا يُحدِث تغييرًا (<span class=\"tx\" data-t=\"\\mu = 75\"></span>).","o":""},{"n":"5","s":[["\\text{عدم رفض } H_0: \\mu = 75 \\text{ وهي غير صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>II</span>"]],"a":"الخطأ من النوع <span class=m dir=ltr>II</span>: أن نستنتج أن العقار لا يُحدِث تغييرًا في معدّل نبضات القلب (<span class=\"tx\" data-t=\"\\mu = 75\"></span>)، في حين أنه في الحقيقة يُحدِث تغييرًا (<span class=\"tx\" data-t=\"\\mu \\ne 75\"></span>).","o":""}],[{"n":"6","s":[["\\text{رفض } H_0: \\mu \\le 7 \\text{ وهي صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>I</span>"]],"a":"الخطأ من النوع <span class=m dir=ltr>I</span>: أن نستنتج أن استهلاك السيّارة يزيد على <span class=\"tx\" data-t=\"7\\text{ L}\"></span> لكل <span class=m dir=ltr>100 km</span> ونرفض ادّعاء الوكيل، في حين أن الاستهلاك في الحقيقة لا يزيد على <span class=\"tx\" data-t=\"7\\text{ L}\"></span>.","o":""},{"n":"7","s":[["\\text{عدم رفض } H_0: \\mu \\le 7 \\text{ وهي غير صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>II</span>"]],"a":"الخطأ من النوع <span class=m dir=ltr>II</span>: ألّا نرفض ادّعاء الوكيل فنستنتج أن الاستهلاك لا يزيد على <span class=\"tx\" data-t=\"7\\text{ L}\"></span> لكل <span class=m dir=ltr>100 km</span>، في حين أنه في الحقيقة يزيد على <span class=\"tx\" data-t=\"7\\text{ L}\"></span>.","o":""}],[{"n":"8","s":[["H_0: \\mu \\le 60 \\ (\\text{الادّعاء}) \\quad H_1: \\mu > 60","الخطوة <span class=m dir=ltr>1</span>: الفرضيتان"],["\\alpha = 0.10 \\Rightarrow z_\\alpha = 1.28","الخطوة <span class=m dir=ltr>2</span>: اختبار أحادي الطرف يمينًا"],["z = \\frac{\\overline{x} - \\mu}{\\sigma/\\sqrt{n}} = \\frac{63.2 - 60}{5.6/\\sqrt{49}} = \\frac{3.2}{0.8}","الخطوة <span class=m dir=ltr>3</span>: الإحصائي <span class=\"tx\" data-t=\"z\"></span>"],["z = 4 > 1.28","تقع ضمن المنطقة الحرجة"]],"a":"أرفض الفرضية الصفرية <span class=\"tx\" data-t=\"H_0\"></span>؛ أي توجد أدلّة كافية لرفض ادّعاء المصنع بأن مقدار فيتامين <span class=m dir=ltr>C</span> لا يتجاوز <span class=\"tx\" data-t=\"60\\text{ mg}\"></span>.","o":""}],[{"n":"9","s":[["H_0: \\mu \\le 170 \\quad H_1: \\mu > 170 \\ (\\text{الادّعاء})","الخطوة <span class=m dir=ltr>1</span>: الفرضيتان"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","الخطوة <span class=m dir=ltr>2</span>: اختبار أحادي الطرف يمينًا"],["z = \\frac{174 - 170}{7/\\sqrt{25}} = \\frac{4}{1.4} \\approx 2.86","الخطوة <span class=m dir=ltr>3</span>: الإحصائي <span class=\"tx\" data-t=\"z\"></span> (المجتمع طبيعي و <span class=\"tx\" data-t=\"\\sigma\"></span> معلوم)"],["2.86 > 1.64","تقع ضمن المنطقة الحرجة"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ أي توجد أدلّة كافية لدعم ادّعاء المحاضر بأن أطوال الطلبة الذكور تزيد على <span class=\"tx\" data-t=\"170\\text{ cm}\"></span>.","o":""}],[{"n":"10","s":[["H_0: \\mu = 33 \\ (\\text{الادّعاء}) \\quad H_1: \\mu \\ne 33","الخطوة <span class=m dir=ltr>1</span>: الفرضيتان"],["\\alpha = 0.01 \\Rightarrow \\frac{\\alpha}{2} = 0.005 \\Rightarrow z_\\alpha = \\pm 2.57","الخطوة <span class=m dir=ltr>2</span>: اختبار ثنائي الطرف"],["z = \\frac{35.6 - 33}{8.2/\\sqrt{64}} = \\frac{2.6}{1.025} \\approx 2.54","الخطوة <span class=m dir=ltr>3</span>: الإحصائي <span class=\"tx\" data-t=\"z\"></span> (<span class=\"tx\" data-t=\"n = 64 \\ge 30\"></span>)"],["-2.57 < 2.54 < 2.57","لا تقع ضمن المنطقة الحرجة"]],"a":"لا أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ أي لا توجد أدلّة كافية لرفض ادّعاء مدير التسويق بأن الوسط الحسابي لأعمار الزبائن <span class=m dir=ltr>33</span> عامًا.","o":""}],[{"n":"11","s":[["H_0: \\mu \\le 130 \\quad H_1: \\mu > 130 \\ (\\text{الادّعاء})","الخطوة <span class=m dir=ltr>1</span>: الفرضيتان"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","الخطوة <span class=m dir=ltr>2</span>: اختبار أحادي الطرف يمينًا"],["z = \\frac{138 - 130}{12/\\sqrt{70}} \\approx \\frac{8}{1.434} \\approx 5.58","الخطوة <span class=m dir=ltr>3</span>: الإحصائي <span class=\"tx\" data-t=\"z\"></span> (<span class=\"tx\" data-t=\"n = 70 \\ge 30\"></span>)"],["5.58 > 1.64","تقع ضمن المنطقة الحرجة"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ أي توجد أدلّة كافية لدعم ادّعاء الشركة بأن الوسط الحسابي لكتل أكياس الفول السوداني يزيد على <span class=\"tx\" data-t=\"130\\text{ g}\"></span>.","o":""}],[{"n":"12","s":[["H_0: \\mu \\ge 500 \\quad H_1: \\mu < 500 \\ (k)","الفرضيتان"],["\\alpha = 0.01 \\Rightarrow z_\\alpha = -2.32","اختبار أحادي الطرف يسارًا"],["z = \\frac{490 - 500}{27/\\sqrt{35}} \\approx \\frac{-10}{4.564} \\approx -2.19","الإحصائي <span class=\"tx\" data-t=\"z\"></span>"],["-2.19 > -2.32","لا تقع ضمن المنطقة الحرجة"]],"a":"<span class=\"tx\" data-t=\"z \\approx -2.19\"></span>؛ لا أرفض <span class=\"tx\" data-t=\"H_0\"></span>، أي لا توجد أدلّة كافية لدعم الادّعاء <span class=\"tx\" data-t=\"\\mu &lt; 500\"></span>.","o":""},{"n":"13","s":[["H_0: \\mu = 5500 \\quad H_1: \\mu \\ne 5500 \\ (k)","الفرضيتان"],["\\alpha = 0.01 \\Rightarrow z_\\alpha = \\pm 2.57","اختبار ثنائي الطرف"],["z = \\frac{5430 - 5500}{236/\\sqrt{200}} \\approx \\frac{-70}{16.69} \\approx -4.19","الإحصائي <span class=\"tx\" data-t=\"z\"></span>"],["-4.19 < -2.57","تقع ضمن المنطقة الحرجة"]],"a":"<span class=\"tx\" data-t=\"z \\approx -4.19\"></span>؛ أرفض <span class=\"tx\" data-t=\"H_0\"></span>، أي توجد أدلّة كافية لدعم الادّعاء <span class=\"tx\" data-t=\"\\mu \\ne 5500\"></span>.","o":""},{"n":"14","s":[["H_0: \\mu \\le 88 \\quad H_1: \\mu > 88 \\ (k)","الفرضيتان"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","اختبار أحادي الطرف يمينًا"],["z = \\frac{91.2 - 88}{3.9/\\sqrt{32}} \\approx \\frac{3.2}{0.689} \\approx 4.64","الإحصائي <span class=\"tx\" data-t=\"z\"></span>"],["4.64 > 1.64","تقع ضمن المنطقة الحرجة"]],"a":"<span class=\"tx\" data-t=\"z \\approx 4.64\"></span>؛ أرفض <span class=\"tx\" data-t=\"H_0\"></span>، أي توجد أدلّة كافية لدعم الادّعاء <span class=\"tx\" data-t=\"\\mu &gt; 88\"></span>.","o":""}],[{"n":"15","s":[["\\text{أيّ الخطأين أفضل؟ يعتمد على السياق}","عواقب كل خطأ تختلف من موقف إلى آخر"]],"a":"لا تكون أيٌّ منهما على صواب دائمًا؛ فالحكم يعتمد على سياق المسألة وعواقب كل خطأ. مثال (إجابة ممكنة): في اختبار أمان دواء جديد (<span class=\"tx\" data-t=\"H_0\"></span>: الدواء آمن)، يكون الخطأ من النوع <span class=m dir=ltr>II (</span>اعتماد دواء ضارّ) أخطر، فالأفضل هنا وقوع خطأ من النوع <span class=m dir=ltr>I</span>، وتكون هديل على صواب. أمّا في الحكم على متّهم (<span class=\"tx\" data-t=\"H_0\"></span>: بريء)، فالخطأ من النوع <span class=m dir=ltr>I (</span>إدانة بريء) أخطر، فتكون لانا على صواب في هذه الحالة.","o":""}],[{"n":"16","s":[["\\text{رفض } H_0 \\text{ ؛ والادّعاء قد يكون } H_0 \\text{ أو } H_1","يعتمد على موقع الادّعاء"]],"a":"صحيحة أحيانًا؛ إذا كان الادّعاء يمثّل <span class=\"tx\" data-t=\"H_0\"></span> فإن رفضها يعني رفض الادّعاء، أمّا إذا كان الادّعاء يمثّل <span class=\"tx\" data-t=\"H_1\"></span> فإن رفض <span class=\"tx\" data-t=\"H_0\"></span> يعني دعم الادّعاء (وجود أدلّة كافية لصحّته).","o":""},{"n":"17","s":[["H_1:\\ <,\\ >,\\ \\ne","الفرضية البديلة لا تحتوي على رمز المساواة"]],"a":"غير صحيحة أبدًا؛ لأن الفرضية البديلة تحتوي دائمًا على أحد الرموز <span class=\"tx\" data-t=\"&lt;\"></span> أو <span class=\"tx\" data-t=\"&gt;\"></span> أو <span class=\"tx\" data-t=\"\\ne\"></span>، ورمز المساواة يكون في الفرضية الصفرية فقط، سواء مثّلت البديلة الادّعاء أم لا.","o":""}],[{"n":"18","s":[["H_0: \\mu \\le 50,\\quad H_1: \\mu > 50","الادّعاء يحوي المساواة فيمثّل الفرضية الصفرية، والاختبار أحادي الطرف يمينًا"],["\\sigma_{\\bar{x}} = \\frac{\\sigma}{\\sqrt{n}} = \\frac{3}{\\sqrt{100}} = 0.3","الخطأ المعياري للوسط الحسابي"],["z = \\frac{\\bar{x}-\\mu}{\\frac{\\sigma}{\\sqrt{n}}} = \\frac{50.6-50}{0.3} = 2","قيمة الإحصائي <span class=m dir=ltr>z</span>"],["z = 2 > z_\\alpha","رُفضت <span class=\"tx\" data-t=\"H_0\"></span> ؛ لذا يجب أن تقع <span class=m dir=ltr>z</span> في المنطقة الحرجة"],["P(Z > 2) = 1 - 0.9772 = 0.0228 \\Rightarrow \\alpha > 0.0228","باستعمال جدول التوزيع الطبيعي"],["\\alpha = 0.10:\\ z_\\alpha = 1.28 < 2,\\quad \\alpha = 0.05:\\ z_\\alpha = 1.64 < 2,\\quad \\alpha = 0.01:\\ z_\\alpha = 2.33 > 2","مقارنة بالقيم الشائعة لمستوى الدلالة"]],"a":"قيم <span class=\"tx\" data-t=\"\\alpha\"></span> المحتملة هي كل قيمة أكبر من <span class=\"tx\" data-t=\"0.0228\"></span>، ومن القيم الشائعة: <span class=\"tx\" data-t=\"\\alpha = 0.05\"></span> أو <span class=\"tx\" data-t=\"\\alpha = 0.10\"></span> (ولا يمكن أن تكون <span class=\"tx\" data-t=\"0.01\"></span>)","o":""}],[{"n":"9","s":[["\\mu \\le 40","الادّعاء «لا يتجاوز <span class=m dir=ltr>40</span>» يحوي المساواة فيمثّل الفرضية الصفرية"],["H_0: \\mu \\le 40,\\quad H_1: \\mu > 40","الفرضية البديلة نقيض الصفرية"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"H_0: \\mu \\le 40\"></span> <span class=m dir=ltr>and</span> <span class=\"tx\" data-t=\"H_1: \\mu &gt; 40\"></span>","o":""}],[{"n":"22","s":[["H_0: \\mu \\le 20\\ (\\text{الادعاء}),\\quad H_1: \\mu > 20","الخطوة <span class=m dir=ltr>1</span>: تحديد الفرضيتين"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","الخطوة <span class=m dir=ltr>2</span>: الاختبار أحادي الطرف يمينًا"],["z = \\frac{\\bar{x}-\\mu}{\\frac{s}{\\sqrt{n}}} = \\frac{23.4 - 20}{\\frac{9.5}{\\sqrt{70}}} \\approx \\frac{3.4}{1.135} \\approx 2.99","الخطوة <span class=m dir=ltr>3</span>: <span class=\"tx\" data-t=\"n \\ge 30\"></span> فنستعمل <span class=\"tx\" data-t=\"s\"></span> بدلًا من <span class=\"tx\" data-t=\"\\sigma\"></span>"],["2.99 > 1.64","الخطوة <span class=m dir=ltr>4</span>: <span class=m dir=ltr>z</span> تقع ضمن المنطقة الحرجة، فنرفض <span class=\"tx\" data-t=\"H_0\"></span>"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ توجد أدلّة كافية لرفض ادّعاء مراقب الجودة، أي إن الوسط الحسابي لزمن الانتظار يزيد على <span class=m dir=ltr>20</span> دقيقة","o":""}],[{"n":"23","s":[["H_0: \\mu \\ge 200\\ (\\text{الادعاء}),\\quad H_1: \\mu < 200","الخطوة <span class=m dir=ltr>1</span>: الادّعاء «<span class=m dir=ltr>200</span> صفحة من دون نقص»"],["\\alpha = 0.10 \\Rightarrow z_\\alpha = -1.28","الخطوة <span class=m dir=ltr>2</span>: الاختبار أحادي الطرف يسارًا"],["z = \\frac{197.8 - 200}{\\frac{5.4}{\\sqrt{93}}} \\approx \\frac{-2.2}{0.56} \\approx -3.93","الخطوة <span class=m dir=ltr>3</span>: إيجاد قيمة الإحصائي <span class=m dir=ltr>z</span>"],["-3.93 < -1.28","الخطوة <span class=m dir=ltr>4</span>: <span class=m dir=ltr>z</span> تقع ضمن المنطقة الحرجة، فنرفض <span class=\"tx\" data-t=\"H_0\"></span>"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ توجد أدلّة كافية لرفض ادّعاء الشركة","o":"لو عُدّ الاختبار ثنائي الطرف (<span class=\"tx\" data-t=\"H_0: \\mu = 200\"></span>) فإن <span class=\"tx\" data-t=\"z_{\\alpha/2} = \\pm 1.64\"></span> والقرار نفسه: رفض <span class=\"tx\" data-t=\"H_0\"></span>"}],[{"n":"1","s":[["H_0: \\mu = 5,\\quad H_1: \\mu \\ne 5","الادّعاء يحوي المساواة"]],"a":"الفرضية الصفرية <span class=\"tx\" data-t=\"H_0: \\mu = 5\"></span> تمثّل الادّعاء","o":""},{"n":"2","s":[["H_0: \\mu \\ge 55,\\quad H_1: \\mu < 55","الادّعاء «أقل من <span class=m dir=ltr>55</span>» لا يحوي المساواة"]],"a":"الفرضية البديلة <span class=\"tx\" data-t=\"H_1: \\mu &lt; 55\"></span> تمثّل الادّعاء","o":""},{"n":"3","s":[["H_0: \\mu \\le 80,\\quad H_1: \\mu > 80","الادّعاء «يزيد على <span class=m dir=ltr>80%</span>» لا يحوي المساواة"]],"a":"الفرضية البديلة <span class=\"tx\" data-t=\"H_1: \\mu &gt; 80\"></span> تمثّل الادّعاء","o":""}],[{"n":"4","s":[["\\text{رفض } H_0: \\mu \\ge 9 \\text{ وهي صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>I</span>"]],"a":"يحدث عندما تستنتج الدراسة أن البرنامج يقلّل معدّل زمن الجري إلى أقل من <span class=m dir=ltr>9</span> دقائق، في حين أنه في الحقيقة لا يقلّه (المعدّل <span class=m dir=ltr>9</span> دقائق أو أكثر)","o":""},{"n":"5","s":[["\\text{عدم رفض } H_0: \\mu \\ge 9 \\text{ وهي غير صحيحة}","تعريف الخطأ من النوع <span class=m dir=ltr>II</span>"]],"a":"يحدث عندما تستنتج الدراسة أنه لا يوجد دليل على أن البرنامج يقلّل زمن الجري، في حين أنه في الحقيقة يقلّه إلى أقل من <span class=m dir=ltr>9</span> دقائق","o":""}],[{"n":"6","s":[["H_0: \\mu \\le 10000\\ (k),\\quad H_1: \\mu > 10000","تحديد الفرضيتين؛ اختبار أحادي الطرف يمينًا"],["\\alpha = 0.01 \\Rightarrow z_\\alpha = 2.33","القيمة الحرجة"],["z = \\frac{10015 - 10000}{\\frac{85}{\\sqrt{48}}} \\approx \\frac{15}{12.27} \\approx 1.22","قيمة الإحصائي <span class=m dir=ltr>z</span>"],["1.22 < 2.33","<span class=m dir=ltr>z</span> لا تقع ضمن المنطقة الحرجة"]],"a":"<span class=\"tx\" data-t=\"z \\approx 1.22\"></span>؛ لا أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ لا توجد أدلّة كافية لرفض الادّعاء <span class=\"tx\" data-t=\"k\"></span>","o":""},{"n":"7","s":[["H_0: \\mu \\le 88,\\quad H_1: \\mu > 88\\ (k)","الادّعاء لا يحوي المساواة فيمثّل البديلة"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","اختبار أحادي الطرف يمينًا"],["z = \\frac{91.2 - 88}{\\frac{3.9}{\\sqrt{52}}} \\approx \\frac{3.2}{0.541} \\approx 5.92","قيمة الإحصائي <span class=m dir=ltr>z</span>"],["5.92 > 1.64","<span class=m dir=ltr>z</span> تقع ضمن المنطقة الحرجة"]],"a":"<span class=\"tx\" data-t=\"z \\approx 5.92\"></span>؛ أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ توجد أدلّة كافية لدعم الادّعاء <span class=\"tx\" data-t=\"k: \\mu &gt; 88\"></span>","o":""}],[{"n":"8","s":[["H_0: \\mu \\le 1.8\\ (\\text{الادعاء}),\\quad H_1: \\mu > 1.8","الخطوة <span class=m dir=ltr>1</span>"],["\\alpha = 0.05 \\Rightarrow z_\\alpha = 1.64","الخطوة <span class=m dir=ltr>2</span>: اختبار أحادي الطرف يمينًا"],["z = \\frac{2.0 - 1.8}{\\frac{0.5}{\\sqrt{45}}} \\approx \\frac{0.2}{0.0745} \\approx 2.68","الخطوة <span class=m dir=ltr>3</span>"],["2.68 > 1.64","الخطوة <span class=m dir=ltr>4</span>: <span class=m dir=ltr>z</span> تقع ضمن المنطقة الحرجة"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ توجد أدلّة كافية لرفض ادّعاء الشركة، أي إن الوسط الحسابي لاستهلاك الطاقة أكبر من <span class=m dir=ltr>1.8 watt</span>","o":""}],[{"n":"9","s":[["H_0: \\mu = 45\\ (\\text{الادعاء}),\\quad H_1: \\mu \\ne 45","الخطوة <span class=m dir=ltr>1</span>: اختبار ثنائي الطرف"],["\\alpha = 0.10 \\Rightarrow \\frac{\\alpha}{2} = 0.05 \\Rightarrow z_{\\alpha} = \\pm 1.64","الخطوة <span class=m dir=ltr>2</span>: القيمتان الحرجتان"],["z = \\frac{48.2 - 45}{\\frac{10.5}{\\sqrt{49}}} = \\frac{3.2}{1.5} \\approx 2.13","الخطوة <span class=m dir=ltr>3</span>"],["2.13 > 1.64","الخطوة <span class=m dir=ltr>4</span>: <span class=m dir=ltr>z</span> تقع ضمن المنطقة الحرجة"]],"a":"أرفض <span class=\"tx\" data-t=\"H_0\"></span>؛ توجد أدلّة كافية لرفض ادّعاء الإدارة بأن الوسط الحسابي <span class=m dir=ltr>45</span> دقيقة","o":""}]]