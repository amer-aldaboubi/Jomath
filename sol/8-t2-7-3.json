[[{"n":"1","s":[["180^\\circ - 102^\\circ = 78^\\circ","الزاوية الداخلية عند الرأس الرابع تكمّل الزاوية الخارجية (زاويتان على مستقيم)"],["78^\\circ = 78^\\circ,\\ 102^\\circ = 102^\\circ","كل زاويتين متقابلتين متطابقتان"]],"a":"متوازي أضلاع؛ لأن كل زاويتين متقابلتين فيه متطابقتان","o":""},{"n":"2","s":[["AB = CD,\\ AD = BC","العلامات تبيّن أن كل ضلعين متقابلين متطابقان"]],"a":"متوازي أضلاع؛ لأن كل ضلعين متقابلين فيه متطابقان","o":""},{"n":"3","s":[["\\overline{AB} \\parallel \\overline{DC}","بتسمية الرؤوس <span class=m dir=ltr>ABCD</span> بدءًا من الأعلى يسارًا: الأسهم (والزاويتان المتبادلتان داخليًّا المتطابقتان مع القطر) تبيّن أن الضلعين العلوي والسفلي متوازيان"],["\\overline{AD} \\cong \\overline{BC}","العلامات تبيّن أن الضلعين الآخرين متطابقان"]],"a":"الإجابة المتوقعة: متوازي أضلاع لوجود زوج أضلاع متقابلة متوازٍ وزوج متطابق","o":"ملاحظة للمعلم: المعطيات كما رُسمت (زوج متوازٍ وزوج آخر متطابق) لا تكفي منطقيًّا (شبه المنحرف المتطابق الساقين مثال مضاد)؛ النظرية تتطلب أن يكون الزوج نفسه متوازيًا ومتطابقًا"}],[{"n":"4","s":[["3y = 96 - y \\Rightarrow 4y = 96 \\Rightarrow y = 24","الضلعان المتقابلان متطابقان"],["2x = 5x - 18 \\Rightarrow 18 = 3x \\Rightarrow x = 6","الضلعان المتقابلان متطابقان"]],"a":"<span class=\"tx\" data-t=\"x = 6,\\ y = 24\"></span>","o":"","k":[{"e":"6","a":null},{"e":"24","a":null}]},{"n":"5","s":[["2x + 3 = 5x \\Rightarrow 3 = 3x \\Rightarrow x = 1","عكس نظرية قطري متوازي الأضلاع: ينصّف كلٌّ منهما الآخر"],["8y - 36 = 4y \\Rightarrow 4y = 36 \\Rightarrow y = 9","القطر الآخر منصَّف أيضًا"]],"a":"<span class=\"tx\" data-t=\"x = 1,\\ y = 9\"></span>","o":"","k":[{"e":"1","a":null},{"e":"9","a":null}]},{"n":"6","s":[["25x = 100 \\Rightarrow x = 4","زاويتان متبادلتان داخليًّا (الضلعان العلوي والسفلي متوازيان، والقطر قاطع)"],["10y = 40 \\Rightarrow y = 4","زاويتان متبادلتان داخليًّا (الضلعان الجانبيان متوازيان)"]],"a":"<span class=\"tx\" data-t=\"x = 4,\\ y = 4\"></span>","o":"","k":[{"e":"4","a":null},{"e":"4","a":null}]}],[{"n":"7","s":[["\\overline{XW} \\cong \\overline{YZ}","معطى (من الشكل)"],["\\angle XWY \\cong \\angle ZYW","معطى (من الشكل)"],["\\overline{XW} \\parallel \\overline{YZ}","عكس نظرية الزاويتين المتبادلتين داخليًّا (القاطع <span class=m dir=ltr>WY)</span>"],["\\square XYZW","نظرية الأضلاع المتوازية والمتطابقة: ضلعان متقابلان متوازيان ومتطابقان"]],"a":"<span class=\"tx\" data-t=\"XYZW\"></span> متوازي أضلاع","o":""}],[{"n":"8","s":[["\\overline{LQ} \\cong \\overline{NQ},\\ \\angle LMQ \\cong \\angle NTQ","معطى (من الشكل)"],["\\angle LQM \\cong \\angle NQT","زاويتان متقابلتان بالرأس"],["\\triangle LQM \\cong \\triangle NQT","<span class=m dir=ltr>AAS</span>"],["\\overline{MQ} \\cong \\overline{TQ}","عنصران متناظران في مثلثين متطابقين"],["\\square LMNT","عكس نظرية قطري متوازي الأضلاع: القطران ينصّف كلٌّ منهما الآخر"]],"a":"<span class=\"tx\" data-t=\"LMNT\"></span> متوازي أضلاع","o":""}],[{"n":"9","s":[["\\triangle TRS \\cong \\triangle RTW","معطى"],["\\overline{TS} \\cong \\overline{RW},\\ \\overline{RS} \\cong \\overline{TW}","أضلاع متناظرة في مثلثين متطابقين"],["\\square RSTW","كل ضلعين متقابلين متطابقان"]],"a":"<span class=\"tx\" data-t=\"RSTW\"></span> متوازي أضلاع","o":""}],[{"n":"10","s":[["\\angle ANL \\cong \\angle DLN","معطى (القوسان المزدوجان)"],["\\overline{AN} \\parallel \\overline{LD}","عكس نظرية الزاويتين المتبادلتين داخليًّا (القاطع <span class=m dir=ltr>LN)</span>"],["\\angle ALN \\cong \\angle DNL","معطى (القوس المفرد)"],["\\overline{AL} \\parallel \\overline{ND}","عكس نظرية الزاويتين المتبادلتين داخليًّا"],["\\square ANDL","تعريف متوازي الأضلاع: كل ضلعين متقابلين متوازيان"]],"a":"<span class=\"tx\" data-t=\"ANDL\"></span> متوازي أضلاع","o":""}],[{"n":"11","s":[["JK = LM = 7\\ \\text{m},\\ KL = JM = 3\\ \\text{m}","معطى"],["\\square JKLM","كل ضلعين متقابلين متطابقان"]],"a":"نعم، <span class=\"tx\" data-t=\"JKLM\"></span> متوازي أضلاع؛ لأن كل ضلعين متقابلين فيه متطابقان","o":""},{"n":"12","s":[["m\\angle JML = m\\angle JKL = 60^\\circ","الزاويتان المتقابلتان متطابقتان"],["m\\angle KJM = 180^\\circ - 60^\\circ = 120^\\circ","الزاويتان المتتاليتان متكاملتان"],["m\\angle KLM = 180^\\circ - 60^\\circ = 120^\\circ","الزاويتان المتتاليتان متكاملتان"]],"a":"<span class=\"tx\" data-t=\"m\\angle JML = 60^\\circ,\\ m\\angle KJM = 120^\\circ,\\ m\\angle KLM = 120^\\circ\"></span>","o":"","k":[{"e":"120","a":null}]}],[{"n":"13","s":[["\\overline{AB} \\parallel \\overline{DC}","بتسمية رؤوس الحرف <span class=m dir=ltr>ABCD</span> بدءًا من الأعلى يسارًا: الأسهم تبيّن أن الضلعين الأفقيين متوازيان"],["\\angle 1 \\cong \\angle 2 \\Rightarrow \\overline{AD} \\parallel \\overline{BC}","الزاويتان المرسومتان عند الخط السفلي متناظرتان ومتطابقتان، فالضلعان المائلان متوازيان"]],"a":"نعم، الحرف <span class=\"tx\" data-t=\"I\"></span> متوازي أضلاع؛ لأن كل ضلعين متقابلين فيه متوازيان","o":""}],[{"n":"14","s":[["m_{BC} = \\frac{-3-(-3)}{2-(-6)} = 0,\\ m_{EG} = \\frac{4-4}{-4-4} = 0","ميلا <span class=m dir=ltr>BC</span> و <span class=m dir=ltr>EG</span> متساويان"],["m_{CE} = \\frac{4-(-3)}{4-2} = \\frac{7}{2},\\ m_{GB} = \\frac{-3-4}{-6-(-4)} = \\frac{7}{2}","ميلا <span class=m dir=ltr>CE</span> و <span class=m dir=ltr>GB</span> متساويان"]],"a":"نعم، <span class=\"tx\" data-t=\"BCEG\"></span> متوازي أضلاع؛ لأن كل ضلعين متقابلين لهما الميل نفسه فهما متوازيان","o":"تُعيَّن النقاط <span class=\"tx\" data-t=\"B(-6,-3), C(2,-3), E(4,4), G(-4,4)\"></span> وتوصل بالترتيب"},{"n":"15","s":[["m_{QR} = \\frac{2-(-6)}{2-(-3)} = \\frac{8}{5},\\ m_{ST} = \\frac{2-6}{-5-(-1)} = 1","الميلان غير متساويين"],["m_{RS} = \\frac{6-2}{-1-2} = -\\frac{4}{3},\\ m_{TQ} = \\frac{-6-2}{-3-(-5)} = -4","الميلان غير متساويين"]],"a":"لا، <span class=\"tx\" data-t=\"QRST\"></span> ليس متوازي أضلاع؛ لأن الأضلاع المتقابلة ليست متوازية","o":"تُعيَّن النقاط <span class=\"tx\" data-t=\"Q(-3,-6), R(2,2), S(-1,6), T(-5,2)\"></span> وتوصل بالترتيب"}],[{"n":"16","s":[["A(1,2),\\ B(2,5),\\ C(5,3)","من الشكل"],["B \\to C:\\ (+3,\\ -2)","الانتقال من <span class=m dir=ltr>B</span> إلى <span class=m dir=ltr>C</span>: <span class=m dir=ltr>3</span> وحدات يمينًا ووحدتان للأسفل"],["D = (1+3,\\ 2-2) = (4,0)","<span class=m dir=ltr>AD</span> يجب أن يوازي <span class=m dir=ltr>BC</span> ويساويه، فنطبّق الانتقال نفسه على <span class=m dir=ltr>A</span>"],["m_{AB} = m_{DC} = 3,\\ m_{BC} = m_{AD} = -\\frac{2}{3}","تحقّق: الأضلاع المتقابلة متوازية"]],"a":"<span class=\"tx\" data-t=\"D(4, 0)\"></span>","o":"","k":[{"p":["4","0"]}]},{"n":"17","s":[["A \\to C:\\ (+4,\\ +1)","في <span class=m dir=ltr>ABEC</span> يجب أن يوازي <span class=m dir=ltr>BE</span> الضلع <span class=m dir=ltr>AC</span> ويساويه"],["E = (2+4,\\ 5+1) = (6,6)","نطبّق الانتقال نفسه على <span class=m dir=ltr>B</span>"],["m_{AB} = m_{CE} = 3,\\ m_{BE} = m_{AC} = \\frac{1}{4}","تحقّق: الأضلاع المتقابلة متوازية"]],"a":"<span class=\"tx\" data-t=\"E(6, 6)\"></span>","o":"","k":[{"p":["6","6"]}]}],[{"n":"18","s":[["\\overline{AF} \\cong \\overline{CD},\\ \\overline{AB} \\cong \\overline{FE},\\ \\overline{BC} \\cong \\overline{ED}","أضلاع السداسي المنتظم متطابقة"],["m\\angle B = m\\angle E = 120^\\circ","زوايا السداسي المنتظم متطابقة"],["\\triangle ABC \\cong \\triangle FED","<span class=m dir=ltr>SAS</span>"],["\\overline{AC} \\cong \\overline{FD}","عنصران متناظران في مثلثين متطابقين"],["\\square FACD","كل ضلعين متقابلين متطابقان <span class=m dir=ltr>(FA</span> ≅ <span class=m dir=ltr>CD</span> و <span class=m dir=ltr>AC</span> ≅ <span class=m dir=ltr>DF)</span>"]],"a":"<span class=\"tx\" data-t=\"FACD\"></span> متوازي أضلاع","o":""}],[{"n":"19","s":[["LA = AM = OC = CN = \\tfrac{1}{2}LM","<span class=m dir=ltr>A</span> و <span class=m dir=ltr>C</span> منتصفا ضلعين متقابلين متطابقين"],["LD = DO = MB = BN = \\tfrac{1}{2}LO","<span class=m dir=ltr>D</span> و <span class=m dir=ltr>B</span> منتصفا ضلعين متقابلين متطابقين"],["\\angle L \\cong \\angle N,\\ \\angle M \\cong \\angle O","الزوايا المتقابلة في متوازي الأضلاع متطابقة"],["\\triangle ALD \\cong \\triangle CNB,\\ \\triangle AMB \\cong \\triangle COD","<span class=m dir=ltr>SAS</span>"],["\\overline{AD} \\cong \\overline{CB},\\ \\overline{AB} \\cong \\overline{CD}","عناصر متناظرة في مثلثات متطابقة"],["\\square ABCD","كل ضلعين متقابلين متطابقان"]],"a":"<span class=\"tx\" data-t=\"ABCD\"></span> متوازي أضلاع","o":""}],[{"n":"20","s":[["AB \\parallel CD,\\ AD \\parallel BC","كل ضلعين متقابلين متوازيان (بالميل أو بالزوايا)"],["AB = CD,\\ AD = BC","أو كل ضلعين متقابلين متطابقان"],["\\angle A \\cong \\angle C,\\ \\angle B \\cong \\angle D","أو كل زاويتين متقابلتين متطابقتان"],["AM = MC,\\ BM = MD","أو القطران ينصّف كلٌّ منهما الآخر"],["AB \\parallel CD,\\ AB = CD","أو ضلعان متقابلان متوازيان ومتطابقان معًا"]],"a":"أثبت تحقق أحد الشروط: الأضلاع المتقابلة متوازية، أو متطابقة، أو الزوايا المتقابلة متطابقة، أو القطران ينصّف كلٌّ منهما الآخر، أو زوج أضلاع متقابلة متوازٍ ومتطابق","o":""}],[{"n":"2","s":[["A(-2,2),\\ B(1,-6),\\ C(8,2)","تسمية الرؤوس"],["D=B+C-A=(1+8+2,\\ -6+2-2)=(11,-6)","قطرا متوازي الأضلاع ينصف كل منهما الآخر (منتصف <span class=m dir=ltr>AD =</span> منتصف <span class=m dir=ltr>BC)</span>"],["\\text{منتصف } \\overline{BC}=\\left(\\tfrac{9}{2},-2\\right)=\\text{منتصف } \\overline{AD}=\\left(\\tfrac{-2+11}{2},\\tfrac{2-6}{2}\\right)","تحقق"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"(11,-6)\"></span>","o":"","k":[{"p":["11","-6"]}]}],[{"n":"5","s":[["DFBE\\ \\text{متوازي أضلاع}","معطى"],["\\overline{DF}\\parallel\\overline{EB},\\ DF=EB","الأضلاع المتقابلة في متوازي الأضلاع متوازية ومتطابقة"],["AE=CF","معطى"],["DF+FC=EB+AE\\ \\Rightarrow\\ DC=AB","بجمع المعادلتين (مسلّمة جمع القطع المستقيمة)"],["\\overline{DC}\\parallel\\overline{AB}","لأنهما يقعان على المستقيمين المتوازيين نفسيهما <span class=\"tx\" data-t=\"\\overleftrightarrow{DF}\"></span> و <span class=\"tx\" data-t=\"\\overleftrightarrow{EB}\"></span>"],["ADCB\\ \\text{متوازي أضلاع}","فيه زوج من الأضلاع المتقابلة متوازٍ ومتطابق"]],"a":"<span class=\"tx\" data-t=\"ADCB\"></span> متوازي أضلاع لأن <span class=\"tx\" data-t=\"\\overline{DC}\\parallel\\overline{AB}\"></span> و <span class=\"tx\" data-t=\"DC=AB\"></span>","o":"يُكتب البرهان في عمودين: العبارات (العمود الأيمن) والمبررات (العمود الأيسر) كما في الخطوات."}],[{"n":"6","s":[["3x=4x-5","قطرا متوازي الأضلاع ينصف كل منهما الآخر"],["x=5","بطرح <span class=\"tx\" data-t=\"3x\"></span> من الطرفين ثم إضافة <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span> (لا يظهر المتغير <span class=\"tx\" data-t=\"y\"></span> في هذا الشكل)","o":""},{"n":"7","s":[["3y=y+78","الزاويتان المتقابلتان <span class=m dir=ltr>A</span> و <span class=m dir=ltr>C</span> متطابقتان"],["2y=78\\ \\Rightarrow\\ y=39","بطرح <span class=\"tx\" data-t=\"y\"></span> ثم القسمة على <span class=m dir=ltr>2</span>"],["3x=4x-21","الزاويتان المتقابلتان <span class=m dir=ltr>B</span> و <span class=m dir=ltr>D</span> متطابقتان"],["x=21","بطرح <span class=\"tx\" data-t=\"3x\"></span> من الطرفين وإضافة <span class=m dir=ltr>21</span>"],["3(21)+(39+78)=63+117=180\\ \\checkmark","تحقق: الزاويتان المتحالفتان متكاملتان"]],"a":"<span class=\"tx\" data-t=\"x=21,\\ y=39\"></span>","o":"","k":[{"e":"21","a":null},{"e":"39","a":null}]}],[{"n":"22","s":[["2y-7=y+2","قطرا متوازي الأضلاع ينصف كل منهما الآخر (القطر <span class=m dir=ltr>LN)</span>"],["y=9","بطرح <span class=\"tx\" data-t=\"y\"></span> وإضافة <span class=m dir=ltr>7</span>"],["3x=y","القطر <span class=m dir=ltr>MP</span>"],["3x=9\\ \\Rightarrow\\ x=3","بالتعويض ثم القسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"x=3\"></span>","o":"","k":[{"e":"3","a":null}]}],[{"n":"1","s":[["20=20,\\quad 14=14","كل ضلعين متقابلين متطابقان"]],"a":"إذا كان كل ضلعين متقابلين في شكل رباعي متطابقين، فإنه متوازي أضلاع","o":""},{"n":"2","s":[["68^\\circ=68^\\circ,\\quad 112^\\circ=112^\\circ","كل زاويتين متقابلتين متطابقتان"]],"a":"إذا كانت كل زاويتين متقابلتين في شكل رباعي متطابقتين، فإنه متوازي أضلاع","o":""},{"n":"3","s":[["\\text{الضلعان المتقابلان: متوازيان وطول كل منهما } 9",""]],"a":"إذا كان في شكل رباعي ضلعان متقابلان متوازيان ومتطابقان، فإنه متوازي أضلاع","o":""}],[{"n":"4","s":[["4x+13=5x-12","الزاويتان المتقابلتان متطابقتان"],["x=25","بطرح <span class=\"tx\" data-t=\"4x\"></span> وإضافة <span class=m dir=ltr>12</span>"],["3(25)-8=67^\\circ","الزاوية السفلية اليسرى"],["4y+7=67","مقابلة لها ومطابقة"],["4y=60\\ \\Rightarrow\\ y=15","بطرح <span class=m dir=ltr>7</span> ثم القسمة على <span class=m dir=ltr>4</span>"]],"a":"<span class=\"tx\" data-t=\"x=25,\\ y=15\"></span>","o":"","k":[{"e":"25","a":null},{"e":"15","a":null}]},{"n":"5","s":[["4y-3=3y+1\\ \\Rightarrow\\ y=4","الضلعان المتقابلان متطابقان"],["7x-3=4x+6","الضلعان المتقابلان متطابقان"],["3x=9\\ \\Rightarrow\\ x=3","بطرح <span class=\"tx\" data-t=\"4x\"></span> وإضافة <span class=m dir=ltr>3</span> ثم القسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"x=3,\\ y=4\"></span>","o":"","k":[{"e":"3","a":null},{"e":"4","a":null}]},{"n":"6","s":[["6x-12=2x+36","الضلعان المتقابلان <span class=m dir=ltr>DE</span> و <span class=m dir=ltr>FG</span> متطابقان"],["4x=48\\ \\Rightarrow\\ x=12","بطرح <span class=\"tx\" data-t=\"2x\"></span> وإضافة <span class=m dir=ltr>12</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["4y+(6y-40)=180","الزاويتان المتحالفتان <span class=m dir=ltr>F</span> و <span class=m dir=ltr>G</span> متكاملتان"],["10y=220\\ \\Rightarrow\\ y=22","بإضافة <span class=m dir=ltr>40</span> ثم القسمة على <span class=m dir=ltr>10</span>"]],"a":"<span class=\"tx\" data-t=\"x=12,\\ y=22\"></span>","o":"","k":[{"e":"12","a":null},{"e":"22","a":null}]}],[{"n":"7","s":[["\\angle D\\cong\\angle BCF","معطى (من الشكل)"],["\\overline{AD}\\parallel\\overline{BC}","عكس مسلّمة الزاويتين المتناظرتين (القاطع <span class=\"tx\" data-t=\"\\overleftrightarrow{DF}\"></span>)"],["\\angle B\\cong\\angle BCF","معطى (من الشكل)"],["\\overline{AB}\\parallel\\overline{DC}","عكس نظرية الزاويتين المتبادلتين داخليًا (القاطع <span class=\"tx\" data-t=\"\\overline{BC}\"></span>)"],["ABCD\\ \\text{متوازي أضلاع}","كل ضلعين متقابلين متوازيان (التعريف)"]],"a":"<span class=\"tx\" data-t=\"ABCD\"></span> متوازي أضلاع","o":"البرهان السهمي: فرعان يلتقيان في النهاية: (<span class=\"tx\" data-t=\"\\overline{AD}\\parallel\\overline{BC}\"></span>) و (<span class=\"tx\" data-t=\"\\overline{AB}\\parallel\\overline{DC}\"></span>) ← <span class=m dir=ltr>ABCD</span> متوازي أضلاع."}],[{"n":"8","s":[["D=A+C-B=(-5+4+3,\\ -2+3-3)=(2,-2)","القطران ينصف كل منهما الآخر"],["\\text{ميل } \\overline{BC}=\\frac{3-3}{4-(-3)}=0,\\quad \\text{ميل } \\overline{AD}=\\frac{-2-(-2)}{2-(-5)}=0","إذن <span class=\"tx\" data-t=\"\\overline{BC}\\parallel\\overline{AD}\"></span>"],["\\text{ميل } \\overline{AB}=\\frac{3-(-2)}{-3-(-5)}=\\frac{5}{2},\\quad \\text{ميل } \\overline{DC}=\\frac{3-(-2)}{4-2}=\\frac{5}{2}","إذن <span class=\"tx\" data-t=\"\\overline{AB}\\parallel\\overline{DC}\"></span>"]],"a":"<span class=\"tx\" data-t=\"D(2,-2)\"></span> لأن كل ضلعين متقابلين متوازيان (لهما الميل نفسه)","o":"أمثّل <span class=m dir=ltr>A(−5,−2), B(−3,3), C(4,3), D(2,−2)</span> ثم أصل بينها بالترتيب."}],[{"n":"9","s":[["JM=KL=13","المعطى فقط زوج واحد من الأضلاع المتقابلة متطابق"],["","عكس النظرية يتطلب أن يكون كل ضلعين متقابلين متطابقين (أيضًا <span class=m dir=ltr>JK = ML)</span>، أو أن يكون الزوج نفسه متوازيًا ومتطابقًا"]],"a":"الخطأ: لا يكفي تطابق ضلعين متقابلين فقط؛ فقد يكون الشكل شبه منحرف متطابق الساقين، لذا لا يمكن إثبات أنه متوازي أضلاع بهذه المعلومات","o":""}]]