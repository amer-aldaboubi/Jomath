kmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span>","o":""},{"n":"40","s":[["4\\sqrt[3]{2x+11}=12\\Rightarrow\\sqrt[3]{2x+11}=3","بإضافة <span class=m dir=ltr>2</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["2x+11=27\\Rightarrow x=8","بتكعيب الطرفين"],["4\\sqrt[3]{27}-2=10\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=8\"></span>","o":""},{"n":"41","s":[["3-x=3^4=81","برفع الطرفين إلى القوة <span class=m dir=ltr>4</span>"],["x=-78","بحل المعادلة"],["\\sqrt[4]{81}=3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=-78\"></span>","o":""},{"n":"42","s":[["\\sqrt{2x+5}=1+\\sqrt{3x-2}","بعزل أحد الجذرين"],["2x+5=1+2\\sqrt{3x-2}+3x-2","بتربيع الطرفين"],["6-x=2\\sqrt{3x-2}\\Rightarrow36-12x+x^2=12x-8","بالتبسيط ثم تربيع الطرفين مرة أخرى"],["x^2-24x+44=0\\Rightarrow(x-2)(x-22)=0","بالتحليل"],["x=2:\\ \\sqrt9-\\sqrt4=1\\ \\checkmark\\quad x=22:\\ \\sqrt{49}-\\sqrt{64}=-1\\ne1","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span> (<span class=\"tx\" data-t=\"x=22\"></span> حل دخيل)","o":""},{"n":"43","s":[["2x-7=3x-12","بتربيع الطرفين"],["x=5","بحل المعادلة الخطية"],["\\sqrt3=\\sqrt3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span>","o":""}],[{"n":"46","s":[["0.72=0.5\\sqrt h","بالتعويض <span class=\"tx\" data-t=\"t=0.72\"></span>"],["\\sqrt h=1.44","بقسمة الطرفين على <span class=m dir=ltr>0.5</span>"],["h=1.44^2=2.0736","بتربيع الطرفين"],["0.5\\sqrt{2.0736}=0.5\\times1.44=0.72\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"ارتفاع القفزة <span class=\"tx\" data-t=\"h\\approx2.07\"></span> قدم (<span class=\"tx\" data-t=\"2.0736\\ \\text{ft}\"></span>)","o":""}],[{"n":"1","s":[["3r+2=(2\\sqrt3)^2=12","بتربيع الطرفين"],["3r=10\\Rightarrow r=\\frac{10}{3}","بطرح <span class=m dir=ltr>2</span> ثم القسمة على <span class=m dir=ltr>3</span>"],["\\sqrt{12}=2\\sqrt3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"r=\\frac{10}{3}\"></span>","o":""},{"n":"2","s":[["\\sqrt{3b-2}=5","بطرح <span class=m dir=ltr>19</span> من الطرفين"],["3b-2=25\\Rightarrow b=9","بتربيع الطرفين"],["\\sqrt{25}+19=24\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"b=9\"></span>","o":""},{"n":"3","s":[["26-n=49","بتربيع الطرفين"],["n=-23","بحل المعادلة"],["\\sqrt{49}=7\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"n=-23\"></span>","o":""},{"n":"4","s":[["2x=x+7-2\\sqrt{x+7}+1","بتربيع الطرفين"],["2\\sqrt{x+7}=8-x\\Rightarrow4(x+7)=64-16x+x^2","بعزل الجذر ثم تربيع الطرفين"],["x^2-20x+36=0\\Rightarrow(x-2)(x-18)=0","بالتحليل"],["x=2:\\ \\sqrt4=2=\\sqrt9-1\\ \\checkmark\\quad x=18:\\ \\sqrt{36}=6\\ne\\sqrt{25}-1=4","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span> (<span class=\"tx\" data-t=\"x=18\"></span> حل دخيل)","o":""},{"n":"5","s":[["4x^2=4x^2+6x-12","بتربيع الطرفين"],["6x=12\\Rightarrow x=2","بطرح <span class=\"tx\" data-t=\"4x^2\"></span> من الطرفين"],["2(2)=4=\\sqrt{16+12-12}\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span>","o":""},{"n":"6","s":[["\\sqrt{x-2}=11-\\sqrt{x-13}","بعزل أحد الجذرين"],["x-2=121-22\\sqrt{x-13}+x-13","بتربيع الطرفين"],["22\\sqrt{x-13}=110\\Rightarrow\\sqrt{x-13}=5","بالتبسيط"],["x-13=25\\Rightarrow x=38","بتربيع الطرفين"],["\\sqrt{36}+\\sqrt{25}=6+5=11\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=38\"></span>","o":""},{"n":"7","s":[["\\sqrt{x+2}=\\sqrt{x-2}+2","بعزل أحد الجذرين"],["x+2=x-2+4\\sqrt{x-2}+4","بتربيع الطرفين"],["0=4\\sqrt{x-2}\\Rightarrow x=2","بالتبسيط"],["\\sqrt0-\\sqrt4+2=0\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span>","o":""},{"n":"8","s":[["2x-9=3^4=81","برفع الطرفين إلى القوة <span class=m dir=ltr>4</span>"],["2x=90\\Rightarrow x=45","بحل المعادلة"],["\\sqrt[4]{81}=3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=45\"></span>","o":""},{"n":"9","s":[["\\sqrt[3]{x^2+4}=2","بإضافة <span class=m dir=ltr>2</span> إلى الطرفين"],["x^2+4=8\\Rightarrow x^2=4","بتكعيب الطرفين"],["x=2\\ \\text{أو}\\ x=-2","بأخذ الجذر التربيعي"],["\\sqrt[3]{8}-2=0\\ \\checkmark","التحقق: كلا الحلين يحقق المعادلة"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span> أو <span class=\"tx\" data-t=\"x=-2\"></span>","o":""},{"n":"10","s":[["3\\sqrt{x-2}=x-2","بطرح <span class=m dir=ltr>2</span> من الطرفين"],["9(x-2)=(x-2)^2","بتربيع الطرفين"],["(x-2)(x-2-9)=0\\Rightarrow(x-2)(x-11)=0","بإخراج العامل المشترك"],["x=2\\ \\text{أو}\\ x=11","خاصية الضرب الصفري"],["x=2:\\ 0+2=2\\ \\checkmark\\quad x=11:\\ 3(3)+2=11\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=2\"></span> أو <span class=\"tx\" data-t=\"x=11\"></span>","o":""},{"n":"11","s":[["\\sqrt{v-10}=6","بقسمة الطرفين على <span class=m dir=ltr>−10</span>"],["v-10=36\\Rightarrow v=46","بتربيع الطرفين"],["-10\\sqrt{36}=-60\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"v=46\"></span>","o":""},{"n":"12","s":[["2n-88=\\frac n6","بتربيع الطرفين"],["12n-528=n\\Rightarrow11n=528","بضرب الطرفين في <span class=m dir=ltr>6</span>"],["n=48","بالقسمة على <span class=m dir=ltr>11</span>"],["\\sqrt{8}=\\sqrt{\\tfrac{48}{6}}=\\sqrt8\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"n=48\"></span>","o":""},{"n":"13","s":[["4x^2=17x-15","بتربيع الطرفين"],["4x^2-17x+15=0\\Rightarrow(4x-5)(x-3)=0","بالتحليل"],["x=\\frac54\\ \\text{أو}\\ x=3","خاصية الضرب الصفري"],["x=3:\\ 6=\\sqrt{36}\\ \\checkmark\\quad x=\\tfrac54:\\ 2.5=\\sqrt{6.25}\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=\\frac54\"></span> أو <span class=\"tx\" data-t=\"x=3\"></span>","o":""},{"n":"14","s":[["r^2+8r+16=-4r-11","بتربيع الطرفين"],["r^2+12r+27=0\\Rightarrow(r+3)(r+9)=0","بالتحليل"],["r=-3\\ \\text{أو}\\ r=-9","خاصية الضرب الصفري"],["r=-3:\\ 1=\\sqrt1\\ \\checkmark\\quad r=-9:\\ -5\\ne\\sqrt{25}","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"r=-3\"></span> (<span class=\"tx\" data-t=\"r=-9\"></span> حل دخيل)","o":""},{"n":"15","s":[["9g^2=-18-27g","بتربيع الطرفين"],["g^2+3g+2=0\\Rightarrow(g+1)(g+2)=0","بالقسمة على <span class=m dir=ltr>9</span> والتحليل"],["g=-1\\ \\text{أو}\\ g=-2","خاصية الضرب الصفري"],["g=-1:\\ 3=\\sqrt9\\ \\checkmark\\quad g=-2:\\ 6=\\sqrt{36}\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"g=-1\"></span> أو <span class=\"tx\" data-t=\"g=-2\"></span>","o":""}],[{"n":"16","s":[["\\frac12(2)\\sqrt{3x+12}=\\sqrt{5x-4}","مساحة المثلث القائم"],["\\sqrt{3x+12}=\\sqrt{5x-4}","بالتبسيط"],["3x+12=5x-4\\Rightarrow16=2x\\Rightarrow x=8","بتربيع الطرفين"],["\\sqrt{36}=\\sqrt{36}=6\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=8\"></span>","o":""}],[{"n":"17","s":[["\\sqrt{3x+7}=\\sqrt{x+5}","عند نقطة التقاطع يتساوى الإحداثي <span class=m dir=ltr>y</span> للمنحنيين"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{3x+7}=\\sqrt{x+5}\"></span>","o":""},{"n":"18","s":[["3x+7=x+5","بتربيع الطرفين"],["2x=-2\\Rightarrow x=-1","بحل المعادلة"],["\\sqrt{4}=\\sqrt{4}=2\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=-1\"></span>، ونقطة التقاطع <span class=\"tx\" data-t=\"(-1,\\ 2)\"></span>","o":""}],[{"n":"19","s":[["5\\sqrt x=10\\Rightarrow(5\\sqrt x)^2=25x","الخطأ: عند التربيع لم يربّع <span class=m dir=ltr>5</span>، فكتب <span class=\"tx\" data-t=\"5x\"></span> بدلًا من <span class=\"tx\" data-t=\"25x\"></span>"],["\\sqrt x=2","التصحيح: بقسمة الطرفين على <span class=m dir=ltr>5</span>"],["x=4","بتربيع الطرفين"],["2+5\\sqrt4=12\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"الحل الصحيح <span class=\"tx\" data-t=\"x=4\"></span>","o":""}]]