[[{"n":"1","s":[["\\sqrt{3x}=12","بإضافة <span class=m dir=ltr>5</span> إلى الطرفين"],["3x=144","بتربيع الطرفين"],["x=48","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["\\sqrt{3(48)}-5=\\sqrt{144}-5=7\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=48\"></span>","o":""},{"n":"2","s":[["1-2x=(-3)^3=-27","بتكعيب الطرفين"],["-2x=-28\\Rightarrow x=14","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>−2</span>"],["\\sqrt[3]{1-28}=\\sqrt[3]{-27}=-3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=14\"></span>","o":""},{"n":"3","s":[["4x+1=2^4=16","برفع الطرفين إلى القوة <span class=m dir=ltr>4</span>"],["4x=15\\Rightarrow x=\\frac{15}{4}","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["\\sqrt[4]{15+1}=\\sqrt[4]{16}=2\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{15}{4}=3.75\"></span>","o":""},{"n":"4","s":[["-\\sqrt{y-5}=-3\\Rightarrow\\sqrt{y-5}=3","بطرح <span class=m dir=ltr>6</span> من الطرفين ثم الضرب في <span class=m dir=ltr>−1</span>"],["y-5=9\\Rightarrow y=14","بتربيع الطرفين"],["6-\\sqrt{9}=3\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"y=14\"></span>","o":""},{"n":"5","s":[["\\sqrt{2-x}=x+4","بطرح <span class=m dir=ltr>3</span> من الطرفين"],["2-x=x^2+8x+16","بتربيع الطرفين"],["x^2+9x+14=0\\Rightarrow(x+2)(x+7)=0","بالتحليل"],["x=-2\\ \\text{أو}\\ x=-7","خاصية الضرب الصفري"],["x=-2:\\ \\sqrt4+3=5=-2+7\\ \\checkmark\\quad x=-7:\\ \\sqrt9+3=6\\ne0","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=-2\"></span> (<span class=\"tx\" data-t=\"x=-7\"></span> حل دخيل)","o":""},{"n":"6","s":[["5x+4=9x","بتربيع الطرفين"],["4=4x\\Rightarrow x=1","بطرح <span class=m dir=ltr>5x</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["\\sqrt{9}=3=3\\sqrt1\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a"