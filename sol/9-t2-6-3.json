span class=\"tx\" data-t=\"\\sqrt{x+3}=\\sqrt{2x+2}\"></span>","o":""},{"n":"20","s":[["x+3=2x+2","بتربيع الطرفين"],["x=1","بطرح <span class=m dir=ltr>x</span> و <span class=m dir=ltr>2</span> من الطرفين"],["\\sqrt{4}=\\sqrt{4}=2\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=1\"></span>، ونقطة التقاطع <span class=\"tx\" data-t=\"(1,\\ 2)\"></span>","o":""}],[{"n":"21","s":[["P=2(4+\\sqrt{6x-5})=22","محيط المستطيل"],["4+\\sqrt{6x-5}=11\\Rightarrow\\sqrt{6x-5}=7","بالقسمة على <span class=m dir=ltr>2</span> ثم طرح <span class=m dir=ltr>4</span>"],["6x-5=49\\Rightarrow x=9","بتربيع الطرفين"],["\\sqrt{54-5}=7,\\ 2(4+7)=22\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"<span class=\"tx\" data-t=\"x=9\"></span>","o":""}],[{"n":"22","s":[["150=\\sqrt{64d}","بالتعويض <span class=\"tx\" data-t=\"v=150\"></span>"],["22500=64d","بتربيع الطرفين"],["d=\\frac{22500}{64}=351.5625","بقسمة الطرفين على <span class=m dir=ltr>64</span>"],["\\sqrt{64\\times351.5625}=\\sqrt{22500}=150\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"الارتفاع <span class=\"tx\" data-t=\"d=351.5625\"></span> قدمًا <span class=\"tx\" data-t=\"\\approx351.6\\ \\text{ft}\"></span>","o":""}],[{"n":"23","s":[["340=20\\sqrt{t+273}","بالتعويض <span class=\"tx\" data-t=\"V=340\"></span>"],["17=\\sqrt{t+273}","بقسمة الطرفين على <span class=m dir=ltr>20</span>"],["289=t+273","بتربيع الطرفين"],["t=16","بطرح <span class=m dir=ltr>273</span> من الطرفين"],["20\\sqrt{289}=20\\times17=340\\ \\checkmark","التحقق بالتعويض في المعادلة الأصلية"]],"a":"درجة الحرارة <span class=\"tx\" data-t=\"16^\\circ\\text{C}\"></span>","o":"مسألة اليوم: <span class=\"tx\" data-t=\"V=20\\sqrt{t+273}\"></span>، وسرعة الصوت <span class=\"tx\" data-t=\"340\\ \\text{m/s}\"></span>."}],[{"n":"24","s":[["\\sqrt{x+1}+5=2\\Rightarrow\\sqrt{x+1}=-3","بطرح <span class=m dir=ltr>5</span> من الطرفين"],["\\sqrt{x+1}+7=10\\Rightarrow x=8,\\quad \\sqrt{x-1}+3=5\\Rightarrow x=5,\\quad \\sqrt