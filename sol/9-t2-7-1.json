[[{"n":"1","s":[["\\frac{6x(x+3)}{9x^2}=\\frac{2\\times 3\\times x(x+3)}{3\\times 3\\times x\\times x}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{2(x+3)}{3x}","بقسمة البسط والمقام على العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{2(x+3)}{3x}\"></span>","o":""},{"n":"2","s":[["\\frac{b^2+5b+4}{b^2-2b-24}=\\frac{(b+1)(b+4)}{(b-6)(b+4)}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{b+1}{b-6}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(b+4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{b+1}{b-6}\"></span>","o":""},{"n":"3","s":[["\\frac{2x^3-18x}{6x^3-12x^2-18x}=\\frac{2x(x^2-9)}{6x(x^2-2x-3)}","بإخراج العامل المشترك"],["=\\frac{2x(x-3)(x+3)}{6x(x-3)(x+1)}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{x+3}{3(x+1)}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"2x(x-3)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x+3}{3(x+1)}\"></span>","o":""},{"n":"4","s":[["\\frac{x^3-8}{x^2-4}=\\frac{(x-2)(x^2+2x+4)}{(x-2)(x+2)}","تحليل الفرق بين مكعبين والفرق بين مربعين"],["=\\frac{x^2+2x+4}{x+2}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x-2)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^2+2x+4}{x+2}\"></span>","o":""},{"n":"5","s":[["\\frac{x^3-9x^2}{x^2-3x-54}=\\frac{x^2(x-9)}{(x-9)(x+6)}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{x^2}{x+6}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x-9)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^2}{x+6}\"></span>","o":""},{"n":"6","s":[["32x^4-50=2(16x^4-25)=2(4x^2-5)(4x^2+5)","تحليل البسط (فرق بين مربعين)"],["4x^3-12x^2-5x+15=4x^2(x-3)-5(x-3)=(x-3)(4x^2-5)","تحليل المقام بالتجميع"],["\\frac{2(4x^2-5)(4x^2+5)}{(x-3)(4x^2-5)}=\\frac{2(4x^2+5)}{x-3}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(4x^2-5)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2(4x^2+5)}{x-3}\"></span>","o":""}],[{"n":"7","s":[["\\frac{3x^2y}{14c^2d}\\times\\frac{28cd}{12x^3y^2}=\\frac{3\\times 28\\, x^2y\\,cd}{14\\times 12\\, c^2d\\,x^3y^2}","بضرب البسط في البسط والمقام في المقام"],["=\\frac{84}{168}\\times\\frac{1}{c\\,x\\,y}","بقسمة العوامل المشتركة"],["=\\frac{1}{2cxy}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2cxy}\"></span>","o":""},{"n":"8","s":[["\\frac{2(d+1)}{(d+4)^2}\\times\\frac{(d+4)(d-3)}{d+1}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{2(d-3)}{d+4}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(d+1)(d+4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2(d-3)}{d+4}\"></span>","o":""},{"n":"9","s":[["\\frac{(x-4)(x+4)}{3x^3}\\times\\frac{x^2}{(x+4)(x-3)}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{x-4}{3x(x-3)}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"x^2(x+4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x-4}{3x(x-3)}\"></span>","o":""},{"n":"10","s":[["\\frac{x(x-3)}{x-2}\\times\\frac{(x+3)(x-2)}{x}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=(x-3)(x+3)=x^2-9","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"x(x-2)\"></span>"]],"a":"<span class=\"tx\" data-t=\"(x-3)(x+3)=x^2-9\"></span>","o":""},{"n":"11","s":[["\\frac{x(x-4)}{x-1}\\times\\frac{(x+4)(x-1)}{2x}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{(x-4)(x+4)}{2}=\\frac{x^2-16}{2}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"x(x-1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{(x-4)(x+4)}{2}\"></span>","o":""},{"n":"12","s":[["\\frac{(b+1)(b+11)}{(b-3)(b+3)}\\times\\frac{(b+3)(b^2-3b+9)}{(b+9)(b+11)}","بالتحليل (مجموع مكعبين في البسط الثاني)"],["=\\frac{(b+1)(b^2-3b+9)}{(b-3)(b+9)}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(b+3)(b+11)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{(b+1)(b^2-3b+9)}{(b-3)(b+9)}\"></span>","o":""}],[{"n":"13","s":[["\\frac{21x^3y^2}{12ab^2}\\times\\frac{24a^3}{3x^2y^2}","بالضرب في مقلوب المقسوم عليه"],["=\\frac{21\\times 24\\,x^3y^2a^3}{12\\times 3\\,ab^2x^2y^2}","بضرب البسط في البسط والمقام في المقام"],["=\\frac{14a^2x}{b^2}","بقسمة العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{14a^2x}{b^2}\"></span>","o":""},{"n":"14","s":[["\\frac{(x+2)(x-1)}{(x+2)(x+3)}\\times\\frac{(x+3)(x+4)}{(x+3)(x-1)}","بالضرب في مقلوب المقسوم عليه والتحليل"],["=\\frac{x+4}{x+3}","بقسمة العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x+4}{x+3}\"></span>","o":""},{"n":"15","s":[["\\frac{p}{p-4}\\times\\frac{(p-4)(p-1)}{p^2}","بالضرب في مقلوب المقسوم عليه والتحليل"],["=\\frac{p-1}{p}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"p(p-4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{p-1}{p}\"></span>","o":""},{"n":"16","s":[["\\frac{(g-7)(g+3)}{4g(g+3)}\\times\\frac{1}{g-7}","بالضرب في مقلوب المقسوم عليه والتحليل"],["=\\frac{1}{4g}","بقسمة العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{4g}\"></span>","o":""},{"n":"17","s":[["\\frac{(x-5)(x+5)}{2(x-1)}\\times\\frac{(x+5)(x-1)}{(x+5)^2}","بالضرب في مقلوب المقسوم عليه والتحليل"],["=\\frac{x-5}{2}","بقسمة العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x-5}{2}\"></span>","o":""},{"n":"18","s":[["\\frac{x+2}{3(x+4)}\\times\\frac{(x-4)(x+4)}{x+2}","بالضرب في مقلوب المقسوم عليه والتحليل"],["=\\frac{x-4}{3}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x+2)(x+4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x-4}{3}\"></span>","o":""}],[{"n":"19","s":[["\\frac{x^3y^3}{cd^4}\\div\\frac{x^2y}{c^2d}","كتابة الكسر المركب في صورة قسمة"],["=\\frac{x^3y^3}{cd^4}\\times\\frac{c^2d}{x^2y}","بالضرب في مقلوب المقسوم عليه"],["=\\frac{cxy^2}{d^3}","بقسمة العوامل المشتركة"]],"a":"<span class=\"tx\" data-t=\"\\frac{cxy^2}{d^3}\"></span>","o":""},{"n":"20","s":[["\\frac{4(a-2)}{(a-3)(a+3)}\\div\\frac{(a-2)(a+1)}{(a+3)(a+4)}","كتابة الكسر المركب في صورة قسمة مع التحليل"],["=\\frac{4(a-2)}{(a-3)(a+3)}\\times\\frac{(a+3)(a+4)}{(a-2)(a+1)}","بالضرب في مقلوب المقسوم عليه"],["=\\frac{4(a+4)}{(a-3)(a+1)}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(a-2)(a+3)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{4(a+4)}{(a-3)(a+1)}\"></span>","o":""},{"n":"21","s":[["\\frac{(2x-3)(4x+1)}{5(2x-1)(x+4)}\\div\\frac{(2x-3)(x+2)}{2(2x+1)(x+4)}","كتابة الكسر المركب في صورة قسمة مع التحليل"],["=\\frac{(2x-3)(4x+1)}{5(2x-1)(x+4)}\\times\\frac{2(2x+1)(x+4)}{(2x-3)(x+2)}","بالضرب في مقلوب المقسوم عليه"],["=\\frac{2(4x+1)(2x+1)}{5(2x-1)(x+2)}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(2x-3)(x+4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2(4x+1)(2x+1)}{5(2x-1)(x+2)}\"></span>","o":""}],[{"n":"22","s":[["A=\\frac{1}{2}\\times\\text{base}\\times\\text{height}","مساحة المثلث"],["A=\\frac{1}{2}\\times\\frac{x^2}{2h^2}\\times\\frac{8}{hx}","بالتعويض"],["=\\frac{8x^2}{4h^3x}=\\frac{2x}{h^3}","بالضرب ثم قسمة العوامل المشتركة"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{2x}{h^3}\\ \\text{cm}^2\"></span>","o":""},{"n":"23","s":[["A=\\text{base}\\times\\text{height}","مساحة متوازي الأضلاع"],["A=\\frac{x+2}{6}\\times\\frac{12x}{(x-2)(x+2)}","بالتعويض والتحليل"],["=\\frac{2x}{x-2}","بقسمة العوامل المشتركة <span class=\"tx\" data-t=\"6(x+2)\"></span>"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{2x}{x-2}\\ \\text{m}^2\"></span>","o":""}],[{"n":"24","s":[["P=(x+4)+(x+4)+(4x+6)=6x+14=2(3x+7)","محيط المثلث"],["A=\\frac{1}{2}(4x+6)(2x)=2x(2x+3)","مساحة المثلث: القاعدة <span class=\"tx\" data-t=\"4x+6\"></span> والارتفاع <span class=\"tx\" data-t=\"2x\"></span>"],["\\frac{P}{A}=\\frac{2(3x+7)}{2x(2x+3)}","النسبة بين المحيط والمساحة"],["=\\frac{3x+7}{x(2x+3)}","بقسمة البسط والمقام على <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{3x+7}{x(2x+3)}\"></span>","o":""}],[{"n":"25","s":[["V_{cyl}=\\pi r^2h=\\pi x^2(x+4)","حجم الأسطوانة: نصف القطر <span class=\"tx\" data-t=\"x\"></span> (القطر <span class=\"tx\" data-t=\"2x\"></span>)"],["V_{cone}=\\frac{1}{3}\\pi(3x)^2d=3\\pi x^2d","حجم المخروط"],["3\\pi x^2d=\\pi x^2(x+4)","الحجمان متساويان"],["d=\\frac{\\pi x^2(x+4)}{3\\pi x^2}=\\frac{x+4}{3}","بقسمة الطرفين على <span class=\"tx\" data-t=\"3\\pi x^2\"></span>"]],"a":"ارتفاع الشمعة المخروطية <span class=\"tx\" data-t=\"d=\\frac{x+4}{3}\\ \\text{cm}\"></span>","o":""}],[{"n":"26","s":[["A=\\frac{x^2}{x^2-2x-15}\\times\\frac{x-5}{x}","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض (مسألة اليوم)"],["=\\frac{x^2}{(x-5)(x+3)}\\times\\frac{x-5}{x}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{x}{x+3}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"x(x-5)\"></span>"]],"a":"مساحة الشاشة <span class=\"tx\" data-t=\"\\frac{x}{x+3}\"></span> وحدة مربعة","o":"مسألة اليوم: شاشة طولها <span class=\"tx\" data-t=\"\\frac{x^2}{x^2-2x-15}\"></span> وعرضها <span class=\"tx\" data-t=\"\\frac{x-5}{x}\"></span>"}],[{"n":"27","s":[["\\frac{x+3}{(2x+1)(x+3)}=\\frac{x+3}{2x^2+7x+3}","نضرب البسط والمقام في العامل نفسه <span class=\"tx\" data-t=\"(x+3)\"></span>"],["\\frac{x+3}{2x^2+7x+3}=\\frac{x+3}{(2x+1)(x+3)}=\\frac{1}{2x+1}","تحقق: بالتحليل والاختصار"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\frac{x+3}{2x^2+7x+3}\"></span>","o":""}],[{"n":"28","s":[["\\frac{x^2+6x+8}{x^2+4x}=\\frac{(x+2)(x+4)}{x(x+4)}=\\frac{x+2}{x}","بالتحليل: يوجد عامل مشترك <span class=\"tx\" data-t=\"(x+4)\"></span>"],["\\frac{x-2}{x^2},\\ \\frac{x+8}{4x^2},\\ \\frac{x^2-x+1}{x(x+4)}","لا يوجد عامل مشترك بين البسط والمقام في كلٍّ منها"]],"a":"المختلف هو <span class=\"tx\" data-t=\"\\frac{x^2+6x+8}{x^2+4x}\"></span> لأنه ليس في أبسط صورة (يُختصر إلى <span class=\"tx\" data-t=\"\\frac{x+2}{x}\"></span>)، أما البقية ففي أبسط صورة.","o":""}],[{"n":"29","s":[["\\frac{x+2}{x-2}\\ne\\frac{2}{-1}","الخطأ: اختُصِر المتغير <span class=\"tx\" data-t=\"x\"></span> من الحدود <span class=\"tx\" data-t=\"x+2\"></span> و <span class=\"tx\" data-t=\"x-2\"></span> و <span class=\"tx\" data-t=\"x-1\"></span>، والاختصار يكون للعوامل لا للحدود"],["\\frac{x+2}{x-2}\\times\\frac{(x+2)(x-2)}{(x+2)(x-1)}","بتحليل كلٍّ من البسط والمقام إلى العوامل"],["=\\frac{x+2}{x-1}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x+2)(x-2)\"></span>"]],"a":"الصحيح: <span class=\"tx\" data-t=\"\\frac{x+2}{x-1}\"></span>","o":""}],[{"n":"30","s":[["\\frac{1}{\\frac{x^2-4y^2}{x+2y}}=1\\div\\frac{(x-2y)(x+2y)}{x+2y}","كتابة الكسر المركب في صورة قسمة مع التحليل"],["=1\\div(x-2y)=\\frac{1}{x-2y}","بالتبسيط"]],"a":"لا؛ المقدار يساوي <span class=\"tx\" data-t=\"\\frac{1}{x-2y}\"></span> وهو مقلوب <span class=\"tx\" data-t=\"x-2y\"></span> وليس مكافئًا له.","o":""}],[{"n":"1","s":[["a)\\ \\frac{(x-3)(x+2)}{(x+1)(x+2)}","يوجد عامل مشترك <span class=\"tx\" data-t=\"(x+2)\"></span>"],["c)\\ \\frac{(x-2)(x-4)}{(x-2)(x+1)},\\quad d)\\ \\frac{(x+4)(x-1)}{(x+2)(x-1)}","يوجد عامل مشترك في كلٍّ منهما"],["b)\\ \\frac{(x+2)(x+4)}{(x+3)(x-1)}","لا يوجد عامل مشترك"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"\\frac{x^2+6x+8}{x^2+2x-3}\"></span>","o":""}],[{"n":"2","s":[["S=6(2x)^2=24x^2,\\quad V=(2x)^3=8x^3","مساحة السطح الكلية والحجم"],["\\frac{S}{V}=\\frac{24x^2}{8x^3}=\\frac{3}{x}","النسبة في أبسط صورة"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\frac{3}{x}\"></span>","o":""}],[{"n":"3","s":[["\\frac{2(w+4)}{3}\\times\\frac{6}{(w+2)(w+4)}","بالتحليل إلى العوامل"],["=\\frac{12}{3(w+2)}=\\frac{4}{w+2}","بقسمة العوامل المشتركة"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"\\frac{4}{w+2}\"></span>","o":""}],[{"n":"4","s":[["\\frac{x-3}{6x^2}\\times\\frac{2x}{x-3}","بالضرب في المقلوب"],["=\\frac{2x}{6x^2}=\\frac{1}{3x}","بقسمة العوامل المشتركة"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"\\frac{1}{3x}\"></span>","o":""}],[{"n":"7","s":[["\\frac{2(x-1)(x-4)}{(x-1)(3x-4)}","بالتحليل إلى العوامل"],["=\\frac{2(x-4)}{3x-4}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x-1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2(x-4)}{3x-4}\"></span>","o":""},{"n":"8","s":[["\\frac{x(7x^2-32x+16)}{4(x-4)}=\\frac{x(7x-4)(x-4)}{4(x-4)}","بالتحليل إلى العوامل"],["=\\frac{x(7x-4)}{4}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"(x-4)\"></span>"]],"a":"