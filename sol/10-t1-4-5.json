[[{"n":"1","s":[["AC^2 = 10^2 + 8^2 = 164","نظرية فيثاغورس في المستطيل <span class=m dir=ltr>ABCD</span>"],["AC = \\sqrt{164} \\approx 12.81","بأخذ الجذر"],["\\tan\\theta = \\frac{PA}{AC} = \\frac{6}{12.81}","المثلث <span class=m dir=ltr>PAC</span> قائم في <span class=m dir=ltr>A</span>"],["\\theta \\approx 25.1^\\circ","معكوس الظل"]],"a":"زاوية ارتفاع قمة السارية من <span class=\"tx\" data-t=\"C\"></span> تقريبًا <span class=\"tx\" data-t=\"25.1^\\circ\"></span>","o":""}],[{"n":"2","s":[["AC^2 = 20^2 + 15^2 = 625","نظرية فيثاغورس في المثلث <span class=m dir=ltr>ABC</span>"],["AC = 25",""]],"a":"<span class=\"tx\" data-t=\"AC = 25\\text{ cm}\"></span>","o":"","k":[{"e":"25","a":null}]},{"n":"3","s":[["\\cos\\angle VAC = \\frac{12.5}{24}","العمود من <span class=m dir=ltr>V</span> يقع في منتصف <span class=m dir=ltr>AC</span>، فنصف القطر <span class=m dir=ltr>12.5</span>"],["\\angle VAC \\approx 58.6^\\circ","معكوس جيب التمام"]],"a":"<span class=\"tx\" data-t=\"\\angle VAC \\approx 58.6^\\circ\"></span>","o":""},{"n":"4","s":[["h^2 = 24^2 - 12.5^2 = 419.75","نظرية فيثاغورس"],["h \\approx 20.49","بأخذ الجذر"]],"a":"ارتفاع الهرم تقريبًا <span class=\"tx\" data-t=\"20.5\\text{ cm}\"></span>","o":"","k":[{"e":"20.5","a":true}]}],[{"n":"5","s":[["\\sin 34^\\circ = \\frac{150}{d}","<span class=m dir=ltr>d</span> المسافة بين الصياد وقاعدة المنارة (الوتر)"],["d = \\frac{150}{\\sin 34^\\circ} \\approx 268.2","بحل المعادلة"]],"a":"يبعد الصياد عن قاعدة المنارة تقريبًا <span class=\"tx\" data-t=\"268.2\\text{ m}\"></span>","o":"البعد الأفقي بين الصياد والجرف: <span class=\"tx\" data-t=\"\\frac{150}{\\tan34^\\circ} \\approx 222.4\\text{ m}\"></span>."},{"n":"6","s":[["150 + 50 = 200","ارتفاع قمة المنارة عن مستوى عيني الصياد"],["\\tan\\theta = \\frac{200}{222.4}","البعد الأفقي <span class=\"tx\" data-t=\"\\frac{150}{\\tan34^\\circ}\\approx 222.4\"></span>"],["\\theta \\approx 42.0^\\circ","معكوس الظل"]],"a":"زاوية الارتفاع نحو قمة المنارة تقريبًا <span class=\"tx\" data-t=\"42.0^\\c