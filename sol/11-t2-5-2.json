[[{"n":"1","s":[["f'(x)=x-3","المشتقة المعطاة"],["f(x)=\\int(x-3)\\,dx=\\frac{x^{2}}{2}-3x+C","بتكامل المشتقة"],["9=\\frac{(2)^{2}}{2}-3(2)+C\\Rightarrow 9=-4+C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(2,9)\"></span>"],["C=13","بإضافة <span class=m dir=ltr>4</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\frac{x^{2}}{2}-3x+13\"></span>","o":""},{"n":"2","s":[["f'(x)=x^{2}-4","المشتقة المعطاة"],["f(x)=\\frac{x^{3}}{3}-4x+C","بتكامل المشتقة"],["7=0-0+C\\Rightarrow C=7","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(0,7)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\frac{x^{3}}{3}-4x+7\"></span>","o":""},{"n":"3","s":[["f'(x)=6x^{2}-4x+2","المشتقة المعطاة"],["f(x)=2x^{3}-2x^{2}+2x+C","بتكامل المشتقة"],["9=2-2+2+C\\Rightarrow C=7","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1,9)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=2x^{3}-2x^{2}+2x+7\"></span>","o":""},{"n":"4","s":[["f'(x)=x^{\\frac{1}{2}}+\\frac{1}{4}x^{2}","المشتقة المعطاة"],["f(x)=\\frac{2}{3}x^{\\frac{3}{2}}+\\frac{x^{3}}{12}+C","بتكامل المشتقة"],["11=\\frac{2}{3}(8)+\\frac{64}{12}+C=\\frac{32}{3}+C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(4,11)\"></span>، <span class=\"tx\" data-t=\"4^{\\frac{3}{2}}=8\"></span>"],["C=11-\\frac{32}{3}=\\frac{1}{3}","بطرح <span class=\"tx\" data-t=\"\\frac{32}{3}\"></span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\frac{2}{3}x^{\\frac{3}{2}}+\\frac{1}{12}x^{3}+\\frac{1}{3}\"></span>","o":""},{"n":"5","s":[["f'(x)=(x+2)^{2}","المشتقة المعطاة"],["f(x)=\\frac{(x+2)^{3}}{3}+C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^{n}\"></span>"],["7=\\frac{(3)^{3}}{3}+C=9+C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1,7)\"></span>"],["C=-2","بطرح <span class=m dir=ltr>9</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\frac{(x+2)^{3}}{3}-2\"></span>","o":""},{"n":"6","s":[["f'(x)=3x^{-\\frac{1}{2}}-x","المشتقة المعطاة"],["f(x)=6\\sqrt{x}-\\frac{x^{2}}{2}+C","بتكامل المشتقة"],["0=6(2)-\\frac{16}{2}+C=4+C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(4,0)\"></span>"],["C=-4","بطرح <span class=m dir=ltr>4</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x)=6\\sqrt{x}-\\frac{x^{2}}{2}-4\"></span>","o":""}],[{"n":"7","s":[["y=\\int(0.4x+3)\\,dx=0.2x^{2}+3x+C","بتكامل الميل"],["5=0.2(0)^{2}+3(0)+C\\Rightarrow C=5","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(0,5)\"></span>"]],"a":"<span class=\"tx\" data-t=\"y=0.2x^{2}+3x+5\"></span>","o":""}],[{"n":"8","s":[["f'(x)=\\frac{x^{2}+10}{x^{2}}=1+10x^{-2}","بقسمة كل حد على <span class=\"tx\" data-t=\"x^{2}\"></span>"],["f(x)=x+10\\cdot\\frac{x^{-1}}{-1}+C=x-\\frac{10}{x}+C","بالتكامل"],["2=5-\\frac{10}{5}+C=3+C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(5,2)\"></span>"],["C=-1","بطرح <span class=m dir=ltr>3</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x)=x-\\frac{10}{x}-1\"></span>","o":""}],[{"n":"9","s":[["f(x)=\\int(3x^{2}-4x-5)\\,dx=x^{3}-2x^{2}-5x+C","بالتكامل"],["(1,0)","من الشكل: المنحنى يقطع المحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>"],["0=1-2-5+C\\Rightarrow C=6","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1,0)\"></span>"],["f(0)=6","تحقُّق: المقطع <span class=\"tx\" data-t=\"y\"></span> في الشكل بين <span class=m dir=ltr>5</span> و <span class=m dir=ltr>10</span> تقريبًا عند <span class=m dir=ltr>6</span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=x^{3}-2x^{2}-5x+6\"></span>","o":"يمكن أيضًا استعمال النقطة <span class=\"tx\" data-t=\"(3,0)\"></span> أو <span class=\"tx\" data-t=\"(-2,0)\"></span> من الشكل، وتعطي النتيجة نفسها."}],[{"n":"10","s":[["y=\\int 4t^{-\\frac{2}{3}}\\,dt=4\\cdot\\frac{t^{\\frac{1}{3}}}{\\frac{1}{3}}+C=12t^{\\frac{1}{3}}+C","بالتكامل"],["30=12\\sqrt[3]{8}+C=24+C","بالتعويض: <span class=\"tx\" data-t=\"y=30\"></span> عندما <span class=\"tx\" data-t=\"t=8\"></span>"],["C=6","بطرح <span class=m dir=ltr>24</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"y=12\\sqrt[3]{t}+6\"></span>","o":""},{"n":"11","s":[["y(27)=12\\sqrt[3]{27}+6","بالتعويض <span class=\"tx\" data-t=\"t=27\"></span>"],["=12(3)+6=42","بالتبسيط"]],"a":"نصف القطر بعد <span class=m dir=ltr>27</span> ثانية <span class=\"tx\" data-t=\"42\\ \\text{cm}\"></span>","o":""}],[{"n":"12","s":[["h(t)=\\int\\left(0.2t^{\\frac{2}{3}}+t^{\\frac{1}{2}}\\right)dt","بتكامل معدل التغير"],["=0.2\\cdot\\frac{t^{\\frac{5}{3}}}{\\frac{5}{3}}+\\frac{t^{\\frac{3}{2}}}{\\frac{3}{2}}+C=0.12t^{\\frac{5}{3}}+\\frac{2}{3}t^{\\frac{3}{2}}+C","قاعدة القوة"],["h(0)=2\\Rightarrow 0+0+C=2\\Rightarrow C=2","الشرط الأولي: الارتفاع عند الزراعة <span class=m dir=ltr>2 ft</span>"]],"a":"<span class=\"tx\" data-t=\"h(t)=0.12t^{\\frac{5}{3}}+\\frac{2}{3}t^{\\frac{3}{2}}+2\"></span>","o":""}],[{"n":"13","s":[["s(t)=\\int(2t+3)\\,dt=t^{2}+3t+C","الموقع هو تكامل السرعة"],["s(0)=0\\Rightarrow C=0","بدأ من نقطة الأصل"],["s(3)=(3)^{2}+3(3)=18","بالتعويض <span class=\"tx\" data-t=\"t=3\"></span>"]],"a":"موقع الجسيم بعد <span class=m dir=ltr>3</span> ثوانٍ <span class=\"tx\" data-t=\"18\\ \\text{m}\"></span>","o":""}],[{"n":"14","s":[["v(t)=\\int t^{2}\\,dt=\\frac{t^{3}}{3}+C_{1}","السرعة هي تكامل التسارع"],["1=\\frac{1}{3}+C_{1}\\Rightarrow C_{1}=\\frac{2}{3}","بالتعويض <span class=\"tx\" data-t=\"v(1)=1\"></span>"],["s(t)=\\int\\left(\\frac{t^{3}}{3}+\\frac{2}{3}\\right)dt=\\frac{t^{4}}{12}+\\frac{2}{3}t+C_{2}","الموقع هو تكامل السرعة"],["s(0)=3\\Rightarrow C_{2}=3","الموقع الابتدائي <span class=m dir=ltr>3 m</span>"],["s(2)=\\frac{16}{12}+\\frac{4}{3}+3=\\frac{17}{3}","بالتعويض <span class=\"tx\" data-t=\"t=2\"></span>"]],"a":"موقع الجسيم بعد ثانيتين <span class=\"tx\" data-t=\"\\frac{17}{3}\\ \\text{m}\\approx 5.67\\ \\text{m}\"></span>","o":""}],[{"n":"15","s":[["v(t)=\\int(9-2t)\\,dt=9t-t^{2}+C_{1}","السرعة هي تكامل التسارع"],["v(0)=2\\Rightarrow C_{1}=2","السرعة الابتدائية <span class=m dir=ltr>2 m/s</span>"],["s(t)=\\int(9t-t^{2}+2)\\,dt=\\frac{9}{2}t^{2}-\\frac{t^{3}}{3}+2t+C_{2}","الموقع هو تكامل السرعة"],["s(0)=0\\Rightarrow C_{2}=0","بدأ من نقطة الأصل"],["s(2)=18-\\frac{8}{3}+4=\\frac{58}{3}","بالتعويض <span class=\"tx\" data-t=\"t=2\"></span>"]],"a":"موقع الجسيم بعد ثانيتين <span class=\"tx\" data-t=\"\\frac{58}{3}\\ \\text{m}\\approx 19.33\\ \\text{m}\"></span>","o":""}],[{"n":"16","s":[["f'(-2)=7\\Rightarrow -2a+b=7","ميل المماس عند <span class=\"tx\" data-t=\"x=-2\"></span> هو <span class=m dir=ltr>7</span>"],["f(x)=\\frac{a}{2}x^{2}+bx+C,\\ f(0)=18\\Rightarrow C=18","بالتكامل، والمنحنى يقطع المحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"(0,18)\"></span>"],["f(-2)=8\\Rightarrow 2a-2b+18=8\\Rightarrow a-b=-5","المنحنى يمر بالنقطة <span class=\"tx\" data-t=\"(-2,8)\"></span>"],["-a=2\\Rightarrow a=-2,\\ b=3","بجمع المعادلتين ثم التعويض"],["f(x)=-x^{2}+3x+18","بالتعويض عن <span class=\"tx\" data-t=\"a\"></span> و <span class=\"tx\" data-t=\"b\"></span> و <span class=\"tx\" data-t=\"C\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=-x^{2}+3x+18\"></span>","o":"تبرير: تحقُّق <span class=\"tx\" data-t=\"f(-2)=-4-6+18=8\"></span> و <span class=\"tx\" data-t=\"f&#x27;(-2)=4+3=7\"></span> و <span class=\"tx\" data-t=\"f(0)=18\"></span>، فالشروط الثلاثة متحققة."}],[{"n":"17","s":[["f'(a)=0\\Rightarrow 4-\\frac{100}{a^{2}}=0","عند النقطة الحرجة تكون المشتقة صفرًا"],["a^{2}=25\\Rightarrow a=5","لأن <span class=\"tx\" data-t=\"a&gt;0\"></span>"],["f(x)=\\int(4-100x^{-2})\\,dx=4x+\\frac{100}{x}+C","بالتكامل"],["10=4(5)+\\frac{100}{5}+C=40+C\\Rightarrow C=-30","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(5,10)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=4x+\\frac{100}{x}-30\"></span>","o":""}],[{"n":"4","s":[["f'(x) = 4 - 2x","من الشكل: المقطع الصادي <span class=m dir=ltr>4</span> والميل <span class=\"tx\" data-t=\"\\frac{0-4}{2-0} = -2\"></span>"],["f(x) = \\int (4 - 2x)\\,dx = 4x - x^2 + C","بتكامل المشتقة"],["f'(x) = 0 \\Rightarrow x = 2","القيمة العظمى عند <span class=\"tx\" data-t=\"x = 2\"></span> (المشتقة تتغير من موجبة إلى سالبة)"],["f(2) = 8 - 4 + C = 12 \\Rightarrow C = 8","بالتعويض بالشرط الأولي <span class=\"tx\" data-t=\"f(2) = 12\"></span>"],["f(x) = 8 + 4x - x^2",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"f(x) = 8 + 4x - x^2\"></span>","o":""}],[{"n":"24","s":[["f'(x) = \\int(ax + b)^3\\,dx = \\frac{(ax + b)^4}{4a} + C_1","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^n\"></span> حيث <span class=\"tx\" data-t=\"a \\ne 0\"></span>"],["f(x) = \\int\\left(\\frac{(ax + b)^4}{4a} + C_1\\right)dx","بتكامل <span class=\"tx\" data-t=\"f&#x27;(x)\"></span>"],["= \\frac{(ax + b)^5}{4a \\cdot 5a} + C_1x + C_2","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^n\"></span> مرة ثانية"],["f(x) = \\frac{(ax + b)^5}{20a^2} + C_1x + C_2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{(ax + b)^5}{20a^2} + C_1x + C_2\"></span> حيث <span class=\"tx\" data-t=\"C_1, C_2\"></span> ثابتان","o":"إذا كان <span class=\"tx\" data-t=\"a = 0\"></span> فإن <span class=\"tx\" data-t=\"f&#x27;&#x27;(x) = b^3\"></span> و <span class=\"tx\" data-t=\"f(x) = \\frac{b^3}{2}x^2 + C_1x + C_2\"></span>."}],[{"n":"25","s":[["s(t) = \\int v(t)\\,dt = \\int(8 + 4t)\\,dt","الموقع هو تكامل السرعة"],["s(t) = 8t + 2t^2 + C","قاعدة تكامل اقتران القوة"],["s(0) = 0 \\Rightarrow C = 0","بدأ الحركة من نقطة الأصل (شرط أولي)"],["s(t) = 2t^2 + 8t",""]],"a":"<span class=\"tx\" data-t=\"s(t) = 2t^2 + 8t\"></span> متر","o":""},{"n":"26","s":[["s(2) = 2(2)^2 + 8(2)","بالتعويض <span class=\"tx\" data-t=\"t = 2\"></span>"],["= 8 + 16 = 24",""]],"a":"موقع الجسيم بعد ثانيتين <span class=\"tx\" data-t=\"24\\,\\text{m}\"></span>","o":""}],[{"n":"28","s":[["f'(x) = 0 \\Rightarrow 2x + 6 = 0 \\Rightarrow x = -3","القيمة الصغرى المحلية عند النقطة الحرجة"],["(-3, 0)","نقطة القيمة الصغرى تقع على المحور <span class=\"tx\" data-t=\"x\"></span> فإحداثيها <span class=\"tx\" data-t=\"y\"></span> صفر"],["f(x) = \\int(2x + 6)\\,dx = x^2 + 6x + C","بتكامل المشتقة"],["f(-3) = 9 - 18 + C = 0 \\Rightarrow C = 9","بالتعويض بالشرط الأولي"],["f(x) = x^2 + 6x + 9",""]],"a":"<span class=\"tx\" data-t=\"f(x) = x^2 + 6x + 9\"></span>","o":""}],[{"n":"1","s":[["f(x) = \\int(3x - 2)\\,dx = \\frac{3}{2}x^2 - 2x + C","بتكامل المشتقة"],["f(-1) = \\frac{3}{2} + 2 + C = 2","بالتعويض بإحداثيي النقطة (الشرط الأولي)"],["C = -\\frac{3}{2}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{3}{2}x^2 - 2x - \\frac{3}{2}\"></span>","o":""},{"n":"2","s":[["\\frac{x + 1}{\\sqrt{x}} = x^{\\frac{1}{2}} + x^{-\\frac{1}{2}}","بتوزيع المقام"],["f(x) = \\frac{2}{3}x^{\\frac{3}{2}} + 2x^{\\frac{1}{2}} + C","بتكامل المشتقة"],["f(4) = \\frac{2}{3}(8) + 2(2) + C = \\frac{28}{3} + C = 5","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(4, 5)\"></span>"],["C = 5 - \\frac{28}{3} = -\\frac{13}{3}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{2}{3}x^{\\frac{3}{2}} + 2\\sqrt{x} - \\frac{13}{3}\"></span>","o":""},{"n":"3","s":[["f'(x) = -x(x + 1) = -x^2 - x","بالتوزيع"],["f(x) = -\\frac{x^3}{3} - \\frac{x^2}{2} + C","بتكامل المشتقة"],["f(-1) = \\frac{1}{3} - \\frac{1}{2} + C = -\\frac{1}{6} + C = 5","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(-1, 5)\"></span>"],["C = \\frac{31}{6}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"f(x) = -\\frac{x^3}{3} - \\frac{x^2}{2} + \\frac{31}{6}\"></span>","o":""},{"n":"4","s":[["f'(x) = x^3 - 2x^{-2} + 2","بكتابة المشتقة على صورة قوى"],["f(x) = \\frac{x^4}{4} + \\frac{2}{x} + 2x + C","بتكامل المشتقة"],["f(1) = \\frac{1}{4} + 2 + 2 + C = 3","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1, 3)\"></span>"],["C = 3 - \\frac{17}{4} = -\\frac{5}{4}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{x^4}{4} + \\frac{2}{x} + 2x - \\frac{5}{4}\"></span>","o":""},{"n":"5","s":[["f(x) = \\int(x + x^{\\frac{1}{2}})\\,dx = \\frac{x^2}{2} + \\frac{2}{3}x^{\\frac{3}{2}} + C","بتكامل المشتقة"],["f(1) = \\frac{1}{2} + \\frac{2}{3} + C = 2","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1, 2)\"></span>"],["C = 2 - \\frac{7}{6} = \\frac{5}{6}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{x^2}{2} + \\frac{2}{3}x^{\\frac{3}{2}} + \\frac{5}{6}\"></span>","o":""},{"n":"6","s":[["f(x) = \\int -10x^{-2}\\,dx = \\frac{-10x^{-1}}{-1} + C = \\frac{10}{x} + C","بتكامل المشتقة"],["f(1) = 10 + C = 15","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(1, 15)\"></span>"],["C = 5","بطرح <span class=m dir=ltr>10</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{10}{x} + 5\"></span>","o":""}],[{"n":"7","s":[["f(x) = \\int x^{\\frac{1}{2}}\\,dx = \\frac{2}{3}x^{\\frac{3}{2}} + C","بتكامل المشتقة"],["f(9) = \\frac{2}{3}(27) + C = 18 + C = 25","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(9, 25)\"></span>؛ <span class=\"tx\" data-t=\"9^{\\frac{3}{2}} = 27\"></span>"],["C = 7","بطرح <span class=m dir=ltr>18</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"f(x) = \\frac{2}{3}x^{\\frac{3}{2}} + 7\"></span>","o":""}],[{"n":"8","s":[["y = \\int 2x^{-2}\\,dx = \\frac{2x^{-1}}{-1} + C = -\\frac{2}{x} + C","بتكامل المشتقة"],["4 = -\\frac{2}{2} + C","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(2, 4)\"></span>"],["C = 5","بإضافة <span class=m dir=ltr>1</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"y = -\\frac{2}{x} + 5\"></span>","o":""}],[{"n":"9","s":[["y = \\int(3x^2 - 12x + 8)\\,dx = x^3 - 6x^2 + 8x + C","بتكامل المشتقة"],["0 = 0 - 0 + 0 + C \\Rightarrow C = 0","المنحنى يمر بنقطة الأصل <span class=\"tx\" data-t=\"(0, 0)\"></span>"],["y = x^3 - 6x^2 + 8x",""],["x^3 - 6x^2 + 8x = 0 \\Rightarrow x(x - 2)(x - 4) = 0","التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span> عندما <span class=\"tx\" data-t=\"y = 0\"></span>، ثم التحليل"],["x = 0,\\; x = 2,\\; x = 4","خاصية الضرب الصفري"]],"a":"الإحداثيات <span class=\"tx\" data-t=\"x\"></span> لنقاط التقاطع: <span class=\"tx\" data-t=\"0, 2, 4\"></span>","o":"التبرير: وجدنا قاعدة العلاقة بالتكامل والشرط الأولي، ثم حللنا <span class=\"tx\" data-t=\"y = 0\"></span>."}],[{"n":"10","s":[["R(x) = \\int(x^2 - 3)\\,dx = \\frac{x^3}{3} - 3x + C","الإيراد هو تكامل الإيراد الحدّي"],["R(0) = 0 \\Rightarrow C = 0","بالتعويض بالشرط الأولي"],["R(x) = \\frac{x^3}{3} - 3x",""]],"a":"<span class=\"tx\" data-t=\"R(x) = \\frac{x^3}{3} - 3x\"></span>","o":""}],[{"n":"11","s":[["s(t) = \\int(3t^2 - 12t + 11)\\,dt = t^3 - 6t^2 + 11t + C","الموقع هو تكامل السرعة"],["s(0) = 0 \\Rightarrow C = 0","بدأ الحركة من نقطة الأصل"],["s(2) = 8 - 24 + 22 = 6","بالتعويض <span class=\"tx\" data-t=\"t = 2\"></span>"]],"a":"موقع الجسيم بعد ثانيتين <span class=\"tx\" data-t=\"6\\,\\text{m}\"></span>","o":""}],[{"n":"12","s":[["v(t) = \\int(6t - 30)\\,dt = 3t^2 - 30t + C_1","السرعة هي تكامل التسارع"],["v(0) = 72 \\Rightarrow C_1 = 72","السرعة الابتدائية <span class=m dir=ltr>72 m/s</span>"],["s(t) = \\int(3t^2 - 30t + 72)\\,dt = t^3 - 15t^2 + 72t + C_2","الموقع هو تكامل السرعة"],["s(0) = 0 \\Rightarrow C_2 = 0","بدأ الحركة من نقطة الأصل"],["s(3) = 27 - 135 + 216 = 108","بالتعويض <span class=\"tx\" data-t=\"t = 3\"></span>"]],"a":"موقع الجسيم بعد <span class=m dir=ltr>3</span> ثوانٍ <span class=\"tx\" data-t=\"108\\,\\text{m}\"></span>","o":""}]]