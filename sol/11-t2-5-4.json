[[{"n":"1","s":[["A=\\int_{-2}^{1}(x^{2}+2)\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["=\\left.\\left(\\frac{x^{3}}{3}+2x\\right)\\right|_{-2}^{1}=\\left(\\frac{1}{3}+2\\right)-\\left(-\\frac{8}{3}-4\\right)","بالتكامل والتعويض"],["=\\frac{7}{3}+\\frac{20}{3}=9","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"9\"></span> وحدات مربعة","o":""},{"n":"2","s":[["\\int_{2}^{4}\\left(2x^{-2}-3\\right)dx=\\left.\\left(-\\frac{2}{x}-3x\\right)\\right|_{2}^{4}","المنطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["=(-0.5-12)-(-1-6)=-5.5","بالتعويض بالحدين"],["A=|-5.5|=5.5","المساحة هي القيمة المطلقة للتكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{11}{2}=5.5\"></span> وحدة مربعة","o":""},{"n":"3","s":[["\\int_{-1}^{0}(x^{3}-3x)\\,dx=\\left.\\left(\\frac{x^{4}}{4}-\\frac{3}{2}x^{2}\\right)\\right|_{-1}^{0}=0-\\left(\\frac{1}{4}-\\frac{3}{2}\\right)=\\frac{5}{4}","الجزء فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{1}(x^{3}-3x)\\,dx=\\frac{1}{4}-\\frac{3}{2}=-\\frac{5}{4}","الجزء تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["A=\\frac{5}{4}+\\left|-\\frac{5}{4}\\right|=\\frac{5}{2}","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{5}{2}=2.5\"></span> وحدة مربعة","o":""}],[{"n":"4","s":[["3x^{2}-2x+2=0:\\ \\Delta=(-2)^{2}-4(3)(2)=-20<0","لا أصفار، فالمنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> دائمًا"],["A=\\int_{0}^{2}(3x^{2}-2x+2)\\,dx=\\left.(x^{3}-x^{2}+2x)\\right|_{0}^{2}","بالتكامل"],["=8-4+4=8","بالتعويض بالحدين"]],"a":"المساحة <span class=\"tx\" data-t=\"8\"></span> وحدات مربعة","o":""}],[{"n":"5","s":[["9-x^{2}=0\\Rightarrow x=\\pm 3","نقاط تقاطع المنحنى مع المحور <span class=\"tx\" data-t=\"x\"></span> (حدود التكامل)"],["A=\\int_{-3}^{3}(9-x^{2})\\,dx=\\left.\\left(9x-\\frac{x^{3}}{3}\\right)\\right|_{-3}^{3}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في الفترة"],["=(27-9)-(-27+9)=36","بالتعويض بالحدين"]],"a":"المساحة <span class=\"tx\" data-t=\"36\"></span> وحدة مربعة","o":""}],[{"n":"6","s":[["x^{3}+4x=x(x^{2}+4)=0\\Rightarrow x=0","الصفر الوحيد داخل الفترة"],["\\int_{-1}^{0}(x^{3}+4x)\\,dx=\\left.\\left(\\frac{x^{4}}{4}+2x^{2}\\right)\\right|_{-1}^{0}=-\\frac{9}{4}","الجزء تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{2}(x^{3}+4x)\\,dx=4+8=12","الجزء فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["A=\\frac{9}{4}+12=\\frac{57}{4}","بجمع القيم المطلقة"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{57}{4}=14.25\"></span> وحدة مربعة","o":""}],[{"n":"7","s":[["-x^{2}+2x-7=0:\\ \\Delta=4-28=-24<0","لا أصفار، والمعامل الرئيس سالب، فالمنحنى تحت المحور <span class=\"tx\" data-t=\"x\"></span> دائمًا"],["\\int_{1}^{4}(-7+2x-x^{2})\\,dx=\\left.\\left(-7x+x^{2}-\\frac{x^{3}}{3}\\right)\\right|_{1}^{4}","بالتكامل"],["=\\left(-12-\\frac{64}{3}\\right)-\\left(-6-\\frac{1}{3}\\right)=-27","بالتعويض بالحدين"],["A=|-27|=27","المساحة هي القيمة المطلقة"]],"a":"المساحة <span class=\"tx\" data-t=\"27\"></span> وحدة مربعة","o":""}],[{"n":"8","s":[["5-x=0\\Rightarrow x=5","الصفر عند طرف الفترة، و <span class=\"tx\" data-t=\"5-x\\ge0\"></span> في <span class=\"tx\" data-t=\"[3,5]\"></span>"],["A=\\int_{3}^{5}(5-x)\\,dx=\\left.\\left(5x-\\frac{x^{2}}{2}\\right)\\right|_{3}^{5}","بالتكامل"],["=12.5-10.5=2","بالتعويض بالحدين"]],"a":"المساحة <span class=\"tx\" data-t=\"2\"></span> وحدة مربعة","o":""}],[{"n":"9","s":[["V=\\pi\\int_{2}^{5}(0.3x)^{2}\\,dx=0.09\\pi\\int_{2}^{5}x^{2}\\,dx","صيغة حجم المجسم الدوراني <span class=\"tx\" data-t=\"V=\\pi\\int_{a}^{b}y^{2}dx\"></span>"],["=0.09\\pi\\left.\\frac{x^{3}}{3}\\right|_{2}^{5}=0.09\\pi\\cdot\\frac{125-8}{3}","بالتكامل والتعويض"],["=0.09\\pi(39)=3.51\\pi\\approx 11.03","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"V=3.51\\pi\\approx 11.03\"></span> وحدة مكعبة","o":""}],[{"n":"10","s":[["V=\\pi\\int_{-1}^{1}(x^{2}+3)^{2}\\,dx","صيغة حجم المجسم الدوراني"],["=\\pi\\int_{-1}^{1}(x^{4}+6x^{2}+9)\\,dx","بفك مربع المجموع"],["=\\pi\\left.\\left(\\frac{x^{5}}{5}+2x^{3}+9x\\right)\\right|_{-1}^{1}=\\pi\\left(\\frac{56}{5}+\\frac{56}{5}\\right)","بالتكامل والتعويض"],["=\\frac{112\\pi}{5}\\approx 70.37","بالتبسيط"]],"a":"حجم عجلة البكرة <span class=\"tx\" data-t=\"\\frac{112\\pi}{5}\\approx 70.37\"></span> وحدة مكعبة","o":""}],[{"n":"11","s":[["y=0\\Rightarrow 100-\\frac{4}{9}x^{2}=0\\Rightarrow x=\\pm 15","حدود التكامل (من الشكل أيضًا)"],["V=\\pi\\int_{-15}^{15}\\left(100-\\frac{4}{9}x^{2}\\right)dx","صيغة الحجم: <span class=\"tx\" data-t=\"y^{2}=100-\\frac{4}{9}x^{2}\"></span>"],["=\\pi\\left.\\left(100x-\\frac{4}{27}x^{3}\\right)\\right|_{-15}^{15}=\\pi\\left[(1500-500)-(-1500+500)\\right]","بالتكامل والتعويض"],["=2000\\pi\\approx 6283.185","بالتبسيط"]],"a":"حجم الكرة <span class=\"tx\" data-t=\"2000\\pi\\approx 6283.185\\ \\text{cm}^{3}\"></span>","o":""}],[{"n":"12","s":[["kx(4-x)=0\\Rightarrow x=0,\\ x=4","حدود المنطقة (أصفار الاقتران)"],["\\int_{0}^{4}k(4x-x^{2})\\,dx=k\\left.\\left(2x^{2}-\\frac{x^{3}}{3}\\right)\\right|_{0}^{4}=k\\left(32-\\frac{64}{3}\\right)=\\frac{32}{3}k","بالتكامل والتعويض"],["\\frac{32}{3}k=32\\Rightarrow k=3","المساحة <span class=m dir=ltr>32</span>، والمنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> فـ <span class=\"tx\" data-t=\"k&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"k=3\"></span>","o":""}],[{"n":"13","s":[["\\int_{-1}^{0} f(x)\\,dx = -2","المنطقة <span class=\"tx\" data-t=\"R_1\"></span> تحت المحور <span class=\"tx\" data-t=\"x\"></span> فالتكامل سالب مساحتها"],["\\int_{3}^{4} f(x)\\,dx = -3","المنطقة <span class=\"tx\" data-t=\"R_2\"></span> تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{4} f(x)\\,dx = \\int_{0}^{3} f(x)\\,dx + \\int_{3}^{4} f(x)\\,dx","خاصية تجزئة فترة التكامل"],["10 = \\int_{0}^{3} f(x)\\,dx + (-3) \\Rightarrow \\int_{0}^{3} f(x)\\,dx = 13","بالتعويض وإضافة <span class=m dir=ltr>3</span> إلى الطرفين"],["\\int_{-1}^{3} f(x)\\,dx = \\int_{-1}^{0} f(x)\\,dx + \\int_{0}^{3} f(x)\\,dx = -2 + 13","خاصية تجزئة فترة التكامل"],["= 11",""]],"a":"<span class=\"tx\" data-t=\"\\int_{-1}^{3} f(x)\\,dx = 11\"></span>","o":"التبرير: التكامل على منطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span> يساوي سالب مساحتها، ثم نجزّئ الفترات."}],[{"n":"3","s":[["4x - x^2 = 0 \\Rightarrow x(4 - x) = 0","نجد نقاط تقاطع المنحنى مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["x = 0,\\; x = 4","خاصية الضرب الصفري"],["f(2) = 8 - 4 = 4 > 0","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في الفترة <span class=\"tx\" data-t=\"[0, 4]\"></span>، فالمساحة <span class=\"tx\" data-t=\"= \\int_0^4 f(x)\\,dx\"></span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"\\int_{0}^{4}(4x - x^2)\\,dx\"></span>","o":""}],[{"n":"13","s":[["V = \\pi\\int_{a}^{b}(f(x))^2\\,dx","صيغة حجم المجسم الدوراني حول المحور <span class=\"tx\" data-t=\"x\"></span>"],["V = \\pi\\int_{0}^{4}(\\sqrt{x})^2\\,dx = \\pi\\int_{0}^{4} x\\,dx","بالتعويض"],["= \\pi\\left[\\frac{x^2}{2}\\right]_{0}^{4} = \\pi(8 - 0) = 8\\pi","بإيجاد التكامل"]],"a":"<span class=\"tx\" data-t=\"V = 8\\pi \\approx 25.13\"></span> وحدة مكعبة","o":""}],[{"n":"23","s":[["A_1 = \\int_{0}^{a} x^2\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في الفترة <span class=\"tx\" data-t=\"[0, a]\"></span>"],["= \\left[\\frac{x^3}{3}\\right]_{0}^{a} = \\frac{a^3}{3}","بإيجاد التكامل"],["A_{ADOB} = OD \\times DA = a \\times a^2 = a^3","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["A_1 = \\frac{a^3}{3} = \\frac{1}{3}\\,a^3 = \\frac{1}{3}A_{ADOB}","بالمقارنة"]],"a":"مساحة المنطقة <span class=\"tx\" data-t=\"= \\frac{a^3}{3}\"></span> وهي ثلث مساحة المستطيل <span class=\"tx\" data-t=\"ADOB\"></span> التي تساوي <span class=\"tx\" data-t=\"a^3\"></span> (وهو المطلوب)","o":""}],[{"n":"27","s":[["A = \\int_{-2}^{2}(2 + 0.1x^4)\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> دائمًا"],["= \\left[2x + 0.02x^5\\right]_{-2}^{2}","قاعدة تكامل اقتران القوة"],["= (4 + 0.64) - (-4 - 0.64)","بالتعويض بحدّي التكامل"],["= 4.64 + 4.64 = 9.28",""]],"a":"المساحة <span class=\"tx\" data-t=\"= 9.28\"></span> وحدة مربعة","o":""}],[{"n":"1","s":[["\\int_{0}^{1}(x^2 - x)\\,dx = \\left[\\frac{x^3}{3} - \\frac{x^2}{2}\\right]_{0}^{1} = -\\frac{1}{6}","الجزء <span class=\"tx\" data-t=\"[0, 1]\"></span> تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{1}^{2}(x^2 - x)\\,dx = \\left(\\frac{8}{3} - 2\\right) - \\left(-\\frac{1}{6}\\right) = \\frac{5}{6}","الجزء <span class=\"tx\" data-t=\"[1, 2]\"></span> فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["A = \\left|-\\frac{1}{6}\\right| + \\frac{5}{6} = 1","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"= 1\"></span> وحدة مربعة","o":""},{"n":"2","s":[["A = \\int_{4}^{9} x^{-\\frac{1}{2}}\\,dx = \\left[2\\sqrt{x}\\right]_{4}^{9}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["= 2(3) - 2(2) = 2","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"= 2\"></span> وحدة مربعة","o":""}],[{"n":"3","s":[["A = \\int_{-1}^{4}(4 + 3x - x^2)\\,dx = \\left[4x + \\frac{3x^2}{2} - \\frac{x^3}{3}\\right]_{-1}^{4}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> بين جذريه <span class=\"tx\" data-t=\"-1\"></span> و <span class=\"tx\" data-t=\"4\"></span>"],["= \\left(16 + 24 - \\frac{64}{3}\\right) - \\left(-4 + \\frac{3}{2} + \\frac{1}{3}\\right) = \\frac{56}{3} + \\frac{13}{6}","بالتعويض بحدّي التكامل"],["= \\frac{125}{6}","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{125}{6} \\approx 20.83\"></span> وحدة مربعة","o":""},{"n":"4","s":[["\\int_{-1}^{0}(3x^2 + x - 2)\\,dx = \\left[x^3 + \\frac{x^2}{2} - 2x\\right]_{-1}^{0}","المنطقة المظللة بين <span class=\"tx\" data-t=\"x = -1\"></span> و <span class=\"tx\" data-t=\"x = 0\"></span>"],["= 0 - \\left(-1 + \\frac{1}{2} + 2\\right) = -\\frac{3}{2}","بالتعويض بحدّي التكامل"],["A = \\left|-\\frac{3}{2}\\right| = \\frac{3}{2}","المنطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span>"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{3}{2}\"></span> وحدة مربعة","o":""}],[{"n":"5","s":[["A = \\int_{-1}^{1}(1 - x^2)\\,dx = \\left[x - \\frac{x^3}{3}\\right]_{-1}^{1}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> بين جذريه"],["= \\frac{2}{3} - \\left(-\\frac{2}{3}\\right) = \\frac{4}{3}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{4}{3}\"></span> وحدة مربعة","o":""},{"n":"6","s":[["\\int_{0}^{1}(x^2 - 1)\\,dx = \\left[\\frac{x^3}{3} - x\\right]_{0}^{1} = -\\frac{2}{3}","الجزء <span class=\"tx\" data-t=\"[0, 1]\"></span> تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{1}^{2}(x^2 - 1)\\,dx = \\left(\\frac{8}{3} - 2\\right) - \\left(-\\frac{2}{3}\\right) = \\frac{4}{3}","الجزء <span class=\"tx\" data-t=\"[1, 2]\"></span> فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["A = \\frac{2}{3} + \\frac{4}{3} = 2","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"= 2\"></span> وحدة مربعة","o":""}],[{"n":"7","s":[["3x^2 - 3 = 0 \\Rightarrow x = \\pm 1","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{-1}^{1}(3x^2 - 3)\\,dx = \\left[x^3 - 3x\\right]_{-1}^{1} = -2 - 2 = -4","المنحنى تحت المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[-1, 1]\"></span>"],["A = |-4| = 4",""]],"a":"المساحة <span class=\"tx\" data-t=\"= 4\"></span> وحدات مربعة","o":""}],[{"n":"8","s":[["x(x^2 - 5x - 6) = x(x - 6)(x + 1) = 0 \\Rightarrow x = -1, 0, 6","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{-1}^{0} f(x)\\,dx = \\left[\\frac{x^4}{4} - \\frac{5x^3}{3} - 3x^2\\right]_{-1}^{0} = \\frac{13}{12}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[-1, 0]\"></span>"],["\\int_{0}^{6} f(x)\\,dx = 324 - 360 - 108 = -144","المنحنى تحت المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[0, 6]\"></span>"],["A = \\frac{13}{12} + 144 = \\frac{1741}{12}","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{1741}{12} \\approx 145.08\"></span> وحدة مربعة","o":""}],[{"n":"9","s":[["x^2(2 - x) = 0 \\Rightarrow x = 0,\\; x = 2","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{2}(2x^2 - x^3)\\,dx = \\left[\\frac{2x^3}{3} - \\frac{x^4}{4}\\right]_{0}^{2}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[0, 2]\"></span>"],["= \\frac{16}{3} - 4 = \\frac{4}{3}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{4}{3}\"></span> وحدة مربعة","o":""}],[{"n":"10","s":[["4x - x^2 = 0 \\Rightarrow x = 0,\\; x = 4","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{4}(4x - x^2)\\,dx = \\left[2x^2 - \\frac{x^3}{3}\\right]_{0}^{4}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["= 32 - \\frac{64}{3} = \\frac{32}{3}","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{32}{3} \\approx 10.67\"></span> وحدة مربعة","o":""}],[{"n":"11","s":[["A = \\int_{-2}^{3}(x^2 + 1)\\,dx","<span class=\"tx\" data-t=\"x^2 + 1 &gt; 0\"></span> دائمًا فالمنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["= \\left[\\frac{x^3}{3} + x\\right]_{-2}^{3} = 12 - \\left(-\\frac{14}{3}\\right)","بالتعويض بحدّي التكامل"],["= \\frac{50}{3}",""]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{50}{3} \\approx 16.67\"></span> وحدة مربعة","o":""}],[{"n":"12","s":[["x(x - 2)(x - 3) = 0 \\Rightarrow x = 0, 2, 3","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{0}^{2} f(x)\\,dx = \\left[\\frac{x^4}{4} - \\frac{5x^3}{3} + 3x^2\\right]_{0}^{2} = \\frac{8}{3}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[0, 2]\"></span>"],["\\int_{2}^{3} f(x)\\,dx = \\frac{9}{4} - \\frac{8}{3} = -\\frac{5}{12}","المنحنى تحت المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[2, 3]\"></span>"],["A = \\frac{8}{3} + \\frac{5}{12} = \\frac{37}{12}","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"= \\frac{37}{12} \\approx 3.08\"></span> وحدة مربعة","o":""}],[{"n":"13","s":[["P(a, \\sqrt{a}),\\; a > 0","النقطة <span class=\"tx\" data-t=\"P\"></span> على المنحنى"],["A_{OPA} = \\int_{0}^{a} x^{\\frac{1}{2}}\\,dx = \\left[\\frac{2}{3}x^{\\frac{3}{2}}\\right]_{0}^{a} = \\frac{2}{3}a^{\\frac{3}{2}}","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["A_{OAPB} = OA \\times AP = a\\sqrt{a} = a^{\\frac{3}{2}}","مساحة المستطيل"],["A_{OPA} = \\frac{2}{3}a^{\\frac{3}{2}} = \\frac{2}{3}A_{OAPB}","بالمقارنة"]],"a":"مساحة <span class=\"tx\" data-t=\"OPA = \\frac{2}{3}a^{\\frac{3}{2}}\"></span> وهي ثلثا مساحة المستطيل <span class=\"tx\" data-t=\"OAPB\"></span> (وهو المطلوب)","o":""}],[{"n":"14","s":[["V = \\pi\\int_{0}^{3}(x^2 + 5)^2\\,dx = \\pi\\int_{0}^{3}(x^4 + 10x^2 + 25)\\,dx","صيغة حجم المجسم الدوراني؛ الحدود من <span class=\"tx\" data-t=\"x = 0\"></span> (المحور <span class=\"tx\" data-t=\"y\"></span>) إلى <span class=\"tx\" data-t=\"x = 3\"></span>"],["= \\pi\\left[\\frac{x^5}{5} + \\frac{10x^3}{3} + 25x\\right]_{0}^{3}","قاعدة تكامل اقتران القوة"],["= \\pi\\left(\\frac{243}{5} + 90 + 75\\right) = \\frac{1068\\pi}{5}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"V = \\frac{1068\\pi}{5} = 213.6\\pi \\approx 671.04\"></span> وحدة مكعبة","o":""}],[{"n":"15","s":[["V_{\\text{left}} = \\pi\\int_{0}^{a} x\\,dx = \\frac{\\pi a^2}{2}","حجم الجزء الأيسر"],["V_{\\text{right}} = \\pi\\int_{a}^{8} x\\,dx = \\frac{\\pi}{2}(64 - a^2)","حجم الجزء الأيمن"],["\\frac{\\pi a^2}{2} = \\frac{\\pi}{2}(64 - a^2) \\Rightarrow 2a^2 = 64","بمساواة الحجمين"],["a^2 = 32 \\Rightarrow a = \\sqrt{32} = 4\\sqrt{2}","<span class=\"tx\" data-t=\"a &gt; 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"a = 4\\sqrt{2} \\approx 5.66\"></span>","o":""}]]