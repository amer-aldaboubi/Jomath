[[{"n":"1","s":[["n=80,\\ p=\\frac{1}{2}","عدد المحاولات ثابت، ولكل محاولة نتيجتان (كتابة/صورة)"],["X\\sim B\\left(80,\\frac{1}{2}\\right)","المحاولات مستقلة واحتمال النجاح ثابت، ونعدّ مرات النجاح"]],"a":"نعم، تُمثِّل تجربة ذات حدّين: <span class=\"tx\" data-t=\"X\\sim B(80,0.5)\"></span>","o":""},{"n":"2","s":[["n=20,\\ p=\\frac{1}{6}","<span class=m dir=ltr>20</span> محاولة مستقلة، النجاح ظهور <span class=m dir=ltr>4</span> واحتماله ثابت"],["X\\sim B\\left(20,\\frac{1}{6}\\right)","نعدّ مرات ظهور <span class=m dir=ltr>4</span>"]],"a":"نعم، تُمثِّل تجربة ذات حدّين: <span class=\"tx\" data-t=\"X\\sim B\\left(20,\\frac{1}{6}\\right)\"></span>","o":""},{"n":"3","s":[["X=\\text{number of trials until first hit}","عدد المحاولات غير محدَّد مسبقًا؛ نتوقف عند أوّل إصابة"]],"a":"لا، لا تُمثِّل تجربة ذات حدّين (هي تجربة هندسية).","o":""}],[{"n":"4","s":[["X\\sim B(n,p)","الصورة العامة للمتغيّر ذي الحدّين"],["X\\sim B(17,\\ 0.64)","بتعويض <span class=\"tx\" data-t=\"n=17,\\ p=0.64\"></span>"]],"a":"<span class=\"tx\" data-t=\"X\\sim B(17,\\ 0.64)\"></span>","o":""}],[{"n":"5","s":[["P(X=r)=\\binom{n}{r}p^{r}(1-p)^{n-r}","صيغة توزيع ذي الحدّين"],["P(X=2)=\\binom{10}{2}(0.2)^{2}(0.8)^{8}","بتعويض <span class=\"tx\" data-t=\"n=10,\\ r=2,\\ p=0.2\"></span>"],["=45(0.04)(0.16777)\\approx 0.302","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=2)\\approx 0.302\"></span>","o":"","k":[{"e":"0.302","a":true}]},{"n":"6","s":[["P(X=5)=\\binom{10}{5}(0.2)^{5}(0.8)^{5}","صيغة توزيع ذي الحدّين"],["=252(0.00032)(0.32768)\\approx 0.026","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=5)\\approx 0.026\"></span>","o":"","k":[{"e":"0.026","a":true}]},{"n":"7","s":[["P(X<3)=P(0)+P(1)+P(2)","احتمال الحوادث المتنافية"],["=(0.8)^{10}+\\binom{10}{1}(0.2)(0.8)^{9}+\\binom{10}{2}(0.2)^2(0.8)^8","صيغة توزيع ذي الحدّين"],["=0.1074+0.2684+0.3020","باستعمال الآلة الحاسبة"],["\\approx 0.678","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;3)\\approx 0.678\"></span>","o":"","k":[{"e":"0.678","a":true}]},{"n":"8","s":[["P(X\\le 7)=1-\\left[P(8)+P(9)+P(10)\\right]","احتمال المتمّمة"],["=1-\\left[\\binom{10}{8}(0.2)^8(0.8)^2+\\binom{10}{9}(0.2)^9(0.8)+(0.2)^{10}\\right]","صيغة توزيع ذي الحدّين"],["=1-0.0000779=0.9999221","باستعمال الآلة الحاسبة"],["\\approx 1.000","بالتقريب لأقرب <span class=m dir=ltr>3</span> منازل"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 7)\\approx 1.000\"></span> (تقريبًا <span class=\"tx\" data-t=\"0.99992\"></span>)","o":"","k":[{"e":"1.0","a":true},{"e":"0.99992","a":true}]},{"n":"9","s":[["P(X\\ge 2)=1-\\left[P(0)+P(1)\\right]","احتمال المتمّمة"],["=1-\\left[(0.8)^{10}+10(0.2)(0.8)^{9}\\right]","صيغة توزيع ذي الحدّين"],["=1-(0.1074+0.2684)","باستعمال الآلة الحاسبة"],["\\approx 0.624","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 2)\\approx 0.624\"></span>","o":"","k":[{"e":"0.624","a":true}]},{"n":"10","s":[["P(2<X\\le 8)=P(X\\le 8)-P(X\\le 2)","الفرق بين احتمالين تراكميين"],["P(X\\le 8)=1-P(9)-P(10)\\approx 0.9999958","صيغة توزيع ذي الحدّين"],["P(X\\le 2)\\approx 0.67780","من الفرع <span class=m dir=ltr>7</span>"],["P(2<X\\le 8)\\approx 0.322","بالطرح والتقريب"]],"a":"<span class=\"tx\" data-t=\"P(2&lt;X\\le 8)\\approx 0.322\"></span>","o":"","k":[{"e":"0.322","a":true}]}],[{"n":"11","s":[["P(X=1)=\\binom{3}{1}\\left(\\frac{2}{3}\\right)^{1}\\left(\\frac{1}{3}\\right)^{2}","صيغة توزيع ذي الحدّين"],["=3\\times\\frac{2}{3}\\times\\frac{1}{9}=\\frac{2}{9}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=1)=\\frac{2}{9}\\approx 0.2222\"></span>","o":"","k":[{"e":"0.2222","a":true}]},{"n":"12","s":[["P(X>1)=P(X=2)+P(X=3)","احتمال الحوادث المتنافية"],["=\\binom{3}{2}\\left(\\frac{2}{3}\\right)^{2}\\left(\\frac{1}{3}\\right)+\\left(\\frac{2}{3}\\right)^{3}","صيغة توزيع ذي الحدّين"],["=\\frac{12}{27}+\\frac{8}{27}=\\frac{20}{27}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;1)=\\frac{20}{27}\\approx 0.7407\"></span>","o":"","k":[{"e":"0.7407","a":true}]},{"n":"13","s":[["P(0\\le X<2)=P(X=0)+P(X=1)","احتمال الحوادث المتنافية"],["=\\left(\\frac{1}{3}\\right)^{3}+\\frac{2}{9}=\\frac{1}{27}+\\frac{6}{27}","صيغة توزيع ذي الحدّين"],["=\\frac{7}{27}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(0\\le X&lt;2)=\\frac{7}{27}\\approx 0.2593\"></span>","o":"","k":[{"e":"0.2593","a":true}]}],[{"n":"14","s":[["X\\sim B(20,\\ 0.25)","<span class=\"tx\" data-t=\"X\"></span>: عدد مرات مواجهة صعوبة في الرؤية"],["P(X=3)=\\binom{20}{3}(0.25)^{3}(0.75)^{17}","صيغة توزيع ذي الحدّين"],["=1140(0.015625)(0.0075169)\\approx 0.1339","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.1339\"></span>","o":"","k":[{"e":"0.1339","a":true}]},{"n":"15","s":[["P(X\\ge 3)=1-\\left[P(0)+P(1)+P(2)\\right]","احتمال المتمّمة"],["=1-\\left[(0.75)^{20}+20(0.25)(0.75)^{19}+190(0.25)^2(0.75)^{18}\\right]","صيغة توزيع ذي الحدّين"],["=1-(0.0032+0.0211+0.0669)","باستعمال الآلة الحاسبة"],["\\approx 0.9087","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 3)\\approx 0.9087\"></span>","o":"","k":[{"e":"0.9087","a":true}]},{"n":"16","s":[["P(X=20)=\\binom{20}{20}(0.25)^{20}(0.75)^{0}","صيغة توزيع ذي الحدّين"],["=(0.25)^{20}\\approx 9.09\\times 10^{-13}","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=20)=(0.25)^{20}\\approx 9.09\\times10^{-13}\"></span> (احتمال يكاد يكون صفرًا)","o":"","k":[{"e":"9.09e-13","a":true}]},{"n":"17","s":[["E(X)=np","توقّع المتغيّر ذي الحدّين"],["=20\\times 0.25=5","بالتعويض"]],"a":"العدد المتوقَّع <span class=\"tx\" data-t=\"5\"></span> مرات.","o":"","k":[{"e":"5","a":null}]}],[{"n":"18","s":[["E(X)=np=5(0.1)=0.5","توقّع المتغيّر ذي الحدّين"],["Var(X)=np(1-p)=5(0.1)(0.9)=0.45","تباين المتغيّر ذي الحدّين"]],"a":"<span class=\"tx\" data-t=\"E(X)=0.5,\\ Var(X)=0.45\"></span>","o":"","k":[{"e":"0.5","a":true},{"e":"0.45","a":true}]},{"n":"19","s":[["E(X)=np=20\\times\\frac{3}{8}=\\frac{15}{2}=7.5","توقّع المتغيّر ذي الحدّين"],["Var(X)=np(1-p)=20\\times\\frac{3}{8}\\times\\frac{5}{8}=\\frac{75}{16}","تباين المتغيّر ذي الحدّين"],["=4.6875","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"E(X)=7.5,\\ Var(X)=\\frac{75}{16}=4.6875\"></span>","o":"","k":[{"e":"7.5","a":true},{"e":"4.6875","a":true}]}],[{"n":"20","s":[["X\\sim B(50,\\ 0.12)","<span class=\"tx\" data-t=\"n=50,\\ p=0.12\"></span>"],["P(X=3)=\\binom{50}{3}(0.12)^{3}(0.88)^{47}","صيغة توزيع ذي الحدّين"],["=19600(0.001728)(0.0024587)\\approx 0.0833","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.0833\"></span>","o":"","k":[{"e":"0.0833","a":true}]},{"n":"21","s":[["E(X)=np=50\\times 0.12","توقّع المتغيّر ذي الحدّين"],["=6","بالتبسيط"]],"a":"العدد المتوقَّع <span class=\"tx\" data-t=\"6\"></span> أشخاص.","o":"","k":[{"e":"6","a":null}]},{"n":"22","s":[["Var(X)=np(1-p)","تباين المتغيّر ذي الحدّين"],["=50(0.12)(0.88)=5.28","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"Var(X)=5.28\"></span>","o":"","k":[{"e":"5.28","a":true}]}],[{"n":"23","s":[["X\\sim B(400,\\ 0.3)","<span class=\"tx\" data-t=\"X\"></span>: عدد الإناث في العيّنة"],["E(X)=np=400\\times 0.3","توقّع المتغيّر ذي الحدّين"],["=120","بالتبسيط"]],"a":"العدد المتوقَّع للإناث <span class=\"tx\" data-t=\"120\"></span>.","o":"","k":[{"e":"120","a":null}]}],[{"n":"24","s":[["\\frac{Var(X)}{E(X)}=\\frac{np(1-p)}{np}=1-p","بقسمة التباين على التوقّع"],["1-p=\\frac{1.12}{1.4}=0.8\\Rightarrow p=0.2","بالتعويض"],["n=\\frac{E(X)}{p}=\\frac{1.4}{0.2}=7","من <span class=\"tx\" data-t=\"E(X)=np\"></span>"],["P(X\\ge 6)=\\binom{7}{6}(0.2)^{6}(0.8)+(0.2)^{7}","صيغة توزيع ذي الحدّين"],["=0.0003584+0.0000128=0.0003712","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 6)=0.0003712\"></span>","o":""}],[{"n":"25","s":[["P(X\\ge 1)=1-P(X=0)=1-(1-p)^{3}","احتمال المتمّمة"],["1-(1-p)^{3}=\\frac{215}{216}\\Rightarrow (1-p)^{3}=\\frac{1}{216}","بالتعويض"],["1-p=\\frac{1}{6}\\Rightarrow p=\\frac{5}{6}","بأخذ الجذر التكعيبي"],["P(X=2)=\\binom{3}{2}\\left(\\frac{5}{6}\\right)^{2}\\left(\\frac{1}{6}\\right)","صيغة توزيع ذي الحدّين"],["=\\frac{75}{216}=\\frac{25}{72}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=2)=\\frac{25}{72}\\approx 0.3472\"></span>","o":"","k":[{"e":"0.3472","a":true}]}],[{"n":"26","s":[["Var(X)=np(1-p)=100p(1-p)=24","تباين المتغيّر ذي الحدّين"],["p^{2}-p+0.24=0","بالقسمة على <span class=m dir=ltr>100</span> وإعادة الترتيب"],["(p-0.4)(p-0.6)=0","بالتحليل"],["p=0.4\\ \\text{or}\\ p=0.6","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"p=0.4\"></span> أو <span class=\"tx\" data-t=\"p=0.6\"></span>؛ كلتاهما تحقّق <span class=\"tx\" data-t=\"p(1-p)=0.24\"></span> وتقع بين <span class=m dir=ltr>0</span> و <span class=m dir=ltr>1</span>.","o":""}],[{"n":"27","s":[["\\frac{76}{4}=19","عدد الإجابات الصحيحة اللازمة"],["X\\sim B\\left(25,\\frac{1}{4}\\right)","<span class=\"tx\" data-t=\"X\"></span>: عدد الإجابات الصحيحة"],["P(X=19)=\\binom{25}{19}\\left(\\frac{1}{4}\\right)^{19}\\left(\\frac{3}{4}\\right)^{6}","صيغة توزيع ذي الحدّين"],["=177100\\left(\\frac{1}{4}\\right)^{19}\\left(\\frac{3}{4}\\right)^{6}\\approx 1.15\\times 10^{-7}","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=19)\\approx 1.15\\times10^{-7}\"></span> (احتمال ضئيل جدًّا)","o":"","k":[{"e":"1.15e-7","a":true}]}],[{"n":"1","s":[["P(X=x)=\\binom{n}{x}p^{x}(1-p)^{n-x}","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["P(X=3)=\\binom{4}{3}(0.4)^3(0.6)^1","بالتعويض <span class=\"tx\" data-t=\"n=4,\\ p=0.4,\\ x=3\"></span>"],["=4(0.064)(0.6)=0.1536","بالتبسيط"]],"a":"الإجابة <span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"0.1536\"></span>","o":"","k":[{"e":"0.1536","a":true}]}],[{"n":"2","s":[["E(X)=np","توقع توزيع ذي الحدين"],["60=320p","بالتعويض"],["p=\\frac{60}{320}=\\frac{3}{16}","بقسمة الطرفين على <span class=m dir=ltr>320</span>"]],"a":"الإجابة <span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"\\frac{3}{16}\"></span>","o":"","k":[{"e":"3/16","a":null}]}],[{"n":"3","s":[["P(X<2)=P(X=0)+P(X=1)","احتمال الحوادث المتنافية"],["=\\binom{8}{0}(0.1)^0(0.9)^8+\\binom{8}{1}(0.1)^1(0.9)^7","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=0.4305+0.3826=0.8131","بالتبسيط"]],"a":"الإجابة <span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"0.8131\"></span>","o":"","k":[{"e":"0.8131","a":true}]}],[{"n":"4","s":[["np=8,\\quad np(1-p)=\\frac{20}{3}","التوقع والتباين"],["1-p=\\frac{20/3}{8}=\\frac{5}{6}","بقسمة التباين على التوقع"],["p=\\frac{1}{6}",""],["n=\\frac{8}{1/6}=48","بالتعويض في <span class=\"tx\" data-t=\"np=8\"></span>"]],"a":"الإجابة <span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"48\"></span>","o":"","k":[{"e":"48","a":null}]}],[{"n":"11","s":[["P(X=x)=\\binom{6}{x}(0.3)^x(0.7)^{6-x}","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["P(X=2)=\\binom{6}{2}(0.3)^2(0.7)^4","بالتعويض"],["=15(0.09)(0.2401)=0.3241","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=2)\\approx0.3241\"></span>","o":"","k":[{"e":"0.3241","a":true}]},{"n":"12","s":[["P(X>4)=P(X=5)+P(X=6)","احتمال الحوادث المتنافية"],["=\\binom{6}{5}(0.3)^5(0.7)+\\binom{6}{6}(0.3)^6","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=0.010206+0.000729=0.010935","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;4)\\approx0.0109\"></span>","o":"","k":[{"e":"0.0109","a":true}]},{"n":"13","s":[["P(2<X\\le4)=P(X=3)+P(X=4)","احتمال الحوادث المتنافية"],["=\\binom{6}{3}(0.3)^3(0.7)^3+\\binom{6}{4}(0.3)^4(0.7)^2","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=0.18522+0.059535=0.244755","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(2&lt;X\\le4)\\approx0.2448\"></span>","o":"","k":[{"e":"0.2448","a":true}]},{"n":"14","s":[["E(X)=np","توقع توزيع ذي الحدين"],["=6(0.3)=1.8","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"E(X)=1.8\"></span>","o":"","k":[{"e":"1.8","a":true}]}],[{"n":"25","s":[["X\\sim B(100,\\ 0.17)","<span class=\"tx\" data-t=\"X\"></span>: عدد المصابيح التالفة"],["E(X)=np","توقع توزيع ذي الحدين"],["=100(0.17)=17","بالتعويض"]],"a":"العدد المتوقع <span class=\"tx\" data-t=\"17\"></span> مصباحًا تالفًا","o":"","k":[{"e":"17","a":null}]}],[{"n":"32","s":[["X\\sim B(20,\\ 0.3)","<span class=\"tx\" data-t=\"X\"></span>: عدد من يجري مكالمتين فقط"],["P(X=4)=\\binom{20}{4}(0.3)^4(0.7)^{16}","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=4845(0.0081)(0.7)^{16}\\approx0.1304","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=4)\\approx0.1304\"></span>","o":"","k":[{"e":"0.1304","a":true}]},{"n":"33","s":[["P(X\\ge2)=1-\\left(P(X=0)+P(X=1)\\right)","احتمال المتممة"],["=1-\\left((0.7)^{20}+20(0.3)(0.7)^{19}\\right)","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=1-(0.000798+0.006839)","بالتبسيط"],["=1-0.007637\\approx0.9924","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge2)\\approx0.9924\"></span>","o":"","k":[{"e":"0.9924","a":true}]}],[{"n":"1","s":[["P(X=x)=\\binom{20}{x}\\left(\\frac{1}{8}\\right)^x\\left(\\frac{7}{8}\\right)^{20-x}","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["P(X=18)=\\binom{20}{18}\\left(\\frac{1}{8}\\right)^{18}\\left(\\frac{7}{8}\\right)^2","بالتعويض"],["=190\\left(\\frac{1}{8}\\right)^{18}\\left(\\frac{49}{64}\\right)\\approx8.08\\times10^{-15}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=18)\\approx8.08\\times10^{-15}\"></span> (قريب جدًّا من الصفر)","o":"","k":[{"e":"8.08e-15","a":true}]},{"n":"2","s":[["P(X\\le3)=P(0)+P(1)+P(2)+P(3)","احتمال الحوادث المتنافية"],["\\approx0.0692+0.1977+0.2684+0.2300","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["\\approx0.7653","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\le3)\\approx0.7653\"></span>","o":"","k":[{"e":"0.7653","a":true}]},{"n":"3","s":[["P(1<X\\le3)=P(X=2)+P(X=3)","احتمال الحوادث المتنافية"],["\\approx0.2684+0.2300","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["\\approx0.4984","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(1&lt;X\\le3)\\approx0.4984\"></span>","o":"","k":[{"e":"0.4984","a":true}]}],[{"n":"4","s":[["p=\\frac{2}{5}=0.4","الخماسي منتظم مقسوم إلى <span class=m dir=ltr>5</span> مثلثات متطابقة، منها مثلثان للحرف <span class=\"tx\" data-t=\"A\"></span>"],["X\\sim B(10,\\ 0.4)",""],["P(X=3)=\\binom{10}{3}(0.4)^3(0.6)^7","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=120(0.064)(0.0279936)\\approx0.2150","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx0.2150\"></span>","o":"","k":[{"e":"0.215","a":true}]},{"n":"5","s":[["P(X\\ge3)=1-\\left(P(X=0)+P(X=1)+P(X=2)\\right)","احتمال المتممة"],["=1-(0.0060+0.0403+0.1209)","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=1-0.1673\\approx0.8327","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge3)\\approx0.8327\"></span>","o":"","k":[{"e":"0.8327","a":true}]},{"n":"6","s":[["P(X=0)=\\binom{10}{0}(0.4)^0(0.6)^{10}","صيغة التوزيع الاحتمالي لتوزيع ذي الحدين"],["=(0.6)^{10}\\approx0.0060","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(X=0)\\approx0.0060\"></span>","o":"","k":[{"e":"0.006","a":true}]}],[{"n":"7","s":[["X\\sim B(n,\\ 0.04)","<span class=\"tx\" data-t=\"X\"></span>: عدد حاملي الفصيلة <span class=\"tx\" data-t=\"O^-\"></span> في العينة"],["E(X)=np","توقع توزيع ذي الحدين"],["10=n(0.04)","بالتعويض"],["n=\\frac{10}{0.04}=250","بقسمة الطرفين على <span class=m dir=ltr>0.04</span>"]],"a":"يلزم إشراك <span class=\"tx\" data-t=\"250\"></span> شخصًا","o":"","k":[{"e":"250","a":null}]}],[{"n":"8","s":[["E(X)=np=40(0.2)=8","التوقع"],["\\sigma^2=np(1-p)=40(0.2)(0.8)=6.4","التباين"]],"a":"<span class=\"tx\" data-t=\"E(X)=8,\\ \\sigma^2=6.4\"></span>","o":""},{"n":"9","s":[["E(X)=np=280(0.4)=112","التوقع"],["\\sigma^2=np(1-p)=280(0.4)(0.6)=67.2","التباين"]],"a":"<span class=\"tx\" data-t=\"E(X)=112,\\ \\sigma^2=67.2\"></span>","o":""},{"n":"10","s":[["E(X)=np=48\\left(\\frac{1}{6}\\right)=8","التوقع"],["\\sigma^2=np(1-p)=48\\left(\\frac{1}{6}\\right)\\left(\\frac{5}{6}\\right)=\\frac{20}{3}","التباين"]],"a":"<span class=\"tx\" data-t=\"E(X)=8,\\ \\sigma^2=\\frac{20}{3}\\approx6.67\"></span>","o":""}],[{"n":"11","s":[["X\\sim B(12000,\\ 0.09)","<span class=\"tx\" data-t=\"X\"></span>: عدد المصابين في العينة"],["E(X)=np=12000(0.09)","توقع توزيع ذي الحدين"],["=1080","بالتبسيط"]],"a":"العدد المتوقع <span class=\"tx\" data-t=\"1080\"></span> شخصًا","o":"","k":[{"e":"1080","a":null}]}]]