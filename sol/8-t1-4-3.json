lass=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"x = 6\"></span>","o":""},{"n":"2","s":[["\\angle K \\cong \\angle J \\Rightarrow LK = LJ","الضلعان المقابلان لزاويتين متطابقتين"],["5x + 5 = 35","بمساواة الطولين"],["5x = 30","بطرح <span class=m dir=ltr>5</span> من الطرفين"],["x = 6","بقسمة الطرفين على <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"x = 6\"></span>","o":""},{"n":"3","s":[["\\overline{CB} \\cong \\overline{CA} \\Rightarrow \\angle A \\cong \\angle B","زاويتا القاعدة متطابقتان"],["9x = 72","بمساواة القياسين"],["x = 8","بقسمة الطرفين على <span class=m dir=ltr>9</span>"]],"a":"<span class=\"tx\" data-t=\"x = 8\"></span>","o":""}],[{"n":"4","s":[["60^\\circ + 60^\\circ + 60^\\circ = 180^\\circ","الزوايا ذات القوس الواحد متطابقة، فالمثلث اليساري متطابق الأضلاع وكل زاوية فيه <span class=m dir=ltr>60°</span>"],["60^\\circ \\div 2 = 30^\\circ","الأقواس المزدوجة متطابقة، فالقطعة الأفقية تنصّف زاوية الـ <span class=m dir=ltr>60°</span> عند الرأس الداخلي"],["x = 180^\\circ - 30^\\circ = 150^\\circ","زاويتان متجاورتان على مستقيم"],["15^\\circ + 15^\\circ + 150^\\circ = 180^\\circ","تحقق: كل زاوية بقوسين <span class=m dir=ltr>= 15°</span>"]],"a":"<span class=\"tx\" data-t=\"x = 150^\\circ\"></span>","o":"لا يظهر المتغير <span class=\"tx\" data-t=\"y\"></span> في هذا الشكل."},{"n":"5","s":[["AM = MC \\Rightarrow \\angle A = \\angle ACM","المثلث <span class=m dir=ltr>AMC</span> متطابق الضلعين <span class=m dir=ltr>(M</span> على الوتر، <span class=m dir=ltr>C</span> رأس القائمة)"],["\\angle MCB = 90^\\circ - \\angle A = \\angle B","كل منهما يتمم ∠<span class=m dir=ltr>A</span>"],["MB = MC = BC","الضلعان المقابلان لزاويتين متطابقتين، و <span class=m dir=ltr>MC = BC</span> من الشكل"],["x = 60^\\circ","المثلث <span class=m dir=ltr>MBC</span> متطابق الأضلاع"],["y = 180^\\circ - 60^\\circ = 120^\\circ","زاويتان متجاورتان على مستقيم"]],"a":"<span class=\"tx\" data-t=\"x = 60^\\circ,\\ y = 120^\\circ\"></span>","o":"سمّينا الرأس القائم <span class=m dir=ltr>C</span> والرأس العلوي <span class=m dir=ltr>B</span> والرأس الأيسر <span class=m dir=ltr>A</span> ونقطة الوتر <span class=m dir=ltr>M</span>."},{"n":"6","s":[["x = 60^\\circ","الزوايا الثلاث ذات القوس الواحد متطابقة، فالمثلث العلوي متطابق الأضلاع"],["40 = 40 = 40","أضلاع المثلث العلوي كلها <span class=m dir=ltr>40</span>"],["60^\\circ + 30^\\circ = 90^\\circ","المثلث السفلي متطابق الضلعين <span class=m dir=ltr>(40</span> و <span class=m dir=ltr>40)</span> فزاويتا قاعدته <span class=m dir=ltr>30°</span>، إذن المثلث الكبير قائم"],["(8y)^2 = 80^2 - 40^2 = 4800","نظرية فيثاغورس (الوتر <span class=m dir=ltr>40 + 40 = 80)</span>"],["8y = 40\\sqrt{3} \\approx 69.28","بأخذ الجذر التربيعي"],["y = 5\\sqrt{3} \\approx 8.66","بقسمة الطرفين على <span class=m dir=ltr>8</span>"]],"a":"<span class=\"tx\" data-t=\"x = 60^\\circ,\\ y = 5\\sqrt{3} \\approx 8.66\"></span>","o":""}],[{"n":"7","s":[["60^\\circ,\\ 60^\\circ,\\ 60^\\circ","كل زاوية في المثلث الكبير هي زاوية مثلث صغير متطابق الأضلاع"],["60^\\circ = 60^\\circ = 60^\\circ","المثلث المتطابق الزوايا متطابق الأضلاع (وكل ضلع مكوَّن من العدد نفسه من الأضلاع الصغيرة)"]],"a":"المثلث الكبير متطابق الزوايا (كل زاوية <span class=\"tx\" data-t=\"60^\\circ\"></span>)، إذن هو متطابق الأضلاع","o":""},{"n":"8","s":[["1,\\ 4,\\ 9,\\ 16","بعدّ المثلثات الصغيرة: <span class=m dir=ltr>1²</span>، <span class=m dir=ltr>2²</span>، <span class=m dir=ltr>3²</span>، <span class=m dir=ltr>4²</span>"]],"a":"<span class=\"tx\" data-t=\"1, 4, 9, 16\"></span> وحدة مربعة","o":""},{"n":"9","s":[["A_n = n^2","النمط: مساحة المثلث رقم <span class=m dir=ltr>n</span> تساوي <span class=m dir=ltr>n²</span>"],["A_{17} = 17^2 = 289","بالتعويض <span class=m dir=ltr>n = 17</span>"]],"a":"<span class=\"tx\" data-t=\"289\"></span> وحدة مربعة","o":""}],[{"n":"10","s":[["\\angle A \\cong \\angle C \\Rightarrow \\overline{BC} \\cong \\overline{AB}","الضلعان المقابلان لزاويتين متطابقتين متطابقان"],["BC = AB = 5\\ \\text{cm}","بالتعويض"]],"a":"الخطأ: ريما ساوت <span class=\"tx\" data-t=\"\\overline{AC}\"></span> بـ <span class=\"tx\" data-t=\"\\overline{BC}\"></span>، والصحيح <span class=\"tx\" data-t=\"\\overline{AB} \\cong \\overline{BC}\"></span>، إذن <span class=\"tx\" data-t=\"BC = 5\\ \\text{cm}\"></span>","o":"الضلع <span class=\"tx\" data-t=\"\\overline{AC}\"></span> هو القاعدة الواقعة بين الزاويتين المتطابقتين."}],[{"n":"3","s":[["\\overline{AB}\\cong\\overline{AC},\\ \\angle BAD\\cong\\angle CAD,\\ \\overline{AD}\\cong\\overline{AD}","معطى <span class=m dir=ltr>+</span> ضلع مشترك"],["\\triangle ABD \\cong \\triangle ACD","<span class=m dir=ltr>SAS (</span>فالعبارة <span class=m dir=ltr>A</span> صحيحة)"],["\\angle B \\cong \\angle C,\\ BD = CD","أجزاء متناظرة (فالعبارة <span class=m dir=ltr>C</span> صحيحة و <span class=m dir=ltr>D</span> خاطئة)"],["\\angle ADB = \\angle ADC = 90^\\circ","متطابقتان ومتجاورتان على مستقيم (فالعبارة <span class=m dir=ltr>B</span> صحيحة)"]],"a":"<span class=m dir=ltr>D)</span> <span class=\"tx\" data-t=\"BD \\ne CD\"></span> هي العبارة غير الصحيحة","o":""}],[{"n":"4","s":[["OM = ON","نصفا قطر القوس الأول (مركزه <span class=m dir=ltr>O)</span>"],["MN = MO","القوس الثاني مركزه <span class=m dir=ltr>M</span> بنصف القطر نفسه"],["MN = NO = OM","المثلث <span class=m dir=ltr>MNO</span> متطابق الأضلاع"],["m\\angle MNO = 60^\\circ","كل زاوية في المثلث المتطابق الأضلاع <span class=m dir=ltr>60°</span>"]],"a":"<span class=m dir=ltr>C)</span> <span class=\"tx\" data-t=\"60^\\circ\"></span>","o":""}]]