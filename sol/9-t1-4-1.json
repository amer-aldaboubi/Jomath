[[{"n":"1","s":[["A=2,\\ B=10","إحداثيا النقطتين من خط الأعداد"],["AB=|10-2|","المسافة <span class=m dir=ltr>=</span> القيمة المطلقة للفرق بين الإحداثيين"],["=8","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"AB = 8\"></span> وحدات","o":"","k":[{"e":"8","a":null}]},{"n":"2","s":[["C=-3,\\ D=4","إحداثيا النقطتين"],["CD=|4-(-3)|","صيغة المسافة على خط الأعداد"],["=|7|=7","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"CD = 7\"></span> وحدات","o":"","k":[{"e":"7","a":null}]},{"n":"3","s":[["C=-3,\\ B=10","إحداثيا النقطتين"],["CB=|10-(-3)|","صيغة المسافة على خط الأعداد"],["=13","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"CB = 13\"></span> وحدة","o":"","k":[{"e":"13","a":null}]},{"n":"4","s":[["A=2,\\ C=-3","إحداثيا النقطتين"],["AC=|-3-2|","صيغة المسافة على خط الأعداد"],["=|-5|=5","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"AC = 5\"></span> وحدات","o":"","k":[{"e":"5","a":null}]}],[{"n":"5","s":[["CD=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2}","صيغة المسافة في المستوى الإحداثي"],["=\\sqrt{(4-(-1))^2+(8-6)^2}","بالتعويض"],["=\\sqrt{5^2+2^2}=\\sqrt{29}","بالتبسيط"],["\\approx 5.4","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"CD=\\sqrt{29}\\approx 5.4\"></span> وحدة","o":"","k":[{"e":"5.4","a":true}]},{"n":"6","s":[["EF=\\sqrt{(2-6)^2+(0-(-1))^2}","بالتعويض في صيغة المسافة"],["=\\sqrt{(-4)^2+1^2}=\\sqrt{17}","بالتبسيط"],["\\approx 4.1","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"EF=\\sqrt{17}\\approx 4.1\"></span> وحدة","o":"","k":[{"e":"4.1","a":true}]},{"n":"7","s":[["GH=\\sqrt{(0-4)^2+(2-(-5))^2}","بالتعويض في صيغة المسافة"],["=\\sqrt{16+49}=\\sqrt{65}","بالتبسيط"],["\\approx 8.1","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"GH=\\sqrt{65}\\approx 8.1\"></span> وحدة","o":"","k":[{"e":"8.1","a":true}]}],[{"n":"8","s":[["L(1,4),\\ M(4,0),\\ N(2,0),\\ P(-1,-2)","إحداثيات الرؤوس من الشكل"],["LM=\\sqrt{(4-1)^2+(0-4)^2}=\\sqrt{25}=5","صيغة المسافة"],["MN=|4-2|=2","قطعة أفقية"],["NP=\\sqrt{(-1-2)^2+(-2-0)^2}=\\sqrt{13}","صيغة المسافة"],["PL=\\sqrt{(1-(-1))^2+(4-(-2))^2}=\\sqrt{40}=2\\sqrt{10}","صيغة المسافة"],["5+2+\\sqrt{13}+2\\sqrt{10}\\approx 16.9","المحيط <span class=m dir=ltr>=</span> مجموع أطوال الأضلاع"]],"a":"المحيط <span class=\"tx\" data-t=\"=7+\\sqrt{13}+2\\sqrt{10}\\approx 16.9\"></span> وحدة","o":"","k":[{"e":"16.9","a":true}]}],[{"n":"9","s":[["R=-10,\\ S=-2","إحداثيا الطرفين من خط الأعداد"],["M=\\frac{-10+(-2)}{2}","صيغة المنتصف على خط الأعداد"],["=\\frac{-12}{2}=-6","بالتبسيط"]],"a":"إحداثي المنتصف <span class=\"tx\" data-t=\"-6\"></span>","o":"","k":[{"e":"-6","a":null}]},{"n":"10","s":[["U=-3,\\ V=6","إحداثيا الطرفين"],["M=\\frac{-3+6}{2}","صيغة المنتصف"],["=\\frac{3}{2}=1.5","بالتبسيط"]],"a":"إحداثي المنتصف <span class=\"tx\" data-t=\"1.5\"></span>","o":"","k":[{"e":"1.5","a":true}]},{"n":"11","s":[["V=6,\\ S=-2","إحداثيا الطرفين"],["M=\\frac{6+(-2)}{2}","صيغة المنتصف"],["=\\frac{4}{2}=2","بالتبسيط"]],"a":"إحداثي المنتصف <span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]}],[{"n":"12","s":[["F(-2,1),\\ E(0,2),\\ H(2,-2),\\ G(0,-3)","إحداثيات الرؤوس من الشكل"],["FE=\\sqrt{(0-(-2))^2+(2-1)^2}=\\sqrt{5}","الطول: صيغة المسافة"],["EH=\\sqrt{(2-0)^2+(-2-2)^2}=\\sqrt{20}=2\\sqrt{5}","العرض: صيغة المسافة"],["A=\\sqrt{5}\\times 2\\sqrt{5}","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["=2\\times 5=10","بالتبسيط"]],"a":"مساحة المستطيل <span class=\"tx\" data-t=\"=10\"></span> وحدات مربعة","o":""}],[{"n":"13","s":[["PT=TQ","<span class=m dir=ltr>T</span> منتصف <span class=m dir=ltr>PQ (</span>العلامتان متطابقتان)"],["5x+3=7x-9","بالتعويض"],["12=2x \\Rightarrow x=6","بحل المعادلة"],["PT=5(6)+3=33","بالتعويض في <span class=m dir=ltr>PT</span>"]],"a":"<span class=\"tx\" data-t=\"PT=33\"></span>","o":"","k":[{"e":"33","a":null}]},{"n":"14","s":[["PT=TQ","<span class=m dir=ltr>T</span> منتصف <span class=m dir=ltr>PQ</span>"],["7x-24=6x-2","بالتعويض"],["x=22","بطرح <span class=m dir=ltr>6x</span> وإضافة <span class=m dir=ltr>24</span> للطرفين"],["PT=7(22)-24=130","بالتعويض في <span class=m dir=ltr>PT</span>"]],"a":"<span class=\"tx\" data-t=\"PT=130\"></span>","o":"","k":[{"e":"130","a":null}]}],[{"n":"15","s":[["M\\left(\\frac{x_1+x_2}{2},\\frac{y_1+y_2}{2}\\right)","صيغة نقطة المنتصف"],["=\\left(\\frac{7+(-4)}{2},\\frac{3+(-1)}{2}\\right)","بالتعويض"],["=\\left(\\frac{3}{2},1\\right)=(1.5,1)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"M(1.5,\\ 1)\"></span>","o":"","k":[{"p":["1.5","1"]}]},{"n":"16","s":[["M=\\left(\\frac{-4+2}{2},\\frac{-5+9}{2}\\right)","بالتعويض في صيغة المنتصف"],["=(-1,2)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"M(-1,\\ 2)\"></span>","o":"","k":[{"p":["-1","2"]}]},{"n":"17","s":[["M=\\left(\\frac{-6+8}{2},\\frac{10+(-2)}{2}\\right)","بالتعويض في صيغة المنتصف"],["=(1,4)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"M(1,\\ 4)\"></span>","o":"","k":[{"p":["1","4"]}]}],[{"n":"18","s":[["\\frac{-5+x}{2}=-2,\\quad \\frac{4+y}{2}=5","بالتعويض في صيغة المنتصف"],["-5+x=-4,\\quad 4+y=10","بضرب الطرفين في <span class=m dir=ltr>2</span>"],["x=1,\\quad y=6","بحل المعادلتين"]],"a":"<span class=\"tx\" data-t=\"D(1,\\ 6)\"></span>","o":"","k":[{"p":["1","6"]}]},{"n":"19","s":[["\\frac{x+1}{2}=-3,\\quad \\frac{y+7}{2}=1","بالتعويض في صيغة المنتصف"],["x+1=-6,\\quad y+7=2","بضرب الطرفين في <span class=m dir=ltr>2</span>"],["x=-7,\\quad y=-5","بحل المعادلتين"]],"a":"<span class=\"tx\" data-t=\"C(-7,\\ -5)\"></span>","o":"","k":[{"p":["-7","-5"]}]},{"n":"20","s":[["\\frac{x+(-4)}{2}=6,\\quad \\frac{y+2}{2}=-1","بالتعويض في صيغة المنتصف"],["x-4=12,\\quad y+2=-2","بضرب الطرفين في <span class=m dir=ltr>2</span>"],["x=16,\\quad y=-4","بحل المعادلتين"]],"a":"<span class=\"tx\" data-t=\"C(16,\\ -4)\"></span>","o":"","k":[{"p":["16","-4"]}]}],[{"n":"21","s":[["A(0,1),\\ B(4,4),\\ C(7,0)","إحداثيات الرؤوس من الشكل"],["AB=\\sqrt{(4-0)^2+(4-1)^2}=\\sqrt{25}=5","صيغة المسافة"],["BC=\\sqrt{(7-4)^2+(0-4)^2}=\\sqrt{25}=5","صيغة المسافة"],["AC=\\sqrt{(7-0)^2+(0-1)^2}=\\sqrt{50}=5\\sqrt{2}","صيغة المسافة"],["AB=BC\\ne AC","ضلعان متطابقان"]],"a":"المثلث <span class=\"tx\" data-t=\"ABC\"></span> متطابق الضلعين","o":""},{"n":"22","s":[["P=AB+BC+AC","المحيط <span class=m dir=ltr>=</span> مجموع أطوال الأضلاع"],["=5+5+5\\sqrt{2}","بالتعويض من السؤال <span class=m dir=ltr>21</span>"],["=10+5\\sqrt{2}\\approx 17.1","بالتبسيط"]],"a":"المحيط <span class=\"tx\" data-t=\"=10+5\\sqrt{2}\\approx 17.1\"></span> وحدة","o":"","k":[{"e":"17.1","a":true}]}],[{"n":"23","s":[["S(3,2),\\ J(1,-1),\\ R(-4,-2)","صويلح <span class=m dir=ltr>S</span>، الجامعة الأردنية <span class=m dir=ltr>J</span>، الرابية <span class=m dir=ltr>R</span>"],["SJ=\\sqrt{(1-3)^2+(-1-2)^2}=\\sqrt{4+9}=\\sqrt{13}","صيغة المسافة"],["\\sqrt{13}\\approx 3.6","باستعمال الآلة الحاسبة"],["RJ=\\sqrt{(1-(-4))^2+(-1-(-2))^2}=\\sqrt{25+1}=\\sqrt{26}","صيغة المسافة"],["\\sqrt{26}\\approx 5.1","باستعمال الآلة الحاسبة"]],"a":"المسافة بين صويلح والجامعة الأردنية <span class=\"tx\" data-t=\"\\approx 3.6\\ \\text{km}\"></span>، وبين الرابية والجامعة الأردنية <span class=\"tx\" data-t=\"\\approx 5.1\\ \\text{km}\"></span>","o":""}],[{"n":"24","s":[["(0,0),\\ (20,30)","موقع آلة التصوير وموقع طائر النورس تقريبًا من الشكل"],["d=\\sqrt{(20-0)^2+(30-0)^2}","صيغة المسافة"],["=\\sqrt{400+900}=\\sqrt{1300}","بالتبسيط"],["\\approx 36.1","باستعمال الآلة الحاسبة"],["36.1<50","المقارنة مع <span class=m dir=ltr>50 m</span>"]],"a":"نعم، تلتقط الآلة صورة عالية الدقة؛ لأن بعد الطائر عنها <span class=\"tx\" data-t=\"\\approx 36.1\\ \\text{m}\"></span> وهو أقل من <span class=\"tx\" data-t=\"50\\ \\text{m}\"></span>","o":"مسألة اليوم (ص <span class=m dir=ltr>132)</span>: آلة التصوير عند نقطة الأصل والطائر عند النقطة <span class=\"tx\" data-t=\"(20, 30)\"></span> تقريبًا كما يظهر في الشكل."}],[{"n":"25","s":[["AB=\\sqrt{(2-1)^2+(6-(-4))^2}","خطأ عماد: خلط بين الإحداثيات؛ طرح الإحداثي <span class=m dir=ltr>x</span> للنقطة <span class=m dir=ltr>B</span> من الإحداثي <span class=m dir=ltr>y</span> للنقطة <span class=m dir=ltr>A</span>"],["AB=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2}","الصواب: نطرح <span class=m dir=ltr>x</span> من <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span> من <span class=m dir=ltr>y</span>"],["=\\sqrt{(1-6)^2+(-4-2)^2}","بتعويض <span class=m dir=ltr>A(6,2), B(1,-4)</span>"],["=\\sqrt{25+36}=\\sqrt{61}","بالتبسيط"],["\\approx 7.8","باستعمال الآلة الحاسبة"]],"a":"الخطأ: عوّض عماد <span class=\"tx\" data-t=\"2\"></span> و <span class=\"tx\" data-t=\"6\"></span> (الإحداثيين <span class=m dir=ltr>y</span> و <span class=m dir=ltr>x</span> للنقطة <span class=m dir=ltr>A)</span> في غير موضعهما. الصحيح: <span class=\"tx\" data-t=\"AB=\\sqrt{61}\\approx 7.8\"></span>","o":""}],[{"n":"26","s":[["AP=3PD \\Rightarrow AD=4PD","<span class=m dir=ltr>P</span> تقسم <span class=m dir=ltr>AD</span> إلى <span class=m dir=ltr>4</span> أجزاء متساوية، <span class=m dir=ltr>3</span> منها من جهة <span class=m dir=ltr>A</span>"],["M=\\left(\\frac{1+7}{2},\\frac{4+13}{2}\\right)=(4,8.5)","<span class=m dir=ltr>M</span> منتصف <span class=m dir=ltr>AD (</span>تبعد جزأين عن كلٍّ من الطرفين)"],["P=\\left(\\frac{4+7}{2},\\frac{8.5+13}{2}\\right)","<span class=m dir=ltr>P</span> منتصف <span class=m dir=ltr>MD (</span>تبعد جزءًا واحدًا عن <span class=m dir=ltr>D)</span>"],["P=(5.5,\\ 10.75)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(5.5,\\ 10.75)\"></span>","o":"التبرير: بما أن <span class=\"tx\" data-t=\"AP = 3PD\"></span> فإن <span class=\"tx\" data-t=\"PD=\\frac{1}{4}AD\"></span>، لذا <span class=m dir=ltr>P</span> هي منتصف القطعة الواصلة بين منتصف <span class=\"tx\" data-t=\"\\overline{AD}\"></span> والنقطة <span class=m dir=ltr>D</span>.","k":[{"p":["5.5","10.75"]}]}],[{"n":"27","s":[["P(10,50),\\ Q(10,10),\\ R(80,10)","إحداثيات الرؤوس من الشكل"],["PQ=50-10=40,\\quad QR=80-10=70","قطعتان رأسية وأفقية"],["RP=\\sqrt{(10-80)^2+(50-10)^2}=\\sqrt{6500}\\approx 80.6","صيغة المسافة"],["40+70+80.6=190.6","طول الممر الكلي (المحيط) بالأمتار"],["\\frac{190.6}{130}\\approx 1.5","الزمن <span class=m dir=ltr>=</span> الم