10","s":[["AB=\\sqrt{8^2+2^2}=\\sqrt{68},\\ BC=\\sqrt{2^2+4^2}=\\sqrt{20},\\ AC=\\sqrt{6^2+2^2}=\\sqrt{40}","صيغة المسافة"],["\\frac{1}{2}AB=\\sqrt{17}\\approx 4.12","القطعة المنصفة الموازية لـ <span class=\"tx\" data-t=\"\\overline{AB}\"></span>"],["\\frac{1}{2}BC=\\sqrt{5}\\approx 2.24","القطعة المنصفة الموازية لـ <span class=\"tx\" data-t=\"\\overline{BC}\"></span>"],["\\frac{1}{2}AC=\\sqrt{10}\\approx 3.16","القطعة المنصفة الموازية لـ <span class=\"tx\" data-t=\"\\overline{AC}\"></span>"]],"a":"أطوال القطع المنصفة: <span class=\"tx\" data-t=\"\\sqrt{17}\\approx4.12,\\ \\sqrt5\\approx2.24,\\ \\sqrt{10}\\approx3.16\"></span>","o":"المنتصفات: <span class=\"tx\" data-t=\"(-1,7)\"></span> لـ <span class=m dir=ltr>AB</span>، <span class=\"tx\" data-t=\"(2,6)\"></span> لـ <span class=m dir=ltr>BC</span>، <span class=\"tx\" data-t=\"(-2,5)\"></span> لـ <span class=m dir=ltr>AC</span>، ويمكن التحقق بصيغة المسافة بينها."}]]