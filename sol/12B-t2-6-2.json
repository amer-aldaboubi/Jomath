[[{"n":"1","s":[["\\mu_{\\overline{x}} = 60,\\quad \\sigma_{\\overline{x}} = \\frac{5}{\\sqrt{40}} \\approx 0.7906","الوسط الحسابي والخطأ المعياري لتوزيع الأوساط"],["P(\\overline{X} < 62) = P\\left(Z < \\frac{62-60}{0.7906}\\right)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span> للوسط الحسابي للعيّنة"],["= P(Z < 2.53)","بالتبسيط"],["= 0.9943","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{X} &lt; 62) \\approx 0.9943\"></span>","o":""}],[{"n":"2","s":[["\\mu_{\\overline{x}} = 8.2,\\quad \\sigma_{\\overline{x}} = \\frac{0.3}{\\sqrt{25}} = 0.06","المجتمع طبيعي، فتوزيع الأوساط طبيعي"],["P(8 < \\overline{X} < 8.3) = P\\left(\\frac{8-8.2}{0.06} < Z < \\frac{8.3-8.2}{0.06}\\right)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= P(-3.33 < Z < 1.67)","بالتبسيط"],["= P(Z < 1.67) - \\left(1 - P(Z < 3.33)\\right)","باستعمال الخصائص"],["= 0.9525 - 1 + 0.9996 = 0.9521","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(8 &lt; \\overline{X} &lt; 8.3) \\approx 0.9521\"></span>","o":""}],[{"n":"3","s":[["\\mu_{\\overline{x}} = 4.5,\\quad \\sigma_{\\overline{x}} = \\frac{2}{\\sqrt{75}} \\approx 0.2309","الوسط الحسابي والخطأ المعياري"],["P(\\overline{X} < 4) = P\\left(Z < \\frac{4-4.5}{0.2309}\\right) = P(Z < -2.17)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= 1 - P(Z < 2.17)","باستعمال الخصائص"],["= 1 - 0.9850 = 0.0150","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{X} &lt; 4) \\approx 0.0150\"></span>","o":""},{"n":"4","s":[["\\mu_{\\overline{x}} = 4.5,\\quad \\sigma_{\\overline{x}} = \\frac{2}{\\sqrt{80}} \\approx 0.2236","الوسط الحسابي والخطأ المعياري"],["P(4.4 < \\overline{X} < 4.8) = P\\left(\\frac{4.4-4.5}{0.2236} < Z < \\frac{4.8-4.5}{0.2236}\\right)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= P(-0.45 < Z < 1.34)","بالتبسيط"],["= P(Z < 1.34) - \\left(1 - P(Z < 0.45)\\right)","باستعمال الخصائص"],["= 0.9099 - 1 + 0.6736 = 0.5835","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(4.4 &lt; \\overline{X} &lt; 4.8) \\approx 0.5835\"></span>","o":"إذا قُرِّب الخطأ المعياري إلى <span class=m dir=ltr>0.22</span> تصبح <span class=\"tx\" data-t=\"z \\approx 1.36\"></span> والاحتمال <span class=\"tx\" data-t=\"\\approx 0.5867\"></span> (الفرق بسبب التقريب)."}],[{"n":"5","s":[["n = 80 \\ge 30","نظرية النهاية المركزية: توزيع الأوساط قريب من الطبيعي"],["\\mu_{\\overline{x}} = 80,\\quad \\sigma_{\\overline{x}} = \\frac{20}{\\sqrt{80}} \\approx 2.2361","الوسط الحسابي والخطأ المعياري"],["P(\\overline{X} > 83) = P\\left(Z > \\frac{83-80}{2.2361}\\right) = P(Z > 1.34)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= 1 - P(Z < 1.34) = 1 - 0.9099","باستعمال الخصائص والجدول"],["= 0.0901","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{X} &gt; 83) \\approx 0.0901\"></span>","o":""}],[{"n":"6","s":[["n = 120 \\ge 30","نظرية النهاية المركزية"],["\\mu_{\\overline{x}} = 52,\\quad \\sigma_{\\overline{x}} = \\frac{4}{\\sqrt{120}} \\approx 0.3651","الوسط الحسابي والخطأ المعياري"],["P(\\overline{X} < 51) = P\\left(Z < \\frac{51-52}{0.3651}\\right) = P(Z < -2.74)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= 1 - P(Z < 2.74) = 1 - 0.9969","باستعمال الخصائص والجدول"],["= 0.0031","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{X} &lt; 51) \\approx 0.0031\"></span>","o":""}],[{"n":"7","s":[["X \\sim B(15,\\ 0.34)","<span class=\"tx\" data-t=\"n = 15,\\ p = 0.34\"></span>"],["np = 15 \\times 0.34 = 5.1 \\ge 5","الشرط الأول متحقق"],["n(1-p) = 15 \\times 0.66 = 9.9 \\ge 5","الشرط الثاني متحقق"],["\\mu = np = 5.1","الوسط الحسابي"],["\\sigma = \\sqrt{np(1-p)} = \\sqrt{15(0.34)(0.66)} = \\sqrt{3.366} \\approx 1.83","الانحراف المعياري"]],"a":"نعم، يمكن استعمال التوزيع الطبيعي للتقريب؛ <span class=\"tx\" data-t=\"\\mu = 5.1\"></span>، <span class=\"tx\" data-t=\"\\sigma \\approx 1.83\"></span>","o":""},{"n":"8","s":[["X \\sim B(12,\\ 0.4)","<span class=\"tx\" data-t=\"n = 12,\\ p = 0.4\"></span>"],["np = 12 \\times 0.4 = 4.8 < 5","الشرط غير متحقق"]],"a":"لا يمكن استعمال التوزيع الطبيعي للتقريب؛ لأن <span class=\"tx\" data-t=\"np = 4.8 &lt; 5\"></span> (مع أن <span class=\"tx\" data-t=\"n(1-p) = 7.2 \\ge 5\"></span>).","o":""}],[{"n":"9","s":[["X \\sim B(200,\\ 0.1):\\ np = 20 \\ge 5,\\ n(1-p) = 180 \\ge 5","شروط التقريب متحققة"],["\\mu = np = 20,\\quad \\sigma = \\sqrt{200(0.1)(0.9)} = \\sqrt{18} \\approx 4.24","الوسط الحسابي والانحراف المعياري"],["P(X \\le 25) \\approx P(Y < 25.5)","عامل تصحيح الاستمرارية"],["= P\\left(Z < \\frac{25.5-20}{4.24}\\right) = P(Z < 1.30)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= 0.9032","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(X \\le 25) \\approx 0.9032\"></span>","o":"","k":[{"e":"0.9032","a":true}]}],[{"n":"10","s":[["\\sigma_{\\overline{x}} = \\frac{\\sigma}{\\sqrt{10}}","المجتمع طبيعي، <span class=\"tx\" data-t=\"n = 10\"></span>"],["P(\\overline{X} > 42) = 0.1 \\Rightarrow P\\left(Z < \\frac{42-40}{\\sigma_{\\overline{x}}}\\right) = 0.9","باستعمال الخصائص"],["\\frac{2}{\\sigma/\\sqrt{10}} = 1.28","من الجدول: <span class=\"tx\" data-t=\"P(Z &lt; 1.28) \\approx 0.9\"></span>"],["\\sigma = \\frac{2\\sqrt{10}}{1.28}","بحل المعادلة"],["\\approx 4.94","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\sigma \\approx 4.94\"></span>","o":""}],[{"n":"11","s":[["\\sigma_{\\overline{x}} = \\frac{6}{\\sqrt{20}} \\approx 1.342","الخطأ المعياري"],["P(\\overline{X} > 30) = 0.25 \\Rightarrow P\\left(Z < \\frac{30-\\mu}{1.342}\\right) = 0.75","باستعمال الخصائص"],["\\frac{30-\\mu}{1.342} = 0.67","من الجدول: <span class=\"tx\" data-t=\"P(Z &lt; 0.67) \\approx 0.75\"></span>"],["30 - \\mu = 0.67 \\times 1.342 \\approx 0.90","بضرب الطرفين في <span class=m dir=ltr>1.342</span>"],["\\mu \\approx 29.1","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\mu \\approx 29.1\\text{ L}\"></span>","o":""}],[{"n":"12","s":[["X \\sim B(n,\\ 0.07)","<span class=\"tx\" data-t=\"X\"></span>: عدد مَن يستعملون اليد اليسرى في العيّنة"],["np = 2","العدد المتوقَّع (الوسط الحسابي)"],["\\sigma = \\sqrt{np(1-p)} = \\sqrt{2 \\times 0.93}","بالتعويض"],["= \\sqrt{1.86} \\approx 1.36","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\sigma \\approx 1.36\"></span>","o":""}],[{"n":"13","s":[["n = 36 \\ge 30:\\ \\mu_{\\overline{x}} = 74.5,\\ \\sigma_{\\overline{x}} = \\frac{6}{\\sqrt{36}} = 1","نظرية النهاية المركزية"],["P(|\\overline{X} - 74.5| \\le 1) = P(73.5 \\le \\overline{X} \\le 75.5)","البُعد لا يزيد على علامة واحدة"],["= P\\left(\\frac{73.5-74.5}{1} \\le Z \\le \\frac{75.5-74.5}{1}\\right) = P(-1 \\le Z \\le 1)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= 2P(Z < 1) - 1 = 2(0.8413) - 1","باستعمال الخصائص والجدول"],["= 0.6826","بالتبسيط"]],"a":"الاحتمال <span class=\"tx\" data-t=\"\\approx 0.6826\"></span>؛ لأن البُعد لا يزيد على علامة واحدة يعني أن <span class=\"tx\" data-t=\"\\overline{X}\"></span> يقع بين <span class=\"tx\" data-t=\"73.5\"></span> و <span class=\"tx\" data-t=\"75.5\"></span>، وهذا يقابل <span class=\"tx\" data-t=\"-1 \\le Z \\le 1\"></span> لأن الخطأ المعياري يساوي <span class=m dir=ltr>1</span>.","o":""}],[{"n":"14","s":[["n = 100 \\ge 30:\\ \\sigma_{\\overline{x}} = \\frac{8.2}{\\sqrt{100}} = 0.82","نظرية النهاية المركزية"],["P(|\\overline{X} - \\mu| < 0.2) = P\\left(-\\frac{0.2}{0.82} < Z < \\frac{0.2}{0.82}\\right)","صيغة قيمة <span class=\"tx\" data-t=\"z\"></span>"],["= P(-0.24 < Z < 0.24)","بالتبسيط"],["= 2P(Z < 0.24) - 1 = 2(0.5948) - 1","باستعمال الخصائص والجدول"],["= 0.1896","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(|\\overline{X} - \\mu| &lt; 0.2) \\approx 0.1896\"></span>","o":""}],[{"n":"4","s":[["np \\ge 5,\\quad n(1-p) \\ge 5","شرطا تقريب ذي الحدين باستعمال التوزيع الطبيعي"],["a)\\ 60(0.11) = 6.6 \\ge 5,\\quad 60(0.89) = 53.4 \\ge 5","الشرطان متحققان"],["b)\\ 45(0.1) = 4.5,\\quad c)\\ 30(0.15) = 4.5,\\quad d)\\ 40(0.12) = 4.8","جميعها أقل من <span class=m dir=ltr>5</span> فلا يتحقق الشرط"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"X \\sim B(60, 0.11)\"></span>","o":""}],[{"n":"5","s":[["\\sigma_{\\bar{x}} = \\frac{10}{\\sqrt{25}} = 2","الخطأ المعياري للوسط الحسابي"],["P(995 < \\bar{X} < 1005) = P\\left(\\frac{995-1000}{2} < Z < \\frac{1005-1000}{2}\\right)","صيغة قيمة <span class=m dir=ltr>z</span> للوسط الحسابي للعيّنة"],["= P(-2.5 < Z < 2.5) = 2P(Z < 2.5) - 1","بالتبسيط واستعمال خاصية التماثل"],["= 2(0.9938) - 1 = 0.9876","باستعمال الجدول"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"0.9876\"></span>","o":"","k":[{"e":"0.9876","a":true}]}],[{"n":"7","s":[["\\bar{X} \\sim N\\left(55, \\frac{\\sigma^2}{16}\\right),\\quad \\sigma_{\\bar{x}} = \\frac{\\sigma}{4}","توزيع الأوساط الحسابية للعيّنات"],["P(\\bar{X} > 57) = 0.05 \\Rightarrow P(Z < z) = 0.95 \\Rightarrow z = 1.64","باستعمال جدول التوزيع الطبيعي"],["\\frac{57-55}{\\frac{\\sigma}{4}} = 1.64 \\Rightarrow \\frac{8}{\\sigma} = 1.64","صيغة قيمة <span class=m dir=ltr>z</span>"],["\\sigma = \\frac{8}{1.64} \\approx 4.88 \\approx 5.0","بحل المعادلة"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"5.0\"></span>","o":"","k":[{"e":"5.0","a":true}]}],[{"n":"15","s":[["\\mu_{\\bar{x}} = 90,\\quad \\sigma_{\\bar{x}} = \\frac{12}{\\sqrt{36}} = 2","الوسط الحسابي والخطأ المعياري"],["P(\\bar{X} > 95) = P\\left(Z > \\frac{95-90}{2}\\right) = P(Z > 2.5)","صيغة قيمة <span class=m dir=ltr>z</span> للوسط الحسابي للعيّنة"],["= 1 - P(Z < 2.5) = 1 - 0.9938","باستعمال الخصائص والجدول"],["= 0.0062","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(\\bar{X} &gt; 95) = 0.0062\"></span>","o":""}],[{"n":"16","s":[["X \\sim B(108, 0.88):\\ np = 95.04 \\ge 5,\\quad n(1-p) = 12.96 \\ge 5","شرطا التقريب متحققان"],["\\mu = np = 95.04,\\quad \\sigma = \\sqrt{np(1-p)} = \\sqrt{11.4048} \\approx 3.377","الوسط الحسابي والانحراف المعياري"],["P(X \\ge 100) \\approx P(Y > 99.5)","باستعمال عامل تصحيح الاستمرارية"],["= P\\left(Z > \\frac{99.5 - 95.04}{3.377}\\right) = P(Z > 1.32)","بإيجاد قيمة <span class=m dir=ltr>z</span>"],["= 1 - 0.9066 = 0.0934","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(X \\ge 100) \\approx 0.0934\"></span>","o":"","k":[{"e":"0.0934","a":true}]}],[{"n":"1","s":[["\\sigma_{\\bar{x}} = \\frac{6.3}{\\sqrt{20}} \\approx 1.409","المجتمع طبيعي فلا نحتاج إلى شرط <span class=\"tx\" data-t=\"n \\ge 30\"></span>"],["P(147 < \\bar{X} < 153) = P\\left(\\frac{147-151.2}{1.409} < Z < \\frac{153-151.2}{1.409}\\right)","صيغة قيمة <span class=m dir=ltr>z</span> للوسط الحسابي للعيّنة"],["= P(-2.98 < Z < 1.28) = P(Z < 1.28) - P(Z < -2.98)","بالتبسيط"],["= 0.8997 - (1 - 0.9986) = 0.8997 - 0.0014","باستعمال الجدول"],["= 0.8983","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(147 &lt; \\bar{X} &lt; 153) \\approx 0.8983\"></span>","o":""}],[{"n":"2","s":[["X \\sim B(200, 0.95):\\ np = 190 \\ge 5,\\quad n(1-p) = 10 \\ge 5","شرطا التقريب متحققان"],["\\mu = 190,\\quad \\sigma = \\sqrt{200(0.95)(0.05)} = \\sqrt{9.5} \\approx 3.082","الوسط الحسابي والانحراف المعياري"],["P(X = 194) \\approx P(193.5 < Y < 194.5)","باستعمال عامل تصحيح الاستمرارية"],["= P\\left(\\frac{193.5-190}{3.082} < Z < \\frac{194.5-190}{3.082}\\right) = P(1.14 < Z < 1.46)","بإيجاد قيم <span class=m dir=ltr>z</span>"],["= 0.9279 - 0.8729 = 0.0550","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(X = 194) \\approx 0.0550\"></span>","o":"","k":[{"e":"0.055","a":true}]}],[{"n":"3","s":[["0.1n \\ge 5 \\Rightarrow n \\ge 50,\\quad 0.9n \\ge 5 \\Rightarrow n \\ge 5.6","شرطا التقريب <span class=\"tx\" data-t=\"np \\ge 5,\\ n(1-p) \\ge 5\"></span>"],["n \\ge 50","نأخذ الشرط الأكبر"]],"a":"الحدّ الأدنى: <span class=\"tx\" data-t=\"n = 50\"></span>","o":"","k":[{"e":"50","a":null}]},{"n":"4","s":[["0.4n \\ge 5 \\Rightarrow n \\ge 12.5,\\quad 0.6n \\ge 5 \\Rightarrow n \\ge 8.3","شرطا التقريب"],["n \\ge 12.5 \\Rightarrow n = 13","<span class=m dir=ltr>n</span> عدد صحيح فنقرّب إلى الأكبر"]],"a":"الحدّ الأدنى: <span class=\"tx\" data-t=\"n = 13\"></span>","o":"","k":[{"e":"13","a":null}]},{"n":"5","s":[["0.5n \\ge 5 \\Rightarrow n \\ge 10","الشرطان متطابقان لأن <span class=\"tx\" data-t=\"p = 1-p = 0.5\"></span>"]],"a":"الحدّ الأدنى: <span class=\"tx\" data-t=\"n = 10\"></span>","o":"","k":[{"e":"10","a":null}]},{"n":"6","s":[["0.8n \\ge 5 \\Rightarrow n \\ge 6.25,\\quad 0.2n \\ge 5 \\Rightarrow n \\ge 25","شرطا التقريب"],["n \\ge 25","نأخذ الشرط الأكبر"]],"a":"الحدّ الأدنى: <span class=\"tx\" data-t=\"n = 25\"></span>","o":"","k":[{"e":"25","a":null}]}],[{"n":"7","s":[["\\mu = 200(0.32) = 64,\\quad \\sigma = \\sqrt{200(0.32)(0.68)} = \\sqrt{43.52} \\approx 6.597","<span class=\"tx\" data-t=\"np = 64 \\ge 5,\\ n(1-p) = 136 \\ge 5\"></span>"],["P(X < 87) \\approx P(Y < 86.5) = P\\left(Z < \\frac{86.5-64}{6.597}\\right)","عامل تصحيح الاستمرارية"],["= P(Z < 3.41) = 0.9997","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(X &lt; 87) \\approx 0.9997\"></span>","o":"","k":[{"e":"0.9997","a":true}]},{"n":"8","s":[["P(X > 50) \\approx P(Y > 50.5) = P\\left(Z > \\frac{50.5-64}{6.597}\\right)","عامل تصحيح الاستمرارية"],["= P(Z > -2.05) = P(Z < 2.05) = 0.9798","خاصية التماثل والجدول"]],"a":"<span class=\"tx\" data-t=\"P(X &gt; 50) \\approx 0.9798\"></span>","o":"","k":[{"e":"0.9798","a":true}]},{"n":"9","s":[["P(X > 75) \\approx P(Y > 75.5) = P\\left(Z > \\frac{75.5-64}{6.597}\\right)","عامل تصحيح الاستمرارية"],["= P(Z > 1.74) = 1 - 0.9591 = 0.0409","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"P(X &gt; 75) \\approx 0.0409\"></span>","o":"","k":[{"e":"0.0409","a":true}]},{"n":"10","s":[["P(75 < X < 87) \\approx P(75.5 < Y < 86.5)","عامل تصحيح الاستمرارية"],["= P(1.74 < Z < 3.41) = 0.9997 - 0.9591","من نتائج السؤالين <span class=m dir=ltr>7</span> و <span class=m dir=ltr>9</span>"],["= 0.0406","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(75 &lt; X &lt; 87) \\approx 0.0406\"></span>","o":"","k":[{"e":"0.0406","a":true}]}],[{"n":"11","s":[["\\sigma_{\\bar{x}} = \\frac{\\sigma}{\\sqrt{50}}","الخطأ المعياري للوسط الحسابي"],["P(\\bar{X} < 350) = 0.33 \\Rightarrow P(Z < z) = 0.33","الاحتمال أقل من <span class=m dir=ltr>0.5</span> فقيمة <span class=m dir=ltr>z</span> سالبة"],["P(Z < -z) = 0.67 \\Rightarrow z = -0.44","باستعمال الجدول وخاصية التماثل"],["\\frac{350-352}{\\frac{\\sigma}{\\sqrt{50}}} = -0.44 \\Rightarrow \\frac{2\\sqrt{50}}{\\sigma} = 0.44","صيغة قيمة <span class=m dir=ltr>z</span>"],["\\sigma = \\frac{2\\sqrt{50}}{0.44} \\approx 32.14","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\sigma \\approx 32.14\"></span> <span class=m dir=ltr>g</span>","o":""}],[{"n":"12","s":[["\\sigma_{\\bar{x}} = \\frac{8}{\\sqrt{64}} = 1","الخطأ المعياري (<span class=\"tx\" data-t=\"n \\ge 30\"></span>)"],["P(|\\bar{X} - 60| \\le 2) = P(58 \\le \\bar{X} \\le 62)","البعد لا يزيد على دقيقتين"],["= P\\left(\\frac{58-60}{1} \\le Z \\le \\frac{62-60}{1}\\right) = P(-2 \\le Z \\le 2)","صيغة قيمة <span class=m dir=ltr>z</span>"],["= 2P(Z < 2) - 1 = 2(0.9772) - 1 = 0.9544","خاصية التماثل والجدول"]],"a":"الاحتمال <span class=\"tx\" data-t=\"= 0.9544\"></span>","o":""}]]