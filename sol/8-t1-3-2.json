داثي <span class=m dir=ltr>y</span> للنقطة الأولى من الإحداثي <span class=m dir=ltr>y</span> للنقطة الثانية، وأطرح الإحداثيين <span class=m dir=ltr>x</span> بالترتيب نفسه، ثم أقسم فرق <span class=m dir=ltr>y</span> على فرق <span class=m dir=ltr>x</span>. إذا كان فرق <span class=m dir=ltr>x</span> صفرًا فالميل غير معرف","o":""}],[{"n":"1","s":[["m=\\frac{-10-(-4)}{5-5}=\\frac{-6}{0}","صيغة الميل"]],"a":"<span class=m dir=ltr>d)</span> غير معرّف؛ لأن للنقطتين الإحداثي <span class=\"tx\" data-t=\"x\"></span> نفسه فالمستقيم رأسي","o":""}],[{"n":"2","s":[["y=2x","المستقيم يمر بنقطة الأصل وميله <span class=m dir=ltr>2</span>"],["2(2)=4","بالتعويض بالنقطة <span class=m dir=ltr>(2, 4)</span>: صحيحة"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"(2,4)\"></span>","o":""}],[{"n":"7","s":[["m=\\frac{0}{x_2-x_1}=0","الفرق بين قيم <span class=m dir=ltr>y</span> على مستقيم أفقي صفر"]],"a":"صحيحة دائمًا: ميل جميع المستقيمات الأفقية صفر","o":""},{"n":"8","s":[["y=x+2","مثال مضاد: ميله <span class=m dir=ltr>1</span>"],["0\\ne 0+2","لا يمر بالنقطة <span class=m dir=ltr>(0, 0)</span>"]],"a":"خطأ: المستقيم الذي ميله <span class=m dir=ltr>1</span> لا يمر بالضرورة بنقطة الأصل","o":""},{"n":"9","s":[["y=5","مثال مضاد: مستقيم أفقي معدل تغيره <span class=m dir=ltr>0</span>"]],"a":"خطأ: يمكن أن يكون معدل التغير صفرًا (ليس سالبًا ولا موجبًا)","o":""},{"n":"10","s":[["x=k","جميع النقاط التي إحداثيها <span class=m dir=ltr>x</span> يساوي <span class=m dir=ltr>k</span> تقع على المستقيم الرأسي <span class=m dir=ltr>x = k</span>"]],"a":"صحيحة دائمًا","o":""}],[{"n":"14","s":[["(4,\\ 400)","من التمثيل البياني"],["m=\\frac{400-200}{4-2}=100","أو: الميل <span class=m dir=ltr>100 km/h</span>"],["y=100(4)=400","بالتعويض <span class=m dir=ltr>x = 4</span>"]],"a":"قطعت الشاحنة <span class=\"tx\" data-t=\"400\\ \\text{km}\"></span>","o":""},{"n":"15","s":[["\\frac{200-0}{2-0}=\\frac{400-200}{4-2}=100","معدل التغير ثابت"]],"a":"نعم، تسير الشاحنة بسرعة ثابتة <span class=\"tx\" data-t=\"100\\ \\text{km/h}\"></span> لأن التمثيل البياني مستقيم، أي معدل التغير (الميل) ثابت","o":""}],[{"n":"18","s":[["m=\\frac{\\text{rise}}{\\text{run}}=\\frac{40}{5.5}","التغير الرأسي <span class=m dir=ltr>÷</span> التغير الأفقي"],["=\\frac{80}{11}\\approx 7.27","بالتبسيط"]],"a":"ميل السلم <span class=\"tx\" data-t=\"\\frac{80}{11}\\approx 7.27\"></span>","o":"السلم ينحدر من الجدار نحو الأرض جهة اليمين، فإذا قيس الميل من اليسار إلى اليمين تكون إشارته سالبة <span class=\"tx\" data-t=\"-\\frac{80}{11}\"></span>"}],[{"n":"22","s":[["m=\\frac{d-b}{c-a}","صيغة الميل"],["=\\frac{-(b-d)}{-(a-c)}=\\frac{b-d}{a-c}","بضرب البسط والمقام في <span class=m dir=ltr>−1</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"\\frac{b-d}{a-c}\"></span>","o":""}],[{"n":"23","s":[["y=22","المستقيم الأفقي: جميع نقاطه لها الإحداثي <span class=m dir=ltr>y</span> نفسه"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"(0,22)\"></span>","o":""}],[{"n":"1a","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{6}{1.5} = 4","يرتفع <span class=m dir=ltr>6</span> وحدات عند التحرك <span class=m dir=ltr>1.5</span> وحدة إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = 4\"></span>","o":""},{"n":"1b","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{-4}{4} = -1","ينخفض <span class=m dir=ltr>4</span> وحدات عند التحرك <span class=m dir=ltr>4</span> وحدات إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = -1\"></span>","o":""},{"n":"1c","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{-6}{3} = -2","ينخفض <span class=m dir=ltr>6</span> وحدات عند التحرك <span class=m dir=ltr>3</span> وحدات إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = -2\"></span>","o":""},{"n":"1d","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{6}{1.5} = 4","يرتفع <span class=m dir=ltr>6</span> وحدات عند التحرك <span class=m dir=ltr>1.5</span> وحدة إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = 4\"></span>","o":""},{"n":"1e","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{4}{8} = \\frac{1}{2}","يرتفع <span class=m dir=ltr>4</span> وحدات عند التحرك <span class=m dir=ltr>8</span> وحدات إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = \\frac{1}{2}\"></span>","o":""},{"n":"1f","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{3}{4} = \\frac{3}{4}","يرتفع <span class=m dir=ltr>3</span> وحدات كلما تحرك <span class=m dir=ltr>4</span> وحدات إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = \\frac{3}{4}\"></span>","o":""},{"n":"1g","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{-3}{6} = -\\frac{1}{2}","ينخفض <span class=m dir=ltr>3</span> وحدات عند التحرك <span class=m dir=ltr>6</span> وحدات إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = -\\frac{1}{2}\"></span>","o":""},{"n":"1h","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{3}{2} = \\frac{3}{2}","يرتفع <span class=m dir=ltr>3</span> وحدات كلما تحرك وحدتين إلى اليمين"]],"a":"<span class=\"tx\" data-t=\"m = \\frac{3}{2}\"></span>","o":""}],[{"n":"2","s":[["P(-1, 2),\\ Q(1, 3),\\ R(4, 3),\\ S(3, -2)","إحداثيات الرؤوس من الشكل"],["m_{PQ} = \\frac{3 - 2}{1 - (-1)} = \\frac{1}{2}","صيغة الميل"],["m_{QR} = \\frac{3 - 3}{4 - 1} = 0","ضلع أفقي"],["m_{RS} = \\frac{-2 - 3}{3 - 4} = \\frac{-5}{-1} = 5",""],["m_{SP} = \\frac{2 - (-2)}{-1 - 3} = \\frac{4}{-4} = -1",""]],"a":"<span class=\"tx\" data-t=\"m_{PQ} = \\frac{1}{2}\"></span> ، <span class=\"tx\" data-t=\"m_{QR} = 0\"></span> ، <span class=\"tx\" data-t=\"m_{RS} = 5\"></span> ، <span class=\"tx\" data-t=\"m_{SP} = -1\"></span>","o":""},{"n":"3","s":[["J(-1, 3),\\ K(3, 1),\\ L(1, -3),\\ M(-3, -1)","إحداثيات الرؤوس من الشكل"],["m_{JK} = \\frac{1 - 3}{3 - (-1)} = \\frac{-2}{4} = -\\frac{1}{2}","صيغة الميل"],["m_{KL} = \\frac{-3 - 1}{1 - 3} = \\frac{-4}{-2} = 2",""],["m_{LM} = \\frac{-1 - (-3)}{-3 - 1} = \\frac{2}{-4} = -\\frac{1}{2}",""],["m_{MJ} = \\frac{3 - (-1)}{-1 - (-3)} = \\frac{4}{2} = 2",""]],"a":"<span class=\"tx\" data-t=\"m_{JK} = -\\frac{1}{2}\"></span> ، <span class=\"tx\" data-t=\"m_{KL} = 2\"></span> ، <span class=\"tx\" data-t=\"m_{LM} = -\\frac{1}{2}\"></span> ، <span class=\"tx\" data-t=\"m_{MJ} = 2\"></span>","o":"ملاحظة: الأضلاع المتقابلة متوازية والمتجاورة متعامدة (حاصل ضرب الميلين <span class=\"tx\" data-t=\"-1\"></span>)."}],[{"n":"4a","s":[["(0, -1),\\ (1, 2)","نقطتان على المستقيم"],["m = \\frac{2 - (-1)}{1 - 0} = 3","صيغة الميل"]],"a":"<span class=\"tx\" data-t=\"m = 3\"></span>","o":""},{"n":"4b","s":[["(0, 5),\\ (4, -3)","نقطتان على المستقيم"],["m = \\frac{-3 - 5}{4 - 0} = \\frac{-8}{4} = -2","صيغة الميل"]],"a":"<span class=\"tx\" data-t=\"m = -2\"></span>","o":""},{"n":"4c","s":[["(-2, 4),\\ (4, 1)","نقطتان على المستقيم"],["m = \\frac{1 - 4}{4 - (-2)} = \\frac{-3}{6} = -0.5","صيغة الميل"]],"a":"<span class=\"tx\" data-t=\"m = -0.5\"></span>","o":""},{"n":"4d","s":[["(-2, 0),\\ (0, 2)","نقطتان على المستقيم"],["m = \\frac{2 - 0}{0 - (-2)} = 1","صيغة الميل"]],"a":"<span class=\"tx\" data-t=\"m = 1\"></span>","o":""}],[{"n":"5","s":[["y = 4x - 2:\\ m = 4","على الصورة <span class=\"tx\" data-t=\"y = mx + b\"></span>"],["y = 4x:\\ m = 4",""],["y - 4x = 3 \\Rightarrow y = 4x + 3:\\ m = 4","بإضافة <span class=\"tx\" data-t=\"4x\"></span> إلى الطرفين"],["y = x + 4:\\ m = 1,\\quad y = 5 - 4x:\\ m = -4,\\quad y = \\frac{x}{4} - 4:\\ m = \\frac{1}{4}","معادلات ميلها ليس <span class=m dir=ltr>4</span>"],["y = 4:\\ m = 0,\\quad x = 4:\\ \\text{undefined}","مستقيم أفقي، ومستقيم رأسي ميله غير معرّف"]],"a":"نضع دائرة حول: <span class=\"tx\" data-t=\"y = 4x - 2\"></span> ، <span class=\"tx\" data-t=\"y = 4x\"></span> ، <span class=\"tx\" data-t=\"y - 4x = 3\"></span>","o":""}],[{"n":"6","s":[["m = \\frac{\\text{rise}}{\\text{run}} = \\frac{2.7}{5.5}","الارتفاع الرأسي <span class=m dir=ltr>2.7 m</span> والمسافة الأفقية <span class=m dir=ltr>5.5 m</span>"],["m = \\frac{27}{55} \\approx 0.49","بالتبسيط"]],"a":"ميل السطح <span class=\"tx\" data-t=\"= \\frac{27}{55} \\approx 0.49\"></span>","o":""}],[{"n":"7","s":[["\\text{Horse: } (0, 30),\\ (50, 50)","نقطتان تقريبيتان من مستقيم الحصان"],["m = \\frac{50 - 30}{50 - 0} = 0.4\\ \\text{kg/day}","معدل النمو <span class=m dir=ltr>=</span> الميل"],["\\text{Seal: } (0, 12),\\ (100, 35)","نقطتان تقريبيتان من مستقيم عجل البحر"],["m = \\frac{35 - 12}{100 - 0} \\approx 0.23\\ \\text{kg/day}","معدل النمو <span class=m dir=ltr>=</span> الميل"],["0.4 > 0.23","مستقيم الحصان أشدّ انحدارًا"]],"a":"معدل نمو الحصان ≈ <span class=\"tx\" data-t=\"0.4\\ \\text{kg}\"></span> يوميًا، ومعدل نمو عجل البحر ≈ <span class=\"tx\" data-t=\"0.23\\ \\text{kg}\"></span> يوميًا؛ الحصان أسرع نموًّا","o":"القيم مقروءة تقريبيًا من الشبكة؛ المهم أنّ ميل مستقيم الحصان أكبر."}],[{"n":"8","s":[["\\frac{90 - 75}{6 - 5} = \\frac{15}{1} = 15","معدل التغير <span class=m dir=ltr>=</span> التغير في الثمن <span class=m dir=ltr>÷</span> التغير في عدد التذاكر"],["\\frac{105 - 90}{7 - 6} = 15,\\quad \\frac{120 - 105}{8 - 7} = 15","المعدل ثابت"]],"a":"معدل التغير <span class=\"tx\" data-t=\"= 15\"></span> <span class=m dir=ltr>JD</span> لكل تذكرة","o":""}],[{"n":"9","s":[["5x - y = -4 \\Rightarrow y = 5x + 4","بحلّ المعادلة بالنسبة إلى <span class=\"tx\" data-t=\"y\"></span>"],["m = 5","ميل المستقيم المعطى"],["5x - y = 3","نُبقي <span class=\"tx\" data-t=\"A\"></span> و <span class=\"tx\" data-t=\"B\"></span> كما هما ونغيّر <span class=\"tx\" data-t=\"C\"></span> فيبقى الميل <span class=\"tx\" data-t=\"-\\frac{A}{B} = 5\"></span>"]],"a":"<span class=\"tx\" data-t=\"5x - y = 3\"></span> (إجابة ممكنة؛ أي معادلة <span class=\"tx\" data-t=\"5x - y = C\"></span> حيث <span class=\"tx\" data-t=\"C \\ne -4\"></span>)","o":""}],[{"n":"10","s":[["3x + 2y = 9:\\ x = 3,\\ y = 4.5","مقطعا معادلة هناء: المقطع <span class=\"tx\" data-t=\"x\"></span> هو <span class=m dir=ltr>3</span> والمقطع <span class=\"tx\" data-t=\"y\"></span> هو <span class=m dir=ltr>4.5</span>"],["\\text{Graph: } (0, 3),\\ (4.5, 0)","لكن المستقيم في التمثيل يقطع <span class=\"tx\" data-t=\"y\"></span> عند <span class=m dir=ltr>3</span> ويقطع <span class=\"tx\" data-t=\"x\"></span> عند <span class=m dir=ltr>4.5</span>"],["m = \\frac{0 - 3}{4.5 - 0} = -\\frac{2}{3}","ميل المستقيم المرسوم"],["y = -\\frac{2}{3}x + 3","صيغة الميل والمقطع"],["2x + 3y = 9","بضرب الطرفين في <span class=m dir=ltr>3</span> ونقل الحدّ إلى اليسار"]],"a":"الخطأ: بدّلت هناء معاملَي <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span> (فبدّلت المقطعين)؛ المعادلة الصحيحة <span class=\"tx\" data-t=\"2x + 3y = 9\"></span>","o":""}],[{"n":"2","s":[["m = \\frac{8 - 4}{5 - 3} = 2","الميل"],["y - 4 = 2(x - 3) \\Rightarrow y = 2x - 2","صيغة الميل ونقطة"],["(4, 6):\\ 2(4) - 2 = 6","تحقّق المعادلة"],["(3,5): 4 \\ne 5,\\ (2,3): 2 \\ne 3,\\ (5,6): 8 \\ne 6","النقاط الأخرى لا تحقّقها"]],"a":"<span class=m dir=ltr>A)</span> <span class=\"tx\" data-t=\"(4, 6)\"></span>","o":""}],[{"n":"5","s":[["m = \\frac{11 - 2}{4 - 1} = 3","الميل من <span class=\"tx\" data-t=\"(1, 2)\"></span> و <span class=\"tx\" data-t=\"(4, 11)\"></span>"],["\\frac{23 - 11}{8 - 4} = 3","تحقّق: المعدل ثابت"],["y = 3x - 1","بالتعويض: <span class=\"tx\" data-t=\"2 = 3(1) + b \\Rightarrow b = -1\"></span>"],["x = 2 \\Rightarrow y = 3(2) - 1 = 5","القيمة المفقودة"]],"a":"<span class=m dir=ltr>B) 5</span>","o":""}]]