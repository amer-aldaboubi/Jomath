[[{"n":"1","s":[["m = \\frac{y_2 - y_1}{x_2 - x_1} = \\frac{7-3}{5-3} = \\frac{4}{2}","صيغة الميل"],["m = 2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"m = 2\"></span>","o":""},{"n":"2","s":[["m = \\frac{3-1}{4-6} = \\frac{2}{-2}","صيغة الميل"],["m = -1","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"m = -1\"></span>","o":""},{"n":"3","s":[["m = \\frac{6-(-6)}{-2-(-2)} = \\frac{12}{0}","صيغة الميل"],["x_1 = x_2","القسمة على صفر غير معرفة؛ المستقيم رأسي"]],"a":"الميل غير معرف","o":""},{"n":"4","s":[["m = \\frac{-7-(-7)}{0-5} = \\frac{0}{-5}","صيغة الميل"],["m = 0","المستقيم أفقي"]],"a":"<span class=\"tx\" data-t=\"m = 0\"></span>","o":""},{"n":"5","s":[["m = \\frac{-5-0}{0-(-1)} = \\frac{-5}{1}","صيغة الميل"],["m = -5","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"m = -5\"></span>","o":""},{"n":"6","s":[["m = \\frac{8-1}{12-4} = \\frac{7}{8}","صيغة الميل"]],"a":"<span class=\"tx\" data-t=\"m = \\frac{7}{8}\"></span>","o":""}],[{"n":"7","s":[["\\frac{-6-(-2)}{s-6} = 4","صيغة الميل"],["-4 = 4(s-6)","بضرب الطرفين في <span class=m dir=ltr>(s − 6)</span>"],["-1 = s - 6","بقسمة الطرفين على <span class=m dir=ltr>4</span>"],["s = 5","بإضافة <span class=m dir=ltr>6</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"s = 5\"></span>","o":""},{"n":"8","s":[["\\frac{3-s}{6-9} = -\\frac{1}{3}","صيغة الميل"],["\\frac{3-s}{-3} = -\\frac{1}{3}","بالتبسيط"],["3 - s = 1","بضرب الطرفين في <span class=m dir=ltr>−3</span>"],["s = 2","بطرح <span class=m dir=ltr>3</span> من الطرفين ثم الضرب في <span class=m dir=ltr>−1</span>"]],"a":"<span class=\"tx\" data-t=\"s = 2\"></span>","o":""}],[{"n":"9","s":[["m = \\frac{2-(-1)}{4-1} = \\frac{3}{3} = 1","باستعمال النقطتين <span class=m dir=ltr>(1,−1)</span> و <span class=m dir=ltr>(4,2)</span>"]],"a":"الميل موجب، <span class=\"tx\" data-t=\"m = 1\"></span>","o":""},{"n":"10","s":[["m = \\frac{3-(-2)}{-1-(-1)} = \\frac{5}{0}","باستعمال النقطتين <span class=m dir=ltr>(−1,−2)</span> و <span class=m dir=ltr>(−1,3)</span>"]],"a":"الميل غير معرف (م