[[{"n":"1","s":[["P(X=x)=p(1-p)^{x-1}","صيغة التوزيع الهندسي"],["P(X=2)=0.2(0.8)^{1}","بتعويض <span class=m dir=ltr>p = 0.2</span> و <span class=m dir=ltr>x = 2</span>"],["=0.160",""]],"a":"<span class=\"tx\" data-t=\"P(X=2)=0.160\"></span>","o":"","k":[{"e":"0.16","a":true}]},{"n":"2","s":[["P(X=10)=0.2(0.8)^{9}","بتعويض <span class=m dir=ltr>x = 10</span> في صيغة التوزيع الهندسي"],["\\approx 0.0268","باستعمال الآلة الحاسبة"],["\\approx 0.027","بالتقريب إلى <span class=m dir=ltr>3</span> منازل عشرية"]],"a":"<span class=\"tx\" data-t=\"P(X=10)\\approx 0.027\"></span>","o":"","k":[{"e":"0.027","a":true}]},{"n":"3","s":[["P(X\\ge 3)=P(X>2)","لأن <span class=m dir=ltr>X</span> تأخذ قيمًا صحيحة"],["P(X>x)=(1-p)^{x}","قانون <span class=m dir=ltr>P(X&gt;x)</span> في التوزيع الهندسي"],["=(0.8)^{2}=0.640","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 3)=0.640\"></span>","o":""},{"n":"4","s":[["P(2<X\\le 5)=P(X>2)-P(X>5)","الفرق بين احتمالين"],["=(0.8)^{2}-(0.8)^{5}","قانون <span class=m dir=ltr>P(X&gt;x) = (1-p)^x</span>"],["=0.64-0.32768=0.31232","باستعمال الآلة الحاسبة"],["\\approx 0.312","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(2&lt;X\\le 5)\\approx 0.312\"></span>","o":"","k":[{"e":"0.312","a":true}]},{"n":"5","s":[["P(X<2)=P(X=1)","أصغر قيمة للمتغيّر الهندسي هي <span class=m dir=ltr>1</span>"],["=0.2(0.8)^{0}=0.200","صيغة التوزيع الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;2)=0.200\"></span>","o":""},{"n":"6","s":[["P(X\\le 4)=1-P(X>4)","احتمال المتممة"],["=1-(0.8)^{4}","قانون <span class=m dir=ltr>P(X&gt;x)</span>"],["=1-0.4096=0.5904\\approx 0.590","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 4)\\approx 0.590\"></span>","o":"","k":[{"e":"0.59","a":true}]},{"n":"7","s":[["P(1\\le X<2)=P(X=1)","القيمة الصحيحة الوحيدة هي <span class=m dir=ltr>1</span>"],["=0.2(0.8)^{0}=0.200","صيغة التوزيع الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(1\\le X&lt;2)=0.200\"></span>","o":""},{"n":"8","s":[["P(3\\le X\\le 6)=P(X>2)-P(X>6)","الفرق بين احتمالين"],["=(0.8)^{2}-(0.8)^{6}","قانون <span class=m dir=ltr>P(X&gt;x)</span>"],["=0.64-0.262144=0.377856","باستعمال الآلة الحاسبة"],["\\approx 0.378","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"P(3\\le X\\le 6)\\approx 0.378\"></span>","o":"","k":[{"e":"0.378","a":true}]}],[{"n":"9","s":[["X\\sim Geo\\left(\\tfrac{1}{8}\\right)","<span class=m dir=ltr>X</span>: عدد مرات الإلقاء حتى ظهور العدد <span class=m dir=ltr>7</span> أول مرة، و <span class=m dir=ltr>p = 1/8</span>"],["P(X=6)=\\tfrac{1}{8}\\left(\\tfrac{7}{8}\\right)^{5}","صيغة التوزيع الهندسي"],["\\approx 0.0641","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=6)\\approx 0.0641\"></span>","o":"","k":[{"e":"0.0641","a":true}]}],[{"n":"10","s":[["X\\sim Geo(0.7)","<span class=m dir=ltr>X</span>: عدد الطلقات حتى إصابة الهدف أول مرة"],["P(X=10)=0.7(0.3)^{9}","صيغة التوزيع الهندسي، أول نجاح في المحاولة العاشرة"],["=0.7\\times 0.0000196830\\approx 0.0000138","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=10)=0.7(0.3)^9\\approx 1.38\\times 10^{-5}\\approx 0.0000138\"></span>","o":"","k":[{"e":"1.38e-5","a":true}]}],[{"n":"11","s":[["X\\sim Geo\\left(\\tfrac{1}{12}\\right)","<span class=m dir=ltr>X</span>: عدد الخنافس التي تُجمع حتى أول خنفساء برتقالية"],["P(X=20)=\\tfrac{1}{12}\\left(\\tfrac{11}{12}\\right)^{19}","صيغة التوزيع الهندسي"],["\\approx 0.0160","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=20)\\approx 0.0160\"></span>","o":"","k":[{"e":"0.016","a":true}]}],[{"n":"12","s":[["X\\sim Geo(0.25)","<span class=m dir=ltr>X</span>: عدد المرضى حتى ظهور أول إصابة بالأعراض الجانبية"],["P(X=10)=0.25(0.75)^{9}","صيغة التوزيع الهندسي"],["\\approx 0.0188","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=10)\\approx 0.0188\"></span>","o":"","k":[{"e":"0.0188","a":true}]},{"n":"13","s":[["P(X>3)=(1-p)^{3}","قانون <span class=m dir=ltr>P(X&gt;x)</span> في التوزيع الهندسي"],["=(0.75)^{3}=0.421875","بالتعويض"],["\\approx 0.422",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;3)\\approx 0.422\"></span>","o":"","k":[{"e":"0.422","a":true}]},{"n":"14","s":[["E(X)=\\frac{1}{p}","توقع المتغيّر الهندسي"],["=\\frac{1}{0.25}=4","بالتعويض"]],"a":"العدد المتوقع هو <span class=\"tx\" data-t=\"4\"></span> مرضى","o":"","k":[{"e":"4","a":null}]}],[{"n":"15","s":[["P(X=r)=\\binom{n}{r}p^{r}(1-p)^{n-r}","صيغة توزيع ذي الحدين"],["P(X=2)=\\binom{10}{2}(0.3)^{2}(0.7)^{8}","<span class=m dir=ltr>n = 10, p = 0.3</span>"],["=45(0.09)(0.0576480)\\approx 0.233","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=2)\\approx 0.233\"></span>","o":"","k":[{"e":"0.233","a":true}]},{"n":"16","s":[["P(X\\ge 9)=P(X=9)+P(X=10)","الحوادث المتنافية"],["=\\binom{10}{9}(0.3)^{9}(0.7)+\\binom{10}{10}(0.3)^{10}","صيغة توزيع ذي الحدين"],["=0.0001378+0.0000059=0.0001437","باستعمال الآلة الحاسبة"],["\\approx 0.000","بالتقريب إلى <span class=m dir=ltr>3</span> منازل عشرية"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 9)\\approx 0.000\"></span> (القيمة الدقيقة تقريبًا <span class=\"tx\" data-t=\"0.00014\"></span>)","o":"","k":[{"e":"0.0","a":true},{"e":"0.00014","a":true}]},{"n":"17","s":[["P(X\\le 8)=1-P(X\\ge 9)","احتمال المتممة"],["=1-0.0001437=0.9998563","من الفرع <span class=m dir=ltr>16</span>"],["\\approx 1.000","بالتقريب إلى <span class=m dir=ltr>3</span> منازل عشرية"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 8)\\approx 1.000\"></span> (تقريبًا <span class=\"tx\" data-t=\"0.99986\"></span>)","o":"","k":[{"e":"1.0","a":true},{"e":"0.99986","a":true}]},{"n":"18","s":[["P(1<X\\le 4)=P(X=2)+P(X=3)+P(X=4)","الحوادث المتنافية"],["=\\binom{10}{2}(0.3)^2(0.7)^8+\\binom{10}{3}(0.3)^3(0.7)^7+\\binom{10}{4}(0.3)^4(0.7)^6","صيغة توزيع ذي الحدين"],["\\approx 0.2335+0.2668+0.2001","باستعمال الآلة الحاسبة"],["\\approx 0.700",""]],"a":"<span class=\"tx\" data-t=\"P(1&lt;X\\le 4)\\approx 0.700\"></span>","o":"","k":[{"e":"0.7","a":true}]},{"n":"19","s":[["P(X>1)=1-\\left(P(X=0)+P(X=1)\\right)","احتمال المتممة"],["=1-\\left((0.7)^{10}+\\binom{10}{1}(0.3)(0.7)^{9}\\right)","صيغة توزيع ذي الحدين"],["=1-(0.0282+0.1211)\\approx 0.851","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;1)\\approx 0.851\"></span>","o":"","k":[{"e":"0.851","a":true}]},{"n":"20","s":[["P(X<4)=P(X=0)+P(X=1)+P(X=2)+P(X=3)","الحوادث المتنافية"],["\\approx 0.0282+0.1211+0.2335+0.2668","صيغة توزيع ذي الحدين"],["\\approx 0.650",""]],"a":"<span class=\"tx\" data-t=\"P(X&lt;4)\\approx 0.650\"></span>","o":"","k":[{"e":"0.65","a":true}]},{"n":"21","s":[["P(0\\le X<3)=P(X=0)+P(X=1)+P(X=2)","الحوادث المتنافية"],["\\approx 0.0282+0.1211+0.2335","صيغة توزيع ذي الحدين"],["\\approx 0.383",""]],"a":"<span class=\"tx\" data-t=\"P(0\\le X&lt;3)\\approx 0.383\"></span>","o":"","k":[{"e":"0.383","a":true}]},{"n":"22","s":[["P(3\\le X\\le 6)=P(X=3)+P(X=4)+P(X=5)+P(X=6)","الحوادث المتنافية"],["\\approx 0.2668+0.2001+0.1029+0.0368","صيغة توزيع ذي الحدين"],["\\approx 0.607",""]],"a":"<span class=\"tx\" data-t=\"P(3\\le X\\le 6)\\approx 0.607\"></span>","o":"","k":[{"e":"0.607","a":true}]}],[{"n":"23","s":[["E(X)=\\frac{1}{p}","توقع المتغيّر الهندسي"],["=\\frac{1}{0.3}=\\frac{10}{3}\\approx 3.33","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{10}{3}\\approx 3.33\"></span>","o":"","k":[{"e":"3.33","a":true}]},{"n":"24","s":[["E(X)=\\frac{1}{p}","توقع المتغيّر الهندسي"],["=\\frac{1}{\\frac{3}{7}}=\\frac{7}{3}\\approx 2.33","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{7}{3}\\approx 2.33\"></span>","o":"","k":[{"e":"2.33","a":true}]}],[{"n":"25","s":[["E(X)=np=5(0.1)=0.5","توقع متغيّر ذي الحدين"],["Var(X)=np(1-p)=5(0.1)(0.9)=0.45","تباين متغيّر ذي الحدين"]],"a":"<span class=\"tx\" data-t=\"E(X)=0.5,\\ Var(X)=0.45\"></span>","o":"","k":[{"e":"0.5","a":true},{"e":"0.45","a":true}]},{"n":"26","s":[["E(X)=np=20\\times\\frac{3}{8}=7.5","توقع متغيّر ذي الحدين"],["Var(X)=np(1-p)=20\\times\\frac{3}{8}\\times\\frac{5}{8}=\\frac{75}{16}=4.6875","تباين متغيّر ذي الحدين"]],"a":"<span class=\"tx\" data-t=\"E(X)=7.5,\\ Var(X)=\\frac{75}{16}=4.6875\"></span>","o":"","k":[{"e":"7.5","a":true},{"e":"4.6875","a":true}]}],[{"n":"27","s":[["X\\sim B\\left(9,\\tfrac{1}{2}\\right)","<span class=m dir=ltr>X</span>: عدد مرات ظهور عدد زوجي، واحتمال الزوجي <span class=m dir=ltr>3/6 = 1/2</span>"],["P(X=5)=\\binom{9}{5}\\left(\\tfrac12\\right)^{5}\\left(\\tfrac12\\right)^{4}","صيغة توزيع ذي الحدين"],["=126\\times\\frac{1}{512}=\\frac{63}{256}\\approx 0.246","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=5)=\\frac{63}{256}\\approx 0.246\"></span>","o":"","k":[{"e":"0.246","a":true}]}],[{"n":"28","s":[["X\\sim B(20,0.25)","<span class=m dir=ltr>X</span>: عدد مرات مواجهة صعوبة في الرؤية"],["P(X=3)=\\binom{20}{3}(0.25)^{3}(0.75)^{17}","صيغة توزيع ذي الحدين"],["=1140(0.015625)(0.0075169)\\approx 0.1339","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.1339\"></span>","o":"","k":[{"e":"0.1339","a":true}]},{"n":"29","s":[["P(X\\ge 3)=1-\\left(P(X=0)+P(X=1)+P(X=2)\\right)","احتمال المتممة"],["=1-\\left((0.75)^{20}+\\binom{20}{1}(0.25)(0.75)^{19}+\\binom{20}{2}(0.25)^{2}(0.75)^{18}\\right)","صيغة توزيع ذي الحدين"],["\\approx 1-(0.0032+0.0211+0.0669)","باستعمال الآلة الحاسبة"],["\\approx 0.9087",""]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 3)\\approx 0.9087\"></span>","o":"","k":[{"e":"0.9087","a":true}]},{"n":"30","s":[["P(X=20)=\\binom{20}{20}(0.25)^{20}(0.75)^{0}","صيغة توزيع ذي الحدين"],["=(0.25)^{20}\\approx 9.09\\times 10^{-13}","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=20)=(0.25)^{20}\\approx 9.09\\times10^{-13}\"></span> (قريب جدًّا من الصفر)","o":"","k":[{"e":"9.09e-13","a":true}]},{"n":"31","s":[["E(X)=np","توقع متغيّر ذي الحدين"],["=20(0.25)=5","بالتعويض"]],"a":"العدد المتوقع <span class=\"tx\" data-t=\"5\"></span> مرات","o":"","k":[{"e":"5","a":null}]}],[{"n":"32","s":[["np=1.4,\\quad np(1-p)=1.12","توقع وتباين متغيّر ذي الحدين"],["1-p=\\frac{1.12}{1.4}=0.8\\Rightarrow p=0.2","بقسمة المعادلة الثانية على الأولى"],["n=\\frac{1.4}{0.2}=7","بالتعويض في المعادلة الأولى"],["P(X\\ge 6)=P(X=6)+P(X=7)","<span class=m dir=ltr>X</span> ~ <span class=m dir=ltr>B(7, 0.2)</span>، والحوادث متنافية"],["=\\binom{7}{6}(0.2)^{6}(0.8)+\\binom{7}{7}(0.2)^{7}","صيغة توزيع ذي الحدين"],["=0.0003584+0.0000128=0.0003712","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"X\\sim B(7,0.2)\"></span> و <span class=\"tx\" data-t=\"P(X\\ge 6)=0.0003712\"></span>","o":""}],[{"n":"33","s":[["E(X)=\\frac{1}{p}=\\frac{4}{3}","توقع المتغيّر الهندسي"],["p=\\frac{3}{4}","بأخذ المقلوب للطرفين"]],"a":"<span class=\"tx\" data-t=\"p=\\frac{3}{4}=0.75\"></span>","o":"","k":[{"e":"0.75","a":true}]}],[{"n":"34","s":[["\\binom{21}{10}p^{10}(1-p)^{11}=\\binom{21}{9}p^{9}(1-p)^{12}","صيغة توزيع ذي الحدين للطرفين"],["352716\\,p=293930\\,(1-p)","بقسمة الطرفين على <span class=m dir=ltr>p^9(1-p)^{11}</span>"],["\\frac{12}{10}p=1-p","لأن <span class=m dir=ltr>352716 ÷ 293930 = 12/10</span>"],["2.2p=1\\Rightarrow p=\\frac{5}{11}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"p=\\frac{5}{11}\\approx 0.455\"></span>","o":"","k":[{"e":"0.455","a":true}]}],[{"n":"35","s":[["X\\sim B(10,0.1)","<span class=m dir=ltr>X</span>: عدد الأشخاص الذين يشترون المنتج"],["P(X=10)=\\binom{10}{10}(0.1)^{10}(0.9)^{0}","صيغة توزيع ذي الحدين"],["=(0.1)^{10}=10^{-10}",""]],"a":"<span class=\"tx\" data-t=\"P(X=10)=10^{-10}=0.0000000001\"></span>","o":"","k":[{"e":"1.0e-10","a":true}]},{"n":"36","s":[["10X>80\\Rightarrow X>8","عائد المبيعات <span class=m dir=ltr>= 10X</span> دينارًا"],["P(X>8)=P(X=9)+P(X=10)","الحوادث المتنافية"],["=\\binom{10}{9}(0.1)^{9}(0.9)+(0.1)^{10}","صيغة توزيع ذي الحدين"],["=9\\times10^{-9}+1\\times10^{-10}=9.1\\times10^{-9}",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;8)=9.1\\times10^{-9}\"></span>","o":""}],[{"n":"37","s":[["P(X=x)=p(1-p)^{x-1}","صيغة التوزيع الهندسي: الأس هو <span class=m dir=ltr>x − 1</span> لا <span class=m dir=ltr>x</span>"],["P(X=3)=\\frac{5}{11}\\left(1-\\frac{5}{11}\\right)^{2}","تكرار الفشل مرتين ثم النجاح في المرة الثالثة"],["=\\frac{5}{11}\\times\\frac{36}{121}=\\frac{180}{1331}\\approx 0.135","بالتبسيط"]],"a":"الصحيح: <span class=\"tx\" data-t=\"P(X=3)=\\frac{180}{1331}\\approx 0.135\"></span>","o":"الخطأ: استعملت لانا الأس <span class=m dir=ltr>3</span> بدل <span class=m dir=ltr>2</span>؛ فظهور الصورة أول مرة في الرمية الثالثة يعني فشلين فقط قبلها.","k":[{"e":"0.135","a":true}]}],[{"n":"38","s":[["(1-p)\\,p=0.21","عدم الرد في المرة الأولى ثم الرد في الثانية (محاولات مستقلة)"],["p^{2}-p+0.21=0","بالتبسيط"],["(p-0.7)(p-0.3)=0","بالتحليل"],["p=0.7","لأن <span class=m dir=ltr>p &gt; 0.5</span>"],["E(X)=\\frac{1}{p}=\\frac{1}{0.7}=\\frac{10}{7}","توقع المتغيّر الهندسي"]],"a":"العدد المتوقع للاستبانات <span class=\"tx\" data-t=\"\\frac{10}{7}\\approx 1.43\"></span>","o":"","k":[{"e":"1.43","a":true}]}],[{"n":"39","s":[["X\\sim B\\left(25,\\tfrac{1}{12}\\right)","<span class=m dir=ltr>X</span>: عدد الطلبة من مواليد آذار، باحتمال <span class=m dir=ltr>1/12</span> لكل طالب (بافتراض تساوي احتمالات الأشهر)"],["P(X=1)=\\binom{25}{1}\\left(\\tfrac{1}{12}\\right)\\left(\\tfrac{11}{12}\\right)^{24}","صيغة توزيع ذي الحدين"],["\\approx 0.258","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=1)\\approx 0.258\"></span>","o":"","k":[{"e":"0.258","a":true}]},{"n":"40","s":[["P(X=3)=\\binom{25}{3}\\left(\\tfrac{1}{12}\\right)^{3}\\left(\\tfrac{11}{12}\\right)^{22}","صيغة توزيع ذي الحدين"],["=2300\\times\\frac{1}{1728}\\times 0.14745\\approx 0.196","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.196\"></span>","o":"","k":[{"e":"0.196","a":true}]}],[{"n":"41","s":[["\\mu=np=30(0.1)=3","توقع متغيّر ذي الحدين"],["\\sigma=\\sqrt{np(1-p)}=\\sqrt{2.7}\\approx 1.643","الانحراف المعياري"],["P(3\\le X<4.643)=P(X=3)+P(X=4)","القيم الصحيحة في الفترة"],["=\\binom{30}{3}(0.1)^{3}(0.9)^{27}+\\binom{30}{4}(0.1)^{4}(0.9)^{26}","صيغة توزيع ذي الحدين"],["\\approx 0.2361+0.1771=0.4132","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(\\mu\\le X&lt;\\mu+\\sigma)\\approx 0.413\"></span>","o":""}],[{"n":"1","s":[["P(X=1)=p(1-p)^{0}","صيغة التوزيع الهندسي"],["=0.1",""]],"a":"الإجابة <span class=m dir=ltr>a)</span>: <span class=\"tx\" data-t=\"0.1\"></span>","o":"","k":[{"e":"0.1","a":true}]}],[{"n":"2","s":[["X\\in\\{0,1,2,3,4,5\\}","في <span class=m dir=ltr>B(5, 0.1)</span> لا يزيد عدد النجاحات على عدد المحاولات <span class=m dir=ltr>5</span>"],["P(X=6)=0","حادث مستحيل"]],"a":"الإجابة <span class=m dir=ltr>b)</span>: <span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"0","a":null}]}],[{"n":"7","s":[["P(X=4)=0.3(0.7)^{3}","صيغة التوزيع الهندسي"],["=0.1029",""]],"a":"<span class=\"tx\" data-t=\"P(X=4)=0.1029\"></span>","o":"","k":[{"e":"0.1029","a":true}]},{"n":"8","s":[["P(3<X\\le 5)=P(X>3)-P(X>5)","الفرق بين احتمالين"],["=(0.7)^{3}-(0.7)^{5}","قانون <span class=m dir=ltr>P(X &gt; x) = (1-p)^x</span>"],["=0.343-0.16807=0.17493",""]],"a":"<span class=\"tx\" data-t=\"P(3&lt;X\\le 5)\\approx 0.1749\"></span>","o":"","k":[{"e":"0.1749","a":true}]},{"n":"9","s":[["P(X>4)=(1-p)^{4}=(0.7)^{4}","قانون <span class=m dir=ltr>P(X &gt; x)</span> في التوزيع الهندسي"],["=0.2401",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;4)=0.2401\"></span>","o":""},{"n":"10","s":[["P(5\\le X\\le 7)=P(X>4)-P(X>7)","الفرق بين احتمالين"],["=(0.7)^{4}-(0.7)^{7}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["=0.2401-0.0823543=0.1577457",""]],"a":"<span class=\"tx\" data-t=\"P(5\\le X\\le 7)\\approx 0.1577\"></span>","o":"","k":[{"e":"0.1577","a":true}]}],[{"n":"11","s":[["P(X=3)=\\binom{10}{3}(0.4)^{3}(0.6)^{7}","صيغة توزيع ذي الحدين"],["=120(0.064)(0.0279936)\\approx 0.2150","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.2150\"></span>","o":"","k":[{"e":"0.215","a":true}]},{"n":"12","s":[["P(X>2)=1-\\left(P(X=0)+P(X=1)+P(X=2)\\right)","احتمال المتممة"],["=1-\\left((0.6)^{10}+\\binom{10}{1}(0.4)(0.6)^{9}+\\binom{10}{2}(0.4)^{2}(0.6)^{8}\\right)","صيغة توزيع ذي الحدين"],["\\approx 1-(0.0060+0.0403+0.1209)\\approx 0.8327","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;2)\\approx 0.8327\"></span>","o":"","k":[{"e":"0.8327","a":true}]},{"n":"13","s":[["P(7\\le X<9)=P(X=7)+P(X=8)","الحوادث المتنافية"],["=\\binom{10}{7}(0.4)^{7}(0.6)^{3}+\\binom{10}{8}(0.4)^{8}(0.6)^{2}","صيغة توزيع ذي الحدين"],["\\approx 0.0425+0.0106=0.0531","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(7\\le X&lt;9)\\approx 0.0531\"></span>","o":"","k":[{"e":"0.0531","a":true}]},{"n":"14","s":[["P(X\\le 9)=1-P(X=10)","احتمال المتممة"],["=1-(0.4)^{10}=1-0.0001049\\approx 0.9999","صيغة توزيع ذي الحدين"]],"a":"<span class=\"tx\" data-t=\"P(X\\le 9)\\approx 0.9999\"></span>","o":"","k":[{"e":"0.9999","a":true}]}],[{"n":"21","s":[["X\\sim B(100,0.17)","<span class=m dir=ltr>X</span>: عدد المصابيح التالفة"],["E(X)=np=100(0.17)=17","توقع متغيّر ذي الحدين"]],"a":"العدد المتوقع <span class=\"tx\" data-t=\"17\"></span> مصباحًا","o":"","k":[{"e":"17","a":null}]}],[{"n":"22","s":[["X\\sim Geo(0.2)","<span class=m dir=ltr>X</span>: عدد الطلبة الذين تُجرى معهم المقابلة حتى أول طالب يمارس التمرينات"],["E(X)=\\frac{1}{p}=\\frac{1}{0.2}=5","توقع المتغيّر الهندسي"]],"a":"العدد المتوقع <span class=\"tx\" data-t=\"5\"></span> طلبة","o":"أي يُتوقع أن يكون الطالب الخامس هو أول من يمارس التمرينات <span class=m dir=ltr>(4</span> طلبة قبله).","k":[{"e":"5","a":null}]}],[{"n":"32","s":[["np=2.5,\\quad np(1-p)=1.875","توقع وتباين متغيّر ذي الحدين"],["1-p=\\frac{1.875}{2.5}=0.75\\Rightarrow p=0.25","بقسمة المعادلتين"],["n=\\frac{2.5}{0.25}=10","بالتعويض"],["P(X\\ge 8)=\\binom{10}{8}(0.25)^{8}(0.75)^{2}+\\binom{10}{9}(0.25)^{9}(0.75)+(0.25)^{10}","صيغة توزيع ذي الحدين، <span class=m dir=ltr>X</span> ~ <span class=m dir=ltr>B(10, 0.25)</span>"],["\\approx 0.000386+0.0000286+0.00000095\\approx 0.000416","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 8)\\approx 0.000416\"></span>","o":"","k":[{"e":"0.000416","a":true}]}],[{"n":"1","s":[["P(X=4)=\\frac{1}{8}\\left(\\frac{7}{8}\\right)^{3}","صيغة التوزيع الهندسي"],["=\\frac{343}{4096}\\approx 0.084",""]],"a":"<span class=\"tx\" data-t=\"P(X=4)\\approx 0.084\"></span>","o":"","k":[{"e":"0.084","a":true}]},{"n":"2","s":[["P(X\\le 4)=1-\\left(\\frac{7}{8}\\right)^{4}","احتمال المتممة و <span class=m dir=ltr>P(X &gt; x) = (1-p)^x</span>"],["=1-0.5862\\approx 0.414",""]],"a":"<span class=\"tx\" data-t=\"P(X\\le 4)\\approx 0.414\"></span>","o":"","k":[{"e":"0.414","a":true}]},{"n":"3","s":[["P(X\\ge 2)=P(X>1)=\\frac{7}{8}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["=0.875",""]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 2)=0.875\"></span>","o":""},{"n":"4","s":[["P(3\\le X\\le 7)=P(X>2)-P(X>7)","الفرق بين احتمالين"],["=\\left(\\frac{7}{8}\\right)^{2}-\\left(\\frac{7}{8}\\right)^{7}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["=0.7656-0.3927\\approx 0.373",""]],"a":"<span class=\"tx\" data-t=\"P(3\\le X\\le 7)\\approx 0.373\"></span>","o":"","k":[{"e":"0.373","a":true}]},{"n":"5","s":[["P(X<2)=P(X=1)=\\frac{1}{8}","صيغة التوزيع الهندسي"],["=0.125",""]],"a":"<span class=\"tx\" data-t=\"P(X&lt;2)=0.125\"></span>","o":""},{"n":"6","s":[["P(X>5)=\\left(\\frac{7}{8}\\right)^{5}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["\\approx 0.513",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;5)\\approx 0.513\"></span>","o":"","k":[{"e":"0.513","a":true}]},{"n":"7","s":[["P(1<X<3)=P(X=2)","القيمة الصحيحة الوحيدة"],["=\\frac{1}{8}\\times\\frac{7}{8}=\\frac{7}{64}\\approx 0.109","صيغة التوزيع الهندسي"]],"a":"<span class=\"tx\" data-t=\"P(1&lt;X&lt;3)\\approx 0.109\"></span>","o":"","k":[{"e":"0.109","a":true}]},{"n":"8","s":[["P(4<X\\le 6)=P(X>4)-P(X>6)","الفرق بين احتمالين"],["=\\left(\\frac{7}{8}\\right)^{4}-\\left(\\frac{7}{8}\\right)^{6}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["=0.5862-0.4488\\approx 0.137",""]],"a":"<span class=\"tx\" data-t=\"P(4&lt;X\\le 6)\\approx 0.137\"></span>","o":"","k":[{"e":"0.137","a":true}]}],[{"n":"9","s":[["P(X=4)=\\binom{5}{4}(0.4)^{4}(0.6)","صيغة توزيع ذي الحدين"],["=5(0.0256)(0.6)=0.0768\\approx 0.077",""]],"a":"<span class=\"tx\" data-t=\"P(X=4)\\approx 0.077\"></span>","o":"","k":[{"e":"0.077","a":true}]},{"n":"10","s":[["P(X\\ge 5)=P(X=5)=(0.4)^{5}","أكبر قيمة لـ <span class=m dir=ltr>X</span> هي <span class=m dir=ltr>5</span>"],["=0.01024\\approx 0.010",""]],"a":"<span class=\"tx\" data-t=\"P(X\\ge 5)\\approx 0.010\"></span>","o":"","k":[{"e":"0.01","a":true}]},{"n":"11","s":[["P(X\\le 3)=1-\\left(P(X=4)+P(X=5)\\right)","احتمال المتممة"],["=1-(0.0768+0.01024)=0.91296\\approx 0.913",""]],"a":"<span class=\"tx\" data-t=\"P(X\\le 3)\\approx 0.913\"></span>","o":"","k":[{"e":"0.913","a":true}]},{"n":"12","s":[["P(3<X\\le 5)=P(X=4)+P(X=5)","الحوادث المتنافية"],["=0.0768+0.01024=0.08704\\approx 0.087",""]],"a":"<span class=\"tx\" data-t=\"P(3&lt;X\\le 5)\\approx 0.087\"></span>","o":"","k":[{"e":"0.087","a":true}]},{"n":"13","s":[["P(X>2)=P(X=3)+P(X=4)+P(X=5)","الحوادث المتنافية"],["=\\binom{5}{3}(0.4)^{3}(0.6)^{2}+0.0768+0.01024","صيغة توزيع ذي الحدين"],["=0.2304+0.0768+0.01024=0.31744\\approx 0.317",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;2)\\approx 0.317\"></span>","o":"","k":[{"e":"0.317","a":true}]},{"n":"14","s":[["P(X<3)=1-P(X>2)","احتمال المتممة"],["=1-0.31744=0.68256\\approx 0.683","من الفرع <span class=m dir=ltr>13</span>"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;3)\\approx 0.683\"></span>","o":"","k":[{"e":"0.683","a":true}]},{"n":"15","s":[["P(2\\le X<5)=P(X=2)+P(X=3)+P(X=4)","الحوادث المتنافية"],["=\\binom{5}{2}(0.4)^{2}(0.6)^{3}+0.2304+0.0768","صيغة توزيع ذي الحدين"],["=0.3456+0.2304+0.0768=0.6528\\approx 0.653",""]],"a":"<span class=\"tx\" data-t=\"P(2\\le X&lt;5)\\approx 0.653\"></span>","o":"","k":[{"e":"0.653","a":true}]},{"n":"16","s":[["X\\in\\{0,1,2,3,4,5\\}","لا يزيد عدد النجاحات على <span class=m dir=ltr>5</span>"],["P(5<X<8)=0","حادث مستحيل"]],"a":"<span class=\"tx\" data-t=\"P(5&lt;X&lt;8)=0\"></span>","o":""}],[{"n":"17","s":[["E(X)=\\frac{1}{p}=\\frac{1}{0.45}=\\frac{20}{9}\\approx 2.22","توقع المتغيّر الهندسي"]],"a":"<span class=\"tx\" data-t=\"E(X)=\\frac{20}{9}\\approx 2.22\"></span>","o":"","k":[{"e":"2.22","a":true}]},{"n":"18","s":[["E(X)=\\frac{1}{p}=\\frac{1}{\\frac{2}{5}}=\\frac{5}{2}=2.5","توقع المتغيّر الهندسي"]],"a":"<span class=\"tx\" data-t=\"E(X)=2.5\"></span>","o":"","k":[{"e":"2.5","a":true}]}],[{"n":"19","s":[["E(X)=np=10(0.2)=2","توقع متغيّر ذي الحدين"],["Var(X)=np(1-p)=10(0.2)(0.8)=1.6","تباين متغيّر ذي الحدين"]],"a":"<span class=\"tx\" data-t=\"E(X)=2,\\ Var(X)=1.6\"></span>","o":"","k":[{"e":"2","a":true},{"e":"1.6","a":true}]},{"n":"20","s":[["E(X)=np=150(0.3)=45","توقع متغيّر ذي الحدين"],["Var(X)=np(1-p)=150(0.3)(0.7)=31.5","تباين متغيّر ذي الحدين"]],"a":"<span class=\"tx\" data-t=\"E(X)=45,\\ Var(X)=31.5\"></span>","o":"","k":[{"e":"45","a":true},{"e":"31.5","a":true}]}],[{"n":"21","s":[["X\\sim Geo(0.1)","<span class=m dir=ltr>X</span>: عدد السيارات المارة حتى أول سيارة صفراء (بما فيها الصفراء)"],["P(X<5)=P(X\\le 4)=1-(0.9)^{4}","احتمال المتممة و <span class=m dir=ltr>P(X &gt; x) = (1-p)^x</span>"],["=1-0.6561=0.3439",""]],"a":"<span class=\"tx\" data-t=\"P(X&lt;5)=0.3439\"></span>","o":""},{"n":"22","s":[["P(X>3)=(0.9)^{3}","قانون <span class=m dir=ltr>P(X &gt; x)</span>"],["=0.729",""]],"a":"<span class=\"tx\" data-t=\"P(X&gt;3)=0.729\"></span>","o":""}],[{"n":"23","s":[["X\\sim B(15,0.1)","<span class=m dir=ltr>X</span>: عدد الرميات التي يُسجَّل فيها هدف"],["P(X=3)=\\binom{15}{3}(0.1)^{3}(0.9)^{12}","صيغة توزيع ذي الحدين"],["=455(0.001)(0.2824)\\approx 0.1285","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=3)\\approx 0.1285\"></span>","o":"","k":[{"e":"0.1285","a":true}]}],[{"n":"24","s":[["X\\sim B\\left(30,\\tfrac{3}{5}\\right)","<span class=m dir=ltr>X</span>: عدد الطلبة الذين يحتاجون أوراقًا إضافية، <span class=m dir=ltr>p = 3/5 = 0.6</span>"],["P(X=10)=\\binom{30}{10}(0.6)^{10}(0.4)^{20}","صيغة توزيع ذي الحدين"],["\\approx 0.0020","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=10)\\approx 0.0020\"></span>","o":"","k":[{"e":"0.002","a":true}]},{"n":"25","s":[["P(X=0)=\\binom{30}{0}(0.6)^{0}(0.4)^{30}","صيغة توزيع ذي الحدين"],["=(0.4)^{30}\\approx 1.15\\times 10^{-12}","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"P(X=0)\\approx 1.15\\times10^{-12}\"></span> (قريب جدًّا من الصفر)","o":"","k":[{"e":"1.15e-12","a":true}]}]]