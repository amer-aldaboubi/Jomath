[[{"n":"1","s":[["F(x)=\\frac{3}{2}\\cdot\\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}}","قاعدة القوة: نضيف <span class=m dir=ltr>1</span> إلى الأس ونقسم على الأس الجديد"],["F(x)=x^{\\frac{3}{2}}","بالتبسيط"],["F'(x)=\\frac{3}{2}x^{\\frac{1}{2}}=f(x)","تحقُّق بالاشتقاق"]],"a":"<span class=\"tx\" data-t=\"F(x)=x^{\\frac{3}{2}}\"></span> (أو <span class=\"tx\" data-t=\"x^{\\frac{3}{2}}+C\"></span> لأي ثابت <span class=\"tx\" data-t=\"C\"></span>)","o":""},{"n":"2","s":[["F(x)=-\\frac{x^{-1}}{-1}","قاعدة القوة: نضيف <span class=m dir=ltr>1</span> إلى الأس ونقسم على الأس الجديد"],["F(x)=x^{-1}=\\frac{1}{x}","بالتبسيط"],["F'(x)=-x^{-2}=f(x)","تحقُّق بالاشتقاق"]],"a":"<span class=\"tx\" data-t=\"F(x)=\\frac{1}{x}\"></span> (أو <span class=\"tx\" data-t=\"\\frac{1}{x}+C\"></span>)","o":""},{"n":"3","s":[["F(x)=-5x","الاقتران الأصلي للثابت <span class=\"tx\" data-t=\"k\"></span> هو <span class=\"tx\" data-t=\"kx\"></span>"],["F'(x)=-5=f(x)","تحقُّق"]],"a":"<span class=\"tx\" data-t=\"F(x)=-5x\"></span> (أو <span class=\"tx\" data-t=\"-5x+C\"></span>)","o":""},{"n":"4","s":[["F(x)=6\\cdot\\frac{x^{6}}{6}","قاعدة القوة: نضيف <span class=m dir=ltr>1</span> إلى الأس ونقسم على الأس الجديد"],["F(x)=x^{6}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"F(x)=x^{6}\"></span> (أو <span class=\"tx\" data-t=\"x^{6}+C\"></span>)","o":""}],[{"n":"5","s":[["\\int 6x\\,dx=6\\cdot\\frac{x^{2}}{2}+C","قاعدة القوة"],["=3x^{2}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"3x^{2}+C\"></span>","o":""},{"n":"6","s":[["\\int(4x+2)\\,dx=4\\cdot\\frac{x^{2}}{2}+2x+C","تكامل المجموع <span class=m dir=ltr>=</span> مجموع التكاملات"],["=2x^{2}+2x+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2x^{2}+2x+C\"></span>","o":""},{"n":"7","s":[["\\int 2x^{4}\\,dx=2\\cdot\\frac{x^{5}}{5}+C","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{5}+C\"></span>","o":""},{"n":"8","s":[["\\int\\frac{5}{x^{3}}\\,dx=\\int 5x^{-3}\\,dx","بكتابة المُكامَل على صورة قوة"],["=5\\cdot\\frac{x^{-2}}{-2}+C","قاعدة القوة"],["=-\\frac{5}{2x^{2}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{5}{2x^{2}}+C\"></span>","o":""},{"n":"9","s":[["\\int 2x^{\\frac{3}{2}}\\,dx=2\\cdot\\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}}+C","قاعدة القوة"],["=\\frac{4}{5}x^{\\frac{5}{2}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{4}{5}x^{\\frac{5}{2}}+C\"></span>","o":""},{"n":"10","s":[["\\int\\frac{10}{\\sqrt{x}}\\,dx=\\int 10x^{-\\frac{1}{2}}\\,dx","بكتابة الجذر على صورة أس"],["=10\\cdot\\frac{x^{\\frac{1}{2}}}{\\frac{1}{2}}+C","قاعدة القوة"],["=20\\sqrt{x}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"20\\sqrt{x}+C\"></span>","o":""},{"n":"11","s":[["\\int x^{2}(x-8)\\,dx=\\int(x^{3}-8x^{2})\\,dx","بفك الأقواس (خاصية التوزيع)"],["=\\frac{x^{4}}{4}-\\frac{8x^{3}}{3}+C","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^{4}}{4}-\\frac{8}{3}x^{3}+C\"></span>","o":""},{"n":"12","s":[["\\int\\left(x^{2}-\\frac{3}{2}x^{\\frac{1}{2}}+x^{-\\frac{4}{3}}\\right)dx","بكتابة <span class=\"tx\" data-t=\"\\sqrt{x}=x^{\\frac{1}{2}}\"></span>"],["=\\frac{x^{3}}{3}-\\frac{3}{2}\\cdot\\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}}+\\frac{x^{-\\frac{1}{3}}}{-\\frac{1}{3}}+C","قاعدة القوة لكل حد"],["=\\frac{x^{3}}{3}-x^{\\frac{3}{2}}-3x^{-\\frac{1}{3}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^{3}}{3}-x^{\\frac{3}{2}}-\\frac{3}{\\sqrt[3]{x}}+C\"></span>","o":""}],[{"n":"13","s":[["\\frac{4x^{3}-2}{x^{3}}=4-2x^{-3}","بقسمة كل حد في البسط على المقام"],["\\int(4-2x^{-3})\\,dx=4x-2\\cdot\\frac{x^{-2}}{-2}+C","قاعدة القوة"],["=4x+\\frac{1}{x^{2}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"4x+\\frac{1}{x^{2}}+C\"></span>","o":""},{"n":"14","s":[["\\frac{x^{2}-1}{x-1}=\\frac{(x-1)(x+1)}{x-1}=x+1,\\ x\\ne 1","بتحليل الفرق بين مربعين والاختصار"],["\\int(x+1)\\,dx=\\frac{x^{2}}{2}+x+C","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^{2}}{2}+x+C\"></span>","o":""},{"n":"15","s":[["\\left(\\frac{x^{2}+1}{x^{2}}\\right)^{2}=\\left(1+x^{-2}\\right)^{2}","بقسمة كل حد على <span class=\"tx\" data-t=\"x^{2}\"></span>"],["=1+2x^{-2}+x^{-4}","بفك مربع المجموع"],["\\int(1+2x^{-2}+x^{-4})\\,dx=x+2\\cdot\\frac{x^{-1}}{-1}+\\frac{x^{-3}}{-3}+C","قاعدة القوة"],["=x-\\frac{2}{x}-\\frac{1}{3x^{3}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"x-\\frac{2}{x}-\\frac{1}{3x^{3}}+C\"></span>","o":""},{"n":"16","s":[["x\\sqrt{x}=x^{1}\\cdot x^{\\frac{1}{2}}=x^{\\frac{3}{2}}","بجمع الأسس عند ضرب القوى"],["\\int x^{\\frac{3}{2}}\\,dx=\\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}}+C","قاعدة القوة"],["=\\frac{2}{5}x^{\\frac{5}{2}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{\\frac{5}{2}}+C\"></span>","o":""},{"n":"17","s":[["\\frac{x^{2}-1}{\\sqrt[3]{x}}=x^{2}x^{-\\frac{1}{3}}-x^{-\\frac{1}{3}}=x^{\\frac{5}{3}}-x^{-\\frac{1}{3}}","بقسمة كل حد على <span class=\"tx\" data-t=\"x^{\\frac{1}{3}}\"></span>"],["\\int\\left(x^{\\frac{5}{3}}-x^{-\\frac{1}{3}}\\right)dx=\\frac{x^{\\frac{8}{3}}}{\\frac{8}{3}}-\\frac{x^{\\frac{2}{3}}}{\\frac{2}{3}}+C","قاعدة القوة"],["=\\frac{3}{8}x^{\\frac{8}{3}}-\\frac{3}{2}x^{\\frac{2}{3}}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{8}x^{\\frac{8}{3}}-\\frac{3}{2}x^{\\frac{2}{3}}+C\"></span>","o":""},{"n":"18","s":[["(x-1)(x+1)=x^{2}-1","الفرق بين مربعين"],["(x^{2}-1)(x-3)=x^{3}-3x^{2}-x+3","بالتوزيع"],["\\int(x^{3}-3x^{2}-x+3)\\,dx=\\frac{x^{4}}{4}-x^{3}-\\frac{x^{2}}{2}+3x+C","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^{4}}{4}-x^{3}-\\frac{x^{2}}{2}+3x+C\"></span>","o":""}],[{"n":"19","s":[["\\int(x+7)^{4}\\,dx=\\frac{(x+7)^{5}}{1\\times 5}+C","قاعدة <span class=\"tx\" data-t=\"\\int(ax+b)^{n}dx=\\frac{(ax+b)^{n+1}}{a(n+1)}+C\"></span> حيث <span class=\"tx\" data-t=\"a=1\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{(x+7)^{5}}{5}+C\"></span>","o":""},{"n":"20","s":[["\\int 3(10x+1)^{-2}\\,dx","بكتابة المُكامَل على صورة قوة"],["=3\\cdot\\frac{(10x+1)^{-1}}{10\\times(-1)}+C","قاعدة <span class=\"tx\" data-t=\"\\int(ax+b)^{n}dx=\\frac{(ax+b)^{n+1}}{a(n+1)}+C\"></span>"],["=-\\frac{3}{10(10x+1)}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{3}{10(10x+1)}+C\"></span>","o":""},{"n":"21","s":[["\\int 2(10x+5)^{-\\frac{1}{2}}\\,dx","بكتابة الجذر على صورة أس"],["=2\\cdot\\frac{(10x+5)^{\\frac{1}{2}}}{10\\times\\frac{1}{2}}+C","قاعدة <span class=\"tx\" data-t=\"\\int(ax+b)^{n}dx=\\frac{(ax+b)^{n+1}}{a(n+1)}+C\"></span>"],["=\\frac{2}{5}\\sqrt{10x+5}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}\\sqrt{10x+5}+C\"></span>","o":""}],[{"n":"22","s":[["y^{2}=(2x+5)^{\\frac{2}{3}}","لأن <span class=\"tx\" data-t=\"y=(2x+5)^{\\frac{1}{3}}\"></span>"],["\\int(2x+5)^{\\frac{2}{3}}\\,dx=\\frac{(2x+5)^{\\frac{5}{3}}}{2\\times\\frac{5}{3}}+C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^{n}\"></span>"],["=\\frac{3}{10}(2x+5)^{\\frac{5}{3}}+C=\\frac{3}{10}y^{5}+C","بالتبسيط، <span class=\"tx\" data-t=\"(2x+5)^{\\frac{5}{3}}=y^{5}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\int y^{2}dx=\\frac{3}{10}(2x+5)^{\\frac{5}{3}}+C=\\frac{3}{10}y^{5}+C\"></span>","o":""},{"n":"23","s":[["\\int y\\,dx=\\int(2x+5)^{\\frac{1}{3}}\\,dx","بالتعويض عن <span class=\"tx\" data-t=\"y\"></span>"],["=\\frac{(2x+5)^{\\frac{4}{3}}}{2\\times\\frac{4}{3}}+C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^{n}\"></span>"],["=\\frac{3}{8}(2x+5)^{\\frac{4}{3}}+C","بالتبسيط"],["=\\frac{3}{8}\\left((2x+5)^{\\frac{1}{3}}\\right)^{4}+C=\\frac{3}{8}y^{4}+C","لأن <span class=\"tx\" data-t=\"(2x+5)^{\\frac{1}{3}}=y\"></span>"]],"a":"تم الإثبات: <span class=\"tx\" data-t=\"\\int y\\,dx=\\frac{3}{8}y^{4}+C\"></span>","o":""}],[{"n":"24","s":[["\\frac{x^{3}-1}{x^{2}}=x-x^{-2}","بقسمة كل حد على <span class=\"tx\" data-t=\"x^{2}\"></span>"],["\\int(x-x^{-2})\\,dx=\\frac{x^{2}}{2}-\\frac{x^{-1}}{-1}+C","قاعدة القوة"],["=\\frac{x^{2}}{2}+\\frac{1}{x}+C","بالتبسيط"]],"a":"الإجابة <span class=m dir=ltr>b</span>: <span class=\"tx\" data-t=\"\\frac{x^{2}}{2}+\\frac{1}{x}+C\"></span>","o":""}],[{"n":"25","s":[["\\int f(x)g(x)\\,dx\\ne\\int f(x)\\,dx\\times\\int g(x)\\,dx","الخطأ: تكامل حاصل الضرب لا يساوي حاصل ضرب التكاملين"],["(2x+1)(x-1)=2x^{2}-x-1","الصحيح: نفك الأقواس أولًا"],["\\int(2x^{2}-x-1)\\,dx=\\frac{2x^{3}}{3}-\\frac{x^{2}}{2}-x+C","قاعدة القوة"]],"a":"الخطأ أن عامرًا كامل كل عامل وحده ثم ضرب الناتجين، والصحيح: <span class=\"tx\" data-t=\"\\frac{2}{3}x^{3}-\\frac{1}{2}x^{2}-x+C\"></span>","o":""}],[{"n":"26","s":[["2x^{2}-5x+3=(2x-3)(x-1)","بتحليل العبارة التربيعية"],["\\frac{(2x-3)^{3}(2x-3)(x-1)}{x-1}=(2x-3)^{4},\\ x\\ne 1","بالاختصار"],["\\int(2x-3)^{4}\\,dx=\\frac{(2x-3)^{5}}{2\\times 5}+C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^{n}\"></span>"],["=\\frac{(2x-3)^{5}}{10}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{(2x-3)^{5}}{10}+C\"></span>","o":""}],[{"n":"27","s":[["\\int\\left(\\frac{P}{2}x^{-2}+Q\\right)dx=\\frac{P}{2}\\cdot\\frac{x^{-1}}{-1}+Qx+C","قاعدة القوة"],["=-\\frac{P}{2x}+Qx+C","بالتبسيط"],["-\\frac{P}{2x}+Qx+C=\\frac{2}{x}+10x+C","بمساواة الناتج بالمعطى"],["-\\frac{P}{2}=2\\Rightarrow P=-4,\\quad Q=10","بمقارنة المعاملات"]],"a":"<span class=\"tx\" data-t=\"P=-4\"></span>، <span class=\"tx\" data-t=\"Q=10\"></span>","o":"التبرير: الاقترانان متساويان لكل <span class=\"tx\" data-t=\"x\\ne0\"></span>، فتتساوى معاملات <span class=\"tx\" data-t=\"\\frac{1}{x}\"></span> ومعاملات <span class=\"tx\" data-t=\"x\"></span>."}],[{"n":"2","s":[["x\\sqrt{3x} = \\sqrt{3}\\,x\\cdot x^{\\frac{1}{2}} = \\sqrt{3}\\,x^{\\frac{3}{2}}","بتبسيط المُكامَل"],["\\int \\sqrt{3}\\,x^{\\frac{3}{2}}\\,dx = \\sqrt{3}\\cdot\\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}} + C","قاعدة تكامل اقتران القوة"],["= \\frac{2\\sqrt{3}}{5}x^{\\frac{5}{2}} + C","بالتبسيط"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"\\frac{2\\sqrt{3}}{5}x^{\\frac{5}{2}} + C\"></span>","o":""}],[{"n":"14","s":[["\\int(8x - 10x^2)\\,dx = \\frac{8x^2}{2} - \\frac{10x^3}{3} + C","قاعدة تكامل اقتران القوة"],["= 4x^2 - \\frac{10}{3}x^3 + C",""]],"a":"<span class=\"tx\" data-t=\"4x^2 - \\frac{10}{3}x^3 + C\"></span>","o":""},{"n":"15","s":[["\\int 3x^{-\\frac{1}{2}}\\,dx = 3\\cdot\\frac{x^{\\frac{1}{2}}}{\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= 6x^{\\frac{1}{2}} + C = 6\\sqrt{x} + C",""]],"a":"<span class=\"tx\" data-t=\"6\\sqrt{x} + C\"></span>","o":""},{"n":"16","s":[["\\frac{4 + 2\\sqrt{x}}{x^2} = 4x^{-2} + 2x^{-\\frac{3}{2}}","بتوزيع المقام"],["\\int(4x^{-2} + 2x^{-\\frac{3}{2}})\\,dx = \\frac{4x^{-1}}{-1} + \\frac{2x^{-\\frac{1}{2}}}{-\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{4}{x} - \\frac{4}{\\sqrt{x}} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{4}{x} - \\frac{4}{\\sqrt{x}} + C\"></span>","o":""},{"n":"17","s":[["\\frac{4 - x^2}{2 + x} = \\frac{(2 - x)(2 + x)}{2 + x} = 2 - x","بتحليل الفرق بين مربعين والاختصار"],["\\int(2 - x)\\,dx = 2x - \\frac{x^2}{2} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"2x - \\frac{x^2}{2} + C\"></span>","o":""},{"n":"18","s":[["\\int(ax + b)^n\\,dx = \\frac{(ax + b)^{n+1}}{a(n+1)} + C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^n\"></span>"],["\\int(2x - 3)^5\\,dx = \\frac{(2x - 3)^6}{2 \\times 6} + C","<span class=\"tx\" data-t=\"a = 2,\\; n = 5\"></span>"],["= \\frac{(2x - 3)^6}{12} + C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{(2x - 3)^6}{12} + C\"></span>","o":""},{"n":"19","s":[["\\int(x + 1)^{\\frac{1}{2}}\\,dx = \\frac{(x + 1)^{\\frac{3}{2}}}{1 \\times \\frac{3}{2}} + C","قاعدة تكامل <span class=\"tx\" data-t=\"(ax+b)^n\"></span> حيث <span class=\"tx\" data-t=\"a = 1\"></span>"],["= \\frac{2}{3}(x + 1)^{\\frac{3}{2}} + C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}(x + 1)^{\\frac{3}{2}} + C = \\frac{2}{3}\\sqrt{(x+1)^3} + C\"></span>","o":""},{"n":"20","s":[["\\frac{x^2 + 3x - 2}{\\sqrt{x}} = x^{\\frac{3}{2}} + 3x^{\\frac{1}{2}} - 2x^{-\\frac{1}{2}}","بتوزيع المقام"],["\\int = \\frac{2}{5}x^{\\frac{5}{2}} + 3\\cdot\\frac{2}{3}x^{\\frac{3}{2}} - 2\\cdot 2x^{\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= \\frac{2}{5}x^{\\frac{5}{2}} + 2x^{\\frac{3}{2}} - 4\\sqrt{x} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{\\frac{5}{2}} + 2x^{\\frac{3}{2}} - 4\\sqrt{x} + C\"></span>","o":""},{"n":"21","s":[["(x^3 - 2x^2)\\cdot\\frac{1}{x - 2} = \\frac{x^2(x - 2)}{x - 2} = x^2,\\; x \\ne 2","بإخراج <span class=\"tx\" data-t=\"x^2\"></span> عاملًا مشتركًا والاختصار"],["\\int x^2\\,dx = \\frac{x^3}{3} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{3} + C\"></span>","o":""},{"n":"22","s":[["\\sqrt{x^3} - \\frac{1}{2\\sqrt[3]{x}} + \\sqrt{2} = x^{\\frac{3}{2}} - \\frac{1}{2}x^{-\\frac{1}{3}} + \\sqrt{2}","بكتابة الجذور على صورة أُسس"],["\\int = \\frac{2}{5}x^{\\frac{5}{2}} - \\frac{1}{2}\\cdot\\frac{3}{2}x^{\\frac{2}{3}} + \\sqrt{2}\\,x + C","قاعدة تكامل اقتران القوة، و<span class=\"tx\" data-t=\"\\sqrt{2}\"></span> ثابت"],["= \\frac{2}{5}x^{\\frac{5}{2}} - \\frac{3}{4}x^{\\frac{2}{3}} + \\sqrt{2}\\,x + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{\\frac{5}{2}} - \\frac{3}{4}x^{\\frac{2}{3}} + \\sqrt{2}\\,x + C\"></span>","o":""}],[{"n":"1","s":[["\\int(5x - 1)\\,dx = \\frac{5x^2}{2} - x + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{2}x^2 - x + C\"></span>","o":""},{"n":"2","s":[["\\int 2x^{-4}\\,dx = \\frac{2x^{-3}}{-3} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{2}{3x^3} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{2}{3x^3} + C\"></span>","o":""},{"n":"3","s":[["\\int(6x^2 - 4x)\\,dx = \\frac{6x^3}{3} - \\frac{4x^2}{2} + C","قاعدة تكامل اقتران القوة"],["= 2x^3 - 2x^2 + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2x^3 - 2x^2 + C\"></span>","o":""},{"n":"4","s":[["\\int(3 - x - 2x^5)\\,dx = 3x - \\frac{x^2}{2} - \\frac{2x^6}{6} + C","قاعدة تكامل اقتران القوة"],["= 3x - \\frac{x^2}{2} - \\frac{x^6}{3} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"3x - \\frac{x^2}{2} - \\frac{x^6}{3} + C\"></span>","o":""},{"n":"5","s":[["\\int(x^{-2} + x^{\\frac{5}{2}})\\,dx = \\frac{x^{-1}}{-1} + \\frac{x^{\\frac{7}{2}}}{\\frac{7}{2}} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{1}{x} + \\frac{2}{7}x^{\\frac{7}{2}} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{x} + \\frac{2}{7}x^{\\frac{7}{2}} + C\"></span>","o":""},{"n":"6","s":[["3x^2 - \\frac{2}{x^2} = 3x^2 - 2x^{-2}","بكتابة المُكامَل على صورة قوى"],["\\int(3x^2 - 2x^{-2})\\,dx = x^3 - \\frac{2x^{-1}}{-1} + C = x^3 + \\frac{2}{x} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"x^3 + \\frac{2}{x} + C\"></span>","o":""},{"n":"7","s":[["\\int(3x^{-2} + 6x^{-\\frac{1}{2}} + x - 4)\\,dx = \\frac{3x^{-1}}{-1} + \\frac{6x^{\\frac{1}{2}}}{\\frac{1}{2}} + \\frac{x^2}{2} - 4x + C","قاعدة تكامل اقتران القوة"],["= -\\frac{3}{x} + 12\\sqrt{x} + \\frac{x^2}{2} - 4x + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{3}{x} + 12\\sqrt{x} + \\frac{x^2}{2} - 4x + C\"></span>","o":""},{"n":"8","s":[["\\int(10x^4 + 8x^{-3})\\,dx = \\frac{10x^5}{5} + \\frac{8x^{-2}}{-2} + C","قاعدة تكامل اقتران القوة"],["= 2x^5 - \\frac{4}{x^2} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2x^5 - \\frac{4}{x^2} + C\"></span>","o":""},{"n":"9","s":[["\\frac{2}{x^3} - 3\\sqrt{x} = 2x^{-3} - 3x^{\\frac{1}{2}}","بكتابة المُكامَل على صورة قوى"],["\\int = \\frac{2x^{-2}}{-2} - \\frac{3x^{\\frac{3}{2}}}{\\frac{3}{2}} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{1}{x^2} - 2x^{\\frac{3}{2}} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{x^2} - 2x^{\\frac{3}{2}} + C\"></span>","o":""},{"n":"10","s":[["8x^3 + 6x - \\frac{4}{\\sqrt{x}} = 8x^3 + 6x - 4x^{-\\frac{1}{2}}","بكتابة المُكامَل على صورة قوى"],["\\int = 2x^4 + 3x^2 - \\frac{4x^{\\frac{1}{2}}}{\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= 2x^4 + 3x^2 - 8\\sqrt{x} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2x^4 + 3x^2 - 8\\sqrt{x} + C\"></span>","o":""},{"n":"11","s":[["\\frac{7}{x^2} + \\sqrt[3]{x^4} = 7x^{-2} + x^{\\frac{4}{3}}","بكتابة المُكامَل على صورة قوى"],["\\int = \\frac{7x^{-1}}{-1} + \\frac{x^{\\frac{7}{3}}}{\\frac{7}{3}} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{7}{x} + \\frac{3}{7}x^{\\frac{7}{3}} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{7}{x} + \\frac{3}{7}x^{\\frac{7}{3}} + C\"></span>","o":""},{"n":"12","s":[["\\frac{x^2}{3} + \\frac{3}{x^2} = \\frac{1}{3}x^2 + 3x^{-2}","بكتابة المُكامَل على صورة قوى"],["\\int = \\frac{x^3}{9} + \\frac{3x^{-1}}{-1} + C = \\frac{x^3}{9} - \\frac{3}{x} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{9} - \\frac{3}{x} + C\"></span>","o":""}],[{"n":"13","s":[["\\frac{4 + 2\\sqrt{x}}{x^2} = 4x^{-2} + 2x^{-\\frac{3}{2}}","بتوزيع المقام"],["\\int = \\frac{4x^{-1}}{-1} + \\frac{2x^{-\\frac{1}{2}}}{-\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{4}{x} - \\frac{4}{\\sqrt{x}} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{4}{x} - \\frac{4}{\\sqrt{x}} + C\"></span>","o":""},{"n":"14","s":[["\\frac{4 - x^2}{2 + x} = \\frac{(2 - x)(2 + x)}{2 + x} = 2 - x","بتحليل الفرق بين مربعين والاختصار"],["\\int(2 - x)\\,dx = 2x - \\frac{x^2}{2} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"2x - \\frac{x^2}{2} + C\"></span>","o":""},{"n":"15","s":[["\\frac{x^2 - 1}{x^2} = 1 - x^{-2}","بتوزيع المقام"],["\\int(1 - x^{-2})\\,dx = x - \\frac{x^{-1}}{-1} + C = x + \\frac{1}{x} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"x + \\frac{1}{x} + C\"></span>","o":""},{"n":"16","s":[["x\\sqrt{x} = x^{\\frac{3}{2}}","بقوانين الأُسس"],["\\int x^{\\frac{3}{2}}\\,dx = \\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}} + C = \\frac{2}{5}x^{\\frac{5}{2}} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{\\frac{5}{2}} + C\"></span>","o":""},{"n":"17","s":[["\\frac{x^2 - 64}{2x + 16} = \\frac{(x - 8)(x + 8)}{2(x + 8)} = \\frac{x - 8}{2}","بالتحليل والاختصار"],["\\int\\left(\\frac{1}{2}x - 4\\right)dx = \\frac{x^2}{4} - 4x + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^2}{4} - 4x + C\"></span>","o":""},{"n":"18","s":[["x^2(1 - x^3) = x^2 - x^5","بالتوزيع"],["\\int(x^2 - x^5)\\,dx = \\frac{x^3}{3} - \\frac{x^6}{6} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{3} - \\frac{x^6}{6} + C\"></span>","o":""},{"n":"19","s":[["(x + 4)^2 = x^2 + 8x + 16","بفك المربع"],["\\int(x^2 + 8x + 16)\\,dx = \\frac{x^3}{3} + 4x^2 + 16x + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{3} + 4x^2 + 16x + C\"></span> (أو <span class=\"tx\" data-t=\"\\frac{(x+4)^3}{3} + C\"></span>)","o":""},{"n":"20","s":[["\\frac{5 - x}{x^5} = 5x^{-5} - x^{-4}","بتوزيع المقام"],["\\int = \\frac{5x^{-4}}{-4} - \\frac{x^{-3}}{-3} + C","قاعدة تكامل اقتران القوة"],["= -\\frac{5}{4x^4} + \\frac{1}{3x^3} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{5}{4x^4} + \\frac{1}{3x^3} + C\"></span>","o":""},{"n":"21","s":[["\\frac{x^2 + 2x + 1}{x + 1} = \\frac{(x + 1)^2}{x + 1} = x + 1","بالتحليل والاختصار"],["\\int(x + 1)\\,dx = \\frac{x^2}{2} + x + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^2}{2} + x + C\"></span>","o":""},{"n":"22","s":[["x(x + 1)^2 = x(x^2 + 2x + 1) = x^3 + 2x^2 + x","بفك المربع والتوزيع"],["\\int(x^3 + 2x^2 + x)\\,dx = \\frac{x^4}{4} + \\frac{2x^3}{3} + \\frac{x^2}{2} + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^4}{4} + \\frac{2x^3}{3} + \\frac{x^2}{2} + C\"></span>","o":""},{"n":"23","s":[["\\frac{(x + 3)^2}{\\sqrt{x}} = \\frac{x^2 + 6x + 9}{x^{\\frac{1}{2}}} = x^{\\frac{3}{2}} + 6x^{\\frac{1}{2}} + 9x^{-\\frac{1}{2}}","بفك المربع وتوزيع المقام"],["\\int = \\frac{2}{5}x^{\\frac{5}{2}} + 6\\cdot\\frac{2}{3}x^{\\frac{3}{2}} + 9\\cdot 2x^{\\frac{1}{2}} + C","قاعدة تكامل اقتران القوة"],["= \\frac{2}{5}x^{\\frac{5}{2}} + 4x^{\\frac{3}{2}} + 18\\sqrt{x} + C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}x^{\\frac{5}{2}} + 4x^{\\frac{3}{2}} + 18\\sqrt{x} + C\"></span>","o":""},{"n":"24","s":[["(x - 5)(x + 5) = x^2 - 25","الفرق بين مربعين"],["\\int(x^2 - 25)\\,dx = \\frac{x^3}{3} - 25x + C","قاعدة تكامل اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{3} - 25x + C\"></span>","o":""}]]