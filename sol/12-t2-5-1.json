[[{"n":"1","s":[["\\int (e^{2x-3}-x^{1/2})\\,dx","بكتابة الجذر في صورة أُسّ"],["=\\frac{1}{2}e^{2x-3}-\\frac{x^{3/2}}{3/2}+C","تكامل <span class=\"tx\" data-t=\"e^{ax+b}\"></span> وقاعدة القوة"],["=\\frac{1}{2}e^{2x-3}-\\frac{2}{3}x^{3/2}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}e^{2x-3}-\\frac{2}{3}x^{3/2}+C\"></span>","o":"","k":[{"e":"C - 2*x^(3/2)/3 + exp(2*x - 3)/2","a":null}]},{"n":"2","s":[["\\int (e^{0.5x}-3e^{-0.5x})\\,dx","لأن <span class=\"tx\" data-t=\"\\frac{1}{e^{0.5x}}=e^{-0.5x}\"></span>"],["=\\frac{e^{0.5x}}{0.5}-\\frac{3e^{-0.5x}}{-0.5}+C","<span class=\"tx\" data-t=\"\\int e^{ax}\\,dx=\\frac{1}{a}e^{ax}+C\"></span>"],["=2e^{0.5x}+6e^{-0.5x}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2e^{0.5x}+6e^{-0.5x}+C\"></span>","o":"","k":[{"e":"C + 2*e^(0.5*x) + 6/e^(0.5*x)","a":true}]},{"n":"3","s":[["\\int 4\\sin 5x\\,dx=-\\frac{4}{5}\\cos 5x","<span class=\"tx\" data-t=\"\\int \\sin ax\\,dx=-\\frac{1}{a}\\cos ax\"></span>"],["\\int 5\\cos 4x\\,dx=\\frac{5}{4}\\sin 4x","<span class=\"tx\" data-t=\"\\int \\cos ax\\,dx=\\frac{1}{a}\\sin ax\"></span>"],["\\int(4\\sin 5x-5\\cos 4x)\\,dx=-\\frac{4}{5}\\cos 5x-\\frac{5}{4}\\sin 4x+C","بجمع النتيجتين"]],"a":"<span class=\"tx\" data-t=\"-\\frac{4}{5}\\cos 5x-\\frac{5}{4}\\sin 4x+C\"></span>","o":"","k":[{"e":"C - 5*sin(4*x)/4 - 4*cos(5*x)/5","a":null}]}],[{"n":"4","s":[["\\int 3\\sec x\\tan x\\,dx=3\\sec x","<span class=\"tx\" data-t=\"\\int \\sec x\\tan x\\,dx=\\sec x\"></span>"],["\\int \\frac{2}{5x}\\,dx=\\frac{2}{5}\\ln|x|","<span class=\"tx\" data-t=\"\\int\\frac{1}{x}\\,dx=\\ln|x|\"></span>"],["\\int\\left(3\\sec x\\tan x-\\frac{2}{5x}\\right)dx=3\\sec x-\\frac{2}{5}\\ln|x|+C","بالجمع"]],"a":"<span class=\"tx\" data-t=\"3\\sec x-\\frac{2}{5}\\ln|x|+C\"></span>","o":""},{"n":"5","s":[["\\left(e^{x/2}-e^{-x/2}\\right)^2=e^{x}-2+e^{-x}","بفك المربع، لأن <span class=\"tx\" data-t=\"e^{x/2}\\cdot e^{-x/2}=1\"></span>"],["\\int (e^{x}-2+e^{-x})\\,dx","التكامل بعد التبسيط"],["=e^{x}-2x-e^{-x}+C","<span class=\"tx\" data-t=\"\\int e^{-x}dx=-e^{-x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"e^{x}-2x-e^{-x}+C\"></span>","o":"","k":[{"e":"C - 2*x + exp(x) - exp(-x)","a":null}]},{"n":"6","s":[["\\int \\sin(5-3x)\\,dx=-\\frac{1}{-3}\\cos(5-3x)=\\frac{1}{3}\\cos(5-3x)","تكامل <span class=\"tx\" data-t=\"\\sin(ax+b)\"></span> حيث <span class=\"tx\" data-t=\"a=-3\"></span>"],["\\int(2+4x^2)\\,dx=2x+\\frac{4}{3}x^3","قاعدة القوة"],["=\\frac{1}{3}\\cos(5-3x)+2x+\\frac{4}{3}x^3+C","بالجمع"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\\cos(5-3x)+2x+\\frac{4}{3}x^3+C\"></span>","o":"","k":[{"e":"C + 4*x^3/3 + 2*x + cos(3*x - 5)/3","a":null}]}],[{"n":"7","s":[["(e^x+1)^2=e^{2x}+2e^x+1","بفك المربع"],["\\int(e^{2x}+2e^x+1)\\,dx=\\frac{1}{2}e^{2x}+2e^x+x+C","بتكامل كل حدّ"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}e^{2x}+2e^x+x+C\"></span>","o":"","k":[{"e":"C + 2*e^x + x + exp(2*x)/2","a":null}]},{"n":"8","s":[["\\int e^{4-x}dx=-e^{4-x}","<span class=\"tx\" data-t=\"a=-1\"></span>"],["\\int \\sin(4-x)\\,dx=\\cos(4-x)","<span class=\"tx\" data-t=\"-\\frac{1}{-1}\\cos(4-x)\"></span>"],["\\int \\cos(4-x)\\,dx=-\\sin(4-x)","<span class=\"tx\" data-t=\"\\frac{1}{-1}\\sin(4-x)\"></span>"],["=-e^{4-x}+\\cos(4-x)-\\sin(4-x)+C","بالجمع"]],"a":"<span class=\"tx\" data-t=\"-e^{4-x}+\\cos(4-x)-\\sin(4-x)+C\"></span>","o":"","k":[{"e":"C - exp(4 - x) + sin(x - 4) + cos(x - 4)","a":null}]},{"n":"9","s":[["\\frac{x^4-6}{2x}=\\frac{1}{2}x^3-\\frac{3}{x}","بقسمة كل حدّ على <span class=\"tx\" data-t=\"2x\"></span>"],["\\int\\left(\\frac{1}{2}x^3-\\frac{3}{x}\\right)dx=\\frac{x^4}{8}-3\\ln|x|+C","قاعدة القوة و <span class=\"tx\" data-t=\"\\int\\frac{1}{x}dx=\\ln|x|\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{x^4}{8}-3\\ln|x|+C\"></span>","o":"","k":[{"e":"C + x^4/8 - 3*log(Abs(x))","a":null}]},{"n":"10","s":[["\\int 3\\csc^2(3x+2)\\,dx=-\\frac{3}{3}\\cot(3x+2)=-\\cot(3x+2)","<span class=\"tx\" data-t=\"\\int\\csc^2(ax+b)dx=-\\frac{1}{a}\\cot(ax+b)\"></span>"],["\\int\\frac{5}{x}\\,dx=5\\ln|x|",""],["=-\\cot(3x+2)+5\\ln|x|+C","بالجمع"]],"a":"<span class=\"tx\" data-t=\"-\\cot(3x+2)+5\\ln|x|+C\"></span>","o":""}],[{"n":"11","s":[["\\frac{e^x+1}{e^x}=1+e^{-x}","بتوزيع المقام"],["\\int(1+e^{-x})\\,dx=x-e^{-x}+C",""]],"a":"<span class=\"tx\" data-t=\"x-e^{-x}+C\"></span>","o":"","k":[{"e":"C + x - exp(-x)","a":null}]},{"n":"12","s":[["\\frac{d}{dx}(e^x+4)=e^x","البسط مشتقة المقام"],["\\int\\frac{e^x}{e^x+4}\\,dx=\\ln(e^x+4)+C","<span class=\"tx\" data-t=\"\\int\\frac{f&#x27;(x)}{f(x)}dx=\\ln|f(x)|+C\"></span> و <span class=\"tx\" data-t=\"e^x+4&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln(e^x+4)+C\"></span>","o":"","k":[{"e":"C + log(exp(x) + 4)","a":null}]},{"n":"13","s":[["\\frac{d}{dx}(\\sin x\\cos x+4)=\\cos^2x-\\sin^2x=\\cos 2x","مشتقة المقام تساوي البسط"],["\\int\\frac{\\cos 2x}{\\sin x\\cos x+4}\\,dx=\\ln|\\sin x\\cos x+4|+C","<span class=\"tx\" data-t=\"\\int\\frac{f&#x27;}{f}dx=\\ln|f|+C\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln(\\sin x\\cos x+4)+C\"></span> (المقام موجب دائمًا)","o":"","k":[{"e":"C + log(sin(x)*cos(x) + 4)","a":null}]},{"n":"14","s":[["\\frac{d}{dx}\\left(5-\\frac{x}{3}\\right)=-\\frac{1}{3}","مشتقة المقام"],["\\int\\frac{dx}{5-\\frac{x}{3}}=-3\\int\\frac{-\\frac{1}{3}}{5-\\frac{x}{3}}\\,dx","بالضرب والقسمة على <span class=\"tx\" data-t=\"-\\frac{1}{3}\"></span>"],["=-3\\ln\\left|5-\\frac{x}{3}\\right|+C","<span class=\"tx\" data-t=\"\\int\\frac{f&#x27;}{f}dx=\\ln|f|\"></span>"]],"a":"<span class=\"tx\" data-t=\"-3\\ln\\left|5-\\frac{x}{3}\\right|+C\"></span>","o":"","k":[{"e":"C - 3*log(Abs(x/3 - 5))","a":null}]},{"n":"15","s":[["\\frac{1}{1-\\sin x}\\cdot\\frac{1+\\sin x}{1+\\sin x}=\\frac{1+\\sin x}{1-\\sin^2x}=\\frac{1+\\sin x}{\\cos^2x}","بالضرب في المرافق"],["=\\sec^2x+\\sec x\\tan x","بتوزيع المقام"],["\\int(\\sec^2x+\\sec x\\tan x)\\,dx=\\tan x+\\sec x+C",""]],"a":"<span class=\"tx\" data-t=\"\\tan x+\\sec x+C\"></span>","o":""},{"n":"16","s":[["\\sec^2x(1+e^x\\cos^2x)=\\sec^2x+e^x","لأن <span class=\"tx\" data-t=\"\\sec^2x\\cos^2x=1\"></span>"],["\\int(\\sec^2x+e^x)\\,dx=\\tan x+e^x+C",""]],"a":"<span class=\"tx\" data-t=\"\\tan x+e^x+C\"></span>","o":"","k":[{"e":"C + exp(x) + tan(x)","a":null}]}],[{"n":"17","s":[["\\int\\frac{2}{x}\\,dx=2\\ln|x|",""],["\\int 2^x\\,dx=\\frac{2^x}{\\ln 2}","<span class=\"tx\" data-t=\"\\int a^x dx=\\frac{a^x}{\\ln a}\"></span>"],["=2\\ln|x|-\\frac{2^x}{\\ln 2}+C",""]],"a":"<span class=\"tx\" data-t=\"2\\ln|x|-\\frac{2^x}{\\ln 2}+C\"></span>","o":"","k":[{"e":"-2^x/log(2) + C + 2*log(Abs(x))","a":null}]},{"n":"18","s":[["\\sin 3x\\cos 2x=\\frac{1}{2}(\\sin 5x+\\sin x)","<span class=\"tx\" data-t=\"\\sin A\\cos B=\\frac{1}{2}[\\sin(A+B)+\\sin(A-B)]\"></span>"],["\\int\\frac{1}{2}(\\sin 5x+\\sin x)\\,dx=\\frac{1}{2}\\left(-\\frac{1}{5}\\cos 5x-\\cos x\\right)+C",""],["=-\\frac{1}{10}\\cos 5x-\\frac{1}{2}\\cos x+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{10}\\cos 5x-\\frac{1}{2}\\cos x+C\"></span>","o":"","k":[{"e":"C - cos(x)/2 - cos(5*x)/10","a":null}]},{"n":"19","s":[["\\frac{d}{dx}(3x^2+9x-1)=6x+9=3(2x+3)","مشتقة المقام"],["\\int\\frac{2x+3}{3x^2+9x-1}\\,dx=\\frac{1}{3}\\int\\frac{6x+9}{3x^2+9x-1}\\,dx",""],["=\\frac{1}{3}\\ln|3x^2+9x-1|+C","<span class=\"tx\" data-t=\"\\int\\frac{f&#x27;}{f}dx=\\ln|f|\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\\ln|3x^2+9x-1|+C\"></span>","o":"","k":[{"e":"C + log(Abs(3*x^2 + 9*x - 1))/3","a":null}]},{"n":"20","s":[["\\frac{x^2+x+1}{x^2+1}=1+\\frac{x}{x^2+1}","بالقسمة"],["\\int\\frac{x}{x^2+1}\\,dx=\\frac{1}{2}\\int\\frac{2x}{x^2+1}\\,dx=\\frac{1}{2}\\ln(x^2+1)",""],["=x+\\frac{1}{2}\\ln(x^2+1)+C",""]],"a":"<span class=\"tx\" data-t=\"x+\\frac{1}{2}\\ln(x^2+1)+C\"></span>","o":"","k":[{"e":"C + x + log(x^2 + 1)/2","a":null}]},{"n":"21","s":[["\\frac{1+\\cos x}{\\sin^2x}=\\csc^2x+\\csc x\\cot x","بتوزيع المقام"],["\\sin^2x\\csc x=\\sin x","لأن <span class=\"tx\" data-t=\"\\csc x=\\frac{1}{\\sin x}\"></span>"],["\\int(\\csc^2x+\\csc x\\cot x+\\sin x)\\,dx=-\\cot x-\\csc x-\\cos x+C",""]],"a":"<span class=\"tx\" data-t=\"-\\cot x-\\csc x-\\cos x+C\"></span>","o":""}],[{"n":"22","s":[["(\\sec x+\\tan x)^2=\\sec^2x+2\\sec x\\tan x+\\tan^2x","بفك المربع"],["=2\\sec^2x+2\\sec x\\tan x-1","<span class=\"tx\" data-t=\"\\tan^2x=\\sec^2x-1\"></span>"],["\\int(2\\sec^2x+2\\sec x\\tan x-1)\\,dx=2\\tan x+2\\sec x-x+C",""]],"a":"<span class=\"tx\" data-t=\"2\\tan x+2\\sec x-x+C\"></span>","o":""},{"n":"23","s":[["\\frac{d}{dx}(e^x+e^{-x})=e^x-e^{-x}","البسط مشتقة المقام"],["\\int\\frac{e^x-e^{-x}}{e^x+e^{-x}}\\,dx=\\ln(e^x+e^{-x})+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln(e^x+e^{-x})+C\"></span>","o":"","k":[{"e":"C + log(exp(x) + exp(-x))","a":null}]},{"n":"24","s":[["\\frac{d}{dx}(x^3-3)=3x^2",""],["\\int\\frac{x^2}{x^3-3}\\,dx=\\frac{1}{3}\\int\\frac{3x^2}{x^3-3}\\,dx=\\frac{1}{3}\\ln|x^3-3|+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\\ln|x^3-3|+C\"></span>","o":"","k":[{"e":"C + log(Abs(x^3 - 3))/3","a":null}]},{"n":"25","s":[["9\\cos^2x=\\frac{9}{2}(1+\\cos 2x),\\ \\sin^2x=\\frac{1}{2}(1-\\cos 2x)","متطابقات ضعف الزاوية"],["6\\sin x\\cos x=3\\sin 2x",""],["9\\cos^2x-\\sin^2x-6\\sin x\\cos x=4+5\\cos 2x-3\\sin 2x","بالتبسيط"],["\\int(4+5\\cos 2x-3\\sin 2x)\\,dx=4x+\\frac{5}{2}\\sin 2x+\\frac{3}{2}\\cos 2x+C",""]],"a":"<span class=\"tx\" data-t=\"4x+\\frac{5}{2}\\sin 2x+\\frac{3}{2}\\cos 2x+C\"></span>","o":"","k":[{"e":"C + 4*x + 5*sin(2*x)/2 + 3*cos(2*x)/2","a":null}]},{"n":"26","s":[["\\cos^4x-\\sin^4x=(\\cos^2x-\\sin^2x)(\\cos^2x+\\sin^2x)","فرق بين مربعين"],["=\\cos 2x\\cdot 1=\\cos 2x",""],["\\int\\cos 2x\\,dx=\\frac{1}{2}\\sin 2x+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\sin 2x+C\"></span>","o":"","k":[{"e":"C + sin(2*x)/2","a":null}]}],[{"n":"27","s":[["\\int_0^{\\pi}2\\cos\\tfrac{1}{2}x\\,dx=\\left[4\\sin\\tfrac{1}{2}x\\right]_0^{\\pi}",""],["=4\\sin\\frac{\\pi}{2}-4\\sin 0=4","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"28","s":[["|\\sin x|=\\sin x\\ (0\\le x\\le\\pi),\\quad |\\sin x|=-\\sin x\\ (\\pi\\le x\\le 2\\pi)","تعريف القيمة المطلقة"],["\\int_0^{\\pi}\\sin x\\,dx-\\int_{\\pi}^{2\\pi}\\sin x\\,dx=[-\\cos x]_0^{\\pi}-[-\\cos x]_{\\pi}^{2\\pi}",""],["=2-(-2)=4",""]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"29","s":[["\\int_1^e\\frac{8x}{x^2+1}\\,dx=4\\int_1^e\\frac{2x}{x^2+1}\\,dx=\\left[4\\ln(x^2+1)\\right]_1^e",""],["=4\\ln(e^2+1)-4\\ln 2=4\\ln\\frac{e^2+1}{2}",""]],"a":"<span class=\"tx\" data-t=\"4\\ln\\frac{e^2+1}{2}\\approx 5.735\"></span>","o":"","k":[{"e":"5.735","a":true}]},{"n":"30","s":[["\\sin 3x\\cos x=\\frac{1}{2}(\\sin 4x+\\sin 2x)","تحويل الضرب إلى جمع"],["\\int_0^{\\pi/6}\\tfrac{1}{2}(\\sin 4x+\\sin 2x)\\,dx=\\frac{1}{2}\\left[-\\frac{\\cos 4x}{4}-\\frac{\\cos 2x}{2}\\right]_0^{\\pi/6}",""],["=\\frac{1}{2}\\left[\\left(\\frac{1}{8}-\\frac{1}{4}\\right)-\\left(-\\frac{1}{4}-\\frac{1}{2}\\right)\\right]","<span class=\"tx\" data-t=\"\\cos\\frac{2\\pi}{3}=-\\frac{1}{2},\\ \\cos\\frac{\\pi}{3}=\\frac{1}{2}\"></span>"],["=\\frac{1}{2}\\cdot\\frac{5}{8}=\\frac{5}{16}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{16}\"></span>","o":"","k":[{"e":"5/16","a":null}]},{"n":"31","s":[["\\frac{\\cot^2x}{1+\\cot^2x}=\\frac{\\cot^2x}{\\csc^2x}=\\cos^2x=\\frac{1+\\cos 2x}{2}",""],["\\int_{\\pi/4}^{\\pi/3}\\frac{1+\\cos 2x}{2}\\,dx=\\left[\\frac{x}{2}+\\frac{\\sin 2x}{4}\\right]_{\\pi/4}^{\\pi/3}",""],["=\\left(\\frac{\\pi}{6}+\\frac{\\sqrt3}{8}\\right)-\\left(\\frac{\\pi}{8}+\\frac{1}{4}\\right)",""],["=\\frac{\\pi}{24}+\\frac{\\sqrt3}{8}-\\frac{1}{4}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{\\pi}{24}+\\frac{\\sqrt3}{8}-\\frac{1}{4}\\approx 0.0974\"></span>","o":"","k":[{"e":"0.0974","a":true}]},{"n":"32","s":[["\\int_0^3(x-5^x)\\,dx=\\left[\\frac{x^2}{2}-\\frac{5^x}{\\ln 5}\\right]_0^3",""],["=\\left(\\frac{9}{2}-\\frac{125}{\\ln 5}\\right)-\\left(0-\\frac{1}{\\ln 5}\\right)=\\frac{9}{2}-\\frac{124}{\\ln 5}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{9}{2}-\\frac{124}{\\ln 5}\\approx -72.55\"></span>","o":"","k":[{"e":"-72.55","a":true}]}],[{"n":"33","s":[["A=\\int_2^4(e^{0.5x}-2)\\,dx","المنطقة فوق المحور <span class=\"tx\" data-t=\"x\"></span> بين <span class=\"tx\" data-t=\"x=2\"></span> و <span class=\"tx\" data-t=\"x=4\"></span> كما في الشكل"],["=\\left[2e^{0.5x}-2x\\right]_2^4",""],["=(2e^2-8)-(2e-4)=2e^2-2e-4",""]],"a":"<span class=\"tx\" data-t=\"2e^2-2e-4\\approx 5.34\"></span> وحدة مربعة","o":"","k":[{"e":"5.34","a":true}]}],[{"n":"34","s":[["\\int_a^{3a}\\left(2+\\frac{1}{x}\\right)dx=\\left[2x+\\ln x\\right]_a^{3a}",""],["=6a+\\ln 3a-2a-\\ln a=4a+\\ln 3",""],["4a+\\ln 3=\\ln 12\\Rightarrow 4a=\\ln 4",""],["a=\\frac{\\ln 4}{4}=\\frac{\\ln 2}{2}",""]],"a":"<span class=\"tx\" data-t=\"a=\\frac{\\ln 2}{2}\\approx 0.347\"></span>","o":"","k":[{"e":"0.347","a":true}]}],[{"n":"35","s":[["\\int_0^a\\frac{x}{x^2+a^2}\\,dx=\\frac{1}{2}\\left[\\ln(x^2+a^2)\\right]_0^a","البسط نصف مشتقة المقام"],["=\\frac{1}{2}\\left(\\ln 2a^2-\\ln a^2\\right)=\\frac{1}{2}\\ln 2",""],["=\\ln 2^{1/2}=\\ln\\sqrt2","خصائص اللوغاريتمات"]],"a":"<span class=\"tx\" data-t=\"\\ln\\sqrt2\"></span> وهو المطلوب","o":"","k":[{"e":"log(sqrt(2))","a":null}]}],[{"n":"36","s":[["\\int_1^a\\frac{4}{x}\\,dx=10",""],["[4\\ln x]_1^a=4\\ln a=10",""],["\\ln a=2.5\\Rightarrow a=e^{2.5}",""]],"a":"<span class=\"tx\" data-t=\"a=e^{2.5}\\approx 12.18\"></span>","o":"","k":[{"e":"12.18","a":true}]}],[{"n":"37","s":[["f(x)=\\int\\cos\\left(\\tfrac{1}{2}x+\\pi\\right)dx=2\\sin\\left(\\tfrac{1}{2}x+\\pi\\right)+C",""],["f(\\pi)=2\\sin\\frac{3\\pi}{2}+C=-2+C=3\\Rightarrow C=5",""],["f(0)=2\\sin\\pi+5=5",""]],"a":"<span class=\"tx\" data-t=\"f(0)=5\"></span>","o":"","k":[{"e":"5","a":null}]}],[{"n":"38","s":[["\\sin\\left(\\frac{\\pi}{2}-2x\\right)=\\cos 2x",""],["y=\\int\\cos 2x\\,dx=\\frac{1}{2}\\sin 2x+C",""],["1=\\frac{1}{2}\\sin\\frac{\\pi}{2}+C\\Rightarrow C=\\frac{1}{2}","بالتعويض <span class=\"tx\" data-t=\"x=\\frac{\\pi}{4},\\ y=1\