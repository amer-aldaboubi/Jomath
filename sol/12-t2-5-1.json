4","s":[["\\int_1^k\\frac{4}{2x-1}dx=\\left.2\\ln|2x-1|\\right|_1^k","<span class=\"tx\" data-t=\"\\int\\frac{1}{ax+b}dx=\\frac{1}{a}\\ln|ax+b|\"></span>"],["=2\\ln(2k-1)-2\\ln1=2\\ln(2k-1)","بالتعويض، و <span class=\"tx\" data-t=\"2k-1&gt;0\"></span> لأن <span class=\"tx\" data-t=\"k&gt;\\frac{1}{2}\"></span>"],["2\\ln(2k-1)=1\\Rightarrow\\ln(2k-1)=\\frac{1}{2}","بمساواة الناتج بـ <span class=m dir=ltr>1</span>"],["2k-1=e^{1/2}\\Rightarrow k=\\frac{1+\\sqrt e}{2}","بأخذ الأسّ للطرفين وحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"k=\\frac{1+\\sqrt e}{2}\\approx1.3244\"></span>","o":"","k":[{"e":"1.3244","a":true}]}],[{"n":"25","s":[["\\int_0^{\\ln a}(e^x+e^{-x})dx=\\left.(e^x-e^{-x})\\right|_0^{\\ln a}","بالتكامل"],["=\\left(a-\\frac{1}{a}\\right)-(1-1)=a-\\frac{1}{a}","لأن <span class=\"tx\" data-t=\"e^{\\ln a}=a\"></span>"],["a-\\frac{1}{a}=\\frac{48}{7}\\Rightarrow7a^2-48a-7=0","بالضرب في <span class=\"tx\" data-t=\"7a\"></span>"],["(7a+1)(a-7)=0\\Rightarrow a=7\\ \\text{أو}\\ a=-\\frac{1}{7}","بالتحليل"],["a=7","لأن <span class=\"tx\" data-t=\"a&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"a=7\"></span>","o":"","k":[{"e":"7","a":null}]}],[{"n":"26","s":[["2\\cos^20.5x=1+\\cos x","متطابقة: <span class=\"tx\" data-t=\"2\\cos^2\\theta=1+\\cos2\\theta\"></span>"],["f(x)=0\\Rightarrow x=\\pi","المنحنى يقطع المحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"\\pi\"></span> (من الشكل)"],["A=\\int_0^{\\pi}(1+\\cos x)dx=\\left.(x+\\sin x)\\right|_0^{\\pi}","المساحة فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["=(\\pi+0)-(0+0)=\\pi","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\pi\\approx3.14\"></span> وحدة مربعة","o":"","k":[{"e":"3.14","a":true}]}],[{"n":"27","s":[["f(x)=\\int(e^{-x}+x^2)dx=-e^{-x}+\\frac{x^3}{3}+C","بالتكامل"],["f(0)=4\\Rightarrow-1+0+C=4\\Rightarrow C=5","بتعويض النقطة <span class=\"tx\" data-t=\"(0,4)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=-e^{-x}+\\frac{x^3}{3}+5\"></span>","o":"","k":[{"e":"x^3/3 + 5 - exp(-x)","a":null}]},{"n":"28","s":[["f(x)=\\int\\left(\\frac{3}{x}-4\\right)dx=3\\ln|x|-4x+C","بالتكامل"],["f(1)=0\\Rightarrow0-4+C=0\\Rightarrow C=4","بتعويض النقطة <span class=\"tx\" data-t=\"(1,0)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=3\\ln|x|-4x+4\"></span>","o":"","k":[{"e":"-4*x + 3*log(Abs(x)) + 4","a":null}]}],[{"n":"29","s":[["\\text{الإزاحة}=\\int_0^3\\frac{-t}{1+t^2}dt=-\\frac{1}{2}\\int_0^3\\frac{2t}{1+t^2}dt","البسط مضاعف لمشتقة المقام"],["=\\left.-\\frac{1}{2}\\ln(1+t^2)\\right|_0^3=-\\frac{1}{2}(\\ln10-\\ln1)","بالتعويض"],["=-\\frac{1}{2}\\ln10\\approx-1.15",""]],"a":"الإزاحة <span class=\"tx\" data-t=\"=-\\frac{1}{2}\\ln10\\approx-1.15\\ \\text{m}\"></span>","o":"","k":[{"e":"-1.15","a":true}]},{"n":"30","s":[["v(t)=\\frac{-t}{1+t^2}\\le0\\ \\text{ لكل }\\ t\\in[0,3]","السرعة لا تغيّر إشارتها في الفترة"],["\\text{المسافة}=\\int_0^3|v(t)|dt=\\left|\\int_0^3v(t)dt\\right|","لعدم تغيّر الإشارة"],["=\\left|-\\frac{1}{2}\\ln10\\right|=\\frac{1}{2}\\ln10\\approx1.15","من السؤال السابق"]],"a":"المسافة <span class=\"tx\" data-t=\"=\\frac{1}{2}\\ln10\\approx1.15\\ \\text{m}\"></span>","o":"","k":[{"e":"1.15","a":true}]}],[{"n":"31","s":[["\\text{الإزاحة}=\\int_0^{\\pi/2}6\\sin3t\\,dt=\\left.-2\\cos3t\\right|_0^{\\pi/2}","بالتكامل"],["=-2\\cos\\frac{3\\pi}{2}+2\\cos0=0+2=2","بالتعويض"]],"a":"الإزاحة <span class=\"tx\" data-t=\"=2\\ \\text{m}\"></span>","o":""},{"n":"32","s":[["6\\sin3t=0\\Rightarrow3t=\\pi\\Rightarrow t=\\frac{\\pi}{3}","أصفار السرعة في الفترة"],["\\int_0^{\\pi/3}6\\sin3t\\,dt=\\left.-2\\cos3t\\right|_0^{\\pi/3}=2+2=4","<span class=\"tx\" data-t=\"v&gt;0\"></span> في <span class=\"tx\" data-t=\"(0,\\frac{\\pi}{3})\"></span>"],["\\int_{\\pi/3}^{\\pi/2}6\\sin3t\\,dt=\\left.-2\\cos3t\\right|_{\\pi/3}^{\\pi/2}=0-2=-2","<span class=\"tx\" data-t=\"v&lt;0\"></span> في <span class=\"tx\" data-t=\"(\\frac{\\pi}{3},\\frac{\\pi}{2})\"></span>"],["\\text{المسافة}=4+|-2|=6","بجمع القيم المطلقة"]],"a":"المسافة الكلية <span class=\"tx\" data-t=\"=6\\ \\text{m}\"></span>","o":""}],[{"n":"33","s":[["s(40)=s(0)+\\int_0^{6}(8t-t^2)dt+\\int_6^{40}\\left(15-\\frac{1}{2}t\\right)dt","<span class=\"tx\" data-t=\"s(0)=0\"></span> لأنه انطلق من نقطة الأصل"],["\\int_0^6(8t-t^2)dt=\\left.\\left(4t^2-\\frac{t^3}{3}\\right)\\right|_0^6=144-72=72","تكامل القطعة الأولى"],["\\int_6^{40}\\left(15-\\frac{t}{2}\\right)dt=\\left.\\left(15t-\\frac{t^2}{4}\\right)\\right|_6^{40}=(600-400)-(90-9)=119","تكامل القطعة الثانية"],["s(40)=0+72+119=191","بالجمع"]],"a":"موقع الجسيم بعد <span class=m dir=ltr>40</span> ثانية: <span class=\"tx\" data-t=\"s(40)=191\\ \\text{m}\"></span> (يمين نقطة الأصل)","o":""}]]