[[{"n":"1","s":[["x^2 \\div x = x,\\quad x(x-1) = x^2 - x","القسمة الطويلة: الحد الأول"],["(x^2 + 5x - 1) - (x^2 - x) = 6x - 1","بالطرح"],["6x \\div x = 6,\\quad 6(x-1) = 6x - 6","الحد الثاني"],["(6x - 1) - (6x - 6) = 5","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"x+6\"></span>، والباقي <span class=\"tx\" data-t=\"5\"></span>","o":"","k":[{"e":"x + 6","a":null},{"e":"5","a":null}]},{"n":"2","s":[["3x^2 \\div x = 3x,\\quad 3x(x+7) = 3x^2 + 21x","القسمة الطويلة"],["(3x^2 + 23x + 14) - (3x^2 + 21x) = 2x + 14","بالطرح"],["2x \\div x = 2,\\quad 2(x+7) = 2x + 14",""],["(2x + 14) - (2x + 14) = 0","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"3x+2\"></span>، والباقي <span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"3*x + 2","a":null},{"e":"0","a":null}]},{"n":"3","s":[["x^3 \\div x = x^2,\\quad x^2(x-2) = x^3 - 2x^2","القسمة الطويلة"],["-x^2 + 5x \\to -x(x-2) = -x^2 + 2x","بالطرح ثم القسمة: <span class=\"tx\" data-t=\"-x^2 \\div x = -x\"></span>"],["3x - 6 \\to 3(x-2) = 3x - 6","بالطرح ثم القسمة: <span class=\"tx\" data-t=\"3x \\div x = 3\"></span>"],["\\text{Remainder} = 0","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"x^2-x+3\"></span>، والباقي <span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"x^2 - x + 3","a":null},{"e":"0","a":null}]},{"n":"4","s":[["9x^3 \\div 3x = 3x^2,\\quad 3x^2(3x-1) = 9x^3 - 3x^2","القسمة الطويلة"],["-6x^2 + 17x \\to -2x(3x-1) = -6x^2 + 2x","بالطرح ثم القسمة"],["15x + 6 \\to 5(3x-1) = 15x - 5","بالطرح ثم القسمة"],["(15x + 6) - (15x - 5) = 11","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"3x^2-2x+5\"></span>، والباقي <span class=\"tx\" data-t=\"11\"></span>","o":"","k":[{"e":"3*x^2 - 2*x + 5","a":null},{"e":"11","a":null}]},{"n":"5","s":[["-6x^3 + x^2 + 0x + 4","نكتب الحد الناقص بمعامل صفري"],["-3x^2(2x-3) = -6x^3 + 9x^2 \\to -8x^2 + 0x","بالطرح"],["-4x(2x-3) = -8x^2 + 12x \\to -12x + 4","بالطرح"],["-6(2x-3) = -12x + 18 \\to 4 - 18 = -14","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"-3x^2-4x-6\"></span>، والباقي <span class=\"tx\" data-t=\"-14\"></span>","o":"","k":[{"e":"-3*x^2 - 4*x - 6","a":null},{"e":"-14","a":null}]},{"n":"6","s":[["8x^4 + 2x^3 - 14x^2 + 0x + 2","نكتب الحد الناقص بمعامل صفري"],["2x^2(4x^2 + x - 1) = 8x^4 + 2x^3 - 2x^2","القسمة: <span class=\"tx\" data-t=\"8x^4 \\div 4x^2 = 2x^2\"></span>"],["-12x^2 + 0x + 2","بالطرح"],["-3(4x^2 + x - 1) = -12x^2 - 3x + 3","القسمة: <span class=\"tx\" data-t=\"-12x^2 \\div 4x^2 = -3\"></span>"],["(-12x^2 + 0x + 2) - (-12x^2 - 3x + 3) = 3x - 1","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"2x^2-3\"></span>، والباقي <span class=\"tx\" data-t=\"3x-1\"></span>","o":"","k":[{"e":"2*x^2 - 3","a":null},{"e":"3*x - 1","a":null}]}],[{"n":"7","s":[["2x = 0 \\Rightarrow x = 0","أصفار المقام"]],"a":"المجال: <span class=\"tx\" data-t=\"\\{x \\mid x \\ne 0,\\ x \\in \\mathbb{R}\\}\"></span>","o":""},{"n":"8","s":[["2x^2 - 3x + 1 = 0","أصفار المقام"],["(2x-1)(x-1) = 0","بالتحليل"],["x = \\frac{1}{2},\\ x = 1","خاصية الضرب الصفري"]],"a":"المجال: <span class=\"tx\" data-t=\"\\{x \\mid x \\ne \\frac{1}{2},\\ x \\ne 1\\}\"></span>","o":""},{"n":"9","s":[["x^2 + 9 = 0 \\Rightarrow x^2 = -9","أصفار المقام"],["x^2 + 9 \\ge 9 > 0","لا يوجد عدد حقيقي مربعه سالب"]],"a":"المجال: جميع الأعداد الحقيقية <span class=\"tx\" data-t=\"\\mathbb{R}\"></span>","o":""}],[{"n":"10","s":[["x - 3 = 0 \\Rightarrow x = 3","خط التقارب الرأسي (صفر المقام)"],["y = 0","خط التقارب الأفقي: درجة البسط أقل من درجة المقام"],["f(0) = -\\frac{2}{3},\\ f(4) = 2,\\ f(5) = 1,\\ f(2) = -2,\\ f(1) = -1","نقاط للتمثيل"]],"a":"خط التقارب الرأسي <span class=\"tx\" data-t=\"x=3\"></span>، الأفقي <span class=\"tx\" data-t=\"y=0\"></span>؛ المجال <span class=\"tx\" data-t=\"\\mathbb{R}-\\{3\\}\"></span>، المدى <span class=\"tx\" data-t=\"\\mathbb{R}-\\{0\\}\"></span>","o":"فرعان: يمين <span class=\"tx\" data-t=\"x=3\"></span> فوق محور <span class=\"tx\" data-t=\"x\"></span>، ويسار <span class=\"tx\" data-t=\"x=3\"></span> تحت محور <span class=\"tx\" data-t=\"x\"></span>، ويقطع محور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"-\\frac{2}{3}\"></span>"},{"n":"11","s":[["(x-1)^2 = 0 \\Rightarrow x = 1","خط التقارب الرأسي"],["y = 0","خط التقارب الأفقي: درجة البسط أقل من درجة المقام"],["(x-1)^2 > 0 \\Rightarrow h(x) < 0","البسط سالب والمقام موجب دائمًا"],["h(0) = -2,\\ h(2) = -2,\\ h(3) = -0.5,\\ h(-1) = -0.5","نقاط للتمثيل"]],"a":"خط التقارب الرأسي <span class=\"tx\" data-t=\"x=1\"></span>، الأفقي <span class=\"tx\" data-t=\"y=0\"></span>؛ المجال <span class=\"tx\" data-t=\"\\mathbb{R}-\\{1\\}\"></span>، المدى <span class=\"tx\" data-t=\"(-\\infty, 0)\"></span> أي <span class=\"tx\" data-t=\"y&lt;0\"></span>","o":"فرعان كلاهما تحت محور <span class=\"tx\" data-t=\"x\"></span> ومتماثلان حول المستقيم <span class=\"tx\" data-t=\"x=1\"></span>، يتجهان للأسفل قرب <span class=\"tx\" data-t=\"x=1\"></span>"},{"n":"12","s":[["x + 2 = 0 \\Rightarrow x = -2","خط التقارب الرأسي"],["y = -1","خط التقارب الأفقي (انسحاب <span class=\"tx\" data-t=\"\\frac{4}{x}\"></span> وحدتين لليسار ووحدة للأسفل)"],["g(0) = 1,\\ g(2) = 0,\\ g(-1) = 3,\\ g(-3) = -5,\\ g(-4) = -3,\\ g(-6) = -2","نقاط للتمثيل"]],"a":"خط التقارب الرأسي <span class=\"tx\" data-t=\"x=-2\"></span>، الأفقي <span class=\"tx\" data-t=\"y=-1\"></span>؛ المجال <span class=\"tx\" data-t=\"\\mathbb{R}-\\{-2\\}\"></span>، المدى <span class=\"tx\" data-t=\"\\mathbb{R}-\\{-1\\}\"></span>","o":"يقطع محور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"1\"></span> ومحور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"2\"></span>"}],[{"n":"13","s":[["f(x) = \\frac{(x+4)(x-1)}{x+4}","بتحليل البسط"],["f(x) = x - 1,\\ x \\ne -4","باختصار العامل المشترك <span class=\"tx\" data-t=\"(x+4)\"></span>"],["f(-4) \\to -4 - 1 = -5","إحداثيا الفجوة"]],"a":"التمثيل هو المستقيم <span class=\"tx\" data-t=\"y=x-1\"></span> مع فجوة (دائرة مفرغة) عند <span class=\"tx\" data-t=\"(-4,-5)\"></span>","o":"المستقيم يقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"1\"></span> ومحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"-1\"></span>"},{"n":"14","s":[["f(x) = \\frac{x^2(x-1)}{x^3}","بتحليل البسط"],["f(x) = \\frac{x-1}{x} = 1 - \\frac{1}{x},\\ x \\ne 0","باختصار <span class=\"tx\" data-t=\"x^2\"></span>؛ يبقى <span class=\"tx\" data-t=\"x\"></span> في المقام"],["x = 0,\\quad y = 1","خط تقارب رأسي وخط تقارب أفقي"],["f(1) = 0,\\ f(-1) = 2,\\ f(2) = 0.5,\\ f(0.5) = -1","نقاط للتمثيل"]],"a":"منحنى <span class=\"tx\" data-t=\"y = 1-\\frac{1}{x}\"></span> بخط تقارب رأسي <span class=\"tx\" data-t=\"x=0\"></span> وأفقي <span class=\"tx\" data-t=\"y=1\"></span>، ويقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(1,0)\"></span>","o":"لا توجد فجوة لأن <span class=\"tx\" data-t=\"x=0\"></span> ما زال صفرًا للمقام بعد الاختصار"},{"n":"15","s":[["f(x) = \\frac{3x^2(x^2 + 2x + 1)}{(x+1)^2} = \\frac{3x^2(x+1)^2}{(x+1)^2}","بتحليل البسط والمقام"],["f(x) = 3x^2,\\ x \\ne -1","باختصار العامل المشترك <span class=\"tx\" data-t=\"(x+1)^2\"></span>"],["3(-1)^2 = 3","إحداثيا الفجوة <span class=\"tx\" data-t=\"(-1, 3)\"></span>"]],"a":"التمثيل هو القطع المكافئ <span class=\"tx\" data-t=\"y=3x^2\"></span> مع فجوة (دائرة مفرغة) عند <span class=\"tx\" data-t=\"(-1,3)\"></span>","o":"رأس القطع <span class=\"tx\" data-t=\"(0,0)\"></span> ومن نقاطه <span class=\"tx\" data-t=\"(1,3)\"></span> و <span class=\"tx\" data-t=\"(\\pm 2, 12)\"></span>"}],[{"n":"16","s":[["x = -1,\\quad y = 2","خطا التقارب الرأسي والأفقي"],["f(0) = 3","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"التمثيل البياني <span class=\"tx\" data-t=\"\\mathbf{B}\"></span>","o":""},{"n":"17","s":[["x = 2,\\quad y = 1","خطا التقارب الرأسي والأفقي"],["h(0) = -\\frac{1}{2} + 1 = 0.5","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"التمثيل البياني <span class=\"tx\" data-t=\"\\mathbf{C}\"></span>","o":""},{"n":"18","s":[["x = -2,\\quad y = -1","خطا التقارب الرأسي والأفقي"],["g(0) = \\frac{1}{2} - 1 = -0.5","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"التمثيل البياني <span class=\"tx\" data-t=\"\\mathbf{A}\"></span>","o":""}],[{"n":"19","s":[["(x+2)^2 = x^2 + 4x + 4","طول الورقة"],["\\text{Width} = \\frac{3x^3 + 14x^2 + ax + 8}{x^2 + 4x + 4}","العرض <span class=m dir=ltr>=</span> المساحة <span class=m dir=ltr>÷</span> الطول"],["3x(x^2 + 4x + 4) = 3x^3 + 12x^2 + 12x","القسمة: الحد الأول <span class=\"tx\" data-t=\"3x\"></span>"],["2x^2 + (a-12)x + 8 - 2(x^2 + 4x + 4) = (a-20)x","الحد الثاني <span class=\"tx\" data-t=\"2\"></span> ثم الطرح"],["a - 20 = 0 \\Rightarrow a = 20","الباقي يجب أن يساوي صفرًا لأن العرض كثير حدود"]],"a":"<span class=\"tx\" data-t=\"a = 20\"></span>، والعرض <span class=\"tx\" data-t=\"3x+2\"></span> وحدة؛ والتحقق: <span class=\"tx\" data-t=\"(x+2)^2(3x+2)=3x^3+14x^2+20x+8\"></span>","o":"","k":[{"e":"20","a":null},{"e":"3*x + 2","a":null},{"e":"3*x^3 + 14*x^2 + 20*x + 8","a":null}]}],[{"n":"20","s":[["x + 5 = 0,\\ x + 2 = 0,\\ x^2 - 9 = 0","للاقترانات <span class=\"tx\" data-t=\"f, g, l\"></span> أصفار في المقام"],["x^2 + 1 > 0","مقام <span class=\"tx\" data-t=\"h\"></span> لا يساوي صفرًا أبدًا"]],"a":"الاقتران المختلف هو <span class=\"tx\" data-t=\"h(x)=\\frac{9}{x^2+1}\"></span>؛ لأن مجاله جميع الأعداد الحقيقية وليس له خط تقارب رأسي، بينما لكل من الاقترانات الأخرى خط تقارب رأسي واحد على الأقل","o":""}],[{"n":"21","s":[["(x+2)(x-7) = x^2 - 5x - 14","المقام صفراه <span class=\"tx\" data-t=\"-2\"></span> و <span class=\"tx\" data-t=\"7\"></span> لخطي التقارب الرأسيين"],["f(x) = \\frac{3x^2}{x^2 - 5x - 14}","درجة البسط <span class=m dir=ltr>=</span> درجة المقام، ونسبة المعاملين الرئيسين <span class=\"tx\" data-t=\"\\frac{3}{1}=3\"></span>"],["3x^2 = 0 \\text{ only at } x = 0","البسط لا يساوي صفرًا عند <span class=\"tx\" data-t=\"-2\"></span> أو <span class=\"tx\" data-t=\"7\"></span> (فلا توجد فجوات)"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"f(x) = \\frac{3x^2}{(x+2)(x-7)}\"></span>","o":"","k":[{"e":"3*x^2/((x - 7)*(x + 2))","a":null}]}],[{"n":"4","s":[["6-2=4","درجة ناتج القسمة <span class=m dir=ltr>=</span> درجة المقسوم <span class=m dir=ltr>−</span> درجة المقسوم عليه"]],"a":"<span class=m dir=ltr>c)</span> الرابعة","o":""}],[{"n":"7","s":[["\\frac{3}{4-3x}\\to 0","عندما تكبر <span class=m dir=ltr>|x|</span> كثيرًا"],["r(x)\\to 0+7=7",""]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"y=7\"></span>","o":"","k":[{"e":"7","a":null}]}],[{"n":"9","s":[["x^2-3x-10=0","أصفار المقام"],["(x-5)(x+2)=0 \\Rightarrow x=5,\\ x=-2","بالتحليل"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\{x\\mid x\\ne -2,\\ x\\ne 5\\}\"></span>","o":""}],[{"n":"12","s":[["8x^3+0x^2+12x-5","نكتب المقسوم بالصورة القياسية مع حد صفري"],["4x^2(2x+3)=8x^3+12x^2 \\Rightarrow -12x^2+12x","بالطرح"],["-6x(2x+3)=-12x^2-18x \\Rightarrow 30x-5","بالطرح"],["15(2x+3)=30x+45 \\Rightarrow -50","الباقي"],["\\frac{8x^3+12x-5}{2x+3}=4x^2-6x+15-\\frac{50}{2x+3}",""]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"4x^2-6x+15\"></span> والباقي <span class=\"tx\" data-t=\"-50\"></span>","o":"","k":[{"e":"4*x^2 - 6*x + 15","a":null},{"e":"-50","a":null}]}],[{"n":"13","s":[["2-x=0 \\Rightarrow x=2","خط التقارب الرأسي: صفر المقام"],["y=0","خط التقارب الأفقي: درجة البسط أقل من درجة المقام"],["(0,2),\\ (1,4),\\ (3,-4),\\ (4,-2),\\ (-2,1)","نقاط للتمثيل"],["D=\\{x\\mid x\\ne 2\\},\\ R=\\{y\\mid y\\ne 0\\}","المجال والمدى"]],"a":"خط التقارب الرأسي <span class=\"tx\" data-t=\"x=2\"></span>، الأفقي <span class=\"tx\" data-t=\"y=0\"></span>؛ المجال <span class=\"tx\" data-t=\"\\{x\\mid x\\ne 2\\}\"></span>، المدى <span class=\"tx\" data-t=\"\\{y\\mid y\\ne 0\\}\"></span>","o":"الفرع الأيسر (<span class=\"tx\" data-t=\"x&lt;2\"></span>) فوق المحور <span class=m dir=ltr>x</span> ويصعد نحو الأعلى قرب <span class=\"tx\" data-t=\"x=2\"></span>، والفرع الأيمن (<span class=\"tx\" data-t=\"x&gt;2\"></span>) تحت المحور <span class=m dir=ltr>x</span> وينزل نحو الأسفل قرب <span class=\"tx\" data-t=\"x=2\"></span>."}],[{"n":"1","s":[["2x^2(x+4)=2x^3+8x^2 \\Rightarrow -12x^2-12x+5","القسمة الطويلة، بالطرح"],["-12x(x+4)=-12x^2-48x \\Rightarrow 36x+5","بالطرح"],["36(x+4)=36x+144 \\Rightarrow -139","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"2x^2-12x+36\"></span> والباقي <span class=\"tx\" data-t=\"-139\"></span>","o":"","k":[{"e":"2*x^2 - 12*x + 36","a":null},{"e":"-139","a":null}]},{"n":"2","s":[["4x^4-6x^3+0x^2-9x+12","نضع حدًّا صفريًا"],["2x^2(2x^2-5x+2) \\Rightarrow 4x^3-4x^2-9x+12","بالطرح"],["2x(2x^2-5x+2) \\Rightarrow 6x^2-13x+12","بالطرح"],["3(2x^2-5x+2) \\Rightarrow 2x+6","الباقي"]],"a":"ناتج القسمة <span class=\"tx\" data-t=\"2x^2+2x+3\"></span> والباقي <span class=\"tx\" data-t=\"2x+6\"></span>","o":"","k":[{"e":"2*x^2 + 2*x + 3","a":null},{"e":"2*x + 6","a":null}]}],[{"n":"3","s":[["f\\left(-\\tfrac{1}{2}\\right)=8","نظرية الباقي: صفر <span class=m dir=ltr>2x + 1</span> هو <span class=m dir=ltr>−1/2</span>"],["4\\left(-\\tfrac{1}{8}\\right)-8\\left(\\tfrac{1}{4}\\right)+7\\left(-\\tfrac{1}{2}\\right)+k=8","بالتعويض"],["-\\tfrac{1}{2}-2-\\tfrac{7}{2}+k=8 \\Rightarrow k-6=8",""],["k=14",""]],"a":"<span class=\"tx\" data-t=\"k=14\"></span>","o":"","k":[{"e":"14","a":null}]}],[{"n":"4","s":[["g(3)=0","نظرية العوامل"],["2(81)-5(27)+3c-18=0","بالتعويض <span class=m dir=ltr>x = 3</span>"],["162-135-18+3c=0 \\Rightarrow 9+3c=0",""],["c=-3",""]],"a":"<span class=\"tx\" data-t=\"c=-3\"></span>","o":"","k":[{"e":"-3","a":null}]}],[{"n":"5","s":[["x-1=0 \\Rightarrow x=1","خط التقارب الرأسي"],["y=4","خط التقارب الأفقي"],["(-1,3),\\ (0,2),\\ (2,6),\\ (3,5)","نقاط للتمثيل"],["D=\\{x\\mid x\\ne 1\\},\\ R=\\{y\\mid y\\ne 4\\}",""]],"a":"<span class=\"tx\" data-t=\"x=1\"></span> و <span class=\"tx\" data-t=\"y=4\"></span>؛ المجال <span class=\"tx\" data-t=\"\\{x\\mid x\\ne 1\\}\"></span>، المدى <span class=\"tx\" data-t=\"\\{y\\mid y\\ne 4\\}\"></span>","o":"منحنى <span class=\"tx\" data-t=\"y=\\frac{2}{x}\"></span> مُ