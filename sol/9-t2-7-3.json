[[{"n":"1","s":[["3y(3-y)=y(y+1)","بالضرب التبادلي"],["9y-3y^2=y^2+y","باستعمال خاصية التوزيع"],["4y^2-8y=0\\Rightarrow 4y(y-2)=0","بالتبسيط والتحليل"],["y=0\\ \\text{or}\\ y=2","خاصية الضرب الصفري، وكلاهما لا يجعل مقامًا صفرًا"]],"a":"<span class=\"tx\" data-t=\"y=0\"></span> أو <span class=\"tx\" data-t=\"y=2\"></span>","o":""},{"n":"2","s":[["2(3x+7)=10(x+5)","بالضرب التبادلي"],["6x+14=10x+50","باستعمال خاصية التوزيع"],["-4x=36\\Rightarrow x=-9","بالتبسيط"],["\\frac{2}{-4}=\\frac{10}{-20}=-\\frac{1}{2}","تحقق"]],"a":"<span class=\"tx\" data-t=\"x=-9\"></span>","o":""},{"n":"3","s":[["y(y-1)=42","بالضرب التبادلي"],["y^2-y-42=0","بطرح <span class=m dir=ltr>42</span> من الطرفين"],["(y-7)(y+6)=0\\Rightarrow y=7\\ \\text{or}\\ y=-6","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"y=7\"></span> أو <span class=\"tx\" data-t=\"y=-6\"></span>","o":""},{"n":"4","s":[["3y(y-1)=18","بالضرب التبادلي"],["3y^2-3y-18=0\\Rightarrow y^2-y-6=0","بالتبسيط وقسمة الطرفين على <span class=m dir=ltr>3</span>"],["(y-3)(y+2)=0\\Rightarrow y=3\\ \\text{or}\\ y=-2","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"y=3\"></span> أو <span class=\"tx\" data-t=\"y=-2\"></span>","o":""},{"n":"5","s":[["w(w+6)=2w(w+1)","بالضرب التبادلي"],["w^2+6w=2w^2+2w","باستعمال خاصية التوزيع"],["w^2-4w=0\\Rightarrow w(w-4)=0","بالتبسيط والتحليل"],["w=0\\ \\text{or}\\ w=4","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"w=0\"></span> أو <span class=\"tx\" data-t=\"w=4\"></span>","o":""},{"n":"6","s":[["x^2+4=5","المقامان متساويان، فبضرب الطرفين في <span class=\"tx\" data-t=\"(x-1)\"></span>"],["x^2=1\\Rightarrow x=1\\ \\text{or}\\ x=-1","بطرح <span class=m dir=ltr>4</span> ثم أخذ الجذر"],["x=1\\Rightarrow x-1=0","الحل <span class=\"tx\" data-t=\"x=1\"></span> دخيل لأنه يجعل المقام صفرًا"]],"a":"<span class=\"tx\" data-t=\"x=-1\"></span>","o":""}],[{"n":"7","s":[["\\frac{30+x}{120+x}=\\frac{1}{3}","نفرض أن عدد أشجار الليمون المضافة <span class=\"tx\" data-t=\"x\"></span>؛ نسبة الليمون إلى جميع الأشجار"],["3(30+x)=120+x","بالضرب التبادلي"],["90+3x=120+x\\Rightarrow 2x=30","بالتبسيط"],["x=15","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["\\frac{45}{135}=\\frac{1}{3}","تحقق"]],"a":"يلزم زراعة <span class=\"tx\" data-t=\"15\"></span> شجرة ليمون","o":""}],[{"n":"8","s":[["8y\\times\\frac{4}{y}+8y\\times\\frac{3}{8}=8y\\times\\frac{6}{y}","بضرب الطرفين في (م.م.أ) <span class=\"tx\" data-t=\"8y\"></span>"],["32+3y=48","بالتبسيط"],["y=\\frac{16}{3}","بطرح <span class=m dir=ltr>32</span> ثم القسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{16}{3}\"></span>","o":""},{"n":"9","s":[["4y-y(y-2)=9(y-2)","بضرب الطرفين في <span class=\"tx\" data-t=\"y(y-2)\"></span>"],["4y-y^2+2y=9y-18","باستعمال خاصية التوزيع"],["y^2+3y-18=0","بالتبسيط"],["(y+6)(y-3)=0\\Rightarrow y=-6\\ \\text{or}\\ y=3","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"y=-6\"></span> أو <span class=\"tx\" data-t=\"y=3\"></span>","o":""},{"n":"10","s":[["(z-4)+z=z(z-3)","بضرب الطرفين في <span class=\"tx\" data-t=\"z(z-4)\"></span>"],["2z-4=z^2-3z\\Rightarrow z^2-5z+4=0","بالتبسيط"],["(z-1)(z-4)=0\\Rightarrow z=1\\ \\text{or}\\ z=4","بالتحليل وخاصية الضرب الصفري"],["z=4\\Rightarrow z-4=0","الحل <span class=\"tx\" data-t=\"z=4\"></span> دخيل"]],"a":"<span class=\"tx\" data-t=\"z=1\"></span>","o":""},{"n":"11","s":[["3(x+2)+2x(x-2)=3x^2","بضرب الطرفين في <span class=\"tx\" data-t=\"(x-2)(x+2)\"></span>"],["2x^2-x+6=3x^2\\Rightarrow x^2+x-6=0","بالتبسيط"],["(x+3)(x-2)=0\\Rightarrow x=-3\\ \\text{or}\\ x=2","بالتحليل وخاصية الضرب الصفري"],["x=2\\Rightarrow x-2=0","الحل <span class=\"tx\" data-t=\"x=2\"></span> دخيل"]],"a":"<span class=\"tx\" data-t=\"x=-3\"></span>","o":""},{"n":"12","s":[["x^3-x^2=x^2(x-1)","تحليل المقام، (م.م.أ) <span class=\"tx\" data-t=\"=x^2(x-1)\"></span>"],["(x^2-3x-4)-(x-1)=(x-2)(x-1)","بضرب الطرفين في <span class=\"tx\" data-t=\"x^2(x-1)\"></span>"],["x^2-4x-3=x^2-3x+2","بالتبسيط"],["-x=5\\Rightarrow x=-5","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"x=-5\"></span>","o":""},{"n":"13","s":[["10(1-x)(1+x)+14(1+x)=12","بضرب الطرفين في <span class=\"tx\" data-t=\"1-x^2=(1-x)(1+x)\"></span>"],["10-10x^2+14+14x=12","باستعمال خاصية التوزيع"],["5x^2-7x-6=0","بالتبسيط والقسمة على <span class=\"tx\" data-t=\"-2\"></span>"],["(5x+3)(x-2)=0\\Rightarrow x=-\\frac{3}{5}\\ \\text{or}\\ x=2","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"x=-\\frac{3}{5}\"></span> أو <span class=\"tx\" data-t=\"x=2\"></span>","o":""},{"n":"14","s":[["x-1=4","بضرب الطرفين في <span class=\"tx\" data-t=\"x(x+5)=x^2+5x\"></span>"],["x=5","بإضافة <span class=m dir=ltr>1</span> للطرفين، ولا يجعل مقامًا صفرًا"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span>","o":""},{"n":"15","s":[["n^2+3n-4=(n-1)(n+4)","تحليل المقام، (م.م.أ) <span class=\"tx\" data-t=\"=(n-1)(n+4)\"></span>"],["(n-1)(n+4)=(n-2)(n+4)+3","بضرب الطرفين في (م.م.أ)"],["n^2+3n-4=n^2+2n-5","باستعمال خاصية التوزيع"],["n=-1","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"n=-1\"></span>","o":""},{"n":"16","s":[["16x=2x(x-5)-6(x-5)","بضرب الطرفين في <span class=\"tx\" data-t=\"x(x-5)\"></span>"],["16x=2x^2-16x+30\\Rightarrow 2x^2-32x+30=0","بالتبسيط"],["x^2-16x+15=0\\Rightarrow (x-1)(x-15)=0","بالقسمة على <span class=m dir=ltr>2</span> والتحليل"],["x=1\\ \\text{or}\\ x=15","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"x=1\"></span> أو <span class=\"tx\" data-t=\"x=15\"></span>","o":""}],[{"n":"17","s":[["\\frac{1}{x}=\\frac{1}{x-2}-1","نساوي بين معادلتي المنحنيين"]],"a":"المعادلة: <span class=\"tx\" data-t=\"\\frac{1}{x}=\\frac{1}{x-2}-1\"></span>","o":"من الشكل: المنحنيان يتقاطعان في نقطتين تقريبًا عند <span class=\"tx\" data-t=\"x\\approx 2.7\"></span> و <span class=\"tx\" data-t=\"x\\approx -0.7\"></span>"},{"n":"18","s":[["x-2=x-x(x-2)","بضرب الطرفين في <span class=\"tx\" data-t=\"x(x-2)\"></span>"],["x-2=-x^2+3x\\Rightarrow x^2-2x-2=0","بالتبسيط"],["x=\\frac{2\\pm\\sqrt{4+8}}{2}=1\\pm\\sqrt{3}","بالقانون العام"],["x\\approx 2.73\\ \\text{or}\\ x\\approx -0.73","بالتقريب، ويتفق ذلك مع الشكل"]],"a":"<span class=\"tx\" data-t=\"x=1+\\sqrt{3}\\approx 2.73\"></span> أو <span class=\"tx\" data-t=\"x=1-\\sqrt{3}\\approx -0.73\"></span>","o":""}],[{"n":"19","s":[["\\frac{1}{45}+\\frac{1}{x}=\\frac{1}{20}","نفرض أن الخرطوم الأسود يملأ المسبح في <span class=\"tx\" data-t=\"x\"></span> دقيقة؛ معدّل العمل في الدقيقة"],["4x+180=9x","بضرب الطرفين في (م.م.أ) <span class=\"tx\" data-t=\"180x\"></span>"],["5x=180\\Rightarrow x=36","بالتبسيط"],["\\frac{1}{45}+\\frac{1}{36}=\\frac{4+5}{180}=\\frac{1}{20}","تحقق"]],"a":"يستغرق الخرطوم الأسود <span class=\"tx\" data-t=\"36\"></span> دقيقة","o":""}],[{"n":"20","s":[["\\frac{200+x}{800+x}=\\frac{2}{5}","نفرض أن كتلة الفضة المضافة <span class=\"tx\" data-t=\"x\"></span> <span class=m dir=ltr>g</span>؛ نسبة الفضة إلى كتلة الخليط"],["5(200+x)=2(800+x)","بالضرب التبادلي"],["1000+5x=1600+2x\\Rightarrow 3x=600","بالتبسيط"],["x=200","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["\\frac{400}{1000}=\\frac{2}{5}","تحقق"]],"a":"يجب إضافة <span class=\"tx\" data-t=\"200\"></span> <span class=m dir=ltr>g</span> من الفضة","o":"مسألة اليوم: خليط كتلته <span class=m dir=ltr>800 g</span> فيه <span class=m dir=ltr>200 g</span> فضة، والنسبة المطلوبة للفضة <span class=\"tx\" data-t=\"2:5\"></span>"}],[{"n":"21","s":[["\\frac{2}{x-1}+\\frac{1}{3}=1","معادلة مقاماتها <span class=\"tx\" data-t=\"x-1\"></span> و <span class=m dir=ltr>3</span>، فـ(م.م.أ) <span class=\"tx\" data-t=\"=3(x-1)\"></span>"],["6+(x-1)=3(x-1)","بضرب الطرفين في <span class=\"tx\" data-t=\"3(x-1)\"></span>"],["x+5=3x-3\\Rightarrow x=4","بالتبسيط"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\frac{2}{x-1}+\\frac{1}{3}=1\"></span> وحلها <span class=\"tx\" data-t=\"x=4\"></span>","o":""}],[{"n":"22","s":[["x(5x-2)\\times\\frac{2x-1}{x}+6\\times x(5x-2)=x(5x-2)\\times\\frac{3x+4}{5x-2}","الخطأ: لم تُضرَب جميع الحدود في (م.م.أ)، إذ لم يُضرَب الحد <span class=m dir=ltr>6</span>"],["(5x-2)(2x-1)+6x(5x-2)=x(3x+4)","بالقسمة على العوامل المشتركة"],["10x^2-9x+2+30x^2-12x=3x^2+4x","باستعمال خاصية التوزيع"],["37x^2-25x+2=0","بالتبسيط"]],"a":"الخطوة الصحيحة: ضرب كل حد (ومنه <span class=m dir=ltr>6)</span> في <span class=\"tx\" data-t=\"x(5x-2)\"></span>، فتصبح المعادلة <span class=\"tx\" data-t=\"37x^2-25x+2=0\"></span>","o":"حلّا المعادلة الناتجة: <span class=\"tx\" data-t=\"x=\\frac{25\\pm\\sqrt{329}}{74}\"></span> أي <span class=\"tx\" data-t=\"x\\approx 0.58\"></span> أو <span class=\"tx\" data-t=\"x\\approx 0.09\"></span>"}],[{"n":"23","s":[["\\frac{6x}{x+4}+4=\\frac{6x+4(x+4)}{x+4}=\\frac{10x+16}{x+4}","لا يمكن مباشرة لأن الطرف الأيسر ليس كسرًا واحدًا؛ نجمع أولًا"],["(10x+16)(x-1)=(2x+2)(x+4)","الآن صارت تناسبًا، فبالضرب التبادلي"],["10x^2+6x-16=2x^2+10x+8\\Rightarrow 2x^2-x-6=0","بالتبسيط والقسمة على <span class=m dir=ltr>4</span>"],["(2x+3)(x-2)=0\\Rightarrow x=-\\frac{3}{2}\\ \\text{or}\\ x=2","بالتحليل وخاصية الضرب الصفري"]],"a":"لا يمكن مباشرةً؛ لأن الضرب التبادلي يُستعمل فقط إذا كان كل طرف كسرًا واحدًا (تناسبًا). بعد جمع الطرف الأيسر في كسر واحد يمكن ذلك، والحلان <span class=\"tx\" data-t=\"x=2\"></span> و <span class=\"tx\" data-t=\"x=-\\frac{3}{2}\"></span>","o":""}],[{"n":"24","s":[["\\frac{x+3}{x-2}\\times\\frac{(x+2)(x-1)}{x+5}\\times\\frac{1}{x-1}=\\frac{(x+3)(x+2)}{(x-2)(x+5)}","تبسيط الكسر المركب بالتحليل (بشرط <span class=\"tx\" data-t=\"x\\ne1\"></span>)"],["\\frac{(x+3)(x+2)}{(x-2)(x+5)}=-2","بطرح <span class=m dir=ltr>2</span> من الطرفين"],["x^2+5x+6=-2(x^2+3x-10)","بالضرب التبادلي"],["3x^2+11x-14=0\\Rightarrow (3x+14)(x-1)=0","بالتبسيط والتحليل"],["x=-\\frac{14}{3}\\ \\text{or}\\ x=1","خاصية الضرب الصفري، و <span class=\"tx\" data-t=\"x=1\"></span> دخيل لأنه يجعل المقام <span class=\"tx\" data-t=\"x-1\"></span> صفرًا"]],"a":"<span class=\"tx\" data-t=\"x=-\\frac{14}{3}\"></span>","o":""}],[{"n":"6","s":[["x(x+6)=4(x+2)","بالضرب التبادلي"],["x^2+2x-8=0","بالتبسيط"],["(x+4)(x-2)=0\\Rightarrow x=-4\\ \\text{or}\\ x=2","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"x=-4,\\ 2\"></span>","o":""}],[{"n":"28","s":[["x(x-2)=15","بالضرب التبادلي"],["x^2-2x-15=0\\Rightarrow (x-5)(x+3)=0","بالتحليل إلى العوامل"],["x=5\\ \\text{or}\\ x=-3","كلاهما لا يجعل المقام صفرًا"]],"a":"<span class=m dir=ltr>b)</span> حلّان","o":""}],[{"n":"29","s":[["\\frac{1}{26}+\\frac{1}{39}=\\frac{1}{t}","نفرض أن الزمن معًا <span class=\"tx\" data-t=\"t\"></span> ساعة؛ مجموع معدّلي العمل"],["3t+2t=78","بضرب الطرفين في (م.م.أ) <span class=\"tx\" data-t=\"78t\"></span>"],["5t=78\\Rightarrow t=15.6","بقسمة الطرفين على <span class=m dir=ltr>5</span>"]],"a":"يحتاجان معًا <span class=\"tx\" data-t=\"15.6\"></span> ساعة","o":""}],[{"n":"1","s":[["\\frac{12}{x-1}=\\frac{9}{2}-\\frac{3}{2}=3","بطرح <span class=\"tx\" data-t=\"\\frac{3}{2}\"></span> من الطرفين"],["3(x-1)=12","بالضرب التبادلي"],["x=5","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span>","o":""},{"n":"2","s":[["3x-4(1-x)=3x(1-x)","بضرب الطرفين في <span class=\"tx\" data-t=\"3(1-x)\"></span>"],["7x-4=3x-3x^2\\Rightarrow 3x^2+4x-4=0","بالتبسيط"],["(3x-2)(x+2)=0\\Rightarrow x=\\frac{2}{3}\\ \\text{or}\\ x=-2","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{2}{3}\"></span> أو <span class=\"tx\" data-t=\"x=-2\"></span>","o":""},{"n":"3","s":[["8+2(x+1)=(x+1)^2","بضرب الطرفين في <span class=\"tx\" data-t=\"2(x+1)\"></span>"],["2x+10=x^2+2x+1\\Rightarrow x^2=9","بالتبسيط"],["x=3\\ \\text{or}\\ x=-3","بأخذ الجذر التربيعي"]],"a":"<span class=\"tx\" data-t=\"x=3\"></span> أو <span class=\"tx\" data-t=\"x=-3\"></span>","o":""},{"n":"4","s":[["y(y+9)=3(y^2+3)","بالضرب التبادلي"],["2y^2-9y+9=0","بالتبسيط"],["(2y-3)(y-3)=0\\Rightarrow y=\\frac{3}{2}\\ \\text{or}\\ y=3","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{3}{2}\"></span> أو <span class=\"tx\" data-t=\"y=3\"></span>","o":""},{"n":"5","s":[["w(2w+1)=(5w-4)(w+2)","بالضرب التبادلي"],["2w^2+w=5w^2+6w-8\\Rightarrow 3w^2+5w-8=0","بالتبسيط"],["(3w+8)(w-1)=0\\Rightarrow w=-\\frac{8}{3}\\ \\text{or}\\ w=1","بالتحليل وخاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"w=-\\frac{8}{3}\"></span> أو <span class=\"tx\" data-t=\"w=1\"></span>","o":""},{"n":"6","s":[["(y+3)+(y-3)=3","بضرب الطرفين في <span class=\"tx\" data-t=\"(y-3)(y+3)\"></span>"],["2y=3\\Rightarrow y=\\frac{3}{2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{3}{2}\"></span>","o":""},{"n":"7","s":[["2b^2-6b-8=2(b-4)(b+1)","تحليل المقام، (م.م.أ) <span class=\"tx\" data-t=\"=2(b-4)(b+1)\"></span>"],["2(b+1)+b(b-4)=b","بضرب الطرفين في (م.م.أ)"],["b^2-3b+2=0\\Rightarrow (b-1)(b-2)=0","بالتبسيط والتحليل"],["b=1\\ \\text{or}\\ b=2","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"b=1\"></span> أو <span class=\"tx\" data-t=\"b=2\"></span>","o":""},{"n":"8","s":[["\\frac{1}{x+1}+\\frac{x}{x-1}=\\frac{x^2+1}{(x-1)(x+1)}","<span class=\"tx\" data-t=\"-\\frac{x}{1-x}=\\frac{x}{x-1}\"></span>"],["(x-1)+x(x+1)=x^2+1","بضرب الطرفين في <span class=\"tx\" data-t=\"(x-1)(x+1)\"></span>"],["x^2+2x-1=x^2+1\\Rightarrow x=1","بالتبسيط"],["x=1\\Rightarrow x-1=0","الحل دخيل لأنه يجعل المقام صفرًا"]],"a":"لا يوجد حل للمعادلة","o":""},{"n":"9","s":[["(c+2)+2(2c+1)=(2c+1)(c+2)","بضرب الطرفين في <span class=\"tx\" data-t=\"(2c+1)(c+2)\"></span>"],["5c+4=2c^2+5c+2","بالتبسيط"],["c^2=1\\Rightarrow c=1\\ \\text{or}\\ c=-1","بالتبسيط وأخذ الجذر"]],"a":"<span class=\"tx\" data-t=\"c=1\"></span> أو <span class=\"tx\" data-t=\"c=-1\"></span>","o":""}],[{"n":"10","s":[["\\frac{10+x}{140+x}=\\frac{1}{6}","نفرض أن عدد الأرانب المشتراة <span class=\"tx\" data-t=\"x\"></span>؛ نسبة الأرانب إلى جميع الحيوانات"],["6(10+x)=140+x","بالضرب التبادلي"],["60+6x=140+x\\Rightarrow 5x=80","بالتبسيط"],["x=16","بقسمة الطرفين على <span class=m dir=ltr>5</span>"],["\\frac{26}{156}=\\frac{1}{6}","تحقق"]],"a":"يلزم شراء <span class=\"tx\" data-t=\"16\"></span> أرنبًا","o":""}],[{"n":"11","s":[["\\frac{2x-2}{x+1}=4","نساوي بين معادلتي المنحنيين"]],"a":"المعادلة: <span class=\"tx\" data-t=\"\\frac{2x-2}{x+1}=4\"></span>","o":"من الشكل: المنحنى يقطع المستقيم <span class=\"tx\" data-t=\"y=4\"></span> عند <span class=\"tx\" data-t=\"x=-3\"></span>"},{"n":"12","s":[["2x-2=4(x+1)","بالضرب التبادلي"],["2x-2=4x+4\\Rightarrow -2x=6","بالتبسيط"],["x=-3","بقسمة الطرفين على <span class=\"tx\" data-t=\"-2\"></span>"],["\\frac{2(-3)-2}{-3+1}=\\frac{-8}{-2}=4","تحقق"]],"a":"<span class=\"tx\" data-t=\"x=-3\"></span>، ونقطة التقاطع <span class=\"tx\" data-t=\"(-3,\\ 4)\"></span>","o":""}],[{"n":"13","s":[["\\frac{1}{x}+\\frac{1}{3x}=\\frac{1}{8}","نفرض أن خالدًا يحتاج <span class=\"tx\" data-t=\"x\"></span> ساعة وحده، فسعيد يحتاج <span class=\"tx\" data-t=\"3x\"></span> ساعة (أبطأ بثلاث مرات)"],["24+8=3x","بضرب الطرفين في (م.م.أ) <span class=\"tx\" data-t=\"24x\"></span>"],["x=\\frac{32}{3}\\approx 10.67","بقسمة الطرفين على <span class=m dir=ltr>3</span>"]],"a":"يستغرق خالد وحده <span class=\"tx\" data-t=\"\\frac{32}{3}\"></span> ساعة، أي <span class=\"tx\" data-t=\"10\\frac{2}{3}\"></span> ساعة <span class=m dir=ltr>(10</span> ساعات و<span class=m dir=ltr>40</span> دقيقة)","o":""}]]