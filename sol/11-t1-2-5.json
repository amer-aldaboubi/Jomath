[[{"n":"1","s":[["2AB+x=300","الجدار هو <span class=m dir=ltr>AD</span>، فالسياج <span class=m dir=ltr>AB + BC + CD</span>"],["AB=\\frac{300-x}{2}=150-\\frac x2",""]],"a":"<span class=\"tx\" data-t=\"AB=150-\\frac{x}{2}\"></span>","o":"","k":[{"e":"150 - x/2","a":null}]},{"n":"2","s":[["A(x)=x\\left(150-\\frac x2\\right)","المساحة <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["A(x)=150x-\\frac12x^2",""]],"a":"<span class=\"tx\" data-t=\"A(x)=150x-\\frac12x^2\"></span>","o":"","k":[{"e":"-x^2/2 + 150*x","a":null}]},{"n":"3","s":[["A'(x)=150-x=0\\Rightarrow x=150",""],["A''(x)=-1<0","قيمة عظمى"],["AB=150-75=75",""]],"a":"<span class=\"tx\" data-t=\"BC=150\\ \\text{m}\"></span>، <span class=\"tx\" data-t=\"AB=CD=75\\ \\text{m}\"></span> (المساحة <span class=\"tx\" data-t=\"11250\\ \\text{m}^2\"></span>)","o":"","k":[{"e":"150","a":null},{"e":"75","a":null},{"e":"11250","a":null}]}],[{"n":"4","s":[["xy=216\\Rightarrow y=\\frac{216}{x}","<span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span> بُعدا المنطقة، والسياج الفاصل موازٍ لـ <span class=m dir=ltr>y</span>"],["L=2x+3y=2x+\\frac{648}{x}","طول السياج"],["L'=2-\\frac{648}{x^2}=0\\Rightarrow x^2=324\\Rightarrow x=18",""],["L''=\\frac{1296}{x^3}>0","قيمة صغرى"],["y=12,\\quad L=36+36=72",""]],"a":"الأبعاد <span class=\"tx\" data-t=\"18\\ \\text{m}\\times12\\ \\text{m}\"></span>، وأقل طول للسياج <span class=\"tx\" data-t=\"72\\ \\text{m}\"></span>","o":"","k":[{"e":"216","a":null},{"e":"72","a":null}]}],[{"n":"5","s":[["V=x(30-2x)(20-2x)","الارتفاع <span class=m dir=ltr>x</span> والقاعدة <span class=m dir=ltr>(30 − 2x) × (20 − 2x)</span>"],["V(x)=4x^3-100x^2+600x,\\ 0<x<10",""]],"a":"<span class=\"tx\" data-t=\"V(x)=4x^3-100x^2+600x\"></span>","o":"","k":[{"e":"4*x^3 - 100*x^2 + 600*x","a":null}]},{"n":"6","s":[["V'(x)=12x^2-200x+600=0\\Rightarrow3x^2-50x+150=0",""],["x=\\frac{25\\pm5\\sqrt7}{3}","القانون العام"],["x=\\frac{25-5\\sqrt7}{3}\\approx3.92","الجذر الآخر ≈ <span class=m dir=ltr>12.74</span> خارج المجال"],["V''(3.92)=24(3.92)-200<0","قيمة عظمى"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{25-5\\sqrt7}{3}\\approx3.92\\ \\text{cm}\"></span> (أكبر حجم <span class=\"tx\" data-t=\"\\approx1056.3\\ \\text{cm}^3\"></span>)","o":"","k":[{"e":"3.92","a":true},{"e":"1056.3","a":true}]}],[{"n":"7","s":[["R(x)=x\\,s(x)=x(150-0.035x)","الإيراد <span class=m dir=ltr>=</span> عدد القطع <span class=m dir=ltr>×</span> السعر"],["R(x)=150x-0.035x^2",""]],"a":"<span class=\"tx\" data-t=\"R(x)=150x-0.035x^2\"></span>","o":"","k":[{"e":"-0.035*x^2 + 150*x","a":true}]},{"n":"8","s":[["R'(x)=150-0.07x,\\quad C'(x)=10+0.18x","الإيراد الحدي والتكلفة الحدية"],["150-0.07x=10+0.18x\\Rightarrow0.25x=140",""],["x=560",""]],"a":"<span class=\"tx\" data-t=\"560\"></span> قطعة","o":"","k":[{"e":"560","a":null}]},{"n":"9","s":[["P(x)=R(x)-C(x)",""],["=150x-0.035x^2-16000-10x-0.09x^2",""],["P(x)=-0.125x^2+140x-16000",""]],"a":"<span class=\"tx\" data-t=\"P(x)=-0.125x^2+140x-16000\"></span>","o":"","k":[{"e":"-0.125*x^2 + 140*x - 16000","a":true}]},{"n":"10","s":[["P'(x)=-0.25x+140=0\\Rightarrow x=560",""],["P''(x)=-0.25<0","قيمة عظمى"],["P(560)=-39200+78400-16000=23200",""]],"a":"<span class=\"tx\" data-t=\"560\"></span> قطعة، وأكبر ربح <span class=\"tx\" data-t=\"23200\"></span> دينار","o":"","k":[{"e":"560","a":null},{"e":"23200","a":null}]},{"n":"11","s":[["s(560)=150-0.035(560)=150-19.6=130.4",""]],"a":"<span class=\"tx\" data-t=\"130.4\"></span> دينارًا","o":"","k":[{"e":"130.4","a":true}]}],[{"n":"12","s":[["V=\\frac13\\pi r^2h,\\ h=60-r",""],["V(r)=\\frac{\\pi}{3}(60r^2-r^3)",""],["V'(r)=\\frac{\\pi}{3}(120r-3r^2)=\\pi r(40-r)=0\\Rightarrow r=40","<span class=m dir=ltr>r &gt; 0</span>"],["V''(40)=\\pi(40-80)<0","قيمة عظمى"],["h=20",""]],"a":"<span class=\"tx\" data-t=\"r=40\\ \\text{cm}\"></span>، <span class=\"tx\" data-t=\"h=20\\ \\text{cm}\"></span> (الحجم <span class=\"tx\" data-t=\"\\frac{32000\\pi}{3}\\approx33510.3\\ \\text{cm}^3\"></span>)","o":"","k":[{"e":"40","a":null},{"e":"20","a":null},{"e":"33510.3","a":true}]}],[{"n":"13","s":[["2r+s=200\\Rightarrow s=200-2r","<span class=m dir=ltr>s</span> طول القوس"],["A=\\frac12rs=\\frac12r(200-2r)","مساحة القطاع"],["A(r)=100r-r^2",""]],"a":"<span class=\"tx\" data-t=\"A(r)=100r-r^2\"></span>","o":"","k":[{"e":"-r^2 + 100*r","a":null}]},{"n":"14","s":[["A'(r)=100-2r=0\\Rightarrow r=50",""],["A''=-2<0","قيمة عظمى"],["A(50)=5000-2500=2500",""]],"a":"<span class=\"tx\" data-t=\"2500\\ \\text{cm}^2\"></span>","o":"","k":[{"e":"2500","a":null}]}],[{"n":"15","s":[["(9x^2-x^2)h=2000\\Rightarrow h=\\frac{250}{x^2}","حجم العلبة <span class=m dir=ltr>=</span> الحجم الخارجي <span class=m dir=ltr>−</span> حجم الفراغ"],["S=2(9x^2-x^2)+4(3x)h+4xh=16x^2+16xh","القاعدتان <span class=m dir=ltr>+</span> الأوجه الخارجية <span class=m dir=ltr>+</span> الأوجه الداخلية"],["S(x)=16x^2+\\frac{4000}{x}","بالتعويض عن <span class=m dir=ltr>h</span>"]],"a":"<span class=\"tx\" data-t=\"S(x)=16x^2+\\frac{4000}{x}\"></span>","o":"","k":[{"e":"16*x^2 + 4000/x","a":null}]},{"n":"16","s":[["S'(x)=32x-\\frac{4000}{x^2}=0\\Rightarrow x^3=125",""],["x=5",""],["S''(x)=32+\\frac{8000}{x^3}>0","قيمة صغرى"]],"a":"<span class=\"tx\" data-t=\"x=5\\ \\text{cm}\"></span> (والمساحة <span class=\"tx\" data-t=\"1200\\ \\text{cm}^2\"></span>)","o":"","k":[{"e":"5","a":null},{"e":"1200","a":null}]}],[{"n":"17","s":[["2x+2\\pi r=400\\Rightarrow x=200-\\pi r","المحيط"],["A=2r\\cdot x+\\pi r^2","مستطيل <span class=m dir=ltr>+</span> دائرة كاملة"],["A=2r(200-\\pi r)+\\pi r^2=400r-\\pi r^2",""]],"a":"<span class=\"tx\" data-t=\"A(r)=400r-\\pi r^2\"></span>","o":"","k":[{"e":"-pi*r^2 + 400*r","a":null}]},{"n":"18","s":[["A'(r)=400-2\\pi r=0\\Rightarrow r=\\frac{200}{\\pi}","القيمة الحرجة"],["x=200-\\pi\\cdot\\frac{200}{\\pi}=0","لا توجد أجزاء مستقيمة"],["A''(r)=-2\\pi<0","قيمة عظمى"]],"a":"عند القيمة الحرجة <span class=\"tx\" data-t=\"x=0\"></span> (المضمار دائرة)، والقيمة الحرجة عظمى","o":""}],[{"n":"33","s":[["8x+4h = 144 \\Rightarrow h = 36-2x","للصندوق <span class=m dir=ltr>8</span> أحرف طولها <span class=\"tx\" data-t=\"x\"></span> و <span class=m dir=ltr>4</span> أحرف طولها <span class=\"tx\" data-t=\"h\"></span> (الارتفاع)"],["V = x^2h = x^2(36-2x) = 36x^2-2x^3,\\quad 0<x<18","حجم الصندوق"],["V'(x) = 72x-6x^2 = 6x(12-x) = 0 \\Rightarrow x = 12","النقطة الحرجة (<span class=\"tx\" data-t=\"x=0\"></span> مرفوضة)"],["V''(x) = 72-12x \\Rightarrow V''(12) = -72 < 0","اختبار المشتقة الثانية: قيمة عظمى"],["h = 36-24 = 12,\\quad V = 12^2\\times 12 = 1728\\ \\text{cm}^3","أبعاد الصندوق وحجمه"]],"a":"<span class=\"tx\" data-t=\"x = 12\\ \\text{cm}\"></span> (والصندوق مكعب حجمه <span class=\"tx\" data-t=\"1728\\ \\text{cm}^3\"></span>)","o":"","k":[{"e":"12","a":null},{"e":"1728","a":null}]}],[{"n":"1","s":[["2(xy+2xy+2x^2) = 2700 \\Rightarrow 6xy+4x^2 = 2700","المساحة الكلية لسطح متوازي المستطيلات"],["y = \\frac{2700-4x^2}{6x} = \\frac{1350-2x^2}{3x}","بكتابة <span class=\"tx\" data-t=\"y\"></span> بدلالة <span class=\"tx\" data-t=\"x\"></span>"],["V = x\\times y\\times 2x = 2x^2\\times\\frac{1350-2x^2}{3x}","الحجم <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض <span class=m dir=ltr>×</span> الارتفاع"],["V(x) = 900x-\\frac{4}{3}x^3","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"V(x) = 900x-\\frac{4}{3}x^3\"></span>","o":"","k":[{"e":"-4*x^3/3 + 900*x","a":null}]},{"n":"2","s":[["V'(x) = 900-4x^2 = 0 \\Rightarrow x^2 = 225 \\Rightarrow x = 15","النقطة الحرجة (<span class=\"tx\" data-t=\"x&gt;0\"></span>)"],["V''(x) = -8x \\Rightarrow V''(15) = -120 < 0","اختبار المشتقة الثانية: قيمة عظمى"],["y = \\frac{1350-450}{45} = 20,\\quad V = 900(15)-\\frac{4}{3}(3375) = 9000","الأبعاد والحجم الأكبر"]],"a":"<span class=\"tx\" data-t=\"x = 15\\ \\text{cm}\"></span> (والحجم الأكبر <span class=\"tx\" data-t=\"9000\\ \\text{cm}^3\"></span>)","o":"","k":[{"e":"15","a":null},{"e":"9000","a":null}]}],[{"n":"3","s":[["R(x) = x\\times s(x) = x(150-0.5x)","الإيراد <span class=m dir=ltr>=</span> عدد البدلات <span class=m dir=ltr>×</span> سعر البدلة"],["R(x) = 150x-0.5x^2","بالتوزيع"]],"a":"<span class=\"tx\" data-t=\"R(x) = 150x-0.5x^2\"></span>","o":"","k":[{"e":"-0.5*x^2 + 150*x","a":true}]},{"n":"4","s":[["R'(x) = 150-x,\\quad C'(x) = 0.5x","الإيراد الحدي والتكلفة الحدية"],["150-x = 2(0.5x) \\Rightarrow 150 = 2x","الإيراد الحدي <span class=m dir=ltr>=</span> مثلا التكلفة الحدية"],["x = 75","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"75\"></span> بدلة","o":"","k":[{"e":"75","a":null}]},{"n":"5","s":[["P(x) = R(x)-C(x) = 150x-0.5x^2-4000-0.25x^2","الربح <span class=m dir=ltr>=</span> الإيراد <span class=m dir=ltr>−</span> التكلفة"],["P(x) = -0.75x^2+150x-4000","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(x) = -0.75x^2+150x-4000\"></span>","o":"","k":[{"e":"-0.75*x^2 + 150*x - 4000","a":true}]},{"n":"6","s":[["P'(x) = -1.5x+150 = 0 \\Rightarrow x = 100","النقطة الحرجة"],["P''(x) = -1.5 < 0","قيمة عظمى"],["P(100) = -7500+15000-4000 = 3500","أكبر ربح"]],"a":"يجب بيع <span class=\"tx\" data-t=\"100\"></span> بدلة، وأكبر ربح ممكن <span class=\"tx\" data-t=\"3500\"></span> دينار","o":""},{"n":"7","s":[["s(100) = 150-0.5(100) = 100","بالتعويض <span class=\"tx\" data-t=\"x=100\"></span> في اقتران السعر"]],"a":"سعر البدلة <span class=\"tx\" data-t=\"100\"></span> دينار","o":"","k":[{"e":"100","a":null}]}],[{"n":"8","s":[["2x+2y+\\pi x = 8 \\Rightarrow y = \\frac{8-2x-\\pi x}{2}","المحيط: قاعدة المستطيل <span class=\"tx\" data-t=\"2x\"></span> وضلعان <span class=\"tx\" data-t=\"y\"></span> ونصف محيط الدائرة <span class=\"tx\" data-t=\"\\pi x\"></span>"],["A = 2xy+\\frac{1}{2}\\pi x^2 = 8x-2x^2-\\frac{\\pi}{2}x^2","المساحة <span class=m dir=ltr>=</span> مساحة المستطيل <span class=m dir=ltr>+</span> مساحة نصف الدائرة"],["A'(x) = 8-4x-\\pi x = 0 \\Rightarrow x = \\frac{8}{4+\\pi}","النقطة الحرجة"],["A''(x) = -(4+\\pi) < 0","قيمة عظمى"],["y = \\frac{8-(2+\\pi)\\frac{8}{4+\\pi}}{2} = \\frac{8}{4+\\pi}","بالتعويض"],["x = y = \\frac{8}{4+\\pi} \\approx 1.12","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"x = y = \\frac{8}{4+\\pi} \\approx 1.12\\ \\text{m}\"></span>","o":"","k":[{"e":"1.12","a":true}]}],[{"n":"9","s":[["V = \\frac{1}{2}x^2 l = 864 \\Rightarrow l = \\frac{1728}{x^2}","حجم المنشور <span class=m dir=ltr>=</span> مساحة القاعدة <span class=m dir=ltr>×</span> الطول"],["S = 2\\times\\frac{1}{2}x^2+2xl = x^2+\\frac{3456}{x}","المساحة: مثلثان ومستطيلان (الوجه العلوي مفتوح)"],["S'(x) = 2x-\\frac{3456}{x^2} = 0 \\Rightarrow x^3 = 1728 \\Rightarrow x = 12","النقطة الحرجة"],["S''(x) = 2+\\frac{6912}{x^3} > 0","قيمة صغرى"],["l = \\frac{1728}{144} = 12,\\quad S = 144+288 = 432\\ \\text{cm}^2","الأبعاد وأقل مساحة"]],"a":"<span class=\"tx\" data-t=\"x = 12\\ \\text{cm}\"></span> و <span class=\"tx\" data-t=\"l = 12\\ \\text{cm}\"></span>؛ لأنّ المشتقة الثانية موجبة عند <span class=\"tx\" data-t=\"x=12\"></span> فتكون المساحة (المواد المستعملة) أقل ما يمكن <span class=\"tx\" data-t=\"432\\ \\text{cm}^2\"></span>","o":""}]]