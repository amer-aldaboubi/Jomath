3","عددان ناتج ضربهما الحد الثابت ومجموعهما معامل <span class=\"tx\" data-t=\"x\"></span>"],["x^2+3x-40=(x+8)(x-5)","التحليل"]],"a":"<span class=\"tx\" data-t=\"(x+8)(x-5)\"></span>","o":""},{"n":"7","s":[["17\\times(-1)=-17,\\;17-1=16","عددان ناتج ضربهما الحد الثابت ومجموعهما معامل <span class=\"tx\" data-t=\"x\"></span>"],["x^2+16x-17=(x+17)(x-1)","التحليل"]],"a":"<span class=\"tx\" data-t=\"(x+17)(x-1)\"></span>","o":""},{"n":"8","s":[["100+x^2-29x=x^2-29x+100","بالترتيب تنازليًّا"],["(-4)(-25)=100,\\;-4-25=-29","عددان ناتج ضربهما <span class=\"tx\" data-t=\"100\"></span> ومجموعهما <span class=\"tx\" data-t=\"-29\"></span>"],["=(x-4)(x-25)","التحليل"]],"a":"<span class=\"tx\" data-t=\"(x-4)(x-25)\"></span>","o":""},{"n":"9","s":[["100\\times(-1)=-100,\\;100-1=99","عددان ناتج ضربهما الحد الثابت ومجموعهما معامل <span class=\"tx\" data-t=\"x\"></span>"],["x^2+99x-100=(x+100)(x-1)","التحليل"]],"a":"<span class=\"tx\" data-t=\"(x+100)(x-1)\"></span>","o":""}],[{"n":"10","s":[["6=1\\times6=2\\times3=(-1)(-6)=(-2)(-3)","أزواج الأعداد الصحيحة التي ناتج ضربها <span class=\"tx\" data-t=\"6\"></span>"],["m=1+6,\\;2+3,\\;-1-6,\\;-2-3","<span class=\"tx\" data-t=\"m\"></span> <span class=m dir=ltr>=</span> مجموع العددين"],["m\\in\\{7,5,-7,-5\\}",""]],"a":"<span class=\"tx\" data-t=\"m=-7,-5,5,7\"></span>","o":""},{"n":"11","s":[["-10=1(-10)=(-1)(10)=2(-5)=(-2)(5)","أزواج الأعداد الصحيحة التي ناتج ضربها <span class=\"tx\" data-t=\"-10\"></span>"],["m=-9,\\;9,\\;-3,\\;3","<span class=\"tx\" data-t=\"m\"></span> <span class=m dir=ltr>=</span> مجموع العددين"]],"a":"<span class=\"tx\" data-t=\"m=-9,-3,3,9\"></span>","o":""},{"n":"12","s":[["p+q=-7,\\;pq=m>0","العددان لهما الإشارة نفسها ومجموعهما سالب، إذن كلاهما سالب"],["(-1,-6),\\;(-2,-5),\\;(-3,-4)","أزواج الأعداد الصحيحة السالبة التي مجموعها <span class=\"tx\" data-t=\"-7\"></span>"],["m=6,\\;10,\\;12","<span class=\"tx\" data-t=\"m\"></span> <span class=m dir=ltr>=</span> ناتج ضرب العددين"]],"a":"<span class=\"tx\" data-t=\"m=6,10,12\"></span>","o":""}],[{"n":"13","s":[["2x^3+4x^2-30x=2x(x^2+2x-15)","بإخراج العامل المشترك الأكبر <span class=\"tx\" data-t=\"2x\"></span>"],["5\\times(-3)=-15,\\;5-3=2","عددان ناتج ضربهما <span class=\"tx\" data-t=\"-15\"></span> ومجموعهما <span class=\"tx\" data-t=\"2\"></span>"],["=2x(x+5)(x-3)","التحليل"],["\\frac{V}{h}=\\frac{2x(x+5)(x-3)}{2x}=(x+5)(x-3)","مساحة القاعدة <span class=m dir=ltr>=</span> الحجم <span class=m dir=ltr>÷</span> الارتفاع <span class=\"tx\" data-t=\"2x\"></span>"]],"a":"بُعدا القاعدة: <span class=\"tx\" data-t=\"(x+5)\"></span> <span class=m dir=ltr>m</span> و <span class=\"tx\" data-t=\"(x-3)\"></span> <span class=m dir=ltr>m</span>","o":""}],[{"n":"14","s":[["2\\times12=24,\\;2+12=14","عددان ناتج ضربهما <span class=\"tx\" data-t=\"24\"></span> ومجموعهما <span class=\"tx\" data-t=\"14\"></span>"],["x^2+14x+24=(x+2)(x+12)","التحليل؛ بُعدا المستطيل <span class=\"tx\" data-t=\"(x+2)\"></span> و <span class=\"tx\" data-t=\"(x+12)\"></span>"],["P=2\\big[(x+2)+(x+12)\\big]=2(2x+14)=4x+28","محيط المستطيل"]],"a":"المحيط <span class=\"tx\" data-t=\"=(4x+28)\"></span> وحدة","o":"إجابة ممكنة بافتراض أن بُعدي المستطيل هما عاملا المقدار."}],[{"n":"15","s":[["x^2+22x+121=x^2+2(x)(11)+11^2","الحد الأول مربع، والأخير <span class=\"tx\" data-t=\"121=11^2\"></span>، والأوسط <span class=\"tx\" data-t=\"2\\times x\\times11\"></span>"],["=(x+11)^2=(x+11)(x+11)","مربع كامل"]],"a":"نعم، يمكن أن تكون الغرفة مربعة الشكل طول ضلعها <span class=\"tx\" data-t=\"(x+11)\"></span> مترًا؛ لأن المساحة مربع كامل (البعدان متساويان).","o":""}],[{"n":"16","s":[["(-3)(-5)=15,\\;-3-5=-8","عددان ناتج ضربهما <span class=\"tx\" data-t=\"15\"></span> ومجموعهما <span class=\"tx\" data-t=\"-8\"></span>"],["x^2-8x+15=(x-3)(x-5)","التحليل"],["L=\\frac{(x-3)(x-5)}{x-5}=x-3","الطول <span class=\"tx\" data-t=\"L\"></span> <span class=m dir=ltr>=</span> المساحة <span class=m dir=ltr>÷</span> العرض المعطى في الشكل <span class=\"tx\" data-t=\"(x-5)\"></span>"]],"a":"طول النافذة <span class=\"tx\" data-t=\"(x-3)\"></span> <span class=m dir=ltr>cm</span>","o":""},{"n":"17","s":[["\\frac{A_{1}}{A_{2}}=\\frac14=\\left(\\frac12\\right)^2","<span class=\"tx\" data-t=\"A_1\"></span> مساحة النافذة و <span class=\"tx\" data-t=\"A_2\"></span> مساحة الشاشة؛ النافذة تصغير للشاشة، ونسبة المساحتين <span class=m dir=ltr>=</span> مربع معامل التشابه"],["k=2","أبعاد الشاشة ضعف أبعاد النافذة"],["2(x-3)=2x-6","طول الشاشة"]],"a":"طول الشاشة <span class=\"tx\" data-t=\"(2x-6)\"></span> <span class=m dir=ltr>cm</span>","o":"وعرض الشاشة <span class=\"tx\" data-t=\"2(x-5)=2x-10\"></span> <span class=m dir=ltr>cm</span>."}],[{"n":"2","s":[["2\\times5=10,\\;2+5=7","عددان ناتج ضربهما <span class=\"tx\" data-t=\"10\"></span> ومجموعهما <span class=\"tx\" data-t=\"7\"></span>"],["x^2+7x+10=(x+5)(x+2)","التحليل"],["W=\\frac{(x+5)(x+2)}{x+5}=x+2","العرض <span class=m dir=ltr>=</span> المساحة <span class=m dir=ltr>÷</span> الطول"]],"a":"<span class=m dir=ltr>A)</span> <span class=\"tx\" data-t=\"x+2\"></span>","o":""}]]