[[{"n":"1","s":[["y=-6","من المعادلة الخطية"],["x^2+4x-2=-6","بالتعويض في المعادلة التربيعية"],["x^2+4x+4=0\\Rightarrow(x+2)^2=0","بإضافة <span class=m dir=ltr>6</span> للطرفين والتحليل"],["x=-2",""],["(-2)^2+4(-2)-2=-6\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(-2,\\,-6)\"></span>","o":"","k":[{"p":["-2","-6"]}]},{"n":"2","s":[["x^2+6x-3=2x-3","بمساواة قيمتي <span class=\"tx\" data-t=\"y\"></span>"],["x^2+4x=0\\Rightarrow x(x+4)=0","بالتبسيط والتحليل"],["x=0\\quad\\text{or}\\quad x=-4","خاصية الضرب الصفري"],["y=2(0)-3=-3,\\quad y=2(-4)-3=-11","بالتعويض في المعادلة الخطية"],["(-4)^2+6(-4)-3=-11\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,-3)\"></span> و <span class=\"tx\" data-t=\"(-4,\\,-11)\"></span>","o":"","k":[{"p":["0","-3"]},{"p":["-4","-11"]}]},{"n":"3","s":[["y=x+1","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2+4=x+1","بالتعويض في المعادلة التربيعية"],["x^2-x+3=0","بالتبسيط"],["b^2-4ac=1-12=-11<0","المميز سالب"]],"a":"لا يوجد حل للنظام (المستقيم لا يقطع المنحنى)","o":""},{"n":"4","s":[["y=\\frac{6-7x}{2}","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2+4x-1=\\frac{6-7x}{2}","بالتعويض"],["2x^2+15x-8=0","بضرب الطرفين في <span class=m dir=ltr>2</span> والتبسيط"],["(2x-1)(x+8)=0\\Rightarrow x=\\frac12\\quad\\text{or}\\quad x=-8","بالتحليل وخاصية الضرب الصفري"],["y=\\frac{6-3.5}{2}=\\frac54,\\qquad y=\\frac{6+56}{2}=31","بالتعويض في المعادلة الخطية"],["(-8)^2+4(-8)-1=31\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"\\left(\\frac12,\\,\\frac54\\right)\"></span> و <span class=\"tx\" data-t=\"(-8,\\,31)\"></span>","o":"","k":[{"p":["1/2","5/4"]},{"p":["-8","31"]}]},{"n":"5","s":[["y=3","من المعادلة الخطية"],["x^2+4x+7=3\\Rightarrow x^2+4x+4=0","بالتعويض"],["(x+2)^2=0\\Rightarrow x=-2","بالتحليل"],["(-2)^2+4(-2)+7=3\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(-2,\\,3)\"></span>","o":"","k":[{"p":["-2","3"]}]},{"n":"6","s":[["x^2-2x+4=x","بالتعويض <span class=\"tx\" data-t=\"y=x\"></span>"],["x^2-3x+4=0","بالتبسيط"],["b^2-4ac=9-16=-7<0","المميز سالب"]],"a":"لا يوجد حل للنظام","o":""},{"n":"7","s":[["y=2x-1","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2+(2x-1)^2=34","بالتعويض"],["5x^2-4x-33=0","بفك القوس والتبسيط"],["(5x+11)(x-3)=0\\Rightarrow x=3\\quad\\text{or}\\quad x=-\\frac{11}{5}","بالتحليل"],["y=5,\\qquad y=2\\left(-\\frac{11}{5}\\right)-1=-\\frac{27}{5}","بالتعويض في المعادلة الخطية"],["3^2+5^2=34\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"(3,\\,5)\"></span> و <span class=\"tx\" data-t=\"\\left(-\\frac{11}{5},\\,-\\frac{27}{5}\\right)\"></span>","o":"","k":[{"p":["3","5"]},{"p":["-11/5","-27/5"]}]},{"n":"8","s":[["x^2+2x+1=0","بالتعويض <span class=\"tx\" data-t=\"y=0\"></span>"],["(x+1)^2=0\\Rightarrow x=-1","بالتحليل"]],"a":"الحل: <span class=\"tx\" data-t=\"(-1,\\,0)\"></span> (المستقيم يمس المنحنى)","o":"","k":[{"p":["-1","0"]}]},{"n":"9","s":[["y=5-x","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2+(5-x)^2=4","بالتعويض"],["2x^2-10x+21=0","بالتبسيط"],["b^2-4ac=100-168=-68<0","المميز سالب"]],"a":"لا يوجد حل للنظام","o":""},{"n":"10","s":[["x=y+2","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"x\"></span>"],["(y+2)^2+y^2=10","بالتعويض"],["2y^2+4y-6=0\\Rightarrow y^2+2y-3=0","بالتبسيط والقسمة على <span class=m dir=ltr>2</span>"],["(y+3)(y-1)=0\\Rightarrow y=1\\quad\\text{or}\\quad y=-3","بالتحليل"],["x=3,\\qquad x=-1","بالتعويض في المعادلة الخطية"],["3^2+1^2=10,\\ (-1)^2+(-3)^2=10\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"(3,\\,1)\"></span> و <span class=\"tx\" data-t=\"(-1,\\,-3)\"></span>","o":"","k":[{"p":["3","1"]},{"p":["-1","-3"]}]},{"n":"11","s":[["1+(y-1)^2=17","بالتعويض <span class=\"tx\" data-t=\"x=1\"></span>"],["(y-1)^2=16","بطرح <span class=m dir=ltr>1</span> من الطرفين"],["y-1=\\pm4","بأخذ الجذر التربيعي"],["y=5\\quad\\text{or}\\quad y=-3",""]],"a":"الحلان: <span class=\"tx\" data-t=\"(1,\\,5)\"></span> و <span class=\"tx\" data-t=\"(1,\\,-3)\"></span>","o":"","k":[{"p":["1","5"]},{"p":["1","-3"]}]},{"n":"12","s":[["x=\\frac{5-3y}{2}","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"x\"></span>"],["2y^2+y\\cdot\\frac{5-3y}{2}=12","بالتعويض في المعادلة الثانية"],["y^2+5y-24=0","بضرب الطرفين في <span class=m dir=ltr>2</span> والتبسيط"],["(y+8)(y-3)=0\\Rightarrow y=3\\quad\\text{or}\\quad y=-8","بالتحليل"],["x=\\frac{5-9}{2}=-2,\\qquad x=\\frac{5+24}{2}=\\frac{29}{2}","بالتعويض في المعادلة الخطية"],["2(9)+(-2)(3)=12\\ \\checkmark","التحقق بالتعويض في المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"(-2,\\,3)\"></span> و <span class=\"tx\" data-t=\"\\left(\\frac{29}{2},\\,-8\\right)\"></span>","o":"","k":[{"p":["-2","3"]},{"p":["29/2","-8"]}]}],[{"n":"13","s":[["2(x+y)=16\\Rightarrow x+y=8,\\qquad x^2-y^2=16","بفرض البعدين <span class=\"tx\" data-t=\"x,y\"></span>: المحيط والفرق بين المربعين"],["y=8-x","بحل المعادلة الخطية لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2-(8-x)^2=16","بالتعويض"],["16x-64=16\\Rightarrow x=5","بالتبسيط"],["y=8-5=3","بالتعويض في المعادلة الخطية"]],"a":"بعدا البركة: <span class=\"tx\" data-t=\"5\\ \\text{m}\"></span> و <span class=\"tx\" data-t=\"3\\ \\text{m}\"></span>","o":"","k":[{"e":"5","a":null},{"e":"3","a":null}]}],[{"n":"14","s":[["x+y=12,\\qquad x^2-y^2=24","بفرض العددين <span class=\"tx\" data-t=\"x&gt;y&gt;0\"></span>"],["y=12-x","من المعادلة الخطية"],["x^2-(12-x)^2=24","بالتعويض"],["24x-144=24\\Rightarrow x=7","بالتبسيط"],["y=12-7=5","بالتعويض في المعادلة الخطية"]],"a":"العددان: <span class=\"tx\" data-t=\"7\"></span> و <span class=\"tx\" data-t=\"5\"></span>","o":"","k":[{"e":"7","a":null},{"e":"5","a":null}]}],[{"n":"15","s":[["2\\pi r_1+2\\pi r_2=12\\pi\\Rightarrow r_1+r_2=6","مجموع المحيطين، بالقسمة على <span class=\"tx\" data-t=\"2\\pi\"></span>"],["\\pi r_1^2+\\pi r_2^2=20\\pi\\Rightarrow r_1^2+r_2^2=20","مجموع المساحتين، بالقسمة على <span class=\"tx\" data-t=\"\\pi\"></span>"],["r_1^2+(6-r_1)^2=20","بتعويض <span class=\"tx\" data-t=\"r_2=6-r_1\"></span>"],["r_1^2-6r_1+8=0\\Rightarrow(r_1-2)(r_1-4)=0","بالتبسيط والتحليل"],["r_1=2,\\ r_2=4\\quad\\text{or}\\quad r_1=4,\\ r_2=2","خاصية الضرب الصفري"]],"a":"نصفا القطرين <span class=\"tx\" data-t=\"2\\ \\text{cm}\"></span> و <span class=\"tx\" data-t=\"4\\ \\text{cm}\"></span>، إذن القطران: <span class=\"tx\" data-t=\"4\\ \\text{cm}\"></span> و <span class=\"tx\" data-t=\"8\\ \\text{cm}\"></span>","o":""}],[{"n":"16","s":[["x=y+4,\\qquad x^2+y^2=346","بفرض عمر شيماء <span class=\"tx\" data-t=\"x\"></span> وعمر ريان <span class=\"tx\" data-t=\"y\"></span>"],["(y+4)^2+y^2=346","بالتعويض"],["2y^2+8y-330=0\\Rightarrow y^2+4y-165=0","بالتبسيط"],["(y+15)(y-11)=0\\Rightarrow y=11","بالتحليل (<span class=\"tx\" data-t=\"y=-15\"></span> مرفوض)"],["x=11+4=15","بالتعويض في المعادلة الخطية"]],"a":"عمر شيماء <span class=\"tx\" data-t=\"15\"></span> عامًا (وعمر ريان <span class=m dir=ltr>11</span> عامًا)","o":"التحقق: <span class=\"tx\" data-t=\"15^2+11^2=225+121=346\"></span>"}],[{"n":"17","s":[["l=2w,\\qquad l^2+w^2=\\left(\\sqrt{1.25}\\right)^2=1.25","الطول مثلا العرض، ونظرية فيثاغورس للقطر"],["(2w)^2+w^2=1.25\\Rightarrow5w^2=1.25","بالتعويض"],["w^2=0.25\\Rightarrow w=0.5","بالقسمة على <span class=m dir=ltr>5</span> وأخذ الجذر الموجب"],["l=2(0.5)=1","بالتعويض في المعادلة الخطية"],["P=2(1+0.5)=3\\ \\text{m}","محيط اللوحة <span class=m dir=ltr>=</span> طول الإطار"],["3\\times2.25=6.75","التكلفة <span class=m dir=ltr>=</span> المحيط <span class=m dir=ltr>×</span> سعر المتر"]],"a":"تكلفة الإطار <span class=\"tx\" data-t=\"6.75\"></span> دينار (أبعاد اللوحة <span class=\"tx\" data-t=\"1\\ \\text{m}\\times0.5\\ \\text{m}\"></span>)","o":"","k":[{"e":"6.75","a":true},{"e":"0.5","a":true}]}],[{"n":"18","s":[["x=y+1,\\qquad x^2+y^2=41","بفرض بعد منطقة الطماطم <span class=\"tx\" data-t=\"x\"></span> والبطاطا <span class=\"tx\" data-t=\"y\"></span>"],["(y+1)^2+y^2=41","بالتعويض"],["2y^2+2y-40=0\\Rightarrow y^2+y-20=0","بالتبسيط"],["(y+5)(y-4)=0\\Rightarrow y=4","بالتحليل (<span class=\"tx\" data-t=\"y=-5\"></span> مرفوض)"],["x=5\\Rightarrow x^2=25,\\ y^2=16","المساحتان"]],"a":"مساحة منطقة الطماطم <span class=\"tx\" data-t=\"25\\ \\text{m}^2\"></span>، ومساحة منطقة البطاطا <span class=\"tx\" data-t=\"16\\ \\text{m}^2\"></span>","o":""}],[{"n":"19","s":[["2+0.12x-0.002x^2=0.15x","بمساواة المعادلتين"],["0.002x^2+0.03x-2=0","بالتبسيط"],["x^2+15x-1000=0","بضرب الطرفين في <span class=m dir=ltr>500</span>"],["(x+40)(x-25)=0\\Rightarrow x=25","بالتحليل (<span class=\"tx\" data-t=\"x=-40\"></span> مرفوض لأن القذيفة تتجه لليمين)"],["y=0.15(25)=3.75","بالتعويض في المعادلة الخطية"]],"a":"نقطة الاصطدام: <span class=\"tx\" data-t=\"(25,\\ 3.75)\"></span>","o":"","k":[{"p":["25","3.75"]}]}],[{"n":"20","s":[["10-x^2=x+12","بتعويض <span class=\"tx\" data-t=\"y=10-x^2\"></span> في معادلة المستقيم"],["x^2+x+2=0","بالتبسيط"],["b^2-4ac=1-8=-7<0","المميز سالب"]],"a":"لا، لا يصل ماء النافورة إلى وحدة الإنارة؛ لأن النظام ليس له حل، أي إن المستقيم لا يقطع منحنى الماء","o":""}],[{"n":"21","s":[["2x^2+3x-5=3x+p","بمساواة المعادلتين"],["2x^2-(5+p)=0","بالتبسيط"],["b^2-4ac=0-4(2)(-5-p)=0","نقطة تقاطع واحدة ⇐ المميز <span class=m dir=ltr>= 0</span>"],["8(5+p)=0\\Rightarrow p=-5","بالحل"],["2x^2=0\\Rightarrow x=0,\\ y=-5","التحقق: نقطة التماس"]],"a":"<span class=\"tx\" data-t=\"p=-5\"></span> (والمستقيم <span class=\"tx\" data-t=\"y=3x-5\"></span> يمس المنحنى في النقطة <span class=\"tx\" data-t=\"(0,\\,-5)\"></span>)","o":"","k":[{"e":"-5","a":null},{"e":"3*x - 5","a":null},{"p":["0","-5"]}]}],[{"n":"22","s":[["y=0.4x+2.5","معادلة المستقيم الأزرق من الشكل: يقطع المحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"2.5\"></span> ويمر بالنقطة <span class=\"tx\" data-t=\"(-3,\\,1.3)\"></span>، فميله <span class=\"tx\" data-t=\"\\frac{1.2}{3}=0.4\"></span>"],["-0.3x^2+4=0.4x+2.5","بمساواة المعادلتين لإيجاد نقطتي التقاطع"],["3x^2+4x-15=0\\Rightarrow(3x-5)(x+3)=0","بضرب الطرفين في <span class=m dir=ltr>10</span> والتحليل"],["x=-3,\\ y=1.3;\\qquad x=\\frac53,\\ y=\\frac{19}{6}\\approx3.17","بالتعويض"],["h=\\frac53-(-3)=\\frac{14}{3}","ارتفاع شبه المنحرف (المسافة الأفقية)"],["A=\\frac12\\left(1.3+\\frac{19}{6}\\right)\\cdot\\frac{14}{3}=\\frac{469}{45}","مساحة شبه المنحرف <span class=m dir=ltr>=</span> نصف مجموع القاعدتين المتوازيتين <span class=m dir=ltr>×</span> الارتفاع"]],"a":"مساحة شبه المنحرف <span class=\"tx\" data-t=\"=\\frac{469}{45}\\approx10.42\"></span> وحدة مربعة","o":"القاعدتان المتوازيتان هما الضلعان الرأسيان بطولي <span class=\"tx\" data-t=\"1.3\"></span> و <span class=\"tx\" data-t=\"\\frac{19}{6}\"></span>؛ معادلة المستقيم مقروءة من الشبكة","k":[{"e":"10.42","a":true}]}],[{"n":"1","s":[["(2,0):\\ 2^2+0^2=4\\ \\checkmark,\\quad 3(2)+0=6\\ \\checkmark","بالتعويض في المعادلتين"],["(0,2):\\ 3(0)+2=2\\ne6","لا يحقق المعادلة الخطية"],["(1,3):\\ 1+9=10\\ne4","لا يحقق"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"(2,\\,0)\"></span>","o":"","k":[{"p":["2","0"]}]}],[{"n":"4","s":[["4x=5-x^2","بمساواة المعادلتين"],["x^2+4x-5=0\\Rightarrow(x+5)(x-1)=0","بالتبسيط والتحليل"],["x=1,\\ y=4;\\qquad x=-5,\\ y=-20","بالتعويض في <span class=\"tx\" data-t=\"y=4x\"></span>"],["5-(-5)^2=-20\\ \\checkmark","التحقق"]],"a":"الحلان: <span class=\"tx\" data-t=\"(1,\\,4)\"></span> و <span class=\"tx\" data-t=\"(-5,\\,-20)\"></span>","o":"","k":[{"p":["1","4"]},{"p":["-5","-20"]}]},{"n":"5","s":[["-x^2-x+12=x^2+7x+12","بمساواة المعادلتين"],["2x^2+8x=0\\Rightarrow2x(x+4)=0","بالتبسيط والتحليل"],["x=0,\\ y=12;\\qquad x=-4,\\ y=16-28+12=0","بالتعويض في إحدى المعادلتين"],["-16+4+12=0\\ \\checkmark","التحقق"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,12)\"></span> و <span class=\"tx\" data-t=\"(-4,\\,0)\"></span>","o":"","k":[{"p":["0","12"]},{"p":["-4","0"]}]}],[{"n":"10","s":[["xy=224,\\qquad(x-1)(y+1)=225","المساحة الأصلية، والجديدة تزيد <span class=m dir=ltr>1</span>"],["xy+x-y-1=225\\Rightarrow224+x-y-1=225","بفك الأقواس وتعويض <span class=\"tx\" data-t=\"xy=224\"></span>"],["x-y=2\\Rightarrow x=y+2","بالتبسيط"],["(y+2)y=224\\Rightarrow y^2+2y-224=0","بالتعويض في <span class=\"tx\" data-t=\"xy=224\"></span>"],["(y+16)(y-14)=0\\Rightarrow y=14","بالتحليل (<span class=\"tx\" data-t=\"y=-16\"></span> مرفوض)"],["x=16","بالتعويض في المعادلة الخطية"]],"a":"أبعاد الملعب: الطول <span class=\"tx\" data-t=\"16\\ \\text{m}\"></span> والعرض <span class=\"tx\" data-t=\"14\\ \\text{m}\"></span>","o":"","k":[{"e":"16","a":null},{"e":"14","a":null}]}],[{"n":"11","s":[["x^2+3x-1=2x+p","بمساواة المعادلتين"],["x^2+x-(1+p)=0","بالتبسيط"],["b^2-4ac<0\\Rightarrow1+4(1+p)<0","لا تقاطع ⇐ المميز سالب"],["5+4p<0\\Rightarrow p<-\\frac54","بالحل"]],"a":"<span class=\"tx\" data-t=\"p&lt;-\\frac54\"></span>","o":"","k":[{"i":"<","x":"p","e":"-5/4"}]}],[{"n":"12","s":[["X+Y=12,\\qquad X^2+Y^2=90","من المعطيات"],["X^2+(12-X)^2=90","بتعويض <span class=\"tx\" data-t=\"Y=12-X\"></span>"],["2X^2-24X+54=0\\Rightarrow X^2-12X+27=0","بالتبسيط"],["(X-3)(X-9)=0\\Rightarrow X=3\\quad\\text{or}\\quad X=9","بالتحليل"],["Y=9\\quad\\text{or}\\quad Y=3","بالتعويض في المعادلة الخطية"]],"a":"<span class=\"tx\" data-t=\"X=3,\\ Y=9\"></span> (الرقم <span class=\"tx\" data-t=\"391290\"></span>) أو <span class=\"tx\" data-t=\"X=9,\\ Y=3\"></span> (الرقم <span class=\"tx\" data-t=\"931290\"></span>)","o":"","k":[{"e":"3","a":null},{"e":"9","a":null},{"e":"391290","a":null},{"e":"9","a":null},{"e":"3","a":null},{"e":"931290","a":null}]}],[{"n":"1","s":[["3x^2+5x-2=7x+15","بمساواة قيمتي <span class=\"tx\" data-t=\"y\"></span>"],["3x^2-2x-17=0","بالتبسيط"],["x=\\frac{2\\pm\\sqrt{4+204}}{6}=\\frac{1\\pm2\\sqrt{13}}{3}","بالقانون العام"],["x\\approx2.74\\Rightarrow y\\approx34.16;\\quad x\\approx-2.07\\Rightarrow y\\approx0.51","بالتعويض في <span class=\"tx\" data-t=\"y=7x+15\"></span>"]],"a":"الحلان: <span cl