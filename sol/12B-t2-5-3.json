[[{"n":"1","s":[["P(X>\\mu)=50\\%","المنحنى متماثل حول الوسط الحسابي"]],"a":"<span class=\"tx\" data-t=\"50\\%\"></span>","o":""},{"n":"2","s":[["P(\\mu-\\sigma<X<\\mu+\\sigma)","البعد عن الوسط لا يزيد على انحراف معياري واحد"],["=34\\%+34\\%=68\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"68\\%\"></span>","o":""},{"n":"3","s":[["P(\\mu<X<\\mu+2\\sigma)","تزيد على الوسط بما لا يزيد على انحرافين"],["=34\\%+13.5\\%=47.5\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"47.5\\%\"></span>","o":""},{"n":"4","s":[["P(\\mu-3\\sigma<X<\\mu+\\sigma)","من <span class=\"tx\" data-t=\"\\mu-3\\sigma\"></span> إلى <span class=\"tx\" data-t=\"\\mu+\\sigma\"></span>"],["=2.35\\%+13.5\\%+34\\%+34\\%","القاعدة التجريبية"],["=83.85\\%","بالجمع"]],"a":"<span class=\"tx\" data-t=\"83.85\\%\"></span>","o":""}],[{"n":"5","s":[["P(\\mu-3\\sigma<X<\\mu-\\sigma)","المنطقة المظللة"],["=2.35\\%+13.5\\%=15.85\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"15.85\\%\"></span>","o":""},{"n":"6","s":[["P(\\mu-2\\sigma<X<\\mu-\\sigma)+P(\\mu+\\sigma<X<\\mu+2\\sigma)","منطقتان مظللتان"],["=13.5\\%+13.5\\%=27\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"27\\%\"></span>","o":""},{"n":"7","s":[["P(\\mu<X<\\mu+2\\sigma)","المنطقة المظللة"],["=34\\%+13.5\\%=47.5\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"47.5\\%\"></span>","o":""},{"n":"8","s":[["P(\\mu-2\\sigma<X<\\mu-\\sigma)+P(\\mu<X<\\mu+\\sigma)","منطقتان مظللتان"],["=13.5\\%+34\\%=47.5\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"47.5\\%\"></span>","o":""}],[{"n":"9","s":[["\\mu_A=15,\\ \\mu_B=12","محور التماثل لكل منحنى"],["\\mu_A>\\mu_B","منحنى <span class=m dir=ltr>A</span> يقع إلى اليمين"],["\\sigma_A<\\sigma_B","منحنى <span class=m dir=ltr>A</span> أعلى وأضيق، و <span class=m dir=ltr>B</span> منخفض ومنبسط"]],"a":"الوسط الحسابي لـ <span class=m dir=ltr>A (</span><span class=\"tx\" data-t=\"15\"></span>) أكبر من الوسط الحسابي لـ <span class=m dir=ltr>B (</span><span class=\"tx\" data-t=\"12\"></span>)، والانحراف المعياري لـ <span class=m dir=ltr>A</span> أصغر من الانحراف المعياري لـ <span class=m dir=ltr>B (</span>بيانات <span class=m dir=ltr>A</span> أقل تشتّتًا).","o":""}],[{"n":"10","s":[["\\mu=79,\\ \\sigma=\\sqrt{144}=12","من <span class=\"tx\" data-t=\"X\\sim N(\\mu,\\sigma^2)\"></span>"],["P(X<79)=P(X<\\mu)=0.5","التماثل حول الوسط"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;79)=0.5\"></span>","o":""},{"n":"11","s":[["67=\\mu-\\sigma,\\ 91=\\mu+\\sigma","<span class=\"tx\" data-t=\"79\\mp12\"></span>"],["P(\\mu-\\sigma<X<\\mu+\\sigma)=0.68","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(67&lt;X&lt;91)=0.68\"></span>","o":""},{"n":"12","s":[["91=\\mu+\\sigma","<span class=\"tx\" data-t=\"79+12\"></span>"],["P(X>\\mu+\\sigma)=0.5-0.34=0.16","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;91)=0.16\"></span>","o":""},{"n":"13","s":[["103=\\mu+2\\sigma","<span class=\"tx\" data-t=\"79+24\"></span>"],["P(X>\\mu+2\\sigma)=0.5-0.475=0.025","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;103)=0.025\"></span>","o":""},{"n":"14","s":[["43=\\mu-3\\sigma,\\ 115=\\mu+3\\sigma","<span class=\"tx\" data-t=\"79\\mp36\"></span>"],["P(\\mu-3\\sigma<X<\\mu+3\\sigma)=0.997","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(43&lt;X&lt;115)=0.997\"></span>","o":""},{"n":"15","s":[["43=\\mu-3\\sigma","<span class=\"tx\" data-t=\"79-36\"></span>"],["P(X<\\mu-3\\sigma)=\\frac{1-0.997}{2}=0.0015","التماثل والقاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;43)=0.0015\"></span>","o":""}],[{"n":"16","s":[["\\mu=167,\\ \\sigma=8","المعطيات"],["P(X<167)=P(X<\\mu)=0.5","التماثل حول الوسط"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;167)=0.5\"></span>","o":""},{"n":"17","s":[["159=\\mu-\\sigma","<span class=\"tx\" data-t=\"167-8\"></span>"],["P(\\mu-\\sigma<X<\\mu)=0.34","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(159&lt;X&lt;167)=0.34\"></span>","o":""},{"n":"18","s":[["151=\\mu-2\\sigma,\\ 175=\\mu+\\sigma","<span class=\"tx\" data-t=\"167-16\"></span> و <span class=\"tx\" data-t=\"167+8\"></span>"],["P=13.5\\%+34\\%+34\\%","القاعدة التجريبية"],["=81.5\\%=0.815","بالجمع"]],"a":"<span class=\"tx\" data-t=\"P(151&lt;X&lt;175)=0.815\"></span>","o":""}],[{"n":"19","s":[["\\mu=50,\\ \\sigma=2,\\ 54=\\mu+2\\sigma","<span class=\"tx\" data-t=\"50+4\"></span>"],["P(X>\\mu+2\\sigma)=0.5-0.475=0.025","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;54)=0.025\"></span>","o":""},{"n":"20","s":[["44=\\mu-3\\sigma,\\ 52=\\mu+\\sigma","<span class=\"tx\" data-t=\"50-6\"></span> و <span class=\"tx\" data-t=\"50+2\"></span>"],["P=2.35\\%+13.5\\%+34\\%+34\\%","القاعدة التجريبية"],["=83.85\\%=0.8385","بالجمع"]],"a":"<span class=\"tx\" data-t=\"P(44&lt;X&lt;52)=0.8385\"></span>","o":""}],[{"n":"21","s":[["X\\sim N(\\mu,\\sigma^{2})","الوسيط الثاني هو التباين لا الانحراف المعياري"],["\\mu=4^{2}=16","الوسيط الأول هو الوسط الحسابي"],["\\sigma^{2}=t^{2}\\Rightarrow \\sigma=t","الانحراف المعياري هو الجذر التربيعي للتباين"]],"a":"الخطأ: الوسط الحسابي ليس <span class=\"tx\" data-t=\"4\"></span> بل <span class=\"tx\" data-t=\"16\"></span>، والانحراف المعياري ليس <span class=\"tx\" data-t=\"t^2\"></span> بل <span class=\"tx\" data-t=\"t\"></span> (و <span class=\"tx\" data-t=\"t^2\"></span> هو التباين). الصحيح: الوسط الحسابي <span class=\"tx\" data-t=\"16\"></span> والانحراف المعياري <span class=\"tx\" data-t=\"t\"></span>.","o":""}],[{"n":"22","s":[["P(\\mu-\\sigma<X<\\mu+\\sigma)=68\\%","القاعدة التجريبية"],["\\mu-\\sigma=93,\\ \\mu+\\sigma=107","الفترة متماثلة حول <span class=\"tx\" data-t=\"\\mu=100\"></span>"],["\\sigma=107-100=7","بالطرح"],["\\sigma^{2}=49","بالتربيع"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2=49\"></span>؛ لأن <span class=m dir=ltr>68%</span> من البيانات تقع ضمن انحراف معياري واحد عن الوسط، و <span class=\"tx\" data-t=\"100\\pm7\"></span> تعطي <span class=\"tx\" data-t=\"93\"></span> و <span class=\"tx\" data-t=\"107\"></span>.","o":""}],[{"n":"23","s":[["P(X\\le\\mu+a)=0.23<0.5","الاحتمال أقل من <span class=m dir=ltr>0.5</span>"],["\\mu+a<\\mu\\Rightarrow a<0","إذن <span class=\"tx\" data-t=\"\\mu+a\"></span> يقع يسار الوسط"],["\\mu-a>\\mu+a","لأن <span class=\"tx\" data-t=\"a\"></span> سالب"],["P(\\mu-a\\le X\\le\\mu+a)=0","الحد الأدنى أكبر من الحد الأعلى: الحادث مستحيل"],["P(\\mu+a\\le X\\le\\mu-a)=1-2(0.23)=0.54","للمقارنة: بالتماثل حول الوسط"]],"a":"<span class=\"tx\" data-t=\"P(\\mu-a\\le X\\le\\mu+a)=0\"></span>؛ لأن <span class=\"tx\" data-t=\"a&lt;0\"></span> فتكون الفترة خالية. (أما الفترة المعكوسة <span class=\"tx\" data-t=\"P(\\mu+a\\le X\\le\\mu-a)=0.54\"></span>)","o":"إذا قصد السؤال الفترة الواقعة بين القيمتين فالجواب <span class=m dir=ltr>0.54</span>."}],[{"n":"24","s":[["16\\%=50\\%-34\\%","نسبة البيانات الأقل من <span class=\"tx\" data-t=\"\\mu-\\sigma\"></span> (القاعدة التجريبية)"],["P(X<\\mu-\\sigma)=0.16","إذن علامة النجاح هي <span class=\"tx\" data-t=\"\\mu-\\sigma\"></span>"],["\\mu-\\sigma=68-15=53","بالتعويض"]],"a":"علامة النجاح <span class=\"tx\" data-t=\"53\"></span>.","o":""}],[{"n":"5","s":[["P(\\mu-3\\sigma<X<\\mu+3\\sigma)\\approx 99.7\\%","القاعدة التجريبية"]],"a":"الإجابة <span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"99.7\\%\"></span>","o":""}],[{"n":"1","s":[["P(X>\\mu)=50\\%","المنحنى متماثل حول الوسط الحسابي"]],"a":"<span class=\"tx\" data-t=\"50\\%\"></span>","o":""},{"n":"2","s":[["P(\\mu-\\sigma<X<\\mu+\\sigma)\\approx68\\%","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"68\\%\"></span>","o":""},{"n":"3","s":[["P(\\mu-2\\sigma<X<\\mu)=\\frac{95\\%}{2}","القاعدة التجريبية والتماثل"],["=47.5\\%",""]],"a":"<span class=\"tx\" data-t=\"47.5\\%\"></span>","o":""},{"n":"4","s":[["P(\\mu-\\sigma<X<\\mu+2\\sigma)=\\frac{68\\%}{2}+\\frac{95\\%}{2}","القاعدة التجريبية والتماثل"],["=34\\%+47.5\\%=81.5\\%","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"81.5\\%\"></span>","o":""}],[{"n":"5","s":[["\\mu=21","محور تماثل المنحنى عند <span class=m dir=ltr>21</span>"],["2\\sigma=3\\Rightarrow\\sigma=1.5","من الشكل"],["21\\pm3(1.5)=16.5,\\ 25.5","تحقق: طرفا المنحنى عند <span class=\"tx\" data-t=\"\\mu\\pm3\\sigma\"></span>"],["\\sigma^2=2.25",""]],"a":"<span class=\"tx\" data-t=\"X\\sim N(21,\\ 1.5^2)\"></span> أي <span class=\"tx\" data-t=\"X\\sim N(21,\\ 2.25)\"></span>","o":""}],[{"n":"6","s":[["x=10","القمة عند <span class=m dir=ltr>10</span>، لكن المنحنى ينحدر يمينها بسرعة ويسارها ببطء، فهو غير متماثل (ملتوٍ)"]],"a":"لا يمثل توزيعًا طبيعيًّا لأنه غير متماثل حول الخط الرأسي المار بقمته، والمنحنى الطبيعي جرسيّ متماثل حول الوسط","o":""},{"n":"7","s":[["x=23","عند <span class=m dir=ltr>23</span> قيمة صغرى للمنحنى لا قيمة عظمى"]],"a":"لا يمثل توزيعًا طبيعيًّا لأنه ليس جرسيّ الشكل: له قيمة صغرى (لا عظمى) عند الوسط، ولا يقترب من المحور الأفقي عند الطرفين","o":""}],[{"n":"8","s":[["\\mu=8,\\ \\sigma=\\sqrt{0.04}=0.2","من <span class=\"tx\" data-t=\"X\\sim N(8,0.04)\"></span>"],["P(X>8)=P(X>\\mu)=0.5","التماثل حول الوسط"]],"a":"<span class=\"tx\" data-t=\"0.5\"></span>","o":""},{"n":"9","s":[["7.8=\\mu-\\sigma,\\quad 8.2=\\mu+\\sigma","<span class=\"tx\" data-t=\"8\\pm0.2\"></span>"],["P(\\mu-\\sigma<X<\\mu+\\sigma)\\approx0.68","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"\\approx0.68\"></span>","o":""},{"n":"10","s":[["8.4=8+2(0.2)=\\mu+2\\sigma",""],["P(X>\\mu+2\\sigma)=\\frac{1-0.95}{2}","القاعدة التجريبية والتماثل"],["=0.025","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"0.025\"></span>","o":""}],[{"n":"11","s":[["\\mu=\\frac{2.3+2.7}{2}=2.5\\ \\text{mm}","المنحنى متماثل حول الوسط"],["P(2.3<X<2.7)=100\\%-2(2.5\\%)=95\\%","من الشكل"],["\\mu+2\\sigma=2.7\\Rightarrow2\\sigma=0.2","القاعدة التجريبية: <span class=m dir=ltr>95%</span> ضمن انحرافين"],["\\sigma=0.1\\ \\text{mm}",""]],"a":"<span class=\"tx\" data-t=\"\\mu=2.5\\ \\text{mm},\\ \\sigma=0.1\\ \\text{mm}\"></span>","o":""},{"n":"12","s":[["P(\\mu<X<\\mu+2\\sigma)=\\frac{95\\%}{2}","القاعدة التجريبية والتماثل"],["=47.5\\%",""]],"a":"<span class=\"tx\" data-t=\"