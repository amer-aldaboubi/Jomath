le + t\\langle 12, -4, -8 \\rangle","باستعمال النقطة الأولى"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle -2, 9, 1 \\rangle + t\\langle 12, -4, -8 \\rangle\"></span>","o":"إجابة ممكنة؛ يمكن استعمال النقطة الأخرى أو أي مضاعف لمتجه الاتجاه."}],[{"n":"15","s":[["\\langle -2+t, 2+2t, -1-t \\rangle = \\langle 4-u, 4+3u, -7+u \\rangle","نساوي المعادلتين"],["-2 + t = 4 - u,\\quad 2 + 2t = 4 + 3u","المركبتان الأولى والثانية"],["t = 4,\\ u = 2","بحل النظام"],["-1 - 4 = -5,\\quad -7 + 2 = -5","التحقق في المركبة الثالثة"],["\\langle -2, 2, -1 \\rangle + 4\\langle 1, 2, -1 \\rangle = \\langle 2, 10, -5 \\rangle","بالتعويض <span class=m dir=ltr>t = 4</span>"]],"a":"نقطة التقاطع <span class=\"tx\" data-t=\"(2, 10, -5)\"></span>","o":"","k":[{"p":["2","10","-5"]}]}],[{"n":"16","s":[["\\overrightarrow{EF} = \\langle -14, 14, 21 \\rangle = 7\\langle -2, 2, 3 \\rangle,\\quad \\overrightarrow{GH} = \\langle -6, 6, 9 \\rangle = 3\\langle -2, 2, 3 \\rangle","متجها الاتجاه"],["\\overrightarrow{EF} = \\frac{7}{3}\\overrightarrow{GH}","المتجهان متوازيان"],["\\overrightarrow{EG} = \\langle 5, 4, -1 \\rangle","نتحقق: هل <span class=m dir=ltr>G</span> على <span class=m dir=ltr>l_1</span>؟"],["\\langle 5, 4, -1 \\rangle \\ne k\\langle -2, 2, 3 \\rangle","<span class=m dir=ltr>EG</span> لا يوازي <span class=m dir=ltr>EF</span> فالمستقيمان غير منطبقين"]],"a":"المستقيمان متوازيان (غير منطبقين)","o":""},{"n":"17","s":[["l_1: \\vec{r} = \\langle 3, 7, -9 \\rangle + t\\langle -1, -11, 12 \\rangle,\\quad l_2: \\vec{r} = \\langle 24, 14, -29 \\rangle + u\\langle -21, -35, 49 \\rangle","معادلتا المستقيمين"],["3 - t = 24 - 21u,\\quad 7 - 11t = 14 - 35u","المتجهان غير متوازيين؛ نساوي المركبات"],["t = 3,\\ u = \\frac{8}{7}","بحل النظام"],["-9 + 12(3) = 27,\\quad -29 + 49\\left(\\frac{8}{7}\\right) = 27","التحقق في المركبة الثالثة"],["\\langle 3, 7, -9 \\rangle + 3\\langle -1, -11, 12 \\rangle = \\langle 0, -26, 27 \\rangle","بالتعويض <span class=m dir=ltr>t = 3</span>"]],"a":"المستقيمان متقاطعان في النقطة <span class=\"tx\" data-t=\"(0, -26, 27)\"></span>","o":"","k":[{"p":["0","-26","27"]}]}],[{"n":"18","s":[["\\overrightarrow{AB} = \\langle 12, -4, -8 \\rangle","متجه الاتجاه"],["\\vec{r} = \\langle -2, 9, 1 \\rangle + t\\langle 12, -4, -8 \\rangle","المعادلة المتجهة"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle -2, 9, 1 \\rangle + t\\langle 12, -4, -8 \\rangle\"></span>","o":"إجابة ممكنة."},{"n":"19","s":[["-2 + 12t = 19 \\Rightarrow t = \\frac{7}{4}","من المركبة الأولى"],["9 - 4\\left(\\frac{7}{4}\\right) = 2,\\quad 1 - 8\\left(\\frac{7}{4}\\right) = -13","التحقق من المركبتين الأخريين"]],"a":"عند <span class=\"tx\" data-t=\"t = \\frac{7}{4}\"></span> نحصل على <span class=\"tx\" data-t=\"(19, 2, -13)\"></span>، إذن النقطة تقع على المستقيم","o":""},{"n":"20","s":[["-2 + 12t = 1 \\Rightarrow t = \\frac{1}{4}","المركبة الأولى"],["1 - 8\\left(\\frac{1}{4}\\right) = -1","التحقق من المركبة الثالثة"],["a = 9 - 4\\left(\\frac{1}{4}\\right) = 8","المركبة الثانية"]],"a":"<span class=\"tx\" data-t=\"a = 8\"></span>","o":"","k":[{"e":"8","a":null}]},{"n":"21","s":[["-2 + 12t = -8 \\Rightarrow t = -\\frac{1}{2}","المركبة الأولى"],["b = 9 - 4\\left(-\\frac{1}{2}\\right) = 11","المركبة الثانية"],["c = 1 - 8\\left(-\\frac{1}{2}\\right) = 5","المركبة الثالثة"]],"a":"<span class=\"tx\" data-t=\"b = 11\"></span>، <span class=\"tx\" data-t=\"c = 5\"></span>","o":"","k":[{"e":"11","a":null},{"e":"5","a":null}]},{"n":"22","s":[["y = 9 - 4t = 0 \\Rightarrow t = \\frac{9}{4}","في المستوى <span class=m dir=ltr>xz</span> يكون <span class=m dir=ltr>y = 0</span>"],["x = -2 + 12\\left(\\frac{9}{4}\\right) = 25,\\quad z = 1 - 8\\left(\\frac{9}{4}\\right) = -17","بالتعويض"]],"a":"النقطة <span class=\"tx\" data-t=\"(25, 0, -17)\"></span>","o":"","k":[{"p":["25","0","-17"]}]}],[{"n":"23","s":[["3\\vec{n} + b\\vec{m} = \\langle -15 + b, 12 - 2b, 3a + 3b \\rangle","ضرب المتجه في عدد ثم الجمع"],["\\langle -15 + b, 12 - 2b, 3a + 3b \\rangle = k\\langle 3, -3, 5 \\rangle","شرط التوازي"],["-15 + b = 3k,\\quad 12 - 2b = -3k","المركبتان الأولى والثانية"],["-3 - b = 0 \\Rightarrow b = -3,\\quad k = -6","بجمع المعادلتين"],["3a - 9 = 5(-6) \\Rightarrow a = -7","المركبة الثالثة"]],"a":"<span class=\"tx\" data-t=\"a = -7\"></span>، <span class=\"tx\" data-t=\"b = -3\"></span>","o":"","k":[{"e":"-7","a":null},{"e":"-3","a":null}]}],[{"n":"24","s":[["\\vec{v} = \\langle 3a + b, -5a + 4b, 6a + bc \\rangle","بالضرب والجمع"],["3a + b = 0,\\quad 6a + bc = 0,\\quad -5a + 4b = 34","اتجاه <span class=m dir=ltr>y</span> الموجب: المركبتان <span class=m dir=ltr>x</span> و <span class=m dir=ltr>z</span> صفر، و <span class=m dir=ltr>|v| = 34 =</span> المركبة <span class=m dir=ltr>y</span>"],["b = -3a \\Rightarrow -5a - 12a = 34 \\Rightarrow a = -2,\\ b = 6","بالتعويض"],["6(-2) + 6c = 0 \\Rightarrow c = 2","المركبة الثالثة"],["\\vec{v} = \\langle 0, 34, 0 \\rangle","التحقق"]],"a":"<span class=\"tx\" data-t=\"a = -2\"></span>، <span class=\"tx\" data-t=\"b = 6\"></span>، <span class=\"tx\" data-t=\"c = 2\"></span>","o":"","k":[{"e":"-2","a":null},{"e":"6","a":null},{"e":"2","a":null}]}],[{"n":"25","s":[["\\overrightarrow{BC} = \\vec{c} - \\vec{b} = \\langle 18, -12, 6 \\rangle = 6\\langle 3, -2, 1 \\rangle","النقاط على مستقيم واحد"],["\\overrightarrow{BA} = \\vec{a} - \\vec{b} = \\langle 6, p - 13, q + 1 \\rangle = k\\langle 3, -2, 1 \\rangle","<span class=m dir=ltr>BA</span> يوازي <span class=m dir=ltr>BC</span>"],["6 = 3k \\Rightarrow k = 2","المركبة الأولى"],["p - 13 = -4 \\Rightarrow p = 9","المركبة الثانية"]],"a":"<span class=\"tx\" data-t=\"p = 9\"></span>","o":"","k":[{"e":"9","a":null}]},{"n":"26","s":[["q + 1 = 2(1) = 2","المركبة الثالثة <span class=m dir=ltr>(k = 2)</span>"],["q = 1","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"q = 1\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"27","s":[["\\overrightarrow{AB} = \\langle -6, 4, -2 \\rangle,\\ \\vec{r} = \\langle 2, 9, 1 \\rangle + t\\langle -6, 4, -2 \\rangle","معادلة المستقيم <span class=m dir=ltr>AB (p = 9, q = 1)</span>"],["2 - 6t = 0 \\Rightarrow t = \\frac{1}{3}","في المستوى <span class=m dir=ltr>yz</span> يكون <span class=m dir=ltr>x = 0</span>"],["y = 9 + \\frac{4}{3} = \\frac{31}{3},\\quad z = 1 - \\frac{2}{3} = \\frac{1}{3}","بالتعويض"]],"a":"نقطة التقاطع <span class=\"tx\" data-t=\"\\left(0, \\frac{31}{3}, \\frac{1}{3}\\right)\"></span>","o":"","k":[{"p":["0","31/3","1/3"]}]},{"n":"28","s":[["\\overrightarrow{AC} = \\langle 12, -8, 4 \\rangle","<span class=m dir=ltr>c − a</span>"],["|\\overrightarrow{AC}| = \\sqrt{144 + 64 + 16} = \\sqrt{224} = \\sqrt{16 \\times 14} = 4\\sqrt{14}","صيغة المقدار"]],"a":"<span class=\"tx\" data-t=\"AC = 4\\sqrt{14}\"></span>، أي <span class=\"tx\" data-t=\"a = 4\"></span>","o":"","k":[{"e":"4*sqrt(14)","a":null},{"e":"4","a":null}]}],[{"n":"29","s":[["m = \\frac{3 - 2}{2 - 1} = 1 \\Rightarrow y - 2 = 1(x - 1) \\Rightarrow y = x + 1","معادلة المستقيم بصيغة الميل ونقطة"],["\\overrightarrow{AB} = \\langle 1, 1 \\rangle,\\ \\vec{r} = \\langle 1, 2 \\rangle + t\\langle 1, 1 \\rangle","المعادلة المتجهة"],["x = 1 + t,\\ y = 2 + t \\Rightarrow y = x + 1","بحذف <span class=m dir=ltr>t</span> نحصل على المعادلة نفسها"]],"a":"<span class=\"tx\" data-t=\"y = x + 1\"></span> و <span class=\"tx\" data-t=\"\\vec{r} = \\langle 1, 2 \\rangle + t\\langle 1, 1 \\rangle\"></span>، والمعادلتان تمثلان المستقيم نفسه","o":"المقارنة: متجه الاتجاه <span class=\"tx\" data-t=\"\\langle 1, 1 \\rangle\"></span> يقابل الميل <span class=\"tx\" data-t=\"1\"></span>، والمعادلة المتجهة تعطي كل نقطة بدلالة الوسيط <span class=\"tx\" data-t=\"t\"></span>."}],[{"n":"30","s":[["\\overrightarrow{AB} = \\langle 1, 1, -1 \\rangle","متجه الاتجاه"],["\\vec{r} = \\langle -3, -1, 12 \\rangle + t\\langle 1, 1, -1 \\rangle","المعادلة المتجهة"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle -3, -1, 12 \\rangle + t\\langle 1, 1, -1 \\rangle\"></span>","o":""},{"n":"31","s":[["\\vec{v} = \\langle 1, 1, -1 \\rangle","<span class=m dir=ltr>l_2</span> يوازي <span class=m dir=ltr>l_1</span> فله متجه الاتجاه نفسه"],["\\vec{r} = \\langle 11, 9, 12 \\rangle + t\\langle 1, 1, -1 \\rangle","يمر بالنقطة <span class=m dir=ltr>C</span>"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle 11, 9, 12 \\rangle + t\\langle 1, 1, -1 \\rangle\"></span>","o":""}],[{"n":"32","s":[["M\\left(\\frac{-1 + (-3)}{2}, \\frac{-2 + 4}{2}, \\frac{1 + (-5)}{2}\\right)","صيغة نقطة المنتصف"]],"a":"<span class=\"tx\" data-t=\"M(-2, 1, -2)\"></span>","o":"","k":[{"p":["-2","1","-2"]}]},{"n":"33","s":[["|\\overrightarrow{NC}| = 2|\\overrightarrow{BN}| \\Rightarrow \\overrightarrow{BN} = \\frac{1}{3}\\overrightarrow{BC}","<span class=m dir=ltr>N</span> تقسم <span class=m dir=ltr>BC</span> بنسبة <span class=m dir=ltr>1</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{BC} = \\langle 3, -6, 9 \\rangle,\\ \\vec{n} = \\langle -3, 4, -5 \\rangle + \\frac{1}{3}\\langle 3, -6, 9 \\rangle = \\langle -2, 2, -2 \\rangle","إحداثيات <span class=m dir=ltr>N</span>"],["\\overrightarrow{MN} = \\langle 0, 1, 0 \\rangle","متجه الاتجاه"],["\\vec{r} = \\langle -2, 1, -2 \\rangle + t\\langle 0, 1, 0 \\rangle","المعادلة المتجهة"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle -2, 1, -2 \\rangle + t\\langle 0, 1, 0 \\rangle\"></span>","o":""}],[{"n":"34","s":[["l_1: \\vec{r} = \\langle -5, 2, 4 \\rangle + t\\langle 3, -5, -1 \\rangle,\\ l_2: \\vec{r} = \\langle 0, -8, -1 \\rangle + u\\langle 12, -15, a+1 \\rangle","معادلتا المستقيمين"],["-5 + 3t = 12u,\\quad 2 - 5t = -8 - 15u","المركبتان الأولى والثانية"],["t = 3,\\ u = \\frac{1}{3}","بحل النظام"],["4 - 3 = -1 + \\frac{1}{3}(a + 1) \\Rightarrow a = 5","المركبة الثالثة"],["\\langle -5, 2, 4 \\rangle + 3\\langle 3, -5, -1 \\rangle = \\langle 4, -13, 1 \\rangle","نقطة التقاطع"]],"a":"<span class=\"tx\" data-t=\"a = 5\"></span>، ونقطة التقاطع <span class=\"tx\" data-t=\"(4, -13, 1)\"></span>","o":"","k":[{"e":"5","a":null},{"p":["4","-13","1"]}]}],[{"n":"35","s":[["\\overrightarrow{AB} = \\langle 70, 140, 130 \\rangle = 10\\langle 7, 14, 13 \\rangle,\\ \\overrightarrow{CD} = \\langle 140, 40, -40 \\rangle = 20\\langle 7, 2, -2 \\rangle","متجها الاتجاه، وهما غير متوازيين"],["\\overleftrightarrow{AB}: \\vec{r} = \\langle 30, -75, 90 \\rangle + t\\langle 7, 14, 13 \\rangle,\\ \\overleftrightarrow{CD}: \\vec{r} = \\langle -20, 45, 200 \\rangle + u\\langle 7, 2, -2 \\rangle","المعادلتان"],["30 + 7t = -20 + 7u,\\quad -75 + 14t = 45 + 2u","المركبتان الأولى والثانية"],["t = \\frac{235}{21},\\ u = \\frac{55}{3}","بحل النظام"],["90 + 13\\left(\\frac{235}{21}\\right) = \\frac{4945}{21} \\approx 235.5 \\ne 200 - 2\\left(\\frac{55}{3}\\right) = \\frac{490}{3} \\approx 163.3","المركبة الثالثة غير متحققة"]],"a":"المستقيمان متخالفان (غير متوازيين وغير متقاطعين)","o":""}],[{"n":"36","s":[["\\vec{r} = \\langle -1, 4, 5 \\rangle + t\\langle -10, 5, 10 \\rangle,\\ \\vec{r} = \\langle -5, 9, 3 \\rangle + u\\langle 7, -14, 14 \\rangle","معادلتا مساري الإشارتين"],["-1 - 10t = -5 + 7u,\\quad 4 + 5t = 9 - 14u","المركبتان الأولى والثانية"],["t = \\frac{1}{5},\\ u = \\frac{2}{7}","بحل النظام"],["5 + 10\\left(\\frac{1}{5}\\right) = 7,\\quad 3 + 14\\left(\\frac{2}{7}\\right) = 7","التحقق في المركبة الثالثة"],["\\langle -1, 4, 5 \\rangle + \\frac{1}{5}\\langle -10, 5, 10 \\rangle = \\langle -3, 5, 7 \\rangle","نقطة التقاطع"]],"a":"نعم، يتقاطع المساران في النقطة <span class=\"tx\" data-t=\"(-3, 5, 7)\"></span>","o":"مسألة اليوم: من <span class=\"tx\" data-t=\"(-1,4,5)\"></span> إلى <span class=\"tx\" data-t=\"(-11,9,15)\"></span>، ومن <span class=\"tx\" data-t=\"(-5,9,3)\"></span> إلى <span class=\"tx\" data-t=\"(2,-5,17)\"></span>. وبما أن <span class=\"tx\" data-t=\"0 \\le t, u \\le 1\"></span> فالتقاطع يقع على المسارين فعلًا.","k":[{"p":["-3","5","7"]}]}],[{"n":"37","s":[["\\overrightarrow{QS} = \\langle 2, -8, 16 \\rangle = 2\\langle 1, -4, 8 \\rangle","متجه اتجاه <span class=m dir=ltr>l_1</span>"],["l_1: \\vec{r} = \\langle -6, 14, -19 \\rangle + t\\langle 1, -4, 8 \\rangle,\\ l_2: \\vec{r} = \\langle 1, 9, 9 \\rangle + u\\langle 4, 7, 4 \\rangle","المعادلتان"],["t = 3,\\ u = -1 \\Rightarrow U(-3, 2, 5)","بحل النظام والتحقق في المركبة الثالثة"],["SU = |\\langle 1, -4, 8 \\rangle| = \\sqrt{1+16+64} = 9","طول <span class=m dir=ltr>SU</span>"],["TU = |\\langle -4, -7, -4 \\rangle| = \\sqrt{16+49+16} = 9","طول <span class=m dir=ltr>TU</span>"]],"a":"<span class=\"tx\" data-t=\"SU = TU = 9\"></span>، إذن المثلث <span class=\"tx\" data-t=\"STU\"></span> متطابق الضلعين","o":""}],[{"n":"38","s":[["\\overrightarrow{DM} = \\frac{1}{3}\\overrightarrow{DE} = 4\\vec{a},\\quad \\overrightarrow{DN} = \\frac{1}{3}\\overrightarrow{DF} = \\frac{8}{3}\\vec{b}","<span class=m dir=ltr>DM</span> : <span class=m dir=ltr>ME = 1</span> : <span class=m dir=ltr>2</span> و <span class=m dir=ltr>DN</span> : <span class=m dir=ltr>NF = 1</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{MN} = \\overrightarrow{DN} - \\overrightarrow{DM} = \\frac{8}{3}\\vec{b} - 4\\vec{a}","بالطرح"],["\\overrightarrow{EF} = \\overrightarrow{DF} - \\overrightarrow{DE} = 8\\vec{b} - 12\\vec{a}","بالطرح"],["\\overrightarrow{MN} = \\frac{1}{3}\\overrightarrow{EF}","<span class=m dir=ltr>MN</span> يوازي <span class=m dir=ltr>EF</span>"]],"a":"<span class=\"tx\" data-t=\"MN \\parallel EF\"></span> و <span class=\"tx\" data-t=\"MN = \\frac{1}{3}EF \\ne EF\"></span>، إذن <span class=\"tx\" data-t=\"FEMN\"></span> شبه منحرف","o":""},{"n":"39","s":[["\\triangle DMN \\sim \\triangle DEF,\\ k = \\frac{1}{3}","تشابه المثلثين <span class=m dir=ltr>(MN</span> ∥ <span class=m dir=ltr>EF)</span>"],["A_{DMN} = \\left(\\frac{1}{3}\\right)^2 \\times 72 = 8","نسبة المساحتين <span class=m dir=ltr>=</span> مربع نسبة التشابه"],["A_{FEMN} = 72 - 8 = 64","بالطرح"]],"a":"مساحة <span class=\"tx\" data-t=\"FEMN = 64\"></span> وحدة مربعة","o":""}],[{"n":"40","s":[["\\vec{r} = \\langle 3 + t, -2 + 2t, -6 + 3t \\rangle","نقطة عامة على المستقيم"],["(3+t)^2 + (-2+2t)^2 + (-6+3t)^2 = 29^2","بعدها عن الأصل <span class=m dir=ltr>29</span>"],["14t^2 - 38t + 49 = 841 \\Rightarrow 7t^2 - 19t - 396 = 0","بالتبسيط"],["(t - 9)(7t + 44) = 0 \\Rightarrow t = 9 \\text{ or } t = -\\frac{44}{7}","بالتحليل"],["t = 9: (12, 16, 21),\\quad t = -\\frac{44}{7}: \\left(-\\frac{23}{7}, -\\frac{102}{7}, -\\frac{174}{7}\\right)","بالتعويض"]],"a":"النقطتان <span class=\"tx\" data-t=\"(12, 16, 21)\"></span> و <span class=\"tx\" data-t=\"\\left(-\\frac{23}{7}, -\\frac{102}{7}, -\\frac{174}{7}\\right)\"></span>","o":"","k":[{"p":["12","16","21"]},{"p":["-23/7","-102/7","-174/7"]}]}],[{"n":"41","s":[["\\overrightarrow{VW} = \\overrightarrow{UX} = 8\\vec{b},\\quad \\overrightarrow{XW} = \\overrightarrow{UV} = 3\\vec{a}","أضلاع متوازي الأضلاع"],["\\overrightarrow{VY} = \\frac{3}{4}\\overrightarrow{VW} = 6\\vec{b}","<span class=m dir=ltr>VY = 3YW</span>"],["\\overrightarrow{UY} = \\overrightarrow{UV} + \\overrightarrow{VY} = 3\\vec{a} + 6\\vec{b}","قاعدة المثلث"],["\\overrightarrow{UZ} = \\overrightarrow{UX} + \\overrightarrow{XZ} = 8\\vec{b} + \\frac{4}{3}(3\\vec{a}) = 4\\vec{a} + 8\\vec{b}","قاعدة المثلث"],["\\overrightarrow{UZ} = \\frac{4}{3}(3\\vec{a} + 6\\vec{b}) = \\frac{4}{3}\\overrightarrow{UY}","بإخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{UZ} = \\frac{4}{3}\\overrightarrow{UY}\"></span> والمتجهان يشتركان في <span class=\"tx\" data-t=\"U\"></span>، إذن <span class=\"tx\" data-t=\"U\"></span> و <span class=\"tx\" data-t=\"Y\"></span> و <span class=\"tx\" data-t=\"Z\"></span> على استقامة واحدة","o":""}],[{"n":"4","s":[["y=-2+t=10\\Rightarrow t=12","مساواة المركبة <span class=m dir=ltr>y</span> بـ <span class=m dir=ltr>10</span>"],["\\vec{r}=\\langle 4-24,\\ -2+12,\\ 5+36\\rangle=\\langle -20,10,41\\rangle","بالتعويض <span class=m dir=ltr>t = 12</span>"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"(-20,10,41)\"></span>","o":"","k":[{"p":["-20","10","41"]}]}],[{"n":"7","s":[["\\vec{v}=k\\vec{u}\\Rightarrow \\langle 2,b,5\\rangle=k\\langle -4,2,a\\rangle","شرط التوازي"],["2=-4k\\Rightarrow k=-\\frac{1}{2}","من المركبة <span class=m dir=ltr>x</span>"],["5=-\\frac{1}{2}a\\Rightarrow a=-10","من المركبة <span class=m dir=ltr>z</span>"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"-10\"></span>","o":"","k":[{"e":"-10","a":null}]}],[{"n":"10","s":[["\\overrightarrow{EF}=\\langle h-2,\\ 5,\\ -3\\rangle,\\quad \\overrightarrow{EG}=\\langle 1,\\ 10,\\ k-4\\rangle","النقاط على مستقيم واحد إذا كان <span class=\"tx\" data-t=\"\\overrightarrow{EF}\\parallel\\overrightarrow{EG}\"></span>"],["\\overrightarrow{EF}=s\\,\\overrightarrow{EG}\\Rightarrow 5=10s\\Rightarrow s=\\frac{1}{2}","من المركبة <span class=m dir=ltr>y</span>"],["h-2=\\frac{1}{2}(1)\\Rightarrow h=\\frac{5}{2}","من المركبة <span class=m dir=ltr>x</span>"],["-3=\\frac{1}{2}(k-4)\\Rightarrow k-4=-6\\Rightarrow k=-2","من المركبة <span class=m dir=ltr>z</span>"]],"a":"<span class=\"tx\" data-t=\"h=\\frac{5}{2}=2.5\"></span> ، <span class=\"tx\" data-t=\"k=-2\"></span>","o":"","k":[{"e":"2.5","a":true},{"e":"-2","a":null}]}],[{"n":"19","s":[["\\overrightarrow{EF}=\\langle -12,3,-18\\rangle=-3\\langle 4,-1,6\\rangle,\\quad \\overrightarrow{GH}=\\langle -14,-35,21\\rangle=-7\\langle 2,5,-3\\rangle","متجها الاتجاه غير متوازيين"],["l_1:\\ \\vec{r}=\\langle 17,6,34\\rangle+\\lambda\\langle 4,-1,6\\rangle,\\quad l_2:\\ \\vec{r}=\\langle 1,21,-2\\rangle+\\mu\\langle 2,5,-3\\rangle","معادلتا المستقيمين"],["17+4\\lambda=1+2\\mu,\\quad 6-\\lambda=21+5\\mu","مساواة المركبتين <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["\\lambda=-5,\\quad \\mu=-2","بحل النظام"],["z:\\ 34+6(-5)=4,\\quad -2-3(-2)=4","التحقق: متساويتان، إذن المستقيمان متقاطعان"],["(17-20,\\ 6+5,\\ 4)=(-3,11,4)","نقطة التقاطع"]],"a":"المستقيمان متقاطعان في النقطة <span class=\"tx\" data-t=\"(-3,11,4)\"></span>","o":"","k":[{"p":["-3","11","4"]}]},{"n":"20","s":[["\\overrightarrow{EF}=\\langle 15,5,-15\\rangle=5\\langle 3,1,-3\\rangle,\\quad \\overrightarrow{GH}=\\langle -6,-24,12\\rangle=-6\\langle 1,4,-2\\rangle","متجها الاتجاه غير متوازيين، إذن المستقيمان غير متوازيين"],["l_1:\\ \\vec{r}=\\langle -3,-5,16\\rangle+\\lambda\\langle 3,1,-3\\rangle,\\quad l_2:\\ \\vec{r}=\\langle 7,2,11\\rangle+\\mu\\langle 1,4,-2\\rangle","معادلتا المستقيمين"],["-3+3\\lambda=7+\\mu,\\quad -5+\\lambda=2+4\\mu","مساواة المركبتين <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["\\lambda=3,\\quad \\mu=-1","بحل النظام"],["z:\\ 16-3(3)=7,\\quad 11-2(-1)=13,\\quad 7\\ne 13","التحقق في المركبة <span class=m dir=ltr>z</span>: غير متساويتين"]],"a":"المستقيمان متخالفان (غير متوازيين وغير متقاطعين)","o":""}],[{"n":"1","s":[["\\overrightarrow{AB}=\\langle -7,2,7\\rangle,\\quad \\overrightarrow{DC}=\\langle -14,4,14\\rangle","متجها ضلعين متقابلين"],["\\overrightarrow{DC}=2\\overrightarrow{AB}\\ne\\overrightarrow{AB}","متوازيان لكن غير متساويين في الطول"],["\\overrightarrow{AD}=\\langle 5,3,-10\\rangle,\\quad \\overrightarrow{BC}=\\langle -2,5,-3\\rangle","غير متوازيين"]],"a":"لا، <span class=\"tx\" data-t=\"ABCD\"></span> ليس متوازي أضلاع (هو شبه منحرف: <span class=\"tx\" data-t=\"\\overline{AB}\\parallel\\overline{DC}\"></span> فقط)","o":""},{"n":"2","s":[["\\overrightarrow{AB}=\\langle -6,-3,-2\\rangle,\\quad \\overrightarrow{DC}=\\langle -8+2,\\ 1-4,\\ 13-15\\rangle=\\langle -6,-3,-2\\rangle","متجها ضلعين متقابلين"],["\\overrightarrow{AB}=\\overrightarrow{DC}","ضلعان متقابلان متوازيان ومتساويان"],["\\overrightarrow{AD}=\\langle -14,-1,23\\rangle\\nparallel\\overrightarrow{AB}","النقاط ليست على استقامة واحدة"]],"a":"نعم، <span class=\"tx\" data-t=\"ABCD\"></span> متوازي أضلاع لأن <span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\overrightarrow{DC}\"></span>","o":""}],[{"n":"3","s":[["\\overrightarrow{AD}=\\overrightarrow{BC}","في متوازي الأضلاع <span class=m dir=ltr>ABCD</span>"],["\\vec{D}=\\vec{A}+\\vec{C}-\\vec{B}=\\langle 2+3-6,\\ 3+1-5,\\ 1+5-4\\rangle",""],["D=(-1,-1,2)",""]],"a":"<span class=\"tx\" data-t=\"D(-1,-1,2)\"></span>","o":"","k":[{"p":["-1","-1","2"]}]}],[{"n":"4","s":[["\\overrightarrow{AB}=-5\\vec{a}+2\\vec{b}","جمع المتجهات"],["\\overrightarrow{AT}=\\frac{5}{6}\\overrightarrow{AB}","لأن <span class=m dir=ltr>AT</span> : <span class=m dir=ltr>TB = 5</span> : <span class=m dir=ltr>1</span>"],["\\overrightarrow{OT}=5\\vec{a}+\\frac{5}{6}(-5\\vec{a}+2\\vec{b})=\\frac{5}{6}\\vec{a}+\\frac{5}{3}\\vec{b}","بالتبسيط"],["\\overrightarrow{OT}=\\frac{5}{6}(\\vec{a}+2\\vec{b})","إخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OT}=\\frac{5}{6}(2\\vec{b}+\\vec{a})\"></span>، إذن <span class=\"tx\" data-t=\"\\overrightarrow{OT}\"></span> يوازي <span class=\"tx\" data-t=\"2\\vec{b}+\\vec{a}\"></span>","o":""}],[{"n":"5","s":[["\\overrightarrow{RQ}=2\\overrightarrow{PR}\\Rightarrow \\overrightarrow{PR}=\\frac{1}{3}\\overrightarrow{PQ}","<span class=m dir=ltr>R</span> تقسم <span class=m dir=ltr>PQ</span> بنسبة <span class=m dir=ltr>1</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{OR}=\\vec{a}+\\frac{1}{3}(\\vec{b}-\\vec{a})=\\frac{2}{3}\\vec{a}+\\frac{1}{3}\\vec{b}",""],["\\overrightarrow{OS}=3\\overrightarrow{OR}=2\\vec{a}+\\vec{b}",""]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OS}=2\\vec{a}+\\vec{b}\"></span> (وهو المطلوب)","o":""},{"n":"6","s":[["\\overrightarrow{TP}=\\overrightarrow{OP}-\\overrightarrow{OT}=\\vec{a}+\\vec{b}",""],["\\overrightarrow{PS}=\\overrightarrow{OS}-\\overrightarrow{OP}=2\\vec{a}+\\vec{b}-\\vec{a}=\\vec{a}+\\vec{b}",""],["\\overrightarrow{TP}=\\overrightarrow{PS}","متوازيان ويشتركان في النقطة <span class=m dir=ltr>P</span>"]],"a":"النقاط <span class=\"tx\" data-t=\"S, P, T\"></span> على استقامة واحدة (و <span class=m dir=ltr>P</span> منتصف <span class=\"tx\" data-t=\"\\overline{TS}\"></span>)","o":""}],[{"n":"7","s":[["\\overrightarrow{CA}=8\\vec{a}-7\\vec{c}","طرح المتجهات"],["\\overrightarrow{CP}=\\frac{3}{5}\\overrightarrow{CA}","<span class=m dir=ltr>P</span> تقسم <span class=m dir=ltr>CA</span> بنسبة <span class=m dir=ltr>3</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{OP}=7\\vec{c}+\\frac{3}{5}(8\\vec{a}-7\\vec{c})=\\frac{24}{5}\\vec{a}+\\frac{14}{5}\\vec{c}",""]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OP}=\\frac{24}{5}\\vec{a}+\\frac{14}{5}\\vec{c}\"></span>","o":""},{"n":"8","s":[["\\overrightarrow{OB}=\\overrightarrow{OC}+\\overrightarrow{CB}=12\\vec{a}+7\\vec{c}",""],["\\overrightarrow{OP}=\\frac{2}{5}(12\\vec{a}+7\\vec{c})=\\frac{2}{5}\\overrightarrow{OB}","إخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OP}=\\frac{2}{5}\\overrightarrow{OB}\"></span> ويشتركان في <span class=m dir=ltr>O</span>، إذن <span class=\"tx\" data-t=\"O, P, B\"></span> على استقامة واحدة","o":""},{"n":"9","s":[["OP=\\frac{2}{5}OB\\Rightarrow PB=\\frac{3}{5}OB",""],["OP:PB=2:3",""]],"a":"<span class=\"tx\" data-t=\"OP:PB=2:3\"></span>","o":""}],[{"n":"10","s":[["\\vec{r}=\\vec{r_0}+t\\vec{v}","الصورة العامة"],["\\vec{r}=\\langle 2,3,-5\\rangle+t\\langle 0,4,-2\\rangle","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle 2,3,-5\\rangle+t\\langle 0,4,-2\\rangle\"></span>","o":""}],[{"n":"11","s":[["\\vec{r}=\\langle 2,-7,11\\rangle+t\\langle -4,5,8\\rangle","بالتعويض في <span class=\"tx\" data-t=\"\\vec{r}=\\vec{r_0}+t\\vec{v}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle 2,-7,11\\rangle+t\\langle -4,5,8\\rangle\"></span>","o":""}],[{"n":"12","s":[["\\vec{v}=\\langle 6-1,\\ 19+7\\rangle=\\langle 5,26\\rangle","متجه الاتجاه"],["\\vec{r}=\\langle 1,-7\\rangle+t\\langle 5,26\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle 1,-7\\rangle+t\\langle 5,26\\rangle\"></span>","o":""},{"n":"13","s":[["\\vec{v}=\\langle 12,9,-23\\rangle","متجه الاتجاه"],["\\vec{r}=\\langle -5,4,15\\rangle+t\\langle 12,9,-23\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle -5,4,15\\rangle+t\\langle 12,9,-23\\rangle\"></span>","o":""},{"n":"14","s":[["\\vec{v}=\\langle 8,-12,11\\rangle","متجه الاتجاه"],["\\vec{r}=\\langle 5,22,-8\\rangle+t\\langle 8,-12,11\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle 5,22,-8\\rangle+t\\langle 8,-12,11\\rangle\"></span>","o":""},{"n":"15","s":[["\\vec{v}=\\langle 9,2,11\\rangle","متجه الاتجاه"],["\\vec{r}=\\langle 0,2,-5\\rangle+t\\langle 9,2,11\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{r}=\\langle 0,2,-5\\rangle+t\\langle 9,2,11\\rangle\"></span>","o":""}],[{"n":"16","s":[["-5+3t=3\\Rightarrow t=\\frac{8}{3}","من المركبة <span class=m dir=ltr>x</span>"],["8-2\\left(\\frac{8}{3}\\right)=\\frac{8}{3}\\ne 7","التحقق في المركبة <span class=m dir=ltr>y</span>"]],"a":"لا، النقطة <span class=\"tx\" data-t=\"(3,7,11)\"></span> لا تقع على المستقيم <span class=\"tx\" data-t=\"l\"></span> لأنه لا توجد قيمة واحدة لـ <span class=m dir=ltr>t</span> تحقق المركبات جميعها","o":""},{"n":"17","s":[["-5+3t=1\\Rightarrow t=2","من المركبة <span class=m dir=ltr>x</span>"],["b=8-2(2)=4","المركبة <span class=m dir=ltr>y</span>"],["c=4+9(2)=22","المركبة <span class=m dir=ltr>z</span>"]],"a":"<span class=\"tx\" data-t=\"b=4\"></span> ، <span class=\"tx\" data-t=\"c=22\"></span>","o":"","k":[{"e":"4","a":null},{"e":"22","a":null}]},{"n":"18","s":[["y=0\\Rightarrow 8-2t=0\\Rightarrow t=4","في المستوى <span class=m dir=ltr>xz</span> يكون <span class=m dir=ltr>y = 0</span>"],["\\langle -5+12,\\ 0,\\ 4+36\\rangle=\\langle 7,0,40\\rangle","بالتعويض <span class=m dir=ltr>t = 4</span>"]],"a":"<span class=\"tx\" data-t=\"(7,0,40)\"></span>","o":"","k":[{"p":["7","0","40"]}]}],[{"n":"19","s":[["\\langle 4,a,-12\\rangle=k\\langle 3,-2,-9\\rangle","شرط التوازي"],["4=3k\\Rightarrow k=\\frac{4}{3}","من المركبة <span class=m dir=ltr>x (</span>وتحقق: <span class=\"tx\" data-t=\"-9k=-12\"></span>)"],["a=-2k=-\\frac{8}{3}","من المركبة <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"a=-\\frac{8}{3}\"></span>","o":"","k":[{"e":"-8/3","a":null}]}],[{"n":"20","s":[["\\overrightarrow{UV}=\\langle 2-p,\\ 8,\\ -2\\rangle,\\quad \\overrightarrow{VW}=\\langle 5,\\ -4,\\ q+3\\rangle","حيث