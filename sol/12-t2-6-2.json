[[{"n":"1","s":[["\\frac{15}{8},\\ \\frac{10}{12} = \\frac{5}{6},\\ \\frac{-20}{24} = -\\frac{5}{6}","نسب المركبات المتناظرة"],["\\frac{15}{8} \\ne \\frac{5}{6}","لا يوجد عدد <span class=m dir=ltr>k</span> ثابت"]],"a":"المتجهان غير متوازيين","o":""},{"n":"2","s":[["\\langle 27, -48, -36 \\rangle = 3\\langle 9, -16, -12 \\rangle","نبحث عن <span class=m dir=ltr>k</span> بحيث <span class=m dir=ltr>u = kv</span>"],["k = 3","النسب متساوية"]],"a":"المتجهان متوازيان","o":""},{"n":"3","s":[["\\frac{-3}{-6} = \\frac{1}{2},\\ \\frac{-1}{-4} = \\frac{1}{4}","نسب المركبات المتناظرة"],["\\frac{1}{2} \\ne \\frac{1}{4}","لا يوجد <span class=m dir=ltr>k</span> ثابت"]],"a":"المتجهان غير متوازيين","o":""},{"n":"4","s":[["\\frac{21}{12} = \\frac{-14}{-8} = \\frac{56}{32} = \\frac{7}{4}","نسب المركبات المتناظرة"],["\\langle 21, -14, 56 \\rangle = \\frac{7}{4}\\langle 12, -8, 32 \\rangle","<span class=m dir=ltr>k = 7/4</span>"]],"a":"المتجهان متوازيان","o":""}],[{"n":"5","s":[["\\overrightarrow{BE} = \\overrightarrow{BA} + \\overrightarrow{AE} = \\vec{a} + 2\\vec{b}","قاعدة المثلث"],["\\overrightarrow{CE} = -(\\vec{b} - 2\\vec{a}) = 2\\vec{a} - \\vec{b},\\quad \\overrightarrow{ED} = -(\\vec{a} - 3\\vec{b}) = -\\vec{a} + 3\\vec{b}","المتجه المعاكس"],["\\overrightarrow{CD} = \\overrightarrow{CE} + \\overrightarrow{ED} = 2\\vec{a} - \\vec{b} - \\vec{a} + 3\\vec{b} = \\vec{a} + 2\\vec{b}","قاعدة المثلث"],["\\overrightarrow{BE} = \\overrightarrow{CD}","ضلعان متقابلان متوازيان ومتطابقان"]],"a":"بما أن <span class=\"tx\" data-t=\"\\overrightarrow{BE} = \\overrightarrow{CD}\"></span> فإن <span class=\"tx\" data-t=\"BE \\parallel CD\"></span> و <span class=\"tx\" data-t=\"BE = CD\"></span>، إذن <span class=\"tx\" data-t=\"BEDC\"></span> متوازي أضلاع","o":""}],[{"n":"6","s":[["\\overrightarrow{OT} = \\overrightarrow{OC} + \\overrightarrow{CT} = 6\\vec{c} + 3\\vec{a}","<span class=m dir=ltr>T</span> منتصف <span class=m dir=ltr>CB</span> و <span class=m dir=ltr>CB = OA = 6a</span>"],["\\overrightarrow{OU} = \\overrightarrow{OA} + \\overrightarrow{AU} = 6\\vec{a} + \\frac{2}{3}(6\\vec{c}) = 6\\vec{a} + 4\\vec{c}","<span class=m dir=ltr>U</span> تقسم <span class=m dir=ltr>AB</span> بحيث <span class=m dir=ltr>BU</span> : <span class=m dir=ltr>UA = 1</span> : <span class=m dir=ltr>2 (</span>كما في الشكل)"],["\\overrightarrow{OX} = 2\\overrightarrow{OA} = 12\\vec{a}","<span class=m dir=ltr>OA = AX</span>"],["\\overrightarrow{TU} = \\overrightarrow{OU} - \\overrightarrow{OT} = 3\\vec{a} - 2\\vec{c}","بالطرح"],["\\overrightarrow{UX} = \\overrightarrow{OX} - \\overrightarrow{OU} = 6\\vec{a} - 4\\vec{c} = 2(3\\vec{a} - 2\\vec{c}) = 2\\overrightarrow{TU}","بالطرح وإخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{UX} = 2\\overrightarrow{TU}\"></span>، فالمتجهان متوازيان ويشتركان في النقطة <span class=\"tx\" data-t=\"U\"></span>، إذن <span class=\"tx\" data-t=\"T\"></span> و <span class=\"tx\" data-t=\"U\"></span> و <span class=\"tx\" data-t=\"X\"></span> على استقامة واحدة","o":"اعتمدنا موقع <span class=\"tx\" data-t=\"U\"></span> في الشكل (أقرب إلى <span class=\"tx\" data-t=\"B\"></span>)، أي <span class=\"tx\" data-t=\"AU = \\frac{2}{3}AB\"></span>."}],[{"n":"7","s":[["\\vec{a} = \\langle -7, 1 \\rangle,\\ \\vec{b} = \\langle 5, 3 \\rangle","متجه الاتجاه ومتجه الموقع"],["\\vec{r} = \\vec{r}_0 + t\\vec{v}","صيغة المعادلة المتجهة للمستقيم"],["\\vec{r} = \\langle 5, 3 \\rangle + t\\langle -7, 1 \\rangle","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle 5, 3 \\rangle + t\\langle -7, 1 \\rangle\"></span>","o":""},{"n":"8","s":[["\\vec{a} = \\langle -3, 2, -1 \\rangle,\\ \\vec{b} = \\langle -2, 0, 8 \\rangle","متجه الاتجاه ومتجه الموقع"],["\\vec{r} = \\vec{r}_0 + t\\vec{v}","صيغة المعادلة المتجهة للمستقيم"],["\\vec{r} = \\langle -2, 0, 8 \\rangle + t\\langle -3, 2, -1 \\rangle","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\vec{r} = \\langle -2, 0, 8 \\rangle + t\\langle -3, 2, -1 \\rangle\"></span>","o":""},{"n":"9","s":[["\\vec{r} = \