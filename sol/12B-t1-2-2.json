[[{"n":"1","s":[["1.8 + 1.4 + 2.6 + 1.6 + 2.8 + 0.9 + 3.1 + 0.8 + 1.2 + 2.4 + 0.6 = 19.2","بإيجاد مجموع ارتفاعات العلب"],["\\frac{19.2}{5} = 3.84 \\approx 4","الحد الأدنى لعدد الصناديق (بالتقريب إلى الأعلى)"],["B1: 1.8,\\ 1.4,\\ 1.6 \\qquad B2: 2.6,\\ 0.9,\\ 0.8,\\ 0.6","أضع كل علبة في أول صندوق يتسع لها، بترتيب العناصر المعطى"],["B3: 2.8,\\ 1.2 \\qquad B4: 3.1 \\qquad B5: 2.4",""]],"a":"عدد الصناديق اللازمة باستعمال الملاءمة الأولى: <span class=m dir=ltr>5</span> صناديق","o":""},{"n":"2","s":[["5 > 4","عدد الصناديق المستعملة يزيد على الحد الأدنى"],["\\{3.1, 1.8\\},\\ \\{2.8, 1.6, 0.6\\},\\ \\{2.6, 2.4\\},\\ \\{1.4, 1.2, 0.9, 0.8\\}","يمكن تعبئة العلب في <span class=m dir=ltr>4</span> صناديق فقط"]],"a":"لا، ليس حلًّا أمثل؛ لأنه يزيد على الحد الأدنى <span class=m dir=ltr>(4)</span>، ويمكن فعلًا التعبئة في <span class=m dir=ltr>4</span> صناديق كما في التوزيع أعلاه.","o":""},{"n":"3","s":[["0.2 + 0.1 + 1.0 + 1.9 + 2.6 = 5.8","مجموع الارتفاعات المهدورة في الصناديق الخمسة"],["5 \\times 5 - 19.2 = 5.8","للتحقق"]],"a":"الارتفاع المهدور: <span class=\"tx\" data-t=\"5.8\"></span> وحدة طول","o":""}],[{"n":"4","s":[["31 + 10 + 38 + 45 + 19 + 47 + 35 + 28 + 12 = 265","مجموع ارتفاعات العلب"],["\\frac{265}{60} = 4.41\\overline{6} \\approx 5","الحد الأدنى لعدد الصناديق"],["47,\\ 45,\\ 38,\\ 35,\\ 31,\\ 28,\\ 19,\\ 12,\\ 10","أرتب الارتفاعات تنازليًّا"],["B1: 47, 12 \\quad B2: 45, 10 \\quad B3: 38, 19","أطبق الملاءمة الأولى على الترتيب التنازلي"],["B4: 35 \\quad B5: 31, 28",""]],"a":"عدد الصناديق اللازمة: <span class=m dir=ltr>5</span> صناديق","o":""},{"n":"5","s":[["5 = 5","عدد الصناديق المستعملة يساوي الحد الأدنى"]],"a":"نعم، الحل أمثل؛ لأن عدد الصناديق المستعملة مساوٍ للحد الأدنى من عدد الصناديق اللازمة.","o":""},{"n":"6","s":[["1 + 5 + 3 + 25 + 1 = 35","مجموع الارتفاعات المهدورة في الصناديق"],["5 \\times 60 - 265 = 35","للتحقق"]],"a":"الارتفاع المهدور: <span class=\"tx\" data-t=\"35\"></span> وحدة طول","o":""}],[{"n":"7","s":[["42 + 21 + 15 + 16 + 35 + 10 + 31 + 11 + 27 + 39 = 247","مجموع ارتفاعات العلب"],["\\frac{247}{65} = 3.8 \\approx 4","الحد الأدنى لعدد الصناديق"],["B1: 39 + 16 + 10 = 65","أبحث عن علب تملأ صندوقًا كاملًا، وأعبئها أولًا"],["B2: 42, 21 \\quad B3: 15, 35, 11 \\quad B4: 31, 27","أطبق الملاءمة الأولى على العلب المتبقية بترتيبها"]],"a":"عدد الصناديق اللازمة باستعمال الصندوق الكامل: <span class=m dir=ltr>4</span> صناديق","o":""},{"n":"8","s":[["4 = 4","عدد الصناديق المستعملة يساوي الحد الأدنى"]],"a":"نعم، الحل أمثل؛ لأن عدد الصناديق المستعملة مساوٍ للحد الأدنى.","o":""},{"n":"9","s":[["0 + 2 + 4 + 7 = 13","الارتفاعات المهدورة: <span class=\"tx\" data-t=\"65-65,\\ 65-63,\\ 65-61,\\ 65-58\"></span>"],["4 \\times 65 - 247 = 13","للتحقق"]],"a":"الارتفاع المهدور: <span class=\"tx\" data-t=\"13\"></span> وحدة طول","o":""}],[{"n":"10","s":[["41 + 28 + 42 + 31 + 36 + 32 + 29 = 239","مجموع كتل الأجهزة"],["\\frac{239}{60} = 3.98\\overline{3} \\approx 4","بالقسمة على سعة الصندوق والتقريب إلى الأعلى"]],"a":"الحد الأدنى لعدد الصناديق: <span class=m dir=ltr>4</span> صناديق","o":""},{"n":"11","s":[["B1: 41 \\quad B2: 28, 31","أضع كل جهاز في أول صندوق يتسع له بالترتيب المعطى"],["B3: 42 \\quad B4: 36 \\quad B5: 32 \\quad B6: 29",""]],"a":"باستعمال الملاءمة الأولى: <span class=m dir=ltr>6</span> صناديق","o":""},{"n":"12","s":[["42,\\ 41,\\ 36,\\ 32,\\ 31,\\ 29,\\ 28","أرتب الكتل تنازليًّا"],["B1: 42 \\quad B2: 41 \\quad B3: 36","لا يتسع أي صندوق منها لجهاز آخر"],["B4: 32, 28 \\quad B5: 31, 29","أطبق الملاءمة الأولى"]],"a":"باستعمال الملاءمة الأولى المتناقصة: <span class=m dir=ltr>5</span> صناديق","o":""}],[{"n":"13","s":[["28 + 32 = 60,\\quad 31 + 29 = 60","أبحث عن أجهزة تملأ صندوقًا كاملًا"],["B1: 28, 32 \\quad B2: 31, 29","أعبئ الصناديق الكاملة أولًا"],["B3: 41 \\quad B4: 42 \\quad B5: 36","أطبق الملاءمة الأولى على الأجهزة المتبقية"]],"a":"باستعمال الصندوق الكامل: <span class=m dir=ltr>5</span> صناديق","o":""},{"n":"14","s":[["41 + 36 > 60,\\ 42 + 36 > 60,\\ 41 + 42 > 60","الأجهزة <span class=m dir=ltr>41</span>، <span class=m dir=ltr>42</