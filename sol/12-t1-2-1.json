[[{"n":"1","s":[["\\cos^2\\theta = 1-\\sin^2\\theta = 1-\\frac{1}{9}=\\frac{8}{9}","المتطابقة الفيثاغورية"],["\\cos\\theta = \\frac{2\\sqrt{2}}{3}","<span class=\"tx\" data-t=\"\\cos\\theta&gt;0\"></span> لأنّ <span class=\"tx\" data-t=\"\\theta\"></span> في الربع الأول"],["\\cot\\theta=\\frac{\\cos\\theta}{\\sin\\theta}=\\frac{2\\sqrt{2}}{3}\\div\\frac{1}{3}=2\\sqrt{2}","متطابقة النسبة"]],"a":"<span class=\"tx\" data-t=\"\\cot\\theta = 2\\sqrt{2}\"></span>","o":""},{"n":"2","s":[["\\sec^2\\theta = 1+\\tan^2\\theta = 1+\\frac{9}{49}=\\frac{58}{49}","المتطابقة الفيثاغورية"],["\\sec\\theta = -\\frac{\\sqrt{58}}{7}","<span class=\"tx\" data-t=\"\\sec\\theta&lt;0\"></span> لأنّ <span class=\"tx\" data-t=\"\\theta\"></span> في الربع الثاني"]],"a":"<span class=\"tx\" data-t=\"\\sec\\theta = -\\dfrac{\\sqrt{58}}{7}\"></span>","o":""},{"n":"3","s":[["\\sin\\theta=\\frac{1}{\\csc\\theta}=-\\frac{3}{5}","متطابقة المقلوب"],["\\cos^2\\theta=1-\\frac{9}{25}=\\frac{16}{25}\\Rightarrow \\cos\\theta=-\\frac{4}{5}","<span class=\"tx\" data-t=\"\\cos\\theta&lt;0\"></span> في الربع الثالث"],["\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}=\\frac{-3/5}{-4/5}=\\frac{3}{4}","متطابقة النسبة"]],"a":"<span class=\"tx\" data-t=\"\\tan\\theta=\\dfrac{3}{4}\"></span>","o":""},{"n":"4","s":[["\\cos\\theta=\\frac{1}{\\sec\\theta}=\\frac{4}{9}","متطابقة المقلوب"],["\\sin^2\\theta=1-\\frac{16}{81}=\\frac{65}{81}","المتطابقة الفيثاغورية"],["\\sin\\theta=-\\frac{\\sqrt{65}}{9}","<span class=\"tx\" data-t=\"\\sin\\theta&lt;0\"></span> في الربع الرابع"]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta=-\\dfrac{\\sqrt{65}}{9}\"></span>","o":""}],[{"n":"5","s":[["\\cos x\\tan x=\\cos x\\cdot\\frac{\\sin x}{\\cos x}","متطابقة النسبة"],["=\\sin x","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"\\sin x\"></span>","o":""},{"n":"6","s":[["\\frac{\\sec x-\\cos x}{\\sin x}=\\frac{\\frac{1}{\\cos x}-\\cos x}{\\sin x}","متطابقة المقلوب"],["=\\frac{1-\\cos^2x}{\\cos x\\sin x}","بتوحيد المقامات"],["=\\frac{\\sin^2x}{\\cos x\\sin x}=\\frac{\\sin x}{\\cos x}=\\tan x","المتطابقة الفيثاغورية ثم الاختصار"]],"a":"<span class=\"tx\" data-t=\"\\tan x\"></span>","o":""},{"n":"7","s":[["\\frac{\\cos(\\frac{\\pi}{2}-x)}{\\csc x}+\\cos^2x=\\frac{\\sin x}{\\frac{1}{\\sin x}}+\\cos^2x","متطابقة الزاويتين المتتامتين ومتطابقة المقلوب"],["=\\sin^2x+\\cos^2x=1","المتطابقة الفيثاغورية"]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":""},{"n":"8","s":[["\\frac{\\sin x-\\cos x}{\\cos x}+\\frac{\\cos x-\\sin x}{\\sin x}=\\frac{\\sin^2x-\\sin x\\cos x+\\cos^2x-\\sin x\\cos x}{\\sin x\\cos x}","بتوحيد المقامات"],["=\\frac{1-2\\sin x\\cos x}{\\sin x\\cos x}","المتطابقة الفيثاغورية"],["=\\frac{1}{\\sin x\\cos x}-2=\\csc x\\sec x-2","بتجزئة الكسر"]],"a":"<span class=\"tx\" data-t=\"\\csc x\\sec x-2\"></span> (أو <span class=\"tx\" data-t=\"\\tan x+\\cot x-2\"></span>)","o":""},{"n":"9","s":[["\\frac{(\\sin x+\\cos x)^2-1}{\\sin x\\cos x}=\\frac{\\sin^2x+2\\sin x\\cos x+\\cos^2x-1}{\\sin x\\cos x}","بفك المربع"],["=\\frac{1+2\\sin x\\cos x-1}{\\sin x\\cos x}","المتطابقة الفيثاغورية"],["=\\frac{2\\sin x\\cos x}{\\sin x\\cos x}=2","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":""},{"n":"10","s":[["\\frac{\\sec x-\\cos x}{\\tan x}=\\frac{\\frac{1-\\cos^2x}{\\cos x}}{\\frac{\\sin x}{\\cos x}}","متطابقتا المقلوب والنسبة"],["=\\frac{\\sin^2x}{\\cos x}\\cdot\\frac{\\cos x}{\\sin x}=\\sin x","المتطابقة الفيثاغورية ثم الاختصار"]],"a":"<span class=\"tx\" data-t=\"\\sin x\"></span>","o":""}],[{"n":"11","s":[["\\cot(-x)\\cos(-x)+\\sin(-x)=-\\cot x\\cos x-\\sin x","متطابقات الزوايا السالبة"],["=-\\left(\\frac{\\cos^2x}{\\sin x}+\\sin x\\right)=-\\frac{\\cos^2x+\\sin^2x}{\\sin x}","متطابقة النسبة وتوحيد المقامات"],["=-\\frac{1}{\\sin x}=-\\csc x","المتطابقة الفيثاغورية ومتطابقة المقلوب"]],"a":"الطرف الأيمن <span class=\"tx\" data-t=\"=-\\csc x=\"></span> الطرف الأيسر، فالمتطابقة صحيحة","o":""},{"n":"12","s":[["(\\sin x+\\cos x)^2=\\sin^2x+2\\sin x\\cos x+\\cos^2x","بفك المربع"],["=1+2\\sin x\\cos x","المتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"13","s":[["\\text{LHS}=\\frac{(\\sin x+\\cos x)^2}{(\\sin x-\\cos x)(\\sin x+\\cos x)}=\\frac{\\sin x+\\cos x}{\\sin x-\\cos x}","بتحليل الفرق بين مربعين في المقام والاختصار"],["\\text{RHS}=\\frac{(\\sin x-\\cos x)(\\sin x+\\cos x)}{(\\sin x-\\cos x)^2}=\\frac{\\sin x+\\cos x}{\\sin x-\\cos x}","بتحليل البسط والاختصار"]],"a":"كلا الطرفين يساوي <span class=\"tx\" data-t=\"\\dfrac{\\sin x+\\cos x}{\\sin x-\\cos x}\"></span>، فالمتطابقة صحيحة","o":""},{"n":"14","s":[["(\\sec x-\\tan x)^2=\\left(\\frac{1}{\\cos x}-\\frac{\\sin x}{\\cos x}\\right)^2=\\frac{(1-\\sin x)^2}{\\cos^2x}","نبدأ بالطرف الأيمن؛ متطابقتا المقلوب والنسبة"],["=\\frac{(1-\\sin x)^2}{1-\\sin^2x}=\\frac{(1-\\sin x)^2}{(1-\\sin x)(1+\\sin x)}","المتطابقة الفيثاغورية وتحليل الفرق بين مربعين"],["=\\frac{1-\\sin x}{1+\\sin x}","بالاختصار"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"15","s":[["\\sin^4x-\\cos^4x=(\\sin^2x-\\cos^2x)(\\sin^2x+\\cos^2x)","تحليل الفرق بين مربعين"],["=(\\sin^2x-\\cos^2x)(1)=\\sin^2x-\\cos^2x","المتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"16","s":[["\\frac{1}{1-\\sin x}-\\frac{1}{1+\\sin x}=\\frac{(1+\\sin x)-(1-\\sin x)}{1-\\sin^2x}","بتوحيد المقامات"],["=\\frac{2\\sin x}{\\cos^2x}","المتطابقة الفيثاغورية"],["=2\\cdot\\frac{1}{\\cos x}\\cdot\\frac{\\sin x}{\\cos x}=2\\sec x\\tan x","متطابقتا المقلوب والنسبة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"17","s":[["\\ln|\\tan\\theta|=\\ln\\left|\\frac{\\sin\\theta}{\\cos\\theta}\\right|","متطابقة النسبة"],["=\\ln|\\sin\\theta|-\\ln|\\cos\\theta|","خاصية لوغاريتم القسمة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"18","s":[["\\ln|\\sec\\theta+\\tan\\theta|+\\ln|\\sec\\theta-\\tan\\theta|=\\ln|(\\sec\\theta+\\tan\\theta)(\\sec\\theta-\\tan\\theta)|","خاصية لوغاريتم الضرب"],["=\\ln|\\sec^2\\theta-\\tan^2\\theta|","الفرق بين مربعين"],["=\\ln 1=0","المتطابقة الفيثاغورية <span class=\"tx\" data-t=\"\\sec^2\\theta-\\tan^2\\theta=1\"></span>"]],"a":"الطرف الأيسر <span class=\"tx\" data-t=\"=0=\"></span> الطرف الأيمن، فالمتطابقة صحيحة","o":""}],[{"n":"19","s":[["\\sin 165^\\circ=\\sin(120^\\circ+45^\\circ)","نكتب الزاوية مجموع زاويتين خاصتين"],["=\\sin120^\\circ\\cos45^\\circ+\\cos120^\\circ\\sin45^\\circ","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}+\\left(-\\frac12\\right)\\frac{\\sqrt2}{2}=\\frac{\\sqrt6-\\sqrt2}{4}","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sin165^\\circ=\\dfrac{\\sqrt6-\\sqrt2}{4}\"></span>","o":""},{"n":"20","s":[["\\tan195^\\circ=\\tan(150^\\circ+45^\\circ)=\\frac{\\tan150^\\circ+\\tan45^\\circ}{1-\\tan150^\\circ\\tan45^\\circ}","متطابقة الظل لمجموع زاويتين"],["=\\frac{-\\frac{1}{\\sqrt3}+1}{1+\\frac{1}{\\sqrt3}}=\\frac{\\sqrt3-1}{\\sqrt3+1}","بالتعويض والضرب في <span class=\"tx\" data-t=\"\\sqrt3\"></span>"],["=\\frac{(\\sqrt3-1)^2}{3-1}=\\frac{4-2\\sqrt3}{2}=2-\\sqrt3","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"\\tan195^\\circ=2-\\sqrt3\"></span>","o":""},{"n":"21","s":[["\\cos\\left(-\\frac{\\pi}{12}\\right)=\\cos\\frac{\\pi}{12}=\\cos\\left(\\frac{\\pi}{3}-\\frac{\\pi}{4}\\right)","جيب التمام اقتران زوجي"],["=\\frac12\\cdot\\frac{\\sqrt2}{2}+\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}=\\frac{\\sqrt2+\\sqrt6}{4}","متطابقة جيب التمام للفرق بين زاويتين"],["\\sec\\left(-\\frac{\\pi}{12}\\right)=\\frac{4}{\\sqrt6+\\sqrt2}=\\frac{4(\\sqrt6-\\sqrt2)}{6-2}=\\sqrt6-\\sqrt2","متطابقة المقلوب وإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"\\sec\\left(-\\dfrac{\\pi}{12}\\right)=\\sqrt6-\\sqrt2\"></span>","o":""},{"n":"22","s":[["\\sin\\frac{17\\pi}{12}=\\sin\\left(\\frac{3\\pi}{4}+\\frac{2\\pi}{3}\\right)","<span class=\"tx\" data-t=\"\\frac{9\\pi}{12}+\\frac{8\\pi}{12}\"></span>"],["=\\sin\\frac{3\\pi}{4}\\cos\\frac{2\\pi}{3}+\\cos\\frac{3\\pi}{4}\\sin\\frac{2\\pi}{3}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt2}{2}\\left(-\\frac12\\right)+\\left(-\\frac{\\sqrt2}{2}\\right)\\frac{\\sqrt3}{2}=-\\frac{\\sqrt2+\\sqrt6}{4}","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sin\\dfrac{17\\pi}{12}=-\\dfrac{\\sqrt2+\\sqrt6}{4}\"></span>","o":""},{"n":"23","s":[["\\sin\\frac{\\pi}{18}\\cos\\frac{5\\pi}{18}+\\cos\\frac{\\pi}{18}\\sin\\frac{5\\pi}{18}=\\sin\\left(\\frac{\\pi}{18}+\\frac{5\\pi}{18}\\right)","متطابقة الجيب لمجموع زاويتين"],["=\\sin\\frac{6\\pi}{18}=\\sin\\frac{\\pi}{3}=\\frac{\\sqrt3}{2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt3}{2}\"></span>","o":""},{"n":"24","s":[["\\frac{\\tan40^\\circ-\\tan10^\\circ}{1+\\tan40^\\circ\\tan10^\\circ}=\\tan(40^\\circ-10^\\circ)","متطابقة الظل للفرق بين زاويتين"],["=\\tan30^\\circ=\\frac{\\sqrt3}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt3}{3}\"></span>","o":""}],[{"n":"25","s":[["a^2+4=5\\Rightarrow a=-1","النقطة <span class=\"tx\" data-t=\"(a,2)\"></span> على الدائرة وفي الربع الثاني"],["\\sin\\beta=\\frac{2}{\\sqrt5},\\ \\cos\\beta=-\\frac{1}{\\sqrt5}","<span class=\"tx\" data-t=\"r=\\sqrt5\"></span>"],["\\frac{1}{16}+b^2=1\\Rightarrow b=-\\frac{\\sqrt{15}}{4};\\ \\cos\\alpha=-\\frac14,\\ \\sin\\alpha=-\\frac{\\sqrt{15}}{4}","النقطة على دائرة الوحدة وفي الربع الثالث"],["f(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta=\\left(-\\frac{\\sqrt{15}}{4}\\right)\\left(-\\frac{1}{\\sqrt5}\\right)+\\left(-\\frac14\\right)\\frac{2}{\\sqrt5}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt{15}-2}{4\\sqrt5}=\\frac{5\\sqrt3-2\\sqrt5}{20}\\approx0.2094","بالتبسيط وإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"f(\\alpha+\\beta)=\\dfrac{5\\sqrt3-2\\sqrt5}{20}\"></span>","o":""},{"n":"26","s":[["g(\\alpha-\\beta)=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta","متطابقة جيب التمام للفرق بين زاويتين"],["=\\left(-\\frac14\\right)\\left(-\\frac{1}{\\sqrt5}\\right)+\\left(-\\frac{\\sqrt{15}}{4}\\right)\\frac{2}{\\sqrt5}","بالتعويض بالقيم من السؤال <span class=m dir=ltr>25</span>"],["=\\frac{1-2\\sqrt{15}}{4\\sqrt5}=\\frac{\\sqrt5-10\\sqrt3}{20}\\approx-0.7542","بالتبسيط وإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"g(\\alpha-\\beta)=\\dfrac{\\sqrt5-10\\sqrt3}{20}\"></span>","o":""},{"n":"27","s":[["\\tan\\alpha=\\frac{-\\sqrt{15}/4}{-1/4}=\\sqrt{15},\\quad \\tan\\beta=\\frac{2}{-1}=-2","متطابقة النسبة"],["h(\\alpha+\\beta)=\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}=\\frac{\\sqrt{15}-2}{1+2\\sqrt{15}}","متطابقة الظل لمجموع زاويتين"],["=\\frac{(\\sqrt{15}-2)(1-2\\sqrt{15})}{1-60}=\\frac{32-5\\sqrt{15}}{59}\\approx0.2142","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"h(\\alpha+\\beta)=\\dfrac{\\sqrt{15}-2}{1+2\\sqrt{15}}=\\dfrac{32-5\\sqrt{15}}{59}\"></span>","o":""}],[{"n":"28","s":[["n=\\frac{\\sin\\left(\\frac{\\theta}{2}+30^\\circ\\right)}{\\sin\\frac{\\theta}{2}}","بالتعويض <span class=\"tx\" data-t=\"\\alpha=60^\\circ\"></span> فيكون <span class=\"tx\" data-t=\"\\frac{\\alpha}{2}=30^\\circ\"></span>"],["=\\frac{\\sin\\frac{\\theta}{2}\\cos30^\\circ+\\cos\\frac{\\theta}{2}\\sin30^\\circ}{\\sin\\frac{\\theta}{2}}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sin\\frac{\\theta}{2}}{\\sin\\frac{\\theta}{2}}+\\frac12\\cdot\\frac{\\cos\\frac{\\theta}{2}}{\\sin\\frac{\\theta}{2}}","بتجزئة الكسر"],["n=\\frac{\\sqrt3}{2}+\\frac12\\cot\\frac{\\theta}{2}","متطابقة النسبة"]],"a":"<span class=\"tx\" data-t=\"n=\\dfrac{\\sqrt3}{2}+\\dfrac12\\cot\\dfrac{\\theta}{2}\"></span> كما هو مطلوب","o":""}],[{"n":"29","s":[["\\frac{g(x+h)-g(x)}{h}=\\frac{\\cos(x+h)-\\cos x}{h}","بتعريف الاقتران"],["=\\frac{\\cos x\\cos h-\\sin x\\sin h-\\cos x}{h}","متطابقة جيب التمام لمجموع زاويتين"],["=\\frac{-\\cos x(1-\\cos h)-\\sin x\\sin h}{h}","بإخراج <span class=\"tx\" data-t=\"-\\cos x\"></span> عاملًا مشتركًا"],["=-\\cos x\\left(\\frac{1-\\cos h}{h}\\right)-\\sin x\\left(\\frac{\\sin h}{h}\\right)","بتجزئة الكسر"]],"a":"الطرفان متساويان، فالعبارة صحيحة","o":""}],[{"n":"30","s":[["\\sin\\left(x+\\frac{\\pi}{6}\\right)=\\sin x\\cos\\frac{\\pi}{6}+\\cos x\\sin\\frac{\\pi}{6}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt3}{2}\\sin x+\\frac12\\cos x","بالتعويض"],["a=\\frac{\\sqrt3}{2},\\ b=\\frac12","بمقارنة المعاملات"]],"a":"<span class=\"tx\" data-t=\"a=\\dfrac{\\sqrt3}{2}\"></span> ، <span class=\"tx\" data-t=\"b=\\dfrac12\"></span>","o":""}],[{"n":"31","s":[["\\sin(A+B)+\\sin(A-B)=(\\sin A\\cos B+\\cos A\\sin B)+(\\sin A\\cos B-\\cos A\\sin B)","متطابقتا الجيب للمجموع والفرق"],["=2\\sin A\\cos B","بجمع الحدود المتشابهة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"32","s":[["\\sqrt2\\sin\\left(A+\\frac{\\pi}{4}\\right)=\\sqrt2\\left(\\sin A\\cos\\frac{\\pi}{4}+\\cos A\\sin\\frac{\\pi}{4}\\right)","نبدأ بالطرف الأيمن؛ متطابقة الجيب لمجموع زاويتين"],["=\\sqrt2\\left(\\frac{\\sqrt2}{2}\\sin A+\\frac{\\sqrt2}{2}\\cos A\\right)=\\sin A+\\cos A","بالتعويض والتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"33","s":[["\\frac{\\sin(A-B)}{\\cos A\\cos B}=\\frac{\\sin A\\cos B-\\cos A\\sin B}{\\cos A\\cos B}=\\tan A-\\tan B","متطابقة الجيب للفرق ثم تجزئة الكسر"],["\\frac{\\sin(B-C)}{\\cos B\\cos C}=\\tan B-\\tan C,\\quad \\frac{\\sin(C-A)}{\\cos C\\cos A}=\\tan C-\\tan A","بالطريقة نفسها"],["(\\tan A-\\tan B)+(\\tan B-\\tan C)+(\\tan C-\\tan A)=0","بالجمع"]],"a":"الطرف الأيسر <span class=\"tx\" data-t=\"=0=\"></span> الطرف الأيمن، فالمتطابقة صحيحة","o":""},{"n":"34","s":[["\\cos(x+y)\\cos(x-y)=(\\cos x\\cos y-\\sin x\\sin y)(\\cos x\\cos y+\\sin x\\sin y)","متطابقتا جيب التمام للمجموع والفرق"],["=\\cos^2x\\cos^2y-\\sin^2x\\sin^2y","الفرق بين مربعين"],["=\\cos^2x(1-\\sin^2y)-(1-\\cos^2x)\\sin^2y","المتطابقة الفيثاغورية"],["=\\cos^2x-\\cos^2x\\sin^2y-\\sin^2y+\\cos^2x\\sin^2y=\\cos^2x-\\sin^2y","بالتوزيع والتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"35","s":[["P(x_0,0),\\ Q(x_0+\\cos\\theta,\\ \\sin\\theta)","نأخذ نقطة تقاطع المستقيم مع المحور <span class=\"tx\" data-t=\"x\"></span>، ونقطة أخرى على المستقيم تبعد عنها وحدة واحدة في اتجاه الزاوية <span class=\"tx\" data-t=\"\\theta\"></span>"],["m=\\frac{y_2-y_1}{x_2-x_1}=\\frac{\\sin\\theta-0}{x_0+\\cos\\theta-x_0}","صيغة الميل"],["m=\\frac{\\sin\\theta}{\\cos\\theta}=\\tan\\theta","متطابقة النسبة (حيث <span class=\"tx\" data-t=\"\\theta\\ne\\frac{\\pi}{2}\"></span>)"]],"a":"ميل المستقيم <span class=\"tx\" data-t=\"m=\\tan\\theta\"></span>","o":"تصلح الطريقة لأيّ <span class=\"tx\" data-t=\"0&lt;\\theta&lt;\\pi\"></span> (حادة أو منفرجة)، لأن إحداثيي النقطة على بعد وحدة هما <span class=\"tx\" data-t=\"\\cos\\theta\"></span> و <span class=\"tx\" data-t=\"\\sin\\theta\"></span>"}],[{"n":"36","s":[["m_1=\\tan\\theta_1,\\quad m_2=\\tan\\theta_2","نتيجة السؤال <span class=m dir=ltr>35</span>"],["\\psi=\\theta_2-\\theta_1","من الشكل (الزاوية الخارجية للمثلث)"],["\\tan\\psi=\\tan(\\theta_2-\\theta_1)=\\frac{\\tan\\theta_2-\\tan\\theta_1}{1+\\tan\\theta_2\\tan\\theta_1}","متطابقة الظل للفرق بين زاويتين"],["\\tan\\psi=\\frac{m_2-m_1}{1+m_1m_2}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\tan\\psi=\\dfrac{m_2-m_1}{1+m_1m_2}\"></span> كما هو مطلوب","o":""}],[{"n":"37","s":[["\\tan\\alpha=\\frac{4}{6}=\\frac23,\\quad \\tan\\beta=\\frac34","من المثلثين القائمين (المقابل <span class=m dir=ltr>÷</span> المجاور)"],["\\text{angle at }P=90^\\circ-\\alpha,\\quad \\text{angle at }Q=90^\\circ-\\beta","زاويتا المثلث السفلي عند نقطتي التقاطع تقابلان بالرأس الزاويتين <span class=\"tx\" data-t=\"90^\\circ-\\alpha\"></span> و <span class=\"tx\" data-t=\"90^\\circ-\\beta\"></span>"],["\\gamma=180^\\circ-(90^\\circ-\\alpha)-(90^\\circ-\\beta)=\\alpha+\\beta","مجموع زوايا المثلث"],["\\tan\\gamma=\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}=\\frac{\\frac23+\\frac34}{1-\\frac12}=\\frac{17/12}{1/2}","متطابقة الظل لمجموع زاويتين"],["\\tan\\gamma=\\frac{17}{6}",""]],"a":"<span class=\"tx\" data-t=\"\\gamma=\\alpha+\\beta\"></span> ، <span class=\"tx\" data-t=\"\\tan\\gamma=\\dfrac{17}{6}\"></span>","o":""}],[{"n":"38","s":[["\\tan(\\alpha-\\beta)=\\frac{\\tan\\alpha-\\tan\\beta}{1+\\tan\\alpha\\tan\\beta}=\\frac{(x+1)-(x-1)}{1+(x+1)(x-1)}","متطابقة الظل للفرق بين زاويتين"],["=\\frac{2}{1+x^2-1}=\\frac{2}{x^2}","بالتبسيط"],["\\cot(\\alpha-\\beta)=\\frac{1}{\\tan(\\alpha-\\beta)}=\\frac{x^2}{2}","متطابقة المقلوب"],["2\\cot(\\alpha-\\beta)=x^2","بضرب الطرفين في <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"2\\cot(\\alpha-\\beta)=x^2\"></span> (التبرير: الظل للفرق يعطي <span class=\"tx\" data-t=\"\\frac{2}{x^2}\"></span> ومقلوبه <span class=\"tx\" data-t=\"\\frac{x^2}{2}\"></span>)","o":""}],[{"n":"39","s":[["\\cos^{-1}\\frac12=\\frac{\\pi}{3},\\quad \\sin^{-1}\\frac{1}{\\sqrt2}=\\frac{\\pi}{4}","قيم الاقترانات العكسية"],["\\sin\\left(\\frac{\\pi}{3}+\\frac{\\pi}{4}\\right)=\\sin\\frac{\\pi}{3}\\cos\\frac{\\pi}{4}+\\cos\\frac{\\pi}{3}\\sin\\frac{\\pi}{4}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}+\\frac12\\cdot\\frac{\\sqrt2}{2}=\\frac{\\sqrt6+\\sqrt2}{4}","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt6+\\sqrt2}{4}\\approx0.9659\"></span>","o":""}],[{"n":"40","s":[["\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y","الخطأ: عكس ترتيب الزاويتين، فكتب <span class=\"tx\" data-t=\"\\sin\\frac{\\pi}{4}\\cos x-\\cos\\frac{\\pi}{4}\\sin x\"></span> وهذا يساوي <span class=\"tx\" data-t=\"\\sin(\\frac{\\pi}{4}-x)\"></span>"],["\\sin\\left(x-\\frac{\\pi}{4}\\right)=\\sin x\\cos\\frac{\\pi}{4}-\\cos x\\sin\\frac{\\pi}{4}","التصحيح: متطابقة الجيب للفرق"],["=\\frac{\\sqrt2}{2}\\sin x-\\frac{\\sqrt2}{2}\\cos x=\\frac{\\sqrt2}{2}(\\sin x-\\cos x)","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sin\\left(x-\\dfrac{\\pi}{4}\\right)=\\dfrac{\\sqrt2}{2}(\\sin x-\\cos x)\"></span>","o":""}],[{"n":"1","s":[["\\tan\\theta=\\frac{1}{\\cot\\theta}=\\frac11=1","متطابقة المقلوب"]],"a":"<span class=m dir=ltr>(b)</span> <span class=\"tx\" data-t=\"1\"></span>","o":""}],[{"n":"2","s":[["\\sin\\left(\\frac{\\pi}{2}-x\\right)=\\cos x","متطابقة الزاويتين المتتامتين"],["=-0.45",""]],"a":"<span class=m dir=ltr>(b)</span> <span class=\"tx\" data-t=\"-0.45\"></span>","o":""}],[{"n":"3","s":[["\\text{a), b), c)}\\ \\checkmark","الظل اقتران فردي، ومقلوب ظل التمام، ونسبة الجيب إلى جيب التمام"],["\\tan^2(-x)+1=\\sec^2(-x)","المتطابقة الصحيحة فيها مربعات؛ أمّا <span class=\"tx\" data-t=\"\\tan(-x)+1=\\sec(-x)\"></span> فغير صحيحة (مثلًا <span class=\"tx\" data-t=\"x=\\frac{\\pi}{4}\"></span>: <span class=\"tx\" data-t=\"0\\ne\\sqrt2\"></span>)"]],"a":"<span class=m dir=ltr>(d)</span> <span class=\"tx\" data-t=\"\\tan(-x)+1=\\sec(-x)\"></span>","o":""}],[{"n":"4","s":[["\\frac{1-\\sin^2x}{1-\\cos^2x}\\times\\tan x=\\frac{\\cos^2x}{\\sin^2x}\\cdot\\frac{\\sin x}{\\cos x}","المتطابقة الفيثاغورية ومتطابقة النسبة"],["=\\frac{\\cos x}{\\sin x}=\\cot x","بالاختصار"]],"a":"<span class=m dir=ltr>(c)</span> <span class=\"tx\" data-t=\"\\cot x\"></span>","o":""}],[{"n":"5","s":[["\\text{a)}\\ \\frac{\\cos x}{1}=\\cos x,\\ \\ \\text{b)}\\ \\frac{\\cos x}{\\sin x}\\sin x=\\cos x,\\ \\ \\text{c)}\\ \\frac{\\cos^2x}{\\cos x}=\\cos x","كل منها يكافئ <span class=\"tx\" data-t=\"\\cos x\"></span>"],["\\text{d)}\\ \\tan x\\csc x=\\frac{\\sin x}{\\cos x}\\cdot\\frac{1}{\\sin x}=\\sec x","لا يكافئ <span class=\"tx\" data-t=\"\\cos x\"></span>"]],"a":"<span class=m dir=ltr>(d)</span> <span class=\"tx\" data-t=\"\\tan x\\csc x\"></span>","o":""}],[{"n":"6","s":[["\\sin x+\\frac{\\cos x}{\\sin x}\\cos x=\\frac{\\sin^2x+\\cos^2x}{\\sin x}","متطابقة النسبة وتوحيد المقامات"],["=\\frac{1}{\\sin x}","المتطابقة الفيثاغورية"]],"a":"<span class=m dir=ltr>(b)</span> <span class=\"tx\" data-t=\"\\dfrac{1}{\\sin x}\"></span>","o":""}],[{"n":"9","s":[["\\frac{\\cos x(\\cot^2x+1)}{\\csc x}=\\frac{\\cos x\\csc^2x}{\\csc x}","المتطابقة الفيثاغورية"],["=\\cos x\\csc x=\\frac{\\cos x}{\\sin x}=\\cot x","بالاختصار ومتطابقة المقلوب"]],"a":"<span class=m dir=ltr>(b)</span> <span class=\"tx\" data-t=\"\\cot x\"></span>","o":""}],[{"n":"10","s":[["\\frac{\\sec x+\\csc x}{1+\\tan x}=\\frac{\\frac{1}{\\cos x}+\\frac{1}{\\sin x}}{\\frac{\\cos x+\\sin x}{\\cos x}}","متطابقتا المقلوب والنسبة"],["=\\frac{\\sin x+\\cos x}{\\sin x\\cos x}\\cdot\\frac{\\cos x}{\\sin x+\\cos x}","بتوحيد المقامات والقسمة"],["=\\frac{1}{\\sin x}=\\csc x","بالاختصار"]],"a":"<span class=m dir=ltr>(d)</span> <span class=\"tx\" data-t=\"\\csc x\"></span>","o":""}],[{"n":"20","s":[["\\sin\\theta=\\sqrt{1-\\frac{16}{25}}=\\frac35","المتطابقة الفيثاغورية؛ <span class=\"tx\" data-t=\"\\theta\"></span> حادة"],["\\cos\\left(\\theta+\\frac{\\pi}{4}\\right)=\\cos\\theta\\cos\\frac{\\pi}{4}-\\sin\\theta\\sin\\frac{\\pi}{4}","متطابقة جيب التمام لمجموع زاويتين"],["=\\frac45\\cdot\\frac{\\sqrt2}{2}-\\frac35\\cdot\\frac{\\sqrt2}{2}=\\frac{\\sqrt2}{2}\\cdot\\frac15=\\frac{\\sqrt2}{10}","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\cos\\left(\\theta+\\dfrac{\\pi}{4}\\right)=\\dfrac{\\sqrt2}{10}\"></span> كما هو مطلوب","o":""}],[{"n":"21","s":[["\\frac{\\sec x-\\cos x}{\\sec x}=1-\\frac{\\cos x}{\\sec x}=1-\\cos x\\cdot\\cos x","بتجزئة الكسر ومتطابقة المقلوب"],["=1-\\cos^2x=\\sin^2x","المتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"22","s":[["(\\sin x+\\cos x)^4=\\left[(\\sin x+\\cos x)^2\\right]^2","قوانين الأسس"],["=(\\sin^2x+2\\sin x\\cos x+\\cos^2x)^2=(1+2\\sin x\\cos x)^2","بفك المربع والمتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"23","s":[["\\cot(x+y)=\\frac{\\cos(x+y)}{\\sin(x+y)}=\\frac{\\cos x\\cos y-\\sin x\\sin y}{\\sin x\\cos y+\\cos x\\sin y}","متطابقتا المجموع"],["=\\frac{\\frac{\\cos x\\cos y}{\\sin x\\sin y}-1}{\\frac{\\cos y}{\\sin y}+\\frac{\\cos x}{\\sin x}}","بقسمة البسط والمقام على <span class=\"tx\" data-t=\"\\sin x\\sin y\"></span>"],["=\\frac{\\cot x\\cot y-1}{\\cot x+\\cot y}","متطابقة النسبة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"24","s":[["\\frac{\\sin x\\sec x}{\\tan x}=\\frac{\\sin x\\cdot\\frac{1}{\\cos x}}{\\tan x}=\\frac{\\tan x}{\\tan x}","متطابقتا المقلوب والنسبة"],["=1",""]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"25","s":[["\\ln|\\sec\\theta|=\\ln\\left|\\frac{1}{\\cos\\theta}\\right|","متطابقة المقلوب"],["=\\ln1-\\ln|\\cos\\theta|=-\\ln|\\cos\\theta|","لوغاريتم القسمة و <span class=\"tx\" data-t=\"\\ln1=0\"></span>"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"26","s":[["\\tan(-15^\\circ)=-\\tan15^\\circ=-\\tan(45^\\circ-30^\\circ)","الظل اقتران فردي"],["=-\\frac{1-\\frac{1}{\\sqrt3}}{1+\\frac{1}{\\sqrt3}}=-\\frac{\\sqrt3-1}{\\sqrt3+1}","متطابقة الظل للفرق"],["=-\\frac{(\\sqrt3-1)^2}{2}=-(2-\\sqrt3)=\\sqrt3-2","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"\\tan(-15^\\circ)=\\sqrt3-2\"></span>","o":""},{"n":"27","s":[["\\sin\\frac{7\\pi}{12}=\\sin\\left(\\frac{\\pi}{3}+\\frac{\\pi}{4}\\right)=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}+\\frac12\\cdot\\frac{\\sqrt2}{2}","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt6+\\sqrt2}{4}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt6+\\sqrt2}{4}\"></span>","o":""},{"n":"28","s":[["\\frac{\\tan20^\\circ+\\tan25^\\circ}{1-\\tan20^\\circ\\tan25^\\circ}=\\tan(20^\\circ+25^\\circ)","متطابقة الظل لمجموع زاويتين"],["=\\tan45^\\circ=1",""]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":""},{"n":"29","s":[["\\cos\\frac{5\\pi}{12}\\cos\\frac{7\\pi}{12}-\\sin\\frac{5\\pi}{12}\\sin\\frac{7\\pi}{12}=\\cos\\left(\\frac{5\\pi}{12}+\\frac{7\\pi}{12}\\right)","متطابقة جيب التمام لمجموع زاويتين"],["=\\cos\\pi=-1",""]],"a":"<span class=\"tx\" data-t=\"-1\"></span>","o":""}],[{"n":"1","s":[["\\cos^3x+\\sin^2x\\cos x=\\cos x(\\cos^2x+\\sin^2x)","بإخراج <span class=\"tx\" data-t=\"\\cos x\"></span> عاملًا مشتركًا"],["=\\cos x","المتطابقة الفيثاغورية"]],"a":"<span class=\"tx\" data-t=\"\\cos x\"></span>","o":""},{"n":"2","s":[["\\frac{1}{1-\\cos x}+\\frac{1}{1+\\cos x}=\\frac{(1+\\cos x)+(1-\\cos x)}{1-\\cos^2x}","بتوحيد المقامات"],["=\\frac{2}{\\sin^2x}=2\\csc^2x","المتطابقة الفيثاغورية ومتطابقة المقلوب"]],"a":"<span class=\"tx\" data-t=\"2\\csc^2x\"></span>","o":""},{"n":"3","s":[["\\frac{\\sec^2x-1}{\\sec^2x}=\\frac{\\tan^2x}{\\sec^2x}","المتطابقة الفيثاغورية"],["=\\frac{\\sin^2x}{\\cos^2x}\\cdot\\cos^2x=\\sin^2x","متطابقتا النسبة والمقلوب"]],"a":"<span class=\"tx\" data-t=\"\\sin^2x\"></span>","o":""},{"n":"4","s":[["\\frac{\\cos^2x-1}{\\cos^2x-\\cos x}=\\frac{(\\cos x-1)(\\cos x+1)}{\\cos x(\\cos x-1)}","بالتحليل"],["=\\frac{\\cos x+1}{\\cos x}=1+\\sec x","بالاختصار وتجزئة الكسر"]],"a":"<span class=\"tx\" data-t=\"1+\\sec x\"></span>","o":""},{"n":"5","s":[["\\frac{1+\\cos x}{1+\\sec x}=\\frac{1+\\cos x}{1+\\frac{1}{\\cos x}}=\\frac{1+\\cos x}{\\frac{\\cos x+1}{\\cos x}}","متطابقة المقلوب"],["=(1+\\cos x)\\cdot\\frac{\\cos x}{1+\\cos x}=\\cos x","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"\\cos x\"></span>","o":""},{"n":"6","s":[["\\frac{3\\sin^2x+4\\sin x+1}{\\sin^2x+2\\sin x+1}=\\frac{(3\\sin x+1)(\\sin x+1)}{(\\sin x+1)^2}","بتحليل البسط والمقام"],["=\\frac{3\\sin x+1}{\\sin x+1}","بالاختصار"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{3\\sin x+1}{\\sin x+1}\"></span>","o":""}],[{"n":"7","s":[["\\frac{\\cos x}{\\sec x}+\\frac{\\sin x}{\\csc x}=\\cos x\\cdot\\cos x+\\sin x\\cdot\\sin x","متطابقة المقلوب"],["=\\cos^2x+\\sin^2x=1","المتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"8","s":[["\\ln|1+\\cos\\theta|+\\ln|1-\\cos\\theta|=\\ln|1-\\cos^2\\theta|","لوغاريتم الضرب"],["=\\ln|\\sin^2\\theta|=2\\ln|\\sin\\theta|","المتطابقة الفيثاغورية ولوغاريتم القوة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"9","s":[["\\frac{1}{1-\\sin^2x}=\\frac{1}{\\cos^2x}=\\sec^2x","المتطابقة الفيثاغورية ومتطابقة المقلوب"],["=1+\\tan^2x","المتطابقة الفيثاغورية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"10","s":[["\\frac{\\sin(A+B)}{\\cos A\\cos B}=\\frac{\\sin A\\cos B+\\cos A\\sin B}{\\cos A\\cos B}","نبدأ بالطرف الأيمن؛ متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sin A}{\\cos A}+\\frac{\\sin B}{\\cos B}=\\tan A+\\tan B","بتجزئة الكسر ومتطابقة النسبة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"11","s":[["\\sin105^\\circ=\\sin(60^\\circ+45^\\circ)=\\sin60^\\circ\\cos45^\\circ+\\cos60^\\circ\\sin45^\\circ","متطابقة الجيب لمجموع زاويتين"],["=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}+\\frac12\\cdot\\frac{\\sqrt2}{2}=\\frac{\\sqrt6+\\sqrt2}{4}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt6+\\sqrt2}{4}\"></span>","o":""},{"n":"12","s":[["\\tan\\frac{19\\pi}{12}=\\tan\\left(\\frac{19\\pi}{12}-\\pi\\right)=\\tan\\frac{7\\pi}{12}","دورة الظل <span class=\"tx\" data-t=\"\\pi\"></span>"],["=\\tan\\left(\\frac{\\pi}{3}+\\frac{\\pi}{4}\\right)=\\frac{\\sqrt3+1}{1-\\sqrt3}","متطابقة الظل لمجموع زاويتين"],["=\\frac{(\\sqrt3+1)(1+\\sqrt3)}{1-3}=\\frac{4+2\\sqrt3}{-2}=-2-\\sqrt3","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"-(2+\\sqrt3)\"></span>","o":""},{"n":"13","s":[["\\cos10^\\circ\\cos80^\\circ-\\sin10^\\circ\\sin80^\\circ=\\cos(10^\\circ+80^\\circ)","متطابقة جيب التمام لمجموع زاويتين"],["=\\cos90^\\circ=0",""]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":""}],[{"n":"14","s":[["\\sin x+\\frac{\\sqrt3}{2}\\sin x+\\frac12\\cos x=\\frac12\\sin x+\\frac{\\sqrt3}{2}\\cos x","متطابقة الجيب لمجموع زاويتين للطرفين"],["\\sin x\\left(\\frac{1+\\sqrt3}{2}\\right)=\\cos x\\left(\\frac{\\sqrt3-1}{2}\\right)","بجمع الحدود المتشابهة"],["\\tan x=\\frac{\\sqrt3-1}{\\sqrt3+1}","بقسمة الطرفين على <span class=\"tx\" data-t=\"\\cos x\\cdot\\frac{1+\\sqrt3}{2}\"></span>"],["=\\frac{(\\sqrt3-1)^2}{3-1}=\\frac{4-2\\sqrt3}{2}=2-\\sqrt3","بإنطاق المقام"]],"a":"<span class=\"tx\" data-t=\"\\tan x=2-\\sqrt3\"></span> كما هو مطلوب","o":""}],[{"n":"15","s":[["A=\\frac{\\pi}{4}-B","من <span class=\"tx\" data-t=\"A+B=\\frac{\\pi}{4}\"></span>"],["\\tan A=\\tan\\left(\\frac{\\pi}{4}-B\\right)=\\frac{\\tan\\frac{\\pi}{4}-\\tan B}{1+\\tan\\frac{\\pi}{4}\\tan B}","متطابقة الظل للفرق"],["=\\frac{1-\\tan B}{1+\\tan B}","<span class=\"tx\" data-t=\"\\tan\\frac{\\pi}{4}=1\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\tan A=\\dfrac{1-\\tan B}{1+\\tan B}\"></span> كما هو مطلوب","o":""}],[{"n":"16","s":[["\\frac{\\sin t\\cos s+\\sin s\\cos t}{\\cos t\\cos s-\\sin s\\sin t}=\\frac{\\sin(s+t)}{\\cos(s+t)}","متطابقتا الجيب وجيب التمام لمجموع زاويتين"],["=\\tan(s+t)","متطابقة النسبة"]],"a":"المتطابقة صحيحة؛ التبرير: البسط هو مفكوك <span class=\"tx\" data-t=\"\\sin(s+t)\"></span> والمقام مفكوك <span class=\"tx\" data-t=\"\\cos(s+t)\"></span>، وناتج قسمتهما <span class=\"tx\" data-t=\"\\tan(s+t)\"></span>","o":""}],[{"n":"17","s":[["(\\csc\\theta-\\cot\\theta)^2=\\left(\\frac{1-\\cos\\theta}{\\sin\\theta}\\right)^2=\\frac{(1-\\cos\\theta)^2}{\\sin^2\\theta}","نبدأ بالطرف الأيمن؛ متطابقتا المقلوب والنسبة"],["=\\frac{(1-\\cos\\theta)^2}{(1-\\cos\\theta)(1+\\cos\\theta)}","المتطابقة الفيثاغورية والتحليل"],["=\\frac{1-\\cos\\theta}{1+\\cos\\theta}","بالاختصار"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"18","s":[["\\sin(x+y)\\sin(x-y)=(\\sin x\\cos y+\\cos x\\sin y)(\\sin x\\cos y-\\cos x\\sin y)","متطابقتا الجيب للمجموع والفرق"],["=\\sin^2x\\cos^2y-\\cos^2x\\sin^2y","الفرق بين مربعين"],["=\\sin^2x(1-\\sin^2y)-(1-\\sin^2x)\\sin^2y=\\sin^2x-\\sin^2y","المتطابقة الفيثاغورية والتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}]]