[[{"n":"1","s":[["A=\\{3\\},\\quad B=\\{2,4,6\\}","<span class=m dir=ltr>A</span>: ظهور العدد <span class=m dir=ltr>3</span>، <span class=m dir=ltr>B</span>: ظهور عدد زوجي"],["A\\cap B=\\varnothing","لا يوجد عنصر مشترك"]],"a":"متنافيان؛ لأنه لا يمكن وقوعهما معًا (<span class=\"tx\" data-t=\"A \\cap B = \\varnothing\"></span>)","o":""},{"n":"2","s":[["A=\\{1,2,3,4,6\\}","عوامل العدد <span class=m dir=ltr>12</span> الظاهرة على حجر النرد"],["B=\\{2,3,5\\}","الأعداد الأولية على حجر النرد"],["A\\cap B=\\{2,3\\}\\ne\\varnothing","يوجد عنصران مشتركان"]],"a":"غير متنافيين؛ لأن ظهور <span class=m dir=ltr>2</span> أو <span class=m dir=ltr>3</span> يحقق الحادثين معًا","o":""},{"n":"3","s":[["A=\\{(2,6),(3,5),(4,4),(5,3),(6,2)\\}","مجموع العددين <span class=m dir=ltr>8</span>"],["B=\\{(6,6)\\}","مجموع العددين <span class=m dir=ltr>12</span>"],["A\\cap B=\\varnothing","لا يمكن أن يكون المجموع <span class=m dir=ltr>8</span> و <span class=m dir=ltr>12</span> معًا"]],"a":"متنافيان؛ لأن <span class=\"tx\" data-t=\"A \\cap B = \\varnothing\"></span>","o":""}],[{"n":"4","s":[["A=\\{7,14\\},\\quad B=\\{5,10,15,20\\}","مضاعفات <span class=m dir=ltr>7</span> ومضاعفات <span class=m dir=ltr>5</span> من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>20</span>"],["A\\cap B=\\varnothing","لا يوجد عدد من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>20</span> من مضاعفات <span class=m dir=ltr>7</span> و <span class=m dir=ltr>5</span> معًا (أصغرها <span class=m dir=ltr>35)</span>"],["P(A\\cap B)=0","الحادثان متنافيان"]],"a":"<span class=\"tx\" data-t=\"P(A \\cap B) = 0\"></span>","o":""},{"n":"5","s":[["P(A\\cup B)=P(A)+P(B)","الحادثان متنافيان"],["=\\frac{2}{20}+\\frac{4}{20}=\\frac{6}{20}","بالتعويض"],["=\\frac{3}{10}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup B) = \\frac{3}{10} = 0.3\"></span>","o":""},{"n":"6","s":[["A=\\{1,3,5,\\dots,19\\},\\quad B=\\{4,8,12,16,20\\}","الأعداد الفردية، والأعداد التي تقبل القسمة على <span class=m dir=ltr>4</span>"],["A\\cap B=\\varnothing","كل عدد يقبل القسمة على <span class=m dir=ltr>4</span> هو عدد زوجي"],["P(A\\cap B)=0","الحادثان متنافيان"]],"a":"<span class=\"tx\" data-t=\"P(A \\cap B) = 0\"></span>","o":""},{"n":"7","s":[["P(A\\cup B)=P(A)+P(B)","الحادثان متنافيان"],["=\\frac{10}{20}+\\frac{5}{20}=\\frac{15}{20}","بالتعويض"],["=\\frac{3}{4}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup B) = \\frac{3}{4} = 0.75\"></span>","o":""}],[{"n":"8","s":[["A\\cap B=\\varnothing","الحادثان متنافيان"],["P(A\\cap B)=0",""]],"a":"<span class=\"tx\" data-t=\"P(A \\cap B) = 0\"></span>","o":""},{"n":"9","s":[["P(A\\cup B)=P(A)+P(B)","احتمال اتحاد حادثين متنافيين"],["=0.4+0.25=0.65","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup B) = 0.65\"></span>","o":""},{"n":"10","s":[["P(\\overline{A\\cup B})=1-P(A\\cup B)","احتمال المتممة"],["=1-0.65=0.35","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{A \\cup B}) = 0.35\"></span>","o":""},{"n":"11","s":[["P(A-B)=P(A)-P(A\\cap B)","احتمال الفرق"],["=0.4-0=0.4","بالتعويض؛ لأن الحادثين متنافيان"]],"a":"<span class=\"tx\" data-t=\"P(A - B) = 0.4\"></span>","o":""}],[{"n":"12","s":[["n(\\Omega)=21","عدد الكرات"],["A=\\{2,4,6,\\dots,20\\},\\ n(A)=10","الأعداد الزوجية من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>21</span>"],["P(A)=\\frac{10}{21}","احتمال الحادث"]],"a":"<span class=\"tx\" data-t=\"P(A) = \\frac{10}{21}\"></span>","o":""},{"n":"13","s":[["B=\\{3,6,9,12,15,18,21\\},\\ n(B)=7","مضاعفات العدد <span class=m dir=ltr>3</span>"],["P(B)=\\frac{7}{21}=\\frac{1}{3}","احتمال الحادث، بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(B) = \\frac{1}{3}\"></span>","o":""},{"n":"14","s":[["A\\cap B=\\{6,12,18\\}","أعداد زوجية ومن مضاعفات <span class=m dir=ltr>3</span> معًا"],["P(A\\cap B)=\\frac{3}{21}=\\frac{1}{7}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cap B) = \\frac{1}{7}\"></span>","o":""},{"n":"15","s":[["P(A\\cup B)=P(A)+P(B)-P(A\\cap B)","احتمال اتحاد حادثين غير متنافيين"],["=\\frac{10}{21}+\\frac{7}{21}-\\frac{3}{21}=\\frac{14}{21}","بالتعويض"],["=\\frac{2}{3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup B) = \\frac{2}{3}\"></span>","o":""}],[{"n":"16","s":[["P(A\\cup B)=P(A)+P(B)-P(A\\cap B)","احتمال اتحاد حادثين"],["=0.3+0.5-0.15=0.65","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup B) = 0.65\"></span>","o":""},{"n":"17","s":[["P(\\overline{A})=1-P(A)","احتمال المتممة"],["=1-0.3=0.7","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{A}) = 0.7\"></span>","o":""},{"n":"18","s":[["P(B-A)=P(B)-P(A\\cap B)","احتمال الفرق"],["=0.5-0.15=0.35","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(B - A) = 0.35\"></span>","o":""},{"n":"19","s":[["A\\cup\\overline{B}=\\overline{B-A}","المنطقة المتبقية من فضاء العينة بعد حذف <span class=m dir=ltr>B − A (</span>شكل فن)"],["P(A\\cup\\overline{B})=1-P(B-A)","احتمال المتممة"],["=1-0.35=0.65","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(A \\cup \\overline{B}) = 0.65\"></span>","o":""},{"n":"20","s":[["\\overline{A}\\cup\\overline{B}=\\overline{A\\cap B}","متممة التقاطع"],["P(\\overline{A}\\cup\\overline{B})=1-P(A\\cap B)","احتمال المتممة"],["=1-0.15=0.85","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{A} \\cup \\overline{B}) = 0.85\"></span>","o":""}],[{"n":"21","s":[["P=\\frac{12}{60}","عدد من يمارسون اللعبتين <span class=m dir=ltr>÷</span> العدد الكلي"],["=\\frac{1}{5}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5} = 0.2\"></span>","o":""},{"n":"22","s":[["P=\\frac{30}{60}=\\frac{1}{2}","كرة القدم فقط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2} = 0.5\"></span>","o":""},{"n":"23","s":[["P=\\frac{8}{60}=\\frac{2}{15}","كرة السلة فقط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{15} \\approx 0.1333\"></span>","o":""},{"n":"24","s":[["P=\\frac{10}{60}=\\frac{1}{6}","لا يمارسون أيًّا من اللعبتين"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6} \\approx 0.1667\"></span>","o":""}],[{"n":"25","s":[["P(A)=0.6,\\ P(B)=0.5,\\ P(A\\cap B)=0.3","<span class=m dir=ltr>A</span>: وصول الباخرة الأولى في موعدها، <span class=m dir=ltr>B</span>: وصول الثانية في موعدها (مسألة اليوم)"],["P(A\\cup B)=P(A)+P(B)-P(A\\cap B)","وصول إحداهما على الأقل يعني الاتحاد"],["=0.6+0.5-0.3=0.8","بالتعويض والتبسيط"]],"a":"احتمال وصول إحدى الباخرتين على الأقل في موعدها <span class=\"tx\" data-t=\"0.8\"></span> أي <span class=\"tx\" data-t=\"80\\%\"></span>","o":""}],[{"n":"26","s":[["P(R\\cap S)=x,\\quad P(R)=P(S)=3x","نفرض قيمة التقاطع"],["P(R\\cup S)=P(R)+P(S)-P(R\\cap S)","احتمال اتحاد حادثين"],["0.75=3x+3x-x=5x","بالتعويض"],["x=0.15","بقسمة الطرفين على <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"P(R \\cap S) = 0.15\"></span>","o":""},{"n":"27","s":[["P(R)=3(0.15)=0.45","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"P(R) = 0.45\"></span>","o":""},{"n":"28","s":[["P(S)=0.45","لأن <span class=m dir=ltr>P(S) = P(R)</span>"],["P(\\overline{S})=1-0.45=0.55","احتمال المتممة"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{S}) = 0.55\"></span>","o":""},{"n":"29","s":[["\\overline{R}\\cap\\overline{S}=\\overline{R\\cup S}","متممة الاتحاد"],["P(\\overline{R}\\cap\\overline{S})=1-0.75=0.25","احتمال المتممة"]],"a":"<span class=\"tx\" data-t=\"P(\\overline{R} \\cap \\overline{S}) = 0.25\"></span>","o":""}],[{"n":"30","s":[["\\Omega=\\{\\text{فوز},\\ \\text{تعادل},\\ \\text{خسارة}\\}","نتائج المباراة الممكنة ثلاث"],["P(\\overline{\\text{فوز}})=1-0.3=0.7","<span class=m dir=ltr>0.7</span> هو احتمال عدم الفوز"],["P(\\text{خسارة})=0.7-P(\\text{تعادل})","احتمال الخسارة"]],"a":"قول يزيد غير صحيح (إلا إذا كان التعادل مستحيلًا)؛ لأن متممة الفوز هي «عدم الفوز» وتشمل التعادل والخسارة، فاحتمال الخسارة يساوي <span class=m dir=ltr>0.7</span> مطروحًا منه احتمال التعادل، أي إنه أقل من أو يساوي <span class=m dir=ltr>0.7</span>","o":""}],[{"n":"31","s":[["A\\cap B=\\varnothing","موقف <span class=m dir=ltr>1</span>: عند الذهاب إلى المدرسة، <span class=m dir=ltr>A</span>: الذهاب بالحافلة، <span class=m dir=ltr>B</span>: الذهاب سيرًا على الأقدام (في الرحلة نفسها)"],["A\\cap B\\ne\\varnothing","موقف <span class=m dir=ltr>2</span>: عند اختيار طالب من الصف، <span class=m dir=ltr>A</span>: يحب الرياضيات، <span class=m dir=ltr>B</span>: يحب العلوم"]],"a":"إجابة ممكنة: الموقف الأول حادثان متنافيان لأنه لا يمكن الذهاب بالحافلة وسيرًا على الأقدام في الوقت نفسه فلا يقعان معًا؛ والموقف الثاني حادثان غير متنافيين لأنه يمكن أن يحب الطالب الرياضيات والعلوم معًا، أي يوجد عنصر مشترك بينهما","o":""}],[{"n":"7","s":[["P(A \\cup B) = P(A) + P(B) - P(A \\cap B)","قانون الاتحاد"],["= 0.3 + 0.6 - 0.1 = 0.8","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"0.8\"></span>","o":""},{"n":"8","s":[["P(\\overline{A}) = 1 - P(A) = 1 - 0.3 = 0.7","الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"0.7\"></span>","o":""},{"n":"9","s":[["P(B - A) = P(B) - P(A \\cap B)","الفرق"],["= 0.6 - 0.1 = 0.5","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"0.5\"></span>","o":""},{"n":"10","s":[["P(\\overline{B}) = 0.4,\\ P(A \\cap \\overline{B}) = 0.3 - 0.1 = 0.2",""],["P(A \\cup \\overline{B}) = 0.3 + 0.4 - 0.2 = 0.5","قانون الاتحاد"]],"a":"<span class=\"tx\" data-t=\"0.5\"></span>","o":""},{"n":"11","s":[["\\overline{A} \\cup \\overline{B} = \\overline{A \\cap B}","قانون دي مورغان"],["P = 1 - 0.1 = 0.9","الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"0.9\"></span>","o":""}],[{"n":"1","s":[["\\{1, 2, 3\\} \\cap \\{3, 6, 9\\} = \\{3\\}","أقل من <span class=m dir=ltr>4</span> ويقبل القسمة على <span class=m dir=ltr>3</span>"],["P = \\frac{1}{10}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{10} = 0.1\"></span>","o":""},{"n":"2","s":[["\\{1, 2, 3\\} \\cup \\{3, 6, 9\\} = \\{1, 2, 3, 6, 9\\}","الاتحاد"],["P = \\frac{3}{10} + \\frac{3}{10} - \\frac{1}{10} = \\frac{5}{10}","قانون الاتحاد"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2} = 0.5\"></span>","o":""}],[{"n":"3","s":[["n(\\Omega) = 16","عدد النقاط"],["x = 3 \\Rightarrow y = 5 - 3 = 2","نقطة تقاطع المستقيمين"],["A \\cap B = \\{(3, 2)\\}",""],["P(A \\cap B) = \\frac{1}{16}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{16}\"></span>","o":""}],[{"n":"4","s":[["P(A \\cup B) = 1 - P(\\overline{A} \\cap \\overline{B}) = 1 - 0.3 = 0.7","قانون دي مورغان والمتممة"],["P(A \\cap B) = 0.5 + 0.6 - 0.7 = 0.4","من قانون الاتحاد"]],"a":"<span class=\"tx\" data-t=\"0.4\"></span>","o":""},{"n":"5","s":[["P(A \\cap \\overline{B}) = P(A) - P(A \\cap B) = 0.5 - 0.4 = 0.1",""]],"a":"<span class=\"tx\" data-t=\"0.1\"></span>","o":""},{"n":"6","s":[["B \\cup \\overline{A} = \\overline{A \\cap \\overline{B}}","قانون دي مورغان"],["P = 1 - 0.1 = 0.9","المتممة"]],"a":"<span class=\"tx\" data-t=\"0.9\"></span>","o":""}],[{"n":"7","s":[["P = \\frac{90}{516} = \\frac{15}{86} \\approx 0.1744","كهربائية وتفضّل العلوم"]],"a":"<span class=\"tx\" data-t=\"\\frac{15}{86} \\approx 0.1744\"></span>","o":""},{"n":"8","s":[["P = \\frac{89}{516} \\approx 0.1725","ميكانيكية وتفضّل الرياضيات"]],"a":"<span class=\"tx\" data-t=\"\\frac{89}{516} \\approx 0.1725\"></span>","o":""},{"n":"9","s":[["P = \\frac{170}{516} + \\frac{254}{516} - \\frac{89}{516}","قانون الاتحاد"],["= \\frac{335}{516} \\approx 0.6492",""]],"a":"<span class=\"tx\" data-t=\"\\frac{335}{516} \\approx 0.6492\"></span>","o":""},{"n":"10","s":[["90 + 81 = 171","تفضّل العلوم وليست كيميائية"],["P = \\frac{171}{516} = \\frac{57}{172} \\approx 0.3314",""]],"a":"<span class=\"tx\" data-t=\"\\frac{57}{172} \\approx 0.3314\"></span>","o":""}]]