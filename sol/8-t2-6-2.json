[[{"n":"1","s":[["2x+(4x+2)=8","بتعويض <span class=m dir=ltr>y</span> من الأولى في الثانية"],["6x=6\\Rightarrow x=1","بطرح <span class=m dir=ltr>2</span> ثم القسمة على <span class=m dir=ltr>6</span>"],["y=4(1)+2=6","بالتعويض في المعادلة الأولى"]],"a":"الحل: <span class=\"tx\" data-t=\"(1,6)\"></span>","o":"","k":[{"p":["1","6"]}]},{"n":"2","s":[["x+5=-2x-4","بتعويض <span class=m dir=ltr>y</span>"],["3x=-9\\Rightarrow x=-3",""],["y=-3+5=2","بالتعويض في المعادلة الأولى"]],"a":"الحل: <span class=\"tx\" data-t=\"(-3,2)\"></span>","o":"","k":[{"p":["-3","2"]}]},{"n":"3","s":[["5\\left(3-\\frac{1}{2}y\\right)-y=1","بتعويض <span class=m dir=ltr>x</span> في المعادلة الثانية"],["15-\\frac{7}{2}y=1\\Rightarrow \\frac{7}{2}y=14\\Rightarrow y=4","بالتبسيط"],["x=3-\\frac{1}{2}(4)=1","بالتعويض في المعادلة الأولى"]],"a":"الحل: <span class=\"tx\" data-t=\"(1,4)\"></span>","o":"","k":[{"p":["1","4"]}]},{"n":"4","s":[["\\frac{1}{2}x-(9-5x)=2","بتعويض <span class=m dir=ltr>y</span> في المعادلة الأولى"],["\\frac{11}{2}x=11\\Rightarrow x=2","بإضافة <span class=m dir=ltr>9</span> للطرفين ثم القسمة"],["y=9-5(2)=-1","بالتعويض"]],"a":"الحل: <span class=\"tx\" data-t=\"(2,-1)\"></span>","o":"","k":[{"p":["2","-1"]}]},{"n":"5","s":[["y=3x+6","بحل المعادلة الثانية بالنسبة إلى <span class=m dir=ltr>y</span>"],["x-4(3x+6)=20","بالتعويض في الأولى"],["-11x-24=20\\Rightarrow x=-4",""],["y=3(-4)+6=-6","بالتعويض"]],"a":"الحل: <span class=\"tx\" data-t=\"(-4,-6)\"></span>","o":"","k":[{"p":["-4","-6"]}]},{"n":"6","s":[["y=6x+3,\\ y=2x+3","بحل كل معادلة بالنسبة إلى <span class=m dir=ltr>y</span>"],["6x+3=2x+3\\Rightarrow x=0","بالتعويض"],["y=2(0)+3=3",""]],"a":"الحل: <span class=\"tx\" data-t=\"(0,3)\"></span>","o":"","k":[{"p":["0","3"]}]},{"n":"7","s":[["y=8x-16","من المعادلة الأولى"],["\\frac{1}{4}(8x-16)-2x=3","بالتعويض في الثانية"],["2x-4-2x=3\\Rightarrow -4=3","عبارة خاطئة"]],"a":"لا يوجد حل للنظام","o":""},{"n":"8","s":[["3y=2x-6\\Rightarrow y=\\frac{2}{3}x-2","من المعادلة الثانية"],["6x-9\\left(\\frac{2}{3}x-2\\right)=18","بالتعويض في الأولى"],["6x-6x+18=18\\Rightarrow 18=18","عبارة صحيحة دائمًا"]],"a":"عدد لانهائي من الحلول","o":""},{"n":"9","s":[["y=-3x-6","من المعادلة الأولى"],["(-3x-6)+6x+24=0","بالتعويض في الثانية"],["3x+18=0\\Rightarrow x=-6",""],["y=-3(-6)-6=12","بالتعويض"]],"a":"الحل: <span class=\"tx\" data-t=\"(-6,12)\"></span>","o":"","k":[{"p":["-6","12"]}]}],[{"n":"10","s":[["x+y=18","<span class=m dir=ltr>x</span> عدد الدجاج، <span class=m dir=ltr>y</span> عدد الأرانب (الرؤوس)"],["2x+4y=50","الأرجل"],["2(18-y)+4y=50\\Rightarrow 2y=14\\Rightarrow y=7","بتعويض <span class=\"tx\" data-t=\"x=18-y\"></span>"],["x=18-7=11",""]],"a":"<span class=m dir=ltr>11</span> دجاجة و <span class=m dir=ltr>7</span> أرانب","o":""}],[{"n":"11","s":[["5x+y=3.25","<span class=m dir=ltr>x</span> سعر <span class=m dir=ltr>1 kg</span> برتقال، <span class=m dir=ltr>y</span> سعر <span class=m dir=ltr>1 kg</span> تفاح (مراد)"],["3x+3y=3.75","فؤاد"],["3x+3(3.25-5x)=3.75","بتعويض <span class=\"tx\" data-t=\"y=3.25-5x\"></span>"],["-12x=-6\\Rightarrow x=0.5","بالتبسيط"],["y=3.25-5(0.5)=0.75","بالتعويض"]],"a":"سعر <span class=m dir=ltr>1 kg</span> من البرتقال <span class=m dir=ltr>JD 0.5</span> ، وسعر <span class=m dir=ltr>1 kg</span> من التفاح <span class=m dir=ltr>JD 0.75</span>","o":""},{"n":"12","s":[["2(0.75)+2(0.5)=1.5+1=2.5",""]],"a":"دفعت منال <span class=m dir=ltr>JD 2.5</span>","o":""}],[{"n":"13","s":[["y=57+1.1x","الموقع (أ): <span class=m dir=ltr>x</span> عدد الأعوام، <span class=m dir=ltr>y</span> عدد السياح بالآلاف"],["y=61+0.7x","الموقع (ب)"],["57+1.1x=61+0.7x\\Rightarrow 0.4x=4\\Rightarrow x=10","بالتعويض"],["y=57+1.1(10)=68",""]],"a":"بعد <span class=m dir=ltr>10</span> أعوام، ويبلغ عدد السياح في كل موقع <span class=m dir=ltr>68</span> ألف سائح","o":""}],[{"n":"14","s":[["2x+8+(x+1)=\\frac{1}{2}(8)(x+1)","المحيط <span class=m dir=ltr>=</span> المساحة"],["3x+9=4x+4\\Rightarrow x=5","بالتبسيط"],["8^2+6^2=100=10^2","التحقق بنظرية فيثاغورس: الأضلاع <span class=m dir=ltr>6, 8, 10</span>"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span> (المحيط <span class=\"tx\" data-t=\"=24\"></span> والمساحة <span class=\"tx\" data-t=\"=24\"></span>)","o":""}],[{"n":"15","s":[["-9a+b=-31","بتعويض <span class=\"tx\" data-t=\"x=-9,\\ y=1\"></span> في المعادلة الأولى"],["-9a-b=-41","في المعادلة الثانية"],["-18a=-72\\Rightarrow a=4","بجمع المعادلتين"],["-36+b=-31\\Rightarrow b=5","بالتعويض"],["4(-9)+5(1)=-31,\\quad 4(-9)-5(1)=-41","التحقق"]],"a":"<span class=\"tx\" data-t=\"a=4\"></span> ، <span class=\"tx\" data-t=\"b=5\"></span> ؛ لأن الحل يجب أن يحقق المعادلتين","o":""}],[{"n":"16","s":[["y=-3x+4","تمر بـ <span class=m dir=ltr>(3, −5)</span> و <span class=m dir=ltr>(−1, 7)</span>: الميل <span class=\"tx\" data-t=\"\\frac{-5-7}{3-(-1)}=-3\"></span>"],["y=x+8","تمر بـ <span class=m dir=ltr>(−1, 7)</span> ولا تمر بـ <span class=m dir=ltr>(3, −5)</span> لأن <span class=\"tx\" data-t=\"3+8=11\\ne -5\"></span>"],["-3x+4=x+8\\Rightarrow x=-1,\\ y=7","حل النظام بالتعويض"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"y=-3x+4\"></span> و <span class=\"tx\" data-t=\"y=x+8\"></span>","o":"","k":[{"e":"4 - 3*x","a":null},{"e":"x + 8","a":null}]}],[{"n":"17","s":[["x+y=240","<span class=m dir=ltr>x</span> عدد الذكور، <span class=m dir=ltr>y</span> عدد الإناث"],["\\frac{x}{y}=\\frac{7}{5}\\Rightarrow x=\\frac{7}{5}y","النسبة"],["\\frac{7}{5}y+y=240\\Rightarrow \\frac{12}{5}y=240\\Rightarrow y=100","بالتعويض"],["x=\\frac{7}{5}(100)=140",""]],"a":"<span class=m dir=ltr>140</span> ذكرًا و <span class=m dir=ltr>100</span> أنثى","o":""}],[{"n":"18","s":[["","أحل إحدى المعادلتين بالنسبة إلى أحد المتغيرين"],["","أعوّض العبارة الناتجة في المعادلة الأخرى، فأحصل على معادلة بمتغير واحد وأحلها"],["","أعوّض القيمة الناتجة لإيجاد المتغير الآخر، ثم أكتب الحل زوجًا مرتبًا وأتحقق"]],"a":"أعزل متغيرًا من معادلة، وأعوّضه في الأخرى، ثم أعوّض لإيجاد المتغير الثاني","o":""}],[{"n":"2","s":[["6x - (-4x) = 30","بتعويض <span class=\"tx\" data-t=\"y = -4x\"></span> في المعادلة الثانية"],["10x = 30 \\Rightarrow x = 3","بالتبسيط وقسمة الطرفين على <span class=m dir=ltr>10</span>"],["y = -4(3) = -12","بالتعويض في المعادلة الأولى"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"(3, -12)\"></span>","o":"","k":[{"p":["3","-12"]}]}],[{"n":"19","s":[["2x + (x + 3) = 12","بتعويض <span class=\"tx\" data-t=\"y = x + 3\"></span> في المعادلة الثانية"],["3x + 3 = 12 \\Rightarrow x = 3","بطرح <span class=m dir=ltr>3</span> من الطرفين ثم القسمة على <span class=m dir=ltr>3</span>"],["y = 3 + 3 = 6","بالتعويض في المعادلة الأولى"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 6)\"></span>","o":"","k":[{"p":["3","6"]}]},{"n":"20","s":[["y = 2 - 2x","بحل المعادلة الثانية بالنسبة إلى <span class=\"tx\" data-t=\"y\"></span>"],["x - 2(2 - 2x) = 6 \\Rightarrow 5x - 4 = 6","بالتعويض في المعادلة الأولى والتبسيط"],["x = 2","بإضافة <span class=m dir=ltr>4</span> ثم القسمة على <span class=m dir=ltr>5</span>"],["y = 2 - 2(2) = -2","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(2, -2)\"></span>","o":"","k":[{"p":["2","-2"]}]},{"n":"21","s":[["3(2y + 7) - 2y = 3","بتعويض <span class=\"tx\" data-t=\"x = 2y + 7\"></span> في المعادلة الثانية"],["4y + 21 = 3 \\Rightarrow 4y = -18","بالتبسيط وطرح <span class=m dir=ltr>21</span> من الطرفين"],["y = -4.5","بقسمة الطرفين على <span class=m dir=ltr>4</span>"],["x = 2(-4.5) + 7 = -2","بالتعويض في المعادلة الأولى"]],"a":"الحل <span class=\"tx\" data-t=\"(-2, -4.5)\"></span>","o":"","k":[{"p":["-2","-4.5"]}]},{"n":"22","s":[["4x - 2(0.5x - 1) = 14","بتعويض <span class=\"tx\" data-t=\"y = 0.5x - 1\"></span> في المعادلة الأولى"],["4x - x + 2 = 14 \\Rightarrow 3x = 12","بالتبسيط وطرح <span class=m dir=ltr>2</span>"],["x = 4","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["y = 0.5(4) - 1 = 1","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(4, 1)\"></span>","o":"","k":[{"p":["4","1"]}]}],[{"n":"27","s":[["2\\ell + 2w = 40","محيط المستطيل <span class=m dir=ltr>40 m</span>"],["\\ell = 2w - 1","الطول يقل <span class=m dir=ltr>1 m</span> عن مثلَي العرض"],["2(2w - 1) + 2w = 40 \\Rightarrow 6w - 2 = 40","بالتعويض في معادلة المحيط"],["6w = 42 \\Rightarrow w = 7","بإضافة <span class=m dir=ltr>2</span> ثم القسمة على <span class=m dir=ltr>6</span>"],["\\ell = 2(7) - 1 = 13","بالتعويض"],["2(13) + 2(7) = 40 \\checkmark","التحقق"]],"a":"الطول <span class=\"tx\" data-t=\"13\\ \\text{m}\"></span> والعرض <span class=\"tx\" data-t=\"7\\ \\text{m}\"></span>","o":"","k":[{"e":"13","a":null},{"e":"7","a":null}]}],[{"n":"28","s":[["4p + 1.5a = 27","<span class=\"tx\" data-t=\"p\"></span> كمية الفستق و <span class=\"tx\" data-t=\"a\"></span> كمية اللوز بالأوقية: القيمة الكلية"],["p = 3a","كمية الفستق ثلاثة أمثال كمية اللوز"],["4(3a) + 1.5a = 27 \\Rightarrow 13.5a = 27","بالتعويض في المعادلة الأولى"],["a = 2","بقسمة الطرفين على <span class=m dir=ltr>13.5</span>"],["p = 3(2) = 6","بالتعويض"],["4(6) + 1.5(2) = 24 + 3 = 27 \\checkmark","التحقق"]],"a":"اللوز <span class=\"tx\" data-t=\"2\"></span> أوقية والفستق <span class=\"tx\" data-t=\"6\"></span> أوقيات","o":"","k":[{"e":"2","a":null},{"e":"6","a":null}]}],[{"n":"29","s":[["x + y = 10","<span class=\"tx\" data-t=\"x\"></span> أهداف الذهاب و <span class=\"tx\" data-t=\"y\"></span> أهداف الإياب"],["2x = 3y \\Rightarrow x = 1.5y","مثلا الذهاب يساوي ثلاثة أمثال الإياب، بالقسمة على <span class=m dir=ltr>2</span>"],["1.5y + y = 10 \\Rightarrow 2.5y = 10","بالتعويض في المعادلة الأولى"],["y = 4","بقسمة الطرفين على <span class=m dir=ltr>2.5</span>"],["x = 10 - 4 = 6","بالتعويض"],["2(6) = 3(4) = 12 \\checkmark","التحقق"]],"a":"سجّل <span class=\"tx\" data-t=\"6\"></span> أهداف في الذهاب و <span class=\"tx\" data-t=\"4\"></span> أهداف في الإياب","o":""}],[{"n":"1","s":[["x - 2 = -2x + 1 \\Rightarrow 3x = 3","بالتعويض"],["x = 1,\\ y = -1","نقطة التقاطع <span class=\"tx\" data-t=\"(1, -1)\"></span>"]],"a":"التمثيل <span class=m dir=ltr>b</span>","o":"في <span class=m dir=ltr>b</span> مستقيم ميله موجب يقطع المحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"-2\"></span> وآخر ميله سالب يقطعه عند <span class=m dir=ltr>1</span>، ويتقاطعان في <span class=\"tx\" data-t=\"(1, -1)\"></span>"},{"n":"2","s":[["x - 3 = -\\frac{1}{3}x + 1 \\Rightarrow \\frac{4}{3}x = 4","بالتعويض"],["x = 3,\\ y = 0","نقطة التقاطع <span class=\"tx\" data-t=\"(3, 0)\"></span>"]],"a":"التمثيل <span class=m dir=ltr>c</span>","o":"في <span class=m dir=ltr>c</span> يقطع المستقيمان المحور <span class=\"tx\" data-t=\"y\"></span> عند <span class=\"tx\" data-t=\"-3\"></span> و <span class=m dir=ltr>1</span> ويتقاطعان في <span class=\"tx\" data-t=\"(3, 0)\"></span>"},{"n":"3","s":[["\\frac{1}{2}x - 2 = 4x + 5 \\Rightarrow -3.5x = 7","بالتعويض"],["x = -2,\\ y = -3","نقطة التقاطع <span class=\"tx\" data-t=\"(-2, -3)\"></span>"]],"a":"التمثيل <span class=m dir=ltr>a</span>","o":"في <span class=m dir=ltr>a</span> مستقيم شديد الانحدار (ميله <span class=m dir=ltr>4)</span> يتقاطع مع الآخر في <span class=\"tx\" data-t=\"(-2, -3)\"></span>"}],[{"n":"4","s":[["x + (x + 1) = 7 \\Rightarrow 2x = 6","بتعويض <span class=\"tx\" data-t=\"y = x + 1\"></span>"],["x = 3,\\ y = 4","بالقسمة على <span class=m dir=ltr>2</span> ثم التعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(3, 4)\"></span>","o":"","k":[{"p":["3","4"]}]},{"n":"5","s":[["2x + 3(x + 5) = 15 \\Rightarrow 5x + 15 = 15","بتعويض <span class=\"tx\" data-t=\"y = x + 5\"></span>"],["x = 0,\\ y = 5","بطرح <span class=m dir=ltr>15</span> ثم القسمة على <span class=m dir=ltr>5</span>، ثم التعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(0, 5)\"></span>","o":"","k":[{"p":["0","5"]}]},{"n":"6","s":[["(3 - y) - y = -1 \\Rightarrow 3 - 2y = -1","بتعويض <span class=\"tx\" data-t=\"x = 3 - y\"></span>"],["-2y = -4 \\Rightarrow y = 2","بطرح <span class=m dir=ltr>3</span> ثم القسمة على <span class=m dir=ltr>−2</span>"],["x = 3 - 2 = 1","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(1, 2)\"></span>","o":"","k":[{"p":["1","2"]}]},{"n":"7","s":[["\\frac{1}{4}x - 2(17 - 2x) = 0","بتعويض <span class=\"tx\" data-t=\"y = 17 - 2x\"></span>"],["\\frac{17}{4}x - 34 = 0 \\Rightarrow x = 8","بالتبسيط ثم الضرب في <span class=\"tx\" data-t=\"\\frac{4}{17}\"></span>"],["y = 17 - 2(8) = 1","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(8, 1)\"></span>","o":"","k":[{"p":["8","1"]}]},{"n":"8","s":[["y = 3x - 5","من المعادلة الثانية بإضافة <span class=\"tx\" data-t=\"3x\"></span>"],["3x - 4(3x - 5) = 2 \\Rightarrow -9x + 20 = 2","بالتعويض في الأولى"],["x = 2","بطرح <span class=m dir=ltr>20</span> ثم القسمة على <span class=m dir=ltr>−9</span>"],["y = 3(2) - 5 = 1","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(2, 1)\"></span>","o":"","k":[{"p":["2","1"]}]},{"n":"9","s":[["y = x + 3","من المعادلة الأولى"],["(x + 3) - 2x = 1 \\Rightarrow -x = -2","بالتعويض في الثانية"],["x = 2,\\ y = 5","بالقسمة على <span class=m dir=ltr>−1</span> ثم التعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(2, 5)\"></span>","o":"","k":[{"p":["2","5"]}]},{"n":"10","s":[["y = 2x - 14","من المعادلة الأولى"],["\\frac{1}{2}(2x - 14) + x = 9 \\Rightarrow 2x - 7 = 9","بالتعويض في الثانية"],["x = 8","بإضافة <span class=m dir=ltr>7</span> ثم القسمة على <span class=m dir=ltr>2</span>"],["y = 2(8) - 14 = 2","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(8, 2)\"></span>","o":"","k":[{"p":["8","2"]}]},{"n":"11","s":[["2y = 2x - 8 \\Rightarrow y = x - 4","من المعادلة الثانية بإضافة <span class=\"tx\" data-t=\"2x\"></span> ثم القسمة على <span class=m dir=ltr>2</span>"],["5x - 3(x - 4) = 18 \\Rightarrow 2x + 12 = 18","بالتعويض في الأولى"],["x = 3","بطرح <span class=m dir=ltr>12</span> ثم القسمة على <span class=m dir=ltr>2</span>"],["y = 3 - 4 = -1","بالتعويض"]],"a":"الحل <span class=\"tx\" data-t=\"(3, -1)\"></span>","o":"","k":[{"p":["3","-1"]}]},{"n":"12","s":[["y = -3x - 5","من المعادلة الأولى"],["(-3x - 5) + 6x = -11 \\Rightarrow 3x = -6","بالتعويض في الثانية وإضافة <span class=m dir=ltr>5</span>"],["x = -2","بالقسمة على <span class=m dir=ltr>3</span>"],["y = -3(-2) - 5 = 1","بالتعويض"]],"a":"الحل 