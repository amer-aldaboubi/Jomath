[[{"n":"الخوارزمية","s":[["12 = 3 \\times 4","العددان <span class=m dir=ltr>3</span> و <span class=m dir=ltr>4</span> أوليان فيما بينهما"],["\\text{sum of digits} \\div 3","الخطوتان <span class=m dir=ltr>1</span> و <span class=m dir=ltr>2</span>: اختبار قابلية القسمة على <span class=m dir=ltr>3</span>"],["\\text{last two digits} \\div 4","الخطوة <span class=m dir=ltr>3</span>: اختبار قابلية القسمة على <span class=m dir=ltr>4</span>"]],"a":"يقبل العدد القسمة على <span class=m dir=ltr>12</span> إذا قبل القسمة على <span class=m dir=ltr>3</span> وعلى <span class=m dir=ltr>4</span> معًا؛ تُطبَّق الخوارزمية في الأسئلة <span class=m dir=ltr>1</span>–<span class=m dir=ltr>4 (</span>انظر الجزء التالي).","o":"هذا الجزء يعرض خطوات الخوارزمية فقط، وحلول الأسئلة <span class=m dir=ltr>1</span>–<span class=m dir=ltr>4</span> في المقطع التالي."}],[{"n":"1","s":[["7 + 1 + 0 + 4 = 12","الخطوة <span class=m dir=ltr>1</span>: أجمع أرقام العدد"],["12 \\div 3 = 4","الخطوة <span class=m dir=ltr>2</span>: المجموع يقبل القسمة على <span class=m dir=ltr>3</span>، أنتقل إلى الخطوة <span class=m dir=ltr>3</span>"],["04 = 4,\\quad 4 \\div 4 = 1","الخطوة <span class=m dir=ltr>3</span>: العدد المكوّن من آحاده وعشراته يقبل القسمة على <span class=m dir=ltr>4</span>"]],"a":"العدد <span class=\"tx\" data-t=\"7104\"></span> يقبل القسمة على <span class=m dir=ltr>12 (</span>للتحقق: <span class=\"tx\" data-t=\"7104 \\div 12 = 592\"></span>)","o":""},{"n":"2","s":[["3 + 2 + 4 + 8 + 9 + 4 + 0 = 30","الخطوة <span class=m dir=ltr>1</span>: أجمع أرقام العدد"],["30 \\div 3 = 10","الخطوة <span class=m dir=ltr>2</span>: المجموع يقبل القسمة على <span class=m dir=ltr>3</span>"],["40 \\div 4 = 10","الخطوة <span class=m dir=ltr>3</span>: العدد <span class=m dir=ltr>40</span> يقبل القسمة على <span class=m dir=ltr>4</span>"]],"a":"العدد <span class=\"tx\" data-t=\"3248940\"></span> يقبل القسمة على <span class=m dir=ltr>12 (</span>للتحقق: <span class=\"tx\" data-t=\"3248940 \\div 12 = 270745\"></span>)","o":""},{"n":"3","s":[["5 + 7 + 6 + 2 = 20","الخطوة <span class=m dir=ltr>1</span>: أجمع أرقام العدد"],["20 \\div 3 = 6.\\overline{6}","الخطوة <span class=m dir=ltr>2</span>: المجموع لا يقبل القسمة على <span class=m dir=ltr>3</span>، فأتوقف"]],"a":"العدد <span class=\"tx\" data-t=\"5762\"></span> لا يقبل القسمة على <span class=m dir=ltr>12</span>","o":""},{"n":"4","s":[["8 + 1 + 4 + 5 + 6 = 24","الخطوة <span class=m dir=ltr>1</span>: أجمع أرقام العدد"],["24 \\div 3 = 8","الخطوة <span class=m dir=ltr>2</span>: المجموع يقبل القسمة على <span class=m dir=ltr>3</span>"],["56 \\div 4 = 14","الخطوة <span class=m dir=ltr>3</span>: العدد <span class=m dir=ltr>56</span> يقبل القسمة على <span class=m dir=ltr>4</span>"]],"a":"العدد <span class=\"tx\" data-t=\"81456\"></span> يقبل القسمة على <span class=m dir=ltr>12 (</span>للتحقق: <span class=\"tx\" data-t=\"81456 \\div 12 = 6788\"></span>)","o":""}],[{"n":"5","s":[["1^2 + 9^2 = 1 + 81 = 82","مجموع مربعات أرقام <span class=m dir=ltr>19</span>"],["8^2 + 2^2 = 64 + 4 = 68","أكرر الخطوتين على الناتج <span class=m dir=ltr>82</span>"],["6^2 + 8^2 = 36 + 64 = 100","أكرر على <span class=m dir=ltr>68</span>"],["1^2 + 0^2 + 0^2 = 1","حصلت على مجموع من منزلة واحدة يساوي <span class=m dir=ltr>1</span>"]],"a":"العدد <span class=\"tx\" data-t=\"19\"></span> عدد سعيد","o":""},{"n":"6","s":[["4^2 + 2^2 = 16 + 4 = 20","مجموع مربعات أرقام <span class=m dir=ltr>42</span>"],["2^2 + 0^2 = 4","حصلت على مجموع من منزلة واحدة يساوي <span class=m dir=ltr>4</span>"]],"a":"العدد <span class=\"tx\" data-t=\"42\"></span> غير سعيد","o":""},{"n":"7","s":[["4^2 + 9^2 = 16 + 81 = 97","مجموع مربعات أرقام <span class=m dir=ltr>49</span>"],["9^2 + 7^2 = 81 + 49 = 130","أكرر على <span class=m dir=ltr>97</span>"],["1^2 + 3^2 + 0^2 = 10","أكرر على <span class=m dir=ltr>130</span>"],["1^2 + 0^2 = 1","مجموع من منزلة واحدة يساوي <span class=m dir=ltr>1</span>"]],"a":"العدد <span class=\"tx\" data-t=\"49\"></span> عدد سعيد","o":""},{"n":"8","s":[["2^2 + 5^2 = 4 + 25 = 29","مجموع مربعات أرقام <span class=m dir=ltr>25</span>"],["2^2 + 9^2 = 85,\\quad 8^2 + 5^2 = 89","أكرر الخطوتين"],["8^2 + 9^2 = 145,\\quad 1 + 16 + 25 = 42","أكرر الخطوتين"],["4^2 + 2^2 = 20,\\quad 2^2 + 0^2 = 4","مجموع من منزلة واحدة يساوي <span class=m dir=ltr>4</span>"]],"a":"العدد <span class=\"tx\" data-t=\"25\"></span> غير سعيد","o":""}],[{"n":"9","s":[["n = 0,\\ x = 0,\\ y = 1","الخطوة <span class=m dir=ltr>1</span>: القيم الابتدائية"],["x = 1,\\ y = 1 \\times 1 = 1 \\Rightarrow \\text{Print } 1,\\ n = 1","الخطوات <span class=m dir=ltr>2</span>–<span class=m dir=ltr>4</span>، ثم <span class=\"tx\" data-t=\"1 &lt; 4\"></span> فأعود إلى الخطوة <span class=m dir=ltr>2</span>"],["x = 2,\\ y = 1 \\times 2 = 2 \\Rightarrow \\text{Print } 2,\\ n = 2","<span class=\"tx\" data-t=\"2 &lt; 4\"></span> فأعود إلى الخطوة <span class=m dir=ltr>2</span>"],["x = 3,\\ y = 2 \\times 3 = 6 \\Rightarrow \\text{Print } 6,\\ n = 3","<span class=\"tx\" data-t=\"3 &lt; 4\"></span> فأعود إلى الخطوة <span class=m dir=ltr>2</span>"],["x = 4,\\ y = 6 \\times 4 = 24 \\Rightarrow \\text{Print } 24,\\ n = 4","<span class=\"tx\" data-t=\"n = 4\"></span> فأتوقف"]],"a":"مخرجات الخوارزمية: <span class=\"tx\" data-t=\"1,\\ 2,\\ 6,\\ 24\"></span>","o":"جدول التتبع أعمدته: الخطوة، <span class=\"tx\" data-t=\"n\"></span>، <span class=\"tx\" data-t=\"x\"></span>، <span class=\"tx\" data-t=\"y\"></span>، المخرج."},{"n":"10","s":[["1 = 1!,\\ 2 = 2!,\\ 6 = 3!,\\ 24 = 4!","كل مخرج هو حاصل ضرب الأعداد من <span class=m dir=ltr>1</span> إلى <span class=\"tx\" data-t=\"x\"></span>"]],"a":"المخرجات هي مضروب الأعداد من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>4</span>، أي: <span class=\"tx\" data-t=\"1!,\\ 2!,\\ 3!,\\ 4!\"></span>","o":""}],[{"n":"11","s":[["G = \\frac{M1 + M2 + M3 + M4}{4}","تحسب الخوارزمية الوسط الحسابي لأربع علامات"],["G < 50\\ ?","ثم تقارن المعدل بالعدد <span class=m dir=ltr>50</span>: إن كان أقل تطبع «راسب»، وإلا تطبع «ناجح»"]],"a":"تحسب الخوارزمية معدل أربع علامات لطالب، ثم تطبع «راسب» إذا كان المعدل أقل من <span class=m dir=ltr>50</span>، و«ناجح» إذا كان <span class=m dir=ltr>50</span> فأكثر.","o":""},{"n":"12a","s":[["G = \\frac{48 + 52 + 46 + 49}{4} = \\frac{195}{4} = 48.75","بالتعويض في صيغة <span class=\"tx\" data-t=\"G\"></span>"],["48.75 < 50","الإجابة عن سؤال الشرط: <span class=m dir=ltr>Yes</span>"]],"a":"المخرج: «راسب»","o":""},{"n":"12b","s":[["G = \\frac{71 + 85 + 62 + 45}{4} = \\frac{263}{4} = 65.75","بالتعويض في صيغة <span class=\"tx\" data-t=\"G\"></span>"],["65.75 \\not< 50","الإجابة عن سؤال الشرط: <span class=m dir=ltr>No</span>"]],"a":"المخرج: «ناجح»","o":""}],[{"n":"13","s":[["p = k^2,\\quad k = 1, 2, 3, \\dots","تحسب الخوارزمية مربعات الأعداد بالترتيب"],["p = n\\ ?\\qquad p > n\\ ?","وتقارن كل مربع بالعدد <span class=\"tx\" data-t=\"n\"></span>: إن ساواه فهو «مربع كامل»، وإن تجاوزه قبل أن يساويه فهو «ليس مربعًا كاملًا»"]],"a":"تحدد الخوارزمية إذا كان العدد المُدخَل <span class=\"tx\" data-t=\"n\"></span> مربعًا كاملًا أم لا.","o":""},{"n":"14a","s":[["n = 24,\\ k = 1,\\ p = 1","<span class=\"tx\" data-t=\"p &gt; n\"></span>؟ لا، <span class=\"tx\" data-t=\"p = n\"></span>؟ لا"],["k = 2,\\ p = 4;\\quad k = 3,\\ p = 9;\\quad k = 4,\\ p = 16","في كل مرة: <span class=\"tx\" data-t=\"p &lt; 24\"></span> فأزيد <span class=\"tx\" data-t=\"k\"></span>"],["k = 5,\\ p = 25 > 24","<span class=\"tx\" data-t=\"p &gt; n\"></span>؟ نعم"]],"a":"المخرج: «<span class=m dir=ltr>24</span> ليس مربعًا كاملًا»","o":""},{"n":"14b","s":[["n = 16,\\ k = 1,\\ p = 1;\\ k = 2,\\ p = 4;\\ k = 3,\\ p = 9","في كل مرة: <span class=\"tx\" data-t=\"p &lt; 16\"></span> فأزيد <span class=\"tx\" data-t=\"k\"></span>"],["k = 4,\\ p = 16","<span class=\"tx\" data-t=\"p &gt; n\"></span>؟ لا، <span class=\"tx\" data-t=\"p = n\"></span>؟ نعم"]],"a":"المخرج: «<span class=m dir=ltr>16</span> مربع كامل»","o":""}],[{"n":"15","s":[["c = 0,\\ R = 1 \\Rightarrow \\text{Print } 1","القيم الابتدائية ثم الطباعة"],["c = 1,\\ R = 2 \\Rightarrow \\text{Print } 2","<span class=\"tx\" data-t=\"c &gt; 5\"></span>؟ لا، أعود للطباعة"],["c = 2,\\ R = 4;\\ c = 3,\\ R = 8;\\ c = 4,\\ R = 16","أطبع <span class=m dir=ltr>4</span> ثم <span class=m dir=ltr>8</span> ثم <span class=m dir=ltr>16</span>"],["c = 5,\\ R = 32 \\Rightarrow \\text{Print } 32","<span class=\"tx\" data-t=\"5 &gt; 5\"></span>؟ لا"],["c = 6,\\ R = 64","<span class=\"tx\" data-t=\"6 &gt; 5\"></span>؟ نعم، أتوقف (لا تُطبع <span class=m dir=ltr>64)</span>"]],"a":"مخرجات الخوارزمية: <span class=\"tx\" data-t=\"1,\\ 2,\\ 4,\\ 8,\\ 16,\\ 32\"></span>","o":""},{"n":"16","s":[["1 = 2^0,\\ 2 = 2^1,\\ \\dots,\\ 32 = 2^5","كل مخرج ضعف السابق"]],"a":"المخرجات هي قوى العدد <span class=m dir=ltr>2</span> من <span class=\"tx\" data-t=\"2^0\"></span> إلى <span class=\"tx\" data-t=\"2^5\"></span>","o":""}],[{"n":"17","s":[["n = 1,\\ A = 0 \\to A = 1 \\Rightarrow \\text{Print } 1","<span class=\"tx\" data-t=\"1 &gt; 16\"></span>؟ لا، <span class=\"tx\" data-t=\"n = 3\"></span>"],["A = 1 + 3 = 4 \\Rightarrow \\text{Print } 4","<span class=\"tx\" data-t=\"4 &gt; 16\"></span>؟ لا، <span class=\"tx\" data-t=\"n = 5\"></span>"],["A = 4 + 5 = 9 \\Rightarrow \\text{Print } 9","<span class=\"tx\" data-t=\"9 &gt; 16\"></span>؟ لا، <span class=\"tx\" data-t=\"n = 7\"></span>"],["A = 9 + 7 = 16 \\Rightarrow \\text{Print } 16","<span class=\"tx\" data-t=\"16 &gt; 16\"></span>؟ لا، <span class=\"tx\" data-t=\"n = 9\"></span>"],["A = 16 + 9 = 25 \\Rightarrow \\text{Print } 25","<span class=\"tx\" data-t=\"25 &gt; 16\"></span>؟ نعم، أتوقف"]],"a":"مخرجات الخوارزمية: <span class=\"tx\" data-t=\"1,\\ 4,\\ 9,\\ 16,\\ 25\"></span>","o":""},{"n":"18","s":[["1 = 1^2,\\ 4 = 2^2,\\ 9 = 3^2,\\ 16 = 4^2,\\ 25 = 5^2","المخرجات مربعات كاملة"],["1 + 3 + 5 + \\dots + (2k - 1) = k^2","لأن <span class=\"tx\" data-t=\"A\"></span> يجمع الأعداد الفردية المتتالية"]],"a":"المخرجات هي مربعات الأعداد من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>5</span>؛ لأن الخوارزمية تجمع الأعداد الفردية المتتالية (<span class=\"tx\" data-t=\"n = 1, 3, 5, \\dots\"></span>) ومجموع أول <span class=\"tx\" data-t=\"k\"></span> عددًا فرديًّا يساوي <span class=\"tx\" data-t=\"k^2\"></span>.","o":""}],[{"n":"19","s":[["A = 27,\\ B = 4","المدخلات"],["27 < 4? \\text{ No} \\Rightarrow A = 27 - 4 = 23","أطرح <span class=\"tx\" data-t=\"B\"></span> من <span class=\"tx\" data-t=\"A\"></span>"],["A = 23 \\to 19 \\to 15 \\to 11 \\to 7 \\to 3","أكرر الطرح ما دام <span class=\"tx\" data-t=\"A \\ge B\"></span>"],["3 < 4? \\text{ Yes} \\Rightarrow \\text{Print } 3","أطبع <span class=\"tx\" data-t=\"A\"></span> وأتوقف"]],"a":"المخرج: <span class=\"tx\" data-t=\"3\"></span>","o":""},{"n":"20","s":[["27 = 6 \\times 4 + 3","طُرح العدد <span class=m dir=ltr>4</span> ست مرات وبقي <span class=m dir=ltr>3</span>"]],"a":"تجد الخوارزمية باقي قسمة <span class=\"tx\" data-t=\"A\"></span> على <span class=\"tx\" data-t=\"B\"></span> (عندما <span class=\"tx\" data-t=\"A, B\"></span> عددان كليان موجبان).","o":""}],[{"n":"1","s":[["c=1,2,3,4,5 \\Rightarrow \\text{Print } a","عند كل قيمة من قيم <span class=\"tx\" data-t=\"c\"></span> التي تحقق <span class=\"tx\" data-t=\"c\\le 5\"></span> يُطبع العدد <span class=\"tx\" data-t=\"a\"></span> نفسه"],["c=6 \\Rightarrow 6\\le 5\\ \\text{No} \\Rightarrow \\text{Stop}","تتوقف الخوارزمية عندما تصبح <span class=\"tx\" data-t=\"c=6\"></span>"]],"a":"<span class=m dir=ltr>(b)</span>: العدد <span class=\"tx\" data-t=\"a\"></span> مكرّرًا <span class=m dir=ltr>5</span> مرّات","o":""}],[{"n":"9","s":[["n=1,\\ S=1;\\quad n=2,\\ S=9;\\quad n=3,\\ S=36","جدول التتبّع: <span class=\"tx\" data-t=\"S=S+n^3\"></span> عند كل قيمة من قيم <span class=\"tx\" data-t=\"n\"></span>"],["n=4,\\ S=100;\\quad n=5,\\ S=225;\\quad n=6,\\ S=441",""],["n=7,\\ S=784;\\quad n=8,\\ S=1296","عندما <span class=\"tx\" data-t=\"n=8\"></span> يكون الجواب <span class=m dir=ltr>Yes</span>"],["\\text{Print } S=1296","المُخرَج"]],"a":"المُخرَج: <span class=\"tx\" data-t=\"1296\"></span>","o":""},{"n":"10","s":[["S=1^3+2^3+3^3+\\cdots+