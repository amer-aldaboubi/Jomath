*((-x^5 + 2*x)^2)^(1/3)) - 8","a":null}]},{"n":"10","s":[["f'(x)=4(\\sqrt x+5)^3\\times\\frac{1}{2\\sqrt x}","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{2(\\sqrt x+5)^3}{\\sqrt x}\"></span>","o":"","k":[{"e":"2*(sqrt(x) + 5)^3/sqrt(x)","a":null}]},{"n":"11","s":[["f(x)=(2x-5)^{\\frac32}",""],["f'(x)=\\frac32(2x-5)^{\\frac12}\\times2","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3\\sqrt{2x-5}\"></span>","o":"","k":[{"e":"3*sqrt(2*x - 5)","a":null}]},{"n":"12","s":[["f'(x)=5(2x^3-3x^2+4x+1)^4(6x^2-6x+4)","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=5(6x^2-6x+4)(2x^3-3x^2+4x+1)^4\"></span>","o":"","k":[{"e":"(30*x^2 - 30*x + 20)*(2*x^3 - 3*x^2 + 4*x + 1)^4","a":null}]}],[{"n":"13","s":[["f(x)=(4x+1)^{-2}",""],["f'(x)=-2(4x+1)^{-3}\\times4=-\\frac{8}{(4x+1)^3}","قاعدة السلسلة"],["f'\\left(\\tfrac14\\right)=-\\frac{8}{2^3}=-1",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;\\left(\\frac14\\right)=-1\"></span>","o":""},{"n":"14","s":[["f'(x)=\\frac12(25-x^2)^{-\\frac12}(-2x)=\\frac{-x}{\\sqrt{25-x^2}}","قاعدة السلسلة"],["f'(3)=\\frac{-3}{\\sqrt{16}}=-\\frac34",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(3)=-\\frac34\"></span>","o":""}],[{"n":"15","s":[["\\frac{dy}{du}=10u+3,\\quad\\frac{du}{dx}=3x^2",""],["\\frac{dy}{dx}=\\frac{dy}{du}\\times\\frac{du}{dx}=(10u+3)(3x^2)","قاعدة السلسلة"],["=(10x^3+13)(3x^2)=30x^5+39x^2","بالتعويض <span class=m dir=ltr>u = x³ + 1</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=30x^5+39x^2\"></span>","o":"","k":[{"e":"30*x^5 + 39*x^2","a":null}]},{"n":"16","s":[["\\frac{dy}{du}=\\frac23(2u+5)^{-\\frac23},\\quad\\frac{du}{dx}=2x-1",""],["\\frac{dy}{dx}=\\frac{2(2x-1)}{3\\sqrt[3]{(2u+5)^2}}","قاعدة السلسلة"],["=\\frac{2(2x-1)}{3\\sqrt[3]{(2x^2-2x+5)^2}}","بالتعويض عن <span class=m dir=ltr>u</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{2(2x-1)}{3\\sqrt[3]{(2x^2-2x+5)^2}}\"></span>","o":"","k":[{"e":"(4*x - 2)/(3*((2*x^2 - 2*x + 5)^2)^(1/3))","a":null}]}],[{"n":"17","s":[["x=2\\Rightarrow u=3",""],["\\frac{dy}{du}=6u-5=13,\\quad\\frac{du}{dx}=2x=4",""],["\\frac{dy}{dx}=13\\times4=52","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"52\"></span>","o":"","k":[{"e":"52","a":null}]},{"n":"18","s":[["x=1\\Rightarrow u=1",""],["\\frac{dy}{du}=3(1+u^2)^2(2u)=3(4)(2)=24,\\quad\\frac{du}{dx}=2",""],["\\frac{dy}{dx}=24\\times2=48","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"48\"></span>","o":"","k":[{"e":"48","a":null}]}],[{"n":"19","s":[["C(x)=1000(x^2-0.1x)^{\\frac12}",""],["C'(x)=1000\\times\\frac12(x^2-0.1x)^{-\\frac12}(2x-0.1)","قاعدة السلسلة"],["C'(x)=\\frac{500(2x-0.1)}{\\sqrt{x^2-0.1x}}",""]],"a":"<span class=\"tx\" data-t=\"C&#x27;(x)=\\frac{500(2x-0.1)}{\\sqrt{x^2-0.1x}}\"></span>","o":"","k":[{"e":"(1000*x - 50.0)/sqrt(x^2 - 0.1*x)","a":true}]},{"n":"20","s":[["C'(20)=\\frac{500(39.9)}{\\sqrt{400-2}}=\\frac{19950}{\\sqrt{398}}","بالتعويض"],["\\approx1000",""]],"a":"<span class=\"tx\" data-t=\"C&#x27;(20)\\approx1000\"></span> ألف دينار لكل قطعة","o":"أي تزداد التكلفة بنحو مليون دينار تقريبًا لكل قطعة إضافية عند إنتاج <span class=m dir=ltr>20</span> قطعة","k":[{"e":"1000","a":true}]}],[{"n":"21","s":[["N(t)=400-1200(t^2+2)^{-2}",""],["N'(t)=2400(t^2+2)^{-3}(2t)=\\frac{4800t}{(t^2+2)^3}","قاعدة السلسلة"],["N'(1)=\\frac{4800}{27}=\\frac{1600}{9}\\approx177.78",""]],"a":"<span class=\"tx\" data-t=\"N&#x27;(1)=\\frac{1600}{9}\\approx177.78\"></span> خلية/يوم","o":"","k":[{"e":"177.78","a":true}]},{"n":"22","s":[["N'(4)=\\frac{4800(4)}{18^3}=\\frac{19200}{5832}=\\frac{800}{243}\\approx3.29",""]],"a":"<span class=\"tx\" data-t=\"N&#x27;(4)=\\frac{800}{243}\\approx3.29\"></span> خلية/يوم","o":"","k":[{"e":"3.29","a":true}]}],[{"n":"23","s":[["f'(x)=g'(h(x))\\cdot h'(x)","قاعدة السلسلة"],["f'(3)=g'(h(3))\\cdot h'(3)=g'(2)(-2)",""],["=6(-2)=-12",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(3)=-12\"></span>","o":""},{"n":"24","s":[["f'(x)=3(h(x))^2\\cdot h'(x)","قاعدة السلسلة"],["f'(3)=3(2)^2(-2)=-24",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(3)=-24\"></span>","o":""}],[{"n":"25","s":[["y=(2x+5)^{\\frac12}",""],["\\frac{dy}{dx}=\\frac12(2x+5)^{-\\frac12}\\times2=\\frac{1}{\\sqrt{2x+5}}","قاعدة السلسلة"],["=\\frac1y","لأن <span class=m dir=ltr>y = √(2x+5)</span>"]],"a":"تم الإثبات: <span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac1y\"></span>","o":""},{"n":"26","s":[["m=\\frac1y=\\frac13","الميل عند <span class=m dir=ltr>(2, 3)</span>"],["y-3=\\frac13(x-2)","معادلة المماس"],["0-3=\\frac13(x-2)\\Rightarrow x=-7","بتعويض <span class=m dir=ltr>y = 0</span>"]],"a":"النقطة <span class=\"tx\" data-t=\"(-7,0)\"></span>","o":"","k":[{"p":["-7","0"]}]}],[{"n":"27","s":[["y=600(x^2+50)^{-1}",""],["\\frac{dy}{dx}=-600(x^2+50)^{-2}(2x)=\\frac{-1200x}{(x^2+50)^2}","قاعدة السلسلة"],["x=1:\\ \\frac{-1200}{51^2}=-\\frac{400}{867}\\approx-0.4614",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{400}{867}\\approx-0.4614\"></span>","o":"","k":[{"e":"-0.4614","a":true}]},{"n":"28","s":[["m=\\frac{-1200(10)}{150^2}=-\\frac{8}{15}","الميل عند <span class=m dir=ltr>x = 10</span>"],["y-4=-\\frac{8}{15}(x-10)",""],["y=-\\frac{8}{15}x+\\frac{28}{3}",""]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{8}{15}x+\\frac{28}{3}\"></span>","o":"","k":[{"e":"28/3 - 8*x/15","a":null}]}],[{"n":"29","s":[["h'(x) = f'(g(x))\\times g'(x)","قاعدة السلسلة"],["f'(u) = 2u","مشتقة الاقتران الخارجي"],["h'(2) = f'(g(2))\\times g'(2) = f'(3)\\times(-1)","بالتعويض <span class=\"tx\" data-t=\"g(2)=3,\\ g&#x27;(2)=-1\"></span>"],["h'(2) = (2\\times 3)\\times(-1) = -6","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"h&#x27;(2) = -6\"></span>؛ لأنّ <span class=\"tx\" data-t=\"h\"></span> اقتران مركّب، فمشتقته حسب قاعدة السلسلة هي مشتقة الاقتران الخارجي عند <span class=\"tx\" data-t=\"g(2)\"></span> مضروبة في <span class=\"tx\" data-t=\"g&#x27;(2)\"></span>","o":""}],[{"n":"30","s":[["\\frac{dy}{dx} = 5(x^2-4)^4\\times 2x = 10x(x^2-4)^4","قاعدة القوة العامة (قاعدة السلسلة)"],["(x^2-4)^5 = 0 \\Rightarrow x^2-4=0 \\Rightarrow x = \\pm 2","قيم <span class=\"tx\" data-t=\"x\"></span> التي يكون عندها <span class=\"tx\" data-t=\"y=0\"></span>"],["\\frac{dy}{dx}\\Big|_{x=2} = 10(2)(0)^4 = 0","بالتعويض <span class=\"tx\" data-t=\"x=2\"></span>"],["\\frac{dy}{dx}\\Big|_{x=-2} = 10(-2)(0)^4 = 0","بالتعويض <span class=\"tx\" data-t=\"x=-2\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx} = 0\"></span> عندما <span class=\"tx\" data-t=\"y = 0\"></span>؛ لأنّ <span class=\"tx\" data-t=\"y=0\"></span> يعني <span class=\"tx\" data-t=\"x^2-4=0\"></span>، والمشتقة تحتوي العامل <span class=\"tx\" data-t=\"(x^2-4)^4\"></span> فتساوي صفرًا","o":""}],[{"n":"31","s":[["f(x) = (x^2+1)^{\\frac{1}{2}}","اقتران مركّب: الداخلي <span class=\"tx\" data-t=\"x^2+1\"></span>"],["h(x) = (x^2+1)^{3}","اقتران مركّب: الداخلي <span class=\"tx\" data-t=\"x^2+1\"></span>"],["g(x) = (x^2+1)^{-2}","اقتران مركّب: الداخلي <span class=\"tx\" data-t=\"x^2+1\"></span>"],["p(x) = x^2+1 \\Rightarrow p'(x) = 2x","ليس اقترانًا مركّبًا (قوة <span class=m dir=ltr>1)</span>، يُشتق مباشرة"]],"a":"المختلف هو <span class=\"tx\" data-t=\"p(x) = x^2+1\"></span>؛ لأنّ الاقترانات الثلاثة الأخرى مركّبة على صورة <span class=\"tx\" data-t=\"(x^2+1)^n\"></span> ونحتاج قاعدة السلسلة لاشتقاقها، أمّا <span class=\"tx\" data-t=\"p\"></span> فيُشتق مباشرة بقاعدة القوة (إجابة ممكنة)","o":""}],[{"n":"32","s":[["f(x) = \\left(2x+(x^2+x)^4\\right)^{\\frac{1}{3}}","بكتابة الجذر على صورة أُس"],["f'(x) = \\frac{1}{3}\\left(2x+(x^2+x)^4\\right)^{-\\frac{2}{3}}\\times\\frac{d}{dx}\\left(2x+(x^2+x)^4\\right)","قاعدة السلسلة"],["\\frac{d}{dx}\\left(2x+(x^2+x)^4\\right) = 2+4(x^2+x)^3(2x+1)","قاعدة السلسلة مرة أخرى للحد <span class=\"tx\" data-t=\"(x^2+x)^4\"></span>"],["f'(x) = \\frac{2+4(2x+1)(x^2+x)^3}{3\\sqrt[3]{\\left(2x+(x^2+x)^4\\right)^2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = \\frac{2+4(2x+1)(x^2+x)^3}{3\\sqrt[3]{(2x+(x^2+x)^4)^2}}\"></span>","o":"","k":[{"e":"((8*x + 4)*(x^2 + x)^3 + 2)/(3*((2*x + (x^2 + x)^4)^2)^(1/3))","a":null}]}],[{"n":"33","s":[["\\frac{dy}{dx} = 3(x^2+x-2)^2(2x+1)","قاعدة السلسلة"],["\\frac{dy}{dx}\\Big|_{x=1} = 3(1+1-2)^2(3) = 0","ميل المماس عند <span class=\"tx\" data-t=\"(1,3)\"></span>"],["y = 3","معادلة المماس: مستقيم أفقي يمر بالنقطة <span class=\"tx\" data-t=\"(1,3)\"></span>"],["(x^2+x-2)^3+3 = 3 \\Rightarrow (x+2)(x-1)=0 \\Rightarrow x=-2 \\text{ or } x=1","نقاط تقاطع المماس مع المنحنى"],["\\frac{dy}{dx}\\Big|_{x=-2} = 3(4-2-2)^2(-3) = 0","الميل عند <span class=\"tx\" data-t=\"(-2,3)\"></span> يساوي صفرًا أيضًا"]],"a":"المستقيم <span class=\"tx\" data-t=\"y = 3\"></span> مماس للمنحنى عند <span class=\"tx\" data-t=\"(1,3)\"></span> وأيضًا عند النقطة <span class=\"tx\" data-t=\"(-2, 3)\"></span>؛ لأنّ النقطة تقع على المنحنى والميل عندها صفر","o":""}],[{"n":"2","s":[["f'(x) = 2(x-3)^1\\times 1","قاعدة السلسلة"],["f'(x) = 2x-6","بالتوزيع"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"2x-6\"></span>","o":"","k":[{"e":"2*x - 6","a":null}]}],[{"n":"29","s":[["V = \\frac{1200}{p} = 1200p^{-1} \\Rightarrow \\frac{dV}{dp} = -\\frac{1200}{p^2}","نكتب الحجم بدلالة الضغط"],["\\frac{dp}{dt} = 0.4\\times\\frac{1}{2\\sqrt{t}} = \\frac{0.2}{\\sqrt{t}}","مشتقة الضغط بالنسبة إلى الزمن"],["t=100:\\quad p = 10+0.4(10) = 14,\\quad \\frac{dp}{dt} = \\frac{0.2}{10} = 0.02","بالتعويض <span class=\"tx\" data-t=\"t=100\"></span>"],["\\frac{dV}{dt} = \\frac{dV}{dp}\\times\\frac{dp}{dt} = -\\frac{1200}{14^2}\\times 0.02","قاعدة السلسلة"],["\\frac{dV}{dt} = -\\frac{24}{196} = -\\frac{6}{49} \\approx -0.122","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dV}{dt} = -\\frac{6}{49} \\approx -0.122\"></span> وحدة حجم لكل ثانية (الحجم يتناقص)","o":""}],[{"n":"1","s":[["f(x) = (4x-1)^{\\frac{1}{2}}","بكتابة الجذر على صورة أُس"],["f'(x) = \\frac{1}{2}(4x-1)^{-\\frac{1}{2}}\\times 4 = \\frac{2}{\\sqrt{4x-1}}","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = \\frac{2}{\\sqrt{4x-1}}\"></span>","o":"","k":[{"e":"2/sqrt(4*x - 1)","a":null}]},{"n":"2","s":[["f(x) = 3(3-x^2)^{-\\frac{1}{2}}","بكتابة الكسر على صورة أُس سالب"],["f'(x) = 3\\times\\left(-\\frac{1}{2}\\right)(3-x^2)^{-\\frac{3}{2}}\\times(-2x)","قاعدة السلسلة"],["f'(x) = \\frac{3x}{(3-x^2)^{\\frac{3}{2}}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = \\frac{3x}{\\sqrt{(3-x^2)^3}}\"></span>","o":"","k":[{"e":"3*x/sqrt((3 - x^2)^3)","a":null}]},{"n":"3","s":[["f'(x) = \\frac{5}{2}(3+4x)^{\\frac{3}{2}}\\times 4","قاعدة السلسلة"],["f'(x) = 10(3+4x)^{\\frac{3}{2}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = 10(3+4x)^{\\frac{3}{2}}\"></span>","o":"","k":[{"e":"10*(4*x + 3)^(3/2)","a":null}]},{"n":"4","s":[["f'(x) = 100(8-x)^{99}\\times(-1)","قاعدة السلسلة"],["f'(x) = -100(8-x)^{99}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = -100(8-x)^{99}\"></span>","o":"","k":[{"e":"-100*(8 - x)^99","a":null}]},{"n":"5","s":[["f'(x) = 2x+2(200-x)\\times(-1)","قاعدة القوة وقاعدة السلسلة"],["f'(x) = 2x-400+2x = 4x-400","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = 4x-400\"></span>","o":"","k":[{"e":"4*x - 400","a":null}]},{"n":"6","s":[["f(x) = (x^2-3)^{-3}","بكتابة الكسر على صورة أُس سالب"],["f'(x) = -3(x^2-3)^{-4}\\times 2x = \\frac{-6x}{(x^2-3)^4}","قاعدة السلسلة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x) = \\frac{-6x}{(x^2-3)^4}\"></span>","o":"","k":[{"e":"-6*x/(x^2 - 3)^4","a":null}]}],[{"n":"7","s":[["f'(x) = 12x^2+4(x-2)^3","قاعدة القوة وقاعدة السلسلة"],["f'(2) = 12(4)+4(0)^3 = 48","بالتعويض <span class=\"tx\" data-t=\"x=2\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(2) = 48\"></span>","o":""},{"n":"8","s":[["f'(x) = \\frac{1}{2}(x^2+8x)^{-\\frac{1}{2}}(2x+8) = \\frac{x+4}{\\sqrt{x^2+8x}}","قاعدة السلسلة"],["f'(8) = \\frac{12}{\\sqrt{64+64}} = \\frac{12}{8\\sqrt{2}}","بالتعويض <span class=\"tx\" data-t=\"x=8\"></span>"],["f'(8) = \\frac{3\\sqrt{2}}{4} \\approx 1.06","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(8) = \\frac{3\\sqrt{2}}{4} \\approx 1.06\"></span>","o":"","k":[{"e":"1.06","a":true}]}],[{"n":"9","s":[["f'(x) = \\frac{1}{2}(100-x^2)^{-\\frac{1}{2}}\\times(-2x) = \\frac{-x}{\\sqrt{100-x^2}}","قاعدة السلسلة"],["f'(-6) = \\frac{6}{\\sqrt{100-36}} = \\frac{6}{8} = \\frac{3}{4}","بالتعويض <span class=\"tx\" data-t=\"x=-6\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(-6) = \\frac{3}{4}\"></span>","o":""},{"n":"10","s":[["m_{OP} = \\frac{8-0}{-6-0} = -\\frac{4}{3}","ميل المستقيم الواصل بين <span class=\"tx\" data-t=\"O(0,0)\"></span> و <span class=\"tx\" data-t=\"P(-6,8)\"></span>"],["m_{\\text{tangent}} = \\frac{3}{4}","من الفرع السابق"],["m_{OP}\\times m_{\\text{tangent}} = -\\frac{4}{3}\\times\\frac{3}{4} = -1","حاصل ضرب الميلين <span class=\"tx\" data-t=\"-1\"></span>"]],"a":"المستقيم <span class=\"tx\" data-t=\"OP\"></span> عمودي على المماس عند <span class=\"tx\" data-t=\"P\"></span> لأنّ حاصل ضرب ميليهما <span class=\"tx\" data-t=\"-1\"></span>","o":""}],[{"n":"11","s":[["P'(t) = 3\\left(t^{\\frac{1}{4}}+3\\right)^2\\times\\frac{1}{4}t^{-\\frac{3}{4}}","قاعدة السلسلة"],["P'(t) = \\frac{3\\left(t^{\\frac{1}{4}}+3\\right)^2}{4t^{\\frac{3}{4}}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(t) = \\frac{3(t^{\\frac{1}{4}}+3)^2}{4t^{\\frac{3}{4}}}\"></span>","o":"","k":[{"e":"3*(t^(1/4) + 3)^2/(4*t^(3/4))","a":null}]},{"n":"12","s":[["16^{\\frac{1}{4}} = 2,\\quad 16^{\\frac{3}{4}} = 8",""],["P'(16) = \\frac{3(2+3)^2}{4(8)} = \\frac{75}{32} \\approx 2.34","بالتعويض <span class=\"tx\" data-t=\"t=16\"></span>"]],"a":"<span class=\"tx\" data-t=\"P&#x27;(16) = \\frac{75}{32} \\approx 2.34\"></span> جزء من المليون لكل سنة","o":"","k":[{"e":"2.34","a":true}]}],[{"n":"13","s":[["f'(x) = g'(h(x))\\times h'(x)","قاعدة السلسلة"],["f'(5) = g'(h(5))\\times h'(5) = g'(-2)\\times 6","بالتعويض <span class=\"tx\" data-t=\"h(5)=-2\"></span>"],["f'(5) = 4\\times 6 = 24",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(5) = 24\"></span>","o":""},{"n":"14","s":[["f'(x) = 4\\times 2h(x)\\times h'(x) = 8h(x)h'(x)","قاعدة السلسلة"],["f'(5) = 8(-2)(6) = -96","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(5) = -96\"></span>","o":""}]]