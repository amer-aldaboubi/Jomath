[[{"n":"1","s":[["P(X>\\mu)=50\\%","منحنى التوزيع الطبيعي متماثل حول الوسط الحسابي"]],"a":"<span class=\"tx\" data-t=\"50\\%\"></span>","o":"","k":[{"e":"50","a":null}]},{"n":"2","s":[["P(\\mu-\\sigma<X<\\mu)=\\frac{68\\%}{2}","القاعدة التجريبية: <span class=m dir=ltr>68%</span> ضمن انحراف معياري واحد، والمنحنى متماثل"],["=34\\%",""]],"a":"<span class=\"tx\" data-t=\"34\\%\"></span>","o":"","k":[{"e":"34","a":null}]},{"n":"3","s":[["P(X>\\mu+2\\sigma)=\\frac{100\\%-95\\%}{2}","القاعدة التجريبية: <span class=m dir=ltr>95%</span> ضمن انحرافين معياريين"],["=2.5\\%",""]],"a":"<span class=\"tx\" data-t=\"2.5\\%\"></span>","o":"","k":[{"e":"2.5","a":true}]},{"n":"4","s":[["P(\\mu-2\\sigma<X<\\mu+3\\sigma)=\\frac{95\\%}{2}+\\frac{99.7\\%}{2}","القاعدة التجريبية والتماثل"],["=47.5\\%+49.85\\%=97.35\\%",""]],"a":"<span class=\"tx\" data-t=\"97.35\\%\"></span>","o":"","k":[{"e":"97.35","a":true}]}],[{"n":"5","s":[["P(X<50)=P(X<\\mu)","<span class=m dir=ltr>50</span> هي الوسط الحسابي"],["=0.5","تماثل المنحنى"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;50)=0.5\"></span>","o":""},{"n":"6","s":[["46=50-4=\\mu-\\sigma,\\ 54=\\mu+\\sigma","μ <span class=m dir=ltr>= 50, σ = 4</span>"],["P(\\mu-\\sigma<X<\\mu+\\sigma)=0.68","القاعدة التجريبية"]],"a":"<span class=\"tx\" data-t=\"P(46&lt;X&lt;54)=0.68\"></span>","o":""},{"n":"7","s":[["42=\\mu-2\\sigma,\\quad 62=\\mu+3\\sigma","μ <span class=m dir=ltr>= 50, σ = 4</span>"],["P(42<X<62)=\\frac{0.95}{2}+\\frac{0.997}{2}","القاعدة التجريبية والتماثل"],["=0.475+0.4985=0.9735",""]],"a":"<span class=\"tx\" data-t=\"P(42&lt;X&lt;62)=0.9735\"></span>","o":""}],[{"n":"8","s":[["\\mu=2.5\\ \\text{mm}","محور تماثل المنحنى"],["P(2.3<X<2.7)=100\\%-2.5\\%-2.5\\%=95\\%","من الشكل"],["2.7=\\mu+2\\sigma\\Rightarrow 2.5+2\\sigma=2.7","القاعدة التجريبية: <span class=m dir=ltr>95%</span> ضمن انحرافين معياريين"],["\\sigma=0.1\\ \\text{mm}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\mu=2.5\\ \\text{mm},\\ \\sigma=0.1\\ \\text{mm}\"></span>","o":""},{"n":"9","s":[["P(\\mu<X<\\mu+2\\sigma)=\\frac{95\\%}{2}","القاعدة التجريبية والتماثل"],["=47.5\\%",""]],"a":"<span class=\"tx\" data-t=\"47.5\\%\"></span> (أقطارها بين <span class=\"tx\" data-t=\"2.5\"></span> و <span class=\"tx\" data-t=\"2.7\"></span> <span class=m dir=ltr>mm)</span>","o":"","k":[{"e":"47.5","a":true},{"e":"2.5","a":true},{"e":"2.7","a":true}]}],[{"n":"10","s":[["P(93<X<107)=68\\%","المعطى"],["93=\\mu-\\sigma,\\ 107=\\mu+\\sigma","القاعدة التجريبية: <span class=m dir=ltr>68%</span> ضمن انحراف معياري واحد، μ <span class=m dir=ltr>= 100</span>"],["\\sigma=107-100=7","بالطرح"],["\\sigma^{2}=49","بالتربيع"]],"a":"<span class=\"tx\" data-t=\"\\sigma^2=49\"></span>","o":""}],[{"n":"11","s":[["P(Z<0.43)=0.6664","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.6664\"></span>","o":"","k":[{"e":"0.6664","a":true}]},{"n":"12","s":[["P(Z>1.08)=1-P(Z<1.08)","باستعمال الخصائص"],["=1-0.8599=0.1401","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.1401\"></span>","o":"","k":[{"e":"0.1401","a":true}]},{"n":"13","s":[["P(Z<-2.03)=1-P(Z<2.03)","باستعمال الخصائص"],["=1-0.9788=0.0212","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.0212\"></span>","o":"","k":[{"e":"0.0212","a":true}]},{"n":"14","s":[["P(Z>2.2)=1-P(Z<2.2)","باستعمال الخصائص"],["=1-0.9861=0.0139","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.0139\"></span>","o":"","k":[{"e":"0.0139","a":true}]},{"n":"15","s":[["P(-0.72<Z<0.72)=2P(Z<0.72)-1","باستعمال الخصائص (التماثل)"],["=2(0.7642)-1=0.5284","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.5284\"></span>","o":"","k":[{"e":"0.5284","a":true}]},{"n":"16","s":[["P(1.5<Z<2.5)=P(Z<2.5)-P(Z<1.5)","باستعمال الخصائص"],["=0.9938-0.9332=0.0606","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.0606\"></span>","o":"","k":[{"e":"0.0606","a":true}]}],[{"n":"17","s":[["P(-0.5<Z<1.5)=P(Z<1.5)-P(Z<-0.5)","المنطقة المظللة بين <span class=m dir=ltr>-0.5</span> و <span class=m dir=ltr>1.5</span>"],["=P(Z<1.5)-\\left(1-P(Z<0.5)\\right)","باستعمال الخصائص"],["=0.9332-(1-0.6915)=0.6247","باستعمال الجدول"]],"a":"المساحة <span class=\"tx\" data-t=\"=0.6247\"></span>","o":""},{"n":"18","s":[["P(-2.25<Z<0)=P(0<Z<2.25)","التماثل حول <span class=m dir=ltr>0</span>"],["=P(Z<2.25)-0.5","<span class=m dir=ltr>P(Z &lt; 0) = 0.5</span>"],["=0.9878-0.5=0.4878","باستعمال الجدول"]],"a":"المساحة <span class=\"tx\" data-t=\"=0.4878\"></span>","o":""}],[{"n":"19","s":[["P(Z<z)=0.7642","المعطى"],["z=0.72","بالبحث عن <span class=m dir=ltr>0.7642</span> داخل الجدول"]],"a":"<span class=\"tx\" data-t=\"z=0.72\"></span>","o":"","k":[{"e":"0.72","a":true}]},{"n":"20","s":[["P(Z<z)=1-0.372=0.628","احتمال المتممة"],["z\\approx 0.33","أقرب قيمة في الجدول <span class=m dir=ltr>0.6293</span>"]],"a":"<span class=\"tx\" data-t=\"z\\approx 0.33\"></span>","o":"","k":[{"e":"0.33","a":true}]},{"n":"21","s":[["P(Z>z)=0.8531>0.5\\Rightarrow z<0","الاحتمال أكبر من <span class=m dir=ltr>0.5</span>"],["P(Z<-z)=0.8531","التماثل: <span class=m dir=ltr>P(Z &gt; z) = P(Z &lt; -z)</span>"],["-z=1.05\\Rightarrow z=-1.05","من الجدول"]],"a":"<span class=\"tx\" data-t=\"z=-1.05\"></span>","o":"","k":[{"e":"-1.05","a":true}]}],[{"n":"22","s":[["\\mu=-3,\\ \\sigma=\\sqrt{25}=5","من المعطيات"],["P(X<2)=P\\left(Z<\\frac{2-(-3)}{5}\\right)=P(Z<1)","صيغة قيم <span class=m dir=ltr>z</span>"],["=0.8413","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.8413\"></span>","o":"","k":[{"e":"0.8413","a":true}]},{"n":"23","s":[["P(X>4.5)=P\\left(Z>\\frac{4.5+3}{5}\\right)=P(Z>1.5)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-P(Z<1.5)=1-0.9332=0.0668","باستعمال الخصائص والجدول"]],"a":"<span class=\"tx\" data-t=\"0.0668\"></span>","o":"","k":[{"e":"0.0668","a":true}]},{"n":"24","s":[["P(-5<X<-3)=P\\left(\\frac{-5+3}{5}<Z<\\frac{-3+3}{5}\\right)","صيغة قيم <span class=m dir=ltr>z</span>"],["=P(-0.4<Z<0)=P(Z<0.4)-0.5","التماثل"],["=0.6554-0.5=0.1554","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"0.1554\"></span>","o":"","k":[{"e":"0.1554","a":true}]}],[{"n":"25","s":[["P\\left(Z<\\frac{x-30}{10}\\right)=0.99","صيغة قيم <span class=m dir=ltr>z</span>"],["\\frac{x-30}{10}\\approx 2.33","أقرب قيمة في الجدول <span class=m dir=ltr>0.9901</span>"],["x=30+23.3=53.3","بالحل"]],"a":"<span class=\"tx\" data-t=\"x\\approx 53.3\"></span>","o":"","k":[{"e":"53.3","a":true}]},{"n":"26","s":[["P\\left(Z<\\frac{x-30}{10}\\right)=1-0.1949=0.8051","احتمال المتممة"],["\\frac{x-30}{10}=0.86","من الجدول"],["x=30+8.6=38.6","بالحل"]],"a":"<span class=\"tx\" data-t=\"x=38.6\"></span>","o":"","k":[{"e":"38.6","a":true}]},{"n":"27","s":[["P(X<x)=0.35<0.5\\Rightarrow z<0","<span class=m dir=ltr>x</span> أقل من الوسط"],["P(Z<-z)=0.65\\Rightarrow -z\\approx 0.39","التماثل، وأقرب قيمة في الجدول <span class=m dir=ltr>0.6517</span>"],["\\frac{x-30}{10}=-0.39\\Rightarrow x=26.1","بالحل"]],"a":"<span class=\"tx\" data-t=\"x\\approx 26.1\"></span>","o":"","k":[{"e":"26.1","a":true}]},{"n":"28","s":[["P\\left(Z<\\frac{x-30}{10}\\right)=0.95","احتمال المتممة"],["\\frac{x-30}{10}\\approx 1.645","<span class=m dir=ltr>0.95</span> تقع في منتصف المسافة بين <span class=m dir=ltr>0.9495 (z = 1.64)</span> و <span class=m dir=ltr>0.9505 (z = 1.65)</span>"],["x=30+16.45=46.45","بالحل"]],"a":"<span class=\"tx\" data-t=\"x\\approx 46.45\"></span> (أو <span class=\"tx\" data-t=\"46.4\"></span> باستعمال <span class=\"tx\" data-t=\"z=1.64\"></span>)","o":"","k":[{"e":"46.45","a":true},{"e":"46.4","a":true},{"e":"1.64","a":true}]}],[{"n":"29","s":[["P(X>175)=P\\left(Z>\\frac{175-185}{4}\\right)=P(Z>-2.5)","صيغة قيم <span class=m dir=ltr>z</span>"],["=P(Z<2.5)=0.9938","التماثل، والجدول"]],"a":"<span class=\"tx\" data-t=\"0.9938\"></span>","o":"","k":[{"e":"0.9938","a":true}]},{"n":"30","s":[["P(180<X<190)=P(-1.25<Z<1.25)","صيغة قيم <span class=m dir=ltr>z</span>"],["=2P(Z<1.25)-1=2(0.8944)-1","التماثل، والجدول"],["=0.7888",""]],"a":"<span class=\"tx\" data-t=\"0.7888\"></span>","o":"","k":[{"e":"0.7888","a":true}]},{"n":"31","s":[["P(X>195)=P\\left(Z>\\frac{195-185}{4}\\right)=P(Z>2.5)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-0.9938=0.0062","باستعمال الجدول"],["2000\\times 0.0062=12.4","عدد اللاعبين <span class=m dir=ltr>=</span> العدد الكلي <span class=m dir=ltr>×</span> الاحتمال"]],"a":"تقريبًا <span class=\"tx\" data-t=\"12\"></span> لاعبًا","o":"","k":[{"e":"12","a":null}]}],[{"n":"32","s":[["X\\sim N(6,2^{2})","<span class=m dir=ltr>X</span>: طول الشجرة بالمتر"],["P(X>9)=P\\left(Z>\\frac{9-6}{2}\\right)=P(Z>1.5)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-P(Z<1.5)=1-0.9332=0.0668","باستعمال الخصائص والجدول"]],"a":"<span class=\"tx\" data-t=\"P(X&gt;9)=0.0668\"></span>","o":""}],[{"n":"33","s":[["P(X<224)=P\\left(Z<\\frac{224-232}{5}\\right)=P(Z<-1.6)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-P(Z<1.6)=1-0.9452=0.0548","باستعمال الخصائص والجدول"]],"a":"<span class=\"tx\" data-t=\"P(X&lt;224)=0.0548\"></span>","o":""},{"n":"34","s":[["P(232<X<x)=P(X<x)-0.5=0.2","<span class=m dir=ltr>232</span> هي الوسط، و <span class=m dir=ltr>P(X &lt;</span> μ<span class=m dir=ltr>) = 0.5</span>"],["P\\left(Z<\\frac{x-232}{5}\\right)=0.7","بإضافة <span class=m dir=ltr>0.5</span> للطرفين"],["\\frac{x-232}{5}\\approx 0.52","أقرب قيمة في الجدول <span class=m dir=ltr>0.6985</span>"],["x=232+2.6=234.6","بالحل"]],"a":"<span class=\"tx\" data-t=\"x\\approx 234.6\\ \\text{g}\"></span>","o":"","k":[{"e":"234.6","a":true}]}],[{"n":"35","s":[["\\sigma=\\sqrt{1.69}=1.3","من المعطيات"],["P(X>47)=0.11\\Rightarrow P\\left(Z<\\frac{47-\\mu}{1.3}\\right)=0.89","احتمال المتممة"],["\\frac{47-\\mu}{1.3}\\approx 1.23","أقرب قيمة في الجدول <span class=m dir=ltr>0.8907</span>"],["\\mu=47-1.3(1.23)=47-1.599\\approx 45.4","بالحل"]],"a":"<span class=\"tx\" data-t=\"\\mu\\approx 45.4\\ \\text{cm}\"></span>","o":""}],[{"n":"36","s":[["P(X>48)=0.2\\Rightarrow P\\left(Z<\\frac{48-43}{\\sigma}\\right)=0.8","احتمال المتممة"],["\\frac{5}{\\sigma}\\approx 0.84","أقرب قيمة في الجدول <span class=m dir=ltr>0.7995</span>"],["\\sigma=\\frac{5}{0.84}\\approx 5.95","بالحل"]],"a":"<span class=\"tx\" data-t=\"\\sigma\\approx 5.95\"></span>","o":""}],[{"n":"37","s":[["z=\\frac{x-\\mu}{\\sigma},\\ \\sigma=\\mu","صيغة قيم <span class=m dir=ltr>z</span>، والتباين μ<span class=m dir=ltr>²</span> يعني <span class=m dir=ltr>σ =</span> μ (μ <span class=m dir=ltr>&gt; 0)</span>"],["2=\\frac{1-\\mu}{\\mu}","بتعويض <span class=m dir=ltr>x = 1, z = 2</span>"],["2\\mu=1-\\mu\\Rightarrow 3\\mu=1","بضرب الطرفين في μ"],["\\mu=\\frac{1}{3}","بالقسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"\\mu=\\frac{1}{3}\"></span>","o":""}],[{"n":"38","s":[["\\frac{10-\\mu}{\\sigma}=1\\Rightarrow 10-\\mu=\\sigma","صيغة قيم <span class=m dir=ltr>z</span> للقيمة <span class=m dir=ltr>10</span>"],["\\frac{4-\\mu}{\\sigma}=-2\\Rightarrow 4-\\mu=-2\\sigma","صيغة قيم <span class=m dir=ltr>z</span> للقيمة <span class=m dir=ltr>4</span>"],["6=3\\sigma\\Rightarrow \\sigma=2","بطرح المعادلة الثانية من الأولى"],["\\mu=10-2=8","بالتعويض في المعادلة الأولى"]],"a":"<span class=\"tx\" data-t=\"\\mu=8,\\ \\sigma=2\"></span>","o":""}],[{"n":"39","s":[["P(X>100)=P\\left(Z>\\frac{100-90}{5}\\right)=P(Z>2)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-0.9772=0.0228","باستعمال الجدول"],["1000\\times 0.0228=22.8","العدد الكلي <span class=m dir=ltr>×</span> الاحتمال"]],"a":"تقريبًا <span class=\"tx\" data-t=\"23\"></span> سيارة","o":"","k":[{"e":"23","a":null}]}],[{"n":"40","s":[["P(X\\le 55)=P\\left(Z\\le\\frac{55-60}{4}\\right)=P(Z\\le -1.25)","صيغة قيم <span class=m dir=ltr>z</span>"],["=1-P(Z<1.25)=1-0.8944=0.1056","باستعمال الخصائص والجدول"],["5000\\times 0.1056=528","العدد الكلي <span class=m dir=ltr>×</span> الاحتمال"]],"a":"عدد البيض الصغير تقريبًا <span class=\"tx\" data-t=\"528\"></span> بيضة","o":"","k":[{"e":"528","a":null}]}],[{"n":"41","s":[["\\sigma^{2}=0.09\\Rightarrow \\sigma=0.3","العدد <span class=m dir=ltr>0.09</span> هو التباين وليس الانحراف المعياري"],["\\mu\\pm 2\\sigma=6.4\\pm 2(0.3)","القاعدة التجريبية: <span class=m dir=ltr>95%</span> ضمن انحرافين معياريين"],["5.8<X<7.0",""]],"a":"الصحيح: <span class=m dir=ltr>95%</span> من البيانات تقع بين <span class=\"tx\" data-t=\"5.8\"></span> و <span class=\"tx\" data-t=\"7\"></span>","o":"الخطأ: استعملت عبير <span class=m dir=ltr>0.09</span> على أنه الانحراف المعياري فحسبت <span class=m dir=ltr>6.4</span> ± <span class=m dir=ltr>2(0.09)</span>، والصحيح أن <span class=m dir=ltr>σ = √0.09 = 0.3</span>."}],[{"n":"42","s":[["P(X>35)=0.025\\Rightarrow P\\left(Z<\\frac{35-\\mu}{\\sigma}\\right)=0.975\\Rightarrow \\frac{35-\\mu}{\\sigma}=1.96","احتمال المتممة والجدول"],["P(X<15)=0.1469<0.5\\Rightarrow \\frac{15-\\mu}{\\sigma}=-1.05","التماثل: <span class=m dir=ltr>P(Z &lt; 1.05) = 0.8531</span>"],["35-\\mu=1.96\\sigma,\\quad 15-\\mu=-1.05\\sigma","بضرب الطرفين في σ"],["20=3.01\\sigma\\Rightarrow \\sigma\\approx 6.64","بطرح المعادلتين"],["\\mu=35-1.96(6.645)\\approx 21.98\\approx 22","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\mu\\approx 22,\\ \\sigma\\approx 6.64\"></span>","o":"التبرير: نحوّل كل احتمال إلى قيمة <span class=m dir=ltr>z</span> من الجدول، فنحصل على نظام معادلتين خطيتين في μ و σ."}],[{"n":"43","s":[["P(X>90)=\\frac{10000}{100000}=0.1,\\quad P(X>95)=\\frac{5000}{100000}=0.05","النسبة <span class=m dir=ltr>=</span> عدد الطلبة <span class=m dir=ltr>÷</span> العدد الكلي"],["\\frac{90-\\mu}{\\sigma}\\approx 1.28","<span class=m dir=ltr>P(Z &lt; z) = 0.9</span>، أقرب قيمة في الجدول <span class=m dir=ltr>0.8997</span>"],["\\frac{95-\\mu}{\\sigma}\\approx 1.645","<span class=m dir=ltr>P(Z &lt; z) = 0.95</span>"],["5=0.365\\sigma\\Rightarrow \\sigma\\approx 13.7","بطرح المعادلتين"],["\\mu=90-1.28(13.7)\\approx 72.5","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\mu\\approx 72.5,\\ \\sigma\\approx 13.7\"></span>","o":"باستعمال <span class=m dir=ltr>z = 1.64</span> بدل <span class=m dir=ltr>1.645</span> نحصل على μ ≈ <span class=m dir=ltr>72.2</span> و σ ≈ <span class=m dir=ltr>13.9</span> تقريبًا."}],[{"n":"44","s":[["P(X>13)=0.05