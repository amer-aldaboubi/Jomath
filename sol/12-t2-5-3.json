[[{"n":"1","s":[["\\frac{x-10}{x(x+5)}=\\frac{A}{x}+\\frac{B}{x+5}\\Rightarrow x-10=A(x+5)+Bx",""],["x=0:\\ A=-2;\\quad x=-5:\\ B=3",""],["\\int\\left(\\frac{-2}{x}+\\frac{3}{x+5}\\right)dx=-2\\ln|x|+3\\ln|x+5|+C",""]],"a":"<span class=\"tx\" data-t=\"-2\\ln|x|+3\\ln|x+5|+C\"></span>","o":""},{"n":"2","s":[["\\frac{2}{(1-x)(1+x)}=\\frac{A}{1-x}+\\frac{B}{1+x}\\Rightarrow 2=A(1+x)+B(1-x)",""],["x=1:\\ A=1;\\quad x=-1:\\ B=1",""],["\\int\\left(\\frac{1}{1-x}+\\frac{1}{1+x}\\right)dx=-\\ln|1-x|+\\ln|1+x|+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{1+x}{1-x}\\right|+C\"></span>","o":""},{"n":"3","s":[["\\frac{4}{(x-2)(x-4)}=\\frac{A}{x-2}+\\frac{B}{x-4}\\Rightarrow 4=A(x-4)+B(x-2)",""],["x=2:\\ A=-2;\\quad x=4:\\ B=2",""],["\\int\\left(\\frac{-2}{x-2}+\\frac{2}{x-4}\\right)dx=-2\\ln|x-2|+2\\ln|x-4|+C",""]],"a":"<span class=\"tx\" data-t=\"2\\ln|x-4|-2\\ln|x-2|+C\"></span>","o":""},{"n":"4","s":[["\\frac{3x+4}{x(x+1)}=\\frac{A}{x}+\\frac{B}{x+1}\\Rightarrow 3x+4=A(x+1)+Bx","بتحليل المقام"],["x=0:\\ A=4;\\quad x=-1:\\ B=-1",""],["\\int\\left(\\frac{4}{x}-\\frac{1}{x+1}\\right)dx=4\\ln|x|-\\ln|x+1|+C",""]],"a":"<span class=\"tx\" data-t=\"4\\ln|x|-\\ln|x+1|+C\"></span>","o":""},{"n":"5","s":[["\\frac{x^2}{x^2-4}=1+\\frac{4}{x^2-4}","بالقسمة الطويلة (درجة البسط <span class=m dir=ltr>=</span> درجة المقام)"],["\\frac{4}{(x-2)(x+2)}=\\frac{A}{x-2}+\\frac{B}{x+2}:\\ A=1,\\ B=-1",""],["\\int\\left(1+\\frac{1}{x-2}-\\frac{1}{x+2}\\right)dx=x+\\ln|x-2|-\\ln|x+2|+C",""]],"a":"<span class=\"tx\" data-t=\"x+\\ln|x-2|-\\ln|x+2|+C\"></span>","o":""},{"n":"6","s":[["\\frac{3x-6}{(x+2)(x-1)}=\\frac{A}{x+2}+\\frac{B}{x-1}\\Rightarrow 3x-6=A(x-1)+B(x+2)","بتحليل المقام"],["x=-2:\\ A=4;\\quad x=1:\\ B=-1",""],["\\int\\left(\\frac{4}{x+2}-\\frac{1}{x-1}\\right)dx=4\\ln|x+2|-\\ln|x-1|+C",""]],"a":"<span class=\"tx\" data-t=\"4\\ln|x+2|-\\ln|x-1|+C\"></span>","o":""}],[{"n":"7","s":[["4x^2-4x-3=(2x-3)(2x+1)","تحليل المقام"],["\\frac{4x+10}{(2x-3)(2x+1)}=\\frac{A}{2x-3}+\\frac{B}{2x+1}","تجزئة الكسر"],["4x+10=A(2x+1)+B(2x-3)","بضرب الطرفين في المقام"],["x=\\tfrac{3}{2}:\\ 16=4A\\Rightarrow A=4;\\quad x=-\\tfrac{1}{2}:\\ 8=-4B\\Rightarrow B=-2","بالتعويض بأصفار المقام"],["\\int\\left(\\frac{4}{2x-3}-\\frac{2}{2x+1}\\right)dx=2\\ln|2x-3|-\\ln|2x+1|+C","تكامل <span class=\"tx\" data-t=\"\\frac{a}{ax+b}\"></span>"]],"a":"<span class=\"tx\" data-t=\"2\\ln|2x-3|-\\ln|2x+1|+C\"></span>","o":""},{"n":"8","s":[["x^3+2x^2-5x-6=(x-2)(x+1)(x+3)","<span class=\"tx\" data-t=\"x=2\"></span> صفر للمقام، ثم القسمة التركيبية"],["\\frac{2x^2+9x-11}{(x-2)(x+1)(x+3)}=\\frac{A}{x-2}+\\frac{B}{x+1}+\\frac{C}{x+3}","تجزئة الكسر"],["x=2:\\ 15=15A\\Rightarrow A=1","بالتعويض"],["x=-1:\\ -18=-6B\\Rightarrow B=3;\\quad x=-3:\\ -20=10C\\Rightarrow C=-2","بالتعويض"],["\\int\\left(\\frac{1}{x-2}+\\frac{3}{x+1}-\\frac{2}{x+3}\\right)dx","بتكامل كل كسر"]],"a":"<span class=\"tx\" data-t=\"\\ln|x-2|+3\\ln|x+1|-2\\ln|x+3|+C\"></span>","o":""},{"n":"9","s":[["\\frac{4x}{(x-3)(x+1)}=\\frac{A}{x-3}+\\frac{B}{x+1}","تحليل المقام وتجزئة الكسر"],["4x=A(x+1)+B(x-3)","بضرب الطرفين في المقام"],["x=3:\\ 12=4A\\Rightarrow A=3;\\quad x=-1:\\ -4=-4B\\Rightarrow B=1","بالتعويض"],["\\int\\left(\\frac{3}{x-3}+\\frac{1}{x+1}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"3\\ln|x-3|+\\ln|x+1|+C\"></span>","o":""},{"n":"10","s":[["\\frac{8x^2-19x+1}{(2x+1)(x-2)^2}=\\frac{A}{2x+1}+\\frac{B}{x-2}+\\frac{C}{(x-2)^2}","عامل خطي مكرر"],["8x^2-19x+1=A(x-2)^2+B(2x+1)(x-2)+C(2x+1)","بضرب الطرفين في المقام"],["x=2:\\ -5=5C\\Rightarrow C=-1;\\quad x=-\\tfrac12:\\ \\tfrac{25}{2}=\\tfrac{25}{4}A\\Rightarrow A=2","بالتعويض"],["x^2:\\ 8=A+2B\\Rightarrow B=3","بمساواة معاملات <span class=\"tx\" data-t=\"x^2\"></span>"],["\\int\\left(\\frac{2}{2x+1}+\\frac{3}{x-2}-\\frac{1}{(x-2)^2}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"\\ln|2x+1|+3\\ln|x-2|+\\dfrac{1}{x-2}+C\"></span>","o":""},{"n":"11","s":[["\\frac{9x^2-3x+2}{9x^2-4}=1+\\frac{-3x+6}{9x^2-4}","درجة البسط <span class=m dir=ltr>=</span> درجة المقام، فنقسم أولًا"],["\\frac{-3x+6}{(3x-2)(3x+2)}=\\frac{A}{3x-2}+\\frac{B}{3x+2}","تجزئة الكسر"],["x=\\tfrac23:\\ 4=4A\\Rightarrow A=1;\\quad x=-\\tfrac23:\\ 8=-4B\\Rightarrow B=-2","بالتعويض في <span class=\"tx\" data-t=\"-3x+6=A(3x+2)+B(3x-2)\"></span>"],["\\int\\left(1+\\frac{1}{3x-2}-\\frac{2}{3x+2}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"x+\\frac13\\ln|3x-2|-\\frac23\\ln|3x+2|+C\"></span>","o":""},{"n":"12","s":[["\\frac{x^3+2x^2+2}{x^2+x}=x+1+\\frac{2-x}{x(x+1)}","بالقسمة الطويلة"],["\\frac{2-x}{x(x+1)}=\\frac{A}{x}+\\frac{B}{x+1}","تجزئة الكسر"],["x=0:\\ A=2;\\quad x=-1:\\ 3=-B\\Rightarrow B=-3","بالتعويض في <span class=\"tx\" data-t=\"2-x=A(x+1)+Bx\"></span>"],["\\int\\left(x+1+\\frac{2}{x}-\\frac{3}{x+1}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"\\frac{x^2}{2}+x+2\\ln|x|-3\\ln|x+1|+C\"></span>","o":""}],[{"n":"13","s":[["\\frac{x^2+x+2}{3-2x-x^2}=-1+\\frac{5-x}{3-2x-x^2}","بالقسمة (درجة البسط <span class=m dir=ltr>=</span> درجة المقام)"],["3-2x-x^2=(1-x)(3+x)","تحليل المقام"],["\\frac{5-x}{(1-x)(3+x)}=\\frac{A}{1-x}+\\frac{B}{3+x}","تجزئة الكسر"],["x=1:\\ 4=4A\\Rightarrow A=1;\\quad x=-3:\\ 8=4B\\Rightarrow B=2","بالتعويض في <span class=\"tx\" data-t=\"5-x=A(3+x)+B(1-x)\"></span>"],["\\int\\left(-1+\\frac{1}{1-x}+\\frac{2}{3+x}\\right)dx","لاحظ: <span class=\"tx\" data-t=\"\\int\\frac{dx}{1-x}=-\\ln|1-x|\"></span>"]],"a":"<span class=\"tx\" data-t=\"-x-\\ln|1-x|+2\\ln|x+3|+C\"></span>","o":""},{"n":"14","s":[["\\frac{2x-4}{(x^2+4)(x+2)}=\\frac{A}{x+2}+\\frac{Bx+C}{x^2+4}","عامل تربيعي غير قابل للتحليل"],["2x-4=A(x^2+4)+(Bx+C)(x+2)","بضرب الطرفين في المقام"],["x=-2:\\ -8=8A\\Rightarrow A=-1","بالتعويض"],["x^2:\\ 0=A+B\\Rightarrow B=1;\\quad x^0:\\ -4=4A+2C\\Rightarrow C=0","بمساواة المعاملات"],["\\int\\left(-\\frac{1}{x+2}+\\frac{x}{x^2+4}\\right)dx=-\\ln|x+2|+\\frac12\\ln(x^2+4)+C","البسط <span class=\"tx\" data-t=\"x\"></span> نصف مشتقة <span class=\"tx\" data-t=\"x^2+4\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\ln|x+2|+\\frac12\\ln(x^2+4)+C\"></span>","o":""},{"n":"15","s":[["\\frac{x^3-4x^2-2}{x^3+x^2}=1+\\frac{-5x^2-2}{x^2(x+1)}","بالقسمة"],["\\frac{-5x^2-2}{x^2(x+1)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{C}{x+1}","تجزئة الكسر (عامل <span class=\"tx\" data-t=\"x\"></span> مكرر)"],["x=0:\\ B=-2;\\quad x=-1:\\ C=-7","بالتعويض في <span class=\"tx\" data-t=\"-5x^2-2=Ax(x+1)+B(x+1)+Cx^2\"></span>"],["x^2:\\ -5=A+C\\Rightarrow A=2","بمساواة معاملات <span class=\"tx\" data-t=\"x^2\"></span>"],["\\int\\left(1+\\frac{2}{x}-\\frac{2}{x^2}-\\frac{7}{x+1}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"x+2\\ln|x|+\\dfrac{2}{x}-7\\ln|x+1|+C\"></span>","o":""},{"n":"16","s":[["2-5x-12x^2=(1-4x)(2+3x)","تحليل المقام"],["\\frac{3-x}{(1-4x)(2+3x)}=\\frac{A}{1-4x}+\\frac{B}{2+3x}","تجزئة الكسر"],["x=\\tfrac14:\\ \\tfrac{11}{4}=\\tfrac{11}{4}A\\Rightarrow A=1;\\quad x=-\\tfrac23:\\ \\tfrac{11}{3}=\\tfrac{11}{3}B\\Rightarrow B=1","بالتعويض في <span class=\"tx\" data-t=\"3-x=A(2+3x)+B(1-4x)\"></span>"],["\\int\\left(\\frac{1}{1-4x}+\\frac{1}{2+3x}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"-\\frac14\\ln|1-4x|+\\frac13\\ln|2+3x|+C\"></span>","o":""},{"n":"17","s":[["\\frac{3x^3+2x^2+12}{x^2(x^2+6)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{Cx+D}{x^2+6}","تجزئة الكسر"],["3x^3+2x^2+12=Ax(x^2+6)+B(x^2+6)+(Cx+D)x^2","بضرب الطرفين في المقام"],["x=0:\\ 12=6B\\Rightarrow B=2","بالتعويض"],["x:\\ 0=6A\\Rightarrow A=0;\\ \\ x^3:\\ 3=A+C\\Rightarrow C=3;\\ \\ x^2:\\ 2=B+D\\Rightarrow D=0","بمساواة المعاملات"],["\\int\\left(\\frac{2}{x^2}+\\frac{3x}{x^2+6}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"-\\dfrac{2}{x}+\\frac32\\ln(x^2+6)+C\"></span>","o":""},{"n":"18","s":[["\\frac{5x-2}{(x-2)^2}=\\frac{A}{x-2}+\\frac{B}{(x-2)^2}","عامل خطي مكرر"],["5x-2=A(x-2)+B","بضرب الطرفين في المقام"],["x=2:\\ B=8;\\quad x:\\ A=5","بالتعويض ومساواة المعاملات"],["\\int\\left(\\frac{5}{x-2}+\\frac{8}{(x-2)^2}\\right)dx",""]],"a":"<span class=\"tx\" data-t=\"5\\ln|x-2|-\\dfrac{8}{x-2}+C\"></span>","o":""}],[{"n":"19","s":[["\\frac{6+3x-x^2}{x^2(x+2)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{C}{x+2}","تحليل المقام <span class=\"tx\" data-t=\"x^3+2x^2=x^2(x+2)\"></span>"],["x=0:\\ 6=2B\\Rightarrow B=3;\\quad x=-2:\\ -4=4C\\Rightarrow C=-1;\\quad x^2:\\ -1=A+C\\Rightarrow A=0","بالتعويض في <span class=\"tx\" data-t=\"6+3x-x^2=Ax(x+2)+B(x+2)+Cx^2\"></span>"],["\\int_2^4\\left(\\frac{3}{x^2}-\\frac{1}{x+2}\\right)dx=\\left[-\\frac{3}{x}-\\ln(x+2)\\right]_2^4",""],["=\\left(-\\tfrac34-\\ln6\\right)-\\left(-\\tfrac32-\\ln4\\right)=\\tfrac34-\\ln\\tfrac32","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac34+\\ln\\frac23\\approx 0.345\"></span>","o":""},{"n":"20","s":[["\\frac{9x^2+4}{9x^2-4}=1+\\frac{8}{(3x-2)(3x+2)}","بالقسمة"],["\\frac{8}{(3x-2)(3x+2)}=\\frac{2}{3x-2}-\\frac{2}{3x+2}","بالتعويض بـ <span class=\"tx\" data-t=\"x=\\pm\\frac23\"></span>"],["\\int\\left(1+\\frac{2}{3x-2}-\\frac{2}{3x+2}\\right)dx=x+\\frac23\\ln\\left|\\frac{3x-2}{3x+2}\\right|",""],["\\left[\\tfrac13+\\tfrac23\\ln\\tfrac13\\right]-\\left[-\\tfrac13+\\tfrac23\\ln3\\right]","بالتعويض بحدّي التكامل"],["=\\frac23-\\frac43\\ln3","لأنّ <span class=\"tx\" data-t=\"\\ln\\frac13=-\\ln3\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac23-\\frac43\\ln3\\approx -0.798\"></span>","o":""},{"n":"21","s":[["\\frac{17-5x}{(2x+3)(2-x)^2}=\\frac{A}{2x+3}+\\frac{B}{2-x}+\\frac{C}{(2-x)^2}","تجزئة الكسر"],["17-5x=A(2-x)^2+B(2x+3)(2-x)+C(2x+3)","بضرب الطرفين في المقام"],["x=2:\\ 7=7C\\Rightarrow C=1;\\ \\ x=-\\tfrac32:\\ \\tfrac{49}{2}=\\tfrac{49}{4}A\\Rightarrow A=2;\\ \\ x^2:\\ 0=A-2B\\Rightarrow B=1","بالتعويض ومساواة المعاملات"],["\\int_0^1\\left(\\frac{2}{2x+3}+\\frac{1}{2-x}+\\frac{1}{(2-x)^2}\\right)dx=\\left[\\ln(2x+3)-\\ln(2-x)+\\frac{1}{2-x}\\right]_0^1",""],["=(\\ln5+1)-\\left(\\ln3-\\ln2+\\tfrac12\\right)=\\tfrac12+\\ln\\tfrac{10}{3}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac12+\\ln\\frac{10}{3}\\approx 1.704\"></span>","o":""},{"n":"22","s":[["16x^2+8x-3=(4x-1)(4x+3)","تحليل المقام"],["\\frac{4}{(4x-1)(4x+3)}=\\frac{1}{4x-1}-\\frac{1}{4x+3}","بالتعويض بـ <span class=\"tx\" data-t=\"x=\\frac14\"></span> و <span class=\"tx\" data-t=\"x=-\\frac34\"></span>"],["\\int_1^4\\left(\\frac{1}{4x-1}-\\frac{1}{4x+3}\\right)dx=\\left[\\frac14\\ln\\left|\\frac{4x-1}{4x+3}\\right|\\right]_1^4",""],["=\\frac14\\ln\\frac{15}{19}-\\frac14\\ln\\frac37=\\frac14\\ln\\frac{35}{19}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac14\\ln\\frac{35}{19}\\approx 0.153\"></span>","o":""},{"n":"23","s":[["\\frac{5x+5}{(x+3)(x-2)}=\\frac{A}{x-2}+\\frac{B}{x+3}","تحليل المقام"],["x=2:\\ 15=5A\\Rightarrow A=3;\\quad x=-3:\\ -10=-5B\\Rightarrow B=2","بالتعويض في <span class=\"tx\" data-t=\"5x+5=A(x+3)+B(x-2)\"></span>"],["\\int_3^4\\left(\\frac{3}{x-2}+\\frac{2}{x+3}\\right)dx=\\left[3\\ln|x-2|+2\\ln|x+3|\\right]_3^4",""],["=(3\\ln2+2\\ln7)-(0+2\\ln6)=\\ln\\frac{8\\times49}{36}=\\ln\\frac{98}{9}","بالتعويض وخصائص اللوغاريتمات"]],"a":"<span class=\"tx\" data-t=\"\\ln\\frac{98}{9}\\approx 2.388\"></span>","o":""},{"n":"24","s":[["x^3-4x^2+4x=x(x-2)^2","تحليل المقام"],["\\frac{4}{x(x-2)^2}=\\frac{A}{x}+\\frac{B}{x-2}+\\frac{C}{(x-2)^2}","تجزئة الكسر"],["x=0:\\ A=1;\\ \\ x=2:\\ 4=2C\\Rightarrow C=2;\\ \\ x^2:\\ 0=A+B\\Rightarrow B=-1","بالتعويض في <span class=\"tx\" data-t=\"4=A(x-2)^2+Bx(x-2)+Cx\"></span>"],["\\left[\\ln x-\\ln(x-2)-\\frac{2}{x-2}\\right]_3^4=(\\ln4-\\ln2-1)-(\\ln3-0-2)",""],["=1+\\ln2-\\ln3=1+\\ln\\frac23","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"1+\\ln\\frac23\\approx 0.595\"></span>","o":""}],[{"n":"25","s":[["A=\\int_0^1\\frac{1}{x^2-5x+6}\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[0,1]\"></span>"],["\\frac{1}{(x-2)(x-3)}=\\frac{-1}{x-2}+\\frac{1}{x-3}","تجزئة الكسر (بالتعويض بـ <span class=\"tx\" data-t=\"x=2,\\,3\"></span>)"],["A=\\left[\\ln|x-3|-\\ln|x-2|\\right]_0^1=\\left[\\ln\\left|\\frac{x-3}{x-2}\\right|\\right]_0^1",""],["=\\ln2-\\ln\\frac32=\\ln\\frac43","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\ln\\frac43\\approx 0.288\"></span> وحدة مربعة","o":""},{"n":"26","s":[["A=\\int_1^2\\frac{x^2+1}{3x-x^2}\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[1,2]\"></span>"],["\\frac{x^2+1}{3x-x^2}=-1+\\frac{3x+1}{x(3-x)}","بالقسمة (درجة البسط <span class=m dir=ltr>=</span> درجة المقام)"],["\\frac{3x+1}{x(3-x)}=\\frac{1/3}{x}+\\frac{10/3}{3-x}","بالتعويض بـ <span class=\"tx\" data-t=\"x=0\"></span> و <span class=\"tx\" data-t=\"x=3\"></span> في <span class=\"tx\" data-t=\"3x+1=A(3-x)+Bx\"></span>"],["A=\\left[-x+\\frac13\\ln x-\\frac{10}{3}\\ln(3-x)\\right]_1^2",""],["=\\left(-2+\\tfrac13\\ln2-0\\right)-\\left(-1+0-\\tfrac{10}{3}\\ln2\\right)=-1+\\tfrac{11}{3}\\ln2","بالتعويض بحدّي التكامل"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{11}{3}\\ln2-1\\approx 1.542\"></span> وحدة مربعة","o":""}],[{"n":"27","s":[["f(x)=0\\Rightarrow 2x-5=0","النقطة <span class=\"tx\" data-t=\"A\"></span> نقطة تقاطع المنحنى مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["x=\\frac52","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"A\\left(\\frac52,\\,0\\right)\"></span>","o":""},{"n":"28","s":[["A=\\int_0^{5/2}\\frac{2x-5}{(x-3)(x+1)}\\,dx","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[0,\\frac52]\"></span>"],["\\frac{2x-5}{(x-3)(x+1)}=\\frac{1/4}{x-3}+\\frac{7/4}{x+1}","بالتعويض بـ <span class=\"tx\" data-t=\"x=3\"></span> و <span class=\"tx\" data-t=\"x=-1\"></span> في <span class=\"tx\" data-t=\"2x-5=A(x+1)+B(x-3)\"></span>"],["A=\\left[\\frac14\\ln|x-3|+\\frac74\\ln|x+1|\\right]_0^{5/2}",""],["=\\left(\\tfrac14\\ln\\tfrac12+\\tfrac74\\ln\\tfrac72\\right)-\\left(\\tfrac14\\ln3+0\\right)","بالتعويض بحدّي التكامل"],["=\\frac74\\ln\\frac72-\\frac14\\ln6","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac74\\ln\\frac72-\\frac14\\ln6\\approx 1.744\"></span> وحدة مربعة","o":""}],[{"n":"29","s":[["u=\\cos x\\Rightarrow du=-\\sin x\\,dx","بالتعويض"],["\\int\\frac{\\sin x}{\\cos x+\\cos^2x}dx=-\\int\\frac{du}{u(1+u)}",""],["\\frac{1}{u(1+u)}=\\frac{1}{u}-\\frac{1}{1+u}","تجزئة الكسر"],["-\\int\\left(\\frac1u-\\frac{1}{1+u}\\right)du=-\\ln|u|+\\ln|1+u|+C",""],["=\\ln\\left|\\frac{1+\\cos x}{\\cos x}\\right|+C","بإرجاع <span class=\"tx\" data-t=\"u=\\cos x\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\dfrac{1+\\cos x}{\\cos x}\\right|+C=\\ln|1+\\cos x|-\\ln|\\cos x|+C\"></span>","o":""},{"n":"30","s":[["u=\\sqrt{x}\\Rightarrow x=u^2,\\ dx=2u\\,du","بالتعويض"],["\\int\\frac{dx}{x^2+x\\sqrt x}=\\int\\frac{2u\\,du}{u^4+u^3}=\\int\\frac{2}{u^2(u+1)}du",""],["\\frac{2}{u^2(u+1)}=\\frac{-2}{u}+\\frac{2}{u^2}+\\frac{2}{u+1}","تجزئة الكسر: <span class=\"tx\" data-t=\"u=0\\Rightarrow B=2\"></span>، <span class=\"tx\" data-t=\"u=-1\\Rightarrow C=2\"></span>، معامل <span class=\"tx\" data-t=\"u^2\"></span>: <span class=\"tx\" data-t=\"A+C=0\"></span>"],["=-2\\ln u-\\frac{2}{u}+2\\ln(u+1)+C",""],["=2\\ln\\frac{\\sqrt x+1}{\\sqrt x}-\\frac{2}{\\sqrt x}+C","بإرجاع <span class=\"tx\" data-t=\"u=\\sqrt x\"></span>"]],"a":"<span class=\"tx\" data-t=\"2\\ln\\left(\\dfrac{\\sqrt x+1}{\\sqrt x}\\right)-\\dfrac{2}{\\sqrt x}+C\"></span>","o":""},{"n":"31","s":[["u=e^x\\Rightarrow du=e^x\\,dx","بالتعويض"],["\\int\\frac{e^{2x}}{e^{2x}+3e^x+2}dx=\\int\\frac{u\\,du}{(u+1)(u+2)}","لأنّ <span class=\"tx\" data-t=\"e^{2x}dx=u\\,du\"></span>"],["\\frac{u}{(u+1)(u+2)}=\\frac{-1}{u+1}+\\frac{2}{u+2}","تجزئة الكسر (بالتعويض بـ <span class=\"tx\" data-t=\"u=-1,\\,-2\"></span>)"],["=-\\ln|u+1|+2\\ln|u+2|+C",""]],"a":"<span class=\"tx\" data-t=\"2\\ln(e^x+2)-\\ln(e^x+1)+C\"></span>","o":""},{"n":"32","s":[["u=\\sin x\\Rightarrow du=\\cos x\\,dx","بالتعويض"],["\\int\\frac{du}{u(u^2-4)}=\\int\\frac{du}{u(u-2)(u+2)}",""],["\\frac{1}{u(u-2)(u+2)}=\\frac{-1/4}{u}+\\frac{1/8}{u-2}+\\frac{1/8}{u+2}","تجزئة الكسر (بالتعويض بـ <span class=\"tx\" data-t=\"u=0,\\,2,\\,-2\"></span>)"],["=-\\frac14\\ln|u|+\\frac18\\ln|u-2|+\\frac18\\ln|u+2|+C",""],["=-\\frac14\\ln|\\sin x|+\\frac18\\ln(4-\\sin^2x)+C","بإرجاع <span class=\"tx\" data-t=\"u=\\sin x\"></span> ودمج اللوغاريتمين"]],"a":"<span class=\"tx\" data-t=\"-\\frac14\\ln|\\sin x|+\\frac18\\ln|\\sin x-2|+\\frac18\\ln|\\sin x+2|+C\"></span>","o":""}],[{"n":"33","s":[["\\int\\frac{dx}{1+e^x}=\\int\\frac{e^{-x}}{e^{-x}+1}dx=-\\ln(1+e^{-x})+C","الطريقة الأولى: بضرب البسط والمقام في <span class=\"tx\" data-t=\"e^{-x}\"></span>، البسط سالب مشتقة المقام"],["u=e^x\\Rightarrow dx=\\frac{du}{u}:\\ \\int\\frac{du}{u(1+u)}","الطريقة الثانية: بالتعويض"],["\\frac{1}{u(1+u)}=\\frac1u-\\frac{1}{1+u}\\Rightarrow \\ln u-\\ln(1+u)+C=x-\\ln(1+e^x)+C","بالكسور الجزئية"],["-\\ln(1+e^{-x})=-\\ln\\frac{e^x+1}{e^x}=-\\ln(1+e^x)+\\ln e^x=x-\\ln(1+e^x)","التبرير: الناتجان متساويان"]],"a":"<span class=\"tx\" data-t=\"\\int\\frac{dx}{1+e^x}=x-\\ln(1+e^x)+C=-\\ln(1+e^{-x})+C\"></span>","o":"التبرير: بخصائص اللوغاريتمات يتحول ناتج الطريقة الأولى إلى ناتج الطريقة الثانية، أو باشتقاق الناتج نحصل على <span class=\"tx\" data-t=\"\\frac{1}{1+e^x}\"></span>."},{"n":"34","s":[["\\int_0^{\\ln2}\\frac{dx}{1+e^x}=\\left[x-\\ln(1+e^x)\\right]_0^{\\ln2}","من السؤال السابق"],["=(\\ln2-\\ln3)-(0-\\ln2)","بالتعويض بحدّي التكامل"],["=2\\ln2-\\ln3=\\ln\\frac43","بخصائص اللوغاريتمات"]],"a":"<span class=\"tx\" data-t=\"\\ln\\frac43\\approx 0.288\"></span>","o":""}],[{"n":"35","s":[["\\frac{5x^2-8x+1}{x(x-1)^2}=\\frac{A}{x}+\\frac{B}{x-1}+\\frac{C}{(x-1)^2}","تجزئة الكسر (العامل <span class=\"tx\" data-t=\"\\frac12\"></span> خارج التكامل)"],["x=0:\\ A=1;\\ \\ x=1:\\ C=-2;\\ \\ x^2:\\ 5=A+B\\Rightarrow B=4","بالتعويض ومساواة المعاملات"],["\\frac12\\int_4^9\\left(\\frac1x+\\frac{4}{x-1}-\\frac{2}{(x-1)^2}\\right)dx=\\left[\\frac12\\ln x+2\\ln(x-1)+\\frac{1}{x-1}\\right]_4^9",""],["=\\left(\\ln3+6\\ln2+\\tfrac18\\right)-\\left(\\ln2+2\\ln3+\\tfrac13\\right)","بالتعويض: <span class=\"tx\" data-t=\"\\frac12\\ln9=\\ln3\"></span>، <span class=\"tx\" data-t=\"2\\ln8=6\\ln2\"></span>"],["=5\\ln2-\\ln3-\\frac{5}{24}=\\ln\\frac{32}{3}-\\frac{5}{24}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\int_4^9\\frac{5x^2-8x+1}{2x(x-1)^2}dx=\\ln\\left(\\frac{32}{3}\\right)-\\frac{5}{24}\"></span> (تمّ الإثبات)","o":""}],[{"n":"36","s":[["u=\\sqrt x\\Rightarrow x=u^2,\\ dx=2u\\,du;\\quad x=9\\to u=3,\\ x=16\\to u=4","بالتعويض وتغيير الحدود"],["\\int_3^4\\frac{2u\\cdot2u}{u^2-4}du=\\int_3^4\\left(4+\\frac{16}{u^2-4}\\right)du","بالقسمة"],["\\frac{16}{(u-2)(u+2)}=\\frac{4}{u-2}-\\frac{4}{u+2}","تجزئة الكسر"],["\\left[4u+4\\ln(u-2)-4\\ln(u+2)\\right]_3^4=(16+4\\ln2-4\\ln6)-(12+0-4\\ln5)","بالتعويض بحدّي التكامل"],["=4+4\\ln\\frac{2\\times5}{6}=4\\left(1+\\ln\\frac53\\right)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\int_9^{16}\\frac{2\\sqrt x}{x-4}dx=4\\left(1+\\ln\\frac53\\right)\"></span> (تمّ الإثبات)","o":""}],[{"n":"37","s":[["\\frac{4x^2+9x+4}{2x^2+5x+3}=2+\\frac{-x-2}{(2x+3)(x+1)}","بالقسمة وتحليل المقام"],["\\frac{-x-2}{(2x+3)(x+1)}=\\frac{1}{2x+3}-\\frac{1}{x+1}","تجزئة الكسر (بالتعويض بـ <span class=\"tx\" data-t=\"x=-\\frac32,\\,-1\"></span>)"],["\\int_0^1\\left(2+\\frac{1}{2x+3}-\\frac{1}{x+1}\\right)dx=\\left[2x+\\frac12\\ln(2x+3)-\\ln(x+1)\\right]_0^1",""],["=\\left(2+\\tfrac12\\ln5-\\ln2\\right)-\\tfrac12\\ln3","بالتعويض بحدّي التكامل"],["=2+\\frac12\\left(\\ln5-\\ln4-\\ln3\\right)=2+\\frac12\\ln\\frac{5}{12}","لأنّ <span class=\"tx\" data-t=\"\\ln2=\\frac12\\ln4\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\int_0^1\\frac{4x^2+9x+4}{2x^2+5x+3}dx=2+\\frac12\\ln\\frac{5}{12}\"></span> (تمّ الإثبات)","o":""}],[{"n":"38","s":[["u=\\sqrt{1+\\sqrt x}\\Rightarrow \\sqrt x=u^2-1,\\ x=(u^2-1)^2","بالتعويض"],["dx=4u(u^2-1)\\,du","باشتقاق <span class=\"tx\" data-t=\"x\"></span> بالنسبة إلى <span class=\"tx\" data-t=\"u\"></span>"],["\\int\\frac{u}{(u^2-1)^2}\\cdot4u(u^2-1)\\,du=\\int\\frac{4u^2}{u^2-1}du=\\int\\left(4+\\frac{4}{u^2-1}\\right)du","بالتبسيط ثم القسمة"],["\\frac{4}{(u-1)(u+1)}=\\frac{2}{u-1}-\\frac{2}{u+1}","تجزئة الكسر"],["=4u+2\\ln\\left|\\frac{u-1}{u+1}\\right|+C",""]],"a":"<span class=\"tx\" data-t=\"4\\sqrt{1+\\sqrt x}+2\\ln\\left|\\dfrac{\\sqrt{1+\\sqrt x}-1}{\\sqrt{1+\\sqrt x}+1}\\right|+C\"></span>","o":""},{"n":"39","s":[["u=x^2\\Rightarrow du=2x\\,dx","بالتعويض"],["\\int\\frac{x}{16x^4-1}dx=\\frac12\\int\\frac{du}{(4u-1)(4u+1)}",""],["\\frac{1}{(4u-1)(4u+1)}=\\frac{1/2}{4u-1}-\\frac{1/2}{4u+1}","تجزئة الكسر"],["=\\frac12\\cdot\\frac12\\cdot\\frac14\\left(\\ln|4u-1|-\\ln|4u+1|\\right)+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{16}\\ln\\left|\\dfrac{4x^2-1}{4x^2+1}\\right|+C\"></span>","o":""},{"n":"40","s":[["u=x^2\\Rightarrow du=2x\\,dx","بالتعويض"],["\\int\\frac{du}{(u+1)(u+2)^2}=\\int\\left(\\frac{A}{u+1}+\\frac{B}{u+2}+\\frac{C}{(u+2)^2}\\right)du","تجزئة الكسر"],["u=-1:\\ A=1;\\ \\ u=-2:\\ C=-1;\\ \\ u^2:\\ 0=A+B\\Rightarrow B=-1","بالتعويض في <span class=\"tx\" data-t=\"1=A(u+2)^2+B(u+1)(u+2)+C(u+1)\"></span>"],["=\\ln|u+1|-\\ln|u+2|+\\frac{1}{u+2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln\\left(\\dfrac{x^2+1}{x^2+2}\\right)+\\dfrac{1}{x^2+2}+C\"></span>","o":""}],[{"n":"16","s":[["\\frac{4}{(x-2)(x+2)}=\\frac{A}{x-2}+\\frac{B}{x+2} \\Rightarrow 4=A(x+2)+B(x-2)","بالكسور الجزئية"],["x=2: A=1,\\quad x=-2: B=-1",""],["\\int\\left(\\frac{1}{x-2}-\\frac{1}{x+2}\\right)dx=\\ln|x-2|-\\ln|x+2|+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{x-2}{x+2}\\right|+C\"></span>","o":""},{"n":"17","s":[["\\frac{x+7}{(x-3)(x+2)}=\\frac{A}{x-3}+\\frac{B}{x+2} \\Rightarrow x+7=A(x+2)+B(x-3)","بالكسور الجزئية"],["x=3: 10=5A \\Rightarrow A=2,\\quad x=-2: 5=-5B \\Rightarrow B=-1",""],["\\int\\left(\\frac{2}{x-3}-\\frac{1}{x+2}\\right)dx=2\\ln|x-3|-\\ln|x+2|+C",""]],"a":"<span class=\"tx\" data-t=\"2\\ln|x-3|-\\ln|x+2|+C\"></span>","o":""},{"n":"18","s":[["\\frac{x-1}{(x-4)(x+2)}=\\frac{A}{x-4}+\\frac{B}{x+2} \\Rightarrow x-1=A(x+2)+B(x-4)","بالكسور الجزئية"],["x=4: 3=6A \\Rightarrow A=\\frac{1}{2},\\quad x=-2: -3=-6B \\Rightarrow B=\\frac{1}{2}",""],["\\int\\left(\\frac{1/2}{x-4}+\\frac{1/2}{x+2}\\right)dx=\\frac{1}{2}\\ln|x-4|+\\frac{1}{2}\\ln|x+2|+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\ln|x-4|+\\frac{1}{2}\\ln|x+2|+C\"></span>","o":""},{"n":"19","s":[["\\frac{x^2+3}{x(x^2+1)}=\\frac{A}{x}+\\frac{Bx+C}{x^2+1} \\Rightarrow x^2+3=A(x^2+1)+(Bx+C)x","عامل تربيعي غير قابل للتحليل"],["x=0: A=3;\\quad x^2: 1=A+B \\Rightarrow B=-2;\\quad x: C=0","بالتعويض ومقارنة المعاملات"],["\\int\\left(\\frac{3}{x}-\\frac{2x}{x^2+1}\\right)dx=3\\ln|x|-\\ln(x^2+1)+C",""]],"a":"<span class=\"tx\" data-t=\"3\\ln|x|-\\ln(x^2+1)+C\"></span>","o":""},{"n":"20","s":[["\\frac{1}{x^2(1-x)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{D}{1-x} \\Rightarrow 1=Ax(1-x)+B(1-x)+Dx^2","عامل خطي مكرر"],["x=0: B=1;\\quad x=1: D=1;\\quad x^2: 0=-A+D \\Rightarrow A=1",""],["\\int\\left(\\frac{1}{x}+\\frac{1}{x^2}+\\frac{1}{1-x}\\right)dx=\\ln|x|-\\frac{1}{x}-\\ln|1-x|+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln|x|-\\frac{1}{x}-\\ln|1-x|+C\"></span>","o":""},{"n":"21","s":[["u=\\cos x,\\ du=-\\sin x\\,dx","بالتعويض"],["\\int\\frac{\\sin x}{\\cos^2x-3\\cos x}\\,dx=-\\int\\frac{du}{u(u-3)}",""],["\\frac{1}{u(u-3)}=-\\frac{1/3}{u}+\\frac{1/3}{u-3}","بالكسور الجزئية"],["-\\int\\left(-\\frac{1/3}{u}+\\frac{1/3}{u-3}\\right)du=\\frac{1}{3}\\ln|u|-\\frac{1}{3}\\ln|u-3|+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\\ln|\\cos x|-\\frac{1}{3}\\ln|\\cos x-3|+C\"></span>","o":""},{"n":"22","s":[["u=\\sqrt{x},\\ x=u^2,\\ dx=2u\\,du","بالتعويض"],["\\int\\frac{u\\cdot 2u}{u^2-4}\\,du=\\int\\left(2+\\frac{8}{u^2-4}\\right)du","بالقسمة"],["\\frac{8}{(u-2)(u+2)}=\\frac{2}{u-2}-\\frac{2}{u+2}","بالكسور الجزئية"],["2u+2\\ln|u-2|-2\\ln|u+2|+C",""]],"a":"<span class=\"tx\" data-t=\"2\\sqrt{x}+2\\ln\\left|\\frac{\\sqrt{x}-2}{\\sqrt{x}+2}\\right|+C\"></span>","o":""}],[{"n":"33","s":[["\\frac{x^2-x}{x^2+x-2}=1+\\frac{-2x+2}{(x+2)(x-1)}=1-\\frac{2(x-1)}{(x+2)(x-1)}=1-\\frac{2}{x+2}","بالقسمة ثم التبسيط"],["\\int_{-1}^{0}\\left(1-\\frac{2}{x+2}\\right)dx=\\left[x-2\\ln|x+2|\\right]_{-1}^{0}",""],["=(0-2\\ln 2)-(-1-2\\ln 1)=1-2\\ln 2",""]],"a":"<span class=\"tx\" data-t=\"1-2\\ln 2\\approx -0.3863\"></span>","o":""}],[{"n":"34","s":[["\\frac{32x^2+4}{16x^2-1}=2+\\frac{6}{(4x-1)(4x+1)}","بالقسمة"],["\\frac{6}{(4x-1)(4x+1)}=\\frac{3}{4x-1}-\\frac{3}{4x+1}","بالكسور الجزئية"],["\\left[2x+\\frac{3}{4}\\ln|4x-1|-\\frac{3}{4}\\ln|4x+1|\\right]_1^2",""],["=2+\\frac{3}{4}(\\ln 7-\\ln 9-\\ln 3+\\ln 5)=2+\\frac{3}{4}\\ln\\frac{35}{27}","خصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"2+\\frac{3}{4}\\ln\\frac{35}{27}\\approx 2.1946\"></span>","o":""}],[{"n":"42","s":[["\\frac{x^2}{x^2-1}=1+\\frac{1}{x^2-1}=1+\\frac{1/2}{x-1}-\\frac{1/2}{x+1}","بالقسمة ثم الكسور الجزئية"],["\\int_2^5\\frac{x^2}{x^2-1}\\,dx=\\left[x+\\frac{1}{2}\\ln|x-1|-\\frac{1}{2}\\ln|x+1|\\right]_2^5",""],["=3+\\frac{1}{2}\\left[(\\ln 4-\\ln 6)-(\\ln 1-\\ln 3)\\right]",""],["=3+\\frac{1}{2}\\ln\\frac{4\\times 3}{6}=3+\\frac{1}{2}\\ln 2","خصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"\\int_2^5\\frac{x^2}{x^2-1}\\,dx=3+\\frac{1}{2}\\ln 2\"></span> (تم الإثبات)","o":""}],[{"n":"1","s":[["\\frac{4}{x(x+4)}=\\frac{A}{x}+\\frac{B}{x+4}\\Rightarrow4=A(x+4)+Bx","بتحليل المقام والكسور الجزئية"],["x=0\\Rightarrow A=1,\\quad x=-4\\Rightarrow B=-1","بالتعويض"],["\\int\\left(\\frac{1}{x}-\\frac{1}{x+4}\\right)dx=\\ln|x|-\\ln|x+4|+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{x}{x+4}\\right|+C\"></span>","o":""},{"n":"2","s":[["\\frac{6}{(x-3)(x+3)}=\\frac{A}{x-3}+\\frac{B}{x+3}\\Rightarrow6=A(x+3)+B(x-3)","الكسور الجزئية"],["x=3\\Rightarrow A=1,\\quad x=-3\\Rightarrow B=-1","بالتعويض"],["\\int\\left(\\frac{1}{x-3}-\\frac{1}{x+3}\\right)dx=\\ln|x-3|-\\ln|x+3|+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{x-3}{x+3}\\right|+C\"></span>","o":""},{"n":"3","s":[["x^3-3x-2=(x-2)(x+1)^2","بالتحليل (<span class=\"tx\" data-t=\"x=2\"></span> صفر للمقام)"],["\\frac{x^2-3x+8}{(x-2)(x+1)^2}=\\frac{A}{x-2}+\\frac{B}{x+1}+\\frac{C}{(x+1)^2}","الكسور الجزئية (عامل مكرر)"],["x^2-3x+8=A(x+1)^2+B(x-2)(x+1)+C(x-2)","بضرب الطرفين في المقام"],["x=2\\Rightarrow A=\\frac{2}{3};\\ x=-1\\Rightarrow C=-4;\\ \\text{معامل }x^2:\\ A+B=1\\Rightarrow B=\\frac{1}{3}","بالتعويض ومقارنة المعاملات"],["\\int(\\ldots)dx=\\frac{2}{3}\\ln|x-2|+\\frac{1}{3}\\ln|x+1|+\\frac{4}{x+1}+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\\ln|x-2|+\\frac{1}{3}\\ln|x+1|+\\frac{4}{x+1}+C\"></span>","o":""},{"n":"4","s":[["\\frac{x-10}{(x-4)(x+2)}=\\frac{A}{x-4}+\\frac{B}{x+2}\\Rightarrow x-10=A(x+2)+B(x-4)","الكسور الجزئية"],["x=4\\Rightarrow A=-1,\\quad x=-2\\Rightarrow B=2","بالتعويض"],["\\int\\left(\\frac{-1}{x-4}+\\frac{2}{x+2}\\right)dx=-\\ln|x-4|+2\\ln|x+2|+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"2\\ln|x+2|-\\ln|x-4|+C\"></span>","o":""},{"n":"5","s":[["\\frac{2x^2+6x-2}{2x^2+x-1}=1+\\frac{5x-1}{(2x-1)(x+1)}","بالقسمة الطويلة (درجة البسط <span class=m dir=ltr>=</span> درجة المقام)"],["\\frac{5x-1}{(2x-1)(x+1)}=\\frac{A}{2x-1}+\\frac{B}{x+1}\\Rightarrow5x-1=A(x+1)+B(2x-1)","الكسور الجزئية"],["x=\\frac{1}{2}\\Rightarrow A=1,\\quad x=-1\\Rightarrow B=2","بالتعويض"],["\\int\\left(1+\\frac{1}{2x-1}+\\frac{2}{x+1}\\right)dx=x+\\frac{1}{2}\\ln|2x-1|+2\\ln|x+1|+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"x+\\frac{1}{2}\\ln|2x-1|+2\\ln|x+1|+C\"></span>","o":""},{"n":"6","s":[["\\frac{2x^2-x+6}{(x^2+2)(x+1)}=\\frac{A}{x+1}+\\frac{Bx+C}{x^2+2}","الكسور الجزئية (عامل تربيعي غير قابل للتحليل)"],["2x^2-x+6=A(x^2+2)+(Bx+C)(x+1)","بضرب الطرفين في المقام"],["x=-1\\Rightarrow9=3A\\Rightarrow A=3;\\ x^2:\\ A+B=2\\Rightarrow B=-1;\\ \\text{الثابت}:\\ 2A+C=6\\Rightarrow C=0","بالتعويض ومقارنة المعاملات"],["\\int\\left(\\frac{3}{x+1}-\\frac{x}{x^2+2}\\right)dx=3\\ln|x+1|-\\frac{1}{2}\\ln(x^2+2)+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"3\\ln|x+1|-\\frac{1}{2}\\ln(x^2+2)+C\"></span>","o":""},{"n":"7","s":[["\\frac{8x+24}{(x+1)(x-3)^2}=\\frac{A}{x+1}+\\frac{B}{x-3}+\\frac{C}{(x-3)^2}","الكسور الجزئية (عامل مكرر)"],["8x+24=A(x-3)^2+B(x+1)(x-3)+C(x+1)","بضرب الطرفين في المقام"],["x=-1\\Rightarrow16=16A\\Rightarrow A=1;\\ x=3\\Rightarrow48=4C\\Rightarrow C=12;\\ x^2:\\ A+B=0\\Rightarrow B=-1","بالتعويض ومقارنة المعاملات"],["\\int(\\ldots)dx=\\ln|x+1|-\\ln|x-3|-\\frac{12}{x-3}+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{x+1}{x-3}\\right|-\\frac{12}{x-3}+C\"></span>","o":""},{"n":"8","s":[["x^3+x^2-x-1=x^2(x+1)-(x+1)=(x-1)(x+1)^2","بالتحليل بالتجميع"],["\\frac{8x}{(x-1)(x+1)^2}=\\frac{A}{x-1}+\\frac{B}{x+1}+\\frac{C}{(x+1)^2}","الكسور الجزئية"],["8x=A(x+1)^2+B(x-1)(x+1)+C(x-1)","بضرب الطرفين في المقام"],["x=1\\Rightarrow A=2;\\ x=-1\\Rightarrow C=4;\\ x^2:\\ A+B=0\\Rightarrow B=-2","بالتعويض ومقارنة المعاملات"],["\\int(\\ldots)dx=2\\ln|x-1|-2\\ln|x+1|-\\frac{4}{x+1}+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"2\\ln\\left|\\frac{x-1}{x+1}\\right|-\\frac{4}{x+1}+C\"></span>","o":""},{"n":"9","s":[["\\frac{4}{x^2(x-2)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{C}{x-2}","الكسور الجزئية (عامل مكرر)"],["4=Ax(x-2)+B(x-2)+Cx^2","بضرب الطرفين في المقام"],["x=0\\Rightarrow B=-2;\\ x=2\\Rightarrow C=1;\\ x^2:\\ A+C=0\\Rightarrow A=-1","بالتعويض ومقارنة المعاملات"],["\\int\\left(-\\frac{1}{x}-\\frac{2}{x^2}+\\frac{1}{x-2}\\right)dx=-\\ln|x|+\\frac{2}{x}+\\ln|x-2|+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{x-2}{x}\\right|+\\frac{2}{x}+C\"></span>","o":""}],[{"n":"10","s":[["\\frac{x-1}{x^2(x+1)}=\\frac{A}{x}+\\frac{B}{x^2}+\\frac{C}{x+1}\\Rightarrow x-1=Ax(x+1)+B(x+1)+Cx^2","الكسور الجزئية"],["x=0\\Rightarrow B=-1;\\ x=-1\\Rightarrow C=-2;\\ x^2:\\ A+C=0\\Rightarrow A=2","بالتعويض ومقارنة المعاملات"],["\\int_1^5\\left(\\frac{2}{x}-\\frac{1}{x^2}-\\frac{2}{x+1}\\right)dx=\\left.\\left(2\\ln x+\\frac{1}{x}-2\\ln(x+1)\\right)\\right|_1^5","بالتكامل"],["=\\left(2\\ln5+\\frac{1}{5}-2\\ln6\\right)-(0+1-2\\ln2)=2\\ln\\frac{5}{3}-\\frac{4}{5}","بالتعويض وخصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"2\\ln\\frac{5}{3}-\\frac{4}{5}=\\ln\\frac{25}{9}-\\frac{4}{5}\\approx0.2217\"></span>","o":""},{"n":"11","s":[["\\frac{4-x}{(x-2)^2}=\\frac{A}{x-2}+\\frac{B}{(x-2)^2}\\Rightarrow4-x=A(x-2)+B","الكسور الجزئية"],["x=2\\Rightarrow B=2;\\ \\text{معامل }x:\\ A=-1","بالتعويض ومقارنة المعاملات"],["\\int_7^{12}\\left(\\frac{-1}{x-2}+\\frac{2}{(x-2)^2}\\right)dx=\\left.\\left(-\\ln(x-2)-\\frac{2}{x-2}\\right)\\right|_7^{12}","بالتكامل"],["=\\left(-\\ln10-\\frac{1}{5}\\right)-\\left(-\\ln5-\\frac{2}{5}\\right)=\\frac{1}{5}-\\ln2","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}-\\ln2\\approx-0.4931\"></span>","o":""},{"n":"12","s":[["\\frac{4}{(x+3)(x+5)}=\\frac{A}{x+3}+\\frac{B}{x+5}\\Rightarrow4=A(x+5)+B(x+3)","الكسور الجزئية"],["x=-3\\Rightarrow A=2,\\quad x=-5\\Rightarrow B=-2","بالتعويض"],["\\int_1^2\\left(\\frac{2}{x+3}-\\frac{2}{x+5}\\right)dx=\\left.2\\ln\\frac{x+3}{x+5}\\right|_1^2","بالتكامل"],["=2\\ln\\frac{5}{7}-2\\ln\\frac{4}{6}=2\\ln\\frac{15}{14}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"2\\ln\\frac{15}{14}=\\ln\\frac{225}{196}\\approx0.1380\"></span>","o":""},{"n":"13","s":[["\\frac{10x^2-26x+10}{2x^2-5x}=5+\\frac{-x+10}{x(2x-5)}","بالقسمة الطويلة"],["\\frac{-x+10}{x(2x-5)}=\\frac{A}{x}+\\frac{B}{2x-5}\\Rightarrow-x+10=A(2x-5)+Bx","الكسور الجزئية"],["x=0\\Rightarrow A=-2,\\quad x=\\frac{5}{2}\\Rightarrow B=3","بالتعويض"],["\\int_1^2\\left(5-\\frac{2}{x}+\\frac{3}{2x-5}\\right)dx=\\left.\\left(5x-2\\ln|x|+\\frac{3}{2}\\ln|2x-5|\\right)\\right|_1^2","بالتكامل"],["=(10-2\\ln2+0)-\\left(5-0+\\frac{3}{2}\\ln3\\right)=5-2\\ln2-\\frac{3}{2}\\ln3","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"5-2\\ln2-\\frac{3}{2}\\ln3\\approx1.9658\"></span>","o":""},{"n":"14","s":[["\\frac{25}{(x+1)(2x-3)^2}=\\frac{A}{x+1}+\\frac{B}{2x-3}+\\frac{C}{(2x-3)^2}","الكسور الجزئية"],["25=A(2x-3)^2+B(x+1)(2x-3)+C(x+1)","بضرب الطرفين في المقام"],["x=-1\\Rightarrow A=1;\\ x=\\frac{3}{2}\\Rightarrow C=10;\\ x^2:\\ 4A+2B=0\\Rightarrow B=-2","بالتعويض ومقارنة المعاملات"],["\\int_2^5(\\ldots)dx=\\left.\\left(\\ln|x+1|-\\ln|2x-3|-\\frac{5}{2x-3}\\right)\\right|_2^5","بالتكامل"],["=\\left(\\ln6-\\ln7-\\frac{5}{7}\\right)-(\\ln3-0-5)=\\ln\\frac{2}{7}+\\frac{30}{7}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\ln\\frac{2}{7}+\\frac{30}{7}\\approx3.0330\"></span>","o":""},{"n":"15","s":[["\\frac{x^2-3x+10}{x^2-x-6}=1+\\frac{-2x+16}{(x-3)(x+2)}","بالقسمة الطويلة"],["\\frac{-2x+16}{(x-3)(x+2)}=\\frac{A}{x-3}+\\frac{B}{x+2}\\Rightarrow-2x+16=A(x+2)+B(x-3)","الكسور الجزئية"],["x=3\\Rightarrow A=2,\\quad x=-2\\Rightarrow B=-4","بالتعويض"],["\\int_0^2\\left(1+\\frac{2}{x-3}-\\frac{4}{x+2}\\right)dx=\\left.\\left(x+2\\ln|x-3|-4\\ln|x+2|\\right)\\right|_0^2","بالتكامل"],["=(2+0-4\\ln4)-(0+2\\ln3-4\\ln2)=2-4\\ln2-2\\ln3=2-\\ln144","بالتعويض وخصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"2-\\ln144\\approx-2.9698\"></span>","o":""}],[{"n":"16","s":[["\\frac{4x+3}{(x+2)(2x-1)}=\\frac{A}{x+2}+\\frac{B}{2x-1}\\Rightarrow4x+3=A(2x-1)+B(x+2)","الكسور الجزئية"],["x=-2\\Rightarrow A=1,\\quad x=\\frac{1}{2}\\Rightarrow B=2","بالتعويض"],["A=\\int_1^2\\left(\\frac{1}{x+2}+\\frac{2}{2x-1}\\right)dx=\\left.\\left(\\ln|x+2|+\\ln|2x-1|\\right)\\right|_1^2","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[1,2]\"></span>"],["=(\\ln4+\\ln3)-(\\ln3+0)=\\ln4","بالتعويض"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\ln4=2\\ln2\\approx1.386\"></span> وحدة مربعة","o":""},{"n":"17","s":[["f(x)=\\frac{x^3+3x^2-7x}{4(x+2)(x-1)^2}=\\frac{1}{4}+\\frac{1}{2(x+2)}+\\frac{1}{4(x-1)}-\\frac{1}{4(x-1)^2}","بالقسمة الطويلة ثم الكسور الجزئية"],["\\text{(حيث }\\ \\tfrac{3x^2-4x-2}{4(x+2)(x-1)^2}=\\tfrac{A}{x+2}+\\tfrac{B}{x-1}+\\tfrac{C}{(x-1)^2}:\\ A=\\tfrac{1}{2},\\ B=\\tfrac{1}{4},\\ C=-\\tfrac{1}{4})","بالتعويض ومقارنة المعاملات"],["A=\\int_2^3f(x)dx=\\left.\\left(\\frac{x}{4}+\\frac{1}{2}\\ln|x+2|+\\frac{1}{4}\\ln|x-1|+\\frac{1}{4(x-1)}\\right)\\right|_2^3","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[2,3]\"></span>"],["=\\left(\\frac{3}{4}+\\frac{1}{2}\\ln5+\\frac{1}{4}\\ln2+\\frac{1}{8}\\right)-\\left(\\frac{1}{2}+\\frac{1}{2}\\ln4+0+\\frac{1}{4}\\right)","بالتعويض"],["=\\frac{1}{8}+\\frac{1}{2}\\ln5-\\frac{3}{4}\\ln2","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{1}{8}+\\frac{1}{2}\\ln5-\\frac{3}{4}\\ln2\\approx0.410\"></span> وحدة مربعة","o":""}],[{"n":"18","s":[["u=e^x\\Rightarrow du=e^xdx\\Rightarrow dx=\\frac{du}{u}","بفرض التعويض"],["\\int\\frac{u^2+u}{(u^2+1)(u-1)}\\cdot\\frac{du}{u}=\\int\\frac{u+1}{(u^2+1)(u-1)}du","بالتعويض والاختصار"],["\\frac{u+1}{(u-1)(u^2+1)}=\\frac{A}{u-1}+\\frac{Bu+C}{u^2+1}:\\ A=1,\\ B=-1,\\ C=0","الكسور الجزئية"],["\\int\\left(\\frac{1}{u-1}-\\frac{u}{u^2+1}\\right)du=\\ln|u-1|-\\frac{1}{2}\\ln(u^2+1)+C","بالتكامل"],["=\\ln|e^x-1|-\\frac{1}{2}\\ln(e^{2x}+1)+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln|e^x-1|-\\frac{1}{2}\\ln(e^{2x}+1)+C\"></span>","o":""},{"n":"19","s":[["u=\\sin x\\Rightarrow du=\\cos x\\,dx","بفرض التعويض"],["\\int\\frac{5}{u^2+3u-4}du=\\int\\frac{5}{(u-1)(u+4)}du","بالتعويض والتحليل"],["\\frac{5}{(u-1)(u+4)}=\\frac{1}{u-1}-\\frac{1}{u+4}","الكسور الجزئية: <span class=\"tx\" data-t=\"A=1,\\ B=-1\"></span>"],["=\\ln|u-1|-\\ln|u+4|+C=\\ln\\left|\\frac{\\sin x-1}{\\sin x+4}\\right|+C","بالتكامل وإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{\\sin x-1}{\\sin x+4}\\right|+C\"></span>","o":""},{"n":"20","s":[["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx","بفرض التعويض"],["\\int\\frac{du}{u^2+5u+6}=\\int\\frac{du}{(u+2)(u+3)}","بالتعويض والتحليل"],["\\frac{1}{(u+2)(u+3)}=\\frac{1}{u+2}-\\frac{1}{u+3}","الكسور الجزئية: <span class=\"tx\" data-t=\"A=1,\\ B=-1\"></span>"],["=\\ln|u+2|-\\ln|u+3|+C=\\ln\\left|\\frac{\\tan x+2}{\\tan x+3}\\right|+C","بالتكامل وإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{\\tan x+2}{\\tan x+3}\\right|+C\"></span>","o":""}],[{"n":"21","s":[["\\frac{4x}{(x-3)(x+1)}=\\frac{A}{x-3}+\\frac{B}{x+1}\\Rightarrow4x=A(x+1)+B(x-3)","الكسور الجزئية"],["x=3\\Rightarrow A=3,\\quad x=-1\\Rightarrow B=1","بالتعويض"],["\\int_0^1\\left(\\frac{3}{x-3}+\\frac{1}{x+1}\\right)dx=\\left.\\left(3\\ln|x-3|+\\ln|x+1|\\right)\\right|_0^1","بالتكامل"],["=(3\\ln2+\\ln2)-(3\\ln3+0)=4\\ln2-3\\ln3","بالتعويض"],["=\\ln16-\\ln27=\\ln\\left(\\frac{16}{27}\\right)","خصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"\\int_0^1\\frac{4x}{x^2-2x-3}dx=\\ln\\left(\\frac{16}{27}\\right)\"></span> وهو المطلوب","o":""}],[{"n":"22","s":[["\\frac{1}{(2x-1)(x+1)}=\\frac{A}{2x-1}+\\frac{B}{x+1}\\Rightarrow1=A(x+1)+B(2x-1)","الكسور الجزئية"],["x=\\frac{1}{2}\\Rightarrow A=\\frac{2}{3},\\quad x=-1\\Rightarrow B=-\\frac{1}{3}","بالتعويض"],["\\int_1^p\\left(\\frac{2/3}{2x-1}-\\frac{1/3}{x+1}\\right)dx=\\left.\\frac{1}{3}\\ln\\frac{2x-1}{x+1}\\right|_1^p","بالتكامل (<span class=\"tx\" data-t=\"x&gt;1\"></span> فالمقادير موجبة)"],["=\\frac{1}{3}\\ln\\frac{2p-1}{p+1}-\\frac{1}{3}\\ln\\frac{1}{2}=\\frac{1}{3}\\ln\\left(\\frac{2p-1}{p+1}\\cdot2\\right)","بالتعويض وخصائص اللوغاريتم"],["=\\frac{1}{3}\\ln\\frac{4p-2}{p+1}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\int_1^p\\frac{1}{2x^2+x-1}dx=\\frac{1}{3}\\ln\\frac{4p-2}{p+1}\"></span> وهو المطلوب","o":""}]]