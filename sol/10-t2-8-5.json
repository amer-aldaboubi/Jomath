[[{"n":"1","s":[["n=5+3+2=10","عدد الكرات الكلي"],["P(R)=\\frac{5}{10},\\quad P(Y)=\\frac{2}{10}","السحب مع الإرجاع، فالحادثان مستقلان"],["P(R\\cap Y)=P(R)\\times P(Y)=\\frac{5}{10}\\times\\frac{2}{10}","احتمال وقوع حادثين مستقلين معًا"],["=\\frac{10}{100}=\\frac{1}{10}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{10} = 0.1\"></span>","o":"","k":[{"e":"0.1","a":true}]},{"n":"2","s":[["P(G_1\\cap G_2)=\\frac{3}{10}\\times\\frac{3}{10}","الحادثان مستقلان لأن السحب مع الإرجاع"],["=\\frac{9}{100}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{9}{100} = 0.09\"></span>","o":"","k":[{"e":"0.09","a":true}]}],[{"n":"3","s":[["\\text{تجربتان منفصلتان}","نتيجة سحب الكرة لا تؤثر في نتيجة إلقاء حجر النرد"]],"a":"مستقلان","o":""},{"n":"4","s":[["\\frac{k}{n}\\ \\to\\ \\frac{k}{n-1}","خروج الطالب الأول من الغرفة يُنقص عدد الطلبة، فيتغير احتمال اختيار الطالب الثاني"]],"a":"غير مستقلين؛ لأن الاختيار الأول تمّ من دون إرجاع (خرج الطالب من الغرفة) فأثّر في احتمال الاختيار الثاني","o":""},{"n":"5","s":[["\\frac{3}{6}\\times\\frac{3}{6}","نتيجة إلقاء الحجر الأول لا تؤثر في نتيجة إلقاء الحجر الآخر"]],"a":"مستقلان","o":""},{"n":"6","s":[["\\text{إصابة الأول لا تؤثر في إصابة الثاني}","كل صياد يطلق طلقته بشكل مستقل نحو هدف ثابت"]],"a":"مستقلان","o":""},{"n":"7","s":[["P(6)=\\frac{1}{10},\\quad P(\\text{زوجي})=\\frac{5}{10}","السحب مع الإرجاع، فلا يتغير عدد البطاقات ولا محتواها"]],"a":"مستقلان؛ لأن البطاقة الأولى أُعيدت قبل السحب الثاني","o":""}],[{"n":"8","s":[["\\text{الشجرة: } R_1:\\frac{2}{5},\\ B_1:\\frac{3}{5};\\ \\text{ثم } R_2|R_1:\\frac{1}{4},\\ B_2|R_1:\\frac{3}{4},\\ R_2|B_1:\\frac{2}{4},\\ B_2|B_1:\\frac{2}{4}","أرسم الشجرة الاحتمالية (السحب من دون إرجاع، المجموع <span class=m dir=ltr>5</span> أقلام)"],["P(R_1\\cap R_2)=\\frac{2}{5}\\times\\frac{1}{4}=\\frac{2}{20}","بضرب الاحتمالات على الفرع"],["=\\frac{1}{10}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{10} = 0.1\"></span>","o":"","k":[{"e":"0.1","a":true}]},{"n":"9","s":[["P(B_1\\cap B_2)=\\frac{3}{5}\\times\\frac{2}{4}=\\frac{6}{20}","بضرب الاحتمالات على الفرع"],["=\\frac{3}{10}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{10} = 0.3\"></span>","o":"","k":[{"e":"0.3","a":true}]},{"n":"10","s":[["P(R_1\\cap B_2)+P(B_1\\cap R_2)","قلم من كل لون: أحمر ثم أزرق، أو أزرق ثم أحمر"],["=\\frac{2}{5}\\times\\frac{3}{4}+\\frac{3}{5}\\times\\frac{2}{4}","بالتعويض من الشجرة"],["=\\frac{6}{20}+\\frac{6}{20}=\\frac{12}{20}=\\frac{3}{5}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5} = 0.6\"></span>","o":"","k":[{"e":"0.6","a":true}]}],[{"n":"11","s":[["P(N_1)=0.75,\\ P(N_2|N_1)=0.8,\\ P(\\overline{N_2}|\\overline{N_1})=0.6","<span class=m dir=ltr>N</span>: النجاح؛ أرسم الشجرة الاحتمالية"],["P(N_1\\cap N_2)=P(N_1)\\times P(N_2|N_1)","احتمال حادثين غير مستقلين"],["=0.75\\times 0.8=0.6","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"0.6\"></span> أي <span class=\"tx\" data-t=\"60\\%\"></span>","o":"","k":[{"e":"0.6","a":true},{"e":"60","a":null}]},{"n":"12","s":[["P(N_1\\cap\\overline{N_2})=0.75\\times 0.2=0.15","ينجح في الأول ويرسب في الثاني: <span class=m dir=ltr>1-0.8=0.2</span>"],["P(\\overline{N_1}\\cap N_2)=0.25\\times 0.4=0.1","يرسب في الأول وينجح في الثاني: <span class=m dir=ltr>1-0.75=0.25</span> و <span class=m dir=ltr>1-0.6=0.4</span>"],["0.15+0.1=0.25","الحادثان متنافيان، فأجمع الاحتمالين"]],"a":"<span class=\"tx\" data-t=\"0.25\"></span> أي <span class=\"tx\" data-t=\"25\\%\"></span>","o":"","k":[{"e":"0.25","a":true},{"e":"25","a":null}]}],[{"n":"13","s":[["n(B) = 33 + 22 = 55","عدد من لهم أخ (كل دائرة <span class=m dir=ltr>B)</span>"],["P(B) = \\frac{55}{100} = 0.55","قانون الاحتمال"]],"a":"<span class=\"tx\" data-t=\"P(B) = \\frac{11}{20} = 0.55\"></span>","o":"","k":[{"e":"0.55","a":true}]},{"n":"14","s":[["n(S) = 22 + 28 = 50","عدد من لهم أخت"],["n(B \\cap S) = 22","من لهم أخ وأخت"],["P(B \\mid S) = \\frac{n(B \\cap S)}{n(S)} = \\frac{22}{50}","الاحتمال المشروط"],["= \\frac{11}{25} = 0.44","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(B \\mid S) = \\frac{11}{25} = 0.44\"></span>","o":""},{"n":"15","s":[["P(S \\mid B) = \\frac{n(S \\cap B)}{n(B)} = \\frac{22}{55}","الاحتمال المشروط"],["= \\frac{2}{5} = 0.4","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"P(S \\mid B) = \\frac{2}{5} = 0.4\"></span>","o":""}],[{"n":"16","s":[["n(\\text{degree}) = 54 + 27 = 81","عدد من لديهم شهادة جامعية"],["n(\\text{exp} \\cap \\text{degree}) = 54","لديهم خبرة وشهادة"],["P(\\text{exp} \\mid \\text{degree}) = \\frac{54}{81} = \\frac{2}{3}","الاحتمال المشروط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3} \\approx 0.6667\"></span>","o":"","k":[{"e":"0.6667","a":true}]},{"n":"17","s":[["n(\\text{exp}) = 54 + 5 = 59","عدد من لديهم خبرة سابقة"],["n(\\overline{\\text{degree}} \\cap \\text{exp}) = 5","لديهم خبرة وليس لديهم شهادة"],["P = \\frac{5}{59} \\approx 0.0847","الاحتمال المشروط"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{59} \\approx 0.0847\"></span>","o":"","k":[{"e":"0.0847","a":true}]}],[{"n":"18","s":[["P(R_1) = 1 - 0.3 = 0.7","احتمال الحادث المتممة"],["P(R_2 \\mid R_1) = 0.8","من المعطيات"],["P(R_1 \\cap R_2) = 0.7 \\times 0.8 = 0.56","ضرب الاحتمالات على فرعي الشجرة"]],"a":"<span class=\"tx\" data-t=\"0.56\"></span>","o":"الشجرة: الإشارة الأولى <span class=m dir=ltr>G (0.3)</span> و <span class=m dir=ltr>R (0.7)</span>؛ بعد <span class=m dir=ltr>R</span>: <span class=m dir=ltr>R (0.8)</span> و <span class=m dir=ltr>G (0.2)</span>؛ بعد <span class=m dir=ltr>G</span>: <span class=m dir=ltr>R (0.4)</span> و <span class=m dir=ltr>G (0.6)</span>.","k":[{"e":"0.56","a":true}]},{"n":"19","s":[["P(G_2 \\mid G_1) = 1 - 0.4 = 0.6","المتممة"],["P(G_1 \\cap G_2) = 0.3 \\times 0.6 = 0.18","ضرب الاحتمالات على الفرعين"]],"a":"<span class=\"tx\" data-t=\"0.18\"></span>","o":"","k":[{"e":"0.18","a":true}]},{"n":"20","s":[["P(G_1 \\cap R_2) = 0.3 \\times 0.4 = 0.12","الأولى خضراء والثانية حمراء"],["P(R_1 \\cap G_2) = 0.7 \\times 0.2 = 0.14","الأولى حمراء والثانية خضراء"],["P = 0.12 + 0.14 = 0.26","جمع احتمالي المسارين (متنافيان)"]],"a":"<span class=\"tx\" data-t=\"0.26\"></span>","o":"","k":[{"e":"0.26","a":true}]}],[{"n":"21","s":[["P(M) = 0.25,\\ P(\\overline{M}) = 0.75","الإثنين: ثلج / لا ثلج"],["P(T) = 0.9","الثلاثاء: ثلج"],["P(\\overline{M} \\cap T) = 0.75 \\times 0.9 = 0.675","ضرب الاحتمالات على فرعي الشجرة"]],"a":"<span class=\"tx\" data-t=\"0.675\"></span>","o":"الشجرة: الإثنين ثلج <span class=m dir=ltr>(0.25) /</span> لا ثلج <span class=m dir=ltr>(0.75)</span>، ثم الثلاثاء ثلج <span class=m dir=ltr>(0.9) /</span> لا ثلج <span class=m dir=ltr>(0.1)</span> من كل فرع.","k":[{"e":"0.675","a":true}]},{"n":"22","s":[["P(\\overline{T}) = 1 - 0.9 = 0.1","المتممة"],["P(\\overline{M} \\cap \\overline{T}) = 0.75 \\times 0.1 = 0.075","ضرب الاحتمالات"]],"a":"<span class=\"tx\" data-t=\"0.075\"></span>","o":"","k":[{"e":"0.075","a":true}]},{"n":"23","s":[["P(\\text{at least one}) = 1 - P(\\overline{M} \\cap \\overline{T})","الحادث المتمم"],["= 1 - 0.075 = 0.925","بالتعويض من الفرع <span class=m dir=ltr>22</span>"]],"a":"<span class=\"tx\" data-t=\"0.925\"></span>","o":"","k":[{"e":"0.925","a":true}]}],[{"n":"24","s":[["P(A) = 0.7,\\ P(B) = 0.6","<span class=m dir=ltr>A</span>: إصابة الأول، <span class=m dir=ltr>B</span>: إصابة الثاني (حادثان مستقلان)"],["P(A \\cap B) = 0.7 \\times 0.6 = 0.42","احتمال حادثين مستقلين"]],"a":"<span class=\"tx\" data-t=\"0.42\"></span>","o":"","k":[{"e":"0.42","a":true}]},{"n":"25","s":[["P(\\overline{A}) = 0.3,\\ P(\\overline{B}) = 0.4","المتممة"],["P(\\overline{A} \\cap \\overline{B}) = 0.3 \\times 0.4 = 0.12","حادثان مستقلان"]],"a":"<span class=\"tx\" data-t=\"0.12\"></span>","o":"","k":[{"e":"0.12","a":true}]},{"n":"26","s":[["P(B \\mid A) = P(B)","لأن <span class=m dir=ltr>A</span> و <span class=m dir=ltr>B</span> مستقلان"],["= 0.6",""]],"a":"<span class=\"tx\" data-t=\"0.6\"></span>","o":"","k":[{"e":"0.6","a":true}]},{"n":"27","s":[["P(\\overline{B} \\mid \\overline{A}) = P(\\overline{B})","لأن الحادثين مستقلان"],["= 1 - 0.6 = 0.4","المتممة"]],"a":"<span class=\"tx\" data-t=\"0.4\"></span>","o":"","k":[{"e":"0.4","a":true}]}],[{"n":"28","s":[["P(\\text{1st}) = \\frac{1}{365},\\ P(\\text{2nd}) = \\frac{1}{365}","مسألة اليوم: يوم ميلاد كل شخص هو الأول من أيلول"],["P = \\frac{1}{365} \\times \\frac{1}{365}","حادثان مستقلان: نضرب الاحتمالين"],["= \\frac{1}{133225} \\approx 0.0000075",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{133225}\"></span> تقريبًا","o":"مسألة اليوم (ص <span class=m dir=ltr>139)</span>: اختيار شخصين عشوائيًّا، ما احتمال أن يكون يوم ميلاد كليهما الأول من أيلول؟","k":[{"e":"1/133225","a":null}]}],[{"n":"29","s":[["A \\cap B = \\varnothing \\Rightarrow P(A \\cap B) = 0","لأن الحادثين متنافيان"],["P(A \\mid B) = \\frac{P(A \\cap B)}{P(B)}","قانون الاحتمال المشروط"],["= \\frac{0}{P(B)} = 0","بشرط <span class=\"tx\" data-t=\"P(B) \\ne 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"P(A \\mid B) = 0\"></span>؛ لأن وقوع <span class=m dir=ltr>B</span> يعني عدم وقوع <span class=m dir=ltr>A (</span>لا يقعان معًا).","o":""}],[{"n":"30","s":[["P(A \\mid B) = \\frac{P(A \\cap B)}{P(B)}","قانون الاحتمال المشروط"],["P(B \\mid A) = \\frac{P(A \\cap B)}{P(A)}","قانون الاحتمال المشروط"],["P(A) \\ne P(B) \\Rightarrow P(A \\mid B) \\ne P(B \\mid A)","المقامان مختلفان عمومًا"],["P(B \\mid S) = 0.44 \\ne P(S \\mid B) = 0.4","مثال مضاد من السؤالين <span class=m dir=ltr>14</span> و <span class=m dir=ltr>15</span>"]],"a":"قول تماضر غير صحيح؛ تتساوى القيمتان فقط إذا كان <span class=\"tx\" data-t=\"P(A) = P(B)\"></span> أو <span class=\"tx\" data-t=\"P(A \\cap B) = 0\"></span>.","o":""}],[{"n":"31","s":[["P(R) = \\frac{1}{n},\\ P(G \\mid R) = \\frac{1}{n-1}","كرة واحدة من كل لون، دون إرجاع"],["\\frac{1}{n} \\times \\frac{1}{n-1} \\approx 0.024","ضرب الاحتمالين"],["n(n-1) \\approx \\frac{1}{0.024} \\approx 41.7","بأخذ المقلوب"],["7 \\times 6 = 42 \\Rightarrow n = 7","بالتجريب"],["\\frac{1}{42} \\approx 0.0238 \\approx 2.4\\%","التحقق"]],"a":"<span class=\"tx\" data-t=\"n = 7\"></span>","o":"","k":[{"e":"7","a":null}]}],[{"n