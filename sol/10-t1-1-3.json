[[{"n":"1","s":[["2x^2+x-5=-x^2-2x-5","بمساواة المعادلتين"],["3x^2+3x=0","بجمع الحدود المتشابهة"],["3x(x+1)=0\\Rightarrow x=0\\quad\\text{or}\\quad x=-1","بالتحليل وخاصية الضرب الصفري"],["y=-5,\\qquad y=2(1)-1-5=-4","بالتعويض في إحدى المعادلتين"],["-(-1)^2-2(-1)-5=-4\\ \\checkmark","التحقق في المعادلة الثانية"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,-5)\"></span> و <span class=\"tx\" data-t=\"(-1,\\,-4)\"></span>","o":"","k":[{"p":["0","-5"]},{"p":["-1","-4"]}]},{"n":"2","s":[["x^2-4x+1=-2x^2-4","بمساواة المعادلتين"],["3x^2-4x+5=0","بالتبسيط"],["b^2-4ac=16-60=-44<0","المميز سالب"]],"a":"لا يوجد حل للنظام (المنحنيان لا يتقاطعان)","o":""},{"n":"3","s":[["x^2+1=2x^2-3","بمساواة المعادلتين"],["x^2=4\\Rightarrow x=\\pm2","بالتبسيط وأخذ الجذر التربيعي"],["y=4+1=5","بالتعويض في إحدى المعادلتين"],["2(4)-3=5\\ \\checkmark","التحقق"]],"a":"الحلان: <span class=\"tx\" data-t=\"(2,\\,5)\"></span> و <span class=\"tx\" data-t=\"(-2,\\,5)\"></span>","o":"","k":[{"p":["2","5"]},{"p":["-2","5"]}]},{"n":"4","s":[["x^2+x+1=-x^2+x-2","بمساواة المعادلتين"],["2x^2+3=0\\Rightarrow x^2=-\\frac32","بالتبسيط"]],"a":"لا يوجد حل للنظام؛ لأنه لا يوجد عدد حقيقي مربعه سالب","o":""},{"n":"5","s":[["-x^2+5x=x^2-5x","بمساواة المعادلتين"],["2x^2-10x=0\\Rightarrow2x(x-5)=0","بالتبسيط والتحليل"],["x=0\\quad\\text{or}\\quad x=5","خاصية الضرب الصفري"],["y=0,\\qquad y=25-25=0","بالتعويض في إحدى المعادلتين"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,0)\"></span> و <span class=\"tx\" data-t=\"(5,\\,0)\"></span>","o":"","k":[{"p":["0","0"]},{"p":["5","0"]}]},{"n":"6","s":[["x^2=x^2+x+6","بمساواة المعادلتين"],["0=x+6\\Rightarrow x=-6","بطرح <span class=\"tx\" data-t=\"x^2\"></span> من الطرفين"],["y=(-6)^2=36","بالتعويض في إحدى المعادلتين"],["36-6+6=36\\ \\checkmark","التحقق"]],"a":"الحل: <span class=\"tx\" data-t=\"(-6,\\,36)\"></span>","o":"","k":[{"p":["-6","36"]}]},{"n":"7","s":[["-x^2+6x+8=-x^2-6x+8","بمساواة المعادلتين"],["12x=0\\Rightarrow x=0","بالتبسيط"],["y=8","بالتعويض في إحدى المعادلتين"]],"a":"الحل: <span class=\"tx\" data-t=\"(0,\\,8)\"></span>","o":"","k":[{"p":["0","8"]}]},{"n":"8","s":[["x^2=y+5","من المعادلة الثانية"],["y+5+y^2=16\\Rightarrow y^2+y-11=0","بالتعويض في المعادلة الأولى"],["y=\\frac{-1\\pm\\sqrt{1+44}}{2}=\\frac{-1\\pm3\\sqrt5}{2}","بالقانون العام"],["y\\approx2.854\\Rightarrow x^2=\\frac{9+3\\sqrt5}{2}\\Rightarrow x\\approx\\pm2.80","بالتعويض في <span class=\"tx\" data-t=\"x^2=y+5\"></span>"],["y\\approx-3.854\\Rightarrow x^2=\\frac{9-3\\sqrt5}{2}\\Rightarrow x\\approx\\pm1.07",""]],"a":"أربعة حلول: <span class=\"tx\" data-t=\"(\\pm2.80,\\ 2.85)\"></span> و <span class=\"tx\" data-t=\"(\\pm1.07,\\ -3.85)\"></span> تقريبًا، بدقة: <span class=\"tx\" data-t=\"x=\\pm\\sqrt{\\frac{9\\pm3\\sqrt5}{2}},\\ y=\\frac{-1\\pm3\\sqrt5}{2}\"></span>","o":""},{"n":"9","s":[["25x^2-10y^2=90","بضرب المعادلة الأولى في <span class=m dir=ltr>5</span>"],["6x^2+10y^2=34","بضرب المعادلة الثانية في <span class=m dir=ltr>2</span>"],["31x^2=124\\Rightarrow x^2=4\\Rightarrow x=\\pm2","بجمع المعادلتين (الحذف)"],["3(4)+5y^2=17\\Rightarrow y^2=1\\Rightarrow y=\\pm1","بالتعويض في إحدى المعادلتين"],["5(4)-2(1)=18\\ \\checkmark","التحقق"]],"a":"أربعة حلول: <span class=\"tx\" data-t=\"(2,\\,1),\\ (2,\\,-1),\\ (-2,\\,1),\\ (-2,\\,-1)\"></span>","o":"","k":[{"p":["2","1"]},{"p":["2","-1"]},{"p":["-2","1"]},{"p":["-2","-1"]}]}],[{"n":"10","s":[["x^2+y^2-4y+4=4\\Rightarrow x^2+y^2-4y=0","بفك القوس في المعادلة الأولى"],["9-4y=0","بتعويض <span class=\"tx\" data-t=\"x^2+y^2=9\"></span>"],["y=\\frac94",""],["x^2=9-\\frac{81}{16}=\\frac{63}{16}","بالتعويض في <span class=\"tx\" data-t=\"x^2+y^2=9\"></span>"],["x=\\pm\\frac{3\\sqrt7}{4}\\approx\\pm1.98","بأخذ الجذر التربيعي"]],"a":"نقطتا التقاطع: <span class=\"tx\" data-t=\"\\left(\\frac{3\\sqrt7}{4},\\,\\frac94\\right)\"></span> و <span class=\"tx\" data-t=\"\\left(-\\frac{3\\sqrt7}{4},\\,\\frac94\\right)\"></span>","o":"","k":[{"p":["3*sqrt(7)/4","9/4"]},{"p":["-3*sqrt(7)/4","9/4"]}]}],[{"n":"11","s":[["x^2+y^2=89,\\qquad x^2-y^2=39","بفرض العددين <span class=\"tx\" data-t=\"x,y\"></span>"],["2x^2=128\\Rightarrow x^2=64\\Rightarrow x=\\pm8","بجمع المعادلتين"],["64+y^2=89\\Rightarrow y^2=25\\Rightarrow y=\\pm5","بالتعويض"]],"a":"العددان <span class=\"tx\" data-t=\"8\"></span> و <span class=\"tx\" data-t=\"5\"></span> (أو <span class=\"tx\" data-t=\"\\pm8\"></span> و <span class=\"tx\" data-t=\"\\pm5\"></span>)","o":"","k":[{"e":"8","a":null},{"e":"5","a":null},{"e":"8","a":null},{"e":"-8","a":null},{"e":"5","a":null},{"e":"-5","a":null}]}],[{"n":"12","s":[["-2t^2+12t+10=-2t^2+4t+42","بمساواة الارتفاعين"],["8t=32\\Rightarrow t=4","بالتبسيط"],["y=-2(16)+12(4)+10=26","الكرة الأولى"],["y=-2(16)+4(4)+42=26","الكرة الثانية"]],"a":"يتساوى الارتفاعان بعد <span class=\"tx\" data-t=\"4\"></span> ثوانٍ، وارتفاع كل كرة عندها <span class=\"tx\" data-t=\"26\\ \\text{m}\"></span>","o":""}],[{"n":"13","s":[["y=x^2+6x,\\qquad y=-x^2+24x","معادلتا مسألة اليوم (العرض والطلب)"],["x^2+6x=-x^2+24x","بمساواة المعادلتين"],["2x^2-18x=0\\Rightarrow2x(x-9)=0","بالتبسيط والتحليل"],["x=0\\quad\\text{or}\\quad x=9","خاصية الضرب الصفري"],["y=0,\\qquad y=81+54=135","بالتعويض في إحدى المعادلتين"]],"a":"نقطتا التوازن: <span class=\"tx\" data-t=\"(0,\\,0)\"></span> و <span class=\"tx\" data-t=\"(9,\\,135)\"></span>؛ أي عند سعر <span class=m dir=ltr>9</span> للوحدة يتساوى العرض والطلب عند <span class=m dir=ltr>135</span> وحدة","o":""}],[{"n":"14","s":[["(x-y)(x-2y)=0","بتحليل المعادلة الأولى"],["x=y\\quad\\text{or}\\quad x=2y","خاصية الضرب الصفري"],["x=y:\\ y^2+y^2=6\\Rightarrow y=\\pm\\sqrt3","بالتعويض في المعادلة الثانية"],["x=2y:\\ 4y^2+2y^2=6\\Rightarrow y=\\pm1,\\ x=\\pm2","بالتعويض في المعادلة الثانية"]],"a":"أربعة حلول: <span class=\"tx\" data-t=\"(\\sqrt3,\\,\\sqrt3),\\ (-\\sqrt3,\\,-\\sqrt3),\\ (2,\\,1),\\ (-2,\\,-1)\"></span>","o":"","k":[{"p":["sqrt(3)","sqrt(3)"]},{"p":["-sqrt(3)","-sqrt(3)"]},{"p":["2","1"]},{"p":["-2","-1"]}]}],[{"n":"15","s":[["x^2+y^2=4,\\qquad x^2+y^2=9","النظام المعطى"],["0=5","بطرح المعادلة الأولى من الثانية: عبارة خاطئة"]],"a":"نعم، قول زينب صحيح؛ فالمقدار <span class=\"tx\" data-t=\"x^2+y^2\"></span> لا يمكن أن يساوي <span class=m dir=ltr>4</span> و <span class=m dir=ltr>9</span> معًا، وهندسيًا هما دائرتان مركزهما نقطة الأصل ونصفا قطريهما <span class=m dir=ltr>2</span> و <span class=m dir=ltr>3</span> فلا تتقاطعان","o":""}],[{"n":"16","s":[["y=x^2+1,\\qquad y=-x^2-1","نظام مقترح"],["x^2+1=-x^2-1\\Rightarrow2x^2=-2","بمساواة المعادلتين"],["x^2=-1","لا يوجد عدد حقيقي مربعه سالب"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"y=x^2+1\"></span> و <span class=\"tx\" data-t=\"y=-x^2-1\"></span> (ليس له حل)","o":""}],[{"n":"17","s":[["a^2+h^2=50^2=2500","بفرض نصف القاعدة <span class=\"tx\" data-t=\"a\"></span> والارتفاع <span class=\"tx\" data-t=\"h\"></span>: الارتفاع ينصف القاعدة، نظرية فيثاغورس"],["\\frac12(2a)h=1200\\Rightarrow ah=1200\\Rightarrow h=\\frac{1200}{a}","المساحة"],["a^2+\\frac{1440000}{a^2}=2500\\Rightarrow a^4-2500a^2+1440000=0","بالتعويض والضرب في <span class=\"tx\" data-t=\"a^2\"></span>"],["(a^2-1600)(a^2-900)=0","بالتحليل (صورة تربيعية)"],["a=40,\\ h=30\\quad\\text{or}\\quad a=30,\\ h=40","<span class=\"tx\" data-t=\"a&gt;0\"></span>"]],"a":"إجابتان: القاعدة <span class=\"tx\" data-t=\"80\\ \\text{m}\"></span> والارتفاع <span class=\"tx\" data-t=\"30\\ \\text{m}\"></span>، أو القاعدة <span class=\"tx\" data-t=\"60\\ \\text{m}\"></span> والارتفاع <span class=\"tx\" data-t=\"40\\ \\text{m}\"></span>","o":""}],[{"n":"18","s":[["x^2+y^2=34,\\qquad y=x^2-22","نظام مقترح"],["5^2+3^2=34\\ \\checkmark","التحقق في المعادلة الأولى"],["5^2-22=3\\ \\checkmark","التحقق في المعادلة الثانية"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"x^2+y^2=34\"></span> و <span class=\"tx\" data-t=\"y=x^2-22\"></span>","o":"","k":[{"q":"x^2 + y^2 - 34"},{"e":"x^2 - 22","a":null}]}],[{"n":"19","s":[["lw=216","بفرض الطول <span class=\"tx\" data-t=\"l\"></span> والعرض <span class=\"tx\" data-t=\"w\"></span>؛ عند ثني الطولين يصبح الطول ارتفاع الأسطوانة والعرض محيط قاعدتها"],["2\\pi r=w\\Rightarrow r=\\frac{w}{2\\pi}","محيط القاعدة"],["V=\\pi r^2l=\\frac{w^2l}{4\\pi}=224","حجم الأسطوانة"],["\\frac{w(lw)}{4\\pi}=224\\Rightarrow\\frac{216w}{4\\pi}=224","بتعويض <span class=\"tx\" data-t=\"lw=216\"></span>"],["w=\\frac{112\\pi}{27}\\approx13.03","بالحل"],["l=\\frac{216}{w}=\\frac{729}{14\\pi}\\approx16.57","بالتعويض"]],"a":"بعدا الورقة: الطول <span class=\"tx\" data-t=\"\\approx16.57\\ \\text{cm}\"></span> والعرض <span class=\"tx\" data-t=\"\\approx13.03\\ \\text{cm}\"></span>","o":"","k":[{"e":"16.57","a":true},{"e":"13.03","a":true}]}],[{"n":"2","s":[["(3,0):\\ 9-15+6=0\\ \\checkmark","بالتعويض في المعادلة الأولى"],["-9+6+3=0\\ \\checkmark","بالتعويض في المعادلة الثانية"],["(1,2):\\ -1+2+3=4\\ne2","لا يحقق المعادلة الثانية"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"(3,\\,0)\"></span>","o":"","k":[{"p":["3","0"]}]}],[{"n":"1","s":[["x^2-6x+9=x^2-3x","بمساواة المعادلتين"],["-3x+9=0\\Rightarrow x=3","بالتبسيط"],["y=9-9=0","بالتعويض"]],"a":"الحل: <span class=\"tx\" data-t=\"(3,\\,0)\"></span>","o":"","k":[{"p":["3","0"]}]},{"n":"2","s":[["y=3x^2+x+2","من المعادلة الأولى"],["3x^2+x+2=-6x^2+7x","بالمساواة"],["9x^2-6x+2=0","بالتبسيط"],["b^2-4ac=36-72=-36<0","المميز سالب"]],"a":"لا يوجد حل للنظام","o":""},{"n":"3","s":[["0.5x^2+0.5x+1=-x^2+2x+4","بمساواة المعادلتين"],["1.5x^2-1.5x-3=0\\Rightarrow x^2-x-2=0","بالتبسيط والقسمة على <span class=m dir=ltr>1.5</span>"],["(x-2)(x+1)=0","بالتحليل"],["x=2,\\ y=4;\\qquad x=-1,\\ y=1","بالتعويض في المعادلة الثانية"],["0.5(4)+0.5(2)+1=4\\ \\checkmark","التحقق"]],"a":"الحلان: <span class=\"tx\" data-t=\"(2,\\,4)\"></span> و <span class=\"tx\" data-t=\"(-1,\\,1)\"></span>","o":"","k":[{"p":["2","4"]},{"p":["-1","1"]}]},{"n":"4","s":[["2x^2+8x+4=x^2+2x+4","بمساواة المعادلتين"],["x^2+6x=0\\Rightarrow x(x+6)=0","بالتبسيط والتحليل"],["x=0,\\ y=4;\\qquad x=-6,\\ y=36-12+4=28","بالتعويض"],["2(36)-48+4=28\\ \\checkmark","التحقق"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,4)\"></span> و <span class=\"tx\" data-t=\"(-6,\\,28)\"></span>","o":"","k":[{"p":["0","4"]},{"p":["-6","28"]}]},{"n":"5","s":[["y=x^2,\\qquad y=-x^2","بحل كل معادلة لـ <span class=\"tx\" data-t=\"y\"></span>"],["x^2=-x^2\\Rightarrow2x^2=0\\Rightarrow x=0","بالمساواة"],["y=0",""]],"a":"الحل: <span class=\"tx\" data-t=\"(0,\\,0)\"></span>","o":"","k":[{"p":["0","0"]}]},{"n":"6","s":[["x^2+x-1=5-x^2","بمساواة المعادلتين"],["2x^2+x-6=0\\Rightarrow(2x-3)(x+2)=0","بالتبسيط والتحليل"],["x=\\frac32,\\ y=5-\\frac94=\\frac{11}{4};\\qquad x=-2,\\ y=1","بالتعويض"]],"a":"الحلان: <span class=\"tx\" data-t=\"\\left(\\frac32,\\,\\frac{11}{4}\\right)\"></span> و <span class=\"tx\" data-t=\"(-2,\\,1)\"></span>","o":"","k":[{"p":["3/2","11/4"]},{"p":["-2","1"]}]},{"n":"7","s":[["y=-x^2-2","من المعادلة الثانية"],["x^2+x+2=-x^2-2\\Rightarrow2x^2+x+4=0","بالمساواة"],["b^2-4ac=1-32=-31<0","المميز سالب"]],"a":"لا يوجد حل للنظام","o":""},{"n":"8","s":[["x^2+2x+2=-x^2-2x+2","بمساواة المعادلتين"],["2x^2+4x=0\\Rightarrow2x(x+2)=0","بالتبسيط والتحليل"],["x=0,\\ y=2;\\qquad x=-2,\\ y=4-4+2=2","بالتعويض"]],"a":"الحلان: <span class=\"tx\" data-t=\"(0,\\,2)\"></span> و <span class=\"tx\" data-t=\"(-2,\\,2)\"></span>","o":"","k":[{"p":["0","2"]},{"p":["-2","2"]}]},{"n":"9","s":[["-x^2+2x+2=-x^2-2x+2","بمساواة المعادلتين"],["4x=0\\Rightarrow x=0","بالتبسيط"],["y=2","بالتعويض"]],"a":"الحل: <span class=\"tx\" data-t=\"(0,\\,2)\"></span>","o":"","k":[{"p":["0","2"]}]},{"n":"10","s":[["x^2=2y+4","من المعادلة الثانية: <span class=\"tx\" data-t=\"0.5x^2=y+2\"></span>"],["y^2=-(2y+4)+4\\Rightarrow y^2+2y=0","بالتعويض في المعادلة الأولى"],["y(y+2)=0\\Rightarrow y=0\\quad\\text{or}\\quad y=-2","بالتحليل"],["y=0:\\ x^2=4\\Rightarrow x=\\pm2;\\qquad y=-2:\\ x^2=0\\Rightarrow x=0","بالتعويض في <span class=\"tx\" data-t=\"x^2=2y+4\"></span>"]],"a":"ثلاثة حلول: <span class=\"tx\" data-t=\"(2,\\,0),\\ (-2,\\,0),\\ (0,\\,-2)\"></span>","o":"","k":[{"p":["2","0"]},{"p":["-2","0"]},{"p":["0","-2"]}]},{"n":"11","s":[["y=x^2+3x-4","من المعادلة الثانية"],["4(x^2+3x-4)+9x^2=25","بالتعويض في المعادلة الأولى"],["13x^2+12x-41=0","بالتبسيط"],["x=\\frac{-12\\pm\\sqrt{144+2132}}{26}=\\frac{-6\\pm\\sqrt{569}}{13}","بالقانون العام"],["x\\approx1.37,\\ y\\approx2.01;\\qquad x\\approx-2.30,\\ y\\approx-5.62","بالتعويض في <span class=\"tx\" data-t=\"y=x^2+3x-4\"></span>"]],"a":"الحلان تقريبًا: <span class=\"tx\" data-t=\"(1.37,\\,2.01)\"></span> و <span class=\"tx\" data-t=\"(-2.30,\\,-5.62)\"></span>","o":"","k":[{"p":["1.37","2.01"]},{"p":["-2.3","-5.62"]}]},{"n":"12","s":[["x^2+(x-3)^2=16","بتعويض <span class=\"tx\" data-t=\"y^2=(x-3)^2\"></span> في المعادلة الأولى"],["2x^2-6x-7=0","بالتبسيط"],["x=\\frac{6\\pm\\sqrt{36+56}}{4}=\\frac{3\\pm\\sqrt{23}}{2}","بالقانون العام"],["y=\\pm(x-3)","من <span class=\"tx\" data-t=\"y^2=(x-3)^2\"></span>"],["x\\approx3.90\\Rightarrow y\\approx\\pm0.90;\\quad x\\approx-0.90\\Rightarrow y\\approx\\pm3.90","بالتعويض"]],"a":"أربعة حلول تقريبًا: <span class=\"tx\" data-t=\"(3.90,\\,0.90),\\ (3.90,\\,-0.90),\\ (-0.90,\\,3.90),\\ (-0.90,\\,-3.90)\"></span>","o":"","k":[{"p":["3.9","0.9"]},{"p":["3.9","-0.9"]},{"p":["-0.9","3.9"]},{"p":["-0.9","-3.9"]}]}],[{"n":"13","s":[["-x^2+3=-x^2+2x","بمساواة المعادلتين"],["2x=3\\Rightarrow x=1.5","بالتبسيط"],["y=-(1.5)^2+3=0.75","بالتعويض"]],"a":"نقطة التقاء الكرتين: <span class=\"tx\" data-t=\"(1.5,\\,0.75)\"></span>","o":"","k":[{"p":["1.5","0.75"]}]}],[{"n":"14","s":[["x^2=20-y","من معادلة القطع المكافئ"],["20-y+y^2=64\\Rightarrow y^2-y-44=0","بالتعويض في معادلة الدائرة"],["y=\\frac{1\\pm\\sqrt{1+176}}{2}=\\frac{1\\pm\\sqrt{177}}{2}","بالقانون العام"],["y\\approx7.15\\Rightarrow x^2\\approx12.85\\Rightarrow x\\approx\\pm3.58","بالتعويض في <span class=\"tx\" data-t=\"x^2=20-y\"></span>"],["y\\approx-6.15\\Rightarrow x^2\\approx26.15\\Rightarrow x\\approx\\pm5.11",""]],"a":"نقاط التقاطع الأربع تقريبًا: <span class=\"tx\" data-t=\"(3.58,\\,7.15),\\ (-3.58,\\,7.15),\\ (5.11,\\,-6.15),\\ (-5.11,\\,-6.15)\"></span>","o":"","k":[{"p":["3.58","7.15"]},{"p":["-3.58","7.15"]},{"p":["5.11","-6.15"]},{"p":["-5.11","-6.15"]}]}],[{"n":"3","s":[["\\frac12x^2+x-\\frac92=-x^2-8x-18","بمساواة المعادلتين"],["\\frac32x^2+9x+\\frac{27}{2}=0\\Rightarrow x^2+6x+9=0","بالتبسيط والضرب في <span class=\"tx\" data-t=\"\\frac23\"></span>"],["(x+3)^2=0\\Rightarrow x=-3","بالتحليل"],["y=-9+24-18=-3","بالتعويض"]],"a":"<span class=m dir=ltr>C)</span> <span class=\"tx\" data-t=\"(-3,\\,-3)\"></span>","o":"","k":[{"p":["-3","-3"]}]}]]