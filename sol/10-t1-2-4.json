[[{"n":"1","s":[["x^2 + y^2 = r^2","المركز نقطة الأصل"],["x^2 + y^2 = 7^2","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"x^2 + y^2 = 49\"></span>","o":"","k":[{"q":"x^2 + y^2 - 49"}]},{"n":"2","s":[["(x - a)^2 + (y - b)^2 = r^2","الصورة القياسية"],["(x + 1)^2 + (y - 3)^2 = 5^2","بتعويض <span class=\"tx\" data-t=\"a = -1, b = 3, r = 5\"></span>"]],"a":"<span class=\"tx\" data-t=\"(x + 1)^2 + (y - 3)^2 = 25\"></span>","o":"","k":[{"q":"(x + 1)^2 + (y - 3)^2 - 25"}]},{"n":"3","s":[["r = \\frac{10}{2} = 5","نصف القطر <span class=m dir=ltr>=</span> نصف القطر الكامل"],["(x + 3)^2 + (y + 2)^2 = 5^2","بتعويض <span class=\"tx\" data-t=\"a = -3, b = -2\"></span>"]],"a":"<span class=\"tx\" data-t=\"(x + 3)^2 + (y + 2)^2 = 25\"></span>","o":"","k":[{"q":"(x + 3)^2 + (y + 2)^2 - 25"}]}],[{"n":"4","s":[["r^2 = (3 - (-1))^2 + (5 - 2)^2","صيغة المسافة بين المركز والنقطة"],["r^2 = 16 + 9 = 25",""],["(x + 1)^2 + (y - 2)^2 = 25","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x + 1)^2 + (y - 2)^2 = 25\"></span>","o":"","k":[{"q":"(x + 1)^2 + (y - 2)^2 - 25"}]},{"n":"5","s":[["r^2 = (-9)^2 + (-4)^2 = 81 + 16 = 97","بتعويض النقطة في <span class=\"tx\" data-t=\"x^2 + y^2 = r^2\"></span>"]],"a":"<span class=\"tx\" data-t=\"x^2 + y^2 = 97\"></span>","o":"","k":[{"q":"x^2 + y^2 - 97"}]}],[{"n":"6","s":[["(x - (-5))^2 + (y - 8)^2 = 6^2","بالمقارنة بالصورة القياسية"]],"a":"المركز <span class=\"tx\" data-t=\"(-5, 8)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"6\"></span>","o":"","k":[{"p":["-5","8"]},{"e":"6","a":null}]},{"n":"7","s":[["(x - 19)^2 + (y - 33)^2 = 20^2","بالمقارنة بالصورة القياسية"]],"a":"المركز <span class=\"tx\" data-t=\"(19, 33)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"20\"></span>","o":"","k":[{"p":["19","33"]},{"e":"20","a":null}]},{"n":"8","s":[["(x - 0)^2 + (y - (-4))^2 = 45","بالمقارنة بالصورة القياسية"],["r = \\sqrt{45} = 3\\sqrt{5}",""]],"a":"المركز <span class=\"tx\" data-t=\"(0, -4)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"3\\sqrt{5} \\approx 6.7\"></span>","o":"","k":[{"p":["0","-4"]},{"e":"6.7","a":true}]},{"n":"9","s":[["(x - 3)^2 + (y - (-10))^2 = 28","بالمقارنة بالصورة القياسية"],["r = \\sqrt{28} = 2\\sqrt{7}",""]],"a":"المركز <span class=\"tx\" data-t=\"(3, -10)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"2\\sqrt{7} \\approx 5.3\"></span>","o":"","k":[{"p":["3","-10"]},{"e":"5.3","a":true}]}],[{"n":"10","s":[["(x^2 - 6x + 9) + (y^2 - 10y + 25) = -30 + 9 + 25","بإكمال المربع"],["(x - 3)^2 + (y - 5)^2 = 4","بالتحليل"]],"a":"المركز <span class=\"tx\" data-t=\"(3, 5)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"p":["3","5"]},{"e":"2","a":null}]},{"n":"11","s":[["(x^2 + 8x + 16) + y^2 = 9 + 16","بإكمال المربع"],["(x + 4)^2 + y^2 = 25","بالتحليل"]],"a":"المركز <span class=\"tx\" data-t=\"(-4, 0)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"5\"></span>","o":"","k":[{"p":["-4","0"]},{"e":"5","a":null}]},{"n":"12","s":[["x^2 + y^2 + 10x + 18y + 79 = 0","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["(x^2 + 10x + 25) + (y^2 + 18y + 81) = -79 + 25 + 81","بإكمال المربع"],["(x + 5)^2 + (y + 9)^2 = 27","بالتحليل"],["r = \\sqrt{27} = 3\\sqrt{3}",""]],"a":"المركز <span class=\"tx\" data-t=\"(-5, -9)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"3\\sqrt{3} \\approx 5.2\"></span>","o":"","k":[{"p":["-5","-9"]},{"e":"5.2","a":true}]},{"n":"13","s":[["(x^2 - 18x + 81) + (y^2 + 14y + 49) = 14 + 81 + 49","بإكمال المربع"],["(x - 9)^2 + (y + 7)^2 = 144","بالتحليل"]],"a":"المركز <span class=\"tx\" data-t=\"(9, -7)\"></span>، ونصف القطر <span class=\"tx\" data-t=\"12\"></span>","o":"","k":[{"p":["9","-7"]},{"e":"12","a":null}]}],[{"n":"14","s":[["r = \\frac{26}{2} = 13","نصف القطر"],["(x + 11)^2 + (y + 1)^2 = 169","الصورة القياسية"],["x^2 + 22x + 121 + y^2 + 2y + 1 - 169 = 0","بفكّ الأقواس"],["x^2 + y^2 + 22x + 2y - 47 = 0","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"(x + 11)^2 + (y + 1)^2 = 169\"></span> ، <span class=\"tx\" data-t=\"x^2 + y^2 + 22x + 2y - 47 = 0\"></span>","o":"","k":[{"q":"(x + 11)^2 + (y + 1)^2 - 169"},{"q":"x^2 + 22*x + y^2 + 2*y - 47"}]},{"n":"15","s":[["r^2 = (4\\sqrt{3})^2 = 48",""],["(x - 3)^2 + y^2 = 48","الصورة القياسية"],["x^2 - 6x + 9 + y^2 - 48 = 0","بفكّ الأقواس"],["x^2 + y^2 - 6x - 39 = 0","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"(x - 3)^2 + y^2 = 48\"></span> ، <span class=\"tx\" data-t=\"x^2 + y^2 - 6x - 39 = 0\"></span>","o":"","k":[{"q":"y^2 + (x - 3)^2 - 48"},{"q":"x^2 - 6*x + y^2 - 39"}]},{"n":"16","s":[["r^2 = (1 - (-4))^2 + (3 - 7)^2 = 25 + 16 = 41","صيغة المسافة"],["(x + 4)^2 + (y - 7)^2 = 41","الصورة القياسية"],["x^2 + 8x + 16 + y^2 - 14y + 49 - 41 = 0","بفكّ الأقواس"],["x^2 + y^2 + 8x - 14y + 24 = 0","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"(x + 4)^2 + (y - 7)^2 = 41\"></span> ، <span class=\"tx\" data-t=\"x^2 + y^2 + 8x - 14y + 24 = 0\"></span>","o":"","k":[{"q":"(x + 4)^2 + (y - 7)^2 - 41"},{"q":"x^2 + 8*x + y^2 - 14*y + 24"}]}],[{"n":"17","s":[["(a, b) = (-1, 4)","المركز من الرسم: منتصف القطر الأفقي من <span class=\"tx\" data-t=\"x = -5.5\"></span> إلى <span class=\"tx\" data-t=\"x = 3.5\"></span>"],["r = \\frac{3.5 - (-5.5)}{2} = 4.5","نصف القطر"],["(x + 1)^2 + (y - 4)^2 = 4.5^2","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x + 1)^2 + (y - 4)^2 = 20.25\"></span>","o":"للتحقق: تقطع الدائرة المحور <span class=\"tx\" data-t=\"y\"></span> تقريبًا عند <span class=\"tx\" data-t=\"8.4\"></span> و <span class=\"tx\" data-t=\"-0.4\"></span> كما في الرسم.","k":[{"q":"(x + 1)^2 + (y - 4)^2 - 20.25"}]},{"n":"18","s":[["(x - 7)^2 + (y - 4)^2 = 224^2","معادلة دائرة البثّ: المركز <span class=\"tx\" data-t=\"(7, 4)\"></span> ونصف القطر <span class=m dir=ltr>224</span>"],["d = \\sqrt{(-75 - 7)^2 + (95 - 4)^2}","المسافة بين البيت <span class=\"tx\" data-t=\"(-75, 95)\"></span> ومحطة الإذاعة"],["d = \\sqrt{6724 + 8281} = \\sqrt{15005} \\approx 122.5","باستعمال الآلة الحاسبة"],["122.5 < 224","البيت داخل دائرة البثّ"]],"a":"نعم، يصل بثّ الإذاعة إلى بيت فوّاز؛ لأنّ بعده عن المحطة <span class=\"tx\" data-t=\"\\approx 122.5\\ \\text{km} &lt; 224\\ \\text{km}\"></span>","o":"مسألة اليوم في بداية الدرس."}],[{"n":"18","s":[["C(7,\\,4),\\ r=224,\\ H(-75,\\,95)","مركز البث <span class=\"tx\" data-t=\"C\"></span> ونصف القطر وموقع البيت <span class=\"tx\" data-t=\"H\"></span> من مسألة اليوم"],["(x-7)^2+(y-4)^2=224^2=50176","معادلة دائرة البث بالصورة القياسية"],["(-75-7)^2+(95-4)^2=(-82)^2+(91)^2","بتعويض إحداثيي البيت في الطرف الأيسر"],["=6724+8281=15005","بالتبسيط"],["15005<50176","البيت يقع داخل الدائرة"],["CH=\\sqrt{15005}\\approx 122.5\\ \\text{km}<224\\ \\text{km}","أو بقانون المسافة بين نقطتين"]],"a":"نعم، يصل بثّ الإذاعة إلى بيت فوّاز؛ لأنّ بُعده عن المحطة <span class=\"tx\" data-t=\"\\approx 122.5\\ \\text{km}\"></span> وهو أقلّ من <span class=\"tx\" data-t=\"224\\ \\text{km}\"></span>","o":"المسألة من «مسألة اليوم» في بداية الدرس (صفحة <span class=m dir=ltr>54)</span>."}],[{"n":"19","s":[["(2x-4)^2+(2y+6)^2=100","المعادلة المعطاة"],["[2(x-2)]^2+[2(y+3)]^2=100","بإخراج العامل المشترك <span class=m dir=ltr>2</span> من كل قوس"],["4(x-2)^2+4(y+3)^2=100",""],["(x-2)^2+(y+3)^2=25","بقسمة الطرفين على <span class=m dir=ltr>4</span>"],["a=2,\\ b=-3,\\ r=\\sqrt{25}=5","بالمقارنة مع الصورة القياسية"]],"a":"المركز <span class=\"tx\" data-t=\"(2,\\,-3)\"></span>، وطول نصف القطر <span class=\"tx\" data-t=\"5\"></span> وحدات","o":""}],[{"n":"20","s":[["x^2+px+y^2+6y=96","بترتيب الحدود"],["\\left(x+\\frac{p}{2}\\right)^2-\\frac{p^2}{4}+(y+3)^2-9=96","بإكمال المربّع"],["\\left(x+\\frac{p}{2}\\right)^2+(y+3)^2=105+\\frac{p^2}{4}",""],["105+\\frac{p^2}{4}=11^2=121\\Rightarrow p^2=64\\Rightarrow p=8","لأنّ <span class=\"tx\" data-t=\"r=11\"></span>، و<span class=\"tx\" data-t=\"p\"></span> موجب"],["\\text{center}=(-4,\\,-3)","المركز <span class=\"tx\" data-t=\"(-\\frac{p}{2},-3)\"></span>"],["d=\\sqrt{(-4-0)^2+(-3-0)^2}=\\sqrt{25}=5","قانون المسافة بين المركز ونقطة الأصل"]],"a":"<span class=\"tx\" data-t=\"p=8\"></span>، المركز <span class=\"tx\" data-t=\"(-4,\\,-3)\"></span>، وبُعده عن نقطة الأصل <span class=\"tx\" data-t=\"5\"></span> وحدات","o":""}],[{"n":"21","s":[["C\\left(\\frac{2+14}{2},\\ \\frac{9+(-7)}{2}\\right)","المركز منتصف القطر <span class=\"tx\" data-t=\"\\overline{DE}\"></span> (قانون نقطة المنتصف)"],["C(8,\\,1)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"C(8,\\,1)\"></span>","o":"","k":[{"p":["8","1"]}]},{"n":"22","s":[["r=CD=\\sqrt{(2-8)^2+(9-1)^2}","قانون المسافة بين نقطتين"],["=\\sqrt{36+64}=\\sqrt{100}=10","بالتبسيط"]],"a":"طول نصف القطر <span class=\"tx\" data-t=\"10\"></span> وحدات","o":"","k":[{"e":"10","a":null}]},{"n":"23","s":[["(x-a)^2+(y-b)^2=r^2","الصورة القياسية"],["(x-8)^2+(y-1)^2=10^2","بتعويض <span class=\"tx\" data-t=\"a=8,\\ b=1,\\ r=10\"></span>"]],"a":"<span class=\"tx\" data-t=\"(x-8)^2+(y-1)^2=100\"></span>","o":"","k":[{"q":"(x - 8)^2 + (y - 1)^2 - 100"}]}],[{"n":"24","s":[["x^2+(3x-2)^2+4x-24(3x-2)+108=0","بتعويض <span class=\"tx\" data-t=\"y=3x-2\"></span> في معادلة الدائرة"],["x^2+9x^2-12x+4+4x-72x+48+108=0","بفكّ الأقواس"],["10x^2-80x+160=0","بجمع الحدود المتشابهة"],["x^2-8x+16=0\\Rightarrow (x-4)^2=0","بقسمة الطرفين على <span class=m dir=ltr>10</span>، ثم بالتحليل"],["x=4,\\quad y=3(4)-2=10","بتعويض قيمة <span class=\"tx\" data-t=\"x\"></span> لإيجاد <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المستقيم يقطع الدائرة في نقطة واحدة فقط هي <span class=\"tx\" data-t=\"(4,\\,10)\"></span>؛ إذن هو مماسّ للدائرة","o":""}],[{"n":"25","s":[["(x+4)^2-16+(y-3)^2-9-75=0","بإكمال المربّع"],["(x+4)^2+(y-3)^2=100","المركز <span class=\"tx\" data-t=\"C(-4,3)\"></span> و <span class=\"tx\" data-t=\"r=10\"></span>"],["CP^2=(8-(-4))^2+(5-3)^2=144+4=148","قانون المسافة بين نقطتين"],["PT^2=CP^2-CT^2=148-100=48","نظرية فيثاغورس (المماس عمودي على نصف القطر)"],["PT=\\sqrt{48}=4\\sqrt{3}\\approx 6.93","بأخذ الجذر التربيعي للطرفين"]],"a":"طول القطعة المماسّية <span class=\"tx\" data-t=\"4\\sqrt{3}\\approx 6.93\"></span> وحدة","o":"","k":[{"e":"6.93","a":true}]}],[{"n":"26","s":[["(x^2-14x)+(y^2+6y)=-59","بترتيب الحدود"],["(x-7)^2-49+(y+3)^2-9=-59","بإكمال المربّع"],["(x-7)^2+(y+3)^2=-1","بالتبسيط"],["r^2=-1<0","مستحيل؛ لأنّ مربّع أي عدد حقيقي لا يكون سالبًا"]],"a":"نعم، قول عبد الرحمن صحيح؛ لأنّ الطرف الأيمن سالب <span class=\"tx\" data-t=\"(-1)\"></span> فلا يوجد نصف قطر <span class=\"tx\" data-t=\"r\"></span> حقيقي، ولا توجد نقاط تحقّق المعادلة","o":""}],[{"n":"27","s":[["R=7","الدائرة الكبرى تمسّ المحور <span class=\"tx\" data-t=\"y\"></span>: نصف قطرها <span class=m dir=ltr>=</span> بُعد المركز عن المحور <span class=\"tx\" data-t=\"y\"></span> <span class=m dir=ltr>=</span> الإحداثي <span class=\"tx\" data-t=\"x\"></span>"],["r=3","الصغرى تمسّ المحور <span class=\"tx\" data-t=\"x\"></span>: نصف قطرها <span class=m dir=ltr>=</span> الإحداثي <span class=\"tx\" data-t=\"y\"></span> للمركز"],["(x-7)^2+(y-3)^2=49","معادلة المحيط الخارجي"],["(x-7)^2+(y-3)^2=9","معادلة المحيط الداخلي"],["A=\\pi R^2-\\pi r^2=49\\pi-9\\pi=40\\pi\\approx 125.66","مساحة الممرّ <span class=m dir=ltr>=</span> الفرق بين مساحتي الدائرتين"]],"a":"الخارجي: <span class=\"tx\" data-t=\"(x-7)^2+(y-3)^2=49\"></span>، الداخلي: <span class=\"tx\" data-t=\"(x-7)^2+(y-3)^2=9\"></span>، مساحة الممرّ <span class=\"tx\" data-t=\"40\\pi\\approx 125.66\"></span> وحدة مربّعة","o":""}],[{"n":"28","s":[["C(9,\\,-4),\\quad r=CD=CB=7","من معادلة الدائرة"],["CA^2=(8-9)^2+(21-(-4))^2=1+625=626","قانون المسافة بين نقطتين"],["AD^2=CA^2-CD^2=626-49=577\\Rightarrow AD=\\sqrt{577}","نظرية فيثاغورس (<span class=\"tx\" data-t=\"\\overline{AD}\\perp\\overline{CD}\"></span>)"],["AB=AD=\\sqrt{577}","المماسّان المرسومان من نقطة خارجية متطابقان"],["\\text{Area}=2\\times\\frac{1}{2}(7)(\\sqrt{577})=7\\sqrt{577}\\approx 168.15","<span class=\"tx\" data-t=\"ABCD\"></span> مكوّن من مثلثين قائمين متطابقين <span class=\"tx\" data-t=\"\\triangle ADC\\cong\\triangle ABC\"></span>"]],"a":"مساحة <span class=\"tx\" data-t=\"ABCD=7\\sqrt{577}\\approx 168.15\"></span> وحدة مربّعة","o":"","k":[{"e":"168.15","a":true}]}],[{"n":"29","s":[["x^2+y^2+2fx+2gy+c=0","الصورة العامة لمعادلة الدائرة"],["2f=8\\Rightarrow f=4,\\quad 2g=-10\\Rightarrow g=-5,\\quad c=24","بالمقارنة"],["a=-f=-4,\\quad b=-g=5","لأنّ <span class=\"tx\" data-t=\"f=-a,\\ g=-b\"></span>"],["r^2=a^2+b^2-c=16+25-24=17","لأنّ <span class=\"tx\" data-t=\"c=a^2+b^2-r^2\"></span>"],["(x+4)^2+(y-5)^2=17","بالتعويض في الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x+4)^2+(y-5)^2=17\"></span> (المركز <span class=\"tx\" data-t=\"(-4,5)\"></span>، <span class=\"tx\" data-t=\"r=\\sqrt{17}\"></span>)","o":"","k":[{"q":"(x + 4)^2 + (y - 5)^2 - 17"},{"p":["-4","5"]},{"e":"sqrt(17)","a":null}]}],[{"n":"6","s":[["(-2+2)^2+(-1-4)^2=0+25=25","<span class=m dir=ltr>a)</span> تقع على الدائرة"],["(1+2)^2+(8-4)^2=9+16=25","<span class=m dir=ltr>b)</span> تقع على الدائرة"],["(3+2)^2+(4-4)^2=25+0=25","<span class=m dir=ltr>c)</span> تقع على الدائرة"],["(0+2)^2+(5-4)^2=4+1=5\\ne 25","<span class=m dir=ltr>d)</span> لا تقع على الدائرة"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"(0,\\,5)\"></span>","o":"","k":[{"p":["0","5"]}]}],[{"n":"7","s":[["C\\left(\\frac{4+6}{2},\\frac{-3+9}{2}\\right)=(5,\\,3)","المركز منتصف القطر"],["r^2=(6-5)^2+(9-3)^2=1+36=37","مربّع المسافة من المركز إلى <span class=\"tx\" data-t=\"B\"></span>"],["(x-5)^2+(y-3)^2=37","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x-5)^2+(y-3)^2=37\"></span>","o":"","k":[{"q":"(x - 5)^2 + (y - 3)^2 - 37"}]}],[{"n":"13","s":[["(x-5)^2+(y-0)^2=20","بالمقارنة مع الصورة القياسية"],["a=5,\\ b=0,\\ r=\\sqrt{20}=2\\sqrt5\\approx4.47",""]],"a":"المركز <span class=\"tx\" data-t=\"(5,\\,0)\"></span>، <span class=\"tx\" data-t=\"r=2\\sqrt{5}\\approx 4.47\"></span>","o":"","k":[{"p":["5","0"]},{"e":"4.47","a":true}]},{"n":"14","s":[["(x^2+18x)+(y^2-8y)=24","بترتيب الحدود"],["(x+9)^2-81+(y-4)^2-16=24","بإكمال المربّع"],["(x+9)^2+(y-4)^2=121","بالتبسيط"],["a=-9,\\ b=4,\\ r=11","بالمقارنة"]],"a":"المركز <span class=\"tx\" data-t=\"(-9,\\,4)\"></span>، <span class=\"tx\" data-t=\"r=11\"></span>","o":"","k":[{"p":["-9","4"]},{"e":"11","a":null}]}],[{"n":"1","s":[["(x-2)^2+(y-(-4))^2=6^2","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x-2)^2+(y+4)^2=36\"></span>","o":"","k":[{"q":"(x - 2)^2 + (y + 4)^2 - 36"}]},{"n":"2","s":[["(x-(-3))^2+(y-(-1))^2=4^2","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x+3)^2+(y+1)^2=16\"></span>","o":"","k":[{"q":"(x + 3)^2 + (y + 1)^2 - 16"}]},{"n":"3","s":[["r^2=(5-2)^2+(10-0)^2=9+100=109","مربّع المسافة بين المركز والنقطة"],["(x-2)^2+y^2=109","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x-2)^2+y^2=109\"></span>","o":"","k":[{"q":"y^2 + (x - 2)^2 - 109"}]},{"n":"4","s":[["r^2=(3-7)^2+(-1-3)^2=16+16=32","مربّع المسافة بين المركز والنقطة"],["(x-7)^2+(y-3)^2=32","الصورة القياسية"]],"a":"<span class=\"tx\" data-t=\"(x-7)^2+(y-3)^2=32\"></span>","o":"","k":[{"q":"(x - 7)^2 + (y - 3)^2 - 32"}]},{"n":"5","s":[["C\\left(\\frac{11+5}{2},\\frac{-4+6}{2}\\right)=(8,\\,1)","المركز منتصف القطر"],["r^2=(5-8)^2+(6-1)^2=9+25=34",""],["(x-8)^2+(y-1)^2=34",""]],"a":"<span class=\"tx\" data-t=\"(x-8)^2+(y-1)^2=34\"></span>","o":"","k":[{"q":"(x - 8)^2 + (y - 1)^2 - 34"}]},{"n":"6","s":[["C\\left(\\frac{4+6}{2},\\frac{12+(-8)}{2}\\right)=(5,\\,2)","المركز منتصف القطر"],["r^2=(4-5)^2+(12-2)^2=1+100=101",""],["(x-5)^2+(y-2)^2=101",""]],"a":"<span class=\"tx\" data-t=\"(x-5)^2+(y-2)^2=101\"></span>","o":"","k":[{"q":"(x - 5)^2 + (y - 2)^2 - 101"}]}],[{"n":"7","s":[["a=-6,\\ b=3,\\ r=\\sqrt{169}=13","بالمقارنة مع الصورة القياسية"]],"a":"المركز <span class=\"tx\" data-t=\"(-6,\\,3)\"></span>، <span class=\"tx\" data-t=\"r=13\"></span>","o":"","k":[{"p":["-6","3"]},{"e":"13","a":null}]},{"n":"8","s":[["x^2+y^2+4x-12y-24=0","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["(x+2)^2-4+(y-6)^2-36=24","بإكمال المربّع"],["(x+2)^2+(y-6)^2=64",""],["a=-2,\\ b=6,\\ r=8",""]],"a":"المركز <span class=\"tx\" data-t=\"(-2,\\,6)\"></span>، <span class=\"tx\" data-t=\"r=8\"></span>","o":"","k":[{"p":["-2","6"]},{"e":"8","a":null}]},{"n":"9","s":[["(x-0)^2+(y-7)^2=15^2","بالمقارنة"]],"a":"المركز <span class=\"tx\" data-t=\"(0,\\,7)\"></span>، <span class=\"tx\" data-t=\"r=15\"></span>","o":"","k":[{"p":["0","7"]},{"e":"15","a":null}]},{"n":"10","s":[["x^2+y^2-10x-8y+5=0","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["(x-5)^2-25+(y-4)^2-16=-5","بإكمال المربّع"],["(x-5)^2+(y-4)^2=36",""],["a=5,\\ b=4,\\ r=6",""]],"a":"المركز <span class=\"tx\" data-t=\"(5,\\,4)\"></span>، <span class=\"tx\" data-t=\"r=6\"></span>","o":"","k":[{"p":["5","4"]},{"e":"6","a":null}]}],[{"n":"11","s":[["C(-5,\\,3),\\quad r^2=41","من معادلة الدائرة"],["CT^2=(8-(-5))^2+(7-3)^2=169+16=185","قانون المسافة بين نقطتين"],["L^2=CT^2-r^2=185-41=144","نظرية فيثاغورس (المماس عمودي على نصف القطر)"],["L=\\sqrt{144}=12",""]],"a":"طول المماس <span class=\"tx\" data-t=\"12\"></span> وحدة","o":"","k":[{"e":"12","a":null}]}],[{"n":"12","s":[["(a+5)^2+(b+2)^2=(a-7)^2+(b+8)^2","البرج الرابع <span class=\"tx\" data-t=\"P(a,b)\"></span> متساوي البُعد عن <span class=\"tx\" data-t=\"A\"></span> و <span class=\"tx\" data-t=\"B\"></span>"],["24a-12b=84\\Rightarrow 2a-b=7","بفكّ الأقواس والتبسيط"],["(a-7)^2+(b+8)^2=(a-3)^2+(b+16)^2","متساوي البُعد عن <span class=\"tx\" data-t=\"B\"></span> و <span class=\"tx\" data-t=\"C\"></span>"],["-8a-16b=152\\Rightarrow a+2b=-19","بالتبسيط"],["b=2a-7\\Rightarrow a+4a-14=-19\\Rightarrow a=-1,\\ b=-9","بالتعويض"],["r^2=(-5+1)^2+(-2+9)^2=16+49=65\\Rightarrow(x+1)^2+(y+9)^2=65","مربّع المسافة من <span class=\"tx\" data-t=\"P\"></span> إلى <span class=\"tx\" data-t=\"A\"></span>"]],"a":"موقع البرج الرابع <span class=\"tx\" data-t=\"(-1,\\,-9)\"></span>، ومعادلة الدائرة <span class=\"tx\" data-t=\"(x+1)^2+(y+9)^2=65\"></span>","o":""}],[{"n":"7","s":[["(a,b)=(-2,\\,3)","المركز من الرسم"],["r=5-3=2","من المركز إلى أعلى نقطة <span class=\"tx\" data-t=\"(-2,5)\"></span>"],["(x+2)^2+(y-3)^2=4","الصورة القياسية"]],"a":"<span class=m dir=ltr>B)</span> <span class=\"tx\" data-t=\"(x+2)^2+(y-3)^2=4\"