[[{"n":"1","s":[["u=2x^3+5\\Rightarrow du=6x^2\\,dx\\Rightarrow x^2dx=\\frac{du}{6}","بافتراض"],["\\int x^2(2x^3+5)^4dx=\\frac{1}{6}\\int u^4\\,du=\\frac{u^5}{30}+C","بالتعويض"],["=\\frac{(2x^3+5)^5}{30}+C","بإعادة <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{(2x^3+5)^5}{30}+C\"></span>","o":""},{"n":"2","s":[["u=x+3\\Rightarrow du=dx,\\ x=u-3",""],["\\int(u-3)^2u^{1/2}du=\\int(u^{5/2}-6u^{3/2}+9u^{1/2})\\,du","بالتعويض وفك المربع"],["=\\frac{2}{7}u^{7/2}-\\frac{12}{5}u^{5/2}+6u^{3/2}+C",""],["=\\frac{2}{7}(x+3)^{7/2}-\\frac{12}{5}(x+3)^{5/2}+6(x+3)^{3/2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{7}(x+3)^{7/2}-\\frac{12}{5}(x+3)^{5/2}+6(x+3)^{3/2}+C\"></span>","o":""},{"n":"3","s":[["u=x+2\\Rightarrow du=dx,\\ x=u-2",""],["\\int(u-2)u^3du=\\int(u^4-2u^3)\\,du=\\frac{u^5}{5}-\\frac{u^4}{2}+C",""],["=\\frac{(x+2)^5}{5}-\\frac{(x+2)^4}{2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{(x+2)^5}{5}-\\frac{(x+2)^4}{2}+C\"></span>","o":""},{"n":"4","s":[["u=x+4\\Rightarrow du=dx,\\ x=u-4",""],["\\int\\frac{u-4}{\\sqrt u}\\,du=\\int(u^{1/2}-4u^{-1/2})\\,du=\\frac{2}{3}u^{3/2}-8u^{1/2}+C",""],["=\\frac{2}{3}(x+4)^{3/2}-8\\sqrt{x+4}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}(x+4)^{3/2}-8\\sqrt{x+4}+C\"></span>","o":""},{"n":"5","s":[["u=\\sin x\\Rightarrow du=\\cos x\\,dx",""],["\\int e^{u}du=e^{u}+C=e^{\\sin x}+C",""]],"a":"<span class=\"tx\" data-t=\"e^{\\sin x}+C\"></span>","o":""},{"n":"6","s":[["u=e^x+1\\Rightarrow du=e^xdx,\\ e^x=u-1",""],["\\int\\frac{e^{2x}\\cdot e^xdx}{e^x+1}=\\int\\frac{(u-1)^2}{u}\\,du=\\int\\left(u-2+\\frac{1}{u}\\right)du",""],["=\\frac{u^2}{2}-2u+\\ln|u|+C",""],["=\\frac{(e^x+1)^2}{2}-2(e^x+1)+\\ln(e^x+1)+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{(e^x+1)^2}{2}-2(e^x+1)+\\ln(e^x+1)+C\"></span>","o":""}],[{"n":"7","s":[["\\sec^4x=\\sec^2x(1+\\tan^2x)","<span class=\"tx\" data-t=\"\\sec^2x=1+\\tan^2x\"></span>"],["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx",""],["\\int(1+u^2)\\,du=u+\\frac{u^3}{3}+C=\\tan x+\\frac{\\tan^3x}{3}+C",""]],"a":"<span class=\"tx\" data-t=\"\\tan x+\\frac{1}{3}\\tan^3x+C\"></span>","o":""},{"n":"8","s":[["\\frac{\\tan x}{\\cos^2x}=\\tan x\\sec^2x",""],["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx",""],["\\int u\\,du=\\frac{u^2}{2}+C=\\frac{\\tan^2x}{2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\tan^2x+C\"></span>","o":""},{"n":"9","s":[["u=\\ln x\\Rightarrow du=\\frac{1}{x}dx",""],["\\int\\sin u\\,du=-\\cos u+C=-\\cos(\\ln x)+C",""]],"a":"<span class=\"tx\" data-t=\"-\\cos(\\ln x)+C\"></span>","o":""},{"n":"10","s":[["u=4+\\sin^2x\\Rightarrow du=2\\sin x\\cos x\\,dx=\\sin 2x\\,dx",""],["\\int u^3du=\\frac{u^4}{4}+C=\\frac{(4+\\sin^2x)^4}{4}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{(4+\\sin^2x)^4}{4}+C\"></span>","o":""},{"n":"11","s":[["u=e^x+e^{-x}\\Rightarrow du=(e^x-e^{-x})\\,dx",""],["\\int\\frac{2\\,du}{u^2}=-\\frac{2}{u}+C",""],["=-\\frac{2}{e^x+e^{-x}}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{2}{e^x+e^{-x}}+C\"></span>","o":""},{"n":"12","s":[["u=x+1\\Rightarrow du=dx,\\ -x=1-u",""],["\\int\\frac{1-u}{u\\sqrt u}\\,du=\\int(u^{-3/2}-u^{-1/2})\\,du",""],["=-2u^{-1/2}-2u^{1/2}+C",""],["=-\\frac{2}{\\sqrt{x+1}}-2\\sqrt{x+1}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{2}{\\sqrt{x+1}}-2\\sqrt{x+1}+C\"></span>","o":""}],[{"n":"13","s":[["u=x+10\\Rightarrow du=dx,\\ x=u-10",""],["\\int(u-10)u^{1/3}du=\\int(u^{4/3}-10u^{1/3})\\,du",""],["=\\frac{3}{7}u^{7/3}-\\frac{15}{2}u^{4/3}+C",""],["=\\frac{3}{7}(x+10)^{7/3}-\\frac{15}{2}(x+10)^{4/3}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{7}(x+10)^{7/3}-\\frac{15}{2}(x+10)^{4/3}+C\"></span>","o":""},{"n":"14","s":[["u=\\tan\\frac{x}{2}\\Rightarrow du=\\frac{1}{2}\\sec^2\\frac{x}{2}\\,dx",""],["\\int 2u^7du=\\frac{u^8}{4}+C=\\frac{1}{4}\\tan^8\\frac{x}{2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{4}\\tan^8\\frac{x}{2}+C\"></span>","o":""},{"n":"15","s":[["\\frac{\\sec^3x+e^{\\sin x}}{\\sec x}=\\sec^2x+e^{\\sin x}\\cos x","بتوزيع المقام"],["\\int e^{\\sin x}\\cos x\\,dx=e^{\\sin x}","بافتراض <span class=\"tx\" data-t=\"u=\\sin x\"></span>"],["=\\tan x+e^{\\sin x}+C",""]],"a":"<span class=\"tx\" data-t=\"\\tan x+e^{\\sin x}+C\"></span>","o":""},{"n":"16","s":[["\\cos^3x=(1-\\sin^2x)\\cos x",""],["u=\\sin x\\Rightarrow du=\\cos x\\,dx",""],["\\int(1+u^{1/3})(1-u^2)\\,du=\\int(1+u^{1/3}-u^2-u^{7/3})\\,du",""],["=u+\\frac{3}{4}u^{4/3}-\\frac{u^3}{3}-\\frac{3}{10}u^{10/3}+C",""],["=\\sin x+\\frac{3}{4}\\sin^{4/3}x-\\frac{1}{3}\\sin^3x-\\frac{3}{10}\\sin^{10/3}x+C",""]],"a":"<span class=\"tx\" data-t=\"\\sin x+\\frac{3}{4}\\sin^{4/3}x-\\frac{1}{3}\\sin^3x-\\frac{3}{10}\\sin^{10/3}x+C\"></span>","o":""},{"n":"17","s":[["\\sin x\\sec^5x=\\frac{\\sin x}{\\cos^5x}",""],["u=\\cos x\\Rightarrow du=-\\sin x\\,dx",""],["-\\int u^{-5}du=\\frac{u^{-4}}{4}+C=\\frac{1}{4}\\sec^4x+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{4}\\sec^4x+C\"></span>","o":""},{"n":"18","s":[["\\frac{\\sin x+\\tan x}{\\cos^3x}=\\frac{\\sin x}{\\cos^3x}+\\frac{\\sin x}{\\cos^4x}","<span class=\"tx\" data-t=\"\\tan x=\\frac{\\sin x}{\\cos x}\"></span>"],["u=\\cos x\\Rightarrow du=-\\sin x\\,dx",""],["-\\int(u^{-3}+u^{-4})\\,du=\\frac{u^{-2}}{2}+\\frac{u^{-3}}{3}+C",""],["=\\frac{1}{2}\\sec^2x+\\frac{1}{3}\\sec^3x+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\sec^2x+\\frac{1}{3}\\sec^3x+C\"></span>","o":""}],[{"n":"19","s":[["u=\\ln x\\Rightarrow du=\\frac{dx}{x};\\ x=1\\to u=0,\\ x=\\sqrt e\\to u=\\frac{1}{2}","تغيير حدود التكامل"],["\\int_0^{1/2}\\sin\\pi u\\,du=\\left[-\\frac{\\cos\\pi u}{\\pi}\\right]_0^{1/2}",""],["=-\\frac{\\cos\\frac{\\pi}{2}}{\\pi}+\\frac{1}{\\pi}=\\frac{1}{\\pi}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{\\pi}\\approx 0.318\"></span>","o":""},{"n":"20","s":[["u=x^2\\Rightarrow du=2x\\,dx;\\ x=0\\to u=0,\\ x=\\frac{\\pi}{2}\\to u=\\frac{\\pi^2}{4}",""],["\\frac{1}{2}\\int_0^{\\pi^2/4}\\sin u\\,du=\\frac{1}{2}[-\\cos u]_0^{\\pi^2/4}",""],["=\\frac{1}{2}\\left(1-\\cos\\frac{\\pi^2}{4}\\right)",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\\left(1-\\cos\\frac{\\pi^2}{4}\\right)\\approx 0.891\"></span>","o":""},{"n":"21","s":[["u=1+x^2\\Rightarrow du=2x\\,dx,\\ x^2=u-1;\\ 0\\to 1,\\ 1\\to 2",""],["\\int_0^1\\frac{x^2\\cdot x\\,dx}{\\sqrt{1+x^2}}=\\frac{1}{2}\\int_1^2\\frac{u-1}{\\sqrt u}\\,du=\\frac{1}{2}\\left[\\frac{2}{3}u^{3/2}-2u^{1/2}\\right]_1^2",""],["=\\frac{1}{2}\\left[\\left(\\frac{4\\sqrt2}{3}-2\\sqrt2\\right)-\\left(\\frac{2}{3}-2\\right)\\right]",""],["=\\frac{1}{2}\\left(\\frac{4}{3}-\\frac{2\\sqrt2}{3}\\right)=\\frac{2-\\sqrt2}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2-\\sqrt2}{3}\\approx 0.195\"></span>","o":""},{"n":"22","s":[["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx;\\ 0\\to 0,\\ \\frac{\\pi}{3}\\to\\sqrt3",""],["\\int_0^{\\sqrt3}u^5du=\\left[\\frac{u^6}{6}\\right]_0^{\\sqrt3}=\\frac{27}{6}=\\frac{9}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{9}{2}\"></span>","o":""},{"n":"23","s":[["u=(x-1)^2\\Rightarrow du=2(x-1)\\,dx;\\ 1\\to 0,\\ 3\\to 4",""],["\\frac{1}{2}\\int_0^4e^u\\,du=\\frac{1}{2}[e^u]_0^4=\\frac{1}{2}(e^4-1)",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}(e^4-1)\\approx 26.80\"></span>","o":""},{"n":"24","s":[["u=2+\\sqrt x\\Rightarrow du=\\frac{dx}{2\\sqrt x};\\ 1\\to 3,\\ 4\\to 4",""],["2\\int_3^4u^{1/2}du=\\left[\\frac{4}{3}u^{3/2}\\right]_3^4",""],["=\\frac{4}{3}(8-3\\sqrt3)=\\frac{32-12\\sqrt3}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{32}{3}-4\\sqrt3\\approx 3.739\"></span>","o":""}],[{"n":"25","s":[["u=1+x^{3/2}\\Rightarrow du=\\frac{3}{2}x^{1/2}dx;\\ 0\\to 1,\\ 1\\to 2","<span class=\"tx\" data-t=\"\\sqrt{x^3}=x^{3/2}\"></span>"],["\\int_0^1\\frac{10\\sqrt x}{(1+x^{3/2})^2}dx=\\frac{20}{3}\\int_1^2u^{-2}du",""],["=\\frac{20}{3}\\left[-\\frac{1}{u}\\right]_1^2=\\frac{20}{3}\\cdot\\frac{1}{2}=\\frac{10}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{10}{3}\"></span>","o":""},{"n":"26","s":[["u=\\cos x\\Rightarrow du=-\\sin x\\,dx;\\ 0\\to 1,\\ \\frac{\\pi}{6}\\to\\frac{\\sqrt3}{2}",""],["-\\int_1^{\\sqrt3/2}2^u\\,du=\\int_{\\sqrt3/2}^{1}2^u\\,du=\\left[\\frac{2^u}{\\ln 2}\\right]_{\\sqrt3/2}^{1}",""],["=\\frac{2-2^{\\sqrt3/2}}{\\ln 2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2-2^{\\sqrt3/2}}{\\ln 2}\\approx 0.256\"></span>","o":""},{"n":"27","s":[["u=\\cot x\\Rightarrow du=-\\csc^2x\\,dx;\\ \\frac{\\pi}{4}\\to 1,\\ \\frac{\\pi}{2}\\to 0",""],["-\\int_1^0u^5du=\\int_0^1u^5du=\\left[\\frac{u^6}{6}\\right]_0^1=\\frac{1}{6}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""}],[{"n":"28","s":[["A=\\left|\\int_{-1}^0 6x(x^2+1)^3dx\\right|+\\int_0^1 6x(x^2+1)^3dx","المنطقة من <span class=\"tx\" data-t=\"-1\"></span> إلى <span class=\"tx\" data-t=\"0\"></span> تحت المحور"],["u=x^2+1\\Rightarrow du=2x\\,dx:\\ \\int 6x(x^2+1)^3dx=3\\int u^3du=\\frac{3}{4}(x^2+1)^4",""],["\\int_0^1=\\frac{3}{4}(16-1)=\\frac{45}{4},\\quad \\int_{-1}^0=\\frac{3}{4}(1-16)=-\\frac{45}{4}",""],["A=\\frac{45}{4}+\\frac{45}{4}=\\frac{45}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{45}{2}=22.5\"></span> وحدة مربعة","o":""},{"n":"29","s":[["A=\\int_2^4\\frac{x}{(x-1)^3}dx","المنطقة فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["u=x-1\\Rightarrow du=dx,\\ x=u+1;\\ 2\\to 1,\\ 4\\to 3",""],["\\int_1^3\\frac{u+1}{u^3}du=\\int_1^3(u^{-2}+u^{-3})\\,du=\\left[-\\frac{1}{u}-\\frac{1}{2u^2}\\right]_1^3",""],["=\\left(-\\frac{1}{3}-\\frac{1}{18}\\right)-\\left(-1-\\frac{1}{2}\\right)=\\frac{10}{9}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{10}{9}\"></span> وحدة مربعة","o":""},{"n":"30","s":[["u=x^2\\Rightarrow du=2x\\,dx:\\ \\int xe^{x^2}dx=\\frac{1}{2}e^{x^2}",""],["A=\\left|\\left[\\tfrac12e^{x^2}\\right]_{-1}^0\\right|=\\left|\\tfrac12-\\tfrac{e}{2}\\right|=\\frac{e-1}{2}","المنطقة <span class=\"tx\" data-t=\"A\"></span> تحت المحور"],["B=\\left[\\tfrac12e^{x^2}\\right]_0^2=\\frac{e^4-1}{2}","المنطقة <span class=\"tx\" data-t=\"B\"></span> فوق المحور"],["A+B=\\frac{e^4+e-2}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{e^4+e-2}{2}\\approx 27.66\"></span> وحدة مربعة","o":""},{"n":"31","s":[["A=\\int_0^{\\sqrt{\\pi/6}}2x\\cos\\left(x^2+\\frac{\\pi}{6}\\right)dx",""],["u=x^2+\\frac{\\pi}{6}\\Rightarrow du=2x\\,dx;\\ 0\\to\\frac{\\pi}{6},\\ \\sqrt{\\tfrac{\\pi}{6}}\\to\\frac{\\pi}{3}",""],["\\int_{\\pi/6}^{\\pi/3}\\cos u\\,du=\\sin\\frac{\\pi}{3}-\\sin\\frac{\\pi}{6}=\\frac{\\sqrt3-1}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{\\sqrt3-1}{2}\\approx 0.366\"></span> وحدة مربعة","o":""}],[{"n":"32","s":[["u=4x^2-10\\Rightarrow du=8x\\,dx",""],["f(x)=\\int 2x(4x^2-10)^2dx=\\frac{1}{4}\\int u^2du=\\frac{(4x^2-10)^3}{12}+C",""],["f(2)=\\frac{6^3}{12}+C=18+C=10\\Rightarrow C=-8",""],["f(x)=\\frac{(4x^2-10)^3}{12}-8",""]],"a":"<span class=\"tx\" data-t=\"f(x)=\\frac{(4x^2-10)^3}{12}-8\"></span>","o":""},{"n":"33","s":[["u=-0.2x^3\\Rightarrow du=-0.6x^2\\,dx",""],["f(x)=-\\frac{1}{0.6}\\int e^u\\,du=-\\frac{5}{3}e^{-0.2x^3}+C",""],["f(0)=-\\frac{5}{3}+C=\\frac{3}{2}\\Rightarrow C=\\frac{19}{6}",""],["f(x)=-\\frac{5}{3}e^{-0.2x^3}+\\frac{19}{6}",""]],"a":"<span class=\"tx\" data-t=\"f(x)=-\\frac{5}{3}e^{-0.2x^3}+\\frac{19}{6}\"></span>","o":""}],[{"n":"34","s":[["x(x-2)^4=0\\Rightarrow x=0\\ \\text{or}\\ x=2","أصفار الاقتران"],["f'(x)=(x-2)^4+4x(x-2)^3=(x-2)^3(5x-2)",""],["f'(2)=0,\\ f(2)=0","المماس عند <span class=\"tx\" data-t=\"x=2\"></span> أفقي (هو المحور <span class=\"tx\" data-t=\"x\"></span>)"]],"a":"نقطة التماس <span class=\"tx\" data-t=\"(2,0)\"></span>","o":""},{"n":"35","s":[["A=\\int_0^2x(x-2)^4dx","<span class=\"tx\" data-t=\"f(x)\\ge 0\"></span> على <span class=\"tx\" data-t=\"[0,2]\"></span>"],["u=x-2\\Rightarrow du=dx,\\ x=u+2;\\ 0\\to -2,\\ 2\\to 0",""],["\\int_{-2}^0(u+2)u^4du=\\left[\\frac{u^6}{6}+\\frac{2u^5}{5}\\right]_{-2}^0",""],["=0-\\left(\\frac{64}{6}-\\frac{64}{5}\\right)=\\frac{32}{15}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{32}{15}\"></span> وحدة مربعة","o":""}],[{"n":"36","s":[["s(t)=\\int\\sin\\omega t\\cos^2\\omega t\\,dt",""],["u=\\cos\\omega t\\Rightarrow du=-\\omega\\sin\\omega t\\,dt",""],["s(t)=-\\frac{1}{\\omega}\\int u^2du=-\\frac{\\cos^3\\omega t}{3\\omega}+C",""],["s(0)=0\\Rightarrow -\\frac{1}{3\\omega}+C=0\\Rightarrow C=\\frac{1}{3\\omega}",""],["s(t)=\\frac{1-\\cos^3\\omega t}{3\\omega}",""]],"a":"<span class=\"tx\" data-t=\"s(t)=\\frac{1-\\cos^3\\omega t}{3\\omega}\"></span> <span class=m dir=ltr>m</span>","o":""}],[{"n":"37","s":[["u=1+e^{-0.01t}\\Rightarrow du=-0.01e^{-0.01t}dt",""],["C(t)=\\int\\frac{du}{u^2}=-\\frac{1}{u}+K=-\\frac{1}{1+e^{-0.01t}}+K",""],["C(0)=-\\frac{1}{2}+K=0.5\\Rightarrow K=1",""],["C(t)=1-\\frac{1}{1+e^{-0.01t}}=\\frac{e^{-0.01t}}{1+e^{-0.01t}}",""]],"a":"<span class=\"tx\" data-t=\"C(t)=1-\\frac{1}{1+e^{-0.01t}}\"></span>","o":""}],[{"n":"38","s":[["u=e^x-2\\Rightarrow du=e^xdx,\\ e^x=u+2;\\ \\ln 3\\to 1,\\ \\ln 4\\to 2",""],["\\int\\frac{e^{3x}\\cdot e^xdx}{e^x-2}=\\int_1^2\\frac{(u+2)^3}{u}\\,du",""],["=\\int_1^2\\left(u^2+6u+12+\\frac{8}{u}\\right)du=\\left[\\frac{u^3}{3}+3u^2+12u+8\\ln u\\right]_1^2",""],["=\\left(\\frac{8}{3}+36+8\\ln 2\\right)-\\left(\\frac{1}{3}+15\\right)=\\frac{70}{3}+8\\ln 2",""]],"a":"<span class=\"tx\" data-t=\"\\frac{70}{3}+8\\ln 2\"></span> ، أي: <span class=\"tx\" data-t=\"a=70,\\ b=3,\\ c=8,\\ d=2\"></span>","o":""}],[{"n":"39","s":[["f(x)=0:\\ \\cos x=0\\ \\text{or}\\ \\sin x=-1","نقاط التقاطع مع المحور <span class=\"tx\" data-t=\"x\"></span>"],["A:\\ \\sin x=-1\\Rightarrow x=-\\frac{\\pi}{2};\\quad C:\\ x=\\frac{3\\pi}{2}",""],["B:\\ \\cos x=0\\Rightarrow x=\\frac{\\pi}{2}",""],["D:\\ f(0)=3\\cos 0\\sqrt{0+1}=3","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"A\\left(-\\frac{\\pi}{2},0\\right),\\ B\\left(\\frac{\\pi}{2},0\\right),\\ C\\left(\\frac{3\\pi}{2},0\\right),\\ D(0,3)\"></span>","o":""},{"n":"40","s":[["u=\\sin x+1\\Rightarrow du=\\cos x\\,dx:\\ \\int 3\\cos x\\sqrt{\\sin x+1}\\,dx=2(\\sin x+1)^{3/2}",""],["R_1=\\left[2(\\sin x+1)^{3/2}\\right]_{-\\pi/2}^{\\pi/2}=2(2)^{3/2}-0=4\\sqrt2",""],["\\int_{\\pi/2}^{3\\pi/2}f(x)\\,dx=0-4\\sqrt2=-4\\sqrt2\\Rightarrow R_2=4\\sqrt2","تحت المحور"],["A=4\\sqrt2+4\\sqrt2=8\\sqrt2",""]],"a":"<span class=\"tx\" data-t=\"8\\sqrt2\\approx 11.31\"></span> وحدة مربعة","o":""},{"n":"41","s":[["R_1=4\\sqrt2,\\quad R_2=\\left|-4\\sqrt2\\right|=4\\sqrt2","من الفرع السابق"]],"a":"للمنطقتين المساحة نفسها <span class=\"tx\" data-t=\"4\\sqrt2\"></span>","o":""}],[{"n":"42","s":[["u=x^{1/4}\\Rightarrow x=u^4,\\ dx=4u^3du;\\ 1\\to 1,\\ 16\\to 2","حسب الإرشاد"],["\\sqrt x=u^2,\\ \\sqrt[4]{x^3}=u^3",""],["\\int_1^2\\frac{u^2\\cdot 4u^3}{1+u^3}du=4\\int_1^2\\left(u^2-\\frac{u^2}{1+u^3}\\right)du","لأن <span class=\"tx\" data-t=\"u^5=u^2(1+u^3)-u^2\"></span>"],["=4\\left[\\frac{u^3}{3}-\\frac{1}{3}\\ln(1+u^3)\\right]_1^2=4\\left[\\frac{7}{3}-\\frac{1}{3}(\\ln 9-\\ln 2)\\right]",""],["=\\frac{28}{3}-\\frac{4}{3}\\ln\\frac{9}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{28}{3}-\\frac{4}{3}\\ln\\frac{9}{2}\\approx 7.328\"></span>","o":""}],[{"n":"43","s":[["x=\\frac{\\pi}{2}-u\\Rightarrow dx=-du",""],["x=0\\to u=\\frac{\\pi}{2},\\ x=\\frac{\\pi}{2}\\to u=0;\\ \\cos x=\\cos\\left(\\frac{\\pi}{2}-u\\right)=\\sin u",""],["\\int_0^{\\pi/2}f(\\cos x)\\,dx=-\\int_{\\pi/2}^{0}f(\\sin u)\\,du=\\int_0^{\\pi/2}f(\\sin u)\\,du","بعكس الحدود"],["=\\int_0^{\\pi/2}f(\\sin x)\\,dx","المتغير صوري"]],"a":"تحقّقت المساواة","o":""}],[{"n":"44","s":[["u=1-x\\Rightarrow x=1-u,\\ dx=-du;\\ 0\\to 1,\\ 1\\to 0",""],["\\int_0^1x^a(1-x)^bdx=-\\int_1^0(1-u)^au^b\\,du",""],["=\\int_0^1u^b(1-u)^a\\,du=\\int_0^1x^b(1-x)^a\\,dx","بعكس الحدود، والمتغير صوري"]],"a":"تحقّقت المساواة","o":""}],[{"n":"45","s":[["u=\\ln(\\ln x)\\Rightarrow du=\\frac{1}{\\ln x}\\cdot\\frac{1}{x}\\,dx","قاعدة السلسلة"],["\\int\\frac{du}{u}=\\ln|u|+C=\\ln|\\ln(\\ln x)|+C",""]],"a":"<span class=\"tx\" data-t=\"\\ln|\\ln(\\ln x)|+C\"></span>","o":""},{"n":"46","s":[["\\sin 2x=2\\sin x\\cos x",""],["u=1+\\sin x\\Rightarrow du=\\cos x\\,dx,\\ \\sin x=u-1",""],["2\\int(u-1)u^3du=2\\left(\\frac{u^5}{5}-\\frac{u^4}{4}\\right)+C",""],["=\\frac{2}{5}(1+\\sin x)^5-\\frac{1}{2}(1+\\sin x)^4+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}(1+\\sin x)^5-\\frac{1}{2}(1+\\sin x)^4+C\"></span>","o":""},{"n":"47","s":[["x=u^6\\Rightarrow dx=6u^5du,\\ \\sqrt x=u^3,\\ \\sqrt[3]{x}=u^2","المضاعف المشترك الأصغر لـ <span class=m dir=ltr>2</span> و <span class=m dir=ltr>3</span> هو <span class=m dir=ltr>6</span>"],["\\int\\frac{6u^5}{u^3-u^2}du=6\\int\\frac{u^3}{u-1}du",""],["=6\\int\\left(u^2+u+1+\\frac{1}{u-1}\\right)du","بالقسمة الطويلة"],["=2u^3+3u^2+6u+6\\ln|u-1|+C",""],["=2\\sqrt x+3\\sqrt[3]{x}+6\\sqrt[6]{x}+6\\ln\\left|\\sqrt[6]{x}-1\\right|+C",""]],"a":"<span class=\"tx\" data-t=\"2\\sqrt x+3\\sqrt[3]{x}+6\\sqrt[6]{x}+6\\ln\\left|\\sqrt[6]{x}-1\\right|+C\"></span>","o":""}],[{"n":"23","s":[["u=1+\\tan x,\\ du=\\sec^2x\\,dx,\\ \\tan x=u-1","بالتعويض"],["\\int(u-1)\\sqrt{u}\\,du=\\int(u^{3/2}-u^{1/2})\\,du",""],["=\\frac{2}{5}u^{5/2}-\\frac{2}{3}u^{3/2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}(1+\\tan x)^{5/2}-\\frac{2}{3}(1+\\tan x)^{3/2}+C\"></span>","o":""},{"n":"24","s":[["u=4-3x,\\ x=\\frac{4-u}{3},\\ dx=-\\frac{1}{3}du","بالتعويض"],["\\int\\frac{\\frac{4-u}{3}}{u^{1/3}}\\left(-\\frac{1}{3}\\right)du=-\\frac{1}{9}\\int(4u^{-1/3}-u^{2/3})\\,du",""],["=-\\frac{1}{9}\\left(6u^{2/3}-\\frac{3}{5}u^{5/3}\\right)+C=-\\frac{2}{3}u^{2/3}+\\frac{1}{15}u^{5/3}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{2}{3}(4-3x)^{2/3}+\\frac{1}{15}(4-3x)^{5/3}+C\"></span>","o":""},{"n":"25","s":[["u=\\ln x,\\ du=\\frac{1}{x}\\,dx","بالتعويض"],["\\int u^6\\,du=\\frac{u^7}{7}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{(\\ln x)^7}{7}+C\"></span>","o":""}],[{"n":"26","s":[["u=x-2,\\ x+1=u+3,\\ dx=du","بالتعويض"],["\\int(u+3)^2\\sqrt{u}\\,du=\\int(u^{5/2}+6u^{3/2}+9u^{1/2})\\,du","بفك المربع والتوزيع"],["=\\frac{2}{7}u^{7/2}+\\frac{12}{5}u^{5/2}+6u^{3/2}+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{7}(x-2)^{7/2}+\\frac{12}{5}(x-2)^{5/2}+6(x-2)^{3/2}+C\"></span>","o":""}],[{"n":"30","s":[["u=t^2,\\ du=2t\\,dt;\\quad t=0\\to u=0,\\ t=1\\to u=1","بالتعويض وتغيير الحدود"],["\\int_0^1 t\\,3^{t^2}\\,dt=\\frac{1}{2}\\int_0^1 3^u\\,du=\\frac{1}{2}\\left[\\frac{3^u}{\\ln 3}\\right]_0^1",""],["=\\frac{1}{2}\\cdot\\frac{3-1}{\\ln 3}=\\frac{1}{\\ln 3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{\\ln 3}\\approx 0.9102\"></span>","o":""},{"n":"31","s":[["\\cot^3x=\\cot x(\\csc^2x-1)=\\cot x\\csc^2x-\\cot x","متطابقة فيثاغورس"],["\\int\\cot^3x\\,dx=-\\frac{\\cot^2x}{2}-\\ln|\\sin x|","بالتعويض <span class=m dir=ltr>u = cot x</span> للحد الأول"],["\\left[-\\frac{\\cot^2x}{2}-\\ln\\sin x\\right]_{\\pi/4}^{\\pi/3}=\\left(-\\frac{1}{6}-\\ln\\frac{\\sqrt{3}}{2}\\right)-\\left(-\\frac{1}{2}-\\ln\\frac{\\sqrt{2}}{2}\\right)",""],["=\\frac{1}{3}+\\ln\\frac{\\sqrt{2}}{\\sqrt{3}}=\\frac{1}{3}-\\frac{1}{2}\\ln\\frac{3}{2}","خصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}-\\frac{1}{2}\\ln\\frac{3}{2}\\approx 0.1306\"></span>","o":""}],[{"n":"32","s":[["u=4+3\\sin x,\\ du=3\\cos x\\,dx","بالتعويض"],["x=-\\frac{\\pi}{2}\\to u=1,\\quad x=\\pi\\to u=4","بتغيير حدود التكامل"],["\\frac{1}{3}\\int_1^4 u^{-1/2}\\,du=\\frac{1}{3}\\left[2\\sqrt{u}\\right]_1^4=\\frac{2}{3}(2-1)",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>","o":""}],[{"n":"60","s":[["p(x)=\\int\\frac{-300x}{(9+x^2)^{3/2}}\\,dx","الاقتران الأصلي لمعدل التغير"],["u=9+x^2,\\ du=2x\\,dx \\Rightarrow -150\\int u^{-3/2}\\,du=300u^{-1/2}+C","بالتعويض"],["p(x)=\\frac{300}{\\sqrt{9+x^2}}+C",""],["75=\\frac{300}{\\sqrt{9+16}}+C=60+C \\Rightarrow C=15","<span class=m dir=ltr>400</span> قطعة تعني <span class=m dir=ltr>x = 4 (</span>بالمئات)"]],"a":"<span class=\"tx\" data-t=\"p(x)=\\dfrac{300}{\\sqrt{9+x^2}}+15\"></span>","o":""}],[{"n":"1","s":[["u=x^2+4\\Rightarrow du=2x\\,dx\\Rightarrow x\\,dx=\\frac{1}{2}du","بفرض التعويض"],["\\int\\frac{x}{\\sqrt{x^2+4}}dx=\\int\\frac{1}{2}u^{-1/2}du=u^{1/2}+C","بالتعويض والتكامل"],["=\\sqrt{x^2+4}+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{x^2+4}+C\"></span>","o":""},{"n":"2","s":[["u=1-\\cos\\frac{x}{2}\\Rightarrow du=\\frac{1}{2}\\sin\\frac{x}{2}\\,dx","بفرض التعويض"],["\\int\\left(1-\\cos\\frac{x}{2}\\right)^2\\sin\\frac{x}{2}dx=\\int2u^2du","<span class=\"tx\" data-t=\"\\sin\\frac{x}{2}dx=2\\,du\"></span>"],["=\\frac{2}{3}u^3+C=\\frac{2}{3}\\left(1-\\cos\\frac{x}{2}\\right)^3+C","بالتكامل وإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\\left(1-\\cos\\frac{x}{2}\\right)^3+C\"></span>","o":""},{"n":"3","s":[["\\csc^5x\\cos^3x=\\frac{\\cos^3x}{\\sin^3x}\\cdot\\frac{1}{\\sin^2x}=\\cot^3x\\csc^2x","بإعادة الكتابة"],["u=\\cot x\\Rightarrow du=-\\csc^2x\\,dx","بفرض التعويض"],["\\int\\cot^3x\\csc^2x\\,dx=-\\int u^3du=-\\frac{u^4}{4}+C","بالتعويض والتكامل"],["=-\\frac{1}{4}\\cot^4x+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{4}\\cot^4x+C\"></span>","o":""},{"n":"4","s":[["u=x^2\\Rightarrow du=2x\\,dx","بفرض التعويض"],["\\int x\\sin x^2dx=\\frac{1}{2}\\int\\sin u\\,du=-\\frac{1}{2}\\cos u+C","بالتعويض والتكامل"],["=-\\frac{1}{2}\\cos x^2+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{2}\\cos x^2+C\"></span>","o":""},{"n":"5","s":[["u=x+2\\Rightarrow x=u-2,\\ dx=du","بفرض التعويض"],["\\int x^3(x+2)^7dx=\\int(u-2)^3u^7du","بالتعويض"],["=\\int(u^{10}-6u^9+12u^8-8u^7)du","بفك <span class=\"tx\" data-t=\"(u-2)^3=u^3-6u^2+12u-8\"></span>"],["=\\frac{u^{11}}{11}-\\frac{3u^{10}}{5}+\\frac{4u^9}{3}-u^8+C","بالتكامل"],["=\\frac{(x+2)^{11}}{11}-\\frac{3(x+2)^{10}}{5}+\\frac{4(x+2)^9}{3}-(x+2)^8+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{(x+2)^{11}}{11}-\\frac{3(x+2)^{10}}{5}+\\frac{4(x+2)^9}{3}-(x+2)^8+C\"></span>","o":""},{"n":"6","s":[["\\ln\\sqrt x=\\frac{1}{2}\\ln x","خصائص اللوغاريتم"],["u=\\ln x\\Rightarrow du=\\frac{1}{x}dx","بفرض التعويض"],["\\int\\frac{\\ln\\sqrt x}{x}dx=\\frac{1}{2}\\int u\\,du=\\frac{u^2}{4}+C","بالتعويض والتكامل"],["=\\frac{1}{4}(\\ln x)^2+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{4}(\\ln x)^2+C\"></span>","o":""}],[{"n":"7","s":[["u=\\sqrt x\\Rightarrow du=\\frac{1}{2\\sqrt x}dx","بفرض التعويض"],["\\int\\frac{e^{\\sqrt x}}{\\sqrt x}dx=2\\int e^udu=2e^u+C","بالتعويض والتكامل"],["=2e^{\\sqrt x}+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"2e^{\\sqrt x}+C\"></span>","o":""},{"n":"8","s":[["u=\\ln4x^2\\Rightarrow du=\\frac{8x}{4x^2}dx=\\frac{2}{x}dx","بفرض التعويض"],["\\int\\frac{\\sin(\\ln4x^2)}{x}dx=\\frac{1}{2}\\int\\sin u\\,du=-\\frac{1}{2}\\cos u+C","بالتعويض والتكامل"],["=-\\frac{1}{2}\\cos(\\ln4x^2)+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{2}\\cos(\\ln4x^2)+C\"></span>","o":""},{"n":"9","s":[["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx","بفرض التعويض"],["\\int\\sec^2x\\cos^3(\\tan x)dx=\\int\\cos^3u\\,du=\\int(1-\\sin^2u)\\cos u\\,du","<span class=\"tx\" data-t=\"\\cos^2u=1-\\sin^2u\"></span>"],["=\\sin u-\\frac{1}{3}\\sin^3u+C","بالتعويض <span class=\"tx\" data-t=\"w=\\sin u\"></span> ثم التكامل"],["=\\sin(\\tan x)-\\frac{1}{3}\\sin^3(\\tan x)+C","بإرجاع <span class=\"tx\" data-t=\"u\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin(\\tan x)-\\frac{1}{3}\\sin^3(\\tan x)+C\"></span>","o":""}],[{"n":"10","s":[["u=4x+1\\Rightarrow x=\\frac{u-1}{4},\\ dx=\\frac{1}{4}du","بفرض التعويض"],["x=6\\Rightarrow u=25,\\quad x=20\\Rightarrow u=81","تغيير حدود التكامل"],["\\int_6^{20}\\frac{8x}{\\sqrt{4x+1}}dx=\\int_{25}^{81}\\frac{2(u-1)}{\\sqrt u}\\cdot\\frac{1}{4}du=\\frac{1}{2}\\int_{25}^{81}(u^{1/2}-u^{-1/2})du","بالتعويض"],["=\\left.\\left(\\frac{1}{3}u^{3/2}-u^{1/2}\\right)\\right|_{25}^{81}=(243-9)-\\left(\\frac{125}{3}-5\\right)","بالتكامل والتعويض"],["=234-\\frac{110}{3}=\\frac{592}{3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{592}{3}\\approx197.33\"></span>","o":""},{"n":"11","s":[["u=\\sqrt{x-1}\\Rightarrow x=u^2+1,\\ dx=2u\\,du","بفرض التعويض"],["x=2\\Rightarrow u=1,\\quad x=5\\Rightarrow u=2","تغيير حدود التكامل"],["\\int_1^2\\frac{2u}{1+u}du=\\int_1^2\\left(2-\\frac{2}{1+u}\\right)du","بالقسمة"],["=\\left.\\left(2u-2\\ln(1+u)\\right)\\right|_1^2=(4-2\\ln3)-(2-2\\ln2)","بالتكامل والتعويض"],["=2-2\\ln\\frac{3}{2}","خصائص اللوغاريتم"]],"a":"<span class=\"tx\" data-t=\"2-2\\ln\\frac{3}{2}\\approx1.1891\"></span>","o":""},{"n":"12","s":[["\\frac{\\sin2x}{1+\\cos x}=\\frac{2\\sin x\\cos x}{1+\\cos x}","متطابقة ضعف الزاوية"],["u=1+\\cos x\\Rightarrow du=-\\sin x\\,dx,\\ \\cos x=u-1","بفرض التعويض"],["x=0\\Rightarrow u=2,\\quad x=\\frac{\\pi}{2}\\Rightarrow u=1","تغيير حدود التكامل"],["\\int_2^1\\frac{2(u-1)}{u}(-du)=\\int_1^2\\left(2-\\frac{2}{u}\\right)du","بالتعويض وقلب الحدود"],["=\\left.(2u-2\\ln u)\\right|_1^2=(4-2\\ln2)-2=2-2\\ln2","بالتكامل والتعويض"]],"a":"<span class=\"tx\" data-t=\"2-2\\ln2\\approx0.6137\"></span>","o":""},{"n":"13","s":[["u=1+\\sqrt x\\Rightarrow du=\\frac{1}{2\\sqrt x}dx","بفرض التعويض"],["x=1\\Rightarrow u=2,\\quad x=4\\Rightarrow u=3","تغيير حدود التكامل"],["\\int_1^4\\frac{(1+\\sqrt x)^3}{\\sqrt x}dx=\\int_2^3 2u^3du=\\left.\\frac{u^4}{2}\\right|_2^3","بالتعويض والتكامل"],["=\\frac{81-16}{2}=\\frac{65}{2}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{65}{2}=32.5\"></span>","o":""},{"n":"14","s":[["u=\\tan x\\Rightarrow du=\\sec^2x\\,dx=\\frac{1}{\\cos^2x}dx","بفرض التعويض"],["x=0\\Rightarrow u=0,\\quad x=\\frac{\\pi}{4}\\Rightarrow u=1","تغيير حدود التكامل"],["\\int_0^1e^udu=\\left.e^u\\right|_0^1=e-1","بالتكامل والتعويض"]],"a":"<span class=\"tx\" data-t=\"e-1\\approx1.7183\"></span>","o":""},{"n":"15","s":[["\\cos^2x\\sin^3x=\\cos^2x(1-\\cos^2x)\\sin x","<span class=\"tx\" data-t=\"\\sin^2x=1-\\cos^2x\"></span>"],["u=\\cos x\\Rightarrow du=-\\sin x\\,dx;\\ x=0\\Rightarrow u=1,\\ x=\\frac{\\pi}{3}\\Rightarrow u=\\frac{1}{2}","بفرض التعويض وتغيير الحدود"],["\\int_1^{1/2}(u^2-u^4)(-du)=\\int_{1/2}^{1}(u^2-u^4)du=\\left.\\left(\\frac{u^3}{3}-\\frac{u^5}{5}\\right)\\right|_{1/2}^{1}","بالتعويض والتكامل"],["=\\left(\\frac{1}{3}-\\frac{1}{5}\\right)-\\left(\\frac{1}{24}-\\frac{1}{160}\\right)=\\frac{2}{15}-\\frac{17}{480}=\\frac{47}{480}","بالتعويض والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{47}{480}\\approx0.0979\"></span>","o":""}],[{"n":"16","s":[["x\\sqrt{x+1}=0\\Rightarrow x=0\\ \\text{أو}\\ x=-1","إذن <span class=\"tx\" data-t=\"A(-1,0)\"></span>، والمنطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[-1,0]\"></span>"],["u=x+1\\Rightarrow x=u-1,\\ dx=du;\\ x=-1\\Rightarrow u=0,\\ x=0\\Rightarrow u=1","بفرض التعويض"],["\\int_{-1}^0x\\sqrt{x+1}dx=\\int_0^1(u-1)u^{1/2}du=\\int_0^1(u^{3/2}-u^{1/2})du","بالتعويض"],["=\\left.\\left(\\frac{2}{5}u^{5/2}-\\frac{2}{3}u^{3/2}\\right)\\right|_0^1=\\frac{2}{5}-\\frac{2}{3}=-\\frac{4}{15}","بالتكامل"],["A=\\left|-\\frac{4}{15}\\right|=\\frac{4}{15}","المساحة قيمة موجبة"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{4}{15}\"></span> وحدة مربعة","o":""}],[{"n":"17","s":[["u=\\cos x\\Rightarrow du=-\\sin x\\,dx","بفرض التعويض"],["f(x)=\\int16\\sin x\\cos^3x\\,dx=-16\\int u^3du=-4u^4+C=-4\\cos^4x+C","بالتعويض والتكامل"],["f\\left(\\frac{\\pi}{4}\\right)=0\\Rightarrow-4\\left(\\frac{\\sqrt2}{2}\\right)^4+C=0\\Rightarrow-1+C=0\\Rightarrow C=1","بتعويض النقطة"]],"a":"<span class=\"tx\" data-t=\"f(x)=1-4\\cos^4x\"></span>","o":""},{"n":"18","s":[["u=x^2+5\\Rightarrow du=2x\\,dx","بفرض التعويض"],["f(x)=\\int\\frac{x}{\\sqrt{x^2+5}}dx=\\frac{1}{2}\\int u^{-1/2}du=\\sqrt{x^2+5}+C","بالتعويض والتكامل"],["f(2)=1\\Rightarrow\\sqrt9+C=1\\Rightarrow C=-2","بتعويض النقطة <span class=\"tx\" data-t=\"(2,1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=\\sqrt{x^2+5}-2\"></span>","o":""}],[{"n":"19","s":[["s(t)=\\int\\frac{-2t}{(1+t^2)^{3/2}}dt","الموقع تكامل السرعة"],["u=1+t^2\\Rightarrow du=2t\\,dt","بفرض التعويض"],["s(t)=-\\int u^{-3/2}du=2u^{-1/2}+C=\\frac{2}{\\sqrt{1+t^2}}+C","بالتعويض والتكامل"],["s(0)=4\\Rightarrow2+C=4\\Rightarrow C=2","الموقع الابتدائي"]],"a":"<span class=\"tx\" data-t=\"s(t)=\\frac{2}{\\sqrt{1+t^2}}+2\"></span> مترًا","o":""}]]