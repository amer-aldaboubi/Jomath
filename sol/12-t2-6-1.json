[[{"n":"1","s":[["(4, 5, 3)","النقطة المعطاة"],["x=4,\\ y=5,\\ z=3","نتحرك على محور <span class=m dir=ltr>x</span> ثم موازيًا لمحور <span class=m dir=ltr>y</span> ثم موازيًا لمحور <span class=m dir=ltr>z</span>"]],"a":"نعيّن النقطة <span class=\"tx\" data-t=\"(4, 5, 3)\"></span> في الفضاء","o":"نبدأ من نقطة الأصل، نتحرك <span class=m dir=ltr>4</span> وحدات في الاتجاه الموجب لمحور <span class=\"tx\" data-t=\"x\"></span>، ثم <span class=m dir=ltr>5</span> وحدات في الاتجاه الموجب لمحور <span class=\"tx\" data-t=\"y\"></span>، ثم <span class=m dir=ltr>3</span> وحدات إلى الأعلى موازيًا لمحور <span class=\"tx\" data-t=\"z\"></span>."},{"n":"2","s":[["(-2, 3, -5)","النقطة المعطاة"],["x=-2,\\ y=3,\\ z=-5","نتحرك على محور <span class=m dir=ltr>x</span> ثم موازيًا لمحور <span class=m dir=ltr>y</span> ثم موازيًا لمحور <span class=m dir=ltr>z</span>"]],"a":"نعيّن النقطة <span class=\"tx\" data-t=\"(-2, 3, -5)\"></span> في الفضاء","o":"نبدأ من نقطة الأصل، نتحرك <span class=m dir=ltr>2</span> وحدات في الاتجاه السالب لمحور <span class=\"tx\" data-t=\"x\"></span>، ثم <span class=m dir=ltr>3</span> وحدات في الاتجاه الموجب لمحور <span class=\"tx\" data-t=\"y\"></span>، ثم <span class=m dir=ltr>5</span> وحدات إلى الأسفل موازيًا لمحور <span class=\"tx\" data-t=\"z\"></span>."},{"n":"3","s":[["(4, 0, -3)","النقطة المعطاة"],["y = 0","النقطة تقع في المستوى <span class=m dir=ltr>xz</span>"]],"a":"نعيّن النقطة <span class=\"tx\" data-t=\"(4, 0, -3)\"></span> في المستوى <span class=\"tx\" data-t=\"xz\"></span>","o":"نتحرك <span class=m dir=ltr>4</span> وحدات في الاتجاه الموجب لمحور <span class=\"tx\" data-t=\"x\"></span>، ولا نتحرك على محور <span class=\"tx\" data-t=\"y\"></span>، ثم <span class=m dir=ltr>3</span> وحدات إلى الأسفل موازيًا لمحور <span class=\"tx\" data-t=\"z\"></span>."}],[{"n":"4","s":[["AB=\\sqrt{(5-(3))^2+(4-(-2))^2+(2-(8))^2}","صيغة المسافة بين نقطتين في الفضاء"],["=\\sqrt{76} = 2\\sqrt{19} \\approx 8.72","بالتبسيط"],["M\\left(\\frac{3+(5)}{2}, \\frac{-2+(4)}{2}, \\frac{8+(2)}{2}\\right) = (4, 1, 5)","صيغة نقطة المنتصف"]],"a":"الطول <span class=\"tx\" data-t=\"= 2\\sqrt{19}\"></span> <span class=\"tx\" data-t=\"\\approx 8.72\"></span>، ونقطة المنتصف <span class=\"tx\" data-t=\"(4, 1, 5)\"></span>","o":""},{"n":"5","s":[["AB=\\sqrt{(2-(-2))^2+(-5-(7))^2+(3-(0))^2}","صيغة المسافة بين نقطتين في الفضاء"],["=\\sqrt{169} = 13","بالتبسيط"],["M\\left(\\frac{-2+(2)}{2}, \\frac{7+(-5)}{2}, \\frac{0+(3)}{2}\\right) = \\left(0, 1, \\frac{3}{2}\\right)","صيغة نقطة المنتصف"]],"a":"الطول <span class=\"tx\" data-t=\"= 13\"></span>، ونقطة المنتصف <span class=\"tx\" data-t=\"\\left(0, 1, \\frac{3}{2}\\right)\"></span>","o":""},{"n":"6","s":[["AB=\\sqrt{(-3-(12))^2+(6-(8))^2+(7-(-5))^2}","صيغة المسافة بين نقطتين في الفضاء"],["=\\sqrt{373} = \\sqrt{373} \\approx 19.31","بالتبسيط"],["M\\left(\\frac{12+(-3)}{2}, \\frac{8+(6)}{2}, \\frac{-5+(7)}{2}\\right) = \\left(\\frac{9}{2}, 7, 1\\right)","صيغة نقطة المنتصف"]],"a":"الطول <span class=\"tx\" data-t=\"= \\sqrt{373}\"></span> <span class=\"tx\" data-t=\"\\approx 19.31\"></span>، ونقطة المنتصف <span class=\"tx\" data-t=\"\\left(\\frac{9}{2}, 7, 1\\right)\"></span>","o":""},{"n":"7","s":[["AB=\\sqrt{(3-(-5))^2+(2-(-8))^2+(-6-(4))^2}","صيغة المسافة بين نقطتين في الفضاء"],["=\\sqrt{264} = 2\\sqrt{66} \\approx 16.25","بالتبسيط"],["M\\left(\\frac{-5+(3)}{2}, \\frac{-8+(2)}{2}, \\frac{4+(-6)}{2}\\right) = (-1, -3, -1)","صيغة نقطة المنتصف"]],"a":"الطول <span class=\"tx\" data-t=\"= 2\\sqrt{66}\"></span> <span class=\"tx\" data-t=\"\\approx 16.25\"></span>، ونقطة المنتصف <span class=\"tx\" data-t=\"(-1, -3, -1)\"></span>","o":""}],[{"n":"8","s":[["\\vec{v} = \\langle -3, -4, 5 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (-3, -4, 5)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(-3, -4, 5)\"></span>","o":"نعيّن النقطة <span class=\"tx\" data-t=\"(-3, -4, 5)\"></span> (على الورق المنقّط متساوي القياس) ثم نرسم سهمًا يبدأ من نقطة الأصل وينتهي عندها."},{"n":"9","s":[["\\vec{m} = \\langle 2, -3, -4 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (2, -3, -4)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(2, -3, -4)\"></span>","o":"نعيّن النقطة <span class=\"tx\" data-t=\"(2, -3, -4)\"></span> (على الورق المنقّط متساوي القياس) ثم نرسم سهمًا يبدأ من نقطة الأصل وينتهي عندها."},{"n":"10","s":[["\\vec{p} = \\langle -3, 5, -2 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (-3, 5, -2)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(-3, 5, -2)\"></span>","o":"نعيّن النقطة <span class=\"tx\" data-t=\"(-3, 5, -2)\"></span> (على الورق المنقّط متساوي القياس) ثم نرسم سهمًا يبدأ من نقطة الأصل وينتهي عندها."},{"n":"11","s":[["\\vec{e} = -5\\hat{\\mathbf{i}}+3\\hat{\\mathbf{j}}+4\\hat{\\mathbf{k}}","المتجه المعطى"],["\\vec{e} = \\langle -5, 3, 4 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (-5, 3, 4)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(-5, 3, 4)\"></span>","o":"نعيّن النقطة <span class=\"tx\" data-t=\"(-5, 3, 4)\"></span> (على الورق المنقّط متساوي القياس) ثم نرسم سهمًا يبدأ من نقطة الأصل وينتهي عندها."},{"n":"12","s":[["\\overrightarrow{AB} = \\langle -3-4, 6-1, 3-1 \\rangle","نطرح إحداثيات البداية من إحداثيات النهاية"],["\\overrightarrow{AB} = \\langle -7, 5, 2 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (-7, 5, 2)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(-7, 5, 2)\"></span>","o":"يمكن أيضًا رسمه من <span class=\"tx\" data-t=\"A(4,1,1)\"></span> إلى <span class=\"tx\" data-t=\"B(-3,6,3)\"></span>؛ وفي الوضع القياسي نرسمه من نقطة الأصل إلى <span class=\"tx\" data-t=\"(-7, 5, 2)\"></span>."},{"n":"13","s":[["\\overrightarrow{GH} = \\langle 0-1, 4-(-3), -2-5 \\rangle","نطرح إحداثيات البداية من إحداثيات النهاية"],["\\overrightarrow{GH} = \\langle -1, 7, -7 \\rangle","الصورة الإحداثية للمتجه"],["(0,0,0) \\to (-1, 7, -7)","نرسمه في الوضع القياسي من نقطة الأصل"]],"a":"نمثّل المتجه بسهم من نقطة الأصل إلى النقطة <span class=\"tx\" data-t=\"(-1, 7, -7)\"></span>","o":"يمكن أيضًا رسمه من <span class=\"tx\" data-t=\"G(1,-3,5)\"></span> إلى <span class=\"tx\" data-t=\"H(0,4,-2)\"></span>؛ وفي الوضع القياسي من نقطة الأصل إلى <span class=\"tx\" data-t=\"(-1, 7, -7)\"></span>."}],[{"n":"14","s":[["\\overrightarrow{AB} = \\langle -3-(4), 2-(6), 5-(9) \\rangle","نطرح إحداثيات نقطة البداية من إحداثيات نقطة النهاية"],["\\overrightarrow{AB} = \\langle -7, -4, -4 \\rangle","بالتبسيط"],["|\\overrightarrow{AB}| = \\sqrt{(-7)^2+(-4)^2+(-4)^2}","صيغة مقدار المتجه"],["= \\sqrt{81} = 9","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB} = \\langle -7, -4, -4 \\rangle\"></span>، و <span class=\"tx\" data-t=\"|\\overrightarrow{AB}| = 9\"></span>","o":""},{"n":"15","s":[["\\overrightarrow{AB} = \\langle 6-(-8), 3-(5), 2-(7) \\rangle","نطرح إحداثيات نقطة البداية من إحداثيات نقطة النهاية"],["\\overrightarrow{AB} = \\langle 14, -2, -5 \\rangle","بالتبسيط"],["|\\overrightarrow{AB}| = \\sqrt{(14)^2+(-2)^2+(-5)^2}","صيغة مقدار المتجه"],["= \\sqrt{225} = 15","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB} = \\langle 14, -2, -5 \\rangle\"></span>، و <span class=\"tx\" data-t=\"|\\overrightarrow{AB}| = 15\"></span>","o":""},{"n":"16","s":[["\\overrightarrow{AB} = \\langle 4-(12), 1-(-5), -1-(4) \\rangle","نطرح إحداثيات نقطة البداية من إحداثيات نقطة النهاية"],["\\overrightarrow{AB} = \\langle -8, 6, -5 \\rangle","بالتبسيط"],["|\\overrightarrow{AB}| = \\sqrt{(-8)^2+(6)^2+(-5)^2}","صيغة مقدار المتجه"],["= \\sqrt{125} = 5\\sqrt{5} \\approx 11.18","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB} = \\langle -8, 6, -5 \\rangle\"></span>، و <span class=\"tx\" data-t=\"|\\overrightarrow{AB}| = 5\\sqrt{5}\"></span> <span class=\"tx\" data-t=\"\\approx 11.18\"></span>","o":""},{"n":"17","s":[["\\overrightarrow{AB} = \\langle 10-(24), 6-(-8), 3-(10) \\rangle","نطرح إحداثيات نقطة البداية من إحداثيات نقطة النهاية"],["\\overrightarrow{AB} = \\langle -14, 14, -7 \\rangle","بالتبسيط"],["|\\overrightarrow{AB}| = \\sqrt{(-14)^2+(14)^2+(-7)^2}","صيغة مقدار المتجه"],["= \\sqrt{441} = 21","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB} = \\langle -14, 14, -7 \\rangle\"></span>، و <span class=\"tx\" data-t=\"|\\overrightarrow{AB}| = 21\"></span>","o":""}],[{"n":"18","s":[["\\overrightarrow{AB} = \\overrightarrow{AO} + \\overrightarrow{OB} = -\\vec{a} + \\vec{b}","قاعدة المثلث لجمع المتجهات"],["\\overrightarrow{AC} = \\frac{1}{2}\\overrightarrow{AB} = \\frac{1}{2}(\\vec{b} - \\vec{a})","<span class=m dir=ltr>C</span> منتصف <span class=m dir=ltr>AB</span>"],["\\overrightarrow{OC} = \\overrightarrow{OA} + \\overrightarrow{AC} = \\vec{a} + \\frac{1}{2}\\vec{b} - \\frac{1}{2}\\vec{a}","قاعدة المثلث"],["\\overrightarrow{OC} = \\frac{1}{2}\\vec{a} + \\frac{1}{2}\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OC} = \\frac{1}{2}(\\vec{a} + \\vec{b})\"></span>","o":""}],[{"n":"19","s":[["\\overrightarrow{SQ} = \\overrightarrow{SP} + \\overrightarrow{PQ}","قاعدة المثلث"],["\\overrightarrow{SP} = -\\overrightarrow{PS} = -\\vec{b}","المتجه المعاكس"],["\\overrightarrow{SQ} = -\\vec{b} + \\vec{a}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{SQ} = \\vec{a} - \\vec{b}\"></span>","o":""},{"n":"20","s":[["\\overrightarrow{NQ} = \\frac{2}{5}\\overrightarrow{SQ} = \\frac{2}{5}(\\vec{a} - \\vec{b})","لأن <span class=m dir=ltr>SN</span> : <span class=m dir=ltr>NQ = 3</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{QR} = \\overrightarrow{PS} = \\vec{b}","ضلعان متقابلان في متوازي الأضلاع"],["\\overrightarrow{NR} = \\overrightarrow{NQ} + \\overrightarrow{QR} = \\frac{2}{5}\\vec{a} - \\frac{2}{5}\\vec{b} + \\vec{b}","قاعدة المثلث"],["\\overrightarrow{NR} = \\frac{2}{5}\\vec{a} + \\frac{3}{5}\\vec{b}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{NR} = \\frac{2}{5}\\vec{a} + \\frac{3}{5}\\vec{b} = \\frac{1}{5}(2\\vec{a} + 3\\vec{b})\"></span>","o":""}],[{"n":"21","s":[["3\\vec{e} + 4\\vec{f} = 3\\langle -3, 9, -4 \\rangle + 4\\langle 5, -3, 7 \\rangle","بالتعويض"],["\\langle -9, 27, -12 \\rangle + \\langle 20, -12, 28 \\rangle","ضرب المتجه في عدد حقيقي"],["\\langle 11, 15, 16 \\rangle","جمع المتجهات"]],"a":"<span class=\"tx\" data-t=\"\\langle 11, 15, 16 \\rangle\"></span>","o":""},{"n":"22","s":[["\\vec{e} + \\vec{f} - 3\\vec{g} = \\langle -3, 9, -4 \\rangle + \\langle 5, -3, 7 \\rangle - 3\\langle -1, 8, -5 \\rangle","بالتعويض"],["\\langle -3, 9, -4 \\rangle + \\langle 5, -3, 7 \\rangle + \\langle 3, -24, 15 \\rangle","ضرب المتجه في عدد حقيقي"],["\\langle 5, -18, 18 \\rangle","جمع المتجهات"]],"a":"<span class=\"tx\" data-t=\"\\langle 5, -18, 18 \\rangle\"></span>","o":""},{"n":"23","s":[["4\\vec{e} - 2\\vec{f} + 3\\vec{g} = \\langle -12, 36, -16 \\rangle + \\langle -10, 6, -14 \\rangle + \\langle -3, 24, -15 \\rangle","ضرب كل متجه في العدد المعطى"],["\\langle -25, 66, -45 \\rangle","جمع المتجهات"]],"a":"<span class=\"tx\" data-t=\"\\langle -25, 66, -45 \\rangle\"></span>","o":""},{"n":"24","s":[["2\\vec{e} + 7\\vec{f} - 2\\vec{g} = \\langle -6, 18, -8 \\rangle + \\langle 35, -21, 49 \\rangle + \\langle 2, -16, 10 \\rangle","ضرب كل متجه في العدد المعطى"],["\\langle 31, -19, 51 \\rangle","جمع المتجهات"]],"a":"<span class=\"tx\" data-t=\"\\langle 31, -19, 51 \\rangle\"></span>","o":""}],[{"n":"25","s":[["\\overrightarrow{OA} = \\langle -1, 6, 5 \\rangle,\\ \\overrightarrow{OB} = \\langle 0, 1, -4 \\rangle,\\ \\overrightarrow{OC} = \\langle 2, 1, 1 \\rangle","متجه الموقع للنقطة هو إحداثياتها"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OA} = \\langle -1, 6, 5 \\rangle\"></span>، <span class=\"tx\" data-t=\"\\overrightarrow{OB} = \\langle 0, 1, -4 \\rangle\"></span>، <span class=\"tx\" data-t=\"\\overrightarrow{OC} = \\langle 2, 1, 1 \\rangle\"></span>","o":""},{"n":"26","s":[["\\overrightarrow{BA} = \\langle -1-0, 6-1, 5-(-4) \\rangle","نهاية <span class=m dir=ltr>−</span> بداية"],["\\overrightarrow{BA} = \\langle -1, 5, 9 \\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{BA} = \\langle -1, 5, 9 \\rangle\"></span>","o":""},{"n":"27","s":[["\\overrightarrow{CB} = \\langle 0-2, 1-1, -4-1 \\rangle","نهاية <span class=m dir=ltr>−</span> بداية"],["\\overrightarrow{CB} = \\langle -2, 0, -5 \\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CB} = \\langle -2, 0, -5 \\rangle\"></span>","o":""},{"n":"28","s":[["CB = |\\overrightarrow{CB}| = \\sqrt{(-2)^2 + 0^2 + (-5)^2}","صيغة المقدار"],["= \\sqrt{29} \\approx 5.39","بالتبسيط"]],"a":"المسافة <span class=\"tx\" data-t=\"= \\sqrt{29} \\approx 5.39\"></span> وحدة","o":""}],[{"n":"29","s":[["\\vec{g} = \\langle 5, 7, -1 \\rangle = 5\\hat{\\mathbf{i}} + 7\\hat{\\mathbf{j}} - \\hat{\\mathbf{k}}","<span class=m dir=ltr>a_1 i + a_2 j + a_3 k</span>"]],"a":"<span class=\"tx\" data-t=\"\\vec{g} = 5\\hat{\\mathbf{i}} + 7\\hat{\\mathbf{j}} - \\hat{\\mathbf{k}}\"></span>","o":""},{"n":"30","s":[["\\overrightarrow{ST} = \\langle 2-1, -2-0, 0-(-5) \\rangle = \\langle 1, -2, 5 \\rangle","نهاية <span class=m dir=ltr>−</span> بداية"],["\\overrightarrow{ST} = \\hat{\\mathbf{i}} - 2\\hat{\\mathbf{j}} + 5\\hat{\\mathbf{k}}","بدلالة متجهات الوحدة الأساسية"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{ST} = \\hat{\\mathbf{i}} - 2\\hat{\\mathbf{j}} + 5\\hat{\\mathbf{k}}\"></span>","o":""},{"n":"31","s":[["-\\vec{a} + 3\\vec{b} = -(\\hat{\\mathbf{i}}+2\\hat{\\mathbf{j}}-4\\hat{\\mathbf{k}}) + 3(4\\hat{\\mathbf{i}}-3\\hat{\\mathbf{j}}+5\\hat{\\mathbf{k}})","بالتعويض"],["= -\\hat{\\mathbf{i}} - 2\\hat{\\mathbf{j}} + 4\\hat{\\mathbf{k}} + 12\\hat{\\mathbf{i}} - 9\\hat{\\mathbf{j}} + 15\\hat{\\mathbf{k}}","خاصية التوزيع"],["= 11\\hat{\\mathbf{i}} - 11\\hat{\\mathbf{j}} + 19\\hat{\\mathbf{k}}","بجمع المركبات المتناظرة"]],"a":"<span class=\"tx\" data-t=\"11\\hat{\\mathbf{i}} - 11\\hat{\\mathbf{j}} + 19\\hat{\\mathbf{k}}\"></span>","o":""}],[{"n":"32","s":[["|\\vec{a}| = \\sqrt{(-4)^2 + 3^2} = \\sqrt{25} = 5","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{a}|}\\vec{a} = \\frac{1}{5}\\langle -4, 3, 0 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle -\\frac{4}{5}, \\frac{3}{5}, 0 \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle -\\frac{4}{5}, \\frac{3}{5}, 0 \\right\\rangle\"></span>","o":""},{"n":"33","s":[["|\\vec{b}| = \\sqrt{143^2 + (-24)^2} = \\sqrt{20449 + 576} = \\sqrt{21025} = 145","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{b}|}\\vec{b} = \\frac{1}{145}\\langle 143, -24, 0 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle \\frac{143}{145}, -\\frac{24}{145}, 0 \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle \\frac{143}{145}, -\\frac{24}{145}, 0 \\right\\rangle\"></span>","o":""},{"n":"34","s":[["|\\vec{c}| = \\sqrt{72^2 + 33^2 + 56^2} = \\sqrt{9409} = 97","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{c}|}\\vec{c} = \\frac{1}{97}\\langle 72, 33, 56 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle \\frac{72}{97}, \\frac{33}{97}, \\frac{56}{97} \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle \\frac{72}{97}, \\frac{33}{97}, \\frac{56}{97} \\right\\rangle\"></span>","o":""},{"n":"35","s":[["|\\vec{d}| = \\sqrt{11^2 + 13^2 + 8^2} = \\sqrt{354}","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{d}|}\\vec{d} = \\frac{1}{\\sqrt{354}}\\langle 11, 13, 8 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle \\frac{11}{\\sqrt{354}}, \\frac{13}{\\sqrt{354}}, \\frac{8}{\\sqrt{354}} \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle \\frac{11}{\\sqrt{354}}, \\frac{13}{\\sqrt{354}}, \\frac{8}{\\sqrt{354}} \\right\\rangle\"></span>","o":""},{"n":"36","s":[["|\\vec{e}| = \\sqrt{5^2 + (-4)^2 + (-2)^2} = \\sqrt{45} = 3\\sqrt{5}","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{e}|}\\vec{e} = \\frac{1}{3\\sqrt{5}}\\langle 5, -4, -2 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle \\frac{5}{3\\sqrt{5}}, -\\frac{4}{3\\sqrt{5}}, -\\frac{2}{3\\sqrt{5}} \\right\\rangle = \\left\\langle \\frac{\\sqrt{5}}{3}, -\\frac{4\\sqrt{5}}{15}, -\\frac{2\\sqrt{5}}{15} \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle \\frac{5}{3\\sqrt{5}}, -\\frac{4}{3\\sqrt{5}}, -\\frac{2}{3\\sqrt{5}} \\right\\rangle = \\left\\langle \\frac{\\sqrt{5}}{3}, -\\frac{4\\sqrt{5}}{15}, -\\frac{2\\sqrt{5}}{15} \\right\\rangle\"></span>","o":""},{"n":"37","s":[["|\\vec{n}| = \\sqrt{(-2)^2 + 0^2 + 3^2} = \\sqrt{13}","صيغة المقدار"],["\\hat{\\mathbf{u}} = \\frac{1}{|\\vec{n}|}\\vec{n} = \\frac{1}{\\sqrt{13}}\\langle -2, 0, 3 \\rangle","متجه الوحدة في اتجاه المتجه"],["\\hat{\\mathbf{u}} = \\left\\langle -\\frac{2}{\\sqrt{13}}, 0, \\frac{3}{\\sqrt{13}} \\right\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\hat{\\mathbf{u}} = \\left\\langle -\\frac{2}{\\sqrt{13}}, 0, \\frac{3}{\\sqrt{13}} \\right\\rangle\"></span>","o":""}],[{"n":"38","s":[["3\\vec{a} + c\\vec{b} = \\langle -9, 12, 36 \\rangle + \\langle 7c, 39c, -2c \\rangle","ضرب المتجه في عدد حقيقي"],["\\langle -9+7c, 12+39c, 36-2c \\rangle = \\langle -23, -66, 40 \\rangle","تساوي متجهين"],["-9 + 7c = -23 \\Rightarrow c = -2","بمساواة المركبات الأولى"],["12 + 39(-2) = -66,\\quad 36 - 2(-2) = 40","التحقق من المركبتين الأخريين"]],"a":"<span class=\"tx\" data-t=\"c = -2\"></span>","o":""}],[{"n":"39","s":[["k\\vec{s} - 4\\vec{t} = \\langle 2k - 12, k(w+47) - 4v, -4k - 8 \\rangle","ضرب المتجه في عدد ثم الطرح"],["2k - 12 = 6 \\Rightarrow k = 9","بمساواة المركبات الأولى"],["-4(9) - 8 = w \\Rightarrow w = -44","بمساواة المركبات الثالثة"],["9(-44 + 47) - 4v = 31 \\Rightarrow 27 - 4v = 31 \\Rightarrow v = -1","بمساواة المركبات الثانية"]],"a":"<span class=\"tx\" data-t=\"k = 9\"></span>، <span class=\"tx\" data-t=\"v = -1\"></span>، <span class=\"tx\" data-t=\"w = -44\"></span>","o":""}],[{"n":"40","s":[["5\\vec{m} + 2\\vec{p} = \\langle 20, 5, -10 \\rangle + \\langle 4, 2a, -2 \\rangle = \\langle 24, 5+2a, -12 \\rangle","ضرب المتجه في عدد ثم الجمع"],["4\\vec{n} = \\langle 24, 8, -12 \\rangle","ضرب المتجه في عدد"],["5 + 2a = 8","تساوي متجهين (المركبة الثانية)"],["a = \\frac{3}{2}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"a = \\frac{3}{2} = 1.5\"></span>","o":""}],[{"n":"41","s":[["\\sqrt{(u-3)^2 + (u+1)^2 + (u-2)^2} = 17","صيغة المقدار"],["(u-3)^2 + (u+1)^2 + (u-2)^2 = 289","بتربيع الطرفين"],["3u^2 - 8u + 14 = 289 \\Rightarrow 3u^2 - 8u - 275 = 0","بالتبسيط"],["(3u + 25)(u - 11) = 0","بالتحليل"],["u = 11 \\quad \\text{or} \\quad u = -\\frac{25}{3}","خاصية الضرب الصفري"]],"a":"<span class=\"tx\" data-t=\"u = 11\"></span> أو <span class=\"tx\" data-t=\"u = -\\frac{25}{3}\"></span>","o":""}],[{"n":"42","s":[["\\overrightarrow{GH} = \\vec{h} - \\vec{g} = \\langle c-1+2, -4-(c+1), c+2+8 \\rangle = \\langle c+1, -c-5, c+10 \\rangle","نهاية <span class=m dir=ltr>−</span> بداية"],["(c+1)^2 + (c+5)^2 + (c+10)^2 = 19^2 = 361","<span class=m dir=ltr>|GH| = 19</span> بتربيع الطرفين"],["3c^2 + 32c + 126 = 361 \\Rightarrow 3c^2 + 32c - 235 = 0","بالتبسيط"],["(3c + 47)(c - 5) = 0 \\Rightarrow c = 5 \\text{ or } c = -\\frac{47}{3}","بالتحليل وخاصية الضرب الصفري"],["c = 5","لأن <span class=m dir=ltr>c &gt; 0</span>"]],"a":"<span class=\"tx\" data-t=\"c = 5\"></span>","o":""}],[{"n":"43","s":[["r = OA = \\sqrt{7^2 + (-3)^2 + 3^2} = \\sqrt{67}","نصف قطر الكرة: بعد <span class=m dir=ltr>A</span> عن نقطة الأصل"],["OB = \\sqrt{2^2 + (-8)^2 + (-1)^2} = \\sqrt{69}","بعد <span class=m dir=ltr>B</span> عن المركز"],["\\sqrt{69} > \\sqrt{67}","بعد <span class=m dir=ltr>B</span> عن المركز أكبر من نصف القطر"]],"a":"قول حنان صحيح: النقطة <span class=\"tx\" data-t=\"B\"></span> تقع خارج الكرة لأن <span class=\"tx\" data-t=\"\\sqrt{69} &gt; \\sqrt{67}\"></span>، وقول هديل خطأ","o":""}],[{"n":"44","s":[["C\\left(\\frac{-4-2}{2}, \\frac{6+2}{2}, \\frac{-1+17}{2}\\right) = C(-3, 4, 8)","مركز الكرة هو منتصف القطر <span class=m dir=ltr>JK</span>"],["r = CJ = \\sqrt{(-4+3)^2 + (6-4)^2 + (-1-8)^2} = \\sqrt{1+4+81} = \\sqrt{86}","نصف القطر"],["CL = \\sqrt{(2+3)^2 + (10-4)^2 + (3-8)^2} = \\sqrt{25+36+25} = \\sqrt{86}","بعد <span class=m dir=ltr>L</span> عن المركز"],["CM = \\sqrt{(4+3)^2 + (-2-4)^2 + (7-8)^2} = \\sqrt{49+36+1} = \\sqrt{86}","بعد <span class=m dir=ltr>M</span> عن المركز"]],"a":"بما أن <span class=\"tx\" data-t=\"CL = CM = r = \\sqrt{86}\"></span> فإن النقطتين <span class=\"tx\" data-t=\"L\"></span> و <span class=\"tx\" data-t=\"M\"></span> تقعان على سطح الكرة","o":""}],[{"n":"45","s":[["AB = |5 - (-1)| = 6","<span class=m dir=ltr>A</span> و <span class=m dir=ltr>B</span> تختلفان في <span class=m dir=ltr>z</span> فقط، إذن <span class=m dir=ltr>AB</span> حرف موازٍ لمحور <span class=m dir=ltr>z</span>"],["BC = \\sqrt{6^2 + (-6)^2 + 0^2} = 6\\sqrt{2}","<span class=m dir=ltr>B</span> و <span class=m dir=ltr>C</span> تختلفان في <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>، إذن <span class=m dir=ltr>BC</span> قطر وجه طوله <span class=m dir=ltr>6√2 =</span> طول الحرف <span class=m dir=ltr>× √2</span>"],["x \\in \\{2, 8\\},\\ y \\in \\{-3, 3\\},\\ z \\in \\{-1, 5\\}","طول الحرف <span class=m dir=ltr>6</span> والأوجه توازي المستويات الإحداثية"],["(2, -3, -1),\\ (2, -3, 5),\\ (8, 3, -1),\\ (8, 3, 5),\\ (8, -3, -1)","الرؤوس الخمسة الباقية"]],"a":"الرؤوس الأخرى: <span class=\"tx\" data-t=\"(2,-3,-1)\"></span>، <span class=\"tx\" data-t=\"(2,-3,5)\"></span>، <span class=\"tx\" data-t=\"(8,3,-1)\"></span>، <span class=\"tx\" data-t=\"(8,3,5)\"></span>، <span class=\"tx\" data-t=\"(8,-3,-1)\"></span>","o":"التبرير: كل رأس من رؤوس المكعب يأخذ <span class=\"tx\" data-t=\"x\"></span> من <span class=\"tx\" data-t=\"\\{2, 8\\}\"></span> و <span class=\"tx\" data-t=\"y\"></span> من <span class=\"tx\" data-t=\"\\{-3, 3\\}\"></span> و <span class=\"tx\" data-t=\"z\"></span> من <span class=\"tx\" data-t=\"\\{-1, 5\\}\"></span>، فتنتج <span class=m dir=ltr>8</span> رؤوس، ثلاثة منها معطاة."}],[{"n":"46","s":[["\\overrightarrow{AB} = \\overrightarrow{AC} + \\overrightarrow{CB} = -3\\vec{a} + 6\\vec{b}","قاعدة المثلث"],["\\overrightarrow{AX} = \\frac{1}{3}\\overrightarrow{AB} = -\\vec{a} + 2\\vec{b}","لأن <span class=m dir=ltr>AX</span> : <span class=m dir=ltr>XB = 1</span> : <span class=m dir=ltr>2</span>"],["\\overrightarrow{CX} = \\overrightarrow{CA} + \\overrightarrow{AX} = 3\\vec{a} - \\vec{a} + 2\\vec{b} = 2\\vec{a} + 2\\vec{b}","قاعدة المثلث"],["\\overrightarrow{CY} = \\overrightarrow{CB} + \\overrightarrow{BY} = 6\\vec{b} + 5\\vec{a} - \\vec{b} = 5\\vec{a} + 5\\vec{b}","قاعدة المثلث"],["\\overrightarrow{CX} = 2(\\vec{a} + \\vec{b}) = \\frac{2}{5}(5\\vec{a} + 5\\vec{b}) = \\frac{2}{5}\\overrightarrow{CY}","بإخراج عامل مشترك"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CX} = \\frac{2}{5}\\overrightarrow{CY}\"></span> (وهو المطلوب)","o":""}],[{"n":"47","s":[["\\overrightarrow{ML} = \\vec{l} - \\vec{m} = \\langle 7, -4, 2 \\rangle,\\ |\\overrightarrow{ML}|^2 = 49+16+4 = 69","متجه الإزاحة ومربع طوله"],["\\overrightarrow{MN} = \\vec{n} - \\vec{m} = \\langle 8, 9, -10 \\rangle,\\ |\\overrightarrow{MN}|^2 = 64+81+100 = 245","متجه الإزاحة ومربع طوله"],["\\overrightarrow{LN} = \\vec{n} - \\vec{l} = \\langle 1, 13, -12 \\rangle,\\ |\\overrightarrow{LN}|^2 = 1+169+144 = 314","متجه الإزاحة ومربع طوله"],["ML^2 + MN^2 = 69 + 245 = 314 = LN^2","عكس نظرية فيثاغورس"]],"a":"المثلث <span class=\"tx\" data-t=\"LMN\"></span> قائم الزاوية في <span class=\"tx\" data-t=\"M\"></span>","o":""},{"n":"48","s":[["A = \\frac{1}{2} \\times ML \\times MN","الضلعان القائمان"],["= \\frac{1}{2}\\sqrt{69}\\sqrt{245} = \\frac{1}{2}\\sqrt{16905} = \\fra