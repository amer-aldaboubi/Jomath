[[{"n":"1","s":[["y=\\sqrt{x} \\Rightarrow y'=\\frac{1}{2\\sqrt{x}}","باشتقاق الاقتران"],["xy'-y=\\frac{x}{2\\sqrt{x}}-\\sqrt{x}=\\frac{\\sqrt{x}}{2}-\\sqrt{x}=-\\frac{\\sqrt{x}}{2}","بالتعويض في الطرف الأيسر"],["-\\frac{\\sqrt{x}}{2}\\ne 0","لا يساوي الطرف الأيمن لكل <span class=m dir=ltr>x &gt; 0</span>"]],"a":"الاقتران <span class=\"tx\" data-t=\"y=\\sqrt{x}\"></span> ليس حلًّا للمعادلة التفاضلية","o":""},{"n":"2","s":[["y'=\\ln x+x\\cdot\\frac{1}{x}-5=\\ln x-4","قاعدة مشتقة الضرب"],["y''=\\frac{1}{x}","بالاشتقاق مرة ثانية"],["y''-\\frac{1}{x}=\\frac{1}{x}-\\frac{1}{x}=0","بالتعويض في المعادلة"]],"a":"نعم، الاقتران حلٌّ للمعادلة التفاضلية","o":""},{"n":"3","s":[["y=\\tan x \\Rightarrow y'=\\sec^2 x=1+\\tan^2 x","مشتقة الظل ومتطابقة فيثاغورس"],["y'+y^2=1+\\tan^2 x+\\tan^2 x=1+2\\tan^2 x","بالتعويض في الطرف الأيسر"],["1+2\\tan^2 x\\ne 1","لا يساوي <span class=m dir=ltr>1</span> لكل قيم <span class=m dir=ltr>x (</span>مثلًا <span class=m dir=ltr>x = π/4</span> يعطي <span class=m dir=ltr>3)</span>"]],"a":"الاقتران <span class=\"tx\" data-t=\"y=\\tan x\"></span> ليس حلًّا للمعادلة التفاضلية","o":""},{"n":"4","s":[["y'=e^x+3e^x+3xe^x=4e^x+3xe^x","قاعدة مشتقة الضرب"],["y''=4e^x+3e^x+3xe^x=7e^x+3xe^x","بالاشتقاق مرة ثانية"],["y''-2y'+y=(7e^x+3xe^x)-(8e^x+6xe^x)+(e^x+3xe^x)","بالتعويض في المعادلة"],["=(7-8+1)e^x+(3-6+3)xe^x=0","بالتبسيط"]],"a":"نعم، الاقتران حلٌّ للمعادلة التفاضلية","o":""}],[{"n":"5","s":[["\\frac{1}{\\sqrt{y}}\\,dy=3x\\,dx","بفصل المتغيرات"],["\\int y^{-1/2}\\,dy=\\int 3x\\,dx","بمكاملة الطرفين"],["2\\sqrt{y}=\\frac{3}{2}x^2+C",""],["y=\\left(\\frac{3}{4}x^2+C_1\\right)^2","بقسمة الطرفين على <span class=m dir=ltr>2</span> ثم التربيع"]],"a":"<span class=\"tx\" data-t=\"y=\\left(\\frac{3}{4}x^2+C\\right)^2\"></span>","o":"","k":[{"e":"(C + 3*x^2/4)^2","a":null}]},{"n":"6","s":[["\\frac{dy}{dx}=-\\frac{3x}{y^2}","بطرح الحد الثاني من الطرفين"],["y^2\\,dy=-3x\\,dx","بفصل المتغيرات"],["\\frac{y^3}{3}=-\\frac{3}{2}x^2+C","بمكاملة الطرفين"],["y=\\sqrt[3]{-\\frac{9}{2}x^2+C_1}","بضرب الطرفين في <span class=m dir=ltr>3</span> وأخذ الجذر التكعيبي"]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt[3]{C-\\frac{9}{2}x^2}\"></span>","o":"","k":[{"e":"(C - 9*x^2/2)^(1/3)","a":null}]},{"n":"7","s":[["\\frac{1}{\\sin y}\\,dy=\\cos x\\,dx \\Rightarrow \\csc y\\,dy=\\cos x\\,dx","بفصل المتغيرات"],["\\int\\csc y\\,dy=\\int\\cos x\\,dx","بمكاملة الطرفين"],["-\\ln|\\csc y+\\cot y|=\\sin x+C","تكامل قاطع التمام"]],"a":"<span class=\"tx\" data-t=\"-\\ln|\\csc y+\\cot y|=\\sin x+C\"></span>","o":""},{"n":"8","s":[["y=\\int\\frac{x}{(x^2+1)^2}\\,dx","المتغير <span class=m dir=ltr>y</span> مفصول؛ نكامل الطرفين"],["u=x^2+1,\\ du=2x\\,dx","بالتعويض"],["y=\\frac{1}{2}\\int u^{-2}\\,du=-\\frac{1}{2u}+C",""],["y=-\\frac{1}{2(x^2+1)}+C","بإرجاع <span class=m dir=ltr>u</span>"]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{1}{2(x^2+1)}+C\"></span>","o":"","k":[{"e":"C - 1/(2*x^2 + 2)","a":null}]},{"n":"9","s":[["\\frac{dy}{dx}=xe^x e^y","خصائص الأسس"],["e^{-y}\\,dy=xe^x\\,dx","بفصل المتغيرات"],["-e^{-y}=xe^x-e^x+C","بمكاملة الطرفين (الطرف الأيمن بالأجزاء)"],["e^{-y}=e^x-xe^x+C_1 \\Rightarrow y=-\\ln\\left(e^x-xe^x+C_1\\right)","بأخذ <span class=m dir=ltr>ln</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"y=-\\ln\\left(e^x-xe^x+C\\right)\"></span>","o":"","k":[{"e":"-log(C - e^x*x + exp(x))","a":null}]},{"n":"10","s":[["\\frac{1}{y^2}\\,dy=x^{-2}e^{1/x}\\,dx","بفصل المتغيرات (بضرب الطرفين في <span class=\"tx\" data-t=\"e^{1/x}\"></span>)"],["\\int y^{-2}\\,dy=\\int x^{-2}e^{1/x}\\,dx","بمكاملة الطرفين"],["-\\frac{1}{y}=-e^{1/x}+C","بالتعويض <span class=m dir=ltr>u = 1/x</span>"],["y=\\frac{1}{e^{1/x}+C_1}","بحل المعادلة لـ <span class=m dir=ltr>y</span>"]],"a":"<span class=\"tx\" data-t=\"y=\\dfrac{1}{e^{1/x}+C}\"></span>","o":"","k":[{"e":"1/(C + exp(1/x))","a":null}]}],[{"n":"11","s":[["\\frac{1}{y}\\,dy=\\frac{x}{x-3}\\,dx=\\left(1+\\frac{3}{x-3}\\right)dx","بفصل المتغيرات ثم القسمة"],["\\ln|y|=x+3\\ln|x-3|+C","بمكاملة الطرفين"],["y=Ae^x(x-3)^3","بأخذ <span class=m dir=ltr>e</span> للطرفين، <span class=m dir=ltr>A</span> ثابت"]],"a":"<span class=\"tx\" data-t=\"\\ln|y|=x+3\\ln|x-3|+C\"></span> ، أي <span class=\"tx\" data-t=\"y=A(x-3)^3e^x\"></span>","o":""},{"n":"12","s":[["\\frac{1}{\\sin^2 y}\\,dy=\\frac{3x^2}{x^3+2}\\,dx","بفصل المتغيرات"],["\\int\\csc^2 y\\,dy=\\int\\frac{3x^2}{x^3+2}\\,dx","بمكاملة الطرفين"],["-\\cot y=\\ln|x^3+2|+C","البسط مشتقة المقام"]],"a":"<span class=\"tx\" data-t=\"-\\cot y=\\ln|x^3+2|+C\"></span>","o":""},{"n":"13","s":[["y^{-3}\\,dy=\\ln x\\,dx","بفصل المتغيرات"],["\\int y^{-3}\\,dy=\\int\\ln x\\,dx","بمكاملة الطرفين"],["-\\frac{1}{2y^2}=x\\ln x-x+C","تكامل <span class=m dir=ltr>ln x</span> بالأجزاء"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{2y^2}=x\\ln x-x+C\"></span>","o":""},{"n":"14","s":[["\\frac{1}{y^2-1}\\,dy=2x^3\\,dx","بفصل المتغيرات"],["\\frac{1}{(y-1)(y+1)}=\\frac{1/2}{y-1}-\\frac{1/2}{y+1}","بالكسور الجزئية"],["\\frac{1}{2}\\ln|y-1|-\\frac{1}{2}\\ln|y+1|=\\frac{x^4}{2}+C","بمكاملة الطرفين"],["\\ln\\left|\\frac{y-1}{y+1}\\right|=x^4+C_1","بضرب الطرفين في <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"\\ln\\left|\\frac{y-1}{y+1}\\right|=x^4+C\"></span>","o":""},{"n":"15","s":[["y\\,dy=\\sin^3 x\\cos^2 x\\,dx=(1-\\cos^2 x)\\cos^2 x\\sin x\\,dx","بفصل المتغيرات والمتطابقة"],["u=\\cos x,\\ du=-\\sin x\\,dx","بالتعويض"],["\\int(1-\\cos^2x)\\cos^2x\\sin x\\,dx=-\\int(u^2-u^4)\\,du=-\\frac{u^3}{3}+\\frac{u^5}{5}",""],["\\frac{y^2}{2}=\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C","بمكاملة الطرفين وإرجاع <span class=m dir=ltr>u</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{y^2}{2}=\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C\"></span>","o":""},{"n":"16","s":[["\\frac{dy}{dx}=\\sqrt{x}\\sqrt{y} \\Rightarrow y^{-1/2}\\,dy=x^{1/2}\\,dx","بفصل المتغيرات"],["2\\sqrt{y}=\\frac{2}{3}x^{3/2}+C","بمكاملة الطرفين"],["y=\\left(\\frac{1}{3}x^{3/2}+C_1\\right)^2","بقسمة الطرفين على <span class=m dir=ltr>2</span> ثم التربيع"]],"a":"<span class=\"tx\" data-t=\"y=\\left(\\frac{1}{3}x^{3/2}+C\\right)^2\"></span>","o":"","k":[{"e":"(C + x^(3/2)/3)^2","a":null}]},{"n":"17","s":[["\\frac{1}{y}\\,dy=\\ln\\sqrt{x}\\,dx=\\frac{1}{2}\\ln x\\,dx","بفصل المتغيرات وخصائص اللوغاريتم"],["\\ln|y|=\\frac{1}{2}(x\\ln x-x)+C","بمكاملة الطرفين"],["y=Ae^{\\frac{1}{2}(x\\ln x-x)}","<span class=m dir=ltr>A</span> ثابت"]],"a":"<span class=\"tx\" data-t=\"\\ln|y|=\\frac{1}{2}(x\\ln x-x)+C\"></span>","o":""},{"n":"18","s":[["\\frac{1}{y-2}\\,dy=\\frac{-3}{(2x+1)(x+2)}\\,dx","بفصل المتغيرات"],["\\frac{-3}{(2x+1)(x+2)}=\\frac{A}{2x+1}+\\frac{B}{x+2} \\Rightarrow -3=A(x+2)+B(2x+1)","بالكسور الجزئية"],["x=-2: B=1,\\quad x=-\\tfrac{1}{2}: A=-2","بالتعويض"],["\\ln|y-2|=-\\ln|2x+1|+\\ln|x+2|+C","بمكاملة الطرفين"],["y=2+\\frac{A(x+2)}{2x+1}","<span class=m dir=ltr>A</span> ثابت"]],"a":"<span class=\"tx\" data-t=\"\\ln|y-2|=\\ln\\left|\\frac{x+2}{2x+1}\\right|+C\"></span> ، أي <span class=\"tx\" data-t=\"y=2+\\frac{A(x+2)}{2x+1}\"></span>","o":""}],[{"n":"19","s":[["y^{-2}\\,dy=\\sqrt{4-x}\\,dx","بفصل المتغيرات"],["-\\frac{1}{y}=-\\frac{2}{3}(4-x)^{3/2}+C","بمكاملة الطرفين"],["-\\frac{1}{2}=-\\frac{2}{3}(3)^{3/2}+C=-2\\sqrt{3}+C \\Rightarrow C=2\\sqrt{3}-\\frac{1}{2}","بتعويض الشرط <span class=m dir=ltr>y(1) = 2</span>"],["\\frac{1}{y}=\\frac{2}{3}(4-x)^{3/2}-2\\sqrt{3}+\\frac{1}{2}",""]],"a":"<span class=\"tx\" data-t=\"y=\\dfrac{1}{\\frac{2}{3}(4-x)^{3/2}-2\\sqrt{3}+\\frac{1}{2}}\"></span>","o":"","k":[{"e":"1/(2*(4 - x)^(3/2)/3 - 2*sqrt(3) + 1/2)","a":null}]},{"n":"20","s":[["y\\,dy=2\\sin^2x\\,dx=(1-\\cos 2x)\\,dx","بفصل المتغيرات ومتطابقة ضعف الزاوية"],["\\frac{y^2}{2}=x-\\frac{1}{2}\\sin 2x+C","بمكاملة الطرفين"],["\\frac{1}{2}=0-0+C \\Rightarrow C=\\frac{1}{2}","بتعويض <span class=m dir=ltr>y(0) = 1</span>"],["y^2=2x-\\sin 2x+1",""]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt{2x-\\sin 2x+1}\"></span> (نأخذ الجذر الموجب لأن <span class=\"tx\" data-t=\"y(0)=1&gt;0\"></span>)","o":""},{"n":"21","s":[["\\sec^2 y\\,dy=2\\cos^2x\\,dx=(1+\\cos 2x)\\,dx","بفصل المتغيرات"],["\\tan y=x+\\frac{1}{2}\\sin 2x+C","بمكاملة الطرفين"],["\\tan\\frac{\\pi}{4}=0+0+C \\Rightarrow C=1","بتعويض <span class=m dir=ltr>y(0) = π/4</span>"]],"a":"<span class=\"tx\" data-t=\"\\tan y=x+\\frac{1}{2}\\sin 2x+1\"></span> ، أي <span class=\"tx\" data-t=\"y=\\tan^{-1}\\left(x+\\frac{1}{2}\\sin 2x+1\\right)\"></span>","o":""},{"n":"22","s":[["e^y\\,dy=\\cos x\\,e^{\\sin x}\\,dx","بفصل المتغيرات"],["e^y=e^{\\sin x}+C","بمكاملة الطرفين <span class=m dir=ltr>(u = sin x)</span>"],["e^0=e^{\\sin\\pi}+C \\Rightarrow 1=1+C \\Rightarrow C=0","بتعويض <span class=m dir=ltr>y(π) = 0</span>"],["e^y=e^{\\sin x}",""]],"a":"<span class=\"tx\" data-t=\"y=\\sin x\"></span>","o":"","k":[{"e":"sin(x)","a":null}]},{"n":"23","s":[["\\frac{8x-18}{(3x-8)(x-2)}=\\frac{A}{3x-8}+\\frac{B}{x-2}","بالكسور الجزئية"],["x=2: -2=-2B \\Rightarrow B=1,\\quad x=\\tfrac{8}{3}: \\tfrac{10}{3}=\\tfrac{2}{3}A \\Rightarrow A=5","بالتعويض"],["y=\\frac{5}{3}\\ln|3x-8|+\\ln|x-2|+C","بمكاملة الطرفين"],["8=\\frac{5}{3}\\ln 1+\\ln 1+C \\Rightarrow C=8","بتعويض <span class=m dir=ltr>y(3) = 8</span>"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{5}{3}\\ln|3x-8|+\\ln|x-2|+8\"></span>","o":"","k":[{"e":"log(Abs(x - 2)) + 5*log(Abs(3*x - 8))/3 + 8","a":null}]},{"n":"24","s":[["y\\,dy=\\frac{1}{x}\\,dx","بفصل المتغيرات"],["\\frac{y^2}{2}=\\ln|x|+C","بمكاملة الطرفين"],["\\frac{1}{2}=\\ln e+C \\Rightarrow C=-\\frac{1}{2}","بتعويض <span class=m dir=ltr>y(e) = 1</span>"],["y^2=2\\ln x-1",""]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt{2\\ln x-1}\"></span>","o":"","k":[{"e":"sqrt(2*log(x) - 1)","a":null}]}],[{"n":"25","s":[["\\frac{1}{10-0.5v}\\,dv=dt","بفصل المتغيرات"],["-2\\ln|10-0.5v|=t+C","بمكاملة الطرفين"],["-2\\ln 10=0+C","من السكون: <span class=m dir=ltr>v(0) = 0</span>"],["\\ln|10-0.5v|=-0.5t+\\ln 10 \\Rightarrow 10-0.5v=10e^{-0.5t}","بالتبسيط وأخذ <span class=m dir=ltr>e</span> للطرفين"],["v=20-20e^{-0.5t}","بحل المعادلة لـ <span class=m dir=ltr>v</span>"]],"a":"<span class=\"tx\" data-t=\"v(t)=20-20e^{-0.5t}\"></span> <span class=m dir=ltr>m/s</span>","o":"","k":[{"e":"20 - 20/e^(0.5*t)","a":true}]}],[{"n":"26","s":[["\\frac{1}{260-0.4N}\\,dN=dt","بفصل المتغيرات"],["-2.5\\ln(260-0.4N)=t+C","بمكاملة الطرفين، و <span class=\"tx\" data-t=\"260-0.4N&gt;0\"></span> لأن <span class=\"tx\" data-t=\"N&lt;650\"></span>"],["N(0)=300: -2.5\\ln 140=C","بتعويض الشرط الابتدائي"],["260-0.4N=140e^{-0.4t} \\Rightarrow N=650-350e^{-0.4t}","بالتبسيط وأخذ <span class=m dir=ltr>e</span> للطرفين"],["N(3)=650-350e^{-1.2}\\approx 544.58","بتعويض <span class=m dir=ltr>t = 3</span>"]],"a":"<span class=\"tx\" data-t=\"N(t)=650-350e^{-0.4t}\"></span> ، وعدد الذئاب بعد <span class=m dir=ltr>3</span> سنوات <span class=\"tx\" data-t=\"\\approx 545\"></span> ذئبًا تقريبًا","o":""}],[{"n":"27","s":[["r^{-2}\\,dr=-0.0075\\,dt","بفصل المتغيرات"],["-\\frac{1}{r}=-0.0075t+C","بمكاملة الطرفين"],["-\\frac{1}{20}=C","بتعويض <span class=m dir=ltr>r(0) = 20</span>"],["\\frac{1}{r}=0.0075t+0.05 \\Rightarrow r=\\frac{1}{0.0075t+0.05}=\\frac{400}{3t+20}","بضرب البسط والمقام في <span class=m dir=ltr>400</span>"]],"a":"<span class=\"tx\" data-t=\"r(t)=\\dfrac{400}{3t+20}\"></span> <span class=m dir=ltr>cm</span>","o":"","k":[{"e":"400/(3*t + 20)","a":null}]},{"n":"28","s":[["10=\\frac{400}{3t+20}","بتعويض <span class=m dir=ltr>r = 10</span>"],["3t+20=40 \\Rightarrow t=\\frac{20}{3}",""]],"a":"بعد <span class=\"tx\" data-t=\"t=\\frac{20}{3}\\approx 6.67\"></span> ثانية","o":"","k":[{"e":"6.67","a":true}]}],[{"n":"29","s":[["\\frac{1}{n}\\,dn=0.2(0.2-\\cos t)\\,dt=(0.04-0.2\\cos t)\\,dt","بفصل المتغيرات"],["\\ln n=0.04t-0.2\\sin t+C","بمكاملة الطرفين <span class=m dir=ltr>(n &gt; 0)</span>"],["\\ln 400=0-0+C \\Rightarrow C=\\ln 400","بتعويض <span class=m dir=ltr>n(0) = 400</span>"],["n=400e^{0.04t-0.2\\sin t}","بأخذ <span class=m dir=ltr>e</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"n(t)=400e^{0.04t-0.2\\sin t}\"></span>","o":"","k":[{"e":"400*e^(0.04*t - 0.2*sin(t))","a":true}]},{"n":"30","s":[["n(3)=400e^{0.12-0.2\\sin 3}","بتعويض <span class=m dir=ltr>t = 3 (</span>الزاوية بالراديان)"],["\\sin 3\\approx 0.1411 \\Rightarrow n(3)\\approx 400e^{0.0918}\\approx 438.4",""]],"a":"عدد الحشرات بعد <span class=m dir=ltr>3</span> أسابيع <span class=\"tx\" data-t=\"\\approx 438\"></span> حشرة","o":"","k":[{"e":"438","a":true}]}],[{"n":"31","s":[["\\frac{1}{y}\\,dy=\\cos x\\,dx","بفصل المتغيرات"],["\\ln|y|=\\sin x+C","بمكاملة الطرفين"],["\\ln 1=\\sin 0+C \\Rightarrow C=0","بتعويض النقطة <span class=m dir=ltr>(0, 1)</span>"]],"a":"<span class=\"tx\" data-t=\"y=e^{\\sin x}\"></span>","o":"","k":[{"e":"exp(sin(x))","a":null}]}],[{"n":"32","s":[["\\frac{1}{y}\\,dy=\\frac{1}{x(x+1)}\\,dx=\\left(\\frac{1}{x}-\\frac{1}{x+1}\\right)dx","بفصل المتغيرات والكسور الجزئية"],["\\ln|y|=\\ln|x|-\\ln|x+1|+C","بمكاملة الطرفين"],["y=\\frac{Ax}{x+1}","<span class=m dir=ltr>A</span> ثابت"],["3=\\frac{A(1)}{2} \\Rightarrow A=6","بتعويض النقطة <span class=m dir=ltr>(1, 3)</span>"]],"a":"<span class=\"tx\" data-t=\"y=\\dfrac{6x}{x+1}\"></span>","o":"","k":[{"e":"6*x/(x + 1)","a":null}]}],[{"n":"33","s":[["\\frac{dy}{dx}=\\frac{x-1}{y^2}-y(x-1)=(x-1)\\cdot\\frac{1-y^3}{y^2}","بإخراج <span class=m dir=ltr>(x − 1)</span> عاملًا مشتركًا"],["\\frac{y^2}{1-y^3}\\,dy=(x-1)\\,dx","بفصل المتغيرات"],["-\\frac{1}{3}\\ln|1-y^3|=\\frac{x^2}{2}-x+C","بمكاملة الطرفين <span class=m dir=ltr>(u = 1 − y³)</span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{3}\\ln|1-y^3|=\\frac{x^2}{2}-x+C\"></span>","o":""},{"n":"34","s":[["\\frac{dy}{dx}=x\\left(\\frac{1}{2y-1}-\\frac{2}{3y-2}\\right)=x\\cdot\\frac{(3y-2)-2(2y-1)}{(2y-1)(3y-2)}=\\frac{-xy}{(2y-1)(3y-2)}","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا وتوحيد المقامات"],["\\frac{(2y-1)(3y-2)}{y}\\,dy=-x\\,dx","بفصل المتغيرات"],["\\left(6y-7+\\frac{2}{y}\\right)dy=-x\\,dx","بالتوزيع والقسمة على <span class=m dir=ltr>y</span>"],["3y^2-7y+2\\ln|y|=-\\frac{x^2}{2}+C","بمكاملة الطرفين"]],"a":"<span class=\"tx\" data-t=\"3y^2-7y+2\\ln|y|=-\\frac{x^2}{2}+C\"></span>","o":""},{"n":"35","s":[["1+\\tan^2x+\\tan^2y+\\tan^2x\\tan^2y=(1+\\tan^2x)(1+\\tan^2y)=\\sec^2x\\sec^2y","بالتحليل ومتطابقة فيثاغورس"],["\\cos^2y\\,dy=\\sec^2x\\,dx","بفصل المتغيرات"],["\\frac{1}{2}(1+\\cos 2y)\\,dy=\\sec^2x\\,dx","متطابقة ضعف الزاوية"],["\\frac{y}{2}+\\frac{\\sin 2y}{4}=\\tan x+C","بمكاملة الطرفين"]],"a":"<span class=\"tx\" data-t=\"\\frac{y}{2}+\\frac{1}{4}\\sin 2y=\\tan x+C\"></span>","o":""}],[{"n":"36","s":[["\\frac{1}{x}\\,dx=-\\lambda\\,dt","بفصل المتغيرات"],["\\ln x=-\\lambda t+C","بمكاملة الطرفين، <span class=m dir=ltr>x &gt; 0</span> لأنها كتلة"],["x=e^{-\\lambda t+C}=e^C\\cdot e^{-\\lambda t}","بأخذ <span class=m dir=ltr>e</span> للطرفين وخصائص الأسس"],["x=ae^{-\\lambda t},\\quad a=e^C","<span class=m dir=ltr>e^C</span> عدد ثابت موجب نسميه <span class=m dir=ltr>a</span>"]],"a":"الحل العام <span class=\"tx\" data-t=\"x=ae^{-\\lambda t}\"></span> حيث <span class=\"tx\" data-t=\"a=e^C\"></span> ثابت (وهو الكتلة عند <span class=\"tx\" data-t=\"t=0\"></span>)","o":""},{"n":"37","s":[["t=0: x=ae^0=a","<span class=m dir=ltr>a</span> هي الكتلة الابتدائية"],["\\frac{a}{2}=ae^{-\\lambda T}","عند عمر النصف <span class=m dir=ltr>T</span> تبقى نصف الكتلة"],["e^{-\\lambda T}=\\frac{1}{2} \\Rightarrow -\\lambda T=\\ln\\frac{1}{2}=-\\ln 2","بقسمة الطرفين على <span class=m dir=ltr>a</span> وأخذ <span class=m dir=ltr>ln</span>"],["T=\\frac{\\ln 2}{\\lambda}","بقسمة الطرفين على <span class=m dir=ltr>−</span>λ"]],"a":"عمر النصف <span class=\"tx\" data-t=\"T=\\dfrac{\\ln 2}{\\lambda}\"></span> ، ولا يعتمد على الكتلة الابتدائية <span class=\"tx\" data-t=\"a\"></span>","o":""}],[{"n":"38","s":[["2x+2ny\\frac{dy}{dx}=0","باشتقاق <span class=\"tx\" data-t=\"x^2+ny^2=a\"></span> ضمنيًّا"],["\\frac{dy}{dx}=-\\frac{x}{ny}",""],["-\\frac{x}{ny}=-\\frac{2x}{3y} \\Rightarrow n=\\frac{3}{2}","بالمقارنة مع المعادلة التفاضلية"],["3y\\,dy=-2x\\,dx \\Rightarrow \\frac{3}{2}y^2=-x^2+a \\Rightarrow x^2+\\frac{3}{2}y^2=a","تحقق: بحل المعادلة بفصل المتغيرات"]],"a":"<span class=\"tx\" data-t=\"n=\\frac{3}{2}\"></span>","o":"","k":[{"e":"3/2","a":null}]},{"n":"39","s":[["x^2+\\frac{3}{2}y^2=a","العلاقة من السؤال السابق"],["25+\\frac{3}{2}(16)=a \\Rightarrow a=49","بتعويض النقطة <span class=m dir=ltr>(5, 4)</span>"],["x^2+0=49 \\Rightarrow x=\\pm 7","التقاطع مع المحور <span class=m dir=ltr>x</span> عندما <span class=m dir=ltr>y = 0</span>"]],"a":"نقاط التقاطع: <span class=\"tx\" data-t=\"(7, 0)\"></span> و <span class=\"tx\" data-t=\"(-7, 0)\"></span>","o":"","k":[{"p":["7","0"]},{"p":["-7","0"]}]}],[{"n":"3","s":[["\\frac{1}{y}\\,dy=2x\\,dx","بفصل المتغيرات"],["\\ln|y|=x^2+C","بمكاملة الطرفين"],["\\ln 1=0+C \\Rightarrow C=0 \\Rightarrow y=e^{x^2}","بتعويض النقطة <span class=m dir=ltr>(0, 1)</span>"]],"a":"الإجابة <span class=m dir=ltr>a</span>: <span class=\"tx\" data-t=\"y=e^{x^2}\"></span>","o":"","k":[{"e":"exp(x^2)","a":null}]}],[{"n":"52","s":[["y^{-1/2}\\,dy=\\frac{1}{x}\\,dx","بفصل المتغيرات"],["2\\sqrt{y}=\\ln|x|+C","بمكاملة الطرفين"],["y=\\frac{1}{4}\\left(\\ln|x|+C\\right)^2",""]],"a":"<span class=\"tx\" data-t=\"2\\sqrt{y}=\\ln|x|+C\"></span>","o":""},{"n":"53","s":[["\\cos y\\,dy=xe^x\\,dx","بفصل المتغيرات <span class=m dir=ltr>(1/sec y = cos y)</span>"],["\\sin y=xe^x-e^x+C","بمكاملة الطرفين (الطرف الأيمن بالأجزاء)"]],"a":"<span class=\"tx\" data-t=\"\\sin y=xe^x-e^x+C\"></span>","o":"","k":[{"e":"C + e^x*x - exp(x)","a":null}]},{"n":"54","s":[["3y^2\\,dy=8x\\,dx","بفصل المتغيرات"],["y^3=4x^2+C","بمكاملة الطرفين"]],"a":"<span class=\"tx\" data-t=\"y=\\sqrt[3]{4x^2+C}\"></span>","o":"","k":[{"e":"(C + 4*x^2)^(1/3)","a":null}]},{"n":"55","s":[["x\\frac{dy}{dx}=\\sqrt{y}(3x+4)","بإخراج <span class=m dir=ltr>√y</span> عاملًا مشتركًا"],["y^{-1/2}\\,dy=\\left(3+\\frac{4}{x}\\right)dx","بفصل المتغيرات"],["2\\sqrt{y}=3x+4\\ln|x|+C","بمكاملة الطرفين"]],"a":"<span class=\"tx\" data-t=\"2\\sqrt{y}=3x+4\\ln|x|+C\"></span>","o":""}],[{"n":"56","s":[["\\frac{dy}{dx}=8-4y=-4(y-2)","بطرح <span class=m dir=ltr>4y</span> من الطرفين"],["\\frac{1}{y-2}\\,dy=-4\\,dx \\Rightarrow \\ln|y-2|=-4x+C","بفصل المتغيرات والمكاملة"],["\\ln|3-2|=0+C \\Rightarrow C=0","بتعويض <span class=m dir=ltr>y(0) = 3</span>"],["y-2=e^{-4x}",""]],"a":"<span class=\"tx\" data-t=\"y=2+e^{-4x}\"></span>","o":"","k":[{"e":"2 + exp(-4*x)","a":null}]},{"n":"57","s":[["e^{-y}\\,dy=\\frac{5}{(2x+1)(x-2)}\\,dx","بفصل المتغيرات"],["\\frac{5}{(2x+1)(x-2)}=\\frac{-2}{2x+1}+\\frac{1}{x-2}","بالكسور الجزئية"],["-e^{-y}=-\\ln|2x+1|+\\ln|x-2|+C","بمكاملة الطرفين"],["-1=-\\ln 5+\\ln 5+C \\Rightarrow C=-1","بتعويض <span class=m dir=ltr>y(−3) = 0</span>"],["e^{-y}=1-\\ln\\left|\\frac{x-2}{2x+1}\\right|",""]],"a":"<span class=\"tx\" data-t=\"y=-\\ln\\left(1-\\ln\\left|\\frac{x-2}{2x+1}\\right|\\right)\"></span>","o":"","k":[{"e":"-log(1 - log(Abs((x - 2)/(2*x + 1))))","a":null}]}],[{"n":"58","s":[["\\frac{1}{N}\\,dN=0.2\\,dt","بفصل المتغيرات"],["\\ln N=0.2t+C","بمكاملة الطرفين <span class=m dir=ltr>(N &gt; 0)</span>"],["\\ln 300=C \\Rightarrow N=300e^{0.2t}","بتعويض <span class=m dir=ltr>N(0) = 300</span>"]],"a":"<span class=\"tx\" data-t=\"N(t)=300e^{0.2t}\"></span>","o":"","k":[{"e":"300*e^(0.2*t)","a":true}]},{"n":"59","s":[["N(5)=300e^{0.2(5)}=300e\\approx 815.5","بتعويض <span class=m dir=ltr>t = 5</span>"]],"a":"عدد الأسماك بعد <span class=m dir=ltr>5</span> سنوات <span class=\"tx\" data-t=\"\\approx 815\"></span> سمكة","o":"","k":[{"e":"815","a":true}]}],[{"n":"1","s":[["\\frac{1}{y}dy=3x^2dx","بفصل المتغيرات"],["\\int\\frac{1}{y}dy=\\int3x^2dx\\Rightarrow\\ln|y|=x^3+C","بتكامل الطرفين"],["y=Ae^{x^3}","حيث <span class=\"tx\" data-t=\"A=\\pm e^C\"></span>"]],"a":"<span class=\"tx\" data-t=\"y=Ae^{x^3}\"></span>","o":"","k":[{"e":"A*e^(x^3)","a":null}]},{"n":"2","s":[["\\frac{dy}{y^2-4}=\\frac{dx}{x}","بفصل المتغيرات"],["\\frac{1}{(y-2)(y+2)}=\\frac{1}{4}\\left(\\frac{1}{y-2}-\\frac{1}{y+2}\\right)","الكسور الجزئية"],["\\frac{1}{4}\\ln\\left|\\frac{y-2}{y+2}\\right|=\\ln|x|+C","بتكامل الطرفين"],["\\frac{y-2}{y+2}=Ax^4\\Rightarrow y=\\frac{2(1+Ax^4)}{1-Ax^4}","بالضرب في <span class=m dir=ltr>4</span> وأخذ الأسّ، ثم حل المعادلة لـ <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{y-2}{y+2}=Ax^4\"></span>، أي <span class=\"tx\" data-t=\"y=\\frac{2(1+Ax^4)}{1-Ax^4}\"></span>","o":""},{"n":"3","s":[["\\frac{dy}{dx}=e^xe^y\\Rightarrow e^{-y}dy=e^xdx","بفصل المتغيرات"],["-e^{-y}=e^x+C","بتكامل الطرفين"],["e^{-y}=-e^x-C\\Rightarrow y=-\\ln(-e^x-C)","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"-e^{-y}=e^x+C\"></span>، أي <span class=\"tx\" data-t=\"y=-\\ln(-e^x-C)\"></span>","o":""},{"n":"4","s":[["\\frac{y}{\\sec y}dy=\\frac{x}{e^{x^2}}dx\\Rightarrow y\\cos y\\,dy=xe^{-x^2}dx","بفصل المتغيرات"],["\\int y\\cos y\\,dy=y\\sin y+\\cos y","بالأجزاء: <span class=\"tx\" data-t=\"u=y,\\ dv=\\cos y\\,dy\"></span>"],["\\int xe^{-x^2}dx=-\\frac{1}{2}e^{-x^2}","بالتعويض <span class=\"tx\" data-t=\"u=-x^2\"></span>"],["y\\sin y+\\cos y=-\\frac{1}{2}e^{-x^2}+C","بمساواة الطرفين"]],"a":"<span class=\"tx\" data-t=\"y\\sin y+\\cos y=-\\frac{1}{2}e^{-x^2}+C\"></span>","o":""},{"n":"5","s":[["\\frac{y}{y-3}dy=dx","بفصل المتغيرات"],["\\frac{y}{y-3}=1+\\frac{3}{y-3}","بالقسمة"],["y+3\\ln|y-3|=x+C","بتكامل الطرفين"]],"a":"<span class=\"tx\" data-t=\"y+3\\ln|y-3|=x+C\"></span>","o":""},{"n":"6","s":[["y^2dy=x\\ln x\\,dx","بفصل المتغيرات"],["\\int x\\ln x\\,dx=\\frac{x^2}{2}\\ln x-\\frac{x^2}{4}","بالأجزاء: <span class=\"tx\" data-t=\"u=\\ln x,\\ dv=x\\,dx\"></span>"],["\\frac{y^3}{3}=\\frac{x^2}{2}\\ln x-\\frac{x^2}{4}+C","بتكامل الطرفين"],["y=\\sqrt[3]{\\frac{3x^2}{2}\\ln x-\\frac{3x^2}{4}+3C}","بالضرب في <span class=m dir=ltr>3</span> وأخذ الجذر التكعيبي"]],"a":"<span class=\"tx\" data-t=\"\\frac{y^3}{3}=\\frac{x^2}{2}\\ln x-\\frac{x^2}{4}+C\"></span>","o":""}],[{"n":"7","s":[["y=\\int-30\\cos4x\\sin4x\\,dx;\\ u=\\sin4x,\\ du=4\\cos4x\\,dx","بالتعويض"],["y=-\\frac{30}{4}\\int u\\,du=-\\frac{15}{4}u^2+C=-\\frac{15}{4}\\sin^24x+C","بالتكامل"],["y\\left(\\frac{\\pi}{8}\\right)=0\\Rightarrow-\\frac{15}{4}\\sin^2\\frac{\\pi}{2}+C=0\\Rightarrow C=\\frac{15}{4}","بالشرط الأولي"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{15}{4}-\\frac{15}{4}\\sin^24x=\\frac{15}{4}\\cos^24x\"></span>","o":"","k":[{"e":"15*cos(4*x)^2/4","a":null}]},{"n":"8","s":[["y^{-1/2}dy=x^2dx","بفصل المتغيرات"],["2\\sqrt y=\\frac{x^3}{3}+C","بتكامل الطرفين"],["y(0)=2\\Rightarrow2\\sqrt2=C","بالشرط الأولي"],["\\sqrt y=\\frac{x^3}{6}+\\sqrt2\\Rightarrow y=\\left(\\frac{x^3}{6}+\\sqrt2\\right)^2","بالقسمة على <span class=m dir=ltr>2</span> وتربيع الطرفين"]],"a":"<span class=\"tx\" data-t=\"y=\\left(\\frac{x^3}{6}+\\sqrt2\\right)^2\"></span>","o":"","k":[{"e":"(x^3/6 + sqrt(2))^2","a":null}]},{"n":"9","s":[["\\cos y\\,dy=4\\sqrt x\\,dx","بفصل المتغيرات"],["\\sin y=\\frac{8}{3}x^{3/2}+C","بتكامل الطرفين"],["y(0)=0\\Rightarrow\\sin0=0+C\\Rightarrow C=0","بالشرط الأولي"]],"a":"<span class=\"tx\" data-t=\"\\sin y=\\frac{8}{3}x^{3/2}\"></span>، أي <span class=\"tx\" data-t=\"y=\\sin^{-1}\\left(\\frac{8}{3}x^{3/2}\\right)\"></span>","o":""},{"n":"10","s":[["\\frac{dy}{dx}=xe^ye^{-x^2}\\Rightarrow e^{-y}dy=xe^{-x^2}dx","بفصل المتغيرات"],["-e^{-y}=-\\frac{1}{2}e^{-x^2}+C","بتكامل الطرفين (بالتعويض <span class=\"tx\" data-t=\"u=-x^2\"></span>)"],["y(1)=0\\Rightarrow-1=-\\frac{1}{2e}+C\\Rightarrow C=\\frac{1}{2e}-1","بالشرط الأولي"],["e^{-y}=\\frac{1}{2}e^{-x^2}+1-\\frac{1}{2e}\\Rightarrow y=-\\ln\\left(\\frac{1}{2}e^{-x^2}+1-\\frac{1}{2e}\\right)","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"y=-\\ln\\left(\\frac{1}{2}e^{-x^2}+1-\\frac{1}{2e}\\right)\"></span>","o":"","k":[{"e":"-log(1 + exp(-x^2)/2 - 1/(2*e))","a":null}]},{"n":"11","s":[["e^ydy=x\\,dx","بفصل المتغيرات"],["e^y=\\frac{x^2}{2}+C","بتكامل الطرفين"],["y(4)=\\ln2\\Rightarrow2=8+C\\Rightarrow C=-6","بالشرط الأولي"],["y=\\ln\\left(\\frac{x^2}{2}-6\\right)","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"y=\\ln\\left(\\frac{x^2}{2}-6\\right)\"></span>","o":"","k":[{"e":"log(x^2/2 - 6)","a":null}]},{"n":"12","s":[["y^{-2}dy=(3x^2+4)dx","بفصل المتغيرات"],["-\\frac{1}{y}=x^3+4x+C","بتكامل الطرفين"],["y(2)=-0.1\\Rightarrow10=8+8+C\\Rightarrow C=-6","بالشرط الأولي"],["-\\frac{1}{y}=x^3+4x-6\\Rightarrow y=\\frac{1}{6-4x-x^3}","بحل المعادلة لـ <span class=\"tx\" data-t=\"y\"></span>"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{1}{6-4x-x^3}\"></span>","o":"","k":[{"e":"1/(-x^3 - 4*x + 6)","a":null}]}],[{"n":"13","s":[["y^{-0.8}dy=\\frac{1}{2}dt","بفصل المتغيرات"],["\\frac{y^{0.2}}{0.2}=\\frac{1}{2}t+C\\Rightarrow5y^{0.2}=\\frac{1}{2}t+C","بتكامل الطرفين"],["y(0)=100000\\Rightarrow5(100000)^{0.2}=C\\Rightarrow C=5(10)=50","بالشرط الأولي: <span class=\"tx\" data-t=\"(10^5)^{0.2}=10\"></span>"],["y^{0.2}=\\frac{t}{10}+10\\Rightarrow y=\\left(\\frac{t}{10}+10\\right)^5","بالقسمة على <span class=m dir=ltr>5</span> ورفع الطرفين للقوة <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"y=\\left(\\frac{t}{10}+10\\right)^5\"></span>","o":"","k":[{"e":"(t/10 + 10)^5","a":null}]},{"n":"14","s":[["t=7\\Rightarrow y=\\left(\\frac{7}{10}+10\\right)^5=(10.7)^5","أسبوع <span class=m dir=ltr>= 7</span> أيام"],["\\approx140255.17","باستعمال الآلة الحاسبة"]],"a":"عدد الخلايا بعد أسبوع <span class=\"tx\" data-t=\"\\approx140255\"></span> خلية","o":"","k":[{"e":"140255","a":true}]}],[{"n":"15","s":[["-\\frac{100}{v^2}dv=dt","بفصل المتغيرات"],["\\frac{100}{v}=t+C","بتكامل الطرفين"],["v(0)=20\\Rightarrow\\frac{100}{20}=C\\Rightarrow C=5","بالشرط الأولي"],["v=\\frac{100}{t+5}","بحل المعادلة لـ <span class=\"tx\" data-t=\"v\"></span>"]],"a":"<span class=\"tx\" data-t=\"v(t)=\\frac{100}{t+5}\\ \\text{m/s}\"></span>","o":"","k":[{"e":"100/(t + 5)","a":null}]}],[{"n":"16","s":[["e^ydy=(10+2\\sec^2x)dx","بفصل المتغيرات"],["e^y=10x+2\\tan x+C","بتكامل الطرفين"],["\\left(\\frac{\\pi}{4},0\\right):\\ 1=\\frac{10\\pi}{4}+2+C\\Rightarrow C=-1-\\frac{5\\pi}{2}","بتعويض النقطة"],["y=\\ln\\left(10x+2\\tan x-1-\\frac{5\\pi}{2}\\right)","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"y=\\ln\\left(10x+2\\tan x-1-\\frac{5\\pi}{2}\\right)\"></span>","o":"","k":[{"e":"log(10*x + 2*tan(x) - 5*pi/2 - 1)","a":null}]}],[{"n":"17","s":[["\\frac{dy}{dx}=-\\frac{y}{x}\\Rightarrow\\frac{dy}{y}=-\\frac{dx}{x}","بفصل المتغيرات"],["\\ln|y|=-\\ln|x|+C\\Rightarrow xy=A","بتكامل الطرفين وخصائص اللوغاريتم"],["(6,4):\\ A=6\\times4=24","بتعويض النقطة"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{24}{x}\"></span> (أي <span class=\"tx\" data-t=\"xy=24\"></span>)","o":"","k":[{"e":"24/x","a":null},{"e":"24","a":null}]}]]