[[{"n":"1","s":[["f'(x)=\\lim_{h\\to0}\\frac{4(x+h)+1-(4x+1)}{h}","التعريف العام للمشتقة"],["=\\lim_{h\\to0}\\frac{4h}{h}=4","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=4\"></span>","o":""},{"n":"2","s":[["\\frac{dy}{dx}=\\lim_{h\\to0}\\frac{1-(x+h)-(1-x)}{h}","التعريف العام للمشتقة"],["=\\lim_{h\\to0}\\frac{-h}{h}=-1",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-1\"></span>","o":""},{"n":"3","s":[["f'(x)=\\lim_{h\\to0}\\frac{\\frac12(x+h)^2-1-\\left(\\frac12x^2-1\\right)}{h}","التعريف العام"],["=\\lim_{h\\to0}\\frac{xh+\\frac12h^2}{h}","بفك الأقواس والتبسيط"],["=\\lim_{h\\to0}\\left(x+\\frac12h\\right)=x","بالقسمة على <span class=m dir=ltr>h</span> ثم التعويض"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=x\"></span>","o":""},{"n":"4","s":[["\\frac{dy}{dx}=\\lim_{h\\to0}\\frac{\\frac{2(x+h)+4}{6}-\\frac{2x+4}{6}}{h}","التعريف العام"],["=\\lim_{h\\to0}\\frac{\\frac{2h}{6}}{h}=\\frac{2}{6}=\\frac13",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac13\"></span>","o":""}],[{"n":"5","s":[["f'(1)=\\lim_{h\\to0}\\frac{4(1+h)^2-4(1)^2}{h}","التعريف العام عند <span class=m dir=ltr>x = 1</span>"],["=\\lim_{h\\to0}\\frac{8h+4h^2}{h}=\\lim_{h\\to0}(8+4h)=8",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(1)=8\"></span>","o":""},{"n":"6","s":[["f(-2+h)=1-(4-4h+h^2)=-3+4h-h^2,\\ f(-2)=-3",""],["f'(-2)=\\lim_{h\\to0}\\frac{4h-h^2}{h}=\\lim_{h\\to0}(4-h)=4","التعريف العام"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(-2)=4\"></span>","o":""},{"n":"7","s":[["f(2+h)=(2+h)^2+(2+h)=6+5h+h^2,\\ f(2)=6",""],["f'(2)=\\lim_{h\\to0}\\frac{5h+h^2}{h}=\\lim_{h\\to0}(5+h)=5","التعريف العام"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(2)=5\"></span>","o":""},{"n":"8","s":[["f(-1+h)=(-1+h)^2-2(-1+h)+3=6-4h+h^2,\\ f(-1)=6",""],["f'(-1)=\\lim_{h\\to0}\\frac{-4h+h^2}{h}=\\lim_{h\\to0}(-4+h)=-4","التعريف العام"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(-1)=-4\"></span>","o":""}],[{"n":"9","s":[["y=10x-6x^{-\\frac12}","بكتابة الجذر على صورة أُس"],["\\frac{dy}{dx}=10+3x^{-\\frac32}=10+\\frac{3}{x\\sqrt x}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=10+\\frac{3}{\\sqrt{x^3}}\"></span>","o":""},{"n":"10","s":[["\\frac{dy}{dx}=8x^7-(-8)x^{-9}=8x^7+8x^{-9}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=8x^7+\\frac{8}{x^9}\"></span>","o":""},{"n":"11","s":[["y=9x^{-2}+3x^{\\frac12}",""],["\\frac{dy}{dx}=-18x^{-3}+\\frac32x^{-\\frac12}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{18}{x^3}+\\frac{3}{2\\sqrt x}\"></span>","o":""},{"n":"12","s":[["y=\\frac1x+\\frac{\\sqrt x}{x}=x^{-1}+x^{-\\frac12}","بتوزيع المقام"],["\\frac{dy}{dx}=-x^{-2}-\\frac12x^{-\\frac32}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{1}{x^2}-\\frac{1}{2\\sqrt{x^3}}\"></span>","o":""},{"n":"13","s":[["y=6x^{-3}+2x^{-2}-3",""],["\\frac{dy}{dx}=-18x^{-4}-4x^{-3}","مشتقة الثابت صفر"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{18}{x^4}-\\frac{4}{x^3}\"></span>","o":""},{"n":"14","s":[["y=20x^5+3x^{\\frac13}+17",""],["\\frac{dy}{dx}=100x^4+x^{-\\frac23}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=100x^4+\\frac{1}{\\sqrt[3]{x^2}}\"></span>","o":""}],[{"n":"15","s":[["\\frac{dy}{dx}=2x-1","المشتقة"],["m=2(4)-1=7,\\quad y=16-4=12","الميل ونقطة التماس <span class=m dir=ltr>(4, 12)</span>"],["y-12=7(x-4)","صيغة الميل ونقطة"],["y=7x-16",""]],"a":"<span class=\"tx\" data-t=\"y=7x-16\"></span>","o":""},{"n":"16","s":[["m_\\perp=-\\frac17","ميل العمودي <span class=m dir=ltr>=</span> سالب مقلوب ميل المماس"],["y-12=-\\frac17(x-4)","عند النقطة <span class=m dir=ltr>(4, 12)</span>"],["y=-\\frac17x+\\frac{88}{7}",""]],"a":"<span class=\"tx\" data-t=\"y=-\\frac17x+\\frac{88}{7}\"></span> (أي <span class=\"tx\" data-t=\"x+7y-88=0\"></span>)","o":""}],[{"n":"17","s":[["f(x)=24x^{-1}",""],["f'(x)=-24x^{-2}=-\\frac{24}{x^2}","مشتقة اقتران القوة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{24}{x^2}\"></span>","o":""},{"n":"18","s":[["x^2>0,\\ x\\ne0","مربع أي عدد غير صفري موجب"],["-\\frac{24}{x^2}<0","عدد سالب مقسوم على عدد موجب"]],"a":"ميل المماس <span class=\"tx\" data-t=\"f&#x27;(x)&lt;0\"></span> دائمًا لكل <span class=\"tx\" data-t=\"x\\ne0\"></span>","o":""},{"n":"19","s":[["-6=\\frac{24}{x}\\Rightarrow x=-4","نقطة التماس <span class=m dir=ltr>(−4, −6)</span>"],["f'(-4)=-\\frac{24}{16}=-\\frac32","ميل المماس"],["m_\\perp=\\frac23","ميل العمودي"],["y+6=\\frac23(x+4)\\Rightarrow y=\\frac23x-\\frac{10}{3}",""]],"a":"<span class=\"tx\" data-t=\"y=\\frac23x-\\frac{10}{3}\"></span>","o":""}],[{"n":"20","s":[["f'(x)=2x-1",""],["2x-1=3\\Rightarrow x=2","ميل المماس <span class=m dir=ltr>= 3</span>"],["f(2)=4-2-12=-10","النقطة <span class=m dir=ltr>(2, −10)</span>"],["y+10=3(x-2)\\Rightarrow y=3x-16","معادلة المماس"]],"a":"النقطة <span class=\"tx\" data-t=\"(2,-10)\"></span>، والمماس <span class=\"tx\" data-t=\"y=3x-16\"></span>","o":""}],[{"n":"21","s":[["f'(x)=3x^2-8x",""],["3x^2-8x=0\\Rightarrow x(3x-8)=0","المماس الأفقي ميله صفر"],["x=0\\ \\text{or}\\ x=\\frac83","خاصية الضرب الصفري"],["f(0)=-4,\\quad f\\left(\\tfrac83\\right)=\\frac{512}{27}-\\frac{256}{9}-4=-\\frac{364}{27}","بالتعويض في <span class=m dir=ltr>f</span>"]],"a":"النقطتان <span class=\"tx\" data-t=\"(0,-4)\"></span> و <span class=\"tx\" data-t=\"\\left(\\frac83,-\\frac{364}{27}\\right)\"></span>","o":""}],[{"n":"22","s":[["f'(x)=10x-49",""],["10x-49=1\\Rightarrow x=5","ميل المماس <span class=m dir=ltr>= 1</span>"],["f(5)=125-245+12=-108",""]],"a":"النقطة <span class=\"tx\" data-t=\"(5,-108)\"></span>","o":""}],[{"n":"23","s":[["y(1)=6-1=5\\Rightarrow P(1,5)","من الشكل <span class=m dir=ltr>x = 1</span> عند <span class=m dir=ltr>P</span>"],["\\frac{dy}{dx}=6-2x\\Rightarrow m=6-2=4","ميل المماس عند <span class=m dir=ltr>P</span>"],["y-5=4(x-1)\\Rightarrow y=4x+1",""]],"a":"<span class=\"tx\" data-t=\"y=4x+1\"></span>","o":""},{"n":"24","s":[["m_\\perp=-\\frac14",""],["y-5=-\\frac14(x-1)","عند <span class=m dir=ltr>P(1, 5)</span>"],["y=-\\frac14x+\\frac{21}{4}",""]],"a":"<span class=\"tx\" data-t=\"y=-\\frac14x+\\frac{21}{4}\"></span> (أي <span class=\"tx\" data-t=\"x+4y-21=0\"></span>)","o":""}],[{"n":"25","s":[["f(-1)=5,\\ f(1)=5","النقطتان تقعان على المنحنى"],["f'(x)=-2x",""],["f'(-1)=2:\\ y-5=2(x+1)\\Rightarrow y=2x+7","المماس عند <span class=m dir=ltr>(−1, 5)</span>"],["f'(1)=-2:\\ y-5=-2(x-1)\\Rightarrow y=-2x+7","المماس عند <span class=m dir=ltr>(1, 5)</span>"]],"a":"<span class=\"tx\" data-t=\"y=2x+7\"></span> و <span class=\"tx\" data-t=\"y=-2x+7\"></span>","o":""},{"n":"26","s":[["2x+7=-2x+7\\Rightarrow x=0","بمساواة المعادلتين"],["y=7","بالتعويض"]],"a":"نقطة التقاطع <span class=\"tx\" data-t=\"(0,7)\"></span>","o":"التبرير: المنحنى متماثل حول محور <span class=m dir=ltr>y</span> فيتقاطع المماسان على محور <span class=m dir=ltr>y</span>"}],[{"n":"27","s":[["y(k)=k^2+4k","نقطة التماس <span class=m dir=ltr>(k, k² + 4k)</span>"],["\\frac{dy}{dx}=2x+4\\Rightarrow m=2k+4","الميل عند <span class=m dir=ltr>x = k</span>"],["y-(k^2+4k)=(2k+4)(x-k)","صيغة الميل ونقطة"],["y=(2k+4)x-2k^2-4k+k^2+4k=(2k+4)x-k^2","بالتبسيط"],["y-(2k+4)x+k^2=0","المطلوب"]],"a":"تم الإثبات: <span class=\"tx\" data-t=\"y-(2k+4)x+k^2=0\"></span>","o":""},{"n":"28","s":[["4y+x=0\\Rightarrow y=-\\frac14x","ميل العمودي <span class=m dir=ltr>−1/4</span>"],["2k+4=4","ميل المماس <span class=m dir=ltr>= 4 (</span>سالب المقلوب)"],["k=0",""],["(0,0):\\ 4(0)+0=0","تحقُّق: العمودي يمر بنقطة التماس <span class=m dir=ltr>(0, 0)</span>"]],"a":"<span class=\"tx\" data-t=\"k=0\"></span>","o":""}],[{"n":"29","s":[["f'(x)=-\\frac{100}{x^2}\\Rightarrow m=-\\frac{100}{a^2}","ميل المماس عند <span class=m dir=ltr>P</span>"],["y-\\frac{100}{a}=-\\frac{100}{a^2}(x-a)\\Rightarrow y=-\\frac{100}{a^2}x+\\frac{200}{a}","معادلة المماس"],["x=0:\\ y=\\frac{200}{a};\\quad y=0:\\ x=2a","المقطعان"],["A=\\frac12\\left|2a\\right|\\left|\\frac{200}{a}\\right|=200","مساحة المثلث"]],"a":"المساحة <span class=\"tx\" data-t=\"=200\"></span> وحدة مربعة (لا تعتمد على <span class=\"tx\" data-t=\"a\"></span>)","o":""}],[{"n":"1","s":[["\\frac{dy}{dx} = 4(2)x^3 - 3(5)x^2 + 0","قاعدة القوة، ومشتقة الثابت صفر"],["\\frac{dy}{dx} = 8x^3-15x^2",""]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"y&#x27; = 8x^3-15x^2\"></span>","o":""}],[{"n":"3","s":[["y = \\frac{2x^4}{3x}+\\frac{9x^2}{3x} = \\frac{2}{3}x^3+3x","بقسمة كل حد على المقام"],["\\frac{dy}{dx} = \\frac{2}{3}(3x^2)+3 = 2x^2+3","قاعدة القوة"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"2x^2+3\"></span>","o":""}],[{"n":"4","s":[["f'(x) = 12\\times\\frac{2}{3}x^{\\frac{2}{3}-1}","قاعدة القوة"],["f'(x) = 8x^{-\\frac{1}{3}}",""]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"8x^{-\\frac{1}{3}}\"></span>","o":""}],[{"n":"6","s":[["f'(x) = \\pi x^{\\pi-1}","قاعدة القوة (<span class=\"tx\" data-t=\"\\pi\"></span> عدد ثابت)"],["\\pi \\approx \\frac{22}{7} \\Rightarrow \\pi-1 \\approx \\frac{15}{7}","باستعمال التقريب <span class=\"tx\" data-t=\"\\frac{22}{7}\"></span> الوارد في البدائل"],["f'(x) \\approx \\frac{22}{7}x^{\\frac{15}{7}}",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"\\frac{22}{7}x^{\\frac{15}{7}}\"></span>","o":""}],[{"n":"16","s":[["y = 2x+8x^{-1}","بكتابة الكسر على صورة أُس سالب"],["\\frac{dy}{dx} = 2-8x^{-2} = 2-\\frac{8}{x^2}","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx} = 2-\\frac{8}{x^2}\"></span>","o":""},{"n":"17","s":[["2x+\\frac{8}{x} = 10","نقاط التقاطع مع <span class=\"tx\" data-t=\"y=10\"></span>"],["2x^2-10x+8 = 0 \\Rightarrow x^2-5x+4=0","بضرب الطرفين في <span class=\"tx\" data-t=\"x\"></span> ثم القسمة على <span class=m dir=ltr>2</span>"],["(x-1)(x-4) = 0 \\Rightarrow x=1 \\text{ or } x=4","بالتحليل"],["\\frac{dy}{dx}\\Big|_{x=1} = 2-\\frac{8}{1} = -6","الميل عند <span class=\"tx\" data-t=\"(1,10)\"></span>"],["\\frac{dy}{dx}\\Big|_{x=4} = 2-\\frac{8}{16} = 1.5","الميل عند <span class=\"tx\" data-t=\"(4,10)\"></span>"]],"a":"ميل المماس عند <span class=\"tx\" data-t=\"(1,10)\"></span> يساوي <span class=\"tx\" data-t=\"-6\"></span>، وعند <span class=\"tx\" data-t=\"(4,10)\"></span> يساوي <span class=\"tx\" data-t=\"\\frac{3}{2}=1.5\"></span>","o":""}],[{"n":"18","s":[["y = 3x^2-3x+ax-a = 3x^2+(a-3)x-a","بالتوزيع"],["\\frac{dy}{dx} = 6x+a-3","قاعدة القوة"],["6x+a-3 = a \\Rightarrow 6x = 3 \\Rightarrow x = \\frac{1}{2}","نجعل المشتقة تساوي <span class=\"tx\" data-t=\"a\"></span>"],["y = \\left(\\frac{3}{2}+a\\right)\\left(\\frac{1}{2}-1\\right) = -\\frac{3}{4}-\\frac{a}{2}","بالتعويض <span class=\"tx\" data-t=\"x=\\frac{1}{2}\"></span> في الاقتران"]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(\\frac{1}{2},\\ -\\frac{3+2a}{4}\\right)\"></span>","o":""}],[{"n":"22","s":[["f'(x) = 3x^2","مشتقة الاقتران"],["3x^2 = 12 \\Rightarrow x^2 = 4 \\Rightarrow x = \\pm 2","نجعل الميل يساوي <span class=m dir=ltr>12</span>"],["f(2) = 8+3 = 11,\\quad f(-2) = -8+3 = -5","بالتعويض في الاقتران"]],"a":"النقطتان <span class=\"tx\" data-t=\"(2, 11)\"></span> و <span class=\"tx\" data-t=\"(-2, -5)\"></span>","o":""}],[{"n":"1","s":[["f'(0) = \\lim_{h\\to 0}\\frac{f(0+h)-f(0)}{h}","التعريف العام للمشتقة"],["f(0) = 0","قيمة الاقتران عند النقطة"],["\\frac{f(0+h)-f(0)}{h} = \\frac{5h-0}{h}","بالتعويض والتبسيط"],["= 5","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(0) = \\lim_{h\\to 0}5 = 5","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(0) = 5\"></span>","o":""},{"n":"2","s":[["f'(-3) = \\lim_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h}","التعريف العام للمشتقة"],["f(-3) = -3","قيمة الاقتران عند النقطة"],["\\frac{f(-3+h)-f(-3)}{h} = \\frac{(-3+h)-(-3)}{h} = \\frac{h}{h}","بالتعويض والتبسيط"],["= 1","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(-3) = \\lim_{h\\to 0}1 = 1","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(-3) = 1\"></span>","o":""},{"n":"3","s":[["f'(2) = \\lim_{h\\to 0}\\frac{f(2+h)-f(2)}{h}","التعريف العام للمشتقة"],["f(2) = 15","قيمة الاقتران عند النقطة"],["\\frac{f(2+h)-f(2)}{h} = \\frac{6(2+h)+3-15}{h} = \\frac{6h}{h}","بالتعويض والتبسيط"],["= 6","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(2) = \\lim_{h\\to 0}6 = 6","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(2) = 6\"></span>","o":""},{"n":"4","s":[["f'(1) = \\lim_{h\\to 0}\\frac{f(1+h)-f(1)}{h}","التعريف العام للمشتقة"],["f(1) = 5","قيمة الاقتران عند النقطة"],["\\frac{5(1+h)^2-5}{h} = \\frac{5+10h+5h^2-5}{h} = \\frac{10h+5h^2}{h}","بالتعويض والتبسيط"],["= 10+5h","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(1) = \\lim_{h\\to 0}(10+5h) = 10","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(1) = 10\"></span>","o":""},{"n":"5","s":[["f'(1) = \\lim_{h\\to 0}\\frac{f(1+h)-f(1)}{h}","التعريف العام للمشتقة"],["f(1) = 7","قيمة الاقتران عند النقطة"],["\\frac{3(1+h)^2+4(1+h)-7}{h} = \\frac{10h+3h^2}{h}","بالتعويض والتبسيط"],["= 10+3h","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(1) = \\lim_{h\\to 0}(10+3h) = 10","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(1) = 10\"></span>","o":""},{"n":"6","s":[["f'(2) = \\lim_{h\\to 0}\\frac{f(2+h)-f(2)}{h}","التعريف العام للمشتقة"],["f(2) = 4-10+7 = 1","قيمة الاقتران عند النقطة"],["\\frac{(2+h)^2-5(2+h)+7-1}{h} = \\frac{-h+h^2}{h}","بالتعويض والتبسيط"],["= -1+h","بقسمة البسط على <span class=\"tx\" data-t=\"h\"></span>"],["f'(2) = \\lim_{h\\to 0}(-1+h) = -1","بالتعويض <span class=\"tx\" data-t=\"h=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(2) = -1\"></span>","o":""}],[{"n":"7","s":[["s = 10t^{\\frac{1}{2}}","بكتابة الجذر على صورة أُس"],["\\frac{ds}{dt} = 10\\times\\frac{1}{2}t^{-\\frac{1}{2}} = \\frac{5}{\\sqrt{t}}","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{ds}{dt} = \\frac{5}{\\sqrt{t}}\"></span>","o":""},{"n":"8","s":[["s = 50t^{-1}+10","بكتابة الكسر على صورة أُس سالب"],["\\frac{ds}{dt} = -50t^{-2} = -\\frac{50}{t^2}","قاعدة القوة، ومشتقة الثابت صفر"]],"a":"<span class=\"tx\" data-t=\"\\frac{ds}{dt} = -\\frac{50}{t^2}\"></span>","o":""},{"n":"9","s":[["s = 10t^2-10t^{-2}","بكتابة الكسر على صورة أُس سالب"],["\\frac{ds}{dt} = 20t+20t^{-3} = 20t+\\frac{20}{t^3}","قاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"\\frac{ds}{dt} = 20t+\\frac{20}{t^3}\"></span>","o":""}],[{"n":"10","s":[["y = x^{\\frac{1}{2}} \\Rightarrow \\frac{dy}{dx} = \\frac{1}{2}x^{-\\frac{1}{2}} = \\frac{1}{2\\sqrt{x}}","قاعدة القوة"],["\\frac{1}{2\\sqrt{x}} = \\frac{1}{2} \\Rightarrow \\sqrt{x} = 1 \\Rightarrow x = 1","نجعل المشتقة تساوي <span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>"],["y = \\sqrt{1} = 1","بالتعويض في الاقتران"]],"a":"النقطة <span class=\"tx\" data-t=\"(1, 1)\"></span>","o":""},{"n":"11","s":[["\\frac{1}{2\\sqrt{x}} = 1 \\Rightarrow \\sqrt{x} = \\frac{1}{2} \\Rightarrow x = \\frac{1}{4}","نجعل المشتقة تساوي <span class=m dir=ltr>1</span>"],["y = \\sqrt{\\tfrac{1}{4}} = \\frac{1}{2}","بالتعويض في الاقتران"]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(\\frac{1}{4}, \\frac{1}{2}\\right)\"></span>","o":""}],[{"n":"12","s":[["y = \\frac{x^2+2ax+a^2}{x} = x+2a+a^2x^{-1}","بفك القوس وقسمة كل حد على <span class=\"tx\" data-t=\"x\"></span>"],["\\frac{dy}{dx} = 1-\\frac{a^2}{x^2}","قاعدة القوة (<span class=\"tx\" data-t=\"a\"></span> ثابت)"],["1-\\frac{a^2}{x^2} = 0 \\Rightarrow x^2 = a^2 \\Rightarrow x = a \\text{ or } x = -a","نجعل المشتقة صفرًا"],["y(a) = \\frac{(2a)^2}{a} = 4a,\\quad y(-a) = \\frac{0^2}{-a} = 0","بالتعويض في الاقتران"]],"a":"النقطتان <span class=\"tx\" data-t=\"(a, 4a)\"></span> و <span class=\"tx\" data-t=\"(-a, 0)\"></span>","o":""}],[{"n":"13","s":[["f(x) = 2+5x^{-1}","بقسمة كل حد على <span class=\"tx\" data-t=\"x\"></span>"],["f'(x) = -5x^{-2} = -\\frac{5}{x^2}","قاعدة القوة"],["f'(10) = -\\frac{5}{100} = -0.05","بالتعويض <span class=\"tx\" data-t=\"x=10\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(10) = -0.05\"></span>","o":""},{"n":"14","s":[["-\\frac{5}{x^2} = -5 \\Rightarrow x^2 = 1 \\Rightarrow x = \\pm 1","نجعل المشتقة تساوي <span class=\"tx\" data-t=\"-5\"></span>"],["f(1) = \\frac{7}{1} = 7,\\quad f(-1) = \\frac{3}{-1} = -3","بالتعويض في الاقتران"]],"a":"النقطتان <span class=\"tx\" data-t=\"(1, 7)\"></span> و <span class=\"tx\" data-t=\"(-1, -3)\"></span>","o":""}],[{"n":"15","s":[["f(-1) = \\sqrt[3]{-1} = -1","نقطة التماس <span class=\"tx\" data-t=\"(-1,-1)\"></span>"],["f'(x) = \\frac{1}{3}x^{-\\frac{2}{3}} = \\frac{1}{3\\sqrt[3]{x^2}}","قاعدة القوة"],["m = f'(-1) = \\frac{1}{3\\sqrt[3]{1}} = \\frac{1}{3}","ميل المماس"],["y-(-1) = \\frac{1}{3}(x-(-1)) \\Rightarrow y = \\frac{1}{3}x-\\frac{2}{3}","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y = \\frac{1}{3}x-\\frac{2}{3}\"></span>","o":""},{"n":"16","s":[["f(x) = 4x^{-1}+1,\\quad f(8) = \\frac{12}{8} = 1.5","نقطة التماس <span class=\"tx\" data-t=\"(8, 1.5)\"></span>"],["f'(x) = -\\frac{4}{x^2} \\Rightarrow m = f'(8) = -\\frac{4}{64} = -\\frac{1}{16}","ميل المماس"],["y-1.5 = -\\frac{1}{16}(x-8) \\Rightarrow y = -\\frac{1}{16}x+2","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y = -\\frac{1}{16}x+2\"></span>","o":""},{"n":"17","s":[["f(x) = 8x^{-\\frac{1}{2}},\\quad f(4) = \\frac{8}{2} = 4","نقطة التماس <span class=\"tx\" data-t=\"(4,4)\"></span>"],["f'(x) = -4x^{-\\frac{3}{2}} \\Rightarrow m = f'(4) = -\\frac{4}{8} = -\\frac{1}{2}","ميل المماس"],["y-4 = -\\frac{1}{2}(x-4) \\Rightarrow y = -\\frac{1}{2}x+6","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y = -\\frac{1}{2}x+6\"></span>","o":""}],[{"n":"18","s":[["f(-1) = -5+1-2 = -6","النقطة <span class=\"tx\" data-t=\"(-1,-6)\"></span>"],["f'(x) = 15x^2+2x \\Rightarrow f'(-1) = 15-2 = 13","ميل المماس"],["m_{\\perp} = -\\frac{1}{13}","ميل العمودي على المماس"],["y+6 = -\\frac{1}{13}(x+1) \\Rightarrow y = -\\frac{1}{13}x-\\frac{79}{13}","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y = -\\frac{1}{13}x-\\frac{79}{13}\"></span> (أو <span class=\"tx\" data-t=\"x+13y+79=0\"></span>)","o":""},{"n":"19","s":[["f(x) = 12x^2-2x^3,\\quad f(5) = 2(25)(1) = 50","النقطة <span class=\"tx\" data-t=\"(5,50)\"></span>"],["f'(x) = 24x-6x^2 \\Rightarrow f'(5) = 120-150 = -30","ميل المماس"],["m_{\\perp} = \\frac{1}{30}","ميل العمودي على المماس"],["y-50 = \\frac{1}{30}(x-5) \\Rightarrow y = \\frac{1}{30}x+\\frac{299}{6}","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y = \\frac{1}{30}x+\\frac{299}{6}\"></span> (أو <span class=\"tx\" data-t=\"x-30y+1495=0\"></span>)","o":""}],[{"n":"20","s":[["f'(x) = 12x^5-4x^3 = 4x^3(3x^2-1)","المماس الأفقي ميله صفر"],["4x^3(3x^2-1) = 0 \\Rightarrow x = 0 \\text{ or } x = \\pm\\frac{1}{\\sqrt{3}}","خاصية الضرب الصفري"],["f(0) = -2","بالتعويض"],["f\\left(\\pm\\tfrac{1}{\\sqrt{3}}\\right) = 2\\left(\\tfrac{1}{27}\\right)-\\tfrac{1}{9}-2 = -\\frac{55}{27}","بالتعويض (<span class=\"tx\" data-t=\"x^2=\\frac{1}{3}\"></span>)"]],"a":"النقاط <span class=\"tx\" data-t=\"(0,-2)\"></span> و <span class=\"tx\" data-t=\"\\left(\\frac{1}{\\sqrt{3}}, -\\frac{55}{27}\\right)\"></span> و <span class=\"tx\" data-t=\"\\left(-\\frac{1}{\\sqrt{3}}, -\\frac{55}{27}\\right)\"></span>","o":""}],[{"n":"21","s":[["x^2-4x+7 = \\frac{x+5}{2}","عند نقاط التقاطع تتساوى قيمتا <span class=\"tx\" data-t=\"y\"></span>"],["2x^2-8x+14 = x+5 \\Rightarrow 2x^2-9x+9 = 0","بضرب الطرفين في <span class=m dir=ltr>2</span>"],["(2x-3)(x-3) = 0 \\Rightarrow x = 1.5 \\text{ or } x = 3","بالتحليل"],["y = \\frac{1.5+5}{2} = 3.25,\\quad y = \\frac{3+5}{2} = 4","بالتعويض في معادلة المستقيم"]],"a":"<span class=\"tx\" data-t=\"A(1.5,\\ 3.25)\"></span> و <span class=\"tx\" data-t=\"B(3,\\ 4)\"></span>","o":""},{"n":"22","s":[["f'(x) = 2x-4","مشتقة الاقتران"],["f'(1.5) = -1:\\quad y-3.25 = -(x-1.5) \\Rightarrow y = -x+4.75","المماس عند <span class=\"tx\" data-t=\"A\"></span>"],["f'(3) = 2:\\quad y-4 = 2(x-3) \\Rightarrow y = 2x-2","المماس عند <span class=\"tx\" data-t=\"B\"></span>"]],"a":"عند <span class=\"tx\" data-t=\"A\"></span>: <span class=\"tx\" data-t=\"y = -x+4.75\"></span>، وعند <span class=\"tx\" data-t=\"B\"></span>: <span class=\"tx\" data-t=\"y = 2x-2\"></span>","o":""}],[{"n":"23","s":[["f'(x) = 2x-5 \\Rightarrow f'(1) = -3","ميل المماس عند <span class=\"tx\" data-t=\"P(1,6)\"></span>"],["y-6 = -3(x-1) \\Rightarrow y = -3x+9","معادلة المماس"],["x=0 \\Rightarrow y = 9;\\quad y=0 \\Rightarrow x = 3","نقطتا تقاطع المماس مع المحورين: <span class=\"tx\" data-t=\"(0,9)\"></span> و <span class=\"tx\" data-t=\"(3,0)\"></span>"],["A = \\frac{1}{2}\\times 3\\times 9 = 13.5","مساحة المثلث القائم"]],"a":"مساحة المثلث <span class=\"tx\" data-t=\"13.5\"></span> وحدة مربعة","o":""}]]