","-5"]},{"p":["13","7","-17"]}]},{"n":"41","s":[["\\overrightarrow{PQ}=\\langle 14,-6,-12\\rangle,\\ PQ=\\sqrt{196+36+144}=\\sqrt{376}","إيجاد طول <span class=m dir=ltr>PQ</span>"],["R=(-10+3u,\\ 31-6u,\\ -26+7u)\\Rightarrow \\overrightarrow{PR}=\\langle 3u-9,\\ 18-6u,\\ 7u-21\\rangle=(u-3)\\langle 3,-6,7\\rangle","الصورة العامة للنقطة <span class=m dir=ltr>R</span> على <span class=\"tx\" data-t=\"l_2\"></span> (و<span class=m dir=ltr>P</span> عند <span class=m dir=ltr>u = 3)</span>"],["PR^2=(u-3)^2(9+36+49)=94(u-3)^2","مربع طول <span class=m dir=ltr>PR</span>"],["94(u-3)^2=376\\Rightarrow (u-3)^2=4\\Rightarrow u=5\\ \\text{or}\\ u=1","لأن <span class=m dir=ltr>PQ = PR</span>"],["u=5\\Rightarrow R=(-10+15,\\ 31-30,\\ -26+35)=(5,1,9)","نأخذ <span class=m dir=ltr>u = 5</span> لأن <span class=m dir=ltr>u &gt; 3</span>"]],"a":"<span class=\"tx\" data-t=\"R(5,1,9)\"></span>","o":"","k":[{"p":["5","1","9"]}]},{"n":"42","s":[["\\overrightarrow{PQ}=\\langle 14,-6,-12\\rangle,\\quad \\overrightarrow{PR}=\\langle 6,-12,14\\rangle","متجها ضلعي الزاوية من الرأس <span class=m dir=ltr>P</span>"],["\\overrightarrow{PQ}\\cdot\\overrightarrow{PR}=84+72-168=-12","الضرب القياسي"],["|\\overrightarrow{PQ}|=|\\overrightarrow{PR}|=\\sqrt{376}","المقداران"],["\\cos\\theta=\\frac{-12}{\\sqrt{376}\\sqrt{376}}=\\frac{-12}{376}=-\\frac{3}{94}","قانون الزاوية بين متجهين"]],"a":"<span class=\"tx\" data-t=\"\\cos\\theta=-\\frac{3}{94}\"></span> (وهو المطلوب)","o":"","k":[{"e":"-3/94","a":null}]},{"n":"43","s":[["\\sin\\theta=\\sqrt{1-\\left(\\frac{-3}{94}\\right)^2}=\\sqrt{\\frac{8836-9}{8836}}=\\frac{\\sqrt{8827}}{94}","المتطابقة <span class=\"tx\" data-t=\"\\sin^2\\theta+\\cos^2\\theta=1\"></span> (والزاوية في مثلث فـ <span class=m dir=ltr>sin</span> موجب)"],["A=\\frac{1}{2}(PQ)(PR)\\sin\\theta","مساحة المثلث بدلالة ضلعين والزاوية المحصورة"],["A=\\frac{1}{2}\\times 376\\times\\frac{\\sqrt{8827}}{94}=2\\sqrt{8827}","بالتعويض، لأن <span class=\"tx\" data-t=\"\\sqrt{376}\\times\\sqrt{376}=376\"></span>"]],"a":"مساحة المثلث <span class=\"tx\" data-t=\"PQR=2\\sqrt{8827}\\approx 187.9\"></span> وحدة مربعة (وهو المطلوب)","o":""}],[{"n":"44","s":[["\\vec{A}=\\vec{B}-\\overrightarrow{AB}=\\langle 8-2,\\ 3-4,\\ -2-4\\rangle=(6,-1,-6)","إيجاد إحداثيات <span class=m dir=ltr>A</span>"],["\\overrightarrow{AH}=\\overrightarrow{AD}+\\overrightarrow{DH}=\\overrightarrow{AD}+\\overrightarrow{AE}","لأن <span class=\"tx\" data-t=\"\\overrightarrow{DH}=\\overrightarrow{AE}\"></span> (أحرف متوازية ومتساوية)"],["\\overrightarrow{AH}=\\langle -10-6,\\ 10-3,\\ -5+6\\rangle=\\langle -16,7,1\\rangle","جمع المتجهات"],["H=(6-16,\\ -1+7,\\ -6+1)=(-10,6,-5)","بإضافة <span class=\"tx\" data-t=\"\\overrightarrow{AH}\"></span> إلى إحداثيات <span class=m dir=ltr>A</span>"]],"a":"<span class=\"tx\" data-t=\"H(-10,6,-5)\"></span>","o":"","k":[{"p":["-10","6","-5"]}]},{"n":"45","s":[["\\overrightarrow{AG}=\\overrightarrow{AB}+\\overrightarrow{AD}+\\overrightarrow{AE}=\\langle -14,11,5\\rangle","قطر متوازي المستطيلات"],["\\overrightarrow{AC}=\\overrightarrow{AB}+\\overrightarrow{AD}=\\langle -8,14,-1\\rangle","قطر القاعدة"],["\\overrightarrow{AG}\\cdot\\overrightarrow{AC}=112+154-5=261","الضرب القياسي"],["|\\overrightarrow{AG}|=\\sqrt{342},\\quad |\\overrightarrow{AC}|=\\sqrt{261}","المقداران"],["\\cos\\theta=\\frac{261}{\\sqrt{342}\\sqrt{261}}\\approx 0.8736\\Rightarrow \\theta\\approx 29.1^\\circ","قانون الزاوية بين متجهين"]],"a":"<span class=\"tx\" data-t=\"m\\angle GAC\\approx 29.1^\\circ\"></span>","o":""},{"n":"46","s":[["\\overrightarrow{AX}=\\overrightarrow{AE}+\\frac{1}{2}\\overrightarrow{EF}=\\overrightarrow{AE}+\\frac{1}{2}\\overrightarrow{AB}=\\langle -5,-1,8\\rangle","<span class=m dir=ltr>X</span> منتصف <span class=\"tx\" data-t=\"\\overline{EF}\"></span> و <span class=\"tx\" data-t=\"\\overrightarrow{EF}=\\overrightarrow{AB}\"></span>"],["\\overrightarrow{XD}=\\overrightarrow{AD}-\\overrightarrow{AX}=\\langle -5,11,-13\\rangle","طرح المتجهات"],["\\overrightarrow{XC}=\\overright