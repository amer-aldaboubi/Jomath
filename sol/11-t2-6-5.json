[[{"n":"1","s":[["\\log 19 \\approx 1.2788","باستعمال الآلة الحاسبة (الأساس <span class=m dir=ltr>10)</span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.3\"></span>","o":"","k":[{"e":"1.3","a":true}]},{"n":"2","s":[["\\log(2.5 \\times 10^{-3}) = \\log 2.5 + \\log 10^{-3}","قانون الضرب"],["\\approx 0.3979 - 3 = -2.6021","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx -2.6\"></span>","o":"","k":[{"e":"-2.6","a":true}]},{"n":"3","s":[["\\ln 3.1 \\approx 1.1314","باستعمال الآلة الحاسبة (الأساس <span class=m dir=ltr>e)</span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.1\"></span>","o":"","k":[{"e":"1.1","a":true}]},{"n":"4","s":[["\\log_{2} 10 = \\frac{\\log 10}{\\log 2}","قانون تغيير الأساس"],["= \\frac{1}{0.3010} \\approx 3.3219","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 3.3\"></span>","o":"","k":[{"e":"3.3","a":true}]},{"n":"5","s":[["\\log_{3} e^{2} = \\frac{\\ln e^{2}}{\\ln 3}","قانون تغيير الأساس"],["= \\frac{2}{\\ln 3} \\approx \\frac{2}{1.0986} \\approx 1.8205","لأنّ <span class=\"tx\" data-t=\"\\ln e^2 = 2\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.8\"></span>","o":"","k":[{"e":"1.8","a":true}]},{"n":"6","s":[["\\ln 5 \\approx 1.6094","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.6\"></span>","o":"","k":[{"e":"1.6","a":true}]}],[{"n":"7","s":[["\\log_{3} 33 = \\frac{\\log 33}{\\log 3}","قانون تغيير الأساس"],["\\approx \\frac{1.5185}{0.4771} \\approx 3.1827","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 3.18\"></span>","o":"","k":[{"e":"3.18","a":true}]},{"n":"8","s":[["\\log_{\\frac{1}{3}} 17 = \\frac{\\log 17}{\\log \\frac{1}{3}}","قانون تغيير الأساس"],["\\approx \\frac{1.2304}{-0.4771} \\approx -2.5789","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx -2.58\"></span>","o":"","k":[{"e":"-2.58","a":true}]},{"n":"9","s":[["\\log_{6} 5 = \\frac{\\log 5}{\\log 6}","قانون تغيير الأساس"],["\\approx \\frac{0.6990}{0.7782} \\approx 0.8982","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.90\"></span>","o":"","k":[{"e":"0.9","a":true}]},{"n":"10","s":[["\\log_{7} \\frac{1}{7} = \\log_{7} 7^{-1} = -1","خاصية: <span class=\"tx\" data-t=\"\\log_b b^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"-1\"></span>","o":"","k":[{"e":"-1","a":null}]},{"n":"11","s":[["\\log 1000 = \\log 10^{3} = 3","خاصية: <span class=\"tx\" data-t=\"\\log_b b^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"3\"></span>","o":"","k":[{"e":"3","a":null}]},{"n":"12","s":[["\\log_{3} 15 = \\frac{\\log 15}{\\log 3}","قانون تغيير الأساس"],["\\approx \\frac{1.1761}{0.4771} \\approx 2.4650","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.46\"></span>","o":"","k":[{"e":"2.46","a":true}]}],[{"n":"13","s":[["\\log 6^{x} = \\log 121","بأخذ اللوغاريتم للطرفين"],["x\\log 6 = \\log 121","قانون القوة"],["x = \\frac{\\log 121}{\\log 6} \\approx 2.6766","بقسمة الطرفين على <span class=\"tx\" data-t=\"\\log 6\"></span>"]],"a":"<span class=\"tx\" data-t=\"x \\approx 2.6766\"></span>","o":"","k":[{"e":"2.6766","a":true}]},{"n":"14","s":[["e^{4x} = 9","بقسمة الطرفين على <span class=m dir=ltr>−3</span>"],["4x = \\ln 9","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["x = \\frac{\\ln 9}{4} \\approx 0.5493","بقسمة الطرفين على <span class=m dir=ltr>4</span>"]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.5493\"></span>","o":"","k":[{"e":"0.5493","a":true}]},{"n":"15","s":[["(7x - 2)\\ln 5 = 2x\\ln 3","بأخذ <span class=m dir=ltr>ln</span> للطرفين وقانون القوة"],["7x\\ln 5 - 2x\\ln 3 = 2\\ln 5","بالتوزيع وتجميع حدود <span class=m dir=ltr>x</span>"],["x(7\\ln 5 - 2\\ln 3) = 2\\ln 5","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا"],["x = \\frac{2\\ln 5}{7\\ln 5 - 2\\ln 3} \\approx 0.3549","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.3549\"></span>","o":"","k":[{"e":"0.3549","a":true}]},{"n":"16","s":[["(5^{x})^{2} + 5^{x} - 42 = 0","لأنّ <span class=\"tx\" data-t=\"25^x = (5^x)^2\"></span>"],["u^{2} + u - 42 = 0,\\quad u = 5^{x}","بفرض <span class=\"tx\" data-t=\"u = 5^x\"></span>"],["(u + 7)(u - 6) = 0","بالتحليل"],["u = 6,\\quad u = -7","خاصية الضرب الصفري، و <span class=\"tx\" data-t=\"u=-7\"></span> مرفوض لأنّ <span class=\"tx\" data-t=\"5^x &gt; 0\"></span>"],["5^{x} = 6 \\Rightarrow x = \\frac{\\log 6}{\\log 5} \\approx 1.1133","بأخذ اللوغاريتم للطرفين"]],"a":"<span class=\"tx\" data-t=\"x \\approx 1.1133\"></span>","o":"","k":[{"e":"1.1133","a":true}]},{"n":"17","s":[["9^{x} = 16","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["x\\log 9 = \\log 16","بأخذ اللوغاريتم للطرفين"],["x = \\frac{\\log 16}{\\log 9} \\approx 1.2619","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"x \\approx 1.2619\"></span>","o":"","k":[{"e":"1.2619","a":true}]},{"n":"18","s":[["(2x + 3)\\ln 27 = (x - 5)\\ln 2","بأخذ <span class=m dir=ltr>ln</span> للطرفين وقانون القوة"],["2x\\ln 27 - x\\ln 2 = -5\\ln 2 - 3\\ln 27","بالتوزيع وتجميع حدود <span class=m dir=ltr>x</span>"],["x(2\\ln 27 - \\ln 2) = -5\\ln 2 - 3\\ln 27","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا"],["x = \\frac{-5\\ln 2 - 3\\ln 27}{2\\ln 27 - \\ln 2} \\approx -2.2638","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"x \\approx -2.2638\"></span>","o":"","k":[{"e":"-2.2638","a":true}]}],[{"n":"19","s":[["97 = 873e^{-0.078t}","بتعويض <span class=m dir=ltr>N = 97</span>"],["e^{-0.078t} = \\frac{97}{873} = \\frac{1}{9}","بقسمة الطرفين على <span class=m dir=ltr>873</span>"],["-0.078t = \\ln \\frac{1}{9} = -\\ln 9","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = \\frac{\\ln 9}{0.078} \\approx 28.17","بقسمة الطرفين على <span class=m dir=ltr>−0.078</span>"]],"a":"بعد <span class=\"tx\" data-t=\"28.17\"></span> سنة تقريبًا (أي نحو <span class=m dir=ltr>28</span> سنة)","o":""}],[{"n":"20","s":[["\\log \\frac{x + 5}{x - 3} = \\log 2","قانون القسمة"],["\\frac{x + 5}{x - 3} = 2","خاصية الواحد لواحد"],["x + 5 = 2x - 6 \\Rightarrow x = 11","بالضرب التبادلي والحل"],["x = 11:\\ x + 5 = 16 > 0,\\ x - 3 = 8 > 0","التحقق من الحل"]],"a":"<span class=\"tx\" data-t=\"x = 11\"></span>","o":"","k":[{"e":"11","a":null}]},{"n":"21","s":[["\\ln((x + 8)(x - 1)) = \\ln x^{2}","قانونا الضرب والقوة"],["x^{2} + 7x - 8 = x^{2}","خاصية الواحد لواحد"],["7x = 8 \\Rightarrow x = \\frac{8}{7}","بطرح <span class=\"tx\" data-t=\"x^2\"></span> من الطرفين"],["x = \\frac{8}{7}:\\ x - 1 = \\frac{1}{7} > 0","التحقق: جميع المقادير موجبة"]],"a":"<span class=\"tx\" data-t=\"x = \\frac{8}{7}\"></span>","o":"","k":[{"e":"8/7","a":null}]},{"n":"22","s":[["\\log_{4} x = 3^{0} = 1","بالصورة الأسية"],["x = 4^{1} = 4","بالصورة الأسية مرة أخرى"]],"a":"<span class=\"tx\" data-t=\"x = 4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"23","s":[["2\\ln x = (\\ln x)^{2}","قانون القوة"],["(\\ln x)^{2} - 2\\ln x = 0 \\Rightarrow \\ln x(\\ln x - 2) = 0","بالتحليل"],["\\ln x = 0 \\Rightarrow x = 1","خاصية الضرب الصفري"],["\\ln x = 2 \\Rightarrow x = e^{2} \\approx 7.389",""]],"a":"<span class=\"tx\" data-t=\"x = 1\"></span> أو <span class=\"tx\" data-t=\"x = e^{2}\"></span>","o":"","k":[{"e":"1","a":null},{"e":"exp(2)","a":null}]},{"n":"24","s":[["\\log 50^{2} = \\log 25^{3} + \\log(x - 2)","قانون القوة"],["\\log 2500 = \\log(15625(x - 2))","قانون الضرب"],["2500 = 15625(x - 2) \\Rightarrow x - 2 = 0.16","خاصية الواحد لواحد"],["x = 2.16","التحقق: <span class=\"tx\" data-t=\"x - 2 = 0.16 &gt; 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = 2.16\"></span>","o":"","k":[{"e":"2.16","a":true}]},{"n":"25","s":[["\\log_{x} 16 = \\frac{4}{3}","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["x^{\\frac{4}{3}} = 16","بالصورة الأسية"],["x = 16^{\\frac{3}{4}} = (2^{4})^{\\frac{3}{4}} = 2^{3} = 8","برفع الطرفين للقوة <span class=\"tx\" data-t=\"\\frac{3}{4}\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = 8\"></span>","o":"","k":[{"e":"8","a":null}]}],[{"n":"26","s":[["2P = Pe^{0.05t}","<span class=m dir=ltr>A = 2P</span> ، <span class=m dir=ltr>r = 0.05</span>"],["e^{0.05t} = 2","بقسمة الطرفين على <span class=m dir=ltr>P</span>"],["0.05t = \\ln 2","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = \\frac{\\ln 2}{0.05} \\approx 13.86","بقسمة الطرفين على <span class=m dir=ltr>0.05</span>"]],"a":"بعد <span class=\"tx\" data-t=\"13.86\"></span> سنة تقريبًا","o":"","k":[{"e":"13.86","a":true}]},{"n":"27","s":[["3P = Pe^{0.05t}","<span class=m dir=ltr>A = 3P</span> ، <span class=m dir=ltr>r = 0.05</span>"],["e^{0.05t} = 3","بقسمة الطرفين على <span class=m dir=ltr>P</span>"],["0.05t = \\ln 3","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = \\frac{\\ln 3}{0.05} \\approx 21.97","بقسمة الطرفين على <span class=m dir=ltr>0.05</span>"]],"a":"بعد <span class=\"tx\" data-t=\"21.97\"></span> سنة تقريبًا","o":"","k":[{"e":"21.97","a":true}]}],[{"n":"28","s":[["8850 = 15500(5 - \\log P)","بتعويض <span class=m dir=ltr>H = 8850</span>"],["5 - \\log P = \\frac{8850}{15500} \\approx 0.570968","بقسمة الطرفين على <span class=m dir=ltr>15500</span>"],["\\log P \\approx 4.429032","بطرح من <span class=m dir=ltr>5</span>"],["P = 10^{4.429032} \\approx 26855","بالصورة الأسية"]],"a":"الضغط الجوي على قمة إفرست <span class=\"tx\" data-t=\"\\approx 26855\"></span> باسكال","o":""}],[{"n":"29","s":[["k = f(-2) = e^{0.5(-2) + 3} = e^{2}","النقطة <span class=\"tx\" data-t=\"(-2, k)\"></span> على المنحنى: نعوّض <span class=m dir=ltr>x = −2</span>"],["k = e^{2} \\approx 7.389",""],["e^{0.5h + 3} = 100","النقطة <span class=\"tx\" data-t=\"(h, 100)\"></span> على المنحنى"],["0.5h + 3 = \\ln 100","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["h = 2(\\ln 100 - 3) \\approx 3.2103","بطرح <span class=m dir=ltr>3</span> والضرب في <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"k = e^{2} \\approx 7.389\"></span> ، <span class=\"tx\" data-t=\"h = 2\\ln 100 - 6 \\approx 3.21\"></span>","o":"التبرير: النقطة تقع على المنحنى إذا حقق إحداثياها قاعدة الاقتران، فنعوّض ونحل.","k":[{"e":"7.389","a":true},{"e":"3.21","a":true}]}],[{"n":"30","s":[["3^x + \\frac{4}{3^x} = 5","المعادلة المعطاة"],["y + \\frac{4}{y} = 5","بفرض <span class=\"tx\" data-t=\"y = 3^x\"></span> حيث <span class=\"tx\" data-t=\"y &gt; 0\"></span>"],["y^2 - 5y + 4 = 0","بضرب الطرفين في <span class=\"tx\" data-t=\"y\"></span> والترتيب"],["(y-1)(y-4) = 0 \\Rightarrow y = 1 ,\\  y = 4","بالتحليل وخاصية الضرب الصفري"],["3^x = 1 \\Rightarrow x = 0","الحل الأول"],["3^x = 4 \\Rightarrow x = \\frac{\\log 4}{\\log 3} \\approx 1.2619","بأخذ <span class=m dir=ltr>log</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"x = 0\"></span> أو <span class=\"tx\" data-t=\"x = \\log_3 4 \\approx 1.2619\"></span>","o":""}],[{"n":"31","s":[["\\log_3 x = k \\log_2 x","المعادلة المعطاة"],["\\frac{\\log x}{\\log 3} = k \\cdot \\frac{\\log x}{\\log 2}","بقانون تغيير الأساس"],["k = \\frac{\\log 2}{\\log 3}","بقسمة الطرفين على <span class=\"tx\" data-t=\"\\frac{\\log x}{\\log 2}\"></span> (بفرض <span class=\"tx\" data-t=\"x \\ne 1\"></span>)"],["k = \\log_3 2 \\approx 0.6309","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"k = \\log_3 2 \\approx 0.6309\"></span>","o":"التبرير: كل لوغاريتم يُكتب بدلالة <span class=m dir=ltr>log</span> الاعتيادي، فتكون النسبة بين <span class=\"tx\" data-t=\"\\log_3 x\"></span> و <span class=\"tx\" data-t=\"\\log_2 x\"></span> ثابتة لا تعتمد على <span class=\"tx\" data-t=\"x\"></span> وتساوي <span class=\"tx\" data-t=\"\\frac{\\log 2}{\\log 3}\"></span> (وعند <span class=\"tx\" data-t=\"x = 1\"></span> يتحقق الطرفان لأي <span class=\"tx\" data-t=\"k\"></span>)."}],[{"n":"6","s":[["2^{x+1} = (2^2)^{x-1} = 2^{2x-2}","بكتابة الطرفين بالأساس <span class=m dir=ltr>2</span>"],["x + 1 = 2x - 2","بمساواة الأسس"],["x = 3",""]],"a":"<span class=\"tx\" data-t=\"x = 3\"></span>، الإجابة <span class=m dir=ltr>b</span>","o":"","k":[{"e":"3","a":null}]}],[{"n":"8","s":[["e^{x^2} = 1 = e^0","<span class=\"tx\" data-t=\"1 = e^0\"></span>"],["x^2 = 0 \\Rightarrow x = 0","بمساواة الأسس"]],"a":"<span class=\"tx\" data-t=\"x = 0\"></span>، الإجابة <span class=m dir=ltr>a</span>","o":"","k":[{"e":"0","a":null}]}],[{"n":"16","s":[["(2^3)^x = 2^1","بكتابة الطرفين بالأساس <span class=m dir=ltr>2</span>"],["3x = 1","بمساواة الأسس"],["x = \\frac{1}{3} \\approx 0.3333",""]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.3333\"></span>","o":"","k":[{"e":"0.3333","a":true}]},{"n":"17","s":[["e^{4x+1} = 32","بقسمة الطرفين على <span class=\"tx\" data-t=\"-3\"></span>"],["4x + 1 = \\ln 32","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["x = \\frac{\\ln 32 - 1}{4}","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["x \\approx 0.6164","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.6164\"></span>","o":"","k":[{"e":"0.6164","a":true}]},{"n":"18","s":[["(2x + 3)\\log 11 = x \\log 5","بأخذ <span class=m dir=ltr>log</span> للطرفين وقانون القوة"],["2x\\log 11 - x\\log 5 = -3\\log 11","بالتوزيع وتجميع حدود <span class=m dir=ltr>x</span>"],["x = \\frac{-3\\log 11}{2\\log 11 - \\log 5}","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا والقسمة"],["x \\approx -2.2577","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"x \\approx -2.2577\"></span>","o":"","k":[{"e":"-2.2577","a":true}]},{"n":"19","s":[["(7^x)^2 + 7^x - 72 = 0","<span class=\"tx\" data-t=\"49^x = (7^x)^2\"></span>"],["y^2 + y - 72 = 0","بفرض <span class=\"tx\" data-t=\"y = 7^x &gt; 0\"></span>"],["(y + 9)(y - 8) = 0","بالتحليل"],["y = 8","نرفض <span class=\"tx\" data-t=\"y = -9\"></span> لأن <span class=\"tx\" data-t=\"7^x &gt; 0\"></span>"],["7^x = 8 \\Rightarrow x = \\frac{\\log 8}{\\log 7} \\approx 1.0686","بأخذ <span class=m dir=ltr>log</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"x \\approx 1.0686\"></span>","o":"","k":[{"e":"1.0686","a":true}]},{"n":"20","s":[["\\log_4 (x+3)(x-3) = 2","قانون الضرب"],["x^2 - 9 = 4^2 = 16","بالتحويل إلى الصورة الأسية"],["x^2 = 25 \\Rightarrow x = \\pm 5",""],["x = -5","مرفوض لأن <span class=\"tx\" data-t=\"\\log_4(-2)\"></span> غير معرّف"]],"a":"<span class=\"tx\" data-t=\"x = 5\"></span>","o":"","k":[{"e":"5","a":null}]}],[{"n":"23","s":[["30e^{0.1t} = 10000","بتعويض <span class=\"tx\" data-t=\"v(t) = 10000\"></span>"],["e^{0.1t} = \\frac{1000}{3}","بقسمة الطرفين على <span class=m dir=ltr>30</span>"],["0.1t = \\ln \\frac{1000}{3}","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = 10\\ln \\frac{1000}{3} \\approx 58.09","بقسمة الطرفين على <span class=m dir=ltr>0.1</span>"]],"a":"بعد <span class=\"tx\" data-t=\"58\"></span> دقيقة تقريبًا (<span class=\"tx\" data-t=\"t \\approx 58.09\"></span>)","o":"","k":[{"e":"58","a":null},{"e":"58.09","a":true}]}],[{"n":"24","s":[["N(0) = 100e^{0} = 100","بتعويض <span class=\"tx\" data-t=\"t = 0\"></span>"]],"a":"العدد الأصلي <span class=\"tx\" data-t=\"100\"></span> خلية","o":"","k":[{"e":"100","a":null}]},{"n":"25","s":[["N(5) = 100e^{0.045 \\times 5} = 100e^{0.225}","بتعويض <span class=\"tx\" data-t=\"t = 5\"></span>"],["N(5) \\approx 125.23","باستعمال الآلة الحاسبة"]],"a":"نحو <span class=\"tx\" data-t=\"125\"></span> خلية","o":"","k":[{"e":"125","a":null}]},{"n":"26","s":[["100e^{0.045t} = 1400","بتعويض <span class=\"tx\" data-t=\"N(t) = 1400\"></span>"],["e^{0.045t} = 14","بقسمة الطرفين على <span class=m dir=ltr>100</span>"],["0.045t = \\ln 14","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = \\frac{\\ln 14}{0.045} \\approx 58.65",""]],"a":"بعد <span class=\"tx\" data-t=\"58.65\"></span> يومًا تقريبًا","o":"","k":[{"e":"58.65","a":true}]},{"n":"27","s":[["100e^{0.045t} = 200","ضعف العدد الأصلي"],["e^{0.045t} = 2 \\Rightarrow 0.045t = \\ln 2","بالقسمة على <span class=m dir=ltr>100</span> وأخذ <span class=m dir=ltr>ln</span>"],["t = \\frac{\\ln 2}{0.045} \\approx 15.40",""]],"a":"بعد <span class=\"tx\" data-t=\"15.40\"></span> يومًا تقريبًا","o":"","k":[{"e":"15.4","a":true}]}],[{"n":"1","s":[["\\log 17 \\approx 1.2304","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.2\"></span>","o":"","k":[{"e":"1.2","a":true}]},{"n":"2","s":[["\\log (1.5 \\times 10^{-4}) = \\log 1.5 - 4 \\approx -3.8239","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx -3.8\"></span>","o":"","k":[{"e":"-3.8","a":true}]},{"n":"3","s":[["\\ln 2.3 \\approx 0.8329","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 0.8\"></span>","o":"","k":[{"e":"0.8","a":true}]},{"n":"4","s":[["\\log_2 15 = \\frac{\\log 15}{\\log 2} \\approx 3.9069","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx 3.9\"></span>","o":"","k":[{"e":"3.9","a":true}]},{"n":"5","s":[["\\log_5 e^7 = \\frac{\\ln e^7}{\\ln 5} = \\frac{7}{\\ln 5} \\approx 4.3493","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx 4.3\"></span>","o":"","k":[{"e":"4.3","a":true}]},{"n":"6","s":[["\\ln 7 \\approx 1.9459","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.9\"></span>","o":"","k":[{"e":"1.9","a":true}]}],[{"n":"7","s":[["\\log_5 27 = \\frac{\\log 27}{\\log 5} \\approx 2.0478","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.05\"></span>","o":"","k":[{"e":"2.05","a":true}]},{"n":"8","s":[["\\log_{\\frac{1}{4}} 19 = \\frac{\\log 19}{\\log 0.25} \\approx -2.1240","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx -2.12\"></span>","o":"","k":[{"e":"-2.12","a":true}]},{"n":"9","s":[["\\log_7 8 = \\frac{\\log 8}{\\log 7} \\approx 1.0686","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx 1.07\"></span>","o":"","k":[{"e":"1.07","a":true}]},{"n":"10","s":[["\\log_8 \\frac{1}{8} = \\log_8 8^{-1} = -1","<span class=\"tx\" data-t=\"\\log_b b^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"-1\"></span>","o":"","k":[{"e":"-1","a":null}]},{"n":"11","s":[["\\log 10000 = \\log 10^4 = 4","<span class=\"tx\" data-t=\"\\log 10^x = x\"></span>"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"12","s":[["\\log_3 18 = \\frac{\\log 18}{\\log 3} \\approx 2.6309","بقانون تغيير الأساس"]],"a":"<span class=\"tx\" data-t=\"\\approx 2.63\"></span>","o":"","k":[{"e":"2.63","a":true}]}],[{"n":"13","s":[["x = \\log_5 120 = \\frac{\\log 120}{\\log 5}","بالتحويل إلى الصورة اللوغاريتمية وتغيير الأساس"],["x \\approx 2.9746","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"x \\approx 2.9746\"></span>","o":"","k":[{"e":"2.9746","a":true}]},{"n":"14","s":[["e^{4x} = 16","بقسمة الطرفين على <span class=\"tx\" data-t=\"-4\"></span>"],["4x = \\ln 16","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["x = \\frac{\\ln 16}{4} = \\ln 2 \\approx 0.6931",""]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.6931\"></span>","o":"","k":[{"e":"0.6931","a":true}]},{"n":"15","s":[["(2x + 1)\\log 3 = 5x\\log 7","بأخذ <span class=m dir=ltr>log</span> للطرفين وقانون القوة"],["2x\\log 3 - 5x\\log 7 = -\\log 3","بالتوزيع وتجميع حدود <span class=m dir=ltr>x</span>"],["x = \\frac{\\log 3}{5\\log 7 - 2\\log 3}","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا والقسمة"],["x \\approx 0.1459","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"x \\approx 0.1459\"></span>","o":"","k":[{"e":"0.1459","a":true}]},{"n":"16","s":[["(8^x)^2 + 2(8^x) - 3 = 0","<span class=\"tx\" data-t=\"64^x = (8^x)^2\"></span>"],["y^2 + 2y - 3 = 0","بفرض <span class=\"tx\" data-t=\"y = 8^x &gt; 0\"></span>"],["(y + 3)(y - 1) = 0","بالتحليل"],["y = 1","نرفض <span class=\"tx\" data-t=\"y = -3\"></span> لأن <span class=\"tx\" data-t=\"8^x &gt; 0\"></span>"],["8^x = 1 \\Rightarrow x = 0",""]],"a":"<span class=\"tx\" data-t=\"x = 0\"></span>","o":"","k":[{"e":"0","a":null}]},{"n":"17","s":[["4^x = 7","بقسمة الطرفين على <span class=m dir=ltr>7</span>"],["x = \\frac{\\log 7}{\\log 4} \\approx 1.4037","بأخذ <span class=m dir=ltr>log</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"x \\approx 1.4037\"></span>","o":"","k":[{"e":"1.4037","a":true}]},{"n":"18","s":[["(x - 1)\\log 21 = (7x + 1)\\log 3","بأخذ <span class=m dir=ltr>log</span> للطرفين وقانون القوة"],["x\\log 21 - 7x\\log 3 = \\log 21 + \\log 3","بالتوزيع وتجميع حدود <span class=m dir=ltr>x</span>"],["x = \\frac{\\log 21 + \\log 3}{\\log 21 - 7\\log 3}","بإخراج <span class=m dir=ltr>x</span> عاملًا مشتركًا والقسمة"],["x \\approx -0.8918","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"x \\approx -0.8918\"></span>","o":"","k":[{"e":"-0.8918","a":true}]}],[{"n":"19","s":[["x^3 = 216","بالتحويل إلى الصورة الأسية"],["x = \\sqrt[3]{216} = 6",""]],"a":"<span class=\"tx\" data-t=\"x = 6\"></span>","o":"","k":[{"e":"6","a":null}]},{"n":"20","s":[["x^{\\frac{1}{2}} = 4","بالتحويل إلى الصورة الأسية"],["x = 4^2 = 16","بتربيع الطرفين"]],"a":"<span class=\"tx\" data-t=\"x = 16\"></span>","o":"","k":[{"e":"16","a":null}]},{"n":"21","s":[["x^{\\frac{3}{2}} = 27","بالتحويل إلى الصورة الأسية (<span class=\"tx\" data-t=\"1.5 = \\frac{3}{2}\"></span>)"],["x = 27^{\\frac{2}{3}} = (\\sqrt[3]{27})^2 = 9","برفع الطرفين للقوة <span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = 9\"></span>","o":"","k":[{"e":"9","a":null}]},{"n":"22","s":[["x^2 - 15 = 2x","خاصية الواحد لواحد للوغاريتمات"],["x^2 - 2x - 15 = 0 \\Rightarrow (x - 5)(x + 3) = 0","بالتحليل"],["x = 5 ,\\  x = -3","خاصية الضرب الصفري"],["x = -3","مرفوض لأن <span class=\"tx\" data-t=\"2x = -6 &lt; 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = 5\"></span>","o":"","k":[{"e":"5","a":null}]},{"n":"23","s":[["x^2 - 4 = 3x","خاصية الواحد لواحد للوغاريتمات"],["x^2 - 3x - 4 = 0 \\Rightarrow (x - 4)(x + 1) = 0","بالتحليل"],["x = 4 ,\\  x = -1","خاصية الضرب الصفري"],["x = -1","مرفوض لأن <span class=\"tx\" data-t=\"3x = -3 &lt; 0\"></span>"]],"a":"<span class=\"tx\" data-t=\"x = 4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"24","s":[["(x - 1)^5 = 1024 = 4^5","بالتحويل إلى الصورة الأسية"],["x - 1 = 4 \\Rightarrow x = 5",""]],"a":"<span class=\"tx\" data-t=\"x = 5\"></span>","o":"التحقق: الأساس <span class=\"tx\" data-t=\"x - 1 = 4 &gt; 0\"></span> ولا يساوي <span class=m dir=ltr>1</span>.","k":[{"e":"5","a":null}]}],[{"n":"25","s":[["P = \\frac{2}{3}\\log \\frac{E}{10^{11.8}}","الصيغة المقصودة (معادلة ريختر)؛ المطبوع <span class=\"tx\" data-t=\"\\log_{\\frac{2}{3}} \\frac{E}{11.81}\"></span> خطأ طباعي على الأرجح"],["8.1 = \\frac{2}{3}\\log \\frac{E}{10^{11.8}}","بتعويض <span class=\"tx\" data-t=\"P = 8.1\"></span>"],["\\log \\frac{E}{10^{11.8}} = 12.15","بضرب الطرفين في <span class=\"tx\" data-t=\"\\frac{3}{2}\"></span>"],["E = 10^{11.8} \\times 10^{12.15} = 10^{23.95}","بالتحويل إلى الصورة الأسية"],["E \\approx 8.91 \\times 10^{23}","بالآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"E = 10^{23.95} \\approx 8.91 \\times 10^{23}\"></span> جول","o":"لو عُوِّض في الصيغة كما طُبعت حرفيًّا: <span class=\"tx\" data-t=\"\\frac{E}{11.81} = \\left(\\frac{2}{3}\\right)^{8.1}\"></span> فيكون <span class=\"tx\" data-t=\"E \\approx 0.44\"></span> جول، وهي قيمة غير منطقية لزلزال؛ لذا اعتُمدت الصيغة القياسية.","k":[{"e":"8.91e+23","a":true}]}],[{"n":"26","s":[["N(0) = \\frac{2000}{1 + 3e^{0}} = \\frac{2000}{4}","بتعويض <span class=\"tx\" data-t=\"t = 0\"></span>"],["N(0) = 500",""]],"a":"<span class=\"tx\" data-t=\"500\"></span> أرنب","o":"","k":[{"e":"500","a":null}]},{"n":"27","s":[["\\frac{2000}{1 + 3e^{-0.05t}} = 700","بتعويض <span class=\"tx\" data-t=\"N(t) = 700\"></span>"],["1 + 3e^{-0.05t} = \\frac{20}{7}","بضرب الطرفين في المقام والقسمة على <span class=m dir=ltr>700</span>"],["e^{-0.05t} = \\frac{13}{21}","بطرح <span class=m dir=ltr>1</span> والقسمة على <span class=m dir=ltr>3</span>"],["-0.05t = \\ln \\frac{13}{21}","بأخذ <span class=m dir=ltr>ln</span> للطرفين"],["t = 20\\ln \\frac{21}{13} \\approx 9.59","بالقسمة على <span class=\"tx\" data-t=\"-0.05\"></span>"]],"a":"بعد <span class=\"tx\" data-t=\"9.59\"></span> سنوات تقريبًا (نحو <span class=m dir=ltr>10</span> سنوات)","o":"","k":[{"e":"9.59","a":true}]}]]