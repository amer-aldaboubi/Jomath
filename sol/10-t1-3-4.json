[[{"n":"1","s":[["x = \\sin^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right) = 45^\\circ","من النسب المثلثية للزوايا الخاصة"],["180^\\circ - 45^\\circ = 135^\\circ","الجيب موجب في الربع الثاني"]],"a":"<span class=\"tx\" data-t=\"x=45^\\circ,\\ 135^\\circ\"></span>","o":"","k":[{"e":"45","a":null},{"e":"135","a":null}]},{"n":"2","s":[["x = \\tan^{-1}\\left(\\frac{1}{\\sqrt{3}}\\right) = 30^\\circ",""],["180^\\circ + 30^\\circ = 210^\\circ","الظل موجب في الربع الثالث"]],"a":"<span class=\"tx\" data-t=\"x=30^\\circ,\\ 210^\\circ\"></span>","o":"","k":[{"e":"30","a":null},{"e":"210","a":null}]},{"n":"3","s":[["x = \\cos^{-1}\\left(\\frac{\\sqrt{3}}{2}\\right) = 30^\\circ",""],["360^\\circ - 30^\\circ = 330^\\circ","جيب التمام موجب في الربع الرابع"]],"a":"<span class=\"tx\" data-t=\"x=30^\\circ,\\ 330^\\circ\"></span>","o":"","k":[{"e":"30","a":null},{"e":"330","a":null}]},{"n":"4","s":[["9\\cos x = -6","بطرح <span class=m dir=ltr>7</span> من الطرفين"],["\\cos x = -\\frac{2}{3}","بقسمة الطرفين على <span class=m dir=ltr>9</span>"],["x = \\cos^{-1}\\left(-\\frac{2}{3}\\right) \\approx 131.8^\\circ","باستعمال الآلة الحاسبة (الربع الثاني)"],["360^\\circ - 131.8^\\circ = 228.2^\\circ","جيب التمام سالب في الربع الثالث"]],"a":"<span class=\"tx\" data-t=\"x\\approx131.8^\\circ,\\ 228.2^\\circ\"></span>","o":"","k":[{"e":"131.8","a":true},{"e":"228.2","a":true}]},{"n":"5","s":[["2\\sin x = -1 \\Rightarrow \\sin x = -\\frac{1}{2}","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>2</span>"],["\\alpha = \\sin^{-1}\\left(\\frac{1}{2}\\right) = 30^\\circ","الزاوية المرجعية"],["x = 180^\\circ + 30^\\circ = 210^\\circ,\\ x = 360^\\circ - 30^\\circ = 330^\\circ","الجيب سالب في الربعين الثالث والرابع"]],"a":"<span class=\"tx\" data-t=\"x=210^\\circ,\\ 330^\\circ\"></span>","o":"","k":[{"e":"210","a":null},{"e":"330","a":null}]},{"n":"6","s":[["-2\\tan x = 4 \\Rightarrow \\tan x = -2","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>−2</span>"],["\\tan^{-1}(2) \\approx 63.4^\\circ","الزاوية المرجعية"],["x = 180^\\circ - 63.4^\\circ = 116.6^\\circ,\\ x = 360^\\circ - 63.4^\\circ = 296.6^\\circ","الظل سالب في الربعين الثاني والرابع"]],"a":"<span class=\"tx\" data-t=\"x\\approx116.6^\\circ,\\ 296.6^\\circ\"></span>","o":"","k":[{"e":"116.6","a":true},{"e":"296.6","a":true}]}],[{"n":"7","s":[["-2\\cos(4x) = -1 \\Rightarrow \\cos(4x) = \\frac{1}{2}","بطرح <span class=m dir=ltr>5</span> ثم القسمة على <span class=m dir=ltr>−2</span>"],["0^\\circ \\le 4x \\le 360^\\circ","بضرب حدود الفترة في <span class=m dir=ltr>4</span>"],["4x = 60^\\circ,\\ 300^\\circ","جيب التمام موجب في الربعين الأول والرابع"],["x = 15^\\circ,\\ 75^\\circ","بقسمة الطرفين على <span class=m dir=ltr>4</span>"]],"a":"<span class=\"tx\" data-t=\"x=15^\\circ,\\ 75^\\circ\"></span>","o":"","k":[{"e":"15","a":null},{"e":"75","a":null}]},{"n":"8","s":[["4\\tan(2x) = 3 \\Rightarrow \\tan(2x) = 0.75","بطرح <span class=m dir=ltr>3</span> ثم القسمة على <span class=m dir=ltr>4</span>"],["0^\\circ \\le 2x \\le 180^\\circ","بضرب حدود الفترة في <span class=m dir=ltr>2</span>"],["2x = \\tan^{-1}(0.75) \\approx 36.87^\\circ","الظل موجب في هذه الفترة في الربع الأول فقط"],["x \\approx 18.4^\\circ","بقسمة الطرفين على <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"x\\approx18.4^\\circ\"></span>","o":"","k":[{"e":"18.4","a":true}]},{"n":"9","s":[["13\\sin(3x) = 5 \\Rightarrow \\sin(3x) = \\frac{5}{13}","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>13</span>"],["0^\\circ \\le 3x \\le 270^\\circ","بضرب حدود الفترة في <span class=m dir=ltr>3</span>"],["3x \\approx 22.62^\\circ,\\ 180^\\circ - 22.62^\\circ = 157.38^\\circ","الجيب موجب في الربعين الأول والثاني"],["x \\approx 7.5^\\circ,\\ 52.5^\\circ","بقسمة الطرفين على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"x\\approx7.5^\\circ,\\ 52.5^\\circ\"></span>","o":"","k":[{"e":"7.5","a":true},{"e":"52.5","a":true}]}],[{"n":"10","s":[["2\\sin x - 4 + 1 = 3\\sin x","خاصية التوزيع"],["-3 = \\sin x","بطرح <span class=m dir=ltr>2 sin x</span> من الطرفين"],["\\sin x = -3 < -1",""]],"a":"لا يوجد حل؛ لأن <span class=\"tx\" data-t=\"-1\\le\\sin x\\le1\"></span>","o":""},{"n":"11","s":[["\\tan x - 6\\tan x + 3 = 10","خاصية التوزيع"],["-5\\tan x = 7 \\Rightarrow \\tan x = -1.4","بالتبسيط ثم القسمة على <span class=m dir=ltr>−5</span>"],["\\tan^{-1}(1.4) \\approx 54.5^\\circ","الزاوية المرجعية"],["x \\approx 125.5^\\circ,\\ 305.5^\\circ","الظل سالب في الربعين الثاني والرابع"]],"a":"<span class=\"tx\" data-t=\"x\\approx125.5^\\circ,\\ 305.5^\\circ\"></span>","o":"","k":[{"e":"125.5","a":true},{"e":"305.5","a":true}]},{"n":"12","s":[["10\\tan x = 4","بطرح <span class=m dir=ltr>5 tan x</span> وإضافة <span class=m dir=ltr>7</span> للطرفين"],["\\tan x = 0.4",""],["x \\approx 21.8^\\circ,\\ 180^\\circ + 21.8^\\circ = 201.8^\\circ","الظل موجب في الربعين الأول والثالث"]],"a":"<span class=\"tx\" data-t=\"x\\approx21.8^\\circ,\\ 201.8^\\circ\"></span>","o":"","k":[{"e":"21.8","a":true},{"e":"201.8","a":true}]},{"n":"13","s":[["5\\cos x - 5 = 6 + \\cos x","خاصية التوزيع"],["4\\cos x = 11 \\Rightarrow \\cos x = 2.75",""],["2.75 > 1",""]],"a":"لا يوجد حل؛ لأن <span class=\"tx\" data-t=\"-1\\le\\cos x\\le1\"></span>","o":""},{"n":"14","s":[["(\\tan x - 4)(\\tan x - 5) = 0","بالتحليل"],["\\tan x = 4 \\Rightarrow x \\approx 76.0^\\circ,\\ 256.0^\\circ","خاصية الضرب الصفري؛ الظل موجب في الربعين الأول والثالث"],["\\tan x = 5 \\Rightarrow x \\approx 78.7^\\circ,\\ 258.7^\\circ",""]],"a":"<span class=\"tx\" data-t=\"x\\approx76.0^\\circ,\\ 78.7^\\circ,\\ 256.0^\\circ,\\ 258.7^\\circ\"></span>","o":"","k":[{"e":"76.0","a":true},{"e":"78.7","a":true},{"e":"256.0","a":true},{"e":"258.7","a":true}]},{"n":"15","s":[["\\cos x(2\\cos x - 1) = 0","بإخراج <span class=m dir=ltr>cos x</span> عاملًا مشتركًا"],["\\cos x = 0 \\Rightarrow x = 90^\\circ,\\ 270^\\circ","خاصية الضرب الصفري"],["\\cos x = \\frac{1}{2} \\Rightarrow x = 60^\\circ,\\ 300^\\circ",""]],"a":"<span class=\"tx\" data-t=\"x=60^\\circ,\\ 90^\\circ,\\ 270^\\circ,\\ 300^\\circ\"></span>","o":"","k":[{"e":"60","a":null},{"e":"90","a":null},{"e":"270","a":null},{"e":"300","a":null}]},{"n":"16","s":[["4\\sin^2 x - 3\\sin x - 1 = 0","بطرح <span class=m dir=ltr>1</span> من الطرفين"],["(4\\sin x + 1)(\\sin x - 1) = 0","بالتحليل"],["\\sin x = 1 \\Rightarrow x = 90^\\circ","خاصية الضرب الصفري"],["\\sin x = -\\frac{1}{4} \\Rightarrow x \\approx 194.5^\\circ,\\ 345.5^\\circ","الزاوية المرجعية <span class=m dir=ltr>14.5°</span>، والجيب سالب في الربعين الثالث والرابع"]],"a":"<span class=\"tx\" data-t=\"x=90^\\circ,\\ x\\approx194.5^\\circ,\\ 345.5^\\circ\"></span>","o":"","k":[{"e":"194.5","a":true},{"e":"345.5","a":true}]},{"n":"17","s":[["\\sin^2 x = \\frac{1}{2}","بإضافة <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>2</span>"],["\\sin x = \\pm\\frac{1}{\\sqrt{2}}","بأخذ الجذر التربيعي للطرفين"],["x = 45^\\circ,\\ 135^\\circ,\\ 225^\\circ,\\ 315^\\circ","الزاوية المرجعية <span class=m dir=ltr>45°</span> في الأرباع الأربعة"]],"a":"<span class=\"tx\" data-t=\"x=45^\\circ,\\ 135^\\circ,\\ 225^\\circ,\\ 315^\\circ\"></span>","o":"","k":[{"e":"45","a":null},{"e":"135","a":null},{"e":"225","a":null},{"e":"315","a":null}]},{"n":"18","s":[["4\\cos^2 x - 15\\cos x - 4 = 0","بطرح <span class=m dir=ltr>15 cos x</span> من الطرفين"],["(4\\cos x + 1)(\\cos x - 4) = 0","بالتحليل"],["\\cos x = 4","مرفوض؛ لأن <span class=m dir=ltr>cos x ≤ 1</span>"],["\\cos x = -\\frac{1}{4} \\Rightarrow x \\approx 104.5^\\circ,\\ 255.5^\\circ","جيب التمام سالب في الربعين الثاني والثالث"]],"a":"<span class=\"tx\" data-t=\"x\\approx104.5^\\circ,\\ 255.5^\\circ\"></span>","o":"","k":[{"e":"104.5","a":true},{"e":"255.5","a":true}]},{"n":"19","s":[["\\frac{\\sin x}{\\cos x} = 1 \\Rightarrow \\tan x = 1","بقسمة الطرفين على <span class=m dir=ltr>cos x (cos x = 0</span> لا يحقق المعادلة)"],["x = 45^\\circ,\\ 225^\\circ","الظل موجب في الربعين الأول والثالث"]],"a":"<span class=\"tx\" data-t=\"x=45^\\circ,\\ 225^\\circ\"></span>","o":"","k":[{"e":"45","a":null},{"e":"225","a":null}]}],[{"n":"20","s":[["-60\\cos(30x) + 110 = 118","بالتعويض <span class=m dir=ltr>d = 118</span>"],["\\cos(30x) = -\\frac{8}{60} \\approx -0.1333","بطرح <span class=m dir=ltr>110</span> ثم القسمة على <span class=m dir=ltr>−60</span>"],["30x \\approx 97.66^\\circ,\\ 360^\\circ - 97.66^\\circ = 262.34^\\circ","جيب التمام سالب في الربعين الثاني والثالث"],["x \\approx 3.26,\\ 8.74","بقسمة الطرفين على <span class=m dir=ltr>30 (</span>بالساعات)"]],"a":"عند الساعة <span class=\"tx\" data-t=\"3.26\"></span> تقريبًا (نحو <span class=m dir=ltr>3</span>:<span class=m dir=ltr>15)</span> والساعة <span class=\"tx\" data-t=\"8.74\"></span> تقريبًا (نحو <span class=m dir=ltr>8</span>:<span class=m dir=ltr>45)</span>","o":"مسألة اليوم: <span class=\"tx\" data-t=\"d=-60\\cos(30x)+110\"></span>، والمطلوب الوقت عندما <span class=\"tx\" data-t=\"d=118\\ \\text{cm}\"></span>."}],[{"n":"21","s":[["d = 90\\sin\\theta","في المثلث القائم الذي وتره <span class=m dir=ltr>AB = 90</span>"],["d = 60\\sin(90^\\circ - \\theta) = 60\\cos\\theta","في المثلث القائم الذي وتره <span class=m dir=ltr>BC = 60</span>"],["90\\sin\\theta = 60\\cos\\theta \\Rightarrow \\tan\\theta = \\frac{2}{3}","بمساواة العبارتين والقسمة على <span class=m dir=ltr>90 cos</span> θ"],["\\theta = \\tan^{-1}\\left(\\frac{2}{3}\\right) \\approx 33.7^\\circ","باستعمال الآلة الحاسبة"],["d = 90\\sin 33.7^\\circ \\approx 49.9","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"d=90\\sin\\theta\"></span> و <span class=\"tx\" data-t=\"d=60\\sin(90^\\circ-\\theta)=60\\cos\\theta\"></span>، والمعادلة <span class=\"tx\" data-t=\"90\\sin\\theta=60\\cos\\theta\"></span> تعطي <span class=\"tx\" data-t=\"\\theta\\approx33.7^\\circ\"></span>، وعرض النهر <span class=\"tx\" data-t=\"d\\approx50\\ \\text{m}\"></span>","o":""}],[{"n":"22","s":[["27 - 25\\cos\\theta = 49","بالتعويض <span class=m dir=ltr>h = 49</span>"],["\\cos\\theta = -\\frac{22}{25} = -0.88","بطرح <span class=m dir=ltr>27</span> ثم القسمة على <span class=m dir=ltr>−25</span>"],["\\theta = \\cos^{-1}(-0.88) \\approx 151.6^\\circ","باستعمال الآلة الحاسبة"],["360^\\circ - 151.6^\\circ = 208.4^\\circ","جيب التمام سالب في الربع الثالث أيضًا"]],"a":"يكون الارتفاع <span class=\"tx\" data-t=\"49\\ \\text{m}\"></span> عندما <span class=\"tx\" data-t=\"\\theta\\approx151.6^\\circ\"></span> أو <span class=\"tx\" data-t=\"\\theta\\approx208.4^\\circ\"></span>","o":"","k":[{"e":"49","a":null},{"e":"151.6","a":true},{"e":"208.4","a":true}]}],[{"n":"23","s":[["110 = \\frac{40^2\\sin(2\\theta)}{9.8}","بالتعويض"],["\\sin(2\\theta) = \\frac{110\\times 9.8}{1600} = 0.67375",""],["2\\theta \\approx 42.36^\\circ\\ \\text{or}\\ 137.64^\\circ","الجيب موجب في الربعين الأول والثاني"],["\\theta \\approx 21.2^\\circ\\ \\text{or}\\ 68.8^\\circ","بقسمة الطرفين على <span class=m dir=ltr>2</span>"],["d_{max} = \\frac{1600 \\times 1}{9.8} \\approx 163.3","أكبر قيمة للجيب <span class=m dir=ltr>1</span> عندما <span class=m dir=ltr>2</span>θ <span class=m dir=ltr>= 90°</span>، أي θ <span class=m dir=ltr>= 45°</span>"]],"a":"الزاوية <span class=\"tx\" data-t=\"\\theta\\approx21.2^\\circ\"></span> أو <span class=\"tx\" data-t=\"\\theta\\approx68.8^\\circ\"></span>، وأبعد نقطة <span class=\"tx\" data-t=\"\\approx163.3\\ \\text{m}\"></span> (عند <span class=\"tx\" data-t=\"\\theta=45^\\circ\"></span>)","o":""}],[{"n":"24","s":[["2\\sin x\\cos x - \\sin x = 0","بطرح <span class=m dir=ltr>sin x</span> من الطرفين"],["\\sin x(2\\cos x - 1) = 0","بإخراج <span class=m dir=ltr>sin x</span> عاملًا مشتركًا"],["\\sin x = 0 \\Rightarrow x = 0^\\circ,\\ 180^\\circ","خاصية الضرب الصفري <span class=m dir=ltr>(360°</span> خارج الفترة)"],["\\cos x = \\frac{1}{2} \\Rightarrow x = 60^\\circ,\\ 300^\\circ",""]],"a":"إجابة علياء صحيحة: <span class=\"tx\" data-t=\"x=0^\\circ,\\ 60^\\circ,\\ 180^\\circ,\\ 300^\\circ\"></span>","o":"خطأ سمير: قسم الطرفين على <span class=\"tx\" data-t=\"\\sin x\"></span> وهو قد يساوي صفرً