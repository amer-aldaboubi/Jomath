 class=\"tx\" data-t=\"210^\\circ\"></span> و <span class=\"tx\" data-t=\"-150^\\circ\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الثالث."},{"n":"20","s":[["-150^\\circ + 360^\\circ = 210^\\circ","بإضافة دورة كاملة"],["-150^\\circ - 360^\\circ = -510^\\circ","بطرح دورة كاملة"]],"a":"<span class=\"tx\" data-t=\"210^\\circ\"></span> و <span class=\"tx\" data-t=\"-510^\\circ\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الثالث."},{"n":"21","s":[["\\frac{11\\pi}{6} + 2\\pi = \\frac{23\\pi}{6}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"],["\\frac{11\\pi}{6} - 2\\pi = -\\frac{\\pi}{6}","بطرح <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{23\\pi}{6}\"></span> و <span class=\"tx\" data-t=\"-\\frac{\\pi}{6}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الرابع."},{"n":"22","s":[["-\\frac{\\pi}{4} + 2\\pi = \\frac{7\\pi}{4}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"],["-\\frac{\\pi}{4} - 2\\pi = -\\frac{9\\pi}{4}","بطرح <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{7\\pi}{4}\"></span> و <span class=\"tx\" data-t=\"-\\frac{9\\pi}{4}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الرابع."},{"n":"23","s":[["-\\frac{\\pi}{12} + 2\\pi = \\frac{23\\pi}{12}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"],["-\\frac{\\pi}{12} - 2\\pi = -\\frac{25\\pi}{12}","بطرح <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{23\\pi}{12}\"></span> و <span class=\"tx\" data-t=\"-\\frac{25\\pi}{12}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الرابع."},{"n":"24","s":[["\\frac{7\\pi}{6} + 2\\pi = \\frac{19\\pi}{6}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"],["\\frac{7\\pi}{6} - 2\\pi = -\\frac{5\\pi}{6}","بطرح <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{19\\pi}{6}\"></span> و <span class=\"tx\" data-t=\"-\\frac{5\\pi}{6}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الثالث."}],[{"n":"25","s":[["s = r\\theta = 15 \\times 1.8 = 27\\ \\text{cm}","صيغة طول القوس (<span class=\"tx\" data-t=\"\\theta\"></span> بالراديان)"],["A = \\frac{1}{2}r^2\\theta = \\frac{1}{2}(15)^2(1.8) = 202.5\\ \\text{cm}^2","صيغة مساحة القطاع الدائري"]],"a":"طول القوس <span class=\"tx\" data-t=\"= 27\\ \\text{cm}\"></span>، المساحة <span class=\"tx\" data-t=\"= 202.5\\ \\text{cm}^2\"></span>","o":""},{"n":"26","s":[["s = r\\theta = 24 \\times 2.7 = 64.8\\ \\text{cm}","صيغة طول القوس (<span class=\"tx\" data-t=\"\\theta\"></span> بالراديان)"],["A = \\frac{1}{2}r^2\\theta = \\frac{1}{2}(24)^2(2.7) = 777.6\\ \\text{cm}^2","صيغة مساحة القطاع الدائري"]],"a":"طول القوس <span class=\"tx\" data-t=\"= 64.8\\ \\text{cm}\"></span>، المساحة <span class=\"tx\" data-t=\"= 777.6\\ \\text{cm}^2\"></span>","o":""},{"n":"27","s":[["s = r\\theta = 6.5 \\times 4 = 26\\ \\text{cm}","صيغة طول القوس (<span class=\"tx\" data-t=\"\\theta\"></span> بالراديان)"],["A = \\frac{1}{2}r^2\\theta = \\frac{1}{2}(6.5)^2(4) = 84.5\\ \\text{cm}^2","صيغة مساحة القطاع الدائري"]],"a":"طول القوس <span class=\"tx\" data-t=\"= 26\\ \\text{cm}\"></span>، المساحة <span class=\"tx\" data-t=\"= 84.5\\ \\text{cm}^2\"></span>","o":""}],[{"n":"28","s":[["r_1 = 10\\ \\text{cm},\\ r_2 = 15\\ \\text{cm},\\ \\theta = 1.6","نصف قطر القوس الداخلي والخارجي"],["A = \\frac{1}{2}(15)^2(1.6) - \\frac{1}{2}(10)^2(1.6)","مساحة القطاع الكبير <span class=m dir=ltr>−</span> مساحة القطاع الصغير"],["= 180 - 80 = 100\\ \\text{cm}^2",""]],"a":"مساحة الشكل <span class=\"tx\" data-t=\"= 100\\ \\text{cm}^2\"></span>","o":""},{"n":"29","s":[["s_2 = 15(1.6) = 24\\ \\text{cm}","طول القوس الخارجي"],["s_1 = 10(1.6) = 16\\ \\text{cm}","طول القوس الداخلي"],["P = 24 + 16 + 5 + 5 = 50\\ \\text{cm}","المحيط <span class=m dir=ltr>=</span> القوسان <span class=m dir=ltr>+</span> القطعتان المستقيمتان (<span class=\"tx\" data-t=\"15-10=5\"></span>)"]],"a":"محيط الشكل <span class=\"tx\" data-t=\"= 50\\ \\text{cm}\"></span>","o":""}],[{"n":"30","s":[["A = \\frac{1}{2}rs","لأن <span class=\"tx\" data-t=\"A=\\frac12 r^2\\theta\"></span> و <span class=\"tx\" data-t=\"s=r\\theta\"></span>"],["500 = \\frac{1}{2}r(20) \\Rightarrow r = 50\\ \\text{cm}","بالتعويض ثم الحل"],["\\theta = \\frac{s}{r} = \\frac{20}{50} = 0.4","من صيغة طول القوس"]],"a":"قياس الزاوية <span class=\"tx\" data-t=\"= 0.4\"></span> راديان","o":""}],[{"n":"31","s":[["\\omega = 100 \\times 2\\pi = 200\\pi\\ \\text{rad/min}","كل دورة <span class=\"tx\" data-t=\"2\\pi\"></span> راديان"],["v = r\\omega = 0.20 \\times 200\\pi = 40\\pi\\ \\text{m/min}","السرعة الخطية <span class=m dir=ltr>=</span> نصف القطر <span class=m dir=ltr>×</span> السرعة الزاوية"],["v = \\frac{40\\pi}{60} = \\frac{2\\pi}{3} \\approx 2.09\\ \\text{m/s}","بالقسمة على <span class=m dir=ltr>60</span> للتحويل إلى ثوانٍ"]],"a":"سرعة التيار <span class=\"tx\" data-t=\"= \\frac{2\\pi}{3} \\approx 2.09\\ \\text{m/s}\"></span>","o":""}],[{"n":"32","s":[["\\theta = 15 \\times 2\\pi = 30\\pi\\ \\text{rad}","كل دورة <span class=\"tx\" data-t=\"2\\pi\"></span> راديان"],["\\omega = \\frac{\\theta}{t} = \\frac{30\\pi}{10} = 3\\pi\\ \\text{rad/s}","السرعة الزاوية"],["v = r\\omega = 3 \\times 3\\pi = 9\\pi \\approx 28.27\\ \\text{ft/s}","السرعة الخطية"]],"a":"<span class=\"tx\" data-t=\"\\omega = 3\\pi \\approx 9.42\\ \\text{rad/s}\"></span> ، <span class=\"tx\" data-t=\"v = 9\\pi \\approx 28.27\\ \\text{ft/s}\"></span>","o":""}],[{"n":"33","s":[["\\frac{2400}{60} = 40\\ \\text{دورة/ثانية}","نحوّل إلى دورات في الثانية"],["\\omega = 40 \\times 2\\pi = 80\\pi\\ \\text{rad/s}","كل دورة <span class=\"tx\" data-t=\"2\\pi\"></span> راديان"]],"a":"<span class=\"tx\" data-t=\"\\omega = 80\\pi \\approx 251.33\\ \\text{rad/s}\"></span>","o":""},{"n":"34","s":[["r = \\frac{7.5}{2} = 3.75\\ \\text{in}","نصف القطر <span class=m dir=ltr>=</span> نصف طول القطر"],["v = r\\omega = 3.75 \\times 80\\pi = 300\\pi","السرعة الخطية"],["v \\approx 942.48\\ \\text{in/s}",""]],"a":"<span class=\"tx\" data-t=\"v = 300\\pi \\approx 942.48\\ \\text{in/s}\"></span>","o":""}],[{"n":"35","s":[["s = r\\theta\\ \\text{cm},\\quad A = \\frac{1}{2}r^2\\theta\\ \\text{cm}^2 = \\frac{r^2\\theta}{20000}\\ \\text{m}^2","لأن <span class=\"tx\" data-t=\"1\\ \\text{m}^2 = 10000\\ \\text{cm}^2\"></span>"],["r\\theta = \\frac{r^2\\theta}{20000}","طول القوس يساوي عدديًّا المساحة"],["r = 20000\\ \\text{cm} = 200\\ \\text{m}","بقسمة الطرفين على <span class=\"tx\" data-t=\"r\\theta\"></span>"]],"a":"نصف القطر <span class=\"tx\" data-t=\"= 20000\\ \\text{cm} = 200\\ \\text{m}\"></span>","o":"تبرير: عند مساواة الصيغتين يُحذف <span class=\"tx\" data-t=\"\\theta\"></span> ويبقى <span class=\"tx\" data-t=\"r\"></span> وحده. (لو كانت الوحدتان من النظام نفسه، أي <span class=m dir=ltr>cm</span> و <span class=m dir=ltr>cm²</span>، لكان <span class=\"tx\" data-t=\"r\\theta=\\frac12 r^2\\theta\"></span> فيكون <span class=\"tx\" data-t=\"r=2\\ \\text{cm}\"></span>.)"},{"n":"36","s":[["r\\theta = \\frac{r^2\\theta}{20000}","المعادلة السابقة"],["\\theta(r - \\tfrac{r^2}{20000}) = 0","تتحقق لكل <span class=\"tx\" data-t=\"\\theta\"></span> عندما <span class=\"tx\" data-t=\"r = 20000\"></span>"]],"a":"لا يمكن تحديد قياس واحد للزاوية؛ أي زاوية <span class=\"tx\" data-t=\"0 &lt; \\theta \\le 2\\pi\"></span> تحقق الشرط","o":"تبرير: <span class=\"tx\" data-t=\"\\theta\"></span> يُحذف من طرفي المعادلة، فالشرط يحدد نصف القطر فقط ولا يحدد الزاوية."}],[{"n":"37","s":[["\\alpha = \\frac{s}{r} = \\frac{4}{4} = 1\\ \\text{rad}","الزاوية المقابلة للقوس الأخضر (بين ضلع الانتهاء والجزء السالب من المحور <span class=\"tx\" data-t=\"x\"></span>)"],["\\theta = \\pi - 1","لأن <span class=\"tx\" data-t=\"\\theta + \\alpha = \\pi\"></span> (نصف دورة)"],["\\theta \\approx 2.14\\ \\text{rad} \\approx 122.7^\\circ",""]],"a":"<span class=\"tx\" data-t=\"\\theta = \\pi - 1 \\approx 2.14\"></span> راديان","o":"تبرير: طول القوس يساوي نصف القطر، فالزاوية المركزية المقابلة له راديان واحد، و <span class=\"tx\" data-t=\"\\theta\"></span> مكملتها."}],[{"n":"38","s":[["BE = AB = r","نصفا قطر القطاع <span class=\"tx\" data-t=\"ABE\"></span>"],["\\triangle EBC:\\ m\\angle B = \\frac{\\pi}{2},\\ m\\angle C = \\frac{\\pi}{4} \\Rightarrow m\\angle E = \\frac{\\pi}{4}","مجموع زوايا المثلث <span class=\"tx\" data-t=\"\\pi\"></span>"],["BC = BE = r","المثلث قائم متطابق الضلعين"],["CE = \\sqrt{r^2 + r^2} = \\sqrt{2}\\,r","نظرية فيثاغورس"],["CD = CE = \\sqrt{2}\\,r","نصفا قطر القطاع <span class=\"tx\" data-t=\"CED\"></span>"]],"a":"<span class=\"tx\" data-t=\"CD = \\sqrt{2}\\,r\"></span> (وهو المطلوب)","o":""},{"n":"39","s":[["m\\angle ECD = \\pi - m\\angle ACE","<span class=\"tx\" data-t=\"ACD\"></span> زاوية مستقيمة"],["= \\pi - \\frac{\\pi}{4} = \\frac{3\\pi}{4}",""]],"a":"<span class=\"tx\" data-t=\"m\\angle ECD = \\frac{3\\pi}{4}\"></span>","o":""},{"n":"40","s":[["\\widehat{AE} = 10 \\times \\frac{\\pi}{2} = 5\\pi","<span class=\"tx\" data-t=\"s=r\\theta\"></span> ، <span class=\"tx\" data-t=\"\\angle ABE\"></span> قائمة"],["\\widehat{ED} = 10\\sqrt{2} \\times \\frac{3\\pi}{4} = 7.5\\sqrt{2}\\,\\pi","نصف القطر <span class=\"tx\" data-t=\"10\\sqrt2\"></span>"],["AD = 10 + 10 + 10\\sqrt{2} = 20 + 10\\sqrt{2}","<span class=\"tx\" data-t=\"AB + BC + CD\"></span>"],["P = 5\\pi + 7.5\\sqrt{2}\\pi + 20 + 10\\sqrt{2} \\approx 83.2\\ \\text{cm}","مجموع حدود الشكل"],["A = \\frac{1}{2}(10)^2\\frac{\\pi}{2} + \\frac{1}{2}(10\\sqrt{2})^2\\frac{3\\pi}{4} + \\frac{1}{2}(10)(10)","قطاع <span class=\"tx\" data-t=\"ABE\"></span> <span class=m dir=ltr>+</span> قطاع <span class=\"tx\" data-t=\"CED\"></span> <span class=m dir=ltr>+</span> المثلث <span class=\"tx\" data-t=\"EBC\"></span>"],["A = 25\\pi + 75\\pi + 50 = 100\\pi + 50 \\approx 364.2\\ \\text{cm}^2",""]],"a":"المحيط <span class=\"tx\" data-t=\"\\approx 83.2\\ \\text{cm}\"></span> ، المساحة <span class=\"tx\" data-t=\"= 100\\pi + 50 \\approx 364.2\\ \\text{cm}^2\"></span>","o":""}],[{"n":"2","s":[["56^\\circ \\times \\frac{\\pi}{180^\\circ} = \\frac{56\\pi}{180} = \\frac{14\\pi}{45}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span> ثم نبسط"]],"a":"الإجابة <span class=\"tx\" data-t=\"b\"></span> : <span class=\"tx\" data-t=\"\\frac{14\\pi}{45}\"></span>","o":""}],[{"n":"3","s":[["s = r\\theta = 15 \\times \\frac{8\\pi}{7} = \\frac{120\\pi}{7}","صيغة طول القوس"],["s \\approx 53.9\\ \\text{cm}",""]],"a":"الإجابة <span class=\"tx\" data-t=\"c\"></span> : <span class=\"tx\" data-t=\"53.9\\ \\text{cm}\"></span>","o":""}],[{"n":"7","s":[["780^\\circ = 2(360^\\circ) + 60^\\circ","دورتان كاملتان عكس عقارب الساعة ثم <span class=\"tx\" data-t=\"60^\\circ\"></span>"]],"a":"ضلع الانتهاء في الربع الأول بزاوية <span class=\"tx\" data-t=\"60^\\circ\"></span> مع المحور <span class=\"tx\" data-t=\"x\"></span> الموجب","o":""},{"n":"8","s":[["-570^\\circ = -360^\\circ - 210^\\circ","دورة كاملة مع عقارب الساعة ثم <span class=\"tx\" data-t=\"210^\\circ\"></span>"],["-570^\\circ + 720^\\circ = 150^\\circ","زاوية مشتركة في ضلع الانتهاء"]],"a":"ضلع الانتهاء في الربع الثاني (يصنع <span class=\"tx\" data-t=\"30^\\circ\"></span> مع المحور <span class=\"tx\" data-t=\"x\"></span> السالب)","o":""},{"n":"9","s":[["\\frac{\\pi}{12} = 15^\\circ","بالتحويل إلى درجات"]],"a":"ضلع الانتهاء في الربع الأول بزاوية <span class=\"tx\" data-t=\"15^\\circ\"></span> عكس عقارب الساعة","o":""},{"n":"10","s":[["\\frac{5\\pi}{2} = 2\\pi + \\frac{\\pi}{2}","دورة كاملة ثم ربع دورة عكس عقارب الساعة"]],"a":"ضلع الانتهاء على الجزء الموجب من المحور <span class=\"tx\" data-t=\"y\"></span>","o":""}],[{"n":"11","s":[["-720^\\circ \\times \\frac{\\pi}{180^\\circ} = -4\\pi","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"]],"a":"<span class=\"tx\" data-t=\"-4\\pi\"></span>","o":""},{"n":"12","s":[["315^\\circ \\times \\frac{\\pi}{180^\\circ} = \\frac{7\\pi}{4}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{7\\pi}{4}\"></span>","o":""},{"n":"13","s":[["\\frac{13\\pi}{8} \\times \\frac{180^\\circ}{\\pi} = 292.5^\\circ","نضرب في <span class=\"tx\" data-t=\"\\frac{180^\\circ}{\\pi}\"></span>"]],"a":"<span class=\"tx\" data-t=\"292.5^\\circ\"></span>","o":""},{"n":"14","s":[["3.5\\pi \\times \\frac{180^\\circ}{\\pi} = 630^\\circ","نضرب في <span class=\"tx\" data-t=\"\\frac{180^\\circ}{\\pi}\"></span>"]],"a":"<span class=\"tx\" data-t=\"630^\\circ\"></span>","o":""}],[{"n":"15","s":[["-115^\\circ + 360^\\circ = 245^\\circ","بإضافة دورة كاملة"],["-115^\\circ - 360^\\circ = -475^\\circ","بطرح دورة كاملة"]],"a":"<span class=\"tx\" data-t=\"245^\\circ\"></span> و <span class=\"tx\" data-t=\"-475^\\circ\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الثالث."},{"n":"16","s":[["780^\\circ - 2(360^\\circ) = 60^\\circ","بطرح دورتين"],["60^\\circ - 360^\\circ = -300^\\circ","بطرح دورة أخرى"]],"a":"<span class=\"tx\" data-t=\"60^\\circ\"></span> و <span class=\"tx\" data-t=\"-300^\\circ\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الأول."},{"n":"17","s":[["-\\frac{7\\pi}{3} + 4\\pi = \\frac{5\\pi}{3}","بإضافة <span class=\"tx\" data-t=\"4\\pi\"></span>"],["-\\frac{7\\pi}{3} + 2\\pi = -\\frac{\\pi}{3}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{5\\pi}{3}\"></span> و <span class=\"tx\" data-t=\"-\\frac{\\pi}{3}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الرابع."},{"n":"18","s":[["\\frac{\\pi}{9} + 2\\pi = \\frac{19\\pi}{9}","بإضافة <span class=\"tx\" data-t=\"2\\pi\"></span>"],["\\frac{\\pi}{9} - 2\\pi = -\\frac{17\\pi}{9}","بطرح <span class=\"tx\" data-t=\"2\\pi\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{19\\pi}{9}\"></span> و <span class=\"tx\" data-t=\"-\\frac{17\\pi}{9}\"></span> (إجابة ممكنة)","o":"ضلع الانتهاء المشترك في الربع الأول."}],[{"n":"19","s":[["A = \\frac{1}{2}r^2\\theta \\Rightarrow 12 = \\frac{1}{2}r^2(0.7)","صيغة مساحة القطاع"],["r^2 = \\frac{24}{0.7} \\approx 34.29",""],["r \\approx 5.86",""]],"a":"<span class=\"tx\" data-t=\"r \\approx 5.86\"></span> وحدة","o":""},{"n":"20","s":[["150^\\circ = \\frac{5\\pi}{6}","نحوّل الزاوية إلى راديان"],["12 = \\frac{1}{2}r^2\\left(\\frac{5\\pi}{6}\\right) \\Rightarrow r^2 = \\frac{144}{5\\pi} \\approx 9.17",""],["r \\approx 3.03",""]],"a":"<span class=\"tx\" data-t=\"r \\approx 3.03\"></span> وحدة","o":""}],[{"n":"1","s":[["225^\\circ \\times \\frac{\\pi}{180^\\circ} = \\frac{5\\pi}{4}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{5\\pi}{4}\"></span>","o":""},{"n":"2","s":[["840^\\circ \\times \\frac{\\pi}{180^\\circ} = \\frac{14\\pi}{3}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{14\\pi}{3}\"></span>","o":""},{"n":"3","s":[["\\frac{11\\pi}{6} \\times \\frac{180^\\circ}{\\pi} = 330^\\circ","نضرب في <span class=\"tx\" data-t=\"\\frac{180^\\circ}{\\pi}\"></span>"]],"a":"<span class=\"tx\" data-t=\"330^\\circ\"></span>","o":""},{"n":"4","s":[["-\\frac{23\\pi}{4} \\times \\frac{180^\\circ}{\\pi} = -1035^\\circ","نضرب في <span class=\"tx\" data-t=\"\\frac{180^\\circ}{\\pi}\"></span>"]],"a":"<span class=\"tx\" data-t=\"-1035^\\circ\"></span>","o":""}],[{"n":"5","s":[["\\theta = 2\\pi - 0.6","زاوية القطاع المظلل <span class=m dir=ltr>=</span> الدورة الكاملة <span class=m dir=ltr>−</span> الزاوية غير المظللة"],["A = \\frac{1}{2}(20)^2(2\\pi - 0.6) = 400\\pi - 120","صيغة مساحة القطاع"],["A \\approx 1136.6\\ \\text{cm}^2",""]],"a":"<span class=\"tx\" data-t=\"A = 400\\pi - 120 \\approx 1136.6\\ \\text{cm}^2\"></span>","o":""}],[{"n":"6","s":[["OA = 6 + x","نصف قطر القطاع الكبير"],["\\frac{1}{2}(6 + x)^2(2) - \\frac{1}{2}(6)^2(2) = 64","مساحة القطاع الكبير <span class=m dir=ltr>−</span> مساحة القطاع الصغير"],["(6 + x)^2 - 36 = 64 \\Rightarrow (6 + x)^2 = 100","بالتبسيط"],["6 + x = 10 \\Rightarrow x = 4","بأخذ الجذر الموجب"]],"a":"<span class=\"tx\" data-t=\"x = 4\"></span>","o":""}],[{"n":"7","s":[["s = 2 \\times \\frac{\\pi}{3} = \\frac{2\\pi}{3} \\approx 2.1\\ \\text{ft}","<span class=\"tx\" data-t=\"s = r\\theta\"></span>"],["A = \\frac{1}{2}(2)^2\\frac{\\pi}{3} = \\frac{2\\pi}{3} \\approx 2.1\\ \\text{ft}^2","<span class=\"tx\" data-t=\"A = \\frac12 r^2\\theta\"></span>"]],"a":"<span class=\"tx\" data-t=\"s \\approx 2.1\\ \\text{ft}\"></span> ، <span class=\"tx\" data-t=\"A \\approx 2.1\\ \\text{ft}^2\"></span>","o":""},{"n":"8","s":[["s = 4 \\times \\frac{\\pi}{6} = \\frac{2\\pi}{3} \\approx 2.1\\ \\text{m}","<span class=\"tx\" data-t=\"s = r\\theta\"></span>"],["A = \\frac{1}{2}(4)^2\\frac{\\pi}{6} = \\frac{4\\pi}{3} \\approx 4.2\\ \\text{m}^2","<span class=\"tx\" data-t=\"A = \\frac12 r^2\\theta\"></span>"]],"a":"<span class=\"tx\" data-t=\"s \\approx 2.1\\ \\text{m}\"></span> ، <span class=\"tx\" data-t=\"A \\approx 4.2\\ \\text{m}^2\"></span>","o":""},{"n":"9","s":[["70^\\circ = \\frac{7\\pi}{18}","نحوّل الزاوية إلى راديان"],["s = 12 \\times \\frac{7\\pi}{18} = \\frac{14\\pi}{3} \\approx 14.7\\ \\text{yd}","<span class=\"tx\" data-t=\"s = r\\theta\"></span>"],["A = \\frac{1}{2}(12)^2\\frac{7\\pi}{18} = 28\\pi \\approx 88.0\\ \\text{yd}^2","<span class=\"tx\" data-t=\"A = \\frac12 r^2\\theta\"></span>"]],"a":"<span class=\"tx\" data-t=\"s \\approx 14.7\\ \\text{yd}\"></span> ، <span class=\"tx\" data-t=\"A \\approx 88.0\\ \\text{yd}^2\"></span>","o":""}],[{"n":"10","s":[["\\pi r^2 = 72 \\Rightarrow r^2 = \\frac{72}{\\pi}","مساحة الدائرة"],["A = \\frac{1}{2}r^2\\theta = \\frac{1}{2}\\cdot\\frac{72}{\\pi}\\cdot\\frac{\\pi}{6} = 6","صيغة مساحة القطاع"]],"a":"<span class=\"tx\" data-t=\"6\\ \\text{cm}^2\"></span>","o":""}],[{"n":"11","s":[["288 = \\frac{1}{2}(24)^2\\theta","صيغة مساحة القطاع"],["288 = 288\\theta \\Rightarrow \\theta = 1","بقسمة الطرفين على <span class=m dir=ltr>288</span>"]],"a":"<span class=\"tx\" data-t=\"\\theta = 1\"></span> راديان <span class=\"tx\" data-t=\"\\approx 57.3^\\circ\"></span>","o":""}],[{"n":"12","s":[["\\theta = 8 \\times 2\\pi = 16\\pi\\ \\text{rad}","كل دورة <span class=\"tx\" data-t=\"2\\pi\"></span> راديان"],["\\omega = \\frac{16\\pi}{15} \\approx 3.35\\ \\text{rad/s}","السرعة الزاوية <span class=\"tx\" data-t=\"\\frac{\\theta}{t}\"></span>"],["v = r\\omega = 2 \\times \\frac{16\\pi}{15} = \\frac{32\\pi}{15} \\approx 6.70\\ \\text{ft/s}","السرعة الخطية"]],"a":"<span class=\"tx\" data-t=\"\\omega = \\frac{16\\pi}{15} \\approx 3.35\\ \\text{rad/s}\"></span> ، <span class=\"tx\" data-t=\"v = \\frac{32\\pi}{15} \\approx 6.70\\ \\text{ft/s}\"></span>","o":""}]]