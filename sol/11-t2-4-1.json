[[{"n":"1","s":[["450^\\circ = 360^\\circ + 90^\\circ","نكتب الزاوية بدلالة دورة كاملة"],["\\text{دورة كاملة عكس عقارب الساعة ثم } 90^\\circ","القياس موجب فالدوران عكس اتجاه عقارب الساعة"]],"a":"ضلع الانتهاء على الجزء الموجب من المحور <span class=\"tx\" data-t=\"y\"></span>","o":"نبدأ من الضلع الابتدائي على الجزء الموجب من المحور <span class=\"tx\" data-t=\"x\"></span>، ونرسم دورة كاملة عكس عقارب الساعة ثم ربع دورة لننتهي على الجزء الموجب من المحور <span class=\"tx\" data-t=\"y\"></span>."},{"n":"2","s":[["-900^\\circ = -2(360^\\circ) - 180^\\circ","نكتب الزاوية بدلالة الدورات الكاملة"],["\\text{دورتان مع عقارب الساعة ثم } 180^\\circ","القياس سالب فالدوران مع اتجاه عقارب الساعة"]],"a":"ضلع الانتهاء على الجزء السالب من المحور <span class=\"tx\" data-t=\"x\"></span>","o":"دورتان كاملتان ونصف دورة مع اتجاه عقارب الساعة."},{"n":"3","s":[["540^\\circ = 360^\\circ + 180^\\circ","نكتب الزاوية بدلالة دورة كاملة"],["\\text{دورة كاملة عكس عقارب الساعة ثم } 180^\\circ","القياس موجب"]],"a":"ضلع الانتهاء على الجزء السالب من المحور <span class=\"tx\" data-t=\"x\"></span>","o":"دورة كاملة ونصف دورة عكس اتجاه عقارب الساعة."},{"n":"4","s":[["-700^\\circ = -360^\\circ - 340^\\circ","نكتب الزاوية بدلالة دورة كاملة"],["-700^\\circ + 2(360^\\circ) = 20^\\circ","ضلع انتهائها يشترك مع ضلع انتهاء الزاوية <span class=\"tx\" data-t=\"20^\\circ\"></span>"]],"a":"ضلع الانتهاء في الربع الأول، يصنع <span class=\"tx\" data-t=\"20^\\circ\"></span> مع الجزء الموجب من المحور <span class=\"tx\" data-t=\"x\"></span>","o":"دورة كاملة مع عقارب الساعة ثم <span class=\"tx\" data-t=\"340^\\circ\"></span> أخرى مع عقارب الساعة."},{"n":"5","s":[["-\\frac{\\pi}{6} = -30^\\circ","بالضرب في <span class=\"tx\" data-t=\"\\frac{180^\\circ}{\\pi}\"></span>"],["\\text{دوران } 30^\\circ \\text{ مع عقارب الساعة}","القياس سالب"]],"a":"ضلع الانتهاء في الربع الرابع، أسفل المحور <span class=\"tx\" data-t=\"x\"></span> الموجب بزاوية <span class=\"tx\" data-t=\"30^\\circ\"></span>","o":""},{"n":"6","s":[["\\frac{21\\pi}{4} = 4\\pi + \\frac{5\\pi}{4}","نطرح دورتين كاملتين (<span class=\"tx\" data-t=\"4\\pi\"></span>)"],["\\frac{5\\pi}{4} = 225^\\circ",""]],"a":"ضلع الانتهاء في الربع الثالث (يصنع <span class=\"tx\" data-t=\"45^\\circ\"></span> مع الجزء السالب من المحور <span class=\"tx\" data-t=\"x\"></span>)","o":"دورتان كاملتان عكس عقارب الساعة ثم <span class=\"tx\" data-t=\"\\frac{5\\pi}{4}\"></span>."},{"n":"7","s":[["\\frac{7\\pi}{6} = \\pi + \\frac{\\pi}{6} = 210^\\circ","نكتبها بدلالة نصف دورة"]],"a":"ضلع الانتهاء في الربع الثالث، تحت الجزء السالب من المحور <span class=\"tx\" data-t=\"x\"></span> بزاوية <span class=\"tx\" data-t=\"\\frac{\\pi}{6}\"></span>","o":""},{"n":"8","s":[["\\frac{\\pi}{9} = \\frac{180^\\circ}{9} = 20^\\circ","بالتحويل إلى درجات"]],"a":"ضلع الانتهاء في الربع الأول، فوق الجزء الموجب من المحور <span class=\"tx\" data-t=\"x\"></span> بزاوية <span class=\"tx\" data-t=\"20^\\circ\"></span>","o":""}],[{"n":"9","s":[["-225^\\circ \\times \\frac{\\pi}{180^\\circ}","للتحويل إلى الراديان نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"],["= -\\frac{5\\pi}{4}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{5\\pi}{4}\"></span>","o":""},{"n":"10","s":[["-135^\\circ \\times \\frac{\\pi}{180^\\circ}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"],["= -\\frac{3\\pi}{4}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{3\\pi}{4}\"></span>","o":""},{"n":"11","s":[["75^\\circ \\times \\frac{\\pi}{180^\\circ}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"],["= \\frac{5\\pi}{12}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{5\\pi}{12}\"></span>","o":""},{"n":"12","s":[["500^\\circ \\times \\frac{\\pi}{180^\\circ}","نضرب في <span class=\"tx\" data-t=\"\\frac{\\pi}{180^\\circ}\"></span>"],["= \\frac{25\\pi}{9}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{25\\pi}{9}\"></span>","o":""},{"n":"13","s":[["-\\frac{\\pi}{7} \\times \\frac{180^\\circ}{\\pi}","للتحويل إلى الدرجات نضرب