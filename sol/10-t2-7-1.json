[[{"n":"1","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\langle 4-2,\\ -1-5\\rangle=\\langle 2,-6\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{2^2+(-6)^2}=\\sqrt{4+36}=\\sqrt{40}","صيغة مقدار المتجه"],["=2\\sqrt{10}\\approx 6.32","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 2,-6\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=2\\sqrt{10}\\approx 6.32\"></span>","o":""},{"n":"2","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\langle -3-(-4),\\ 0-7\\rangle=\\langle 1,-7\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{1^2+(-7)^2}=\\sqrt{1+49}=\\sqrt{50}","صيغة مقدار المتجه"],["=5\\sqrt{2}\\approx 7.07","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 1,-7\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=5\\sqrt{2}\\approx 7.07\"></span>","o":""},{"n":"3","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\langle 8-6,\\ 1-(-2)\\rangle=\\langle 2,3\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{2^2+3^2}=\\sqrt{4+9}","صيغة مقدار المتجه"],["=\\sqrt{13}\\approx 3.61","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 2,3\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=\\sqrt{13}\\approx 3.61\"></span>","o":""},{"n":"4","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\langle 3-4,\\ -5-(-9)\\rangle=\\langle -1,4\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{(-1)^2+4^2}=\\sqrt{1+16}","صيغة مقدار المتجه"],["=\\sqrt{17}\\approx 4.12","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle -1,4\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=\\sqrt{17}\\approx 4.12\"></span>","o":""},{"n":"5","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\langle 0.5-(-1.5),\\ -4-3\\rangle=\\langle 2,-7\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{2^2+(-7)^2}=\\sqrt{4+49}","صيغة مقدار المتجه"],["=\\sqrt{53}\\approx 7.28","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 2,-7\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=\\sqrt{53}\\approx 7.28\"></span>","o":""},{"n":"6","s":[["\\vec{v}=\\langle x_2-x_1,\\ y_2-y_1\\rangle","الصورة الإحداثية للمتجه: النهاية <span class=m dir=ltr>−</span> البداية"],["\\vec{v}=\\left\\langle -2-(-6),\\ -\\frac{1}{3}-\\left(-\\frac{2}{3}\\right)\\right\\rangle=\\left\\langle 4,\\frac{1}{3}\\right\\rangle","بالتعويض والتبسيط"],["|\\vec{v}|=\\sqrt{4^2+\\left(\\frac{1}{3}\\right)^2}=\\sqrt{16+\\frac{1}{9}}=\\sqrt{\\frac{145}{9}}","صيغة مقدار المتجه"],["=\\frac{\\sqrt{145}}{3}\\approx 4.01","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 4,\\frac{1}{3}\\rangle\"></span> ، <span class=\"tx\" data-t=\"|\\vec{v}|=\\frac{\\sqrt{145}}{3}\\approx 4.01\"></span>","o":""}],[{"n":"7","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{AB}=\\langle 5-1,\\ 4-5\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle 4,-1\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\langle 4,-1\\rangle\"></span>","o":""},{"n":"8","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{DB}=\\langle 5-2,\\ 4-3\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle 3,1\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{DB}=\\langle 3,1\\rangle\"></span>","o":""},{"n":"9","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{CB}=\\langle 5-3,\\ 4-1\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle 2,3\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CB}=\\langle 2,3\\rangle\"></span>","o":""},{"n":"10","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{CA}=\\langle 1-3,\\ 5-1\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle -2,4\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{CA}=\\langle -2,4\\rangle\"></span>","o":""},{"n":"11","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{AC}=\\langle 3-1,\\ 1-5\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle 2,-4\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{AC}=\\langle 2,-4\\rangle\"></span>","o":""},{"n":"12","s":[["A(1,5),\\ B(5,4),\\ C(3,1),\\ D(2,3)","إحداثيات النقاط من الشكل"],["\\overrightarrow{DA}=\\langle 1-2,\\ 5-3\\rangle","إحداثيات النهاية <span class=m dir=ltr>−</span> إحداثيات البداية"],["=\\langle -1,2\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{DA}=\\langle -1,2\\rangle\"></span>","o":""}],[{"n":"13","s":[["\\overrightarrow{AD}=\\langle 2-1,\\ 3-5\\rangle=\\langle 1,-2\\rangle","النهاية <span class=m dir=ltr>D(2,3)</span> والبداية <span class=m dir=ltr>A(1,5)</span>"],["|\\overrightarrow{AD}|=\\sqrt{1^2+(-2)^2}=\\sqrt{5}","صيغة مقدار المتجه"],["\\overrightarrow{DC}=\\langle 3-2,\\ 1-3\\rangle=\\langle 1,-2\\rangle","النهاية <span class=m dir=ltr>C(3,1)</span> والبداية <span class=m dir=ltr>D(2,3)</span>"],["|\\overrightarrow{DC}|=\\sqrt{1^2+(-2)^2}=\\sqrt{5}","صيغة مقدار المتجه"],["|\\overrightarrow{AD}|=|\\overrightarrow{DC}|=\\sqrt{5}","المقداران متساويان"]],"a":"<span class=\"tx\" data-t=\"|\\overrightarrow{AD}|=|\\overrightarrow{DC}|=\\sqrt{5}\"></span> ، وبما أن <span class=m dir=ltr>D</span> تقع على <span class=\"tx\" data-t=\"\\overline{AC}\"></span> (والمتجهان متساويان <span class=\"tx\" data-t=\"\\langle 1,-2\\rangle\"></span>)، فإن <span class=m dir=ltr>D</span> هي نقطة منتصف <span class=\"tx\" data-t=\"\\overline{AC}\"></span>","o":"تحقق: منتصف <span class=m dir=ltr>AC</span> هو <span class=\"tx\" data-t=\"\\left(\\frac{1+3}{2},\\frac{5+1}{2}\\right)=(2,3)=D\"></span>"}],[{"n":"14","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{2^2+(-6)^2}=\\sqrt{40}","بالتعويض والتبسيط"],["=2\\sqrt{10}\\approx 6.32","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2\\sqrt{10}\\approx 6.32\"></span>","o":""},{"n":"15","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{7^2+(-8)^2}=\\sqrt{113}","بالتعويض والتبسيط"],["\\approx 10.63","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{113}\\approx 10.63\"></span>","o":""},{"n":"16","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{(-1)^2+(-1)^2}=\\sqrt{2}","بالتعويض والتبسيط"],["\\approx 1.41","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{2}\\approx 1.41\"></span>","o":""},{"n":"17","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{3^2+5^2}=\\sqrt{34}","بالتعويض والتبسيط"],["\\approx 5.83","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{34}\\approx 5.83\"></span>","o":""},{"n":"18","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{0^2+0^2}=\\sqrt{0}","بالتعويض والتبسيط"],["=0","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"0\"></span> (المتجه الصفري مقداره صفر)","o":""},{"n":"19","s":[["|\\vec{v}|=\\sqrt{v_1^2+v_2^2}","صيغة مقدار المتجه"],["=\\sqrt{2^2+9^2}=\\sqrt{85}","بالتعويض والتبسيط"],["\\approx 9.22","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{85}\\approx 9.22\"></span>","o":""}],[{"n":"20","s":[["\\overrightarrow{FG}=\\langle 2-4,\\ 6-2\\rangle","النهاية <span class=m dir=ltr>G(2,6) −</span> البداية <span class=m dir=ltr>F(4,2)</span>"],["=\\langle -2,4\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{FG}=\\langle -2,4\\rangle\"></span>","o":""},{"n":"21","s":[["\\overrightarrow{GF}=\\langle 4-2,\\ 2-6\\rangle","النهاية <span class=m dir=ltr>F(4,2) −</span> البداية <span class=m dir=ltr>G(2,6)</span>"],["=\\langle 2,-4\\rangle","بالتبسيط (معاكس للمتجه <span class=m dir=ltr>FG)</span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{GF}=\\langle 2,-4\\rangle\"></span>","o":""},{"n":"22","s":[["M\\left(\\frac{4+2}{2},\\ \\frac{2+6}{2}\\right)=M(3,4)","صيغة نقطة المنتصف"],["\\overrightarrow{OM}=\\langle 3-0,\\ 4-0\\rangle","البداية <span class=m dir=ltr>O(0,0)</span> والنهاية <span class=m dir=ltr>M</span>"],["=\\langle 3,4\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{OM}=\\langle 3,4\\rangle\"></span>","o":""}],[{"n":"23","s":[["\\theta=25^\\circ","الطريقة الأولى: الزاوية مع الاتجاه الموجب لمحور <span class=m dir=ltr>x (</span>الأفقي)"],["90^\\circ-25^\\circ=65^\\circ","الطريقة الثانية: الزاوية مع اتجاه الشمال (محور <span class=m dir=ltr>y</span> الموجب)"]],"a":"اتجاه <span class=\"tx\" data-t=\"\\vec{p}\"></span> هو <span class=\"tx\" data-t=\"25^\\circ\"></span> مع الأفقي، أو <span class=\"tx\" data-t=\"65^\\circ\"></span> مع الشمال (شمال <span class=\"tx\" data-t=\"65^\\circ\"></span> شرق)","o":""}],[{"n":"24","s":[["\\vec{v}=\\langle v_x,\\ v_y\\rangle","الصورة الإحداثية للسرعة المتجهة"],["\\vec{v}=\\langle 27,\\ 25\\rangle","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 27,25\\rangle\"></span> <span class=m dir=ltr>km/h</span>","o":"مقدار السرعة <span class=\"tx\" data-t=\"\\sqrt{27^2+25^2}=\\sqrt{1354}\\approx 36.80\"></span> <span class=m dir=ltr>km/h (</span>إضافي). إذا اعتُبرت الحركة نزولًا على المنحدر فتكون <span class=\"tx\" data-t=\"\\langle 27,-25\\rangle\"></span>"}],[{"n":"25","s":[["\\vec{F}=\\langle |\\vec{F}|\\cos\\theta,\\ |\\vec{F}|\\sin\\theta\\rangle","المركبتان الأفقية والرأسية"],["=\\langle 350\\cos63^\\circ,\\ 350\\sin63^\\circ\\rangle","بالتعويض"],["=\\langle 350\\times 0.4540,\\ 350\\times 0.8910\\rangle","بتعويض قيم النسب المثلثية"],["\\approx\\langle 158.90,\\ 311.85\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{F}\\approx\\langle 158.90,\\ 311.85\\rangle\"></span> <span class=m dir=ltr>N (</span>مقدارا المركبتين)","o":"اتجاه الدفع في الشكل نحو الأسفل وإلى اليسار على امتداد المقبض، فبأخذ اليمين وأعلى موجبين يكون <span class=\"tx\" data-t=\"\\vec{F}\\approx\\langle -158.90,\\ -311.85\\rangle\"></span>"}],[{"n":"26","s":[["\\vec{v}=\\langle |\\vec{v}|\\cos\\theta,\\ |\\vec{v}|\\sin\\theta\\rangle","صيغة المتجه بدلالة مقداره واتجاهه"],["=\\langle 27\\cos90^\\circ,\\ 27\\sin90^\\circ\\rangle","بالتعويض"],["=\\langle 27\\times0,\\ 27\\times1\\rangle=\\langle 0,27\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 0,27\\rangle\"></span>","o":""}],[{"n":"27","s":[["\\vec{v}=\\langle |\\vec{v}|\\cos\\theta,\\ |\\vec{v}|\\sin\\theta\\rangle","صيغة المتجه بدلالة مقداره واتجاهه"],["=\\langle 10\\cos320^\\circ,\\ 10\\sin320^\\circ\\rangle","بالتعويض"],["=\\langle 10\\times0.7660,\\ 10\\times(-0.6428)\\rangle","بتعويض قيم النسب المثلثية"],["\\approx\\langle 7.66,\\ -6.43\\rangle","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}\\approx\\langle 7.66,-6.43\\rangle\"></span>","o":""}],[{"n":"28","s":[["\\text{start }(0,0)","نجعل منزل عبد الرحمن نقطة الأصل، الشرق اتجاه <span class=m dir=ltr>x</span> الموجب والشمال اتجاه <span class=m dir=ltr>y</span> الموجب"],["(248,\\ 0)","موقع المسجد بعد السير <span class=m dir=ltr>248 m</span> شرقًا"],["(248,\\ -562)","موقع منزل يحيى بعد السير <span class=m dir=ltr>562 m</span> جنوبًا"],["\\vec{v}=\\langle 248-0,\\ -562-0\\rangle=\\langle 248,-562\\rangle","النهاية <span class=m dir=ltr>−</span> البداية"],["|\\vec{v}|=\\sqrt{248^2+(-562)^2}=\\sqrt{377348}\\approx 614.29","البعد بين المنزلين (أقصر مسافة)"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 248,-562\\rangle\"></span> ، والبعد بين المنزلين <span class=\"tx\" data-t=\"\\approx 614.29\"></span> <span class=m dir=ltr>m</span>","o":""}],[{"n":"29","s":[["\\overrightarrow{AB}=\\langle 3-1,\\ y-2\\rangle=\\langle 2,\\ y-2\\rangle","النهاية <span class=m dir=ltr>−</span> البداية"],["\\sqrt{2^2+(y-2)^2}=\\sqrt{13}","صيغة مقدار المتجه"],["4+(y-2)^2=13","بتربيع الطرفين"],["(y-2)^2=9","بطرح <span class=m dir=ltr>4</span> من الطرفين"],["y-2=\\pm3","بأخذ الجذر التربيعي للطرفين"],["y=5\\ \\text{ or }\\ y=-1","بإضافة <span class=m dir=ltr>2</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"B(3,5)\"></span> أو <span class=\"tx\" data-t=\"B(3,-1)\"></span> ؛ وكلاهما يحقق <span class=\"tx\" data-t=\"|\\overrightarrow{AB}|=\\sqrt{4+9}=\\sqrt{13}\"></span>","o":""}],[{"n":"30","s":[["\\sqrt{4^2+b^2}=5","صيغة مقدار المتجه"],["16+b^2=25","بتربيع الطرفين"],["b^2=9","بطرح <span class=m dir=ltr>16</span> من الطرفين"],["b=\\pm3","بأخذ الجذر التربيعي"]],"a":"<span class=\"tx\" data-t=\"\\{-3,\\ 3\\}\"></span> ؛ لأن <span class=\"tx\" data-t=\"\\sqrt{4^2+(\\pm3)^2}=\\sqrt{25}=5\"></span>","o":""}],[{"n":"31","s":[["|\\vec{v}|=\\sqrt{6^2+(-1)^2}","صيغة مقدار المتجه"],["=\\sqrt{36+1}=\\sqrt{37}\\approx 6.08","بالتبسيط"],["37","خطأ ناصر: نسي أخذ الجذر التربيعي"],["\\sqrt{36-1}=\\sqrt{35}","خطأ ليلى: طرحت <span class=m dir=ltr>1</span> بدل جمعه، مع أن مربع <span class=m dir=ltr>−1</span> يساوي <span class=m dir=ltr>+1</span>"]],"a":"كلاهما مخطئ، والإجابة الصحيحة <span class=\"tx\" data-t=\"|\\vec{v}|=\\sqrt{37}\"></span>","o":""}],[{"n":"32","s":[["A(1,2),\\ B(4,6)","نختار نقطة بداية ونقطة نهاية (إجابة ممكنة)"],["\\overrightarrow{AB}=\\langle 4-1,\\ 6-2\\rangle=\\langle 3,4\\rangle","النهاية <span class=m dir=ltr>−</span> البداية"],["|\\overrightarrow{AB}|=\\sqrt{3^2+4^2}=\\sqrt{25}=5","صيغة مقدار المتجه"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"\\overrightarrow{AB}=\\langle 3,4\\rangle\"></span> ومقداره <span class=\"tx\" data-t=\"5\"></span>","o":"نرسم سهمًا من النقطة <span class=m dir=ltr>(1,2)</span> إلى النقطة <span class=m dir=ltr>(4,6)</span>"}],[{"n":"1","s":[["|\\vec{v}|=\\sqrt{1^2+(-1)^2}=\\sqrt{2}","صيغة مقدار المتجه"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\sqrt{2}\"></span>","o":""}],[{"n":"2","s":[["\\overrightarrow{BA}=\\langle 2-(-1),\\ 5-7\\rangle","نطرح إحداثيات نقطة البداية <span class=\"tx\" data-t=\"B\"></span> من نقطة النهاية <span class=\"tx\" data-t=\"A\"></span>"],["=\\langle 3,-2\\rangle",""]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"\\langle 3,-2\\rangle\"></span>","o":""}],[{"n":"3","s":[["|\\langle 2,4\\rangle|=\\sqrt{20}\\ne 20,\\ \\ |\\langle -4,10\\rangle|=\\sqrt{116}\\ne\\sqrt{84}","نحسب مقدار كل متجه"],["|\\langle 4,-3\\rangle|=\\sqrt{25}=5\\ne\\sqrt{7}",""],["|\\langle -6,8\\rangle|=\\sqrt{36+64}=\\sqrt{100}=10","صحيحة"]],"a":"<span class=m dir=ltr>d)</span> مقدار المتجه <span class=\"tx\" data-t=\"\\langle -6,8\\rangle\"></span> يساوي <span class=m dir=ltr>10</span>","o":""}],[{"n":"4","s":[["\\overrightarrow{AB}=\\langle 3-0,\\ y-2\\rangle=\\langle 3,\\ y-2\\rangle",""],["\\sqrt{9+(y-2)^2}=3\\sqrt{2}","صيغة مقدار المتجه"],["9+(y-2)^2=18","بتربيع الطرفين"],["(y-2)^2=9\\Rightarrow y-2=\\pm 3","بأخذ الجذر التربيعي"],["y=5\\ \\text{ or }\\ y=-1",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"5,\\ -1\"></span>","o":""}],[{"n":"24","s":[["\\vec{v}=|\\vec{v}|\\langle\\cos\\theta,\\ \\sin\\theta\\rangle,\\ \\ \\theta=-10^\\circ","زاوية الانخفاض تحت الأفقي"],["\\vec{v}=\\langle 200\\cos(-10^\\circ),\\ 200\\sin(-10^\\circ)\\rangle","بالتعويض"],["\\vec{v}\\approx\\langle 196.96,\\ -34.73\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{v}\\approx\\langle 196.96,\\ -34.73\\rangle\"></span> <span class=m dir=ltr>km/h</span>","o":""}],[{"n":"1","s":[["A(2,5),\\ F(7,6)","من الشبكة (كل مربع وحدة، لأن <span class=\"tx\" data-t=\"\\overrightarrow{AD}=\\langle 2,-1\\rangle\"></span>)"],["\\overrightarrow{AF}=\\langle 5,1\\rangle,\\ |\\overrightarrow{AF}|=\\sqrt{26}",""]],"a":"<span class=\"tx\" data-t=\"\\langle 5,1\\rangle\"></span>، المقدار <span class=\"tx\" data-t=\"\\sqrt{26}\\approx 5.10\"></span>","o":"الإحداثيات مقيسة من الزاوية السفلية اليسرى للشبكة: <span class=\"tx\" data-t=\"A(2,5), B(1,2), C(4,1), D(4,4), E(7,3), F(7,6)\"></span>"},{"n":"2","s":[["\\overrightarrow{AB}=\\langle 1-2,\\ 2-5\\rangle=\\langle -1,-3\\rangle",""],["|\\overrightarrow{AB}|=\\sqrt{1+9}=\\sqrt{10}",""]],"a":"<span class=\"tx\" data-t=\"\\langle -1,-3\\rangle\"></span>، المقدار <span class=\"tx\" data-t=\"\\sqrt{10}\\approx 3.16\"></span>","o":""},{"n":"3","s":[["\\overrightarrow{CA}=\\langle 2-4,\\ 5-1\\rangle=\\langle -2,4\\rangle",""],["|\\overrightarrow{CA}|=\\sqrt{4+16}=\\sqrt{20}=2\\sqrt{5}",""]],"a":"<span class=\"tx\" data-t=\"\\langle -2,4\\rangle\"></span>، المقدار <span class=\"tx\" data-t=\"2\\sqrt{5}\\approx 4.47\"></span>","o":""},{"n":"4","s":[["\\overrightarrow{EB}=\\langle 1-7,\\ 2-3\\rangle=\\langle -6,-1\\rangle",""],["|\\overrightarrow{EB}|=\\sqrt{36+1}=\\sqrt{37}",""]],"a":"<span class=\"tx\" data-t=\"\\langle -6,-1\\rangle\"></span>، المقدار <span class=\"tx\" data-t=\"\\sqrt{37}\\approx 6.08\"></span>","o":""},{"n":"5","s":[["\\overrightarrow{EF}=\\langle 0,3\\rangle,\\ |\\overrightarrow{EF}|=3",""]],"a":"<span class=\"tx\" data-t=\"\\langle 0,3\\rangle\"></span>، المقدار <span class=m dir=ltr>3</span>","o":""},{"n":"6","s":[["\\overrightarrow{DC}=\\langle 0,-3\\rangle,\\ |\\overrightarrow{DC}|=3",""]],"a":"<span class=\"tx\" data-t=\"\\langle 0,-3\\rangle\"></span>، المقدار <span class=m dir=ltr>3</span>","o":""}],[{"n":"7","s":[["\\overrightarrow{BD}=\\langle 4-1,\\ 4-2\\rangle=\\langle 3,2\\rangle",""],["\\overrightarrow{BF}=\\langle 7-1,\\ 6-2\\rangle=\\langle 6,4\\rangle",""],["\\overrightarrow{BF}=2\\overrightarrow{BD}","أحدهما مضاعف للآخر ولهما نقطة مشتركة <span class=\"tx\" data-t=\"B\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\overrightarrow{BD}=\\langle 3,2\\rangle\"></span>، <span class=\"tx\" data-t=\"\\overrightarrow{BF}=\\langle 6,4\\rangle\"></span>؛ النقاط <span class=\"tx\" data-t=\"B, D, F\"></span> على استقامة واحدة، و<span class=\"tx\" data-t=\"D\"></span> منتصف <span class=\"tx\" data-t=\"\\overline{BF}\"></span>","o":""}],[{"n":"8","s":[["B=(6+2,\\ 3-5)=(8,-2)","إحداثيات <span class=\"tx\" data-t=\"A\"></span> <span class=m dir=ltr>+</span> مركبتا <span class=\"tx\" data-t=\"\\overrightarrow{AB}\"></span>"]],"a":"<span class=\"tx\" data-t=\"B(8,-2)\"></span>","o":""},{"n":"9","s":[["C=(6-3,\\ 3+4)=(3,7)",""]],"a":"<span class=\"tx\" data-t=\"C(3,7)\"></span>","o":""},{"n":"10","s":[["D=(6+6,\\ 3+0)=(12,3)",""]],"a":"<span class=\"tx\" data-t=\"D(12,3)\"></span>","o":""}],[{"n":"11","s":[["\\vec{v}=\\langle v_x,\\ v_y\\rangle","السرعة المتجهة بالصورة الإحداثية"],["\\vec{v}=\\langle 58,\\ -37\\rangle","المركبة الرأسية سالبة لأن الشاحنة تنحدر إلى الأسفل"]],"a":"<span class=\"tx\" data-t=\"\\vec{v}=\\langle 58,-37\\rangle\"></span> <span class=m dir=ltr>km/h</span>","o":"إذا اعتُبرت <span class=\"tx\" data-t=\"v_y=37\"></span> بإشارتها كما أُعطيت فالمتجه <span class=\"tx\" data-t=\"\\langle 58, 37\\rangle\"></span>؛ والأدقّ فيزيائيًّا للانحدار <span class=\"tx\" data-t=\"\\langle 58,-37\\rangle\"></span>"}],[{"n":"12","s":[["\\vec{F}=|\\vec{F}|\\langle\\cos\\theta,\\ \\sin\\theta\\rangle","الصورة الإحداثية بدلالة المقدار والاتجاه"],["\\vec{F}=\\langle 272\\cos 51^\\circ,\\ 272\\sin 51^\\circ\\rangle","بالتعويض"],["\\vec{F}\\approx\\langle 171.2,\\ 211.4\\rangle",""]],"a":"<span class=\"tx\" data-t=\"\\vec{F}\\approx\\langle 171.2,\\ 211.4\\rangle\"></span> <span class=m dir=ltr>N</span>","o":"إذا أُخذ اتجاه الدفع تحت الأفقي (نحو الأرض) تكون المركبة الرأسية <span class=\"tx\" data-t=\"-211.4\"></span>"}],[{"n":"13","s":[["\\overrightarrow{AB}=\\langle x+1,\\ 2-4\\rangle=\\langle x+1,\\ -2\\rangle",""],["\\sqrt{(x+1)^2+4}=7","صيغة مقدار المتجه"],["(x+1)^2=45","بتربيع الطرفين وطرح <span class=m dir=ltr>4</span>"],["x+1=\\pm 3\\sqrt{5}","بأخذ الجذر التربيعي"],["x=-1+3\\sqrt{5}\\approx 5.71\\ \\text{ or }\\ x=-1-3\\sqrt{5}\\approx -7.71",""]],"a":"<span class=\"tx\" data-t=\"x=-1\\pm 3\\sqrt{5}\"></span>، أي <span class=\"tx\" data-t=\"x\\approx 5.71\"></span> أو <span class=\"tx\" data-t=\"x\\approx -7.71\"></span> (قيمتان لأن النقطة <span class=\"tx\" data-t=\"B\"></span> قد تقع يمين <span class=\"tx\" data-t=\"A\"></span> أو يسارها)","o":""}]]