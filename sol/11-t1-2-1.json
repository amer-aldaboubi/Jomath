[[{"n":"1","s":[["\\lim_{x\\to5^-}\\frac{1}{x-5}=-\\infty","عدديًا: <span class=m dir=ltr>x = 4.9</span> ← <span class=m dir=ltr>−10</span> ، <span class=m dir=ltr>x = 4.99</span> ← <span class=m dir=ltr>−100 (</span>القيم تتناقص بلا حدود)"],["\\lim_{x\\to5^+}\\frac{1}{x-5}=+\\infty","<span class=m dir=ltr>x = 5.01</span> ← <span class=m dir=ltr>100</span> ، <span class=m dir=ltr>x = 5.001</span> ← <span class=m dir=ltr>1000 (</span>القيم تتزايد بلا حدود)"],["\\lim_{x\\to5^-}\\ne\\lim_{x\\to5^+}","بيانيًا: للمنحنى خط تقارب رأسي <span class=m dir=ltr>x = 5</span>"]],"a":"النهاية <span class=\"tx\" data-t=\"\\lim_{x\\to5}\\frac{1}{x-5}\"></span> غير موجودة","o":""},{"n":"2","s":[["x=2.9 \\to 9.9,\\quad x=2.99\\to 9.99","من اليسار"],["x=3.1 \\to 10.1,\\quad x=3.01\\to 10.01","من اليمين"],["\\lim_{x\\to3}(x+7)=3+7=10","تقترب القيم من <span class=m dir=ltr>10</span> من الجهتين"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to3}(x+7)=10\"></span>","o":""},{"n":"3","s":[["x=-0.1\\to0.1,\\quad x=-0.01\\to0.01","من اليسار"],["x=0.1\\to0.1,\\quad x=0.01\\to0.01","من اليمين"],["\\lim_{x\\to0}|x|=0","رأس منحنى القيمة المطلقة عند <span class=m dir=ltr>(0, 0)</span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to0}|x|=0\"></span>","o":""},{"n":"4","s":[["x=-1.1\\to-3.79,\\quad x=-0.9\\to-4.19","تقترب القيم من <span class=m dir=ltr>−4</span> من الجهتين"],["\\lim_{x\\to-1}(x^2-5)=(-1)^2-5=-4","بالتعويض المباشر للتحقق"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to-1}(x^2-5)=-4\"></span>","o":""},{"n":"5","s":[["x=1.99\\to3.0302,\\quad x=2.01\\to2.9703","تقترب القيم من <span class=m dir=ltr>3</span> من الجهتين"],["\\lim_{x\\to2}\\frac{x^2-1}{x^2-2x+1}=\\frac{4-1}{4-4+1}=\\frac{3}{1}=3","بالتعويض للتحقق"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to2}\\frac{x^2-1}{x^2-2x+1}=3\"></span>","o":""},{"n":"6","s":[["x=2.9\\to100,\\quad x=2.99\\to10000","من اليسار: القيم تتزايد بلا حدود"],["x=3.1\\to100,\\quad x=3.01\\to10000","من اليمين: القيم تتزايد بلا حدود"],["\\lim_{x\\to3}\\frac{1}{(x-3)^2}=\\infty","للمنحنى خط تقارب رأسي <span class=m dir=ltr>x = 3</span>"]],"a":"النهاية غير موجودة (القيم تزداد بلا حدود، <span class=\"tx\" data-t=\"\\infty\"></span>)","o":""},{"n":"7","s":[["f(x)=-1,\\ x\\ne3","قرب <span class=m dir=ltr>3 (</span>من الجهتين) قيمة الاقتران ثابتة <span class=m dir=ltr>−1</span>"],["\\lim_{x\\to3^-}f(x)=\\lim_{x\\to3^+}f(x)=-1","قيمة <span class=m dir=ltr>f(3) = 1</span> لا تؤثر في النهاية"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to3}f(x)=-1\"></span>","o":""},{"n":"8","s":[["\\lim_{x\\to-2^-}p(x)=-2+6=4","النهاية من اليسار باستعمال <span class=m dir=ltr>x + 6</span>"],["\\lim_{x\\to-2^+}p(x)=-\\frac{1}{2}(-2)+1=2","النهاية من اليمين"],["4\\ne2","النهايتان من اليمين واليسار غير متساويتين"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to-2}p(x)\"></span> غير موجودة","o":""}],[{"n":"9","s":[["\\lim_{x\\to3}(x^2-4x+7)=3^2-4(3)+7","بالتعويض المباشر (اقتران كثير حدود)"],["=9-12+7=4",""]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"10","s":[["\\lim_{x\\to3}\\frac{x^2-16}{x-4}=\\frac{9-16}{3-4}","بالتعويض المباشر (المقام لا يساوي صفرًا)"],["=\\frac{-7}{-1}=7",""]],"a":"<span class=\"tx\" data-t=\"7\"></span>","o":"","k":[{"e":"7","a":null}]},{"n":"11","s":[["\\left(\\sqrt{9}+\\frac{1}{\\sqrt{9}}\\right)^2=\\left(3+\\frac{1}{3}\\right)^2","بالتعويض المباشر"],["=\\left(\\frac{10}{3}\\right)^2=\\frac{100}{9}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{100}{9}\"></span>","o":"","k":[{"e":"100/9","a":null}]},{"n":"12","s":[["(2\\pi)^3+\\pi(2\\pi)-5\\pi^3","بالتعويض المباشر"],["=8\\pi^3+2\\pi^2-5\\pi^3=3\\pi^3+2\\pi^2","بتجميع الحدود المتشابهة"]],"a":"<span class=\"tx\" data-t=\"3\\pi^3+2\\pi^2\"></span>","o":"","k":[{"e":"2*pi^2 + 3*pi^3","a":null}]},{"n":"13","s":[["\\lim_{x\\to-3}\\frac{x-3}{2x+4}=\\frac{-6}{-2}=3>0","نهاية ما تحت الجذر موجبة"],["\\lim_{x\\to-3}\\sqrt{\\frac{x-3}{2x+4}}=\\sqrt{3}","نهاية الجذر"]],"a":"<span class=\"tx\" data-t=\"\\sqrt{3}\"></span>","o":"","k":[{"e":"sqrt(3)","a":null}]},{"n":"14","s":[["\\lim_{x\\to4}(x^2+11)=16+11=27","نهاية ما تحت الجذر"],["\\sqrt[3]{27}=3","نهاية الجذر التكعيبي"]],"a":"<span class=\"tx\" data-t=\"3\"></span>","o":"","k":[{"e":"3","a":null}]},{"n":"15","s":[["\\frac{0}{0}","التعويض المباشر يعطي صيغة غير محددة"],["\\frac{(x-3)(x^2+3x+9)}{x-3}=x^2+3x+9","بتحليل الفرق بين مكعبين والاختصار"],["\\lim_{x\\to3}(x^2+3x+9)=9+9+9=27","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"27\"></span>","o":"","k":[{"e":"27","a":null}]},{"n":"16","s":[["\\frac{0}{0}","صيغة غير محددة"],["\\frac{(2x+3)(x+1)}{x+1}=2x+3","بالتحليل والاختصار"],["\\lim_{x\\to-1}(2x+3)=-2+3=1","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"17","s":[["\\frac{x^2-x-2}{|x-2|}=\\frac{(x-2)(x+1)}{|x-2|}","بتحليل البسط"],["\\lim_{x\\to2^+}\\frac{(x-2)(x+1)}{x-2}=\\lim_{x\\to2^+}(x+1)=3","عندما <span class=m dir=ltr>x &gt; 2</span>: <span class=m dir=ltr>|x − 2| = x − 2</span>"],["\\lim_{x\\to2^-}\\frac{(x-2)(x+1)}{-(x-2)}=\\lim_{x\\to2^-}-(x+1)=-3","عندما <span class=m dir=ltr>x &lt; 2</span>: <span class=m dir=ltr>|x − 2| = −(x − 2)</span>"],["3\\ne-3","النهايتان غير متساويتين"]],"a":"النهاية غير موجودة","o":""},{"n":"18","s":[["\\lim_{x\\to3^-}f(x)=3-1=2","النهاية من اليسار"],["\\lim_{x\\to3^+}f(x)=3(3)-7=2","النهاية من اليمين"],["\\lim_{x\\to3}f(x)=2","النهايتان متساويتان"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]},{"n":"19","s":[["\\frac{\\frac{1}{\\sqrt t}-\\frac12}{t-4}=\\frac{2-\\sqrt t}{2\\sqrt t\\,(t-4)}","بتوحيد المقامات في البسط"],["=\\frac{-(\\sqrt t-2)}{2\\sqrt t(\\sqrt t-2)(\\sqrt t+2)}","بتحليل <span class=m dir=ltr>t − 4</span> فرقًا بين مربعين"],["=\\frac{-1}{2\\sqrt t(\\sqrt t+2)}","بالاختصار"],["\\lim_{t\\to4}\\frac{-1}{2\\sqrt t(\\sqrt t+2)}=\\frac{-1}{2(2)(4)}=-\\frac{1}{16}","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"-\\frac{1}{16}\"></span>","o":"","k":[{"e":"-1/16","a":null}]},{"n":"20","s":[["\\frac{\\sqrt{x+1}-2}{x-3}\\times\\frac{\\sqrt{x+1}+2}{\\sqrt{x+1}+2}","بالضرب في مرافق البسط"],["=\\frac{x+1-4}{(x-3)(\\sqrt{x+1}+2)}=\\frac{1}{\\sqrt{x+1}+2}","بالتبسيط والاختصار"],["\\lim_{x\\to3}\\frac{1}{\\sqrt{x+1}+2}=\\frac{1}{2+2}=\\frac14","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{4}\"></span>","o":"","k":[{"e":"1/4","a":null}]}],[{"n":"21","s":[["\\lim_{x\\to2^-}f(x)=4,\\quad \\lim_{x\\to2^+}f(x)=4","من التمثيل البياني يقترب المنحنى من النقطة <span class=m dir=ltr>(2, 4)</span> من الجهتين"],["\\lim_{x\\to2}f(x)=4",""]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to2}f(x)=4\"></span>","o":""},{"n":"22","s":[["\\lim_{x\\to-2^-}f(x)=4","الفرع الأيسر ينتهي بنقطة مغلقة عند <span class=m dir=ltr>(−2, 4)</span>"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]}],[{"n":"23","s":[["\\lim_{x\\to1^-}h(x)=-1,\\quad\\lim_{x\\to1^+}h(x)=-1","يقترب المنحنى من الدائرة المفرغة <span class=m dir=ltr>(1, −1)</span> من الجهتين"],["\\lim_{x\\to1}h(x)=-1","النقطة <span class=m dir=ltr>(1, 1)</span> هي <span class=m dir=ltr>h(1)</span> ولا تؤثر في النهاية"]],"a":"<span class=\"tx\" data-t=\"-1\"></span>","o":"","k":[{"e":"-1","a":null}]},{"n":"24","s":[["\\lim_{x\\to2^+}h(x)=2","من اليمين يقترب المنحنى من الدائرة المفرغة <span class=m dir=ltr>(2, 2)</span>"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]},{"n":"25","s":[["\\lim_{x\\to3^-}h(x)=\\lim_{x\\to3^+}h(x)\\approx2","المنحنى متصل حول <span class=m dir=ltr>x = 3</span> وقيمته هناك نحو <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to3}h(x)\\approx 2\"></span>","o":"القيمة مقروءة تقريبيًّا من التمثيل البياني"}],[{"n":"26","s":[["f(0)=c=0","بالتعويض <span class=m dir=ltr>x = 0</span>"],["\\lim_{x\\to1}f(x)=a+b=5","نهاية كثير حدود <span class=m dir=ltr>=</span> قيمته"],["\\lim_{x\\to-2}f(x)=4a-2b=8\\Rightarrow 2a-b=4","بالقسمة على <span class=m dir=ltr>2</span>"],["3a=9\\Rightarrow a=3","بجمع المعادلتين"],["b=5-3=2","بالتعويض في <span class=m dir=ltr>a + b = 5</span>"]],"a":"<span class=\"tx\" data-t=\"a=3,\\ b=2,\\ c=0\"></span>","o":"","k":[{"e":"3","a":null},{"e":"2","a":null},{"e":"0","a":null}]}],[{"n":"27","s":[["\\lim_{x\\to2}f(x)=2","يقترب منحنى <span class=m dir=ltr>f</span> من الدائرة المفرغة <span class=m dir=ltr>(2, 2)</span>"],["\\lim_{x\\to2}g(x)=0","منحنى <span class=m dir=ltr>g</span> يقطع محور <span class=m dir=ltr>x</span> عند <span class=m dir=ltr>x = 2</span>"],["\\lim_{x\\to2}(f(x)+g(x))=2+0=2","نهاية المجموع"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]},{"n":"28","s":[["\\lim_{x\\to1}f(x)=1","من التمثيل البياني (المستقيم <span class=m dir=ltr>y = x)</span>"],["\\lim_{x\\to1}\\sqrt{3+f(x)}=\\sqrt{3+1}=2","نهاية الجذر"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]},{"n":"29","s":[["\\lim_{x\\to0}f(x)=0","منحنى <span class=m dir=ltr>f</span> يمر بنقطة الأصل"],["\\lim_{x\\to0}g(x)=g(0)","<span class=m dir=ltr>g</span> متصل عند <span class=m dir=ltr>0 (</span>قيمة محدودة)"],["\\lim_{x\\to0}(f(x)\\times g(x))=0\\times g(0)=0","نهاية الضرب"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"0","a":null}]}],[{"n":"30","s":[["f(-5)=25\\pi-21+7=25\\pi-14","<span class=m dir=ltr>f(−5)</span> معرّفة"],["\\lim_{x\\to-5}f(x)=25\\pi-14","نهاية كثير الحدود بالتعويض"],["\\lim_{x\\to-5}f(x)=f(-5)",""]],"a":"<span class=\"tx\" data-t=\"f\"></span> متّصل عند <span class=\"tx\" data-t=\"x=-5\"></span>","o":"","k":[{"e":"f","a":null},{"e":"-5","a":null}]},{"n":"31","s":[["g(-5)=\\frac{16}{25+25}=\\frac{8}{25}","<span class=m dir=ltr>g(−5)</span> معرّفة"],["\\lim_{x\\to-5}g(x)=\\frac{8}{25}","اقتران نسبي مقامه لا يساوي صفرًا عند <span class=m dir=ltr>−5</span>"],["\\lim_{x\\to-5}g(x)=g(-5)",""]],"a":"<span class=\"tx\" data-t=\"g\"></span> متّصل عند <span class=\"tx\" data-t=\"x=-5\"></span>","o":"","k":[{"e":"g","a":null},{"e":"-5","a":null}]},{"n":"32","s":[["\\lim_{x\\to0^-}h(x)=0^2=0","النهاية من اليسار"],["\\lim_{x\\to0^+}h(x)=3","النهاية من اليمين"],["0\\ne3","النهاية غير موجودة"]],"a":"<span class=\"tx\" data-t=\"h\"></span> غير متّصل عند <span class=\"tx\" data-t=\"x=0\"></span>","o":""}],[{"n":"33","s":[["\\lim_{x\\to3}f(x)=3+3=6","النهاية عند <span class=m dir=ltr>3</span>"],["f(3)=2+\\sqrt k",""],["2+\\sqrt k=6\\Rightarrow\\sqrt k=4","شرط الاتصال: النهاية <span class=m dir=ltr>=</span> قيمة الاقتران"],["k=16","بتربيع الطرفين"]],"a":"<span class=\"tx\" data-t=\"k=16\"></span>","o":"","k":[{"e":"16","a":null}]}],[{"n":"34","s":[["x>1:\\ \\frac{x^2+x-1-1}{x-1}=\\frac{(x+2)(x-1)}{x-1}=x+2","<span class=m dir=ltr>|x − 1| = x − 1</span>"],["\\lim_{x\\to1^+}=1+2=3","النهاية من اليمين"],["x<1:\\ \\frac{x^2-x+1-1}{-(x-1)}=\\frac{x(x-1)}{-(x-1)}=-x","<span class=m dir=ltr>|x − 1| = −(x − 1)</span>"],["\\lim_{x\\to1^-}=-1","النهاية من اليسار"],["3\\ne-1","بيانيًّا: المنحنى قفزة عند <span class=m dir=ltr>x = 1</span>"]],"a":"النهاية غير موجودة","o":"بيانيًّا: يقترب المنحنى من <span class=m dir=ltr>(1, −1)</span> من اليسار (المستقيم <span class=m dir=ltr>y = −x)</span> ومن <span class=m dir=ltr>(1, 3)</span> من اليمين (المستقيم <span class=m dir=ltr>y = x + 2)</span>"}],[{"n":"35","s":[["\\lim_{x\\to0}(\\sqrt{mx+b}-3)=0","المقام يقترب من <span class=m dir=ltr>0</span> والنهاية موجودة، إذن البسط يقترب من <span class=m dir=ltr>0</span>"],["\\sqrt b-3=0\\Rightarrow b=9",""],["\\frac{\\sqrt{mx+9}-3}{x}\\times\\frac{\\sqrt{mx+9}+3}{\\sqrt{mx+9}+3}=\\frac{mx}{x(\\sqrt{mx+9}+3)}","بالضرب في المرافق"],["\\lim_{x\\to0}\\frac{m}{\\sqrt{mx+9}+3}=\\frac{m}{6}","بالاختصار والتعويض"],["\\frac m6=1\\Rightarrow m=6",""]],"a":"<span class=\"tx\" data-t=\"m=6,\\ b=9\"></span>","o":"","k":[{"e":"6","a":null},{"e":"9","a":null}]}],[{"n":"36","s":[["\\frac{1}{x-1}-\\frac{a}{x^2-1}=\\frac{x+1-a}{(x-1)(x+1)}","بتوحيد المقامات"],["1+1-a=0\\Rightarrow a=2","المقام يقترب من <span class=m dir=ltr>0</span>، فلكي توجد النهاية يجب أن يقترب البسط من <span class=m dir=ltr>0</span>"],["\\frac{x-1}{(x-1)(x+1)}=\\frac{1}{x+1}","بالتعويض <span class=m dir=ltr>a = 2</span> والاختصار"],["\\lim_{x\\to1}\\frac{1}{x+1}=\\frac12","النهاية موجودة"]],"a":"<span class=\"tx\" data-t=\"a=2\"></span> (وتكون النهاية <span class=\"tx\" data-t=\"\\frac12\"></span>)","o":"","k":[{"e":"2","a":null},{"e":"1/2","a":null}]}],[{"n":"9","s":[["\\frac{\\sqrt{7+2}-3}{7-7} = \\frac{0}{0}","التعويض المباشر يعطي صيغة غير معيّنة"],["\\lim_{x\\to 7}\\frac{\\sqrt{x+2}-3}{x-7}\\times\\frac{\\sqrt{x+2}+3}{\\sqrt{x+2}+3} = \\lim_{x\\to 7}\\frac{x+2-9}{(x-7)(\\sqrt{x+2}+3)}","بالضرب في المرافق"],["= \\lim_{x\\to 7}\\frac{1}{\\sqrt{x+2}+3}","باختصار العامل <span class=\"tx\" data-t=\"(x-7)\"></span>"],["= \\frac{1}{\\sqrt{9}+3} = \\frac{1}{6}","بالتعويض المباشر"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":"","k":[{"e":"1/6","a":null}]},{"n":"10","s":[["\\frac{16-20+4}{16-12-4} = \\frac{0}{0}","التعويض المباشر يعطي صيغة غير معيّنة"],["\\lim_{x\\to -4}\\frac{(x+4)(x+1)}{(x+4)(x-1)}","بالتحليل إلى العوامل"],["= \\lim_{x\\to -4}\\frac{x+1}{x-1} = \\frac{-3}{-5} = \\frac{3}{5}","بالاختصار ثم التعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5}\"></span>","o":"","k":[{"e":"3/5","a":null}]},{"n":"11","s":[["x-4 \\ne 0 \\text{ at } x=-4","المقام لا يساوي صفرًا عند <span class=\"tx\" data-t=\"x=-4\"></span>، فنعوّض مباشرة"],["\\lim_{x\\to -4}\\frac{|x-4|}{x-4} = \\frac{|-8|}{-8} = \\frac{8}{-8} = -1","بالتعويض المباشر"]],"a":"<span class=\"tx\" data-t=\"-1\"></span>","o":"","k":[{"e":"-1","a":null}]},{"n":"12","s":[["\\lim_{x\\to 1}\\frac{x^4+x^2-6}{x^4+2x+3} = \\frac{1+1-6}{1+2+3}","بالتعويض المباشر (المقام لا يساوي صفرًا)"],["= \\frac{-4}{6} = -\\frac{2}{3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-\\frac{2}{3}\"></span>","o":"","k":[{"e":"-2/3","a":null}]}],[{"n":"13","s":[["f(5) = 3(5)-2 = 13","الاقتران معرّف عند <span class=\"tx\" data-t=\"x=5\"></span>"],["\\lim_{x\\to 5}(3x-2) = 13","نهاية كثير الحدود بالتعويض المباشر"],["\\lim_{x\\to 5}f(x) = f(5)","شرط الاتصال متحقق"]],"a":"<span class=\"tx\" data-t=\"f\"></span> متّصل عند <span class=\"tx\" data-t=\"x=5\"></span> (كثير حدود متّصل عند جميع الأعداد الحقيقية)","o":""},{"n":"14","s":[["g(0) = \\frac{1}{0}","غير معرّف"]],"a":"<span class=\"tx\" data-t=\"g\"></span> غير متّصل عند <span class=\"tx\" data-t=\"x=0\"></span>؛ لأنّ <span class=\"tx\" data-t=\"g(0)\"></span> غير معرّف","o":""},{"n":"15","s":[["h(3) = 2(3)-1 = 5","الاقتران معرّف عند <span class=\"tx\" data-t=\"x=3\"></span>"],["\\lim_{x\\to 3^-}h(x) = 3(3)+4 = 13","النهاية من اليسار"],["\\lim_{x\\to 3^+}h(x) = 2(3)-1 = 5","النهاية من اليمين"],["13 \\ne 5","النهاية عند <span class=\"tx\" data-t=\"x=3\"></span> غير موجودة"]],"a":"<span class=\"tx\" data-t=\"h\"></span> غير متّصل عند <span class=\"tx\" data-t=\"x=3\"></span>؛ لأنّ النهايتين من اليمين ومن اليسار غير متساويتين","o":""}],[{"n":"26","s":[["\\lim_{x\\to 1^-}G(x) = 4","من التمثيل: المستقيم يقترب من الدائرة المفرغة <span class=\"tx\" data-t=\"(1,4)\"></span>"],["\\lim_{x\\to 1^+}G(x) = -1","المنحنى يقترب من الدائرة المفرغة <span class=\"tx\" data-t=\"(1,-1)\"></span>"],["4 \\ne -1","النهايتان غير متساويتين"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to 1}G(x)\"></span> غير موجودة","o":""},{"n":"27","s":[["\\lim_{x\\to -2}G(x) = 1","من التمثيل: المستقيم <span class=\"tx\" data-t=\"y=x+3\"></span> يمر بالنقطة <span class=\"tx\" data-t=\"(-2,1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"28","s":[["\\lim_{x\\to -3}G(x) = 0","من التمثيل: المستقيم يقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(-3,0)\"></span>"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"0","a":null}]}],[{"n":"1","s":[["\\lim_{t\\to -2^-}f(t) = 0,\\quad \\lim_{t\\to -2^+}f(t) = 0","من التمثيل: الجزءان يقتربان من الدائرة المفرغة <span class=\"tx\" data-t=\"(-2,0)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{t\\to -2}f(t) = 0\"></span> (وجود دائرة مفرغة لا يؤثر في قيمة النهاية)","o":""},{"n":"2","s":[["\\lim_{t\\to -1^-}f(t) = -1,\\quad \\lim_{t\\to -1^+}f(t) = -1","من التمثيل: المنحنى يمر بالنقطة <span class=\"tx\" data-t=\"(-1,-1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{t\\to -1}f(t) = -1\"></span>","o":""},{"n":"3","s":[["\\lim_{t\\to 0^-}f(t) = -1","من اليسار يقترب المنحنى من الدائرة المفرغة <span class=\"tx\" data-t=\"(0,-1)\"></span>"],["\\lim_{t\\to 0^+}f(t) = 1","من اليمين يقترب من الدائرة المفرغة <span class=\"tx\" data-t=\"(0,1)\"></span>"],["-1 \\ne 1","النهايتان غير متساويتين"]],"a":"<span class=\"tx\" data-t=\"\\lim_{t\\to 0}f(t)\"></span> غير موجودة","o":""}],[{"n":"4","s":[["x:\\ 4.9,\\ 4.99,\\ 4.999 \\to f(x):\\ 9.9,\\ 9.99,\\ 9.999","جدول قيم من اليسار"],["x:\\ 5.1,\\ 5.01,\\ 5.001 \\to f(x):\\ 10.1,\\ 10.01,\\ 10.001","جدول قيم من اليمين"],["\\frac{x^2-25}{x-5} = \\frac{(x-5)(x+5)}{x-5} = x+5,\\ x\\ne 5","بيانيًا: المنحنى مستقيم <span class=\"tx\" data-t=\"y=x+5\"></span> فيه دائرة مفرغة عند <span class=\"tx\" data-t=\"(5,10)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to 5}\\frac{x^2-25}{x-5} = 10\"></span>","o":""},{"n":"5","s":[["x:\\ -2.1,\\ -2.01,\\ -2.001 \\to f(x):\\ 8.51,\\ 8.0501,\\ 8.005","جدول قيم من اليسار"],["x:\\ -1.9,\\ -1.99,\\ -1.999 \\to f(x):\\ 7.51,\\ 7.9501,\\ 7.995","جدول قيم من اليمين"],["(-2)^2-(-2)+2 = 8","بيانيًا: القطع المكافئ يمر بالنقطة <span class=\"tx\" data-t=\"(-2,8)\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to -2}(x^2-x+2) = 8\"></span>","o":""},{"n":"6","s":[["x:\\ 0.9,\\ 0.99,\\ 0.999 \\to f(x):\\ 10,\\ 100,\\ 1000","من اليسار تزداد القيم بلا حدود"],["x:\\ 1.1,\\ 1.01,\\ 1.001 \\to f(x):\\ -10,\\ -100,\\ -1000","من اليمين تتناقص القيم بلا حدود"],["x = 1","بيانيًا: يوجد خط تقارب رأسي عند <span class=\"tx\" data-t=\"x=1\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\lim_{x\\to 1}\\frac{1}{1-x}\"></span> غير موجودة","o":""}],[{"n":"7","s":[["x\\le 2:\\ y = x^2","جزء من القطع المكافئ يمر بالنقاط <span class=\"tx\" data-t=\"(-2,4), (-1,1), (0,0), (1,1)\"></span> وينتهي بدائرة مغلقة عند <span class=\"tx\" data-t=\"(2,4)\"></span>"],["x>2:\\ y = 6-x","نصف مستقيم يبدأ من <span class=\"tx\" data-t=\"(2,4)\"></span> ويمر بالنقاط <span class=\"tx\" data-t=\"(3,3), (4,2), (6,0)\"></span>"]],"a":"التمثيل: قطع مكافئ <span class=\"tx\" data-t=\"y=x^2\"></span> يسار <span class=\"tx\" data-t=\"x=2\"></span> متصل بالمستقيم <span class=\"tx\" data-t=\"y=6-x\"></span> عند النقطة <span class=\"tx\" data-t=\"(2,4)\"></span>","o":"الفرعان يلتقيان عند <span class=\"tx\" data-t=\"(2,4)\"></span> لأنّ <span class=\"tx\" data-t=\"2^2 = 6-2 = 4\"></span>، فلا توجد فجوة في التمثيل"},{"n":"8a","s":[["\\lim_{x\\to 2^-}f(x) = \\lim_{x\\to 2^-}x^2 = 4","من التمثيل (يسار <span class=m dir=ltr>2</span> نستعمل <span class=\"tx\" data-t=\"x^2\"></span>)"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"8b","s":[["\\lim_{x\\to 1}f(x) = 1^2 = 1","من التمثيل: القطع المكافئ يمر بالنقطة <span class=\"tx\" data-t=\"(1,1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"8c","s":[["\\lim_{x\\to 6}f(x) = 6-6 = 0","من التمثيل: المستقيم يقطع محور <span class=\"tx\" data-t=\"x\"></span> عند <span class=\"tx\" data-t=\"(6,0)\"></span>"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"0","a":null}]}],[{"n":"9","s":[["\\lim_{x\\to -7}(2x+5) = 2(-7)+5 = -9","بالتعويض المباشر"]],"a":"<span class=\"tx\" data-t=\"-9\"></span>","o":"","k":[{"e":"-9","a":null}]},{"n":"10","s":[["\\lim_{x\\to 2}(-x^2+5x-2) = -4+10-2 = 4","بالتعويض المباشر"]],"a":"<span class=\"tx\" data-t=\"4\"></span>","o":"","k":[{"e":"4","a":null}]},{"n":"11","s":[["\\lim_{x\\to 2}\\frac{x+3}{x+6} = \\frac{2+3}{2+6} = \\frac{5}{8}","بالتعويض المباشر (المقام لا يساوي صفرًا)"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{8}\"></span>","o":"","k":[{"e":"5/8","a":null}]},{"n":"12","s":[["\\frac{2(1)-2}{1-1} = \\frac{0}{0}","صيغة غير معيّنة"],["\\lim_{x\\to 1}\\frac{2(x-1)}{-(x-1)} = \\lim_{x\\to 1}(-2) = -2","بإخراج العامل المشترك والاختصار"]],"a":"<span class=\"tx\" data-t=\"-2\"></span>","o":"","k":[{"e":"-2","a":null}]},{"n":"13","s":[["\\lim_{x\\to 3}\\frac{2x-6}{x+5} = \\frac{6-6}{3+5} = \\frac{0}{8} = 0","بالتعويض المباشر (المقام لا يساوي صفرًا)"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":"","k":[{"e":"0","a":null}]},{"n":"14","s":[["\\lim_{z\\to -4}\\sqrt[3]{2z-8} = \\sqrt[3]{2(-4)-8} = \\sqrt[3]{-16}","بالتعويض المباشر (الجذر التكعيبي معرّف للأعداد السالبة)"],["\\sqrt[3]{-16} = -2\\sqrt[3]{2} \\approx -2.52","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"-2\\sqrt[3]{2} \\approx -2.52\"></span>","o":"","k":[{"e":"-2.52","a":true}]},{"n":"15","s":[["\\frac{18-18}{27-27} = \\frac{0}{0}","صيغة غير معيّنة"],["\\lim_{x\\to 3}\\frac{2(x-3)(x+3)}{(x-3)(x^2+3x+9)}","تحليل الفرق بين مربعين والفرق بين مكعبين"],["= \\lim_{x\\to 3}\\frac{2(x+3)}{x^2+3x+9} = \\frac{12}{27} = \\frac{4}{9}","بالاختصار ثم التعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{4}{9}\"></span>","o":"","k":[{"e":"4/9","a":null}]},{"n":"16","s":[["\\frac{25-35+10}{25-25} = \\frac{0}{0}","صيغة غير معيّنة"],["\\lim_{x\\to 5}\\frac{(x-5)(x-2)}{-5(x-5)}","بالتحليل إلى العوامل"],["= \\lim_{x\\to 5}\\frac{x-2}{-5} = \\frac{3}{-5} = -\\frac{3}{5}","بالاختصار ثم التعويض"]],"a":"<span class=\"tx\" data-t=\"-\\frac{3}{5}\"></span>","o":"","k":[{"e":"-3/5","a":null}]},{"n":"17","s":[["\\frac{\\sqrt{1}-1}{0} = \\frac{0}{0}","صيغة غير معيّنة"],["\\lim_{x\\to 0}\\frac{\\sqrt{3x+1}-1}{x}\\times\\frac{\\sqrt{3x+1}+1}{\\sqrt{3x+1}+1} = \\lim_{x\\to 0}\\frac{3x}{x(\\sqrt{3x+1}+1)}","بالضرب في المرافق"],["= \\lim_{x\\to 0}\\frac{3}{\\sqrt{3x+1}+1} = \\frac{3}{2}","بالاختصار ثم التعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{2}\"></span>","o":"","k":[{"e":"3/2","a":null}]}],[{"n":"18","s":[["f(2) = 2-6 = -4","الاقتران معرّف عند <span class=\"tx\" data-t=\"x=2\"></span>"],["\\lim_{x\\to 2^-}f(x) = 2-2 = 0","النهاية من اليسار"],["\\lim_{x\\to 2^+}f(x) = 2-6 = -4","النهاية من اليمين"],["0 \\ne -4","النهاية عند <span class=\"tx\" data-t=\"x=2\"></span> غير موجودة"]],"a":"<span class=\"tx\" data-t=\"f\"></span> غير متّصل عند <span class=\"tx\" data-t=\"x=2\"></span>؛ لأنّ <span class=\"tx\" data-t=\"\\lim_{x\\to 2}f(x)\"></span> غير موجودة","o":""}]]