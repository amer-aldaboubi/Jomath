[[{"n":"1","s":[["\\theta = 225^\\circ","الضلع الابتدائي على الجزء الموجب من المحور <span class=m dir=ltr>x</span>، والدوران عكس اتجاه حركة عقارب الساعة"],["180^\\circ < \\theta < 270^\\circ","الزاوية أكبر من <span class=m dir=ltr>180</span> وأصغر من <span class=m dir=ltr>270</span>"],["\\alpha = 45^\\circ","الزاوية المرجعية α: الزاوية الحادة بين ضلع الانتهاء والمحور <span class=m dir=ltr>x</span>"]],"a":"ضلع الانتهاء للزاوية <span class=\"tx\" data-t=\"225^\\circ\"></span> يقع في الربع الثالث","o":"أرسم الضلع الابتدائي على محور <span class=m dir=ltr>x</span> الموجب، ثم أدير عكس عقارب الساعة بمقدار <span class=\"tx\" data-t=\"225^\\circ\"></span> وأرسم ضلع الانتهاء، وأضع قوسًا يبيّن الدوران."},{"n":"2","s":[["\\theta = 160^\\circ","الضلع الابتدائي على الجزء الموجب من المحور <span class=m dir=ltr>x</span>، والدوران عكس اتجاه حركة عقارب الساعة"],["90^\\circ < \\theta < 180^\\circ","الزاوية أكبر من <span class=m dir=ltr>90</span> وأصغر من <span class=m dir=ltr>180</span>"],["\\alpha = 20^\\circ","الزاوية المرجعية α: الزاوية الحادة بين ضلع الانتهاء والمحور <span class=m dir=ltr>x</span>"]],"a":"ضلع الانتهاء للزاوية <span class=\"tx\" data-t=\"160^\\circ\"></span> يقع في الربع الثاني","o":"أرسم الضلع الابتدائي على محور <span class=m dir=ltr>x</span> الموجب، ثم أدير عكس عقارب الساعة بمقدار <span class=\"tx\" data-t=\"160^\\circ\"></span> وأرسم ضلع الانتهاء، وأضع قوسًا يبيّن الدوران."},{"n":"3","s":[["\\theta = 330^\\circ","الضلع الابتدائي على الجزء الموجب من المحور <span class=m dir=ltr>x</span>، والدوران عكس اتجاه حركة عقارب الساعة"],["270^\\circ < \\theta < 360^\\circ","الزاوية أكبر من <span class=m dir=ltr>270</span> وأصغر من <span class=m dir=ltr>360</span>"],["\\alpha = 30^\\circ","الزاوية المرجعية α: الزاوية الحادة بين ضلع الانتهاء والمحور <span class=m dir=ltr>x</span>"]],"a":"ضلع الانتهاء للزاوية <span class=\"tx\" data-t=\"330^\\circ\"></span> يقع في الربع الرابع","o":"أرسم الضلع الابتدائي على محور <span class=m dir=ltr>x</span> الموجب، ثم أدير عكس عقارب الساعة بمقدار <span class=\"tx\" data-t=\"330^\\circ\"></span> وأرسم ضلع الانتهاء، وأضع قوسًا يبيّن الدوران."},{"n":"4","s":[["\\theta = 240^\\circ","الضلع الابتدائي على الجزء الموجب من المحور <span class=m dir=ltr>x</span>، والدوران عكس اتجاه حركة عقارب الساعة"],["180^\\circ < \\theta < 270^\\circ","الزاوية أكبر من <span class=m dir=ltr>180</span> وأصغر من <span class=m dir=ltr>270</span>"],["\\alpha = 60^\\circ","الزاوية المرجعية α: الزاوية الحادة بين ضلع الانتهاء والمحور <span class=m dir=ltr>x</span>"]],"a":"ضلع الانتهاء للزاوية <span class=\"tx\" data-t=\"240^\\circ\"></span> يقع في الربع الثالث","o":"أرسم الضلع الابتدائي على محور <span class=m dir=ltr>x</span> الموجب، ثم أدير عكس عقارب الساعة بمقدار <span class=\"tx\" data-t=\"240^\\circ\"></span> وأرسم ضلع الانتهاء، وأضع قوسًا يبيّن الدوران."}],[{"n":"5","s":[["270^\\circ < 285^\\circ < 360^\\circ","بمقارنة قياس الزاوية بحدود الأرباع"]],"a":"يقع ضلع الانتهاء في الربع الرابع","o":""},{"n":"6","s":[["0^\\circ < 75^\\circ < 90^\\circ","بمقارنة قياس الزاوية بحدود الأرباع"]],"a":"يقع ضلع الانتهاء في الربع الأول","o":""},{"n":"7","s":[["90^\\circ < 100^\\circ < 180^\\circ","بمقارنة قياس الزاوية بحدود الأرباع"]],"a":"يقع ضلع الانتهاء في الربع الثاني","o":""},{"n":"8","s":[["180^\\circ < 265^\\circ < 270^\\circ","بمقارنة قياس الزاوية بحدود الأرباع"]],"a":"يقع ضلع الانتهاء في الربع الثالث","o":""}],[{"n":"9","s":[["\\sin\\theta = y > 0","الجيب يمثل الإحداثي <span class=m dir=ltr>y</span> لنقطة التقاطع مع دائرة الوحدة"],["y > 0","فوق المحور <span class=m dir=ltr>x</span>"]],"a":"الربعان: الأول، والثاني","o":""},{"n":"10","s":[["\\cos\\theta = x > 0","جيب التمام يمثل الإحداثي <span class=m dir=ltr>x</span>"],["x > 0","يمين المحور <span class=m dir=ltr>y</span>"]],"a":"الربعان: الأول، والرابع","o":""},{"n":"11","s":[["\\tan\\theta = \\frac{y}{x} < 0","الظل سالب عندما تختلف إشارتا <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["x<0,\\ y>0 \\ \\text{or}\\ x>0,\\ y<0",""]],"a":"الربعان: الثاني، والرابع","o":""},{"n":"12","s":[["\\sin\\theta<0 \\Rightarrow \\text{III, IV}","الجيب سالب في الربعين الثالث والرابع"],["\\cos\\theta<0 \\Rightarrow \\text{II, III}","جيب التمام سالب في الربعين الثاني والثالث"],["\\text{III}","الربع المشترك"]],"a":"الربع الثالث","o":""}],[{"n":"13","s":[["\\sin\\theta = -0.7 < 0","الجيب سالب"]],"a":"الربعان: الثالث، والرابع","o":""},{"n":"14","s":[["\\tan\\theta = 2 > 0","الظل موجب"]],"a":"الربعان: الأول، والثالث","o":""},{"n":"15","s":[["\\cos\\theta = -\\frac{1}{2} < 0","جيب التمام سالب"]],"a":"الربعان: الثاني، والثالث","o":""},{"n":"16","s":[["\\tan\\theta = -1 < 0","الظل سالب"]],"a":"الربعان: الثاني، والرابع","o":""},{"n":"17","s":[["\\cos\\theta = 0.45 > 0","جيب التمام موجب"]],"a":"الربعان: الأول، والرابع","o":""},{"n":"18","s":[["\\sin\\theta = 0.55 > 0","الجيب موجب"]],"a":"الربعان: الأول، والثاني","o":""},{"n":"19","s":[["\\sin\\theta = 0.3 > 0 \\Rightarrow \\text{I, II}","الجيب موجب"],["\\cos\\theta < 0 \\Rightarrow \\text{II, III}","جيب التمام سالب"],["\\text{II}","الربع المشترك"]],"a":"الربع الثاني","o":""},{"n":"20","s":[["\\tan\\theta = -4 < 0 \\Rightarrow \\text{II, IV}","الظل سالب"],["\\sin\\theta > 0 \\Rightarrow \\text{I, II}","الجيب موجب"],["\\text{II}","الربع المشترك"]],"a":"الربع الثاني","o":""}],[{"n":"21","s":[["P(x, y) = P(\\cos\\theta, \\sin\\theta)","إحداثيا نقطة التقاطع مع دائرة الوحدة"],["\\cos\\theta = 0,\\ \\sin\\theta = -1",""],["\\tan\\theta = \\frac{-1}{0}","القسمة على صفر غير معرّفة"]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta=-1\"></span>، <span class=\"tx\" data-t=\"\\cos\\theta=0\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta\"></span> غير معرّف","o":""},{"n":"22","s":[["\\cos\\theta = 0.5,\\ \\sin\\theta = 0.5\\sqrt{3}","<span class=m dir=ltr>x = cos</span> θ و <span class=m dir=ltr>y = sin</span> θ"],["\\tan\\theta = \\frac{\\sin\\theta}{\\cos\\theta} = \\frac{0.5\\sqrt{3}}{0.5} = \\sqrt{3}",""]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta=\\frac{\\sqrt3}{2}\"></span>، <span class=\"tx\" data-t=\"\\cos\\theta=\\frac12\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta=\\sqrt3\"></span>","o":""},{"n":"23","s":[["\\cos\\theta = -\\frac{8}{17},\\ \\sin\\theta = \\frac{15}{17}","<span class=m dir=ltr>x = cos</span> θ و <span class=m dir=ltr>y = sin</span> θ"],["\\tan\\theta = \\frac{15/17}{-8/17} = -\\frac{15}{8}",""]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta=\\frac{15}{17}\"></span>، <span class=\"tx\" data-t=\"\\cos\\theta=-\\frac{8}{17}\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta=-\\frac{15}{8}\"></span>","o":""},{"n":"24","s":[["\\cos\\theta = \\frac{20}{29},\\ \\sin\\theta = -\\frac{21}{29}","<span class=m dir=ltr>x = cos</span> θ و <span class=m dir=ltr>y = sin</span> θ"],["\\tan\\theta = \\frac{-21/29}{20/29} = -\\frac{21}{20}",""]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta=-\\frac{21}{29}\"></span>، <span class=\"tx\" data-t=\"\\cos\\theta=\\frac{20}{29}\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta=-\\frac{21}{20}\"></span>","o":""}],[{"n":"25","s":[["\\cos^2\\theta + \\sin^2\\theta = 1","نتيجة لنظرية فيثاغورس"],["\\cos^2\\theta = 1 - \\frac{9}{16} = \\frac{7}{16}","بتعويض قيمة <span class=m dir=ltr>sin</span> θ"],["\\cos\\theta = -\\frac{\\sqrt{7}}{4} \\approx -0.6614","في الربع الثاني يكون <span class=m dir=ltr>cos</span> θ سالبًا"],["\\tan\\theta = \\frac{3/4}{-\\sqrt{7}/4} = -\\frac{3}{\\sqrt{7}} \\approx -1.1339","<span class=m dir=ltr>tan</span> θ <span class=m dir=ltr>= sin</span> θ <span class=m dir=ltr>÷ cos</span> θ"]],"a":"<span class=\"tx\" data-t=\"\\cos\\theta=-\\frac{\\sqrt7}{4}\\approx-0.6614\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta=-\\frac{3}{\\sqrt7}=-\\frac{3\\sqrt7}{7}\\approx-1.1339\"></span>","o":""},{"n":"26","s":[["\\tan\\theta=0.78>0,\\ \\sin\\theta<0 \\Rightarrow \\text{III}","الظل موجب والجيب سالب: الربع الثالث"],["\\sin\\theta = 0.78\\cos\\theta","من <span class=m dir=ltr>tan</span> θ <span class=m dir=ltr>= sin</span> θ <span class=m dir=ltr>÷ cos</span> θ"],["\\cos^2\\theta + 0.6084\\cos^2\\theta = 1 \\Rightarrow 1.6084\\cos^2\\theta = 1","بالتعويض في <span class=m dir=ltr>cos²</span>θ <span class=m dir=ltr>+ sin²</span>θ <span class=m dir=ltr>= 1</span>"],["\\cos\\theta = -\\sqrt{\\frac{1}{1.6084}} \\approx -0.7885","<span class=m dir=ltr>cos</span> θ سالب في الربع الثالث"],["\\sin\\theta = 0.78 \\times (-0.7885) \\approx -0.6150","بتعويض قيمة <span class=m dir=ltr>cos</span> θ"]],"a":"<span class=\"tx\" data-t=\"\\cos\\theta\\approx-0.7885\"></span>، <span class=\"tx\" data-t=\"\\sin\\theta\\approx-0.6150\"></span>","o":""},{"n":"27","s":[["\\cos\\theta<0,\\ \\tan\\theta<0 \\Rightarrow \\text{II}","الربع الثاني"],["\\sin^2\\theta = 1 - (-0.75)^2 = 0.4375","نتيجة لنظرية فيثاغورس"],["\\sin\\theta = \\sqrt{0.4375} \\approx 0.6614","<span class=m dir=ltr>sin</span> θ موجب في الربع الثاني"],["\\tan\\theta = \\frac{0.6614}{-0.75} \\approx -0.8819",""]],"a":"<span class=\"tx\" data-t=\"\\sin\\theta\\approx0.6614\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta\\approx-0.8819\"></span>","o":""},{"n":"28","s":[["\\cos^2\\theta = 1 - (-0.87)^2 = 0.2431","نتيجة لنظرية فيثاغورس"],["\\cos\\theta = \\sqrt{0.2431} \\approx 0.4931","<span class=m dir=ltr>cos</span> θ موجب في الربع الرابع"],["\\tan\\theta = \\frac{-0.87}{0.4931} \\approx -1.7645",""]],"a":"<span class=\"tx\" data-t=\"\\cos\\theta\\approx0.4931\"></span>، <span class=\"tx\" data-t=\"\\tan\\theta\\approx-1.7645\"></span>","o":""}],[{"n":"29","s":[["\\sin\\theta = y","جيب الزاوية هو الإحداثي <span class=m dir=ltr>y</span> لنقطة تقاطع ضلع الانتهاء مع دائرة الوحدة"],["-1 \\le y \\le 1","نصف قطر دائرة الوحدة <span class=m dir=ltr>1</span>"],["\\sin 90^\\circ = 1,\\ \\sin 270^\\circ = -1","أعلى نقطة <span class=m dir=ltr>(0,1)</span> وأدنى نقطة <span class=m dir=ltr>(0,−1)</span>"]],"a":"أكبر قيمة لجيب الزاوية <span class=\"tx\" data-t=\"1\"></span> (عند <span class=\"tx\" data-t=\"90^\\circ\"></span>)، وأصغر قيمة <span class=\"tx\" data-t=\"-1\"></span> (عند <span class=\"tx\" data-t=\"270^\\circ\"></span>)؛ لأن <span class=\"tx\" data-t=\"-1\\le\\sin\\theta\\le1\"></span>","o":""}],[{"n":"30","s":[["180^\\circ<x<360^\\circ,\\ \\tan x = 0.75>0 \\Rightarrow \\text{III}","الظل موجب في الربع الثالث فقط من هذه الفترة"],["\\sin x = 0.75\\cos x",""],["1.5625\\cos^2 x = 1 \\Rightarrow \\cos x = -0.8","<span class=m dir=ltr>cos x</span> سالب في الربع الثالث"],["\\sin x = 0.75\\times(-0.8) = -0.6",""],["\\sin x + \\cos x = -0.6 + (-0.8) = -1.4",""]],"a":"إجابة زينة صحيحة: <span class=\"tx\" data-t=\"\\sin x+\\cos x=-1.4\"></span>","o":"خطأ أمجد: لم ينتبه إلى أن الجيب وجيب التمام كليهما سالبان في الربع الثالث، فأخذ إحدى القيمتين بإشارة خاطئة (<span class=\"tx\" data-t=\"0.8-0.6=0.2\"></span>)."}],[{"n":"1","s":[["\\cos\\theta = -0.5 < 0","جيب التمام سالب في الربعين الثاني والثالث"]],"a":"<span class=m dir=ltr>(b)</span> الربعين: الثاني، والثالث","o":""}],[{"n":"2","s":[["\\sin\\theta = y = \\frac{9}{41}","الجيب هو الإحداثي <span class=m dir=ltr>y</span> لنقطة التقاطع مع دائرة الوحدة"]],"a":"<span class=m dir=ltr>(d)</span> <span class=\"tx\" data-t=\"\\frac{9}{41}\"></span>","o":""}],[{"n":"4","s":[["\\cos^2 x = 1 - \\sin^2 x = 1 - \\frac{64}{289} = \\frac{225}{289}","المتطابقة <span class=\"tx\" data-t=\"\\sin^2 x + \\cos^2 x = 1\"></span>"],["\\cos x = -\\frac{15}{17}","نأخذ الإشارة السالبة لأن <span class=\"tx\" data-t=\"x\"></span> في الربع الثاني"],["\\tan x = \\frac{\\sin x}{\\cos x} = \\frac{8/17}{-15/17} = -\\frac{8}{15}","تعريف الظل"]],"a":"<span class=m dir=ltr>a)</span> <span class=\"tx\" data-t=\"-\\frac{8}{15}\"></span>","o":""}],[{"n":"6","s":[["\\cos x = 0.6,\\quad \\sin x = 0.8","الإحداثي <span class=\"tx\" data-t=\"x\"></span> هو جيب التمام والإحداثي <span class=\"tx\" data-t=\"y\"></span> هو الجيب"],["\\tan x = \\frac{0.8}{0.6} = \\frac{4}{3}","<span class=\"tx\" data-t=\"\\tan x = \\frac{y}{x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin x = 0.8,\\ \\cos x = 0.6,\\ \\tan x = \\frac{4}{3}\"></span>","o":""},{"n":"7","s":[["\\cos x = \\frac{5}{13},\\quad \\sin x = -\\frac{12}{13}","الإحداثي <span class=\"tx\" data-t=\"x\"></span> هو جيب التمام والإحداثي <span class=\"tx\" data-t=\"y\"></span> هو الجيب"],["\\tan x = \\frac{-12/13}{5/13} = -\\frac{12}{5}","<span class=\"tx\" data-t=\"\\tan x = \\frac{y}{x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin x = -\\frac{12}{13},\\ \\cos x = \\frac{5}{13},\\ \\tan x = -\\frac{12}{5}\"></span>","o":""},{"n":"8","s":[["\\cos x = -1,\\quad \\sin x = 0","إحداثيا النقطة"],["\\tan x = \\frac{0}{-1} = 0","<span class=\"tx\" data-t=\"\\tan x = \\frac{y}{x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin x = 0,\\ \\cos x = -1,\\ \\tan x = 0\"></span>","o":""},{"n":"9","s":[["\\cos x = -\\frac{1}{\\sqrt{2}},\\quad \\sin x = -\\frac{1}{\\sqrt{2}}","إحداثيا النقطة"],["\\tan x = \\frac{-1/\\sqrt{2}}{-1/\\sqrt{2}} = 1","<span class=\"tx\" data-t=\"\\tan x = \\frac{y}{x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin x = -\\frac{1}{\\sqrt{2}} = -\\frac{\\sqrt{2}}{2},\\ \\cos x = -\\frac{\\sqrt{2}}{2},\\ \\tan x = 1\"></span>","o":""},{"n":"10","s":[["\\cos x = 0,\\quad \\sin x = 1","إحداثيا النقطة"],["\\tan x = \\frac{1}{0}","القسمة على صفر"]],"a":"<span class=\"tx\" data-t=\"\\sin x = 1,\\ \\cos x = 0\"></span>، و <span class=\"tx\" data-t=\"\\tan x\"></span> غير معرّف","o":""},{"n":"11","s":[["\\cos x = -0.96,\\quad \\sin x = 0.28","إحداثيا النقطة"],["\\tan x = \\frac{0.28}{-0.96} = -\\frac{7}{24} \\approx -0.2917","<span class=\"tx\" data-t=\"\\tan x = \\frac{y}{x}\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\sin x = 0.28,\\ \\cos x = -0.96,\\ \\tan x = -\\frac{7}{24}\"></span>","o":""}],[{"n":"14","s":[["\\cos^2 x = 1 - \\left(-\\frac{1}{2}\\right)^2 = \\frac{3}{4}","المتطابقة <span class=\"tx\" data-t=\"\\sin^2 x + \\cos^2 x = 1\"></span>"],["\\cos x = \\frac{\\sqrt{3}}{2}","موجب لأن <span class=\"tx\" data-t=\"x\"></span> في الربع الرابع"],["\\tan x = \\frac{-1/2}{\\sqrt{3}/2} = -\\frac{1}{\\sqrt{3}} = -\\frac{\\sqrt{3}}{3}","تعريف الظل"]],"a":"<span class=\"tx\" data-t=\"\\cos x = \\frac{\\sqrt{3}}{2},\\ \\tan x = -\\frac{\\sqrt{3}}{3}\"></span>","o":"الزاوية هي <span class=\"tx\" data-t=\"x = 330^\\circ\"></span>"},{"n":"15","s":[["\\sin^2 x = 1 - 0.4^2 = 0.84","المتطابقة <span class=\"tx\" data-t=\"\\sin^2 x + \\cos^2 x = 1\"></span>"],["\\sin x = \\pm\\sqrt{0.84} \\approx \\pm 0.9165","جيب التمام موجب، إذن <span class=\"tx\" data-t=\"x\"></span> في الربع الأول أو الرابع"],["\\tan x = \\frac{\\pm 0.9165}{0.4} \\approx \\pm 2.2913","تعريف الظل"]],"a":"في الربع الأول: <span class=\"tx\" data-t=\"\\sin x \\approx 0.9165,\\ \\tan x \\approx 2.2913\"></span> ؛ في الربع الرابع: <span class=\"tx\" data-t=\"\\sin x \\approx -0.9165,\\ \\tan x \\approx -2.2913\"></span>","o":"القيمة الدقيقة <span class=\"tx\" data-t=\"\\sqrt{0.84} = \\frac{\\sqrt{21}}{5}\"></span>"},{"n":"16","s":[["180^\\circ \\le x \\le 360^\\circ,\\ \\tan x > 0","الظل موجب في الربعين الأول والثالث، إذن <span class=\"tx\" data-t=\"x\"></span> في الربع الثالث"],["r = \\sqrt{3^2 + 1^2} = \\sqrt{10}","الوتر <span class=\"tx\" data-t=\"r\"></span>: نرسم مثلثًا مرجعيًا مقابله <span class=m dir=ltr>3</span> ومجاوره <span class=m dir=ltr>1</span>، نظرية فيثاغورس"],["\\sin x = -\\frac{3}{\\sqrt{10}} \\approx -0.9487,\\quad \\cos x = -\\frac{1}{\\sqrt{10}} \\approx -0.3162","الجيب وجيب التمام سالبان في الربع الثالث"]],"a":"<span class=\"tx\" data-t=\"\\sin x = -\\frac{3}{\\sqrt{10}},\\ \\cos x = -\\frac{1}{\\sqrt{10}}\"></span>","o":""},{"n":"17","s":[["\\frac{\\sin x}{\\cos x} = -1 \\Rightarrow \\tan x = -1","بقسمة الطرفين على <span class=\"tx\" data-t=\"\\cos x\"></span> (<span class=\"tx\" data-t=\"\\cos x \\ne 0\"></span>)"],["x = 135^\\circ,\\ 315^\\circ","الظل سالب في الربعين الثاني والرابع، والزاوية المرجعية <span class=\"tx\" data-t=\"45^\\circ\"></span>"],["x = 135^\\circ:\\ \\sin x = \\frac{\\sqrt{2}}{2},\\ \\cos x = -\\frac{\\sqrt{2}}{2}","الربع الثاني"],["x = 315^\\circ:\\ \\sin x = -\\frac{\\sqrt{2}}{2},\\ \\cos x = \\frac{\\sqrt{2}}{2}","الربع الرابع"]],"a":