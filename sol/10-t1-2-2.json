[[{"n":"1","s":[["\\frac{72^\\circ}{360^\\circ} = \\frac{1}{5}","الكسر <span class=m dir=ltr>=</span> زاوية القطاع <span class=m dir=ltr>÷ 360</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}\"></span> الدائرة","o":""},{"n":"2","s":[["l = \\frac{\\theta}{360^\\circ} \\times 2\\pi r","قانون طول القوس"],["= \\frac{1}{5} \\times 2\\pi \\times 8.4 = 3.36\\pi","بالتعويض"],["\\approx 10.6","باستعمال الآلة الحاسبة"]],"a":"طول القوس <span class=\"tx\" data-t=\"\\approx 10.6\"></span> وحدة","o":""},{"n":"3","s":[["A = \\frac{\\theta}{360^\\circ} \\times \\pi r^2","قانون مساحة القطاع"],["= \\frac{1}{5} \\times \\pi \\times 8.4^2 = 14.112\\pi","بالتعويض"],["\\approx 44.3","باستعمال الآلة الحاسبة"]],"a":"مساحة القطاع <span class=\"tx\" data-t=\"\\approx 44.3\"></span> وحدة مربعة","o":""}],[{"n":"4","s":[["r = 10,\\ \\theta = 180^\\circ","نصف دائرة قطرها <span class=m dir=ltr>20</span>"],["l = \\frac{1}{2} \\times 2\\pi(10) = 10\\pi","طول القوس"],["A = \\frac{1}{2} \\times \\pi(10)^2 = 50\\pi","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"10\\pi\"></span>، والمساحة <span class=\"tx\" data-t=\"50\\pi\"></span>","o":""},{"n":"5","s":[["r = 10,\\ \\theta = 90^\\circ","ربع دائرة"],["l = \\frac{1}{4} \\times 2\\pi(10) = 5\\pi","طول القوس"],["A = \\frac{1}{4} \\times \\pi(10)^2 = 25\\pi","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"5\\pi\"></span>، والمساحة <span class=\"tx\" data-t=\"25\\pi\"></span>","o":""},{"n":"6","s":[["\\frac{45^\\circ}{360^\\circ} = \\frac{1}{8}","كسر القطاع"],["l = \\frac{1}{8} \\times 2\\pi(10) = \\frac{5}{2}\\pi","طول القوس"],["A = \\frac{1}{8} \\times \\pi(10)^2 = \\frac{25}{2}\\pi","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"2.5\\pi\"></span>، والمساحة <span class=\"tx\" data-t=\"12.5\\pi\"></span>","o":""},{"n":"7","s":[["\\frac{135^\\circ}{360^\\circ} = \\frac{3}{8}","كسر القطاع"],["l = \\frac{3}{8} \\times 2\\pi(7) = \\frac{21}{4}\\pi","طول القوس"],["A = \\frac{3}{8} \\times \\pi(7)^2 = \\frac{147}{8}\\pi","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"\\frac{21}{4}\\pi = 5.25\\pi\"></span>، والمساحة <span class=\"tx\" data-t=\"\\frac{147}{8}\\pi = 18.375\\pi\"></span>","o":""}],[{"n":"8","s":[["r = \\frac{25}{2} = 12.5","نصف القطر"],["A = \\frac{1}{2}\\pi(12.5)^2 = 78.125\\pi \\approx 245.4","مساحة نصف الدائرة"],["P = \\frac{1}{2} \\times 2\\pi(12.5) + 25","نصف المحيط <span class=m dir=ltr>+</span> القطر"],["P = 12.5\\pi + 25 \\approx 64.3",""]],"a":"المساحة <span class=\"tx\" data-t=\"78.125\\pi \\approx 245.4\"></span> وحدة مربعة، والمحيط <span class=\"tx\" data-t=\"12.5\\pi + 25 \\approx 64.3\"></span> وحدة","o":""}],[{"n":"9","s":[["r = \\frac{40}{2} = 20","القطر <span class=m dir=ltr>40</span>"],["\\theta = 360^\\circ - 70^\\circ = 290^\\circ","زاوية الجزء المظلّل"],["A = \\frac{290^\\circ}{360^\\circ} \\times \\pi(20)^2","قانون مساحة القطاع"],["A = \\frac{2900}{9}\\pi \\approx 322.2\\pi","بالتبسيط"]],"a":"مساحة الجزء المظلّل <span class=\"tx\" data-t=\"\\frac{2900}{9}\\pi\"></span> وحدة مربعة (تقريبًا <span class=\"tx\" data-t=\"1012.3\"></span>)","o":""}],[{"n":"10","s":[["r = 12,\\ \\theta = 45^\\circ","نصف قطر الفطيرة وزاوية القطعة"],["A = \\frac{45^\\circ}{360^\\circ} \\times \\pi(12)^2","قانون مساحة القطاع"],["A = \\frac{1}{8} \\times 144\\pi = 18\\pi \\approx 56.5",""]],"a":"مساحة القطعة <span class=\"tx\" data-t=\"18\\pi \\approx 56.5\\ \\text{cm}^2\"></span>","o":"مسألة اليوم: فطيرة قطرها <span class=m dir=ltr>24 cm</span>، والزاوية بين الشقّين <span class=m dir=ltr>45°</span>."}],[{"n":"11","s":[["\\frac{1}{2} \\times 2\\pi(10) = 10\\pi","نصف الدائرة الكبيرة (قطرها <span class=m dir=ltr>20)</span>"],["2 \\times \\frac{1}{2} \\times 2\\pi(5) = 10\\pi","نصفا الدائرتين الصغيرتين (قطر كل منهما <span class=m dir=ltr>10)</span>"],["P = 10\\pi + 10\\pi = 20\\pi","بالجمع"]],"a":"محيط الشكل <span class=\"tx\" data-t=\"20\\pi\"></span> وحدة","o":""},{"n":"12","s":[["\\frac{1}{2}\\pi(10)^2 = 50\\pi","مساحة نصف الدائرة الكبيرة"],["2 \\times \\frac{1}{2}\\pi(5)^2 = 25\\pi","مساحة نصفي الدائرتين الصغيرتين"],["A = 50\\pi + 25\\pi = 75\\pi","بالجمع"]],"a":"مساحة الشكل <span class=\"tx\" data-t=\"75\\pi\"></span> وحدة مربعة","o":""}],[{"n":"13","s":[["\\theta = 360^\\circ - 160^\\circ = 200^\\circ","زاوية القوس الأكبر <span class=\"tx\" data-t=\"ACB\"></span>"],["l = \\frac{200^\\circ}{360^\\circ} \\times 2\\pi(12.5)","قانون طول القوس"],["l = \\frac{125}{9}\\pi \\approx 43.6",""]],"a":"طول القوس <span class=\"tx\" data-t=\"ACB = \\frac{125}{9}\\pi \\approx 43.6\"></span> وحدة طول","o":""}],[{"n":"14","s":[["\\frac{1}{4}\\pi(12)^2 = 36\\pi","مساحة ربع الدائرة"],["\\frac{1}{2} \\times 12 \\times 12 = 72","مساحة المثلث القائم"],["A = 36\\pi - 72 \\approx 41.1","مساحة ربع الدائرة <span class=m dir=ltr>−</span> مساحة المثلث"]],"a":"مساحة الجزء المظلّل <span class=\"tx\" data-t=\"36\\pi - 72\"></span> وحدة مربعة","o":""}],[{"n":"15","s":[["\\frac{1}{4}\\pi(8)^2 = 16\\pi","مساحة ربع الدائرة التي مركزها <span class=\"tx\" data-t=\"D\"></span>"],["\\frac{1}{2}(8)(8) = 32","مساحة المثلث <span class=\"tx\" data-t=\"ADC\"></span>"],["16\\pi - 32","مساحة القطعة الدائرية <span class=\"tx\" data-t=\"APC\"></span> (نصف الجزء المظلّل)"],["A = 2(16\\pi - 32) = 32\\pi - 64","الجزء المظلّل قطعتان متطابقتان"]],"a":"مساحة الجزء المظلّل <span class=\"tx\" data-t=\"32\\pi - 64\\ \\text{cm}^2\"></span> (تقريبًا <span class=\"tx\" data-t=\"36.5\\ \\text{cm}^2\"></span>)","o":""}],[{"n":"16","s":[["\\frac{\\theta}{360^\\circ} \\times \\pi(15)^2 = 100","قانون مساحة القطاع"],["\\theta = \\frac{100 \\times 360^\\circ}{225\\pi}","بحلّ المعادلة"],["\\theta = \\frac{160}{\\pi} \\approx 50.9^\\circ","باستعمال الآلة الحاسبة"]],"a":"زاوية دوران المرشّ <span class=\"tx\" data-t=\"\\approx 50.9^\\circ\"></span>","o":""}],[{"n":"17","s":[["R = 66,\\ r = 66 - 40 = 26","نصفا قطري الدائرتين الكبرى والصغرى"],["A = \\frac{130^\\circ}{360^\\circ}\\pi(66^2) - \\frac{130^\\circ}{360^\\circ}\\pi(26^2)","مساحة القطاع الكبير <span class=m dir=ltr>−</span> مساحة القطاع الصغير"],["A = \\frac{13}{36}\\pi(4356 - 676) = \\frac{11960}{9}\\pi","بالتبسيط"],["A \\approx 4174.8","باستعمال الآلة الحاسبة"]],"a":"المساحة التي تنظّفها الماسحة <span class=\"tx\" data-t=\"\\approx 4174.8\\ \\text{cm}^2\"></span>","o":""}],[{"n":"18","s":[["R = 1 + 3 = 4","نصف قطر القطاع الكبير"],["\\frac{30^\\circ}{360^\\circ} \\times 2\\pi(4) = \\frac{2}{3}\\pi","طول القوس الكبير"],["\\frac{330^\\circ}{360^\\circ} \\times 2\\pi(1) = \\frac{11}{6}\\pi","طول قوس الدائرة الصغيرة"],["P = 3 + 3 + \\frac{2}{3}\\pi + \\frac{11}{6}\\pi = 6 + \\frac{5}{2}\\pi \\approx 13.85","المحيط"],["A = \\frac{30^\\circ}{360^\\circ}\\pi(4^2) + \\pi(1^2) - \\frac{30^\\circ}{360^\\circ}\\pi(1^2)","القطاع الكبير <span class=m dir=ltr>+</span> الدائرة <span class=m dir=ltr>−</span> الجزء المشترك"],["A = \\frac{4}{3}\\pi + \\pi - \\frac{1}{12}\\pi = \\frac{9}{4}\\pi \\approx 7.07",""]],"a":"المحيط <span class=\"tx\" data-t=\"6 + 2.5\\pi \\approx 13.85\\ \\text{cm}\"></span>، والمساحة <span class=\"tx\" data-t=\"\\frac{9}{4}\\pi \\approx 7.07\\ \\text{cm}^2\"></span>","o":""}],[{"n":"19","s":[["r = 18,\\ A = \\frac{180}{2} = 90","مساحة القطعة الواحدة"],["\\frac{\\theta}{360^\\circ} \\times \\pi(18)^2 = 90","قانون مساحة القطاع"],["\\theta = \\frac{90 \\times 360^\\circ}{324\\pi} = \\frac{100}{\\pi}","بحلّ المعادلة"],["\\theta \\approx 31.8^\\circ \\approx 32^\\circ","بالتقريب إلى أقرب عدد كلي"]],"a":"زاوية القطعة الواحدة <span class=\"tx\" data-t=\"\\approx 32^\\circ\"></span>","o":""}],[{"n":"20","s":[["A_{\\triangle} = \\frac{\\sqrt{3}}{4}(6)^2 = 9\\sqrt{3}","مساحة المثلث المتطابق الأضلاع"],["AP = 3,\\ m\\angle A = 60^\\circ","نصف قطر القطاع وزاويته"],["A_{\\text{sector}} = \\frac{60^\\circ}{360^\\circ}\\pi(3)^2 = \\frac{3}{2}\\pi","مساحة القطاع"],["A = 9\\sqrt{3} - \\frac{3}{2}\\pi \\approx 10.88","مساحة المثلث <span class=m dir=ltr>−</span> مساحة القطاع"]],"a":"مساحة الجزء المظلّل <span class=\"tx\" data-t=\"9\\sqrt{3} - \\frac{3}{2}\\pi \\approx 10.9\\ \\text{cm}^2\"></span>","o":""}],[{"n":"4","s":[["\\ell=\\frac{\\theta}{360^\\circ}\\times 2\\pi r","طول القوس"],["=\\frac{45}{360}\\times 2\\pi(3)=\\frac{1}{8}\\times 6\\pi=\\frac{3\\pi}{4}","بالتعويض"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"\\frac{3\\pi}{4}\"></span>","o":""}],[{"n":"8","s":[["A_{ABCD}=\\frac{43}{360}\\pi(3x)^2-\\frac{43}{360}\\pi(2x)^2","مساحة القطاع الأكبر <span class=m dir=ltr>−</span> مساحة القطاع الأصغر"],["=\\frac{43}{360}\\pi(5x^2)=30","بالتبسيط والتعويض"],["x^2=\\frac{30\\times360}{43\\times5\\pi}=\\frac{10800}{215\\pi}\\approx15.99",""],["x\\approx 4.00","بأخذ الجذر الموجب"]],"a":"<span class=\"tx\" data-t=\"x\\approx 4\\ \\text{cm}\"></span>","o":""},{"n":"9","s":[["\\ell_{CD}-\\ell_{AB}=\\frac{43}{360}\\times2\\pi(3x)-\\frac{43}{360}\\times2\\pi(2x)","طول القوس"],["=\\frac{43}{360}\\times2\\pi x=\\frac{43\\pi x}{180}","بالتبسيط"],["\\approx\\frac{43\\pi(3.9987)}{180}\\approx 3.00","بالتعويض"]],"a":"الفرق <span class=\"tx\" data-t=\"\\approx 3\\ \\text{cm}\"></span>","o":""}],[{"n":"10","s":[["\\theta=360^\\circ-90^\\circ=270^\\circ,\\ r=11","زاوية القطاع"],["A=\\frac{270}{360}\\pi(11)^2=\\frac{363\\pi}{4}\\approx285.10","مساحة القطاع"],["\\ell=\\frac{270}{360}\\times2\\pi(11)=16.5\\pi\\approx51.84","طول القوس"],["P=\\ell+2r=16.5\\pi+22\\approx73.84","المحيط <span class=m dir=ltr>=</span> طول القوس <span class=m dir=ltr>+</span> نصفا القطر"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{363\\pi}{4}\\approx 285.10\"></span> وحدة مربّعة، المحيط <span class=\"tx\" data-t=\"16.5\\pi+22\\approx 73.84\"></span> وحدة","o":""},{"n":"11","s":[["\\theta=360^\\circ-50^\\circ=310^\\circ,\\ r=8","زاوية القطاع"],["A=\\frac{310}{360}\\pi(8)^2=\\frac{496\\pi}{9}\\approx173.14","مساحة القطاع"],["\\ell=\\frac{310}{360}\\times2\\pi(8)=\\frac{124\\pi}{9}\\approx43.28","طول القوس"],["P=\\frac{124\\pi}{9}+16\\approx59.28","المحيط <span class=m dir=ltr>=</span> طول القوس <span class=m dir=ltr>+</span> نصفا القطر"]],"a":"المساحة <span class=\"tx\" data-t=\"\\frac{496\\pi}{9}\\approx 173.14\"></span> وحدة مربّعة، المحيط <span class=\"tx\" data-t=\"\\approx 59.28\"></span> وحدة","o":""}],[{"n":"15","s":[["\\frac{a}{360}\\pi(3)^2=9\\Rightarrow\\frac{a}{360}=\\frac{1}{\\pi}","مساحة القطاع في الدائرة الكبرى"],["\\frac{a}{360}\\pi(2)^2=\\frac{1}{\\pi}\\times4\\pi=4","مساحة القطاع في الدائرة الصغرى (الزاوية نفسها)"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"4\"></span>","o":""}],[{"n":"16","s":[["r_1=\\frac{73}{2}=36.5\\ \\text{m}","نصف قطر نصف الدائرة للحدّ الداخلي للمسرب الأول"],["r_3=36.5+1+1=38.5\\ \\text{m}","الحدّ الداخلي للمسرب الثالث يبعد مسربين <span class=m dir=ltr>(2 m)</span>"],["L_1=2(120)+2\\pi(36.5),\\quad L_3=2(120)+2\\pi(38.5)","الجزآن المستقيمان <span class=m dir=ltr>+</span> نصفا دائرة (دائرة كاملة)"],["L_3-L_1=2\\pi(38.5-36.5)=4\\pi\\approx12.57\\ \\text{m}","الجزآن المستقيمان متساويان"]],"a":"يزيد بمقدار <span class=\"tx\" data-t=\"4\\pi\\approx 12.57\\ \\text{m}\"></span>","o":""}],[{"n":"1","s":[["\\ell=\\frac{120}{360}\\times2\\pi(21)=14\\pi\\approx43.98\\ \\text{cm}","طول القوس"],["A=\\frac{120}{360}\\pi(21)^2=147\\pi\\approx461.81\\ \\text{cm}^2","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"14\\pi\\approx 43.98\\ \\text{cm}\"></span>، المساحة <span class=\"tx\" data-t=\"147\\pi\\approx 461.81\\ \\text{cm}^2\"></span>","o":""},{"n":"2","s":[["r=\\frac{14}{2}=7","نصف القطر"],["\\ell=\\frac{135}{360}\\times2\\pi(7)=5.25\\pi\\approx16.49\\ \\text{cm}","طول القوس"],["A=\\frac{135}{360}\\pi(7)^2=18.375\\pi\\approx57.73\\ \\text{cm}^2","مساحة القطاع"]],"a":"طول القوس <span class=\"tx\" data-t=\"\\approx 16.49\\ \\text{cm}\"></span>، المساحة <span class=\"tx\" data-t=\"\\approx 57.73\\ \\text{cm}^2\"></span>","o":""}],[{"n":"3","s":[["\\frac{72}{360}\\pi r^2=35","مساحة القطاع"],["\\frac{1}{5}\\pi r^2=35\\Rightarrow r^2=\\frac{175}{\\pi}",""],["r=\\sqrt{\\frac{175}{\\pi}}\\approx7.46",""]],"a":"<span class=\"tx\" data-t=\"r\\approx 7.46\\ \\text{cm}\"></span>","o":""},{"n":"4","s":[["\\frac{45}{360}\\pi r^2=60\\Rightarrow\\frac{1}{8}\\pi r^2=60","مساحة القطاع"],["r^2=\\frac{480}{\\pi}\\Rightarrow r\\approx12.36",""],["d=2r\\approx24.72","القطر ضعف نصف القطر"]],"a":"طول القطر <span class=\"tx\" data-t=\"\\approx 24.72\\ \\text{cm}\"></span>","o":""}],[{"n":"5","s":[["\\theta=360^\\circ-115^\\circ=245^\\circ,\\ r=20","زاوية القطاع المرسوم"],["\\ell=\\frac{245}{360}\\times2\\pi(20)\\approx85.52","طول القوس"],["P=\\ell+2r\\approx85.52+40=125.52","المحيط <span class=m dir=ltr>=</span> القوس <span class=m dir=ltr>+</span> نصفا القطر"]],"a":"المحيط <span class=\"tx\" data-t=\"\\approx 125.52\\ \\text{cm}\"></span>","o":""},{"n":"6","s":[["\\theta=360^\\circ-80^\\circ=280^\\circ,\\ r=14","زاوية القطاع المرسوم"],["\\ell=\\frac{280}{360}\\times2\\pi(14)\\approx68.42","طول القوس"],["P=\\ell+2r\\approx68.42+28=96.42","المحيط <span class=m dir=ltr>=</span> القوس <span class=m dir=ltr>+</span> نصفا القطر"]],"a":"المحيط <span class=\"tx\" data-t=\"\\approx 96.42\\ \\text{cm}\"></span>","o":""}],[{"n":"7","s":[["\\frac{\\theta}{360}\\pi(15)^2=200","مساحة القطاع"],["\\theta=\\frac{200\\times360}{225\\pi}=\\frac{320}{\\pi}","بحلّ المعادلة"],["\\theta\\approx101.9^\\circ",""]],"a":"<span class=\"tx\" data-t=\"\\theta\\approx 101.9^\\circ\"></span>","o":""}],[{"n":"8","s":[["A=\\frac{135}{360}\\pi(11)^2-\\frac{135}{360}\\pi(6)^2","مساحة القطاع الكبير <span class=m dir=ltr>−</span> مساحة القطاع الصغير"],["=\\frac{3}{8}\\pi(121-36)=\\frac{3}{8}(85)\\pi=31.875\\pi","بالتبسيط"],["\\approx100.14\\ \\text{cm}^2",""]],"a":"مساحة المنطقة المظلّلة <span class=\"tx\" data-t=\"31.875\\pi\\approx 100.14\\ \\text{cm}^2\"></span>","o":""}],[{"n":"3","s":[["A_s=\\pi(12.5)^2=156.25\\pi\\approx490.87\\ \\text{cm}^2","مساحة الصغيرة"],["A_L=\\pi(20)^2=400\\pi\\approx1256.64\\ \\text{cm}^2","مساحة الكبيرة"],["\\frac{5}{490.87}\\approx0.0102\\ \\text{JD/cm}^2","سعر السنتيمتر المربّع من الصغيرة"],["\\frac{8}{1256.64}\\approx0.0064\\ \\text{JD/cm}^2","سعر السنتيمتر المربّع من الكبيرة"]],"a":"عرض الفطيرة الكبيرة أفضل؛ لأنّ سعر السنتيمتر المربّع فيها أقل","o":""},{"n":"4","s":[["A=\\frac{144}{360}\\pi(20)^2","مساحة القطاع، <span class=\"tx\" data-t=\"r=\\frac{40}{2}=20\"></span>"],["=0.4\\times400\\pi=160\\pi\\approx502.65\\ \\text{cm}^2",""]],"a":"مساحة الجزء <span class=\"tx\" data-t=\"160\\pi\\approx 502.65\\ \\text{cm}^2\"></span>","o":""}]]