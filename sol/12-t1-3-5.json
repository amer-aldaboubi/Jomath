[[{"n":"1","s":[["\\frac{dx}{dt}=2,\\ \\frac{dy}{dt}=-3,\\ x=20,\\ y=50","<span class=m dir=ltr>x</span> الضلع المتزايد، <span class=m dir=ltr>y</span> الضلع المتناقص"],["A=xy\\Rightarrow\\frac{dA}{dt}=y\\frac{dx}{dt}+x\\frac{dy}{dt}","مشتقة الضرب"],["\\frac{dA}{dt}=50(2)+20(-3)=40",""]],"a":"<span class=\"tx\" data-t=\"40\\ \\text{cm}^2/\\text{s}\"></span>","o":""},{"n":"2","s":[["P=2x+2y\\Rightarrow\\frac{dP}{dt}=2\\frac{dx}{dt}+2\\frac{dy}{dt}",""],["\\frac{dP}{dt}=2(2)+2(-3)=-2",""]],"a":"<span class=\"tx\" data-t=\"-2\\ \\text{cm/s}\"></span> (يتناقص المحيط)","o":""},{"n":"3","s":[["D^2=x^2+y^2,\\ D=\\sqrt{2900}=10\\sqrt{29}","نظرية فيثاغورس"],["2D\\frac{dD}{dt}=2x\\frac{dx}{dt}+2y\\frac{dy}{dt}",""],["\\frac{dD}{dt}=\\frac{20(2)+50(-3)}{10\\sqrt{29}}=\\frac{-11}{\\sqrt{29}}\\approx-2.04",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dD}{dt}=-\\frac{11}{\\sqrt{29}}\\approx-2.04\\ \\text{cm/s}\"></span>","o":""},{"n":"4","s":[["\\frac{dx}{dt}>0,\\ \\frac{dA}{dt}>0","كميات متزايدة"],["\\frac{dy}{dt}<0,\\ \\frac{dP}{dt}<0,\\ \\frac{dD}{dt}<0","كميات متناقصة"]],"a":"المتزايدة: طول الضلع الأول والمساحة (معدَّلاهما موجبان). المتناقصة: طول الضلع الثاني والمحيط والقطر (معدَّلاتها سالبة)","o":""}],[{"n":"5","s":[["x=10+6t\\Rightarrow x(4)=34","طول الضلع بعد <span class=m dir=ltr>4 s</span>"],["V=x^3\\Rightarrow\\frac{dV}{dt}=3x^2\\frac{dx}{dt}",""],["\\frac{dV}{dt}=3(34)^2(6)=20808",""]],"a":"<span class=\"tx\" data-t=\"20808\\ \\text{cm}^3/\\text{s}\"></span>","o":""},{"n":"6","s":[["x(6)=10+36=46",""],["S=6x^2\\Rightarrow\\frac{dS}{dt}=12x\\frac{dx}{dt}",""],["\\frac{dS}{dt}=12(46)(6)=3312",""]],"a":"<span class=\"tx\" data-t=\"3312\\ \\text{cm}^2/\\text{s}\"></span>","o":""}],[{"n":"7","s":[["r=1\\ \\text{m},\\ \\frac{dV}{dt}=500\\ \\text{L/min}=0.5\\ \\text{m}^3/\\text{min}","<span class=m dir=ltr>1 m³ = 1000 L</span>"],["V=\\pi r^2h=\\pi h\\Rightarrow\\frac{dV}{dt}=\\pi\\frac{dh}{dt}",""],["\\frac{dh}{dt}=\\frac{0.5}{\\pi}\\approx0.159",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dh}{dt}=\\frac{1}{2\\pi}\\approx0.159\\ \\text{m/min}\"></span> (ثابت عند أي لحظة)","o":""},{"n":"8","s":[["L=2\\pi rh=2\\pi h","المساحة الجانبية للوقود"],["\\frac{dL}{dt}=2\\pi\\frac{dh}{dt}=2\\pi\\cdot\\frac{0.5}{\\pi}=1",""]],"a":"<span class=\"tx\" data-t=\"1\\ \\text{m}^2/\\text{min}\"></span>","o":""}],[{"n":"9","s":[["h=\\frac38(2r)=\\frac34r\\Rightarrow r=\\frac43h",""],["V=\\frac13\\pi r^2h=\\frac{16\\pi}{27}h^3","بالتعويض عن <span class=m dir=ltr>r</span>"],["\\frac{dV}{dt}=\\frac{16\\pi}{9}h^2\\frac{dh}{dt}",""],["10=\\frac{16\\pi}{9}(16)\\frac{dh}{dt}\\Rightarrow\\frac{dh}{dt}=\\frac{45}{128\\pi}\\approx0.112","عند <span class=m dir=ltr>h = 4</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dh}{dt}=\\frac{45}{128\\pi}\\approx0.112\\ \\text{m/min}\"></span>","o":""},{"n":"10","s":[["\\frac{dr}{dt}=\\frac43\\frac{dh}{dt}",""],["\\frac{dr}{dt}=\\frac43\\cdot\\frac{45}{128\\pi}=\\frac{15}{32\\pi}\\approx0.149",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dr}{dt}=\\frac{15}{32\\pi}\\approx0.149\\ \\text{m/min}\"></span>","o":""},{"n":"11","s":[["r=\\frac43(4)=\\frac{16}{3}",""],["A=\\pi r^2\\Rightarrow\\frac{dA}{dt}=2\\pi r\\frac{dr}{dt}",""],["\\frac{dA}{dt}=2\\pi\\cdot\\frac{16}{3}\\cdot\\frac{15}{32\\pi}=5",""]],"a":"<span class=\"tx\" data-t=\"5\\ \\text{m}^2/\\text{min}\"></span>","o":""}],[{"n":"12","s":[["s^2=x^2+y^2","نظرية فيثاغورس"],["s=\\sqrt{225^2+300^2}=375",""],["2s\\frac{ds}{dt}=2x\\frac{dx}{dt}+2y\\frac{dy}{dt}",""],["\\frac{ds}{dt}=\\frac{225(-450)+300(-600)}{375}=-750","المسافتان تتناقصان لأنّ الطائرتين تقتربان"]],"a":"<span class=\"tx\" data-t=\"\\frac{ds}{dt}=-750\\ \\text{km/h}\"></span> (تقل المسافة بينهما بمعدَّل <span class=m dir=ltr>750 km/h)</span>","o":""},{"n":"13","s":[["t_1=\\frac{225}{450}=0.5\\ \\text{h}","زمن وصول الطائرة الأولى إلى نقطة الالتقاء"],["t_2=\\frac{300}{600}=0.5\\ \\text{h}","زمن وصول الطائرة الثانية"],["s(t)=375-750t=0\\ \\text{at}\\ t=0.5",""]],"a":"نعم، يجب توجيه إحدى الطائرتين لمسار مختلف؛ لأنهما تصلان نقطة الالتقاء في اللحظة نفسها (بعد نصف ساعة) وعلى الارتفاع نفسه فستصطدمان","o":""}],[{"n":"14","s":[["a=15t,\\ b=20t;\\ t=2\\Rightarrow a=30,\\ b=40","المسافتان المقطوعتان بعد ساعتين"],["s^2=a^2+b^2-2ab\\cos\\frac{\\pi}{3}=a^2+b^2-ab","قانون جيوب التمام"],["s^2=900+1600-1200=1300\\Rightarrow s=10\\sqrt{13}",""],["2s\\frac{ds}{dt}=2a\\frac{da}{dt}+2b\\frac{db}{dt}-\\frac{da}{dt}b-a\\frac{db}{dt}",""],["\\frac{ds}{dt}=\\frac{900+1600-600-600}{20\\sqrt{13}}=\\frac{1300}{20\\sqrt{13}}=5\\sqrt{13}\\approx18.03",""]],"a":"<span class=\"tx\" data-t=\"5\\sqrt{13}\\approx18.03\\ \\text{km/h}\"></span>","o":""}],[{"n":"15","s":[["L^2=x^2+1","نظرية فيثاغورس: <span class=m dir=ltr>L</span> طول الحبل، <span class=m dir=ltr>x</span> بعد القارب عن الرصيف"],["x=8\\Rightarrow L=\\sqrt{65}",""],["2L\\frac{dL}{dt}=2x\\frac{dx}{dt}",""],["\\frac{dx}{dt}=\\frac{L}{x}\\frac{dL}{dt}=\\frac{\\sqrt{65}}{8}(-1)\\approx-1.008","الحبل يقصر بمعدَّل <span class=m dir=ltr>1 m/s</span>"]],"a":"يقترب القارب بسرعة <span class=\"tx\" data-t=\"\\frac{\\sqrt{65}}{8}\\approx1.008\\ \\text{m/s}\"></span>","o":""}],[{"n":"16","s":[["\\tan\\theta=\\frac{x}{132}","<span class=m dir=ltr>x</span> المسافة الأفقية بين السيارة وموقع أسفل الكاميرا"],["\\sec^2\\theta\\frac{d\\theta}{dt}=\\frac{1}{132}\\frac{dx}{dt}",""],["\\theta=0:\\ \\frac{d\\theta}{dt}=\\frac{264}{132}=2","<span class=m dir=ltr>sec 0 = 1</span>"]],"a":"<span class=\"tx\" data-t=\"2\\ \\text{rad/s}\"></span>","o":""},{"n":"17","s":[["x=264(0.5)=132\\Rightarrow\\tan\\theta=1\\Rightarrow\\theta=\\frac{\\pi}{4}",""],["\\frac{d\\theta}{dt}=\\frac{264}{132}\\cos^2\\theta=2\\left(\\frac{\\sqrt2}{2}\\right)^2=1",""]],"a":"<span class=\"tx\" data-t=\"1\\ \\text{rad/s}\"></span>","o":""}],[{"n":"18","s":[["\\frac{dy}{dt}=f'(x)\\frac{dx}{dt}=\\pi\\cos\\frac{\\pi x}{2}\\cdot\\frac{dx}{dt}","قاعدة السلسلة"],["\\frac{dy}{dt}=\\pi\\cos\\frac{\\pi}{6}\\cdot\\sqrt{10}=\\frac{\\sqrt3\\,\\pi\\sqrt{10}}{2}","عند <span class=m dir=ltr>x = 1/3</span>"],["D=\\sqrt{x^2+y^2}=\\sqrt{\\frac19+1}=\\frac{\\sqrt{10}}{3}",""],["\\frac{dD}{dt}=\\frac{x\\frac{dx}{dt}+y\\frac{dy}{dt}}{D}=\\frac{\\frac{\\sqrt{10}}{3}+\\frac{\\sqrt3\\pi\\sqrt{10}}{2}}{\\frac{\\sqrt{10}}{3}}",""],["\\frac{dD}{dt}=1+\\frac{3\\sqrt3\\,\\pi}{2}\\approx9.16",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dD}{dt}=1+\\frac{3\\sqrt{3}\\pi}{2}\\approx9.16\"></span> وحدة طول لكل ثانية","o":""}],[{"n":"19","s":[["x=30\\cos\\theta",""],["\\frac{d\\theta}{dt}=10\\times2\\pi=20\\pi\\ \\text{rad/s}","كل دورة <span class=m dir=ltr>= 2π</span>"],["\\frac{dx}{dt}=-30\\sin\\theta\\frac{d\\theta}{dt}=-600\\pi\\sin\\theta",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dx}{dt}=-600\\pi\\sin\\theta\\ \\text{cm/s}\"></span>","o":""},{"n":"20","s":[["\\frac{dx}{dt}=-600\\pi\\sin\\frac{\\pi}{4}=-300\\sqrt2\\,\\pi\\approx-1332.9",""]],"a":"<span class=\"tx\" data-t=\"-300\\sqrt{2}\\pi\\approx-1332.9\\ \\text{cm/s}\"></span>","o":""}],[{"n":"21","s":[["\\frac{h}{12}=\\frac{2}{x}\\Rightarrow h=\\frac{24}{x}","تشابه المثلثين: <span class=m dir=ltr>x</span> بعد الرجل عن المصباح، <span class=m dir=ltr>h</span> طول الظل"],["\\frac{dh}{dt}=-\\frac{24}{x^2}\\frac{dx}{dt}",""],["x=12-4=8",""],["\\frac{dh}{dt}=-\\frac{24}{64}(1.6)=-0.6",""]],"a":"يتناقص طول الظل بمعدَّل <span class=\"tx\" data-t=\"0.6\\ \\text{m/s}\"></span>","o":""}],[{"n":"22","s":[["\\sqrt{a^2+16}+\\sqrt{b^2+16}=12","<span class=m dir=ltr>a</span> بعد <span class=m dir=ltr>A</span> عن <span class=m dir=ltr>Q</span>، <span class=m dir=ltr>b</span> بعد <span class=m dir=ltr>B</span> عن <span class=m dir=ltr>Q</span>"],["a=3\\Rightarrow\\sqrt{25}=5\\Rightarrow\\sqrt{b^2+16}=7\\Rightarrow b=\\sqrt{33}",""],["\\frac{a\\frac{da}{dt}}{\\sqrt{a^2+16}}+\\frac{b\\frac{db}{dt}}{\\sqrt{b^2+16}}=0","باشتقاق الطرفين"],["\\frac{3(0.5)}{5}+\\frac{\\sqrt{33}}{7}\\frac{db}{dt}=0\\Rightarrow\\frac{db}{dt}=-\\frac{2.1}{\\sqrt{33}}\\approx-0.366",""]],"a":"تقترب العربة <span class=m dir=ltr>B</span> من <span class=m dir=ltr>Q</span> بسرعة <span class=\"tx\" data-t=\"\\frac{2.1}{\\sqrt{33}}\\approx0.366\\ \\text{m/s}\"></span>","o":"التبرير: طول الحبل ثابت، فما يزيده جزء الحبل نحو <span class=m dir=ltr>A</span> ينقصه جزء الحبل نحو <span class=m dir=ltr>B</span>؛ لذا يكون معدَّل تغيُّر <span class=m dir=ltr>b</span> سالبًا"}],[{"n":"23","s":[["s^2=100^2+200^2-2(100)(200)\\cos\\theta=50000-40000\\cos\\theta","قانون جيوب التمام، θ الزاوية عند المركز"],["\\frac{d\\theta}{dt}=\\frac{v}{r}=\\frac{7}{100}=0.07\\ \\text{rad/s}",""],["s=200\\Rightarrow\\cos\\theta=\\frac14\\Rightarrow\\sin\\theta=\\pm\\frac{\\sqrt{15}}{4}",""],["2s\\frac{ds}{dt}=40000\\sin\\theta\\frac{d\\theta}{dt}",""],["\\frac{ds}{dt}=\\frac{40000\\left(\\pm\\frac{\\sqrt{15}}{4}\\right)(0.07)}{400}=\\pm\\frac{7\\sqrt{15}}{4}\\approx\\pm6.78",""]],"a":"<span class=\"tx\" data-t=\"\\frac{ds}{dt}=\\frac{7\\sqrt{15}}{4}\\approx6.78\\ \\text{m/s}\"></span> (عندما يبتعد العدّاء) أو <span class=\"tx\" data-t=\"-\\frac{7\\sqrt{15}}{4}\\approx-6.78\\ \\text{m/s}\"></span> (عندما يقترب)","o":""}],[{"n":"8","s":[["\\frac{dV}{dt}=3x^2\\frac{dx}{dt}=24","<span class=m dir=ltr>V = x^3</span>"],["\\frac{dS}{dt}=12x\\frac{dx}{dt}=12","<span class=m dir=ltr>S = 6x^2</span>"],["\\frac{3x^2}{12x}=\\frac{24}{12}\\Rightarrow\\frac{x}{4}=2\\Rightarrow x=8","بقسمة المعادلتين"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"8\\ \\text{cm}\"></span>","o":""}],[{"n":"41","s":[["s^{2}=x^{2}+y^{2}","نظرية فيثاغورس، حيث <span class=m dir=ltr>x</span> المسافة الأفقية للدرّاجة و <span class=m dir=ltr>y</span> ارتفاع البالون"],["x=17(3)=51,\\quad y=65+1(3)=68","بعد <span class=m dir=ltr>3</span> ثوانٍ: <span class=m dir=ltr>dx/dt = 17</span> و <span class=m dir=ltr>dy/dt = 1</span>"],["s=\\sqrt{51^{2}+68^{2}}=\\sqrt{7225}=85","بالتعويض"],["2s\\frac{ds}{dt}=2x\\frac{dx}{dt}+2y\\frac{dy}{dt}","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>t</span>"],["85\\frac{ds}{dt}=51(17)+68(1)=935","بالتعويض والقسمة على <span class=m dir=ltr>2</span>"],["\\frac{ds}{dt}=\\frac{935}{85}=11","بقسمة الطرفين على <span class=m dir=ltr>85</span>"]],"a":"تتزايد المسافة بين البالون والدرّاجة بسرعة <span class=\"tx\" data-t=\"11\\ \\text{ft/s}\"></span>","o":""}],[{"n":"1","s":[["V=\\frac{4}{3}\\pi r^{3}\\Rightarrow\\frac{dV}{dt}=4\\pi r^{2}\\frac{dr}{dt}","حجم الكرة واشتقاقه بالنسبة إلى <span class=m dir=ltr>t</span>"],["8=4\\pi(12)^{2}\\frac{dr}{dt}","بالتعويض <span class=m dir=ltr>r = 12, dV/dt = 8</span>"],["\\frac{dr}{dt}=\\frac{8}{576\\pi}=\\frac{1}{72\\pi}\\approx 0.0044","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dr}{dt}=\\frac{1}{72\\pi}\\approx 0.0044\\ \\text{cm/s}\"></span>","o":""},{"n":"2","s":[["\\frac{4}{3}\\pi r^{3}=36\\pi\\Rightarrow r^{3}=27\\Rightarrow r=3","نصف القطر عندما <span class=m dir=ltr>V = 36π</span>"],["8=4\\pi(3)^{2}\\frac{dr}{dt}","بالتعويض"],["\\frac{dr}{dt}=\\frac{8}{36\\pi}=\\frac{2}{9\\pi}\\approx 0.07","بالقسمة والتقريب لأقرب جزء من مئة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dr}{dt}=\\frac{2}{9\\pi}\\approx 0.07\\ \\text{cm/s}\"></span>","o":""},{"n":"3","s":[["V=8(33.5)=268","الحجم بعد <span class=m dir=ltr>33.5 s (</span>بدءًا من بالون فارغ)"],["\\frac{4}{3}\\pi r^{3}=268\\Rightarrow r^{3}=\\frac{201}{\\pi}\\approx 64\\Rightarrow r\\approx 4","بحل المعادلة"],["8=4\\pi(4)^{2}\\frac{dr}{dt}\\Rightarrow\\frac{dr}{dt}=\\frac{1}{8\\pi}\\approx 0.04","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{dr}{dt}\\approx\\frac{1}{8\\pi}\\approx 0.04\\ \\text{cm/s}\"></span>","o":""}],[{"n":"4","s":[["A=\\frac{1}{2}\\times\\text{base}\\times h","مساحة المثلث"],["h=s\\sin\\theta","الارتفاع على أحد الضلعين المتطابقين (من تعريف الجيب في المثلث القائم)"],["A=\\frac{1}{2}\\cdot s\\cdot s\\sin\\theta=\\frac{1}{2}s^{2}\\sin\\theta","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"A=\\frac{1}{2}s^{2}\\sin\\theta\"></span> وهو المطلوب","o":""},{"n":"5","s":[["\\frac{dA}{dt}=\\frac{1}{2}s^{2}\\cos\\theta\\frac{d\\theta}{dt}","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>t (s</span> ثابت)"],["\\frac{dA}{dt}=\\frac{1}{2}s^{2}\\cdot\\frac{\\sqrt{3}}{2}\\cdot\\frac{1}{2}","بالتعويض θ <span class=m dir=ltr>= π/6, d</span>θ<span class=m dir=ltr>/dt = 1/2</span>"],["\\frac{dA}{dt}=\\frac{\\sqrt{3}}{8}s^{2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dA}{dt}=\\frac{\\sqrt{3}}{8}s^{2}\"></span> وحدة مربعة لكل دقيقة","o":""}],[{"n":"6","s":[["y=\\frac{10}{1+x^{2}}\\Rightarrow\\frac{dy}{dt}=\\frac{-20x}{(1+x^{2})^{2}}\\cdot\\frac{dx}{dt}","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>t (</span>قاعدة السلسلة)"],["\\frac{dy}{dt}=\\frac{-20(20)}{(401)^{2}}(3)=-\\frac{1200}{160801}","بالتعويض <span class=m dir=ltr>x = 20, dx/dt = 3</span>"],["\\frac{dy}{dt}\\approx -0.0075","بالتقريب"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dt}=-\\frac{1200}{160801}\\approx -0.0075\\ \\text{cm/s}\"></span>","o":""}],[{"n":"7","s":[["s^{2}=x^{2}+6^{2}","نظرية فيثاغورس <span class=m dir=ltr>(x</span> المسافة الأفقية، <span class=m dir=ltr>s</span> البعد عن الرادار)"],["10^{2}=x^{2}+36\\Rightarrow x=8","عندما <span class=m dir=ltr>s = 10</span>"],["2s\\frac{ds}{dt}=2x\\frac{dx}{dt}","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>t</span>"],["10(300)=8\\frac{dx}{dt}\\Rightarrow\\frac{dx}{dt}=375","بالتعويض"]],"a":"سرعة الطائرة <span class=\"tx\" data-t=\"375\\ \\text{km/h}\"></span>","o":""}],[{"n":"8","s":[["x^{2}+y^{2}=5^{2}","نظرية فيثاغورس: <span class=m dir=ltr>x</span> بُعد الطرف السفلي عن الجدار، <span class=m dir=ltr>y</span> ارتفاع الطرف العلوي"],["3^{2}+y^{2}=25\\Rightarrow y=4","عندما <span class=m dir=ltr>x = 3</span>"],["2x\\frac{dx}{dt}+2y\\frac{dy}{dt}=0","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>t</span>"],["3\\frac{dx}{dt}+4(0.15)=0\\Rightarrow\\frac{dx}{dt}=-0.2","بالتعويض <span class=m dir=ltr>dy/dt = 0.15</span>"]],"a":"يقترب الطرف السفلي من الجدار بسرعة <span class=\"tx\" data-t=\"0.2\\ \\text{m/s}\"></span> (<span class=\"tx\" data-t=\"\\frac{dx}{dt}=-0.2\"></span>)","o":""}],[{"n":"9","s":[["\\text{width}=x-(-x)=2x,\\quad\\text{height}=e^{-x^{2}/2}","أبعاد المستطيل من الشكل"],["A(x)=2xe^{-x^{2}/2}","المساحة <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"]],"a":"<span class=\"tx\" data-t=\"A=2xe^{-x^{2}/2},\\ x&gt;0\"></span>","o":""},{"n":"10","s":[["\\frac{dA}{dt}=\\left(2e^{-x^{2}/2}+2x\\cdot e^{-x^{2}/2}(-x)\\right)\\frac{dx}{dt}","مشتقة الضرب وقاعدة السلسلة"],["\\frac{dA}{dt}=2e^{-x^{2}/2}(1-x^{2})\\frac{dx}{dt}","بإخراج العامل المشترك"],["\\frac{dA}{dt}=2e^{-8}(1-16)(4)=-120e^{-8}\\approx -0.0403","بالتعويض <span class=m dir=ltr>x = 4, dx/dt = 4</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dA}{dt}=-120e^{-8}\\approx -0.0403\\ \\text{cm}^2\\text{/min}\"></span> (المساحة تتناقص)","o":""}]]