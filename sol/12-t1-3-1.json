[[{"n":"1","s":[["f(x)=2\\sin x-e^{x}","الاقتران المعطى"],["f'(x)=2\\cos x-e^{x}","مشتقة <span class=\"tx\" data-t=\"\\sin x\"></span> هي <span class=\"tx\" data-t=\"\\cos x\"></span>، ومشتقة <span class=\"tx\" data-t=\"e^x\"></span> هي <span class=\"tx\" data-t=\"e^x\"></span>"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=2\\cos x-e^{x}\"></span>","o":"","k":[{"e":"-exp(x) + 2*cos(x)","a":null}]},{"n":"2","s":[["f(x)=\\frac{1}{4}\\ln x-\\pi\\cos x","بكتابة الاقتران بصورة أبسط"],["f'(x)=\\frac{1}{4}\\cdot\\frac{1}{x}-\\pi(-\\sin x)","مشتقة <span class=\"tx\" data-t=\"\\ln x\"></span> هي <span class=\"tx\" data-t=\"\\frac{1}{x}\"></span>، ومشتقة <span class=\"tx\" data-t=\"\\cos x\"></span> هي <span class=\"tx\" data-t=\"-\\sin x\"></span>"],["f'(x)=\\frac{1}{4x}+\\pi\\sin x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1}{4x}+\\pi\\sin x\"></span>","o":"","k":[{"e":"pi*sin(x) + 1/(4*x)","a":null}]},{"n":"3","s":[["f(x)=\\ln x^{-3}+x^{4}=-3\\ln x+x^{4}","خصائص اللوغاريتمات: <span class=\"tx\" data-t=\"\\ln a^{n}=n\\ln a\"></span>"],["f'(x)=-\\frac{3}{x}+4x^{3}","باشتقاق كل حدّ"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{3}{x}+4x^{3}\"></span>","o":"","k":[{"e":"4*x^3 - 3/x","a":null}]},{"n":"4","s":[["f(x)=e^{x}\\cdot e+1","خاصية الأسس: <span class=\"tx\" data-t=\"e^{x+1}=e\\cdot e^{x}\"></span>"],["f'(x)=e\\cdot e^{x}+0=e^{x+1}","مشتقة الثابت صفر"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=e^{x+1}\"></span>","o":"","k":[{"e":"exp(x + 1)","a":null}]},{"n":"5","s":[["f(x)=e^{x}+x^{e}","الاقتران المعطى (<span class=\"tx\" data-t=\"e\"></span> ثابت)"],["f'(x)=e^{x}+e\\,x^{e-1}","مشتقة الاقتران الأسي الطبيعي، وقاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=e^{x}+e\\,x^{e-1}\"></span>","o":"","k":[{"e":"E*x^(-1 + E) + exp(x)","a":null}]},{"n":"6","s":[["f(x)=\\ln 10-\\ln x^{n}=\\ln 10-n\\ln x","قانون القسمة وقانون القوة في اللوغاريتمات"],["f'(x)=0-n\\cdot\\frac{1}{x}","مشتقة الثابت <span class=\"tx\" data-t=\"\\ln 10\"></span> صفر"],["f'(x)=-\\frac{n}{x}",""]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=-\\frac{n}{x}\"></span>","o":"","k":[{"e":"-n/x","a":null}]}],[{"n":"7","s":[["f'(x)=\\cos x+\\frac{1}{2}e^{x}","باشتقاق الاقتران"],["m=f'(\\pi)=\\cos\\pi+\\frac{1}{2}e^{\\pi}=\\frac{1}{2}e^{\\pi}-1","ميل المماس عند <span class=\"tx\" data-t=\"x=\\pi\"></span>"],["y-\\frac{1}{2}e^{\\pi}=\\left(\\frac{1}{2}e^{\\pi}-1\\right)(x-\\pi)","صيغة الميل ونقطة"],["y=\\left(\\frac{1}{2}e^{\\pi}-1\\right)x+\\pi+\\frac{1}{2}e^{\\pi}(1-\\pi)","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y-\\frac{1}{2}e^{\\pi}=\\left(\\frac{1}{2}e^{\\pi}-1\\right)(x-\\pi)\"></span>، أي تقريبًا <span class=\"tx\" data-t=\"y\\approx 10.57x-21.64\"></span>","o":"","k":[{"q":"y - (-1 + exp(pi)/2)*(x - pi) - exp(pi)/2"},{"e":"10.57*x - 21.64","a":true}]},{"n":"8","s":[["m_{\\text{tangent}}=\\frac{1}{2}e^{\\pi}-1=\\frac{e^{\\pi}-2}{2}","من السؤال السابق"],["m_{\\text{normal}}=-\\frac{1}{m_{\\text{tangent}}}=-\\frac{2}{e^{\\pi}-2}","العمودي يعامد المماس، فحاصل ضرب الميلين <span class=\"tx\" data-t=\"-1\"></span>"],["y-\\frac{1}{2}e^{\\pi}=-\\frac{2}{e^{\\pi}-2}(x-\\pi)","صيغة الميل ونقطة"]],"a":"<span class=\"tx\" data-t=\"y-\\frac{1}{2}e^{\\pi}=-\\frac{2}{e^{\\pi}-2}(x-\\pi)\"></span>، والميل <span class=\"tx\" data-t=\"\\approx -0.0946\"></span>","o":"","k":[{"q":"y + 2*(x - pi)/(-2 + exp(pi)) - exp(pi)/2"},{"e":"-0.0946","a":true}]}],[{"n":"9","s":[["f'(x)=e^{x}-2","باشتقاق الاقتران"],["e^{x}-2=0","المماس أفقي عندما يكون الميل صفرًا"],["e^{x}=2\\Rightarrow x=\\ln 2","بأخذ <span class=\"tx\" data-t=\"\\ln\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"x=\\ln 2\\approx 0.693\"></span>","o":"","k":[{"e":"0.693","a":true}]}],[{"n":"10","s":[["f(\\pi)=\\sin\\pi+\\cos\\pi=-1","إحداثي <span class=\"tx\" data-t=\"y\"></span> للنقطة"],["f'(x)=\\cos x-\\sin x\\Rightarrow f'(\\pi)=-1-0=-1","ميل المماس"],["m_{\\text{normal}}=-\\frac{1}{-1}=1","ميل العمودي"],["y-(-1)=1(x-\\pi)\\Rightarrow y=x-\\pi-1","صيغة الميل ونقطة"]],"a":"الإجابة <span class=m dir=ltr>b</span>: <span class=\"tx\" data-t=\"y=x-\\pi-1\"></span>","o":"","k":[{"e":"x - pi - 1","a":null}]}],[{"n":"11","s":[["f(x)=\\ln(kx)=\\ln k+\\ln x","قانون الضرب في اللوغاريتمات (<span class=\"tx\" data-t=\"k&gt;0,\\ x&gt;0\"></span>)"],["f'(x)=0+\\frac{1}{x}","<span class=\"tx\" data-t=\"\\ln k\"></span> عدد ثابت مشتقته صفر"],["f'(x)=\\frac{1}{x}","وهو المطلوب"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{1}{x}\"></span> مهما كانت قيمة <span class=\"tx\" data-t=\"k\"></span> الموجبة","o":"","k":[{"e":"1/x","a":null},{"e":"k","a":null}]}],[{"n":"12","s":[["f'(x)=\\frac{1}{x}\\Rightarrow f'(e)=\\frac{1}{e}","ميل المماس عند <span class=\"tx\" data-t=\"(e,1)\"></span>"],["y-1=\\frac{1}{e}(x-e)","صيغة الميل ونقطة"],["y=\\frac{1}{e}x-1+1=\\frac{1}{e}x","بالتبسيط"],["x=0\\Rightarrow y=0","بالتعويض بنقطة الأصل"]],"a":"معادلة المماس <span class=\"tx\" data-t=\"y=\\frac{x}{e}\"></span> تحققها النقطة <span class=\"tx\" data-t=\"(0,0)\"></span>، إذن المماس يمرّ بنقطة الأصل","o":""},{"n":"13","s":[["m_{\\text{normal}}=-\\frac{1}{1/e}=-e","ميل العمودي على المماس"],["y-1=-e(x-e)","معادلة العمودي"],["0-1=-e(x-e)","المقطع <span class=\"tx\" data-t=\"x\"></span>: نضع <span class=\"tx\" data-t=\"y=0\"></span>"],["x-e=\\frac{1}{e}\\Rightarrow x=e+\\frac{1}{e}","بقسمة الطرفين على <span class=\"tx\" data-t=\"-e\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x\"></span> للعمودي هو <span class=\"tx\" data-t=\"e+\\frac{1}{e}\"></span>","o":"","k":[{"e":"x","a":null},{"e":"exp(-1) + E","a":null}]}],[{"n":"14","s":[["v(t)=s'(t)=-\\cos t","السرعة مشتقة الموقع"],["a(t)=v'(t)=\\sin t","التسارع مشتقة السرعة"]],"a":"<span class=\"tx\" data-t=\"v(t)=-\\cos t\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(t)=\\sin t\\ \\text{m/s}^2\"></span>","o":"","k":[{"e":"-cos(t)","a":null},{"e":"sin(t)","a":null}]},{"n":"15","s":[["v(t)=-\\cos t=0\\Rightarrow\\cos t=0","السكون اللحظي عندما <span class=\"tx\" data-t=\"v=0\"></span>"],["t=\\frac{\\pi}{2}","أوّل قيمة موجبة"],["s\\left(\\frac{\\pi}{2}\\right)=4-\\sin\\frac{\\pi}{2}=4-1=3","بالتعويض في اقتران الموقع"]],"a":"الموقع <span class=\"tx\" data-t=\"3\\ \\text{m}\"></span> (عند <span class=\"tx\" data-t=\"t=\\frac{\\pi}{2}\\ \\text{s}\"></span>)","o":"","k":[{"e":"3","a":null},{"e":"pi/2","a":null}]},{"n":"16","s":[["a(t)=\\sin t=0","التسارع صفر"],["t=0,\\ \\pi,\\ 2\\pi,\\ \\dots","<span class=\"tx\" data-t=\"\\sin t=0\"></span> عند مضاعفات <span class=\"tx\" data-t=\"\\pi\"></span>"],["s(t)=4-\\sin t=4-0=4","بالتعويض"]],"a":"الموقع <span class=\"tx\" data-t=\"4\\ \\text{m}\"></span> في كل مرّة يكون فيها التسارع صفرًا","o":""}],[{"n":"17","s":[["s(0)=e^{0}-4(0)=1","الموقع الابتدائي عند <span class=\"tx\" data-t=\"t=0\"></span>"]],"a":"الموقع الابتدائي <span class=\"tx\" data-t=\"1\\ \\text{m}\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"18","s":[["v(t)=e^{t}-4,\\quad a(t)=e^{t}","باشتقاق الموقع ثم السرعة"],["e^{t}-4=0\\Rightarrow t=\\ln 4","السرعة صفر"],["a(\\ln 4)=e^{\\ln 4}=4","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"a=4\\ \\text{m/s}^2\"></span> (عند <span class=\"tx\" data-t=\"t=\\ln 4\\approx1.39\\ \\text{s}\"></span>)","o":"","k":[{"e":"4","a":null},{"e":"1.39","a":true}]}],[{"n":"19","s":[["x=0\\Rightarrow y=e^{0}-0=1","نقطة التقاطع مع المحور <span class=\"tx\" data-t=\"y\"></span> هي <span class=\"tx\" data-t=\"(0,1)\"></span>"],["y'=e^{x}-a\\Rightarrow y'(0)=1-a","ميل المماس عند <span class=\"tx\" data-t=\"x=0\"></span>"],["y-1=(1-a)(x-0)","صيغة الميل ونقطة"],["y=(1-a)x+1",""]],"a":"<span class=\"tx\" data-t=\"y=(1-a)x+1\"></span>","o":"التبرير: عند المحور <span class=\"tx\" data-t=\"y\"></span> يكون <span class=\"tx\" data-t=\"x=0\"></span> فنحصل على النقطة <span class=\"tx\" data-t=\"(0,1)\"></span>، والميل هو قيمة المشتقة عندها <span class=\"tx\" data-t=\"1-a\"></span>.","k":[{"e":"x*(1 - a) + 1","a":null}]}],[{"n":"20","s":[["y'=2e^{x}+3+15x^{2}","باشتقاق الاقتران"],["2e^{x}>0,\\quad 15x^{2}\\ge 0","لكل قيم <span class=\"tx\" data-t=\"x\"></span> الحقيقية"],["y'>0+3+0=3>2","إذن الميل دائمًا أكبر من <span class=m dir=ltr>3</span>"],["2e^{x}+15x^{2}=-1","لو فرضنا <span class=\"tx\" data-t=\"y&#x27;=2\"></span> لحصلنا على معادلة طرفها الأيسر موجب وطرفها الأيمن سالب"]],"a":"لا يوجد مماس ميله <span class=m dir=ltr>2</span>؛ لأنّ <span class=\"tx\" data-t=\"y&#x27;&gt;3\"></span> لجميع قيم <span class=\"tx\" data-t=\"x\"></span>","o":""}],[{"n":"21","s":[["x=0\\Rightarrow y=ke^{0}=k\\Rightarrow P(0,k)","نقطة التقاطع مع المحور <span class=\"tx\" data-t=\"y\"></span>"],["y'=ke^{x}\\Rightarrow y'(0)=k","ميل المماس عند <span class=\"tx\" data-t=\"P\"></span>"],["y-k=k(x-0)\\Rightarrow y=kx+k","معادلة المماس"],["0=kx+k\\Rightarrow x=-1","نضع <span class=\"tx\" data-t=\"y=0\"></span> ونقسم على <span class=\"tx\" data-t=\"k\\ne0\"></span>"]],"a":"يقطع المماس المحور <span class=\"tx\" data-t=\"x\"></span> عند النقطة <span class=\"tx\" data-t=\"(-1,0)\"></span>","o":"","k":[{"e":"x","a":null},{"p":["-1","0"]}]},{"n":"22","s":[["m_{\\text{normal}}=-\\frac{1}{k}","ميل العمودي عند <span class=\"tx\" data-t=\"P(0,k)\"></span>"],["y=-\\frac{1}{k}x+k","معادلة العمودي"],["0=-\\frac{100}{k}+k","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(100,0)\"></span>"],["k^{2}=100\\Rightarrow k=10","بالضرب في <span class=\"tx\" data-t=\"k\"></span>، و<span class=\"tx\" data-t=\"k&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"k=10\"></span>","o":"التبرير: نرفض <span class=\"tx\" data-t=\"k=-10\"></span> لأنّ <span class=\"tx\" data-t=\"k&gt;0\"></span>.","k":[{"e":"10","a":null}]}],[{"n":"23","s":[["v(t)=\\sin t-\\cos t","السرعة مشتقة الموقع"],["\\sin t-\\cos t=0\\Rightarrow\\tan t=1","السكون اللحظي: <span class=\"tx\" data-t=\"v=0\"></span>، بالقسمة على <span class=\"tx\" data-t=\"\\cos t\"></span>"],["t=\\frac{\\pi}{4}+n\\pi,\\ n=0,1,2,\\dots","حلول المعادلة لـ <span class=\"tx\" data-t=\"t\\ge0\"></span>"]],"a":"<span class=\"tx\" data-t=\"t=\\frac{\\pi}{4},\\ \\frac{5\\pi}{4},\\ \\frac{9\\pi}{4},\\dots\"></span> (أوّلها <span class=\"tx\" data-t=\"t=\\frac{\\pi}{4}\\ \\text{s}\"></span>)","o":"التبرير: عند هذه القيم تنعدم السرعة وتتغيّر إشارتها فيتوقف الجسم لحظيًّا."},{"n":"24","s":[["s(0)=3-\\cos0-\\sin0=2","الموقع الابتدائي"],["3-\\cos t-\\sin t=2\\Rightarrow\\cos t+\\sin t=1","نساوي الموقع بـ <span class=m dir=ltr>2</span>"],["1+2\\sin t\\cos t=1\\Rightarrow\\sin 2t=0","بتربيع الطرفين"],["2t=\\pi\\Rightarrow t=\\frac{\\pi}{2}","أوّل قيمة موجبة تحقق المعادلة الأصلية"],["\\cos\\frac{\\pi}{2}+\\sin\\frac{\\pi}{2}=0+1=1","التحقق"]],"a":"يعود الجسم إلى موقعه الابتدائي أوّل مرّة عند <span class=\"tx\" data-t=\"t=\\frac{\\pi}{2}\\ \\text{s}\"></span>","o":"التبرير: لكل <span class=\"tx\" data-t=\"0&lt;t&lt;\\frac{\\pi}{2}\"></span> يكون <span class=\"tx\" data-t=\"\\cos t+\\sin t&gt;1\"></span> فلا يعود قبل ذلك."}],[{"n":"25","s":[["y=\\log x=\\frac{\\ln x}{\\ln 10}","تغيير الأساس"],["\\frac{dy}{dx}=\\frac{1}{\\ln 10}\\cdot\\frac{1}{x}","<span class=\"tx\" data-t=\"\\frac{1}{\\ln 10}\"></span> ثابت"],["\\frac{dy}{dx}=\\frac{1}{x\\ln 10}","وهو المطلوب"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{1}{x\\ln 10}\"></span>","o":"","k":[{"e":"1/(x*log(10))","a":null}]},{"n":"26","s":[["y=\\log a+\\log x^{2}=\\log a+2\\log x","قوانين اللوغاريتمات (<span class=\"tx\" data-t=\"x&gt;0\"></span>)"],["\\frac{dy}{dx}=0+2\\cdot\\frac{1}{x\\ln 10}","<span class=\"tx\" data-t=\"\\log a\"></span> ثابت، ونستعمل نتيجة السؤال <span class=m dir=ltr>25</span>"],["\\frac{dy}{dx}=\\frac{2}{x\\ln 10}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{2}{x\\ln 10}\"></span>","o":"","k":[{"e":"2/(x*log(10))","a":null}]}],[{"n":"1","s":[["v(t)=s'(t)=\\cos t",""],["\\cos t=0\\Rightarrow t=\\frac{\\pi}{2}",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"t=\\frac{\\pi}{2}\"></span>","o":"","k":[{"e":"pi/2","a":null}]}],[{"n":"39","s":[["N(a)=2000+500\\ln a","الاقتران المعطى"],["N'(a)=0+500\\cdot\\frac{1}{a}=\\frac{500}{a}","مشتقة الثابت صفر، ومشتقة <span class=m dir=ltr>ln a</span> هي <span class=m dir=ltr>1/a</span>"]],"a":"<span class=\"tx\" data-t=\"N&#x27;(a)=\\frac{500}{a}\"></span> وحدة لكل ألف دينار","o":"","k":[{"e":"500/a","a":null}]},{"n":"40","s":[["N'(10)=\\frac{500}{10}=50","بالتعويض <span class=m dir=ltr>a = 10</span>"]],"a":"<span class=\"tx\" data-t=\"N&#x27;(10)=50\"></span>: عندما يكون الإنفاق <span class=m dir=ltr>10</span> آلاف دينار، يزداد عدد الوحدات المبيعة بمعدّل <span class=m dir=ltr>50</span> وحدة تقريبًا لكل ألف دينار إضافي","o":""}],[{"n":"1","s":[["f(x)=9e^{x}+\\frac{1}{3}x^{-\\frac{1}{2}}","بكتابة الجذر على صورة أُسّ"],["f'(x)=9e^{x}+\\frac{1}{3}\\left(-\\frac{1}{2}\\right)x^{-\\frac{3}{2}}","مشتقة <span class=m dir=ltr>e^x</span> هي <span class=m dir=ltr>e^x</span>، وقاعدة القوة"],["f'(x)=9e^{x}-\\frac{1}{6x\\sqrt{x}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=9e^{x}-\\frac{1}{6x\\sqrt{x}}\"></span>","o":""},{"n":"2","s":[["f(x)=2e^{x}+x^{-2}","بكتابة الكسر على صورة أُسّ سالب"],["f'(x)=2e^{x}-2x^{-3}=2e^{x}-\\frac{2}{x^{3}}","مشتقة <span class=m dir=ltr>e^x</span> وقاعدة القوة"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=2e^{x}-\\frac{2}{x^{3}}\"></span>","o":"","k":[{"e":"2*e^x - 2/x^3","a":null}]},{"n":"3","s":[["f'(x)=\\frac{\\pi}{2}\\cos x-(-\\sin x)","مشتقة <span class=m dir=ltr>sin x</span> هي <span class=m dir=ltr>cos x</span>، ومشتقة <span class=m dir=ltr>cos x</span> هي <span class=m dir=ltr>−sin x</span>"],["f'(x)=\\frac{\\pi}{2}\\cos x+\\sin x","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=\\frac{\\pi}{2}\\cos x+\\sin x\"></span>","o":"","k":[{"e":"sin(x) + pi*cos(x)/2","a":null}]}],[{"n":"4","s":[["f(2)=2e^{2}+2","نقطة التماس"],["f'(x)=2e^{x}+1\\Rightarrow f'(2)=2e^{2}+1","الميل عند <span class=m dir=ltr>x = 2</span>"],["y-(2e^{2}+2)=(2e^{2}+1)(x-2)","معادلة المماس بصيغة الميل ونقطة"],["y=(2e^{2}+1)x-2e^{2}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y=(2e^{2}+1)x-2e^{2}\"></span> (أي تقريبًا <span class=\"tx\" data-t=\"y\\approx 15.78x-14.78\"></span>)","o":"","k":[{"e":"-2*e^2 + x*(2*e^2 + 1)","a":null},{"e":"15.78*x - 14.78","a":true}]}],[{"n":"5","s":[["f'(x)=3+\\cos x","مشتقة الاقتران"],["-1\\le\\cos x\\le 1\\Rightarrow 2\\le 3+\\cos x\\le 4","مدى جيب التمام"],["f'(x)\\ge 2>0","لا يمكن أن تساوي المشتقة صفرًا"]],"a":"بما أن <span class=\"tx\" data-t=\"f&#x27;(x)\\ne 0\"></span> لجميع قيم <span class=m dir=ltr>x</span>، فلا يوجد مماس أفقي لمنحنى الاقتران","o":""}],[{"n":"6","s":[["v(t)=s'(t)=2e^{t}-2et","السرعة مشتقة الموقع <span class=m dir=ltr>(e</span> ثابت)"],["a(t)=v'(t)=2e^{t}-2e","التسارع مشتقة السرعة"],["v(4)=2e^{4}-8e\\approx 87.45","بالتعويض <span class=m dir=ltr>t = 4</span>"],["a(4)=2e^{4}-2e\\approx 103.76","بالتعويض <span class=m dir=ltr>t = 4</span>"]],"a":"<span class=\"tx\" data-t=\"v(4)=2e^{4}-8e\\approx 87.45\\ \\text{m/s}\"></span>، <span class=\"tx\" data-t=\"a(4)=2e^{4}-2e\\approx 103.76\\ \\text{m/s}^2\"></span>","o":"","k":[{"e":"87.45","a":true},{"e":"103.76","a":true}]},{"n":"7","s":[["v(2)=2e^{2}-4e\\approx 14.78-10.87=3.90","بالتعويض <span class=m dir=ltr>t = 2</span> في اقتران السرعة"],["v(2)>0","السرعة موجبة"]],"a":"يتحرّك الجسيم في الاتجاه الموجب (إلى اليمين) عندما <span class=\"tx\" data-t=\"t=2\"></span>","o":""},{"n":"8","s":[["a(t)=2e^{t}-2e=0","نساوي التسارع بالصفر"],["e^{t}=e\\Rightarrow t=1","بحلّ المعادلة"],["v(1)=2e-2e(1)=0","بالتعويض في اقتران السرعة"]],"a":"عندما يكون التسارع صفرًا (<span class=\"tx\" data-t=\"t=1\"></span>) تكون سرعة الجسيم <span class=\"tx\" data-t=\"0\\ \\text{m/s}\"></span>","o":""}],[{"n":"9","s":[["f(x)=\\ln x^{2}=2\\ln x,\\ x>0","خصائص اللوغاريتمات"],["f'(x)=\\frac{2}{x}\\Rightarrow f'(e^{2})=\\frac{2}{e^{2}}","الميل عند <span class=m dir=ltr>x = e^2</span>"],["f(e^{2})=2\\ln e^{2}=4","نقطة التماس <span class=m dir=ltr>(e^2, 4)</span>"],["y-4=\\frac{2}{e^{2}}(x-e^{2})\\Rightarrow y=\\frac{2}{e^{2}}x+2","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=\\frac{2}{e^{2}}x+2\"></span>","o":"","k":[{"e":"2*x*exp(-2) + 2","a":null}]},{"n":"10","s":[["6x-2y+5=0\\Rightarrow y=3x+\\frac{5}{2}","ميل المستقيم <span class=m dir=ltr>3</span>"],["f'(x)=\\frac{2}{x}=3","المماس الموازي له الميل نفسه"],["x=\\frac{2}{3}","بحلّ المعادلة"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{2}{3}\"></span>","o":"","k":[{"e":"2/3","a":null}]}],[{"n":"11","s":[["f'(x)=2\\cos x+4\\sin x","مشتقة الاقتران"],["f'(0)=2(1)+4(0)=2","بالتعويض <span class=m dir=ltr>x = 0</span>"]],"a":"ميل المماس عندما <span class=\"tx\" data-t=\"x=0\"></span> يساوي <span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"0","a":null},{"e":"2","a":null}]},{"n":"12","s":[["f\\left(\\frac{\\pi}{2}\\right)=2(1)-4(0)=2","نقطة التماس"],["f'\\left(\\frac{\\pi}{2}\\right)=2(0)+4(1)=4","الميل"],["y-2=4\\left(x-\\frac{\\pi}{2}\\right)","معادلة المماس بصيغة الميل ونقطة"],["y=4x-2\\pi+2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"y=4x-2\\pi+2\"></span>","o":"","k":[{"e":"4*x - 2*pi + 2","a":null}]}]]