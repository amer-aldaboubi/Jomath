[[{"n":"1","s":[["2x = 7y","المعادلة المعطاة"],["2x - 7y = 0","بطرح <span class=m dir=ltr>7y</span> من الطرفين"],["Ax + By = C,\\ A=2,\\ B=-7,\\ C=0","أس كل متغير <span class=m dir=ltr>1</span> ولا يوجد ضرب بين المتغيرين"]],"a":"نعم، المعادلة خطية؛ صورتها القياسية <span class=\"tx\" data-t=\"2x - 7y = 0\"></span>","o":""},{"n":"2","s":[["y = 1 - x^2","المعادلة المعطاة"],["x^2","أس المتغير <span class=\"tx\" data-t=\"x\"></span> يساوي <span class=m dir=ltr>2</span> وليس <span class=m dir=ltr>1</span>"]],"a":"لا، المعادلة ليست خطية لوجود <span class=\"tx\" data-t=\"x^2\"></span>","o":""},{"n":"3","s":[["9xy + 11x = 6","المعادلة المعطاة"],["9xy","يوجد حد فيه ضرب المتغيرين <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span> معًا"]],"a":"لا، المعادلة ليست خطية لوجود الحد <span class=\"tx\" data-t=\"9xy\"></span>","o":""}],[{"n":"4","s":[["y = -1","قيمة <span class=m dir=ltr>y</span> ثابتة مهما كانت قيمة <span class=m dir=ltr>x</span>"],["(-2,-1),\\ (0,-1),\\ (2,-1)","جدول قيم: <span class=m dir=ltr>x = -2, 0, 2</span>"]],"a":"مستقيم أفقي يمر بالنقاط <span class=\"tx\" data-t=\"(-2,-1),(0,-1),(2,-1)\"></span>","o":"أعيّن النقاط وأصل بينها: مستقيم أفقي موازٍ للمحور <span class=m dir=ltr>x</span> ويقطع المحور <span class=m dir=ltr>y</span> عند <span class=\"tx\" data-t=\"-1\"></span>"},{"n":"5","s":[["y - x = 8 \\Rightarrow y = x + 8","بإضافة <span class=m dir=ltr>x</span> إلى الطرفين"],["x=-8 \\Rightarrow y=0","بالتعويض"],["x=0 \\Rightarrow y=8","بالتعويض"],["x=-4 \\Rightarrow y=4","بالتعويض"]],"a":"النقاط <span class=\"tx\" data-t=\"(-8,0),(-4,4),(0,8)\"></span> تقع على المستقيم","o":"أعيّن النقاط الثلاث وأرسم مستقيمًا يمر بها (يقطع المحور <span class=m dir=ltr>x</span> عند <span class=\"tx\" data-t=\"-8\"></span> والمحور <span class=m dir=ltr>y</span> عند <span class=m dir=ltr>8)</span>"},{"n":"6","s":[["3x + 2y = 15","المعادلة المعطاة"],["x=1:\\ 3 + 2y = 15 \\Rightarrow y = 6","بالتعويض ثم الحل"],["x=3:\\ 9 + 2y = 15 \\Rightarrow y = 3","بالتعويض ثم الحل"],["x=5:\\ 15 + 2y = 15 \\Rightarrow y = 0","بالتعويض ثم الحل"]],"a":"النقاط <span class=\"tx\" data-t=\"(1,6),(3,3),(5,0)\"></span> تقع على المستقيم","o":"أعيّن النقاط وأصل بينها بمستقيم؛ يقطع المحور <span class=m dir=ltr>y</span> عند <span class=\"tx\" data-t=\"7.5\"></span> والمحور <span class=m dir=ltr>x</span> عند <span class=m dir=ltr>5</span>"}],[{"n":"7","s":[["(-2,0)","نقطة تقاطع المستقيم مع المحور <span class=m dir=ltr>x</span>"],["(0,4)","نقطة تقاطع المستقيم مع المحور <span class=m dir=ltr>y</span>"]],"a":"المقطع <span class=m dir=ltr>x</span> هو <span class=\"tx\" data-t=\"-2\"></span>، والمقطع <span class=m dir=ltr>y</span> هو <span class=\"tx\" data-t=\"4\"></span>","o":""},{"n":"8","s":[["(0,0)","المستقيم يمر بنقطة الأصل، فيقطع المحورين عندها"]],"a":"المقطع <span class=m dir=ltr>x</span> هو <span class=\"tx\" data-t=\"0\"></span>، والمقطع <span class=m dir=ltr>y</span> هو <span class=\"tx\" data-t=\"0\"></span>","o":""}],[{"n":"9","s":[["y=0:\\ x = 4(0) - 6 = -6","المقطع <span class=m dir=ltr>x</span>: بتعويض <span class=m dir=ltr>y = 0</span>"],["x=0:\\ 0 = 4y - 6","المقطع <span class=m dir=ltr>y</span>: بتعويض <span class=m dir=ltr>x = 0</span>"],["4y = 6 \\Rightarrow y = 1.5","بإضافة <span class=m dir=ltr>6</span> ثم القسمة على <span class=m dir=ltr>4</span>"]],"a":"المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=-6\"></span>، المقطع <span class=m dir=ltr>y</span> <span class=\"tx\" data-t=\"=1.5\"></span>","o":"أعيّن <span class=\"tx\" data-t=\"(-6,0)\"></span> و <span class=\"tx\" data-t=\"(0,1.5)\"></span> وأرسم المستقيم المار بهما"},{"n":"10","s":[["x + 6 = 0 \\Rightarrow x = -6","بطرح <span class=m dir=ltr>6</span> من الطرفين"],["(-6,0)","المقطع <span class=m dir=ltr>x</span>"],["\\text{no } y\\text{-intercept}","المستقيم رأسي موازٍ للمحور <span class=m dir=ltr>y</span> فلا يقطعه"]],"a":"المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=-6\"></span>، ولا يوجد مقطع <span class=m dir=ltr>y</span>؛ المستقيم رأسي <span class=\"tx\" data-t=\"x=-6\"></span>","o":"أرسم مستقيمًا رأسيًا يمر بالنقطة <span class=\"tx\" data-t=\"(-6,0)\"></span>"},{"n":"11","s":[["\\frac{4x}{3} = \\frac{3y}{4} + 1","المعادلة المعطاة"],["y=0:\\ \\frac{4x}{3} = 1 \\Rightarrow x = \\frac{3}{4}","المقطع <span class=m dir=ltr>x</span>: بتعويض <span class=m dir=ltr>y = 0</span> ثم الضرب في <span class=m dir=ltr>3/4</span>"],["x=0:\\ 0 = \\frac{3y}{4} + 1","المقطع <span class=m dir=ltr>y</span>: بتعويض <span class=m dir=ltr>x = 0</span>"],["\\frac{3y}{4} = -1 \\Rightarrow y = -\\frac{4}{3}","بطرح <span class=m dir=ltr>1</span> ثم الضرب في <span class=m dir=ltr>4/3</span>"]],"a":"المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=\\frac{3}{4}=0.75\"></span>، المقطع <span class=m dir=ltr>y</span> <span class=\"tx\" data-t=\"=-\\frac{4}{3}\\approx -1.33\"></span>","o":"أعيّن <span class=\"tx\" data-t=\"(0.75,0)\"></span> و <span class=\"tx\" data-t=\"(0,-\\frac{4}{3})\"></span> وأرسم المستقيم المار بهما"}],[{"n":"12","s":[["y=0:\\ 0 = 18 - 2x \\Rightarrow x = 9","المقطع <span class=m dir=ltr>x</span>: بتعويض <span class=m dir=ltr>y = 0</span>"],["x=0:\\ y = 18 - 2(0) = 18","المقطع <span class=m dir=ltr>y</span>: بتعويض <span class=m dir=ltr>x = 0</span>"]],"a":"المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=9\"></span>، المقطع <span class=m dir=ltr>y</span> <span class=\"tx\" data-t=\"=18\"></span>","o":"أعيّن <span class=\"tx\" data-t=\"(9,0)\"></span> و <span class=\"tx\" data-t=\"(0,18)\"></span> وأصل بينهما بقطعة مستقيمة في الربع الأول فقط (الزمن والوقود غير سالبين)"},{"n":"13","s":[["(0,18)","عند بداية الرحلة <span class=m dir=ltr>x = 0</span>"],["(9,0)","عندما يصبح الوقود صفرًا"]],"a":"المقطع <span class=m dir=ltr>y</span> <span class=\"tx\" data-t=\"=18\"></span>: كمية الوقود في الخزان الممتلئ عند الانطلاق <span class=m dir=ltr>18</span> لترًا. المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=9\"></span>: ينفد الوقود تمامًا بعد <span class=m dir=ltr>9</span> ساعات من القيادة","o":""},{"n":"14","s":[["\\frac{1}{4} \\times 18 = 4.5","ربع كمية الوقود في الخزان الممتلئ"],["18 - 2x = 4.5","بالتعويض <span class=m dir=ltr>y = 4.5</span>"],["-2x = -13.5","بطرح <span class=m dir=ltr>18</span> من الطرفين"],["x = 6.75","بقسمة الطرفين على <span class=m dir=ltr>−2</span>"]],"a":"بعد <span class=\"tx\" data-t=\"6.75\"></span> ساعة (أي <span class=m dir=ltr>6</span> ساعات و<span class=m dir=ltr>45</span> دقيقة)","o":""}],[{"n":"15","s":[["(0,20)","المقطع <span class=m dir=ltr>y</span>: عند الزمن <span class=m dir=ltr>0</span> كان الراكب في الطابق <span class=m dir=ltr>20</span>"]],"a":"صعد الراكب من الطابق العشرين","o":""},{"n":"16","s":[["(20,0)","المقطع <span class=m dir=ltr>x</span>: يصبح رقم الطابق <span class=m dir=ltr>0</span> عند الزمن <span class=m dir=ltr>20</span>"]],"a":"بعد <span class=m dir=ltr>20</span> ثانية","o":""},{"n":"17","s":[["m = \\frac{0-20}{20-0} = -1","المستقيم يمر بالنقطتين <span class=m dir=ltr>(0,20)</span> و <span class=m dir=ltr>(20,0)</span>"],["y = 20 - x","ينزل طابقًا واحدًا كل ثانية"],["8 = 20 - x \\Rightarrow x = 12","بتعويض <span class=m dir=ltr>y = 8</span>"]],"a":"بعد <span class=m dir=ltr>12</span> ثانية","o":""}],[{"n":"18","s":[["2x + 2y = 12","المحيط <span class=m dir=ltr>= 2 ×</span> الطول <span class=m dir=ltr>+ 2 ×</span> العرض"]],"a":"<span class=\"tx\" data-t=\"2x + 2y = 12\"></span> (أو بالتبسيط <span class=\"tx\" data-t=\"x + y = 6\"></span>)","o":""},{"n":"19","s":[["y=0:\\ 2x = 12 \\Rightarrow x = 6","المقطع <span class=m dir=ltr>x</span>"],["x=0:\\ 2y = 12 \\Rightarrow y = 6","المقطع <span class=m dir=ltr>y</span>"]],"a":"المقطع <span class=m dir=ltr>x</span> <span class=\"tx\" data-t=\"=6\"></span>، المقطع <span class=m dir=ltr>y</span> <span class=\"tx\" data-t=\"=6\"></span>","o":""},{"n":"20","s":[["(6,0),\\ (0,6)","المقطعان"],["(2,4),\\ (3,3)","نقاط أخرى للتحقق"]],"a":"قطعة مستقيمة تصل بين <span class=\"tx\" data-t=\"(6,0)\"></span> و <span class=\"tx\" data-t=\"(0,6)\"></span> في الربع الأول","o":"الأبعاد موجبة، فالتمثيل قطعة مستقيمة في الربع الأول دون النقطتين الطرفيتين"},{"n":"21","s":[["x + y = 6","بقسمة طرفي المعادلة على <span class=m dir=ltr>2</span>"],["(1,5),\\ (2,4),\\ (3,3)","أعداد كلية موجبة مجموعها <span class=m dir=ltr>6</span>"]],"a":"<span class=\"tx\" data-t=\"(1,5),(2,4),(3,3)\"></span> (وأيضًا <span class=\"tx\" data-t=\"(4,2),(5,1)\"></span>)","o":""}],[{"n":"22","s":[["A = \\frac{1}{2}s^2 = 4.5 \\Rightarrow s^2 = 9 \\Rightarrow s = 3","المثلث الناتج قائم ومتطابق الضلعين لأن ميل المستقيم <span class=m dir=ltr>−1</span>"],["x = 1,\\ y = 1","نختار <span class=m dir=ltr>a = 1, b = 1</span>"],["(1,1),\\ (4,1),\\ (1,4)","رؤوس المثلث: <span class=m dir=ltr>x+y=5</span> يقطع <span class=m dir=ltr>y=1</span> عند <span class=m dir=ltr>x=4</span> ويقطع <span class=m dir=ltr>x=1</span> عند <span class=m dir=ltr>y=4</span>"],["A = \\frac{1}{2}(3)(3) = 4.5","مساحة المثلث"]],"a":"إجابة ممكنة: <span class=\"tx\" data-t=\"x = 1\"></span> و <span class=\"tx\" data-t=\"y = 1\"></span> (يتحقق ذلك لأي <span class=\"tx\" data-t=\"a, b\"></span> بحيث <span class=\"tx\" data-t=\"a + b = 2\"></span>، مثل <span class=\"tx\" data-t=\"x=0, y=2\"></span>)","o":""}],[{"n":"23","s":[["x = 2,\\ x = 5","مستقيمان رأسيان، المسافة بينهما <span class=m dir=ltr>5 − 2 = 3</span>"],["y = -2,\\ y = 1","مستقيمان أفقيان، المسافة بينهما <span class=m dir=ltr>1 − (−2) = 3</span>"],["(2,-2),\\ (5,-2),\\ (5,1),\\ (2,1)","رؤوس الشكل"]],"a":"الشكل مربع طول ضلعه <span class=m dir=ltr>3</span> وحدات؛ لأن المستقيمات الرأسية تعامد الأفقية (زوايا قائمة) وجميع الأضلاع متساوية الطول <span class=m dir=ltr>3</span>","o":"أرسم المستقيمين الرأسيين عند <span class=\"tx\" data-t=\"x=2\"></span> و <span class=\"tx\" data-t=\"x=5\"></span> والأفقيين عند <span class=\"tx\" data-t=\"y=-2\"></span> و <span class=\"tx\" data-t=\"y=1\"></span>"}],[{"n":"24","s":[["Ax + By = C","الصورة القياسية"],["y = 3x - 4 \\Rightarrow -3x + y = -4 \\Rightarrow 3x - y = 4","مثال: ننقل الحدين إلى طرف ونضرب في <span class=m dir=ltr>−1</span>"]],"a":"أنقل الحدين اللذين فيهما المتغيران إلى الطرف الأيسر والعدد الثابت إلى الطرف الأيمن لتصبح <span class=\"tx\" data-t=\"Ax + By = C\"></span>، حيث <span class=\"tx\" data-t=\"A, B, C\"></span> أعداد صحيحة، و <span class=\"tx\" data-t=\"A\"></span> و <span class=\"tx\" data-t=\"B\"></span> ليسا صفرًا معًا، و <span class=\"tx\" data-t=\"A \\ge 0\"></span> عادةً؛ وإذا وُجدت كسور أضرب الطرفين في المضاعف المشترك الأصغر للمقامات","o":""}],[{"n":"3","s":[["5(0)+2y=30","المقطع <span class=m dir=ltr>y</span>: نعوض <span class=m dir=ltr>x = 0</span>"],["y=15","بقسمة الطرفين على <span class=m dir=ltr>2</span>"]],"a":"<span class=m dir=ltr>d) 15</span>","o":""}],[{"n":"4","s":[["0=4x+32","المقطع <span class=m dir=ltr>x</span>: نعوض <span class=m dir=ltr>y = 0</span>"],["-32=4x","بطرح <span class=m dir=ltr>32</span> من الطرفين"],["x=-8","بقسمة الطرفين على <span class=m dir=ltr>4</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"-8\"></span>","o":""}],[{"n":"11","s":[["(7,\\ 0)","المقطع <span class=m dir=ltr>x</span> من التمثيل البياني"]],"a":"تصل الطائرة إلى سطح الأرض بعد <span class=m dir=ltr>7</span> ثوانٍ","o":""},{"n":"12","s":[["m=\\frac{0-35}{7-0}=-5","الميل من النقطتين <span class=m dir=ltr>(0, 35)</span> و <span class=m dir=ltr>(7, 0)</span>"],["y=-5x+35","صيغة الميل والمقطع"],["15=-5x+35","بالتعويض <span class=m dir=ltr>y = 15</span>"],["-20=-5x \\Rightarrow x=4","بطرح <span class=m dir=ltr>35</span> ثم القسمة على <span class=m dir=ltr>−5</span>"]],"a":"بعد <span class=m dir=ltr>4</span> ثوانٍ","o":""},{"n":"13","s":[["(0,\\ 35)","المقطع <span class=m dir=ltr>y</span>"]],"a":"المقطع <span class=\"tx\" data-t=\"y\"></span> يساوي <span class=m dir=ltr>35</span>، ويدل على الارتفاع الابتدائي للطائرة <span class=\"tx\" data-t=\"35\\ \\text{m}\"></span> عند بداية هبوطها (الزمن <span class=m dir=ltr>0)</span>","o":""}],[{"n":"24","s":[["-3y=29 \\Rightarrow y=-\\frac{29}{3}","لا يحتوي على <span class=m dir=ltr>x</span>، أي <span class=m dir=ltr>y</span> ثابت"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"-3y=29\"></span> (أما <span class=\"tx\" data-t=\"2x+7=0\"></span> فمستقيم رأسي)","o":""}],[{"n":"1","s":[["\\frac{1}{x} + \\frac{4}{y} = 8","المتغيران <span class=\"tx\" data-t=\"x\"></span> و <span class=\"tx\" data-t=\"y\"></span> في مقامي الكسرين (أُسّهما <span class=\"tx\" data-t=\"-1\"></span>)"]],"a":"ليست خطية","o":""},{"n":"2","s":[["\\frac{x}{3} = 2 + \\frac{y}{5}","المعادلة المعطاة"],["\\frac{1}{3}x - \\frac{1}{5}y = 2","بطرح <span class=\"tx\" data-t=\"\\frac{y}{5}\"></span> من الطرفين، وهي على الصورة <span class=\"tx\" data-t=\"Ax + By = C\"></span>"],["5x - 3y = 30","بضرب الطرفين في <span class=m dir=ltr>15</span>"]],"a":"خطية","o":""},{"n":"3","s":[["\\frac{5}{x} = y - 1","المتغير <span class=\"tx\" data-t=\"x\"></span> في المقام"]],"a":"ليست خطية","o":""}],[{"n":"4","s":[["5x + 3y = 30:\\; (6, 0),\\ (0, 10)","المقطع <span class=\"tx\" data-t=\"x\"></span>: نعوّض <span class=\"tx\" data-t=\"y=0\"></span>، والمقطع <span class=\"tx\" data-t=\"y\"></span>: نعوّض <span class=\"tx\" data-t=\"x=0\"></span>"],["5x + 3y = -30:\\; (-6, 0),\\ (0, -10)","بالطريقة نفسها"],["5x - 3y = 30:\\; (6, 0),\\ (0, -10)","بالطريقة نفسها"],["5x - 3y = -30:\\; (-6, 0),\\ (0, 10)","بالطريقة نفسها"]],"a":"<span class=\"tx\" data-t=\"5x+3y=30\"></span> ← التمثيل الرابع (يقطع <span class=\"tx\" data-t=\"x\"></span> عند <span class=m dir=ltr>6</span> و <span class=\"tx\" data-t=\"y\"></span> عند <span class=m dir=ltr>10)</span>؛ <span class=\"tx\" data-t=\"5x+3y=-30\"></span> ← التمثيل الثاني <span class=m dir=ltr>(−6</span> و <span class=m dir=ltr>−10)</span>؛ <span class=\"tx\" data-t=\"5x-3y=30\"></span> ← التمثيل الأول <span class=m dir=ltr>(6</span> و <span class=m dir=ltr>−10)</span>؛ <span class=\"tx\" data-t=\"5x-3y=-30\"></span> ← التمثيل الثالث <span class=m dir=ltr>(−6</span> و <span class=m dir=ltr>10)</span>","o":"ترتيب التمثيلات من اليسار إلى اليمين كما في الصفحة."}],[{"n":"5","s":[["2x + y = 6","بضرب الطرفين في <span class=m dir=ltr>4</span>"],["y = 0 \\Rightarrow 2x = 6 \\Rightarrow x = 3","المقطع <span class=\"tx\" data-t=\"x\"></span>"],["x = 0 \\Rightarrow y = 6","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x = 3\"></span>، المقطع <span class=\"tx\" data-t=\"y = 6\"></span>","o":"نعيّن النقطتين <span class=\"tx\" data-t=\"(3, 0)\"></span> و <span class=\"tx\" data-t=\"(0, 6)\"></span> ونصل بينهما بمستقيم."},{"n":"6","s":[["y = 0 \\Rightarrow 0 = -x + 7 \\Rightarrow x = 7","المقطع <span class=\"tx\" data-t=\"x\"></span>"],["x = 0 \\Rightarrow y = 7","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x = 7\"></span>، المقطع <span class=\"tx\" data-t=\"y = 7\"></span>","o":"نعيّن <span class=\"tx\" data-t=\"(7, 0)\"></span> و <span class=\"tx\" data-t=\"(0, 7)\"></span> ونصل بينهما."},{"n":"7","s":[["y = 0 \\Rightarrow 3x + 9 = 0 \\Rightarrow x = -3","المقطع <span class=\"tx\" data-t=\"x\"></span>"],["x = 0 \\Rightarrow y = 9","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x = -3\"></span>، المقطع <span class=\"tx\" data-t=\"y = 9\"></span>","o":"نعيّن <span class=\"tx\" data-t=\"(-3, 0)\"></span> و <span class=\"tx\" data-t=\"(0, 9)\"></span> ونصل بينهما."},{"n":"8","s":[["1 = 10 - 3y \\Rightarrow 3y = 9","بإضافة <span class=\"tx\" data-t=\"3y\"></span> وطرح <span class=m dir=ltr>1</span> من الطرفين"],["y = 3","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["x = 0 \\Rightarrow y = 3","المقطع <span class=\"tx\" data-t=\"y\"></span> هو <span class=m dir=ltr>3</span>، ولا يوجد مقطع <span class=\"tx\" data-t=\"x\"></span> لأنّ <span class=\"tx\" data-t=\"y\"></span> لا يساوي <span class=m dir=ltr>0</span> أبدًا"]],"a":"المقطع <span class=\"tx\" data-t=\"y = 3\"></span>، ولا يوجد مقطع <span class=\"tx\" data-t=\"x\"></span>","o":"المستقيم أفقي يمرّ بالنقطة <span class=\"tx\" data-t=\"(0, 3)\"></span> موازٍ للمحور <span class=\"tx\" data-t=\"x\"></span>."},{"n":"9","s":[["y = 0 \\Rightarrow 4x = 14 \\Rightarrow x = 3.5","المقطع <span class=\"tx\" data-t=\"x\"></span>"],["x = 0 \\Rightarrow -7y = 14 \\Rightarrow y = -2","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x = 3.5\"></span>، المقطع <span class=\"tx\" data-t=\"y = -2\"></span>","o":"نعيّن <span class=\"tx\" data-t=\"(3.5, 0)\"></span> و <span class=\"tx\" data-t=\"(0, -2)\"></span> ونصل بينهما."},{"n":"10","s":[["y = 0 \\Rightarrow 5 - x = 0 \\Rightarrow x = 5","المقطع <span class=\"tx\" data-t=\"x\"></span>"],["x = 0 \\Rightarrow y = 5","المقطع <span class=\"tx\" data-t=\"y\"></span>"]],"a":"المقطع <span class=\"tx\" data-t=\"x = 5\"></span>، المقطع <span class=\"tx\" data-t=\"y = 5\"></span>","o":"نعيّن <span class=\"tx\" data-t=\"(5, 0)\"></span> و <span class=\"tx\" data-t=\"(0, 5)\"></span> ونصل بينهما."}],[{"n":"11","s":[["\\text{Graph: } (0, 3),\\ (4, 0) \\Rightarrow m = \\frac{0 - 3}{4 - 0} = -\\frac{3}{4}","من التمثيل البياني: المقطعان <span class=\"tx\" data-t=\"y=3\"></span> و <span class=\"tx\" data-t=\"x=4\"></span>"],["y = -\\frac{3}{4}x + 3 \\Rightarrow 3x + 4y = 12","معادلة التمثيل البياني (بضرب الطرفين في <span class=m dir=ltr>4)</span>"],["\\text{Table: } m = \\frac{4 - 5}{-2 - (-4)} = -\\frac{1}{2},\\ (0, 3)","من الجدول: كلما زادت <span class=\"tx\" data-t=\"x\"></span> بمقدار <span class=m dir=ltr>2</span> نقصت <span class=\"tx\" data-t=\"y\"></span> بمقدار <span class=m dir=ltr>1</span>"],["y = -\\frac{1}{2}x + 3 \\Rightarrow x + 2y = 6","معادلة الجدول؛ مقطعها <span class=\"tx\" data-t=\"x\"></span> هو <span class=m dir=ltr>6</span>"]],"a":"تتشابهان في المقطع <span class=\"tx\" data-t=\"y\"></span> (كلتاهما تمرّ بالنقطة <span class=\"tx\" data-t=\"(0, 3)\"></span>) وكلتاهما ميلها سالب؛ وتختلفان في الميل (<span class=\"tx\" data-t=\"-\\frac{3}{4}\"></span> و <span class=\"tx\" data-t=\"-\\frac{1