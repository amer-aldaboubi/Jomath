[[{"n":"1","s":[["f(x)=x^2-4x+3","الاقتران"],["f'(x)=2x-4","باشتقاق الاقتران"],["2x-4=0","بمساواة المشتقة بالصفر"],["x=2","القيم الحرجة"],["x<2:\\ -,\\quad x>2:\\ +","إشارة الميل حول القيم الحرجة"],["f(2)=4-8+3=-1","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-1\"></span> عند <span class=\"tx\" data-t=\"x=2\"></span>، ولا توجد قيمة عظمى","o":""},{"n":"2","s":[["f(x)=x^2+6x-3","الاقتران"],["f'(x)=2x+6","باشتقاق الاقتران"],["2x+6=0","بمساواة المشتقة بالصفر"],["x=-3","القيم الحرجة"],["x<-3:\\ -,\\quad x>-3:\\ +","إشارة الميل حول القيم الحرجة"],["f(-3)=9-18-3=-12","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-12\"></span> عند <span class=\"tx\" data-t=\"x=-3\"></span>","o":""},{"n":"3","s":[["f(x)=1+5x-x^2","الاقتران"],["f'(x)=5-2x","باشتقاق الاقتران"],["5-2x=0","بمساواة المشتقة بالصفر"],["x=2.5","القيم الحرجة"],["x<2.5:\\ +,\\quad x>2.5:\\ -","إشارة الميل حول القيم الحرجة"],["f(2.5)=1+12.5-6.25=7.25","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"7.25\"></span> عند <span class=\"tx\" data-t=\"x=2.5\"></span>","o":""},{"n":"4","s":[["f(x)=x^3+1.5x^2-18x","الاقتران"],["f'(x)=3x^2+3x-18","باشتقاق الاقتران"],["3(x+3)(x-2)=0","بمساواة المشتقة بالصفر"],["x=-3,\\ x=2","القيم الحرجة"],["+\\ (-3)\\ -\\ (2)\\ +","إشارة الميل حول القيم الحرجة"],["f(-3)=40.5,\\quad f(2)=-22","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"40.5\"></span> عند <span class=\"tx\" data-t=\"x=-3\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-22\"></span> عند <span class=\"tx\" data-t=\"x=2\"></span>","o":""},{"n":"5","s":[["f(x)=18x^2-x^4","الاقتران"],["f'(x)=36x-4x^3","باشتقاق الاقتران"],["-4x(x-3)(x+3)=0","بمساواة المشتقة بالصفر"],["x=-3,\\ 0,\\ 3","القيم الحرجة"],["+\\ (-3)\\ -\\ (0)\\ +\\ (3)\\ -","إشارة الميل حول القيم الحرجة"],["f(-3)=81,\\ f(0)=0,\\ f(3)=81","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمتان عظميان محليتان <span class=\"tx\" data-t=\"81\"></span> عند <span class=\"tx\" data-t=\"x=\\pm 3\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"0\"></span> عند <span class=\"tx\" data-t=\"x=0\"></span>","o":""},{"n":"6","s":[["f(x)=2x^3-6x+4","الاقتران"],["f'(x)=6x^2-6","باشتقاق الاقتران"],["6(x-1)(x+1)=0","بمساواة المشتقة بالصفر"],["x=-1,\\ x=1","القيم الحرجة"],["+\\ (-1)\\ -\\ (1)\\ +","إشارة الميل حول القيم الحرجة"],["f(-1)=8,\\quad f(1)=0","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"8\"></span> عند <span class=\"tx\" data-t=\"x=-1\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"0\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>","o":""},{"n":"7","s":[["f(x)=x^3-12x-4","الاقتران"],["f'(x)=3x^2-12","باشتقاق الاقتران"],["3(x-2)(x+2)=0","بمساواة المشتقة بالصفر"],["x=-2,\\ x=2","القيم الحرجة"],["+\\ (-2)\\ -\\ (2)\\ +","إشارة الميل حول القيم الحرجة"],["f(-2)=12,\\quad f(2)=-20","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"12\"></span> عند <span class=\"tx\" data-t=\"x=-2\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-20\"></span> عند <span class=\"tx\" data-t=\"x=2\"></span>","o":""},{"n":"8","s":[["f(x)=2x^3+7","الاقتران"],["f'(x)=6x^2","باشتقاق الاقتران"],["6x^2=0","بمساواة المشتقة بالصفر"],["x=0","القيم الحرجة"],["x<0:\\ +,\\quad x>0:\\ +","إشارة الميل حول القيم الحرجة"]],"a":"لا توجد قيم عظمى أو صغرى محلية؛ لأن إشارة الميل لا تتغيّر حول <span class=\"tx\" data-t=\"x=0\"></span>","o":""},{"n":"9","s":[["f(x)=x^3-2x+4","الاقتران"],["f'(x)=3x^2-2","باشتقاق الاقتران"],["x^2=\\frac{2}{3}","بمساواة المشتقة بالصفر"],["x=\\pm\\sqrt{\\frac{2}{3}}\\approx\\pm 0.82","القيم الحرجة"],["+\\ (-0.82)\\ -\\ (0.82)\\ +","إشارة الميل حول القيم الحرجة"],["f(-\\sqrt{\\tfrac{2}{3}})=4+\\tfrac{4\\sqrt{6}}{9}\\approx 5.09,\\ \\ f(\\sqrt{\\tfrac{2}{3}})=4-\\tfrac{4\\sqrt{6}}{9}\\approx 2.91","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"\\approx 5.09\"></span> عند <span class=\"tx\" data-t=\"x=-\\sqrt{\\frac{2}{3}}\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"\\approx 2.91\"></span> عند <span class=\"tx\" data-t=\"x=\\sqrt{\\frac{2}{3}}\"></span>","o":""},{"n":"10","s":[["f(x)=x^3+x^2-8x+54","الاقتران"],["f'(x)=3x^2+2x-8","باشتقاق الاقتران"],["(x+2)(3x-4)=0","بمساواة المشتقة بالصفر"],["x=-2,\\ x=\\frac{4}{3}","القيم الحرجة"],["+\\ (-2)\\ -\\ (\\tfrac{4}{3})\\ +","إشارة الميل حول القيم الحرجة"],["f(-2)=66,\\quad f(\\tfrac{4}{3})=\\frac{1282}{27}\\approx 47.48","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"66\"></span> عند <span class=\"tx\" data-t=\"x=-2\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"\\frac{1282}{27}\\approx 47.48\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{4}{3}\"></span>","o":""}],[{"n":"11","s":[["h'(t)=19.6-9.8t","السرعة مشتقة الارتفاع"],["h'(3)=19.6-29.4=-9.8","بتعويض <span class=m dir=ltr>t = 3</span>"]],"a":"<span class=\"tx\" data-t=\"-9.8\\ \\text{m/s}\"></span> (السهم يهبط)","o":""},{"n":"12","s":[["19.6-9.8t=0\\Rightarrow t=2","بمساواة المشتقة بالصفر"],["t<2:\\ +,\\quad t>2:\\ -","إشارة الميل تتغير من موجبة إلى سالبة: قيمة عظمى"],["h(2)=1.2+39.2-19.6=20.8","بتعويض <span class=m dir=ltr>t = 2</span>"]],"a":"أعلى ارتفاع <span class=\"tx\" data-t=\"20.8\\ \\text{m}\"></span>","o":""}],[{"n":"13","s":[["A(x)=50x-x^2","بفك الأقواس"],["A'(x)=50-2x=0\\Rightarrow x=25","بمساواة المشتقة بالصفر"],["x<25:\\ +,\\quad x>25:\\ -","قيمة عظمى"],["A(25)=25(25)=625","بالتعويض"]],"a":"أكبر مساحة <span class=\"tx\" data-t=\"625\\ \\text{m}^2\"></span>","o":""}],[{"n":"14","s":[["f(x)=3x^4-10x^3+6x^2+3","الاقتران"],["f'(x)=12x^3-30x^2+12x","باشتقاق الاقتران"],["6x(2x-1)(x-2)=0","بمساواة المشتقة بالصفر"],["x=0,\\ \\frac{1}{2},\\ 2","القيم الحرجة"],["-\\ (0)\\ +\\ (\\tfrac12)\\ -\\ (2)\\ +","إشارة الميل حول القيم الحرجة"],["f(0)=3,\\ f(\\tfrac12)=\\frac{55}{16},\\ f(2)=-5","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"صغرى محلية عند <span class=\"tx\" data-t=\"(0,\\ 3)\"></span>، عظمى محلية عند <span class=\"tx\" data-t=\"(\\frac{1}{2},\\ \\frac{55}{16})\"></span>، صغرى محلية عند <span class=\"tx\" data-t=\"(2,\\ -5)\"></span>","o":""}],[{"n":"15","s":[["f'(x)=2x+\\frac{1}{k}","باشتقاق الاقتران"],["2(3)+\\frac{1}{k}=0","المشتقة صفر عند <span class=m dir=ltr>x = 3</span>"],["\\frac{1}{k}=-6","بطرح <span class=m dir=ltr>6</span> من الطرفين"],["k=-\\frac{1}{6}",""]],"a":"<span class=\"tx\" data-t=\"k=-\\frac{1}{6}\"></span>","o":""}],[{"n":"16","s":[["3(4x)=12x","طول الأسلاك الأفقية: <span class=m dir=ltr>3</span> خطوط كل منها <span class=m dir=ltr>4x</span>"],["5(2y)=10y","طول الأسلاك الرأسية: <span class=m dir=ltr>5</span> خطوط كل منها <span class=m dir=ltr>2y</span>"],["12x+10y=180","الطول الكلي للشباك"],["y=\\frac{180-12x}{10}=18-1.2x","بطرح <span class=m dir=ltr>12x</span> ثم القسمة على <span class=m dir=ltr>10</span>"]],"a":"<span class=\"tx\" data-t=\"y=18-1.2x\"></span>","o":""},{"n":"17","s":[["A=(4x)(2y)=8xy","المساحة الكلية للحظائر الثمانية"],["A(x)=8x(18-1.2x)","بتعويض <span class=m dir=ltr>y</span>"],["A(x)=144x-9.6x^2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"A(x)=144x-9.6x^2\"></span>","o":""},{"n":"18","s":[["A'(x)=144-19.2x","باشتقاق الاقتران"],["144-19.2x=0\\Rightarrow x=7.5","بمساواة المشتقة بالصفر"],["x<7.5:\\ +,\\quad x>7.5:\\ -","قيمة عظمى"]],"a":"<span class=\"tx\" data-t=\"x=7.5\\ \\text{m}\"></span>","o":""},{"n":"19","s":[["A(7.5)=144(7.5)-9.6(7.5)^2","بالتعويض"],["=1080-540=540","بالتبسيط"]],"a":"أكبر مساحة <span class=\"tx\" data-t=\"540\\ \\text{m}^2\"></span>","o":""}],[{"n":"20","s":[["f'(x)=6x^2+6x+4","باشتقاق الاقتران"],["6x^2+6x+4=0","لإيجاد القيم الحرجة"],["\\Delta=b^2-4ac=36-96=-60<0","المميّز سالب"],["","لا توجد حلول حقيقية، فالمشتقة لا تساوي صفرًا أبدًا"]],"a":"الاقتران ليس له قيم حرجة؛ لأن <span class=\"tx\" data-t=\"f&#x27;(x)&gt;0\"></span> دائمًا (المميّز سالب)","o":""}],[{"n":"21","s":[["f'(x)=2x+a","باشتقاق الاقتران"],["2(1)+a=0\\Rightarrow a=-2","المشتقة صفر عند <span class=m dir=ltr>x = 1</span>"],["1-2+b=3\\Rightarrow b=4","النقطة <span class=m dir=ltr>(1, 3)</span> على المنحنى"],["x<1:\\ -,\\quad x>1:\\ +","إشارة الميل حول <span class=m dir=ltr>x = 1</span>"]],"a":"<span class=\"tx\" data-t=\"a=-2,\\ b=4\"></span>، والقيمة الحرجة قيمة صغرى محلية <span class=m dir=ltr>(3)</span>","o":"التبرير: إشارة الميل تتغير من سالبة إلى موجبة عند <span class=\"tx\" data-t=\"x=1\"></span> (وأيضًا معامل <span class=\"tx\" data-t=\"x^2\"></span> موجب)."}],[{"n":"22","s":[["[ABCD]=8\\times 6=48","مساحة المستطيل"],["[ADF]=\\frac{1}{2}(6)(8-x)=24-3x","<span class=m dir=ltr>DF = 8 − x</span>"],["[FCE]=\\frac{1}{2}x(6-x)=3x-\\frac{1}{2}x^2","<span class=m dir=ltr>FC = x, CE = 6 − x</span>"],["[ABE]=\\frac{1}{2}(8)(x)=4x","<span class=m dir=ltr>BE = x</span>"],["H(x)=48-(24-3x)-(3x-\\tfrac12x^2)-4x","مساحة <span class=m dir=ltr>AFE =</span> المستطيل <span class=m dir=ltr>−</span> المثلثات الثلاثة"],["H(x)=24-4x+\\frac{1}{2}x^2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"H(x)=24-4x+\\frac{1}{2}x^2\"></span>","o":""},{"n":"23","s":[["H'(x)=-4+x","باشتقاق الاقتران"],["-4+x=0\\Rightarrow x=4","بمساواة المشتقة بالصفر"],["x<4:\\ -,\\quad x>4:\\ +","قيمة صغرى"],["H(4)=24-16+8=16","أصغر مساحة"]],"a":"<span class=\"tx\" data-t=\"x=4\"></span>، وأصغر مساحة للمثلث <span class=\"tx\" data-t=\"16\"></span> وحدة مربعة","o":""}],[{"n":"24","s":[["4x+2\\pi r=20\\Rightarrow r=\\frac{20-4x}{2\\pi}","طول السلك <span class=m dir=ltr>=</span> محيط المربع <span class=m dir=ltr>+</span> محيط الدائرة"],["A=x^2+\\pi r^2=x^2+\\frac{(20-4x)^2}{4\\pi}","مجموع المساحتين"],["A'=2x-\\frac{2(20-4x)}{\\pi}=0","باشتقاق الاقتران ومساواته بالصفر"],["\\pi x=20-4x\\Rightarrow x=\\frac{20}{\\pi+4}\\approx 2.80","بحل المعادلة"],["4x=\\frac{80}{\\pi+4}\\approx 11.20","طول الجزء المخصص للمربع"]],"a":"يُقصّ السلك على بعد <span class=\"tx\" data-t=\"\\frac{80}{\\pi+4}\\approx 11.20\\ \\text{cm}\"></span> من أحد طرفيه: <span class=\"tx\" data-t=\"11.20\\ \\text{cm}\"></span> للمربع و<span class=\"tx\" data-t=\"8.80\\ \\text{cm}\"></span> للدائرة","o":"إشارة <span class=\"tx\" data-t=\"A&#x27;\"></span> تتغير من سالبة إلى موجبة عند <span class=\"tx\" data-t=\"x\\approx 2.80\"></span> فهي قيمة صغرى، وأصغر مجموع للمساحتين <span class=\"tx\" data-t=\"\\frac{100}{\\pi+4}\\approx 14.00\\ \\text{cm}^2\"></span>."}],[{"n":"3","s":[["f(x)=x^3-8x^2+21x-18","بفك الأقواس"],["f'(x)=3x^2-16x+21=(3x-7)(x-3)","باشتقاق الاقتران والتحليل"],["x=\\frac{7}{3},\\ x=3","بمساواة المشتقة بالصفر"],["+\\ (\\tfrac{7}{3})\\ -\\ (3)\\ +","إشارة الميل: عظمى عند <span class=m dir=ltr>7/3</span>"]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"\\frac{7}{3}\"></span>","o":""}],[{"n":"8","s":[["2(2x\\cdot x)+2(2x\\cdot y)+2(x\\cdot y)=600","المساحة الكلية لسطح متوازي المستطيلات"],["4x^2+6xy=600\\Rightarrow y=\\frac{600-4x^2}{6x}","بجعل <span class=m dir=ltr>y</span> موضوع القانون"],["V=(2x)(x)(y)=2x^2\\cdot\\frac{600-4x^2}{6x}","الحجم"],["V(x)=\\frac{x(600-4x^2)}{3}=200x-\\frac{4}{3}x^3","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"V(x)=200x-\\frac{4}{3}x^3\"></span>","o":""},{"n":"9","s":[["V'(x)=200-4x^2","باشتقاق الاقتران"],["200-4x^2=0\\Rightarrow x^2=50","بمساواة المشتقة بالصفر"],["x=\\sqrt{50}=5\\sqrt{2}\\approx 7.07","لأن <span class=m dir=ltr>x</span> موجب"],["x<5\\sqrt2:\\ +,\\quad x>5\\sqrt2:\\ -","قيمة عظمى"]],"a":"<span class=\"tx\" data-t=\"x=5\\sqrt{2}\\approx 7.07\\ \\text{cm}\"></span>","o":""},{"n":"10","s":[["V(5\\sqrt2)=200(5\\sqrt2)-\\frac{4}{3}(5\\sqrt2)^3","بالتعويض"],["=1000\\sqrt2-\\frac{1000\\sqrt2}{3}=\\frac{2000\\sqrt2}{3}","بالتبسيط"],["\\approx 942.81",""]],"a":"أكبر حجم <span class=\"tx\" data-t=\"\\frac{2000\\sqrt{2}}{3}\\approx 942.81\\ \\text{cm}^3\"></span>","o":""}],[{"n":"20","s":[["f(x)=17","الاقتران"],["f'(x)=0","باشتقاق الاقتران"]],"a":"اقتران ثابت: لا توجد قيم عظمى أو صغرى محلية (الميل صفر دائمًا ولا تتغير إشارته)","o":""},{"n":"21","s":[["f(x)=5x+4","الاقتران"],["f'(x)=5","باشتقاق الاقتران"],["f'(x)=5\\ne 0","الميل لا يساوي صفرًا أبدًا"]],"a":"لا توجد قيم عظمى أو صغرى محلية؛ الاقتران متزايد دائمًا","o":""},{"n":"22","s":[["f(x)=x^2-5x+6","الاقتران"],["f'(x)=2x-5","باشتقاق الاقتران"],["2x-5=0","بمساواة المشتقة بالصفر"],["x=2.5","القيم الحرجة"],["x<2.5:\\ -,\\quad x>2.5:\\ +","إشارة الميل حول القيم الحرجة"],["f(2.5)=6.25-12.5+6=-0.25","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-0.25\"></span> عند <span class=\"tx\" data-t=\"x=2.5\"></span>","o":""},{"n":"23","s":[["f(x)=2x^3-4x^2+2x+1","الاقتران"],["f'(x)=6x^2-8x+2","باشتقاق الاقتران"],["2(3x-1)(x-1)=0","بمساواة المشتقة بالصفر"],["x=\\frac{1}{3},\\ x=1","القيم الحرجة"],["+\\ (\\tfrac13)\\ -\\ (1)\\ +","إشارة الميل حول القيم الحرجة"],["f(\\tfrac13)=\\frac{35}{27}\\approx 1.30,\\quad f(1)=1","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"\\frac{35}{27}\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{1}{3}\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"1\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>","o":""}],[{"n":"25","s":[["f'(x)=k-3x^2","باشتقاق الاقتران"],["k-3(-1)^2=0","المشتقة صفر عند <span class=m dir=ltr>x = −1</span>"],["k=3","بإضافة <span class=m dir=ltr>3</span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"k=3\"></span>","o":""}],[{"n":"26","s":[["-5<x<-2","المنحنى يصعد من <span class=m dir=ltr>(−5, −42)</span> إلى <span class=m dir=ltr>(−2, 35)</span>"],["2<x<3","المنحنى يصعد من <span class=m dir=ltr>(2, 7)</span> إلى <span class=m dir=ltr>(3, 14)</span>"]],"a":"الميل موجب في الفترتين <span class=\"tx\" data-t=\"-5&lt;x&lt;-2\"></span> و<span class=\"tx\" data-t=\"2&lt;x&lt;3\"></span>","o":""},{"n":"27","s":[["-2<x<2","المنحنى يهبط من <span class=m dir=ltr>(−2, 35)</span> إلى <span class=m dir=ltr>(2, 7)</span>"]],"a":"الميل سالب في الفترة <span class=\"tx\" data-t=\"-2&lt;x&lt;2\"></span>","o":""},{"n":"28","s":[["(-2,\\ 35),\\ (2,\\ 7)","نقطتا التحول (القمة والقاع)"]],"a":"النقطتان <span class=\"tx\" data-t=\"(-2,\\ 35)\"></span> و<span class=\"tx\" data-t=\"(2,\\ 7)\"></span>","o":""}],[{"n":"30","s":[["f'(x)=15x^4-15x^2","باشتقاق الاقتران"],["15x^2(x-1)(x+1)=0\\Rightarrow x=-1,\\ 0,\\ 1","بمساواة المشتقة بالصفر"],["+\\ (-1)\\ -\\ (0)\\ -\\ (1)\\ +","إشارة الميل"],["","عظمى عند <span class=m dir=ltr>−1</span>، صغرى عند <span class=m dir=ltr>1</span>، ولا تتغير الإشارة عند <span class=m dir=ltr>0</span>"]],"a":"<span class=m dir=ltr>d)</span> <span class=\"tx\" data-t=\"-1,\\ 1\"></span>","o":""}],[{"n":"31","s":[["f'(x)=2(x-3)","بفك الأقواس ثم الاشتقاق: <span class=m dir=ltr>f(x)=x²−6x+9</span>"],["2(x-3)=0\\Rightarrow x=3","نقطة حرجة واحدة"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"1\"></span>","o":""}],[{"n":"32","s":[["f'(x)=3x^2-12","باشتقاق الاقتران"]],"a":"<span class=\"tx\" data-t=\"f&#x27;(x)=3x^2-12\"></span>","o":""},{"n":"33","s":[["B(0,\\ 17)","نقطة التقاطع مع محور <span class=m dir=ltr>y</span>"],["f'(0)=-12","بتعويض <span class=m dir=ltr>x = 0</span>"]],"a":"الميل عند <span class=\"tx\" data-t=\"B\"></span> يساوي <span class=\"tx\" data-t=\"-12\"></span>","o":""},{"n":"34","s":[["3x^2-12=0\\Rightarrow x^2=4","بمساواة المشتقة بالصفر"],["x=-2,\\ x=2","<span class=m dir=ltr>A</span> يسار محور <span class=m dir=ltr>y</span> و <span class=m dir=ltr>C</span> يمينه"],["f(-2)=-8+24+17=33","بالتعويض"],["f(2)=8-24+17=1","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"A(-2,\\ 33)\"></span> و<span class=\"tx\" data-t=\"C(2,\\ 1)\"></span>","o":""}],[{"n":"1","s":[["f(x)=2","الاقتران"],["f'(x)=0","باشتقاق الاقتران"]],"a":"اقتران ثابت: لا توجد قيم عظمى أو صغرى محلية","o":""},{"n":"2","s":[["f(x)=-3","الاقتران"],["f'(x)=0","باشتقاق الاقتران"]],"a":"اقتران ثابت: لا توجد قيم عظمى أو صغرى محلية","o":""},{"n":"3","s":[["f(x)=2x-1","الاقتران"],["f'(x)=2\\ne 0","الميل لا يساوي صفرًا أبدًا"]],"a":"لا توجد قيم عظمى أو صغرى؛ الاقتران متزايد دائمًا","o":""},{"n":"4","s":[["f(x)=5x+3","الاقتران"],["f'(x)=5\\ne 0","الميل لا يساوي صفرًا أبدًا"]],"a":"لا توجد قيم عظمى أو صغرى؛ الاقتران متزايد دائمًا","o":""},{"n":"5","s":[["f(x)=x^2+2x+1","الاقتران"],["f'(x)=2x+2","باشتقاق الاقتران"],["2x+2=0","بمساواة المشتقة بالصفر"],["x=-1","القيم الحرجة"],["x<-1:\\ -,\\quad x>-1:\\ +","إشارة الميل حول القيم الحرجة"],["f(-1)=1-2+1=0","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"0\"></span> عند <span class=\"tx\" data-t=\"x=-1\"></span>","o":""},{"n":"6","s":[["f(x)=x^2-8x+7","الاقتران"],["f'(x)=2x-8","باشتقاق الاقتران"],["2x-8=0","بمساواة المشتقة بالصفر"],["x=4","القيم الحرجة"],["x<4:\\ -,\\quad x>4:\\ +","إشارة الميل حول القيم الحرجة"],["f(4)=16-32+7=-9","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-9\"></span> عند <span class=\"tx\" data-t=\"x=4\"></span>","o":""},{"n":"7","s":[["f(x)=x^3-6x^2+5","الاقتران"],["f'(x)=3x^2-12x","باشتقاق الاقتران"],["3x(x-4)=0","بمساواة المشتقة بالصفر"],["x=0,\\ x=4","القيم الحرجة"],["+\\ (0)\\ -\\ (4)\\ +","إشارة الميل حول القيم الحرجة"],["f(0)=5,\\quad f(4)=-27","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"5\"></span> عند <span class=\"tx\" data-t=\"x=0\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-27\"></span> عند <span class=\"tx\" data-t=\"x=4\"></span>","o":""},{"n":"8","s":[["f(x)=x^3+6x^2-15x","الاقتران"],["f'(x)=3x^2+12x-15","باشتقاق الاقتران"],["3(x+5)(x-1)=0","بمساواة المشتقة بالصفر"],["x=-5,\\ x=1","القيم الحرجة"],["+\\ (-5)\\ -\\ (1)\\ +","إشارة الميل حول القيم الحرجة"],["f(-5)=100,\\quad f(1)=-8","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"100\"></span> عند <span class=\"tx\" data-t=\"x=-5\"></span>، وقيمة صغرى محلية <span class=\"tx\" data-t=\"-8\"></span> عند <span class=\"tx\" data-t=\"x=1\"></span>","o":""},{"n":"9","s":[["f(x)=4x^3-x^4","الاقتران"],["f'(x)=12x^2-4x^3","باشتقاق الاقتران"],["4x^2(3-x)=0","بمساواة المشتقة بالصفر"],["x=0,\\ x=3","القيم الحرجة"],["+\\ (0)\\ +\\ (3)\\ -","إشارة الميل حول القيم الحرجة"],["f(3)=108-81=27","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة عظمى محلية <span class=\"tx\" data-t=\"27\"></span> عند <span class=\"tx\" data-t=\"x=3\"></span>، ولا قيمة عند <span class=\"tx\" data-t=\"x=0\"></span> (الإشارة لا تتغير)","o":""},{"n":"10","s":[["f(x)=x^2-x-2","الاقتران"],["f'(x)=2x-1","باشتقاق الاقتران"],["2x-1=0","بمساواة المشتقة بالصفر"],["x=\\frac{1}{2}","القيم الحرجة"],["x<\\tfrac12:\\ -,\\quad x>\\tfrac12:\\ +","إشارة الميل حول القيم الحرجة"],["f(\\tfrac12)=\\frac14-\\frac12-2=-\\frac{9}{4}","بالتعويض في <span class=m dir=ltr>f(x)</span>"]],"a":"قيمة صغرى محلية <span class=\"tx\" data-t=\"-\\frac{9}{4}=-2.25\"></span> عند <span class=\"tx\" data-t=\"x=\\frac{1}{2}\"></span>","o":""}],[{"n":"11","s":[["f'(x)=2kx+1","باشتقاق الاقتران"],["2k(1)+1=0","المشتقة صفر عند <span class=m dir=ltr>x = 1</span>"],["k=-\\frac{1}{2}","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>2</span>"]],"a":"<span class=\"tx\" data-t=\"k=-\\frac{1}{2}\"></span>","o":""}],[{"n":"12","s":[["x+y=150\\Rightarrow y=150-x","نفرض العددين <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span>"],["P(x)=x(150-x)=150x-x^2","حاصل الضرب"],["P'(x)=150-2x=0\\Rightarrow x=75","بمساواة المشتقة بالصفر"],["x<75:\\ +,\\quad x>75:\\ -","قيمة عظمى"],["y=150-75=75,\\ P=5625",""]],"a":"العددان <span class=\"tx\" data-t=\"75\"></span> و<span class=\"tx\" data-t=\"75\"></span>، وأكبر حاصل ضرب <span class=\"tx\" data-t=\"5625\"></span>","o":""}],[{"n":"13","s":[["A(x)=9x-x^2","بفك الأقواس"],["A'(x)=9-2x=0\\Rightarrow x=4.5","بمساواة المشتقة بالصفر"],["x<4.5:\\ +,\\quad x>4.5:\\ -","قيمة عظمى"],["A(4.5)=4.5(4.5)=20.25","بالتعويض"]],"a":"أكبر مساحة <span class=\"tx\" data-t=\"20.25\\ \\text{m}^2\"></span>","o":""}],[{"n":"14","s":[["2x+2y+\\pi x=80","المحيط: طول المستطيل <span class=m dir=ltr>+</span> عرضاه <span class=m dir=ltr>+</span> نصف محيط دائرة نصف قطرها <span class=m dir=ltr>x</span>"],["y=\\frac{80-2x-\\pi x}{2}","بجعل <span class=m dir=ltr>y</span> موضوع القانون"],["A=2xy+\\frac{1}{2}\\pi x^2","مساحة المستطيل <span class=m dir=ltr>+</span> نصف الدائرة"],["A=x(80-2x-\\pi x)+\\frac{\\pi}{2}x^2","بتعويض <span class=m dir=ltr>y</span>"],["A(x)=80x-\\left(2+\\frac{\\pi}{2}\\right)x^2","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"A(x)=80x-\\left(2+\\frac{\\pi}{2}\\right)x^2\"></span>","o":""},{"n":"15","s":[["A'(x)=80-(4+\\pi)x","باشتقاق الاقتران"],["80-(4+\\pi)x=0","بمساواة المشتقة بالصفر"],["x=\\frac{80}{4+\\pi}\\approx 11.20","بالقسمة على <span class=m dir=ltr>(4 + π)</span>"]],"a":"<span class=\"tx\" data-t=\"x=\\frac{80}{4+\\pi}\\approx 11.20\\ \\text{m}\"></span>","o":""},{"n":"16","s":[["A=80x-\\frac{4+\\pi}{2}x^2,\\ x=\\frac{80}{4+\\pi}","بالتعويض"],["A=\\frac{6400}{4+\\pi}-\\frac{3200}{4+\\pi}=\\frac{3200}{4+\\pi}","بالتبسيط"],["\\approx 448.08",""]],"a":"أكبر مساحة <span class=\"tx\" data-t=\"\\frac{3200}{4+\\pi}\\approx 448.08\\ \\text{m}^2\"></span>","o":""}],[{"n":"17","s":[["f'(x)=\\frac{1}{2}x+a","باشتقاق الاقتران"],["\\frac{1}{2}(-4)+a=0\\Rightarrow a=2","المشتقة صفر عند <span class=m dir=ltr>x = −4</span>"],["\\frac{1}{4}(16)+2(-4)+b=-3","النقطة <span class=m dir=ltr>(−4, −3)</span> على المنحنى"],["4-8+b=-3\\Rightarrow b=1",""],["x<-4:\\ -,\\quad x>-4:\\ +","إشارة الميل"]],"a":"<span class=\"tx\" data-t=\"a=2,\\ b=1\"></span>، والقيمة الحرجة <span class=\"tx\" data-t=\"-3\"></span> قيمة صغرى محلية","o":"التبرير: إشارة الميل تتغير من سالبة إلى موجبة عند <span class=\"tx\" data-t=\"x=-4\"></span>."}]]