فان متساويان، فالمتطابقة صحيحة","o":""},{"n":"28","s":[["\\tan3x=\\frac{\\tan2x+\\tan x}{1-\\tan2x\\tan x}","متطابقة الظل لمجموع زاويتين"],["=\\frac{\\frac{2\\tan x}{1-\\tan^2x}+\\tan x}{1-\\frac{2\\tan^2x}{1-\\tan^2x}}","متطابقة ضعف الزاوية للظل"],["=\\frac{2\\tan x+\\tan x-\\tan^3x}{1-\\tan^2x-2\\tan^2x}","بضرب البسط والمقام في <span class=\"tx\" data-t=\"1-\\tan^2x\"></span>"],["=\\frac{3\\tan x-\\tan^3x}{1-3\\tan^2x}","بالتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"29","s":[["4\\cos\\frac{x}{2}\\cos\\frac{x}{4}\\sin\\frac{x}{4}=2\\cos\\frac{x}{2}\\left(2\\sin\\frac{x}{4}\\cos\\frac{x}{4}\\right)","نبدأ بالطرف الأيمن"],["=2\\cos\\frac{x}{2}\\sin\\frac{x}{2}","متطابقة ضعف الزاوية (<span class=\"tx\" data-t=\"2\\cdot\\frac{x}{4}=\\frac{x}{2}\"></span>)"],["=\\sin x","متطابقة ضعف الزاوية (<span class=\"tx\" data-t=\"2\\cdot\\frac{x}{2}=x\"></span>)"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"30","s":[["\\frac{\\cos2x}{\\cos^2x}+\\tan^2x=\\frac{\\cos^2x-\\sin^2x}{\\cos^2x}+\\frac{\\sin^2x}{\\cos^2x}","متطابقتا ضعف الزاوية والنسبة"],["=\\frac{\\cos^2x-\\sin^2x+\\sin^2x}{\\cos^2x}=\\frac{\\cos^2x}{\\cos^2x}=1","بالتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"31","s":[["\\cos^22x=(2\\cos^2x-1)^2","متطابقة ضعف الزاوية"],["=4\\cos^4x-4\\cos^2x+1","بفك المربع"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"32","s":[["\\frac{2(\\tan x-\\cot x)}{(\\tan x-\\cot x)(\\tan x+\\cot x)}=\\frac{2}{\\tan x+\\cot x}","تحليل الفرق بين مربعين والاختصار"],["\\tan x+\\cot x=\\frac{\\sin^2x+\\cos^2x}{\\sin x\\cos x}=\\frac{1}{\\sin x\\cos x}","متطابقة النسبة والمتطابقة الفيثاغورية"],["\\frac{2}{\\tan x+\\cot x}=2\\sin x\\cos x=\\sin2x","متطابقة ضعف الزاوية"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"33","s":[["\\tan^2\\frac{u}{2}=\\frac{1-\\cos u}{1+\\cos u},\\quad u=x+\\frac{\\pi}{2}","متطابقة نصف الزاوية، لأنّ <span class=\"tx\" data-t=\"\\frac{x}{2}+\\frac{\\pi}{4}=\\frac{u}{2}\"></span>"],["\\cos\\left(x+\\frac{\\pi}{2}\\right)=-\\sin x","متطابقة جيب التمام لمجموع زاويتين"],["\\tan^2\\left(\\frac{x}{2}+\\frac{\\pi}{4}\\right)=\\frac{1-(-\\sin x)}{1+(-\\sin x)}=\\frac{1+\\sin x}{1-\\sin x}","بالتعويض"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"34","s":[["\\cot^2\\frac{x}{2}=\\frac{1}{\\tan^2\\frac{x}{2}}=\\frac{1+\\cos x}{1-\\cos x}","متطابقة نصف الزاوية"],["=\\frac{(1+\\cos x)\\sec x}{(1-\\cos x)\\sec x}=\\frac{\\sec x+1}{\\sec x-1}","بضرب البسط والمقام في <span class=\"tx\" data-t=\"\\sec x\"></span>؛ <span class=\"tx\" data-t=\"\\cos x\\sec x=1\"></span>"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"35","s":[["\\frac12\\left(\\ln|1-\\cos2x|-\\ln2\\right)=\\frac12\\ln\\left|\\frac{1-\\cos2x}{2}\\right|","نبدأ بالطرف الأيمن؛ لوغاريتم القسمة"],["=\\frac12\\ln|\\sin^2x|","متطابقة تقليص القوة <span class=\"tx\" data-t=\"\\sin^2x=\\frac{1-\\cos2x}{2}\"></span>"],["=\\frac12\\cdot2\\ln|\\sin x|=\\ln|\\sin x|","لوغاريتم القوة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"36","s":[["x=\\cos\\theta,\\quad y=\\sin\\theta","الرأس العلوي على نصف الدائرة التي نصف قطرها <span class=m dir=ltr>1</span>"],["\\text{width}=2x=2\\cos\\theta,\\quad \\text{height}=y=\\sin\\theta","المستطيل متماثل حول المركز"],["A(\\theta)=2\\cos\\theta\\sin\\theta,\\quad 0<\\theta<\\frac{\\pi}{2}","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"]],"a":"<span class=\"tx\" data-t=\"A(\\theta)=2\\sin\\theta\\cos\\theta\"></span>","o":""},{"n":"37","s":[["A(\\theta)=2\\sin\\theta\\cos\\theta","من السؤال <span class=m dir=ltr>36</span>"],["=\\sin2\\theta","متطابقة ضعف الزاوية"]],"a":"<span class=\"tx\" data-t=\"A(\\theta)=\\sin2\\theta\"></span> (وأكبر مساحة <span class=m dir=ltr>1</span> عندما <span class=\"tx\" data-t=\"\\theta=\\frac{\\pi}{4}\"></span>)","o":""}],[{"n":"38","s":[["\\cos4x=1-2\\sin^22x","متطابقة ضعف الزاوية"],["=1-2(2\\sin x\\cos x)^2","متطابقة ضعف الزاوية للجيب"],["=1-8\\sin^2x\\cos^2x","بالتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"39","s":[["\\cos^2x\\sin^4x=(\\sin x\\cos x)^2\\sin^2x=\\frac{\\sin^22x}{4}\\cdot\\sin^2x","متطابقة ضعف الزاوية"],["=\\frac14\\cdot\\frac{1-\\cos4x}{2}\\cdot\\frac{1-\\cos2x}{2}=\\frac{(1-\\cos4x)(1-\\cos2x)}{16}","متطابقات تقليص القوة"],["=\\frac{1-\\cos2x-\\cos4x+\\cos4x\\cos2x}{16}","بالتوزيع"],["\\cos4x\\cos2x=\\frac12(\\cos2x+\\cos6x)","تحويل الضرب إلى جمع"],["=\\frac{1-\\frac12\\cos2x-\\cos4x+\\frac12\\cos6x}{16}=\\frac{1}{32}(2-\\cos2x-2\\cos4x+\\cos6x)","بالتبسيط"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"11","s":[["3\\cos37.5^\\circ\\sin37.5^\\circ=\\frac32(2\\sin37.5^\\circ\\cos37.5^\\circ)=\\frac32\\sin75^\\circ","متطابقة ضعف الزاوية"],["\\sin75^\\circ=\\sin(45^\\circ+30^\\circ)=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12=\\frac{\\sqrt6+\\sqrt2}{4}","متطابقة الجيب لمجموع زاويتين"],["\\frac32\\cdot\\frac{\\sqrt6+\\sqrt2}{4}=\\frac{3(\\sqrt6+\\sqrt2)}{8}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{3(\\sqrt6+\\sqrt2)}{8}\"></span>","o":"","k":[{"e":"3*sqrt(2)/8 + 3*sqrt(6)/8","a":null}]},{"n":"12","s":[["\\cos\\frac{\\pi}{12}+\\cos\\frac{5\\pi}{12}=2\\cos\\frac{\\frac{\\pi}{12}+\\frac{5\\pi}{12}}{2}\\cos\\frac{\\frac{\\pi}{12}-\\frac{5\\pi}{12}}{2}","متطابقة تحويل الجمع إلى ضرب"],["=2\\cos\\frac{\\pi}{4}\\cos\\left(-\\frac{\\pi}{6}\\right)=2\\cdot\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}",""],["=\\frac{\\sqrt6}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt6}{2}\"></span>","o":"","k":[{"e":"sqrt(6)/2","a":null}]},{"n":"13","s":[["\\cos255^\\circ-\\cos195^\\circ=-2\\sin\\frac{255^\\circ+195^\\circ}{2}\\sin\\frac{255^\\circ-195^\\circ}{2}","متطابقة تحويل الفرق إلى ضرب"],["=-2\\sin225^\\circ\\sin30^\\circ=-2\\left(-\\frac{\\sqrt2}{2}\\right)\\left(\\frac12\\right)",""],["=\\frac{\\sqrt2}{2}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt2}{2}\"></span>","o":"","k":[{"e":"sqrt(2)/2","a":null}]}],[{"n":"14","s":[["\\text{diagonal}=20","قطر المستطيل هو قطر الدائرة"],["\\text{side}_1=20\\cos\\theta,\\quad \\text{side}_2=20\\sin\\theta","في المثلث القائم الذي وتره القطر والزاوية <span class=\"tx\" data-t=\"\\theta\"></span>"],["A=(20\\cos\\theta)(20\\sin\\theta)=400\\sin\\theta\\cos\\theta","مساحة المستطيل <span class=m dir=ltr>=</span> الطول <span class=m dir=ltr>×</span> العرض"],["=200(2\\sin\\theta\\cos\\theta)=200\\sin2\\theta","متطابقة ضعف الزاوية"]],"a":"<span class=\"tx\" data-t=\"A(\\theta)=200\\sin2\\theta\"></span> كما هو مطلوب","o":""}],[{"n":"15","s":[["\\sin(x+y)-\\sin(x-y)=2\\cos x\\sin y","متطابقتا الجيب للمجموع والفرق (أو تحويل الفرق إلى ضرب)"],["\\cos(x+y)+\\cos(x-y)=2\\cos x\\cos y","متطابقتا جيب التمام للمجموع والفرق"],["\\frac{2\\cos x\\sin y}{2\\cos x\\cos y}=\\frac{\\sin y}{\\cos y}=\\tan y","بالاختصار ومتطابقة النسبة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"16","s":[["\\sin^6x+\\cos^6x=(\\sin^2x+\\cos^2x)^3-3\\sin^2x\\cos^2x(\\sin^2x+\\cos^2x)","<span class=\"tx\" data-t=\"a^3+b^3=(a+b)^3-3ab(a+b)\"></span>"],["=1-3\\sin^2x\\cos^2x","المتطابقة الفيثاغورية"],["=1-\\frac34(2\\sin x\\cos x)^2=1-\\frac34\\sin^22x","متطابقة ضعف الزاوية"],["4(\\sin^6x+\\cos^6x)=4-3\\sin^22x","بضرب الطرفين في <span class=m dir=ltr>4</span>"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"17","s":[["\\frac12(\\ln|1+\\cos2x|-\\ln2)=\\frac12\\ln\\left|\\frac{1+\\cos2x}{2}\\right|","نبدأ بالطرف الأيمن؛ لوغاريتم القسمة"],["=\\frac12\\ln|\\cos^2x|","متطابقة تقليص القوة"],["=\\frac12\\cdot2\\ln|\\cos x|=\\ln|\\cos x|","لوغاريتم القوة"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"18","s":[["\\sec2x=\\frac{1}{\\cos2x}=\\frac{1}{2\\cos^2x-1}","متطابقتا المقلوب وضعف الزاوية"],["=\\frac{1\\cdot\\sec^2x}{(2\\cos^2x-1)\\sec^2x}=\\frac{\\sec^2x}{2-\\sec^2x}","بضرب البسط والمقام في <span class=\"tx\" data-t=\"\\sec^2x\"></span>"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""},{"n":"19","s":[["\\csc x-\\cot x=\\frac{1}{\\sin x}-\\frac{\\cos x}{\\sin x}=\\frac{1-\\cos x}{\\sin x}","نبدأ بالطرف الأيمن؛ متطابقتا المقلوب والنسبة"],["=\\tan\\frac{x}{2}","متطابقة نصف الزاوية للظل"]],"a":"الطرفان متساويان، فالمتطابقة صحيحة","o":""}],[{"n":"31","s":[["\\cos^25x-\\sin^25x=\\cos(2\\cdot5x)","متطابقة ضعف الزاوية"],["=\\cos10x",""]],"a":"<span class=\"tx\" data-t=\"\\cos10x\"></span>","o":"","k":[{"e":"cos(10*x)","a":null}]},{"n":"32","s":[["2\\sin\\frac{x}{2}\\cos\\frac{x}{2}=\\sin\\left(2\\cdot\\frac{x}{2}\\right)","متطابقة ضعف الزاوية"],["=\\sin x",""]],"a":"<span class=\"tx\" data-t=\"\\sin x\"></span>","o":"","k":[{"e":"sin(x)","a":null}]},{"n":"33","s":[["\\frac{1-\\cos8x}{2}=\\sin^24x","متطابقة تقليص القوة (نصف الزاوية) مع <span class=\"tx\" data-t=\"8x=2(4x)\"></span>"],["\\sqrt{\\sin^24x}=|\\sin4x|","الجذر التربيعي لمربع"]],"a":"<span class=\"tx\" data-t=\"|\\sin4x|\"></span>","o":"","k":[{"e":"Abs(sin(4*x))","a":null}]}],[{"n":"1","s":[["2\\sin3x\\cos3x=\\sin(2\\cdot3x)","متطابقة ضعف الزاوية <span class=\"tx\" data-t=\"\\sin2A=2\\sin A\\cos A\"></span>"],["=\\sin6x",""]],"a":"<span class=\"tx\" data-t=\"\\sin6x\"></span>","o":"","k":[{"e":"sin(6*x)","a":null}]},{"n":"2","s":[["\\frac{2\\tan7x}{1-\\tan^27x}=\\tan(2\\cdot7x)","متطابقة ضعف الزاوية للظل"],["=\\tan14x",""]],"a":"<span class=\"tx\" data-t=\"\\tan14x\"></span>","o":"","k":[{"e":"tan(14*x)","a":null}]},{"n":"3","s":[["\\frac{1-\\cos4x}{\\sin4x}=\\tan\\frac{4x}{2}","متطابقة نصف الزاوية للظل <span class=\"tx\" data-t=\"\\tan\\frac{A}{2}=\\frac{1-\\cos A}{\\sin A}\"></span>"],["=\\tan2x",""]],"a":"<span class=\"tx\" data-t=\"\\tan2x\"></span>","o":"","k":[{"e":"tan(2*x)","a":null}]}],[{"n":"4","s":[["\\frac{2\\tan15^\\circ}{1-\\tan^215^\\circ}=\\tan30^\\circ","متطابقة ضعف الزاوية للظل"],["=\\frac{\\sqrt3}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt3}{3}\"></span>","o":"","k":[{"e":"sqrt(3)/3","a":null}]},{"n":"5","s":[["\\sin\\frac{\\pi}{8}\\cos\\frac{\\pi}{8}=\\frac12\\left(2\\sin\\frac{\\pi}{8}\\cos\\frac{\\pi}{8}\\right)=\\frac12\\sin\\frac{\\pi}{4}","متطابقة ضعف الزاوية"],["=\\frac12\