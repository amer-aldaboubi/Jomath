[[{"n":"1","s":[["","المتغيّر المستقل <span class=\"tx\" data-t=\"x\"></span>: عدد الجولات، والمتغيّر التابع <span class=\"tx\" data-t=\"y\"></span>: عدد القطع المبيعة؛ لأنّ عدد القطع المبيعة يعتمد على عدد الجولات"],["(20,30),(40,20),(10,50),(18,35),(50,60)","نعيّن الأزواج المرتّبة (الجولات، القطع) في المستوى الإحداثي"],["(20,50),(50,30),(15,20),(30,40),(10,25)","بقية الأزواج المرتّبة"]],"a":"المستقل: عدد الجولات (المحور <span class=\"tx\" data-t=\"x\"></span>)، التابع: عدد القطع المبيعة (المحور <span class=\"tx\" data-t=\"y\"></span>)، ويُرسم شكل انتشار بالنقاط العشر أعلاه","o":"تدريج مقترح: المحور <span class=\"tx\" data-t=\"x\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>60 (</span>كل مربع <span class=m dir=ltr>5)</span>، والمحور <span class=\"tx\" data-t=\"y\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>70 (</span>كل مربع <span class=m dir=ltr>5)</span>."},{"n":"2","s":[["","النقاط متناثرة ولا تقترب من خط مستقيم واضح، مع ميل خفيف جدًّا نحو الأعلى"],["r\\approx 0.16","للتحقق (اختياري): معامل ارتباط بيرسون قريب من الصفر"]],"a":"يوجد ارتباط موجب ضعيف جدًّا (يكاد لا يوجد ارتباط) بين عدد الجولات وعدد القطع المبيعة؛ أي إنّ زيادة عدد الجولات لا تؤدّي بالضرورة إلى زيادة عدد القطع المبيعة","o":""}],[{"n":"3","s":[["","المتغيّر المستقل <span class=\"tx\" data-t=\"x\"></span>: درجة الحرارة وقت الظهيرة، والمتغيّر التابع <span class=\"tx\" data-t=\"y\"></span>: عدد حبّات المثلّجات المبيعة؛ لأنّ المبيعات تعتمد على درجة الحرارة"],["(20,70),(28,86),(18,58),(24,76),(30,97),(22,78),(21,65)","نعيّن الأزواج المرتّبة (الحرارة، عدد الحبّات)"],["(16,58),(29,91),(19,63),(27,93),(26,91),(23,79),(27,82)","بقية الأزواج المرتّبة"]],"a":"المستقل: درجة الحرارة (المحور <span class=\"tx\" data-t=\"x\"></span>)، التابع: عدد حبّات المثلّجات المبيعة (المحور <span class=\"tx\" data-t=\"y\"></span>)، ويُرسم شكل انتشار بالنقاط الأربع عشرة أعلاه","o":"تدريج مقترح: <span class=\"tx\" data-t=\"x\"></span> من <span class=m dir=ltr>14</span> إلى <span class=m dir=ltr>32</span>، و<span class=\"tx\" data-t=\"y\"></span> من <span class=m dir=ltr>50</span> إلى <span class=m dir=ltr>100</span>."},{"n":"4","s":[["","النقاط تتجمّع قريبًا من خط مستقيم ميله موجب (تتّجه من أسفل اليسار إلى أعلى اليمين)"],["r\\approx 0.95","للتحقق (اختياري): قيمة <span class=\"tx\" data-t=\"r\"></span> قريبة من <span class=m dir=ltr>1</span>"]],"a":"يوجد ارتباط موجب قوي؛ أي إنّه كلّما ارتفعت درجة الحرارة وقت الظهيرة زاد عدد حبّات المثلّجات التي يبيعها محمود بوجه عام","o":""}],[{"n":"5","s":[["","المتغيّر المستقل <span class=\"tx\" data-t=\"x\"></span>: البعد عن مركز المدينة <span class=m dir=ltr>(km)</span>، والمتغيّر التابع <span class=\"tx\" data-t=\"y\"></span>: الكثافة السكّانية؛ لأنّ الكثافة تعتمد على موقع المنطقة"],["(0.6,4700),(3.8,2300),(3,2000),(2,3300),(1.7,3900)","نعيّن الأزواج المرتّبة (البعد، الكثافة)"],["(1.9,2400),(3.5,1800),(4,1600),(2.5,2400),(1,3500)","بقية الأزواج المرتّبة"]],"a":"المستقل: البعد عن مركز المدينة (المحور <span class=\"tx\" data-t=\"x\"></span>)، التابع: الكثافة السكّانية (المحور <span class=\"tx\" data-t=\"y\"></span>)، ويُرسم شكل انتشار بالنقاط العشر أعلاه","o":"تدريج مقترح: <span class=\"tx\" data-t=\"x\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>4.5 (</span>كل مربع <span class=m dir=ltr>0.5)</span>، و<span class=\"tx\" data-t=\"y\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>5000 (</span>كل مربع <span class=m dir=ltr>500)</span>."},{"n":"6","s":[["","النقاط تتّجه من أعلى اليسار إلى أسفل اليمين، وتقترب من خط مستقيم ميله سالب"],["r\\approx -0.89","للتحقق (اختياري): قيمة <span class=\"tx\" data-t=\"r\"></span> قريبة من <span class=\"tx\" data-t=\"-1\"></span>"]],"a":"يوجد ارتباط سالب قوي؛ أي إنّه كلّما زاد بعد المنطقة عن مركز المدينة قلّت الكثافة السكّانية فيها بوجه عام","o":""}],[{"n":"7","s":[["\\sum x_i=414,\\ \\sum y_i=411,\\ \\sum x_iy_i=24757,\\ \\sum x_i^2=25668,\\ \\sum y_i^2=24287","ننشئ جدولًا بالأعمدة <span class=\"tx\" data-t=\"x, y, xy, x^2, y^2\"></span> ونجد المجاميع، <span class=\"tx\" data-t=\"n=8\"></span>"],["S_{xy}=24757-\\frac{(414)(411)}{8}=3487.75","بالتعويض في صيغة <span class=\"tx\" data-t=\"S_{xy}\"></span>"],["S_{xx}=25668-\\frac{(414)^2}{8}=4243.5","بالتعويض في صيغة <span class=\"tx\" data-t=\"S_{xx}\"></span>"],["S_{yy}=24287-\\frac{(411)^2}{8}=3171.875","بالتعويض في صيغة <span class=\"tx\" data-t=\"S_{yy}\"></span>"],["r=\\frac{S_{xy}}{\\sqrt{S_{xx}S_{yy}}}=\\frac{3487.75}{\\sqrt{(4243.5)(3171.875)}}\\approx 0.95","صيغة معامل ارتباط بيرسون، واستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"r\\approx 0.95\"></span>: ارتباط موجب قوي جدًّا بين التكلفة التقديرية والتكلفة الفعلية؛ أي إنّ تقديرات الموظفين دقيقة إلى حدٍّ كبير (كلّما زادت التكلفة التقديرية زادت الفعلية)","o":""}],[{"n":"8","s":[["","المتغيّر المستقل <span class=\"tx\" data-t=\"x\"></span>: عدد وحدات المكمّل الغذائي، والمتغيّر التابع <span class=\"tx\" data-t=\"y\"></span>: الإنتاج <span class=m dir=ltr>(L)</span>؛ لأنّ كمية الحليب تعتمد على عدد الوحدات"],["(1,18),(2,19),(3,20),(4,21),(5,21)","نعيّن الأزواج المرتّبة"],["(6,22),(7,24),(8,24),(9,23),(10,23)","بقية الأزواج المرتّبة"]],"a":"المستقل: عدد الوحدات (المحور <span class=\"tx\" data-t=\"x\"></span>)، التابع: الإنتاج باللتر (المحور <span class=\"tx\" data-t=\"y\"></span>)، ويُرسم شكل انتشار بالنقاط العشر أعلاه","o":"تدريج مقترح: <span class=\"tx\" data-t=\"x\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>10</span>، و<span class=\"tx\" data-t=\"y\"></span> من <span class=m dir=ltr>16</span> إلى <span class=m dir=ltr>25</span>."},{"n":"9","s":[["","النقاط تتّجه إلى الأعلى بوجه عام؛ فيوجد ارتباط موجب قوي"],["","يزداد الإنتاج بانتظام تقريبًا حتى <span class=m dir=ltr>7</span> وحدات، ثم يثبت أو ينقص قليلًا <span class=m dir=ltr>(24, 24, 23, 23)</span>"]],"a":"إجابة ممكنة: المكمّل الغذائي يزيد إنتاج الحليب (ارتباط موجب قوي)، لكنّ الزيادة تتوقّف تقريبًا بعد <span class=m dir=ltr>7</span> وحدات؛ فلا فائدة كبيرة من إعطاء البقرة أكثر من <span class=m dir=ltr>7</span> وحدات تقريبًا","o":""},{"n":"10","s":[["\\sum x_i=28,\\ \\sum y_i=145,\\ \\sum x_iy_i=605,\\ \\sum x_i^2=140,\\ \\sum y_i^2=3027","بيانات البقرات السبع الأولى، <span class=\"tx\" data-t=\"n=7\"></span>"],["S_{xy}=605-\\frac{(28)(145)}{7}=25","صيغة <span class=\"tx\" data-t=\"S_{xy}\"></span>"],["S_{xx}=140-\\frac{(28)^2}{7}=28","صيغة <span class=\"tx\" data-t=\"S_{xx}\"></span>"],["S_{yy}=3027-\\frac{(145)^2}{7}\\approx 23.43","صيغة <span class=\"tx\" data-t=\"S_{yy}\"></span>"],["r=\\frac{25}{\\sqrt{(28)(23.43)}}\\approx 0.98","صيغة معامل ارتباط بيرسون"]],"a":"<span class=\"tx\" data-t=\"r\\approx 0.98\"></span>: ارتباط موجب قوي جدًّا (قريب من التام)؛ أي إنّه كلّما زاد عدد وحدات المكمّل (حتى <span class=m dir=ltr>7</span> وحدات) زاد إنتاج الحليب","o":""}],[{"n":"11","s":[["\\sum x_i=415,\\ \\sum y_i=55.2,\\ \\sum x_iy_i=4475.5,\\ \\sum x_i^2=37525","ننشئ جدولًا بالأعمدة <span class=\"tx\" data-t=\"x, y, xy, x^2\"></span>، <span class=\"tx\" data-t=\"n=5\"></span>"],["S_{xy}=4475.5-\\frac{(415)(55.2)}{5}=-106.1","صيغة <span class=\"tx\" data-t=\"S_{xy}\"></span>"],["S_{xx}=37525-\\frac{(415)^2}{5}=3080","صيغة <span class=\"tx\" data-t=\"S_{xx}\"></span>"],["\\bar{x}=\\frac{415}{5}=83,\\quad \\bar{y}=\\frac{55.2}{5}=11.04","الوسط الحسابي لكلٍّ من <span class=\"tx\" data-t=\"x\"></span> و<span class=\"tx\" data-t=\"y\"></span>"],["m=\\frac{-106.1}{3080}\\approx -0.0344","صيغة الميل"],["b=11.04-(-0.0344)(83)\\approx 13.9","صيغة المقطع"]],"a":"<span class=\"tx\" data-t=\"y=-0.0344x+13.9\"></span>","o":"","k":[{"e":"13.9 - 0.0344*x","a":true}]},{"n":"12","s":[["y=-0.0344(70)+13.9","بتعويض <span class=\"tx\" data-t=\"x=70\"></span> في معادلة خط الانحدار"],["\\approx 11.49","باستعمال الآلة الحاسبة"]],"a":"معدل استهلاك الوقود المتوقَّع <span class=\"tx\" data-t=\"\\approx 11.5\\ \\text{km/L}\"></span>","o":"","k":[{"e":"11.5","a":true}]},{"n":"13","s":[["m=-0.0344","الميل سالب"],["b=13.9","المقطع"]],"a":"يدلّ الميل على أنّ معدل استهلاك الوقود يقلّ بمقدار <span class=\"tx\" data-t=\"0.0344\\ \\text{km/L}\"></span> تقريبًا لكل زيادة مقدارها <span class=\"tx\" data-t=\"1\\ \\text{km/h}\"></span> في السرعة. ويدلّ المقطع <span class=\"tx\" data-t=\"13.9\"></span> على معدل الاستهلاك عندما تكون السرعة صفرًا، وهذا غير منطقي لأنّ السيارة لا تتحرّك","o":""}],[{"n":"14","s":[["S_{xx}=1960-\\frac{(109)^2}{10}=771.9","صيغة <span class=\"tx\" data-t=\"S_{xx}\"></span>"],["m=\\frac{S_{xy}}{S_{xx}}\\Rightarrow 0.7=\\frac{S_{xy}}{771.9}","الميل من معادلة خط الانحدار <span class=\"tx\" data-t=\"m=0.7\"></span>"],["S_{xy}=0.7(771.9)=540.33","بضرب الطرفين في <span class=m dir=ltr>771.9</span>"],["540.33=\\sum x_iy_i-\\frac{(109)(120)}{10}","صيغة <span class=\"tx\" data-t=\"S_{xy}\"></span>"],["\\sum x_iy_i=540.33+1308=1848.33","بإضافة <span class=m dir=ltr>1308</span> إلى الطرفين"]],"a":"<span class=\"tx\" data-t=\"\\sum x_iy_i=1848.33\"></span>","o":""},{"n":"15","s":[["S_{yy}=2145-\\frac{(120)^2}{10}=705","صيغة <span class=\"tx\" data-t=\"S_{yy}\"></span>"],["r=\\frac{540.33}{\\sqrt{(771.9)(705)}}","صيغة معامل ارتباط بيرسون"],["\\approx 0.73","باستعمال الآلة الحاسبة"]],"a":"<span class=\"tx\" data-t=\"r\\approx 0.73\"></span> (ارتباط موجب قوي نسبيًّا)","o":"","k":[{"e":"0.73","a":true}]}],[{"n":"16","s":[["r=-0.31","سالب وضعيف: النقاط متناثرة مع اتجاه خفيف نحو الأسفل"]],"a":"<span class=m dir=ltr>D</span>","o":""},{"n":"17","s":[["r=-0.94","سالب قوي: النقاط قريبة من خط ميله سالب"]],"a":"<span class=m dir=ltr>B</span>","o":""},{"n":"18","s":[["r=0.55","موجب متوسط القوة: النقاط تتّجه إلى الأعلى لكنّها متناثرة نسبيًّا"]],"a":"<span class=m dir=ltr>C</span>","o":""},{"n":"19","s":[["r=0.97","موجب قوي جدًّا: النقاط قريبة جدًّا من خط ميله موجب"]],"a":"<span class=m dir=ltr>A</span>","o":""}],[{"n":"20","s":[["r=-0.86","الإشارة سالبة والقيمة قريبة من <span class=\"tx\" data-t=\"-1\"></span>"]],"a":"يوجد ارتباط سالب قوي بين عمر الموظف وعدد الأخطاء؛ أي إنّه كلّما زاد عمر الموظف قلّ عدد الأخطاء التي يقع فيها عند إدخال البيانات بوجه عام","o":""}],[{"n":"21","s":[["x\\uparrow \\Rightarrow y\\uparrow","الارتباط بين <span class=\"tx\" data-t=\"x\"></span> و<span class=\"tx\" data-t=\"y\"></span> موجب"],["y\\uparrow \\Rightarrow z\\downarrow","الارتباط بين <span class=\"tx\" data-t=\"y\"></span> و<span class=\"tx\" data-t=\"z\"></span> سالب"],["z\\downarrow \\Rightarrow w\\downarrow","الارتباط بين <span class=\"tx\" data-t=\"z\"></span> و<span class=\"tx\" data-t=\"w\"></span> موجب"],["x\\uparrow \\Rightarrow w\\downarrow","إذن زيادة <span class=\"tx\" data-t=\"x\"></span> ترتبط بنقصان <span class=\"tx\" data-t=\"w\"></span>"]],"a":"الارتباط بين <span class=\"tx\" data-t=\"x\"></span> و<span class=\"tx\" data-t=\"w\"></span> سالب (بوجه عام)؛ لأنّ زيادة <span class=\"tx\" data-t=\"x\"></span> تصاحبها زيادة <span class=\"tx\" data-t=\"y\"></span>، فنقصان <span class=\"tx\" data-t=\"z\"></span>، فنقصان <span class=\"tx\" data-t=\"w\"></span>","o":""}],[{"n":"22","s":[["","النقاط في شكل الانتشار تتّجه بوجه عام من أعلى اليسار إلى أسفل اليمين؛ فالارتباط سالب"],["m=0.063>0","لكنّ ميل المعادلة التي وضعتها ميسون موجب"]],"a":"المعادلة غير صحيحة؛ لأنّ الارتباط سالب، فيجب أن يكون ميل خط الانحدار <span class=\"tx\" data-t=\"m\"></span> سالبًا، لا موجبًا كما في <span class=\"tx\" data-t=\"y=0.063x+16.1\"></span>","o":""}],[{"n":"23","s":[["(10,35),(20,55),(30,40),(35,100)","نعيّن الأزواج المرتّبة (النسبة المئوية، السعر)"],["(40,60),(50,90),(60,110),(70,130)","بقية الأزواج المرتّبة"]],"a":"شكل انتشار بالنقاط الثماني أعلاه: النسبة المئوية على المحور <span class=\"tx\" data-t=\"x\"></span>، والسعر بالقرش على المحور <span class=\"tx\" data-t=\"y\"></span>","o":"تدريج مقترح: <span class=\"tx\" data-t=\"x\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>80 (</span>كل مربع <span class=m dir=ltr>10)</span>، و<span class=\"tx\" data-t=\"y\"></span> من <span class=m dir=ltr>0</span> إلى <span class=m dir=ltr>140 (</span>كل مربع <span class=m dir=ltr>10)</span>. النقطة <span class=\"tx\" data-t=\"(35,100)\"></span> تبدو بعيدة عن نمط بقية النقاط."},{"n":"24","s":[["\\sum x_i=315,\\ \\sum y_i=620,\\ \\sum x_iy_i=28750,\\ \\sum x_i^2=15225","ننشئ جدولًا بالأعمدة <span class=\"tx\" data-t=\"x, y, xy, x^2\"></span>، <span class=\"tx\" data-t=\"n=8\"></span>"],["S_{xy}=28750-\\frac{(315)(620)}{8}=4337.5","صيغة <span class=\"tx\" data-t=\"S_{xy}\"></span>"],["S_{xx}=15225-\\frac{(315)^2}{8}=2821.875","صيغة <span class=\"tx\" data-t=\"S_{xx}\"></span>"],["\\bar{x}=\\frac{315}{8}=39.375,\\quad \\bar{y}=\\frac{620}{8}=77.5","الوسطان الحسابيان"],["m=\\frac{4337.5}{2821.875}\\approx 1.54","صيغة الميل"],["b=77.5-1.54(39.375)\\approx 16.86","صيغة المقطع"]],"a":"<span class=\"tx\" data-t=\"y=1.54x+16.86\"></span>","o":"","k":[{"e":"1.54*x + 16.86","a":true}]},{"n":"25","s":[["\\sum y_i^2=56550","نضيف العمود <span class=\"tx\" data-t=\"y^2\"></span> إلى الجدول"],["S_{yy}=56550-\\frac{(620)^2}{8}=8500","صيغة <span class=\"tx\" data-t=\"S_{yy}\"></span>"],["r=\\frac{4337.5}{\\sqrt{(2821.875)(8500)}}\\approx 0.89","صيغة معامل ارتباط بيرسون"]],"a":"<span class=\"tx\" data-t=\"r\\approx 0.89\"></span>: ارتباط موجب قوي؛ أي إنّه كلّما زادت نسبة مسحوق الكاكاو الخام في قطعة الشوكولاتة زاد سعرها بوجه عام","o":""},{"n":"26","s":[["","النقطة <span class=\"tx\" data-t=\"(35,100)\"></span> للعلامة <span class=m dir=ltr>D</span> تقع بعيدًا فوق نمط بقية النقاط؛ فسعرها أعلى من سعر علامات نسبتها أكبر <span class=m dir=ltr>(E</span>: <span class=m dir=ltr>40%</span> بسعر <span class=m dir=ltr>60</span> قرشًا، <span class=m dir=ltr>F</span>: <span class=m dir=ltr>50%</span> بسعر <span class=m dir=ltr>90</span> قرشًا)"],["y=1.54(35)+16.86\\approx 70.76","بتعويض <span class=\"tx\" data-t=\"x=35\"></span> في معادلة خط الانحدار"]],"a":"العلامة التجارية <span class=m dir=ltr>D</span>، والسعر العادل المقترح نحو <span class=m dir=ltr>71</span> قرشًا (إجابة ممكنة: بين <span class=m dir=ltr>60</span> و<span class=m dir=ltr>75</span> قرشًا)؛ لأنّ نسبة الكاكاو فيها <span class=m dir=ltr>35%</span> فقط، وهي تقع بين <span class=m dir