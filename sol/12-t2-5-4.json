[[{"n":"1","s":[["u=x+1,\\ dv=\\cos x\\,dx\\Rightarrow du=dx,\\ v=\\sin x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int(x+1)\\cos x\\,dx=(x+1)\\sin x-\\int\\sin x\\,dx","صيغة التكامل بالأجزاء"],["=(x+1)\\sin x+\\cos x+C",""]],"a":"<span class=\"tx\" data-t=\"(x+1)\\sin x+\\cos x+C\"></span>","o":"","k":[{"e":"C + (x + 1)*sin(x) + cos(x)","a":null}]},{"n":"2","s":[["u=x,\\ dv=e^{x/2}dx\\Rightarrow du=dx,\\ v=2e^{x/2}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int xe^{x/2}dx=2xe^{x/2}-\\int2e^{x/2}dx","صيغة التكامل بالأجزاء"],["=2xe^{x/2}-4e^{x/2}+C",""]],"a":"<span class=\"tx\" data-t=\"2xe^{x/2}-4e^{x/2}+C=2e^{x/2}(x-2)+C\"></span>","o":""},{"n":"3","s":[["u=2x^2-1,\\ dv=e^{-x}dx\\Rightarrow du=4x\\,dx,\\ v=-e^{-x}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int(2x^2-1)e^{-x}dx=-(2x^2-1)e^{-x}+\\int4xe^{-x}dx","صيغة التكامل بالأجزاء"],["\\int4xe^{-x}dx=-4xe^{-x}+\\int4e^{-x}dx=-4xe^{-x}-4e^{-x}","بالأجزاء مرة ثانية: <span class=\"tx\" data-t=\"u=4x,\\ dv=e^{-x}dx\"></span>"],["=-(2x^2-1)e^{-x}-4xe^{-x}-4e^{-x}+C","بالتجميع"]],"a":"<span class=\"tx\" data-t=\"-e^{-x}(2x^2+4x+3)+C\"></span>","o":"","k":[{"e":"C - (2*x^2 + 4*x + 3)*exp(-x)","a":null}]},{"n":"4","s":[["u=\\ln(1+x),\\ dv=x\\,dx\\Rightarrow du=\\frac{dx}{1+x},\\ v=\\frac{x^2}{2}","الاقتران اللوغاريتمي هو <span class=\"tx\" data-t=\"u\"></span>"],["\\int x\\ln(1+x)dx=\\frac{x^2}{2}\\ln(1+x)-\\frac12\\int\\frac{x^2}{1+x}dx","صيغة التكامل بالأجزاء"],["\\frac{x^2}{1+x}=x-1+\\frac{1}{1+x}","بالقسمة الطويلة"],["=\\frac{x^2}{2}\\ln(1+x)-\\frac12\\left(\\frac{x^2}{2}-x+\\ln(1+x)\\right)+C",""]],"a":"<span class=\"tx\" data-t=\"\\dfrac{x^2-1}{2}\\ln(1+x)-\\dfrac{x^2}{4}+\\dfrac{x}{2}+C\"></span>","o":"","k":[{"e":"C - x^2/4 + x/2 + (x^2/2 - 1/2)*log(x + 1)","a":null}]},{"n":"5","s":[["x\\sin x\\cos x=\\frac12x\\sin2x","متطابقة ضعف الزاوية"],["u=x,\\ dv=\\sin2x\\,dx\\Rightarrow du=dx,\\ v=-\\frac12\\cos2x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\frac12\\int x\\sin2x\\,dx=\\frac12\\left(-\\frac x2\\cos2x+\\frac12\\int\\cos2x\\,dx\\right)","صيغة التكامل بالأجزاء"],["=-\\frac x4\\cos2x+\\frac18\\sin2x+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{x}{4}\\cos2x+\\frac18\\sin2x+C\"></span>","o":"","k":[{"e":"C - x*cos(2*x)/4 + sin(2*x)/8","a":null}]},{"n":"6","s":[["u=x,\\ dv=\\sec x\\tan x\\,dx\\Rightarrow du=dx,\\ v=\\sec x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\sec x\\tan x\\,dx=x\\sec x-\\int\\sec x\\,dx","صيغة التكامل بالأجزاء"],["=x\\sec x-\\ln|\\sec x+\\tan x|+C","<span class=\"tx\" data-t=\"\\int\\sec x\\,dx=\\ln|\\sec x+\\tan x|\"></span>"]],"a":"<span class=\"tx\" data-t=\"x\\sec x-\\ln|\\sec x+\\tan x|+C\"></span>","o":""}],[{"n":"7","s":[["\\frac{x}{\\sin^2x}=x\\csc^2x;\\quad u=x,\\ dv=\\csc^2x\\,dx\\Rightarrow v=-\\cot x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\csc^2x\\,dx=-x\\cot x+\\int\\cot x\\,dx","صيغة التكامل بالأجزاء"],["=-x\\cot x+\\ln|\\sin x|+C","<span class=\"tx\" data-t=\"\\int\\cot x\\,dx=\\ln|\\sin x|\"></span>"]],"a":"<span class=\"tx\" data-t=\"-x\\cot x+\\ln|\\sin x|+C\"></span>","o":""},{"n":"8","s":[["u=\\ln x,\\ dv=x^{-3}dx\\Rightarrow du=\\frac{dx}{x},\\ v=-\\frac{1}{2x^2}","الاقتران اللوغاريتمي هو <span class=\"tx\" data-t=\"u\"></span>"],["\\int\\frac{\\ln x}{x^3}dx=-\\frac{\\ln x}{2x^2}+\\int\\frac{1}{2x^3}dx","صيغة التكامل بالأجزاء"],["=-\\frac{\\ln x}{2x^2}-\\frac{1}{4x^2}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\dfrac{\\ln x}{2x^2}-\\dfrac{1}{4x^2}+C=-\\dfrac{2\\ln x+1}{4x^2}+C\"></span>","o":"","k":[{"e":"C - (2*log(x) + 1)/(4*x^2)","a":null}]},{"n":"9","s":[["u=2x^2,\\ dv=\\sec^2x\\tan x\\,dx\\Rightarrow du=4x\\,dx,\\ v=\\frac12\\sec^2x","لأنّ <span class=\"tx\" data-t=\"\\frac{d}{dx}\\left(\\frac12\\sec^2x\\right)=\\sec^2x\\tan x\"></span>"],["\\int2x^2\\sec^2x\\tan x\\,dx=x^2\\sec^2x-\\int2x\\sec^2x\\,dx","صيغة التكامل بالأجزاء"],["\\int2x\\sec^2x\\,dx=2x\\tan x-\\int2\\tan x\\,dx=2x\\tan x+2\\ln|\\cos x|","بالأجزاء مرة ثانية: <span class=\"tx\" data-t=\"u=2x,\\ dv=\\sec^2x\\,dx\"></span>"],["=x^2\\sec^2x-2x\\tan x-2\\ln|\\cos x|+C","بالتجميع"]],"a":"<span class=\"tx\" data-t=\"x^2\\sec^2x-2x\\tan x-2\\ln|\\cos x|+C\"></span>","o":"إجابة مكافئة: <span class=\"tx\" data-t=\"x^2\\tan^2x-2x\\tan x-2\\ln|\\cos x|+C\"></span> (تختلف بثابت)."},{"n":"10","s":[["u=x-2,\\ dv=\\sqrt{8-x}\\,dx\\Rightarrow du=dx,\\ v=-\\frac23(8-x)^{3/2}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int(x-2)\\sqrt{8-x}\\,dx=-\\frac23(x-2)(8-x)^{3/2}+\\frac23\\int(8-x)^{3/2}dx","صيغة التكامل بالأجزاء"],["\\frac23\\int(8-x)^{3/2}dx=-\\frac{4}{15}(8-x)^{5/2}","قاعدة القوة مع قسمة على مشتقة ما داخل القوس <span class=\"tx\" data-t=\"(-1)\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac23(x-2)(8-x)^{3/2}-\\frac{4}{15}(8-x)^{5/2}+C\"></span>","o":"","k":[{"e":"C + (4/3 - 2*x/3)*(8 - x)^(3/2) - 4*(8 - x)^(5/2)/15","a":null}]},{"n":"11","s":[["u=x^3,\\ dv=\\cos2x\\,dx","نكرر التكامل بالأجزاء (الطريقة الجدولية)"],["\\begin{array}{c|c}u & dv\\\\\\hline x^3 & \\cos2x\\\\ 3x^2 & \\tfrac12\\sin2x\\\\ 6x & -\\tfrac14\\cos2x\\\\ 6 & -\\tfrac18\\sin2x\\\\ 0 & \\tfrac1{16}\\cos2x\\end{array}","اشتقاق <span class=\"tx\" data-t=\"u\"></span> وتكامل <span class=\"tx\" data-t=\"dv\"></span> مع تبديل الإشارات <span class=\"tx\" data-t=\"+,-,+,-\"></span>"],["=\\frac{x^3}{2}\\sin2x+\\frac{3x^2}{4}\\cos2x-\\frac{6x}{8}\\sin2x-\\frac{6}{16}\\cos2x+C",""]],"a":"<span class=\"tx\" data-t=\"\\frac{x^3}{2}\\sin2x+\\frac{3x^2}{4}\\cos2x-\\frac{3x}{4}\\sin2x-\\frac38\\cos2x+C\"></span>","o":"","k":[{"e":"C + x^3*sin(2*x)/2 + 3*x^2*cos(2*x)/4 - 3*x*sin(2*x)/4 - 3*cos(2*x)/8","a":null}]},{"n":"12","s":[["\\frac{x}{6^x}=x\\,6^{-x};\\quad u=x,\\ dv=6^{-x}dx\\Rightarrow v=-\\frac{6^{-x}}{\\ln6}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x6^{-x}dx=-\\frac{x6^{-x}}{\\ln6}+\\frac{1}{\\ln6}\\int6^{-x}dx","صيغة التكامل بالأجزاء"],["=-\\frac{x6^{-x}}{\\ln6}-\\frac{6^{-x}}{(\\ln6)^2}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\dfrac{x}{6^x\\ln6}-\\dfrac{1}{6^x(\\ln6)^2}+C\"></span>","o":"","k":[{"e":"C - x/(6^x*log(6)) - 1/(6^x*log(6)^2)","a":null}]},{"n":"13","s":[["I=\\int e^{3x}\\cos x\\,dx;\\ u=e^{3x},\\ dv=\\cos x\\,dx","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["I=e^{3x}\\sin x-3\\int e^{3x}\\sin x\\,dx","صيغة التكامل بالأجزاء"],["\\int e^{3x}\\sin x\\,dx=-e^{3x}\\cos x+3I","بالأجزاء مرة ثانية: <span class=\"tx\" data-t=\"u=e^{3x},\\ dv=\\sin x\\,dx\"></span>"],["I=e^{3x}\\sin x+3e^{3x}\\cos x-9I\\Rightarrow10I=e^{3x}(\\sin x+3\\cos x)","بالتعويض وجمع <span class=\"tx\" data-t=\"9I\"></span> للطرفين"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{e^{3x}(\\sin x+3\\cos x)}{10}+C\"></span>","o":"","k":[{"e":"C + (sin(x) + 3*cos(x))*exp(3*x)/10","a":null}]},{"n":"14","s":[["u=\\ln(\\sin x),\\ dv=\\cos x\\,dx\\Rightarrow du=\\frac{\\cos x}{\\sin x}dx,\\ v=\\sin x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\cos x\\ln(\\sin x)\\,dx=\\sin x\\ln(\\sin x)-\\int\\cos x\\,dx","صيغة التكامل بالأجزاء"],["=\\sin x\\ln(\\sin x)-\\sin x+C",""]],"a":"<span class=\"tx\" data-t=\"\\sin x\\ln(\\sin x)-\\sin x+C\"></span>","o":"","k":[{"e":"C + log(sin(x))*sin(x) - sin(x)","a":null}]},{"n":"15","s":[["t=1+e^x\\Rightarrow dt=e^x\\,dx","بالتعويض أولًا"],["\\int e^x\\ln(1+e^x)\\,dx=\\int\\ln t\\,dt",""],["u=\\ln t,\\ dv=dt:\\ \\int\\ln t\\,dt=t\\ln t-\\int dt=t\\ln t-t","بالأجزاء"],["=(1+e^x)\\ln(1+e^x)-(1+e^x)+C","بإرجاع <span class=\"tx\" data-t=\"t\"></span>"]],"a":"<span class=\"tx\" data-t=\"(1+e^x)\\ln(1+e^x)-e^x+C\"></span>","o":"الثابت <span class=\"tx\" data-t=\"-1\"></span> اندمج مع <span class=\"tx\" data-t=\"C\"></span>.","k":[{"e":"C + (exp(x) + 1)*log(exp(x) + 1) - exp(x)","a":null}]}],[{"n":"16","s":[["\\int e^x\\cos x\\,dx=\\frac{e^x(\\sin x+\\cos x)}{2}","بالأجزاء مرتين (كما في السؤال <span class=m dir=ltr>13)</span>"],["\\left[\\frac{e^x(\\sin x+\\cos x)}{2}\\right]_0^{\\pi/2}=\\frac{e^{\\pi/2}(1+0)}{2}-\\frac{1(0+1)}{2}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{e^{\\pi/2}-1}{2}\\approx 1.905\"></span>","o":"","k":[{"e":"1.905","a":true}]},{"n":"17","s":[["\\ln x^2=2\\ln x","خاصية اللوغاريتم"],["u=\\ln x,\\ dv=dx:\\ \\int\\ln x\\,dx=x\\ln x-x","بالأجزاء"],["2\\left[x\\ln x-x\\right]_1^e=2\\left[(e-e)-(0-1)\\right]","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"2\"></span>","o":"","k":[{"e":"2","a":null}]},{"n":"18","s":[["\\ln(xe^x)=\\ln x+x","خصائص اللوغاريتمات"],["\\int_1^2(\\ln x+x)\\,dx=\\left[x\\ln x-x+\\frac{x^2}{2}\\right]_1^2","<span class=\"tx\" data-t=\"\\int\\ln x\\,dx\"></span> بالأجزاء"],["=(2\\ln2-2+2)-\\left(0-1+\\tfrac12\\right)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"2\\ln2+\\frac12\\approx 1.886\"></span>","o":"","k":[{"e":"1.886","a":true}]},{"n":"19","s":[["u=x,\\ dv=\\sec^23x\\,dx\\Rightarrow v=\\frac13\\tan3x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\sec^23x\\,dx=\\frac x3\\tan3x-\\frac13\\int\\tan3x\\,dx=\\frac x3\\tan3x+\\frac19\\ln|\\cos3x|","صيغة التكامل بالأجزاء"],["x=\\tfrac{\\pi}{9}:\\ \\frac{\\pi}{27}\\sqrt3+\\frac19\\ln\\frac12","<span class=\"tx\" data-t=\"\\tan\\frac{\\pi}{3}=\\sqrt3,\\ \\cos\\frac{\\pi}{3}=\\frac12\"></span>"],["x=\\tfrac{\\pi}{12}:\\ \\frac{\\pi}{36}+\\frac19\\ln\\frac{\\sqrt2}{2}=\\frac{\\pi}{36}-\\frac{1}{18}\\ln2","<span class=\"tx\" data-t=\"\\tan\\frac{\\pi}{4}=1\"></span>"],["\\frac{\\sqrt3\\,\\pi}{27}-\\frac{\\ln2}{9}-\\frac{\\pi}{36}+\\frac{\\ln2}{18}","بالطرح"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{\\sqrt3\\,\\pi}{27}-\\dfrac{\\pi}{36}-\\dfrac{\\ln2}{18}\\approx 0.0758\"></span>","o":"","k":[{"e":"0.0758","a":true}]},{"n":"20","s":[["u=\\ln x,\\ dv=x^4dx\\Rightarrow v=\\frac{x^5}{5}","الاقتران اللوغاريتمي هو <span class=\"tx\" data-t=\"u\"></span>"],["\\int x^4\\ln x\\,dx=\\frac{x^5}{5}\\ln x-\\frac{x^5}{25}","صيغة التكامل بالأجزاء"],["\\left[\\frac{x^5}{5}\\ln x-\\frac{x^5}{25}\\right]_1^e=\\frac{e^5}{5}-\\frac{e^5}{25}+\\frac1{25}","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{4e^5+1}{25}\\approx 23.786\"></span>","o":"","k":[{"e":"23.786","a":true}]},{"n":"21","s":[["\\int x^2\\sin x\\,dx=-x^2\\cos x+2\\int x\\cos x\\,dx","بالأجزاء: <span class=\"tx\" data-t=\"u=x^2,\\ dv=\\sin x\\,dx\"></span>"],["=-x^2\\cos x+2x\\sin x+2\\cos x","بالأجزاء مرة ثانية"],["\\left[-x^2\\cos x+2x\\sin x+2\\cos x\\right]_0^{\\pi/2}=(0+\\pi+0)-(0+0+2)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\pi-2\\approx 1.142\"></span>","o":"","k":[{"e":"1.142","a":true}]},{"n":"22","s":[["\\int xe^{-2x}dx=-\\frac x2e^{-2x}-\\frac14e^{-2x}","بالأجزاء: <span class=\"tx\" data-t=\"u=x,\\ dv=e^{-2x}dx\"></span>"],["\\int xe^{-x}dx=-xe^{-x}-e^{-x}","بالأجزاء: <span class=\"tx\" data-t=\"u=x,\\ dv=e^{-x}dx\"></span>"],["\\left[-\\frac x2e^{-2x}-\\frac14e^{-2x}-xe^{-x}-e^{-x}\\right]_0^1=\\left(-\\tfrac34e^{-2}-2e^{-1}\\right)-\\left(-\\tfrac54\\right)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\dfrac54-\\dfrac{3}{4e^2}-\\dfrac{2}{e}\\approx 0.413\"></span>","o":"","k":[{"e":"0.413","a":true}]},{"n":"23","s":[["u=xe^x,\\ dv=\\frac{dx}{(1+x)^2}\\Rightarrow du=(x+1)e^x\\,dx,\\ v=-\\frac{1}{1+x}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\frac{xe^x}{(1+x)^2}dx=-\\frac{xe^x}{1+x}+\\int e^x\\,dx=\\frac{e^x}{1+x}","صيغة التكامل بالأجزاء ثم التبسيط"],["\\left[\\frac{e^x}{1+x}\\right]_0^1=\\frac e2-1","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{e}{2}-1\\approx 0.359\"></span>","o":"","k":[{"e":"0.359","a":true}]},{"n":"24","s":[["u=x,\\ dv=3^xdx\\Rightarrow v=\\frac{3^x}{\\ln3}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x3^xdx=\\frac{x3^x}{\\ln3}-\\frac{3^x}{(\\ln3)^2}","صيغة التكامل بالأجزاء"],["\\left(\\frac{3}{\\ln3}-\\frac{3}{(\\ln3)^2}\\right)-\\left(0-\\frac{1}{(\\ln3)^2}\\right)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{3}{\\ln3}-\\dfrac{2}{(\\ln3)^2}\\approx 1.074\"></span>","o":"","k":[{"e":"1.074","a":true}]}],[{"n":"25","s":[["t=x^2\\Rightarrow dt=2x\\,dx","بالتعويض"],["\\int x^3e^{x^2}dx=\\frac12\\int te^t\\,dt","لأنّ <span class=\"tx\" data-t=\"x^3dx=x^2\\cdot x\\,dx=\\frac12t\\,dt\"></span>"],["\\frac12\\left(te^t-e^t\\right)+C","بالأجزاء: <span class=\"tx\" data-t=\"u=t,\\ dv=e^tdt\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\frac12e^{x^2}(x^2-1)+C\"></span>","o":"","k":[{"e":"C + (x^2 - 1)*exp(x^2)/2","a":null}]},{"n":"26","s":[["t=\\ln x\\Rightarrow x=e^t,\\ dx=e^t\\,dt","بالتعويض"],["\\int\\cos(\\ln x)\\,dx=\\int e^t\\cos t\\,dt",""],["=\\frac{e^t(\\cos t+\\sin t)}{2}+C","بالأجزاء مرتين"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{x}{2}\\left(\\cos(\\ln x)+\\sin(\\ln x)\\right)+C\"></span>","o":"","k":[{"e":"C + x*(sin(log(x)) + cos(log(x)))/2","a":null}]},{"n":"27","s":[["t=x^2\\Rightarrow dt=2x\\,dx","بالتعويض"],["\\int x^3\\sin x^2\\,dx=\\frac12\\int t\\sin t\\,dt",""],["=\\frac12\\left(-t\\cos t+\\sin t\\right)+C","بالأجزاء: <span class=\"tx\" data-t=\"u=t,\\ dv=\\sin t\\,dt\"></span>"]],"a":"<span class=\"tx\" data-t=\"-\\frac{x^2}{2}\\cos x^2+\\frac12\\sin x^2+C\"></span>","o":"","k":[{"e":"C - x^2*cos(x)^2/2 + sin(x)^2/2","a":null}]},{"n":"28","s":[["\\sin2x=2\\sin x\\cos x;\\ t=\\cos x\\Rightarrow dt=-\\sin x\\,dx","متطابقة ضعف الزاوية ثم التعويض"],["\\int e^{\\cos x}\\sin2x\\,dx=-2\\int te^t\\,dt",""],["=-2\\left(te^t-e^t\\right)+C","بالأجزاء"]],"a":"<span class=\"tx\" data-t=\"2e^{\\cos x}(1-\\cos x)+C\"></span>","o":"","k":[{"e":"C + 2*e^cos(x)*(1 - cos(x))","a":null}]},{"n":"29","s":[["t=\\sqrt x\\Rightarrow x=t^2,\\ dx=2t\\,dt","بالتعويض"],["\\int\\sin\\sqrt x\\,dx=\\int2t\\sin t\\,dt",""],["=2\\left(-t\\cos t+\\sin t\\right)+C","بالأجزاء: <span class=\"tx\" data-t=\"u=2t,\\ dv=\\sin t\\,dt\"></span>"]],"a":"<span class=\"tx\" data-t=\"-2\\sqrt x\\cos\\sqrt x+2\\sin\\sqrt x+C\"></span>","o":"","k":[{"e":"C - 2*sqrt(x)*cos(sqrt(x)) + 2*sin(sqrt(x))","a":null}]},{"n":"30","s":[["t=x^2\\Rightarrow dt=2x\\,dx","بالتعويض"],["\\int\\frac{x^3e^{x^2}}{(x^2+1)^2}dx=\\frac12\\int\\frac{te^t}{(t+1)^2}dt",""],["u=te^t,\\ dv=\\frac{dt}{(t+1)^2}\\Rightarrow du=(t+1)e^tdt,\\ v=-\\frac{1}{t+1}","بالأجزاء"],["\\frac12\\left(-\\frac{te^t}{t+1}+\\int e^tdt\\right)=\\frac12\\cdot\\frac{e^t}{t+1}+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\dfrac{e^{x^2}}{2(x^2+1)}+C\"></span>","o":"","k":[{"e":"C + exp(x^2)/(2*x^2 + 2)","a":null}]},{"n":"31","s":[["u=\\ln(9-x^2),\\ dv=dx\\Rightarrow du=\\frac{-2x}{9-x^2}dx,\\ v=x","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\ln(9-x^2)dx=x\\ln(9-x^2)+\\int\\frac{2x^2}{9-x^2}dx","صيغة التكامل بالأجزاء"],["\\frac{2x^2}{9-x^2}=-2+\\frac{18}{(3-x)(3+x)}=-2+\\frac{3}{3-x}+\\frac{3}{3+x}","بالقسمة ثم الكسور الجزئية"],["=x\\ln(9-x^2)-2x-3\\ln|3-x|+3\\ln|3+x|+C",""]],"a":"<span class=\"tx\" data-t=\"x\\ln(9-x^2)-2x+3\\ln\\left|\\dfrac{3+x}{3-x}\\right|+C\"></span>","o":"","k":[{"e":"C + x*log(9 - x^2) - 2*x + 3*log(Abs((x + 3)/(x - 3)))","a":null}]},{"n":"32","s":[["u=\\ln x,\\ dv=\\frac{4}{(x-1)^3}dx\\Rightarrow du=\\frac{dx}{x},\\ v=-\\frac{2}{(x-1)^2}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\frac{4\\ln x}{(x-1)^3}dx=-\\frac{2\\ln x}{(x-1)^2}+\\int\\frac{2}{x(x-1)^2}dx","صيغة التكامل بالأجزاء"],["\\frac{2}{x(x-1)^2}=\\frac{2}{x}-\\frac{2}{x-1}+\\frac{2}{(x-1)^2}","الكسور الجزئية"],["=-\\frac{2\\ln x}{(x-1)^2}+2\\ln|x|-2\\ln|x-1|-\\frac{2}{x-1}+C",""]],"a":"<span class=\"tx\" data-t=\"-\\dfrac{2\\ln x}{(x-1)^2}+2\\ln\\left|\\dfrac{x}{x-1}\\right|-\\dfrac{2}{x-1}+C\"></span>","o":"","k":[{"e":"C + 2*log(Abs(x/(x - 1))) - 2/(x - 1) - 2*log(x)/(x - 1)^2","a":null}]}],[{"n":"33","s":[["e^{-x}\\sin2x=0\\Rightarrow\\sin2x=0","لأنّ <span class=\"tx\" data-t=\"e^{-x}\\ne0\"></span>"],["2x=\\pi,\\,2\\pi\\Rightarrow x=\\frac{\\pi}{2},\\ \\pi","أول صفرين موجبين"]],"a":"<span class=\"tx\" data-t=\"A\\left(\\frac{\\pi}{2},0\\right)\"></span>، <span class=\"tx\" data-t=\"B(\\pi,0)\"></span>","o":"","k":[{"p":["pi/2","0"]},{"p":["pi","0"]}]},{"n":"34","s":[["\\int e^{-x}\\sin2x\\,dx=-\\frac{e^{-x}}{5}(\\sin2x+2\\cos2x)","بالأجزاء مرتين"],["\\int_0^{\\pi/2}e^{-x}\\sin2x\\,dx=\\frac{2}{5}e^{-\\pi/2}+\\frac25","المنطقة فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{\\pi/2}^{\\pi}e^{-x}\\sin2x\\,dx=-\\frac25e^{-\\pi}-\\frac25e^{-\\pi/2}","المنطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span> (سالب)"],["A=\\left(\\tfrac25+\\tfrac25e^{-\\pi/2}\\right)+\\left(\\tfrac25e^{-\\pi}+\\tfrac25e^{-\\pi/2}\\right)","نجمع القيم المطلقة"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac25+\\frac45e^{-\\pi/2}+\\frac25e^{-\\pi}\\approx 0.584\"></span> وحدة مربعة","o":"","k":[{"e":"0.584","a":true}]}],[{"n":"35","s":[["s(t)=\\int te^{-t/2}dt","الموقع تكامل السرعة"],["u=t,\\ dv=e^{-t/2}dt\\Rightarrow v=-2e^{-t/2}:\\ s(t)=-2te^{-t/2}-4e^{-t/2}+C","بالأجزاء"],["s(0)=0\\Rightarrow -4+C=0\\Rightarrow C=4","بدأ الحركة من نقطة الأصل"]],"a":"<span class=\"tx\" data-t=\"s(t)=4-(2t+4)e^{-t/2}\"></span> متر","o":"","k":[{"e":"-(2*t + 4)*exp(-t/2) + 4","a":null}]}],[{"n":"36","s":[["f(x)=\\int(x+2)\\sin x\\,dx",""],["u=x+2,\\ dv=\\sin x\\,dx:\\ f(x)=-(x+2)\\cos x+\\sin x+C","بالأجزاء"],["f(0)=2\\Rightarrow -2+0+C=2\\Rightarrow C=4","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(0,2)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=-(x+2)\\cos x+\\sin x+4\"></span>","o":"","k":[{"e":"(-x - 2)*cos(x) + sin(x) + 4","a":null}]},{"n":"37","s":[["f(x)=\\int2xe^{-x}dx",""],["u=2x,\\ dv=e^{-x}dx:\\ f(x)=-2xe^{-x}-2e^{-x}+C","بالأجزاء"],["f(0)=3\\Rightarrow -2+C=3\\Rightarrow C=5","بالتعويض بالنقطة <span class=\"tx\" data-t=\"(0,3)\"></span>"]],"a":"<span class=\"tx\" data-t=\"f(x)=5-2e^{-x}(x+1)\"></span>","o":"","k":[{"e":"5 - 2*(x + 1)/e^x","a":null}]}],[{"n":"38","s":[["N(t)=\\int(t+6)e^{-0.25t}dt",""],["u=t+6,\\ dv=e^{-0.25t}dt\\Rightarrow v=-4e^{-0.25t}","بالأجزاء"],["N(t)=-4(t+6)e^{-0.25t}+4\\int e^{-0.25t}dt=-4(t+6)e^{-0.25t}-16e^{-0.25t}+C",""],["N(0)=40\\Rightarrow -24-16+C=40\\Rightarrow C=80","عند بدء الدورة <span class=\"tx\" data-t=\"t=0\"></span>"]],"a":"<span class=\"tx\" data-t=\"N(t)=80-(4t+40)e^{-0.25t}\"></span>","o":"","k":[{"e":"-(4*t + 40)*exp(-0.25*t) + 80","a":true}]}],[{"n":"39","s":[["u=\\ln2x,\\ dv=x^2dx\\Rightarrow du=\\frac{dx}{x},\\ v=\\frac{x^3}{3}","الاقتران اللوغاريتمي هو <span class=\"tx\" data-t=\"u\"></span>"],["\\int x^2\\ln2x\\,dx=\\frac{x^3}{3}\\ln2x-\\frac{x^3}{9}","صيغة التكامل بالأجزاء"],["\\left[\\frac{x^3}{3}\\ln2x-\\frac{x^3}{9}\\right]_{1/2}^{3}=(9\\ln6-3)-\\left(\\tfrac{1}{24}\\ln1-\\tfrac{1}{72}\\right)","بالتعويض بحدّي التكامل"],["=9\\ln6-3+\\frac{1}{72}=9\\ln6-\\frac{215}{72}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\int_{1/2}^{3}x^2\\ln2x\\,dx=9\\ln6-\\frac{215}{72}\"></span> (تمّ الإثبات)","o":""}],[{"n":"40","s":[["\\sin5x\\sin3x=\\frac12(\\cos2x-\\cos8x)","تحويل الضرب إلى جمع"],["\\int x\\cos kx\\,dx=\\frac{x\\sin kx}{k}+\\frac{\\cos kx}{k^2}","بالأجزاء"],["\\frac12\\left[\\frac{x\\sin2x}{2}+\\frac{\\cos2x}{4}-\\frac{x\\sin8x}{8}-\\frac{\\cos8x}{64}\\right]_0^{\\pi/4}",""],["=\\frac12\\left[\\left(\\tfrac{\\pi}{8}-\\tfrac{1}{64}\\right)-\\left(\\tfrac14-\\tfrac1{64}\\right)\\right]=\\frac12\\left(\\frac{\\pi}{8}-\\frac14\\right)","بالتعويض بحدّي التكامل"]],"a":"<span class=\"tx\" data-t=\"\\int_0^{\\pi/4}x\\sin5x\\sin3x\\,dx=\\frac{\\pi-2}{16}\"></span> (تمّ الإثبات)","o":""}],[{"n":"41","s":[["\\int xe^{x/2}dx=2xe^{x/2}-4e^{x/2}","بالأجزاء: <span class=\"tx\" data-t=\"u=x,\\ dv=e^{x/2}dx\"></span>"],["\\left[2xe^{x/2}-4e^{x/2}\\right]_0^a=2ae^{a/2}-4e^{a/2}+4=6","بالتعويض بحدّي التكامل"],["(2a-4)e^{a/2}=2\\Rightarrow a-2=e^{-a/2}","بالقسمة على <span class=\"tx\" data-t=\"2e^{a/2}\"></span>"],["a=2+e^{-a/2}",""]],"a":"<span class=\"tx\" data-t=\"a\"></span> يحقق المعادلة <span class=\"tx\" data-t=\"x=2+e^{-x/2}\"></span> (تمّ الإثبات)، و <span class=\"tx\" data-t=\"a\\approx 2.314\"></span>","o":""}],[{"n":"42","s":[["u=(\\ln x)^2,\\ dv=dx\\Rightarrow du=\\frac{2\\ln x}{x}dx,\\ v=x","الطريقة الأولى: بالأجزاء"],["\\int(\\ln x)^2dx=x(\\ln x)^2-2\\int\\ln x\\,dx=x(\\ln x)^2-2x\\ln x+2x+C",""],["t=\\ln x\\Rightarrow x=e^t,\\ dx=e^tdt:\\ \\int t^2e^tdt","الطريقة الثانية: التعويض ثم الأجزاء"],["=e^t(t^2-2t+2)+C=x\\left((\\ln x)^2-2\\ln x+2\\right)+C","بالأجزاء مرتين ثم إرجاع <span class=\"tx\" data-t=\"t\"></span>"]],"a":"<span class=\"tx\" data-t=\"x(\\ln x)^2-2x\\ln x+2x+C\"></span>","o":"التبرير: الطريقتان تعطيان الناتج نفسه، والتحقق باشتقاقه يعطي <span class=\"tx\" data-t=\"(\\ln x)^2\"></span>.","k":[{"e":"C + x*log(x)^2 - 2*x*log(x) + 2*x","a":null}]}],[{"n":"43","s":[["\\int xe^{2x}dx=\\frac x2e^{2x}-\\frac14e^{2x}","بالأجزاء: <span class=\"tx\" data-t=\"u=x,\\ dv=e^{2x}dx\"></span>"],["R_1=-\\int_{-1/2}^{0}xe^{2x}dx=-\\left[-\\tfrac14-\\left(-\\tfrac14e^{-1}-\\tfrac14e^{-1}\\right)\\right]","<span class=\"tx\" data-t=\"R_1\"></span> تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["R_1=\\frac14-\\frac{1}{2e}=\\frac{e-2}{4e}",""],["R_2=\\int_0^{1/2}xe^{2x}dx=\\left(\\tfrac e4-\\tfrac e4\\right)-\\left(-\\tfrac14\\right)=\\frac14","<span class=\"tx\" data-t=\"R_2\"></span> فوق المحور <span class=\"tx\" data-t=\"x\"></span>"]],"a":"<span class=\"tx\" data-t=\"R_1=\\frac{e-2}{4e}\\approx 0.066\"></span>، <span class=\"tx\" data-t=\"R_2=\\frac14\"></span> وحدة مربعة","o":"","k":[{"e":"0.066","a":true},{"e":"1/4","a":null}]},{"n":"44","s":[["\\frac{R_1}{R_2}=\\frac{(e-2)/(4e)}{1/4}=\\frac{e-2}{e}","من السؤال السابق"]],"a":"<span class=\"tx\" data-t=\"R_1:R_2=(e-2):e\"></span> (تمّ الإثبات)","o":""}],[{"n":"45","s":[["u=\\ln x,\\ dv=x^ndx\\Rightarrow du=\\frac{dx}{x},\\ v=\\frac{x^{n+1}}{n+1}","الاقتران اللوغاريتمي هو <span class=\"tx\" data-t=\"u\"></span>"],["\\int x^n\\ln x\\,dx=\\frac{x^{n+1}}{n+1}\\ln x-\\frac{1}{n+1}\\int x^n\\,dx","صيغة التكامل بالأجزاء"],["=\\frac{x^{n+1}}{n+1}\\ln x-\\frac{x^{n+1}}{(n+1)^2}+C",""],["=\\frac{x^{n+1}}{(n+1)^2}\\left(-1+(n+1)\\ln x\\right)+C","بإخراج <span class=\"tx\" data-t=\"\\frac{x^{n+1}}{(n+1)^2}\"></span> عاملًا مشتركًا"]],"a":"تمّ الإثبات","o":""},{"n":"46","s":[["u=x^n,\\ dv=e^{ax}dx\\Rightarrow du=nx^{n-1}dx,\\ v=\\frac{e^{ax}}{a}","اختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span> (<span class=\"tx\" data-t=\"a\\ne0\"></span>)"],["\\int x^ne^{ax}dx=\\frac{x^ne^{ax}}{a}-\\int\\frac{e^{ax}}{a}\\cdot nx^{n-1}dx","صيغة التكامل بالأجزاء"],["=\\frac{x^ne^{ax}}{a}-\\frac na\\int x^{n-1}e^{ax}dx",""]],"a":"تمّ الإثبات","o":""}],[{"n":"27","s":[["u=x,\\ dv=\\csc^2x\\,dx \\Rightarrow du=dx,\\ v=-\\cot x","التكامل بالأجزاء"],["\\int x\\csc^2x\\,dx=-x\\cot x+\\int\\cot x\\,dx","قانون التكامل بالأجزاء"],["=-x\\cot x+\\ln|\\sin x|+C",""]],"a":"<span class=\"tx\" data-t=\"-x\\cot x+\\ln|\\sin x|+C\"></span>","o":""}],[{"n":"28","s":[["u=x^2-5x,\\ dv=e^x\\,dx \\Rightarrow du=(2x-5)\\,dx,\\ v=e^x","التكامل بالأجزاء"],["=(x^2-5x)e^x-\\int(2x-5)e^x\\,dx",""],["\\int(2x-5)e^x\\,dx=(2x-5)e^x-2e^x","بالأجزاء مرة ثانية"],["=(x^2-5x)e^x-(2x-5)e^x+2e^x+C=e^x(x^2-7x+7)+C","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"e^x(x^2-7x+7)+C\"></span>","o":"","k":[{"e":"C + (x^2 - 7*x + 7)*exp(x)","a":null}]},{"n":"29","s":[["u=x,\\ dv=\\sin 2x\\,dx \\Rightarrow du=dx,\\ v=-\\frac{1}{2}\\cos 2x","التكامل بالأجزاء"],["=-\\frac{x}{2}\\cos 2x+\\frac{1}{2}\\int\\cos 2x\\,dx",""],["=-\\frac{x}{2}\\cos 2x+\\frac{1}{4}\\sin 2x+C",""]],"a":"<span class=\"tx\" data-t=\"-\\frac{x}{2}\\cos 2x+\\frac{1}{4}\\sin 2x+C\"></span>","o":"","k":[{"e":"C - x*cos(2*x)/2 + sin(2*x)/4","a":null}]}],[{"n":"35","s":[["u=\\ln 2x,\\ dv=x\\,dx \\Rightarrow du=\\frac{1}{x}dx,\\ v=\\frac{x^2}{2}","التكامل بالأجزاء"],["\\int x\\ln 2x\\,dx=\\frac{x^2}{2}\\ln 2x-\\int\\frac{x}{2}\\,dx=\\frac{x^2}{2}\\ln 2x-\\frac{x^2}{4}",""],["\\left[\\frac{x^2}{2}\\ln 2x-\\frac{x^2}{4}\\right]_{1/2}^{e/2}=\\left(\\frac{e^2}{8}-\\frac{e^2}{16}\\right)-\\left(0-\\frac{1}{16}\\right)","<span class=m dir=ltr>ln e = 1</span> ، <span class=m dir=ltr>ln 1 = 0</span>"],["=\\frac{e^2+1}{16}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{e^2+1}{16}\\approx 0.5243\"></span>","o":"","k":[{"e":"0.5243","a":true}]}],[{"n":"1","s":[["u=x,\\ dv=\\cos4x\\,dx\\Rightarrow du=dx,\\ v=\\frac{1}{4}\\sin4x","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\cos4x\\,dx=\\frac{x}{4}\\sin4x-\\int\\frac{1}{4}\\sin4x\\,dx","صيغة التكامل بالأجزاء: <span class=\"tx\" data-t=\"\\int u\\,dv=uv-\\int v\\,du\"></span>"],["=\\frac{x}{4}\\sin4x+\\frac{1}{16}\\cos4x+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{x}{4}\\sin4x+\\frac{1}{16}\\cos4x+C\"></span>","o":"","k":[{"e":"C + x*sin(4*x)/4 + cos(4*x)/16","a":null}]},{"n":"2","s":[["u=x,\\ dv=\\sqrt{x+1}\\,dx\\Rightarrow du=dx,\\ v=\\frac{2}{3}(x+1)^{3/2}","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\sqrt{x+1}\\,dx=\\frac{2}{3}x(x+1)^{3/2}-\\frac{2}{3}\\int(x+1)^{3/2}dx","التكامل بالأجزاء"],["=\\frac{2}{3}x(x+1)^{3/2}-\\frac{4}{15}(x+1)^{5/2}+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}x(x+1)^{3/2}-\\frac{4}{15}(x+1)^{5/2}+C\"></span>","o":"","k":[{"e":"C + 2*x*(x + 1)^(3/2)/3 - 4*(x + 1)^(5/2)/15","a":null}]},{"n":"3","s":[["u=x,\\ dv=e^{-x}dx\\Rightarrow du=dx,\\ v=-e^{-x}","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int xe^{-x}dx=-xe^{-x}+\\int e^{-x}dx","التكامل بالأجزاء"],["=-xe^{-x}-e^{-x}+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"-xe^{-x}-e^{-x}+C=-e^{-x}(x+1)+C\"></span>","o":""},{"n":"4","s":[["u=\\ln x,\\ dv=(x^2+1)dx\\Rightarrow du=\\frac{1}{x}dx,\\ v=\\frac{x^3}{3}+x","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int(x^2+1)\\ln x\\,dx=\\left(\\frac{x^3}{3}+x\\right)\\ln x-\\int\\left(\\frac{x^2}{3}+1\\right)dx","التكامل بالأجزاء"],["=\\left(\\frac{x^3}{3}+x\\right)\\ln x-\\frac{x^3}{9}-x+C","بالتكامل"]],"a":"<span class=\"tx\" data-t=\"\\left(\\frac{x^3}{3}+x\\right)\\ln x-\\frac{x^3}{9}-x+C\"></span>","o":"","k":[{"e":"C - x^3/9 - x + (x^3/3 + x)*log(x)","a":null}]},{"n":"5","s":[["\\ln x^3=3\\ln x","خصائص اللوغاريتم"],["u=\\ln x,\\ dv=dx\\Rightarrow du=\\frac{1}{x}dx,\\ v=x","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["3\\int\\ln x\\,dx=3\\left(x\\ln x-\\int1\\,dx\\right)=3x\\ln x-3x+C","التكامل بالأجزاء"]],"a":"<span class=\"tx\" data-t=\"3x\\ln x-3x+C\"></span>","o":"","k":[{"e":"C + 3*x*log(x) - 3*x","a":null}]},{"n":"6","s":[["I=\\int e^{2x}\\sin x\\,dx;\\ u=e^{2x},\\ dv=\\sin x\\,dx","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["I=-e^{2x}\\cos x+2\\int e^{2x}\\cos x\\,dx","التكامل بالأجزاء"],["\\int e^{2x}\\cos x\\,dx=e^{2x}\\sin x-2\\int e^{2x}\\sin x\\,dx=e^{2x}\\sin x-2I","التكامل بالأجزاء مرة ثانية"],["I=-e^{2x}\\cos x+2e^{2x}\\sin x-4I\\Rightarrow5I=e^{2x}(2\\sin x-\\cos x)","بالتعويض وجمع <span class=\"tx\" data-t=\"4I\"></span> للطرفين"],["I=\\frac{1}{5}e^{2x}(2\\sin x-\\cos x)+C","بالقسمة على <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}e^{2x}(2\\sin x-\\cos x)+C\"></span>","o":"","k":[{"e":"C + (2*sin(x) - cos(x))*exp(2*x)/5","a":null}]}],[{"n":"7","s":[["\\int\\ln x\\,dx=x\\ln x-x","التكامل بالأجزاء: <span class=\"tx\" data-t=\"u=\\ln x,\\ dv=dx\"></span>"],["\\int_1^e\\ln x\\,dx=\\left.(x\\ln x-x)\\right|_1^e=(e-e)-(0-1)=1","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"1\"></span>","o":"","k":[{"e":"1","a":null}]},{"n":"8","s":[["u=\\ln x,\\ dv=x^{-2}dx\\Rightarrow du=\\frac{1}{x}dx,\\ v=-\\frac{1}{x}","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\frac{\\ln x}{x^2}dx=-\\frac{\\ln x}{x}+\\int\\frac{1}{x^2}dx=-\\frac{\\ln x}{x}-\\frac{1}{x}","التكامل بالأجزاء"],["\\left.\\left(-\\frac{\\ln x}{x}-\\frac{1}{x}\\right)\\right|_1^2=\\left(-\\frac{\\ln2}{2}-\\frac{1}{2}\\right)-(0-1)=\\frac{1}{2}-\\frac{1}{2}\\ln2","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}-\\frac{1}{2}\\ln2\\approx0.1534\"></span>","o":"","k":[{"e":"0.1534","a":true}]},{"n":"9","s":[["u=x,\\ dv=\\cos\\frac{x}{4}dx\\Rightarrow du=dx,\\ v=4\\sin\\frac{x}{4}","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x\\cos\\frac{x}{4}dx=4x\\sin\\frac{x}{4}-\\int4\\sin\\frac{x}{4}dx=4x\\sin\\frac{x}{4}+16\\cos\\frac{x}{4}","التكامل بالأجزاء"],["\\left.\\left(4x\\sin\\frac{x}{4}+16\\cos\\frac{x}{4}\\right)\\right|_0^{\\pi}=\\left(4\\pi\\cdot\\frac{\\sqrt2}{2}+16\\cdot\\frac{\\sqrt2}{2}\\right)-(0+16)","بالتعويض"],["=2\\sqrt2\\,\\pi+8\\sqrt2-16","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"2\\sqrt2\\,\\pi+8\\sqrt2-16\\approx4.1995\"></span>","o":"","k":[{"e":"4.1995","a":true}]},{"n":"10","s":[["I=\\int e^{3x}\\cos2x\\,dx=\\frac{1}{2}e^{3x}\\sin2x-\\frac{3}{2}\\int e^{3x}\\sin2x\\,dx","بالأجزاء: <span class=\"tx\" data-t=\"u=e^{3x},\\ dv=\\cos2x\\,dx\"></span>"],["\\int e^{3x}\\sin2x\\,dx=-\\frac{1}{2}e^{3x}\\cos2x+\\frac{3}{2}I","بالأجزاء مرة ثانية"],["I=\\frac{1}{2}e^{3x}\\sin2x+\\frac{3}{4}e^{3x}\\cos2x-\\frac{9}{4}I\\Rightarrow I=\\frac{e^{3x}(2\\sin2x+3\\cos2x)}{13}","بحل المعادلة لـ <span class=\"tx\" data-t=\"I\"></span>"],["\\left.\\frac{e^{3x}(2\\sin2x+3\\cos2x)}{13}\\right|_0^{\\pi/4}=\\frac{e^{3\\pi/4}(2+0)}{13}-\\frac{1\\cdot(0+3)}{13}","بالتعويض"],["=\\frac{2e^{3\\pi/4}-3}{13}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{2e^{3\\pi/4}-3}{13}\\approx1.3924\"></span>","o":"","k":[{"e":"1.3924","a":true}]},{"n":"11","s":[["u=\\ln(x+1),\\ dv=dx\\Rightarrow du=\\frac{dx}{x+1},\\ v=x+1","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span> (نختار <span class=\"tx\" data-t=\"v=x+1\"></span> للتبسيط)"],["\\int\\ln(x+1)dx=(x+1)\\ln(x+1)-\\int1\\,dx=(x+1)\\ln(x+1)-x","التكامل بالأجزاء"],["\\left.\\left((x+1)\\ln(x+1)-x\\right)\\right|_1^e=\\left((e+1)\\ln(e+1)-e\\right)-(2\\ln2-1)","بالتعويض"],["=(e+1)\\ln(e+1)-2\\ln2-e+1","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"(e+1)\\ln(e+1)-2\\ln2-e+1\\approx1.7785\"></span>","o":"","k":[{"e":"1.7785","a":true}]},{"n":"12","s":[["\\int x^2e^xdx=x^2e^x-2\\int xe^xdx","بالأجزاء: <span class=\"tx\" data-t=\"u=x^2,\\ dv=e^xdx\"></span>"],["\\int xe^xdx=xe^x-e^x","بالأجزاء مرة ثانية: <span class=\"tx\" data-t=\"u=x,\\ dv=e^xdx\"></span>"],["\\int x^2e^xdx=e^x(x^2-2x+2)","بالتعويض"],["\\left.e^x(x^2-2x+2)\\right|_0^1=e(1)-1(2)=e-2","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"e-2\\approx0.7183\"></span>","o":"","k":[{"e":"0.7183","a":true}]}],[{"n":"13","s":[["u=\\ln x,\\ dv=dx\\Rightarrow du=\\frac{1}{x}dx,\\ v=x","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int\\ln x\\,dx=x\\ln x-\\int1\\,dx=x\\ln x-x","التكامل بالأجزاء"],["\\int_2^4\\ln x\\,dx=(4\\ln4-4)-(2\\ln2-2)","بالتعويض"],["=8\\ln2-2\\ln2-2=6\\ln2-2","<span class=\"tx\" data-t=\"\\ln4=2\\ln2\"></span>"]],"a":"<span class=\"tx\" data-t=\"\\int_2^4\\ln x\\,dx=6\\ln2-2\"></span> وهو المطلوب","o":""}],[{"n":"14","s":[["x\\sin x=0\\Rightarrow x=0\\ \\text{أو}\\ \\sin x=0\\Rightarrow x=0,\\pi,2\\pi,\\ldots","المقاطع <span class=\"tx\" data-t=\"x\"></span>"],["A(\\pi,0),\\quad B(2\\pi,0)","من الشكل: <span class=\"tx\" data-t=\"A\"></span> أول مقطع موجب و <span class=\"tx\" data-t=\"B\"></span> الذي يليه"]],"a":"<span class=\"tx\" data-t=\"A(\\pi,0)\"></span>، <span class=\"tx\" data-t=\"B(2\\pi,0)\"></span>","o":"","k":[{"p":["pi","0"]},{"p":["2*pi","0"]}]},{"n":"15","s":[["\\int x\\sin x\\,dx=-x\\cos x+\\sin x","بالأجزاء: <span class=\"tx\" data-t=\"u=x,\\ dv=\\sin x\\,dx\"></span>"],["\\int_0^{\\pi}x\\sin x\\,dx=\\left.(-x\\cos x+\\sin x)\\right|_0^{\\pi}=\\pi","المنطقة فوق المحور <span class=\"tx\" data-t=\"x\"></span>"],["\\int_{\\pi}^{2\\pi}x\\sin x\\,dx=(-2\\pi+0)-(\\pi+0)=-3\\pi","المنطقة تحت المحور <span class=\"tx\" data-t=\"x\"></span>"],["A=\\pi+|-3\\pi|=4\\pi","بجمع المساحتين"]],"a":"المساحة <span class=\"tx\" data-t=\"=4\\pi\\approx12.57\"></span> وحدة مربعة","o":"","k":[{"e":"12.57","a":true}]}],[{"n":"16","s":[["x^2\\ln x=0,\\ x>0\\Rightarrow\\ln x=0\\Rightarrow x=1","<span class=\"tx\" data-t=\"x^2\\ne0\"></span> لأن <span class=\"tx\" data-t=\"x&gt;0\"></span>"]],"a":"<span class=\"tx\" data-t=\"A(1,0)\"></span>","o":"","k":[{"p":["1","0"]}]},{"n":"17","s":[["u=\\ln x,\\ dv=x^2dx\\Rightarrow du=\\frac{1}{x}dx,\\ v=\\frac{x^3}{3}","باختيار <span class=\"tx\" data-t=\"u\"></span> و <span class=\"tx\" data-t=\"dv\"></span>"],["\\int x^2\\ln x\\,dx=\\frac{x^3}{3}\\ln x-\\int\\frac{x^2}{3}dx=\\frac{x^3}{3}\\ln x-\\frac{x^3}{9}","التكامل بالأجزاء"],["A=\\int_1^2x^2\\ln x\\,dx=\\left(\\frac{8}{3}\\ln2-\\frac{8}{9}\\right)-\\left(0-\\frac{1}{9}\\right)","المنحنى فوق المحور <span class=\"tx\" data-t=\"x\"></span> في <span class=\"tx\" data-t=\"[1,2]\"></span>"],["=\\frac{8}{3}\\ln2-\\frac{7}{9}","بالتبسيط"]],"a":"المساحة <span class=\"tx\" data-t=\"=\\frac{8}{3}\\ln2-\\frac{7}{9}\\approx1.071\"></span> وحدة مربعة","o":"","k":[{"e":"1.071","a":true}]}]]