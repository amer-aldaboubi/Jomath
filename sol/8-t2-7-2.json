[[{"n":"1","s":[["\\angle DAB \\cong \\angle BCD","الزوايا المتقابلة في متوازي الأضلاع متطابقة"]],"a":"<span class=\"tx\" data-t=\"\\angle BCD\"></span>","o":""},{"n":"2","s":[["\\angle ABD \\cong \\angle CDB","زاويتان متبادلتان داخليًّا، لأن <span class=m dir=ltr>AB</span> ∥ <span class=m dir=ltr>DC</span> والقاطع <span class=m dir=ltr>BD</span>"]],"a":"<span class=\"tx\" data-t=\"\\angle CDB\"></span>","o":""},{"n":"3","s":[["\\overline{AB} \\parallel \\overline{DC}","الأضلاع المتقابلة في متوازي الأضلاع متوازية"]],"a":"<span class=\"tx\" data-t=\"\\overline{DC}\"></span>","o":""},{"n":"4","s":[["\\overline{BC} \\parallel \\overline{AD}","الأضلاع المتقابلة في متوازي الأضلاع متوازية"]],"a":"<span class=\"tx\" data-t=\"\\overline{AD}\"></span>","o":""},{"n":"5","s":[["AB = CD,\\ AD = CB,\\ BD = DB","الأضلاع المتقابلة متطابقة، وضلع مشترك"],["\\triangle ABD \\cong \\triangle CDB","<span class=m dir=ltr>SSS</span>"]],"a":"<span class=\"tx\" data-t=\"\\triangle CDB\"></span>","o":""},{"n":"6","s":[["CD = AB,\\ AD = CB,\\ AC = CA","الأضلاع المتقابلة متطابقة، وضلع مشترك"],["\\triangle ACD \\cong \\triangle CAB","<span class=m dir=ltr>SSS</span>"]],"a":"<span class=\"tx\" data-t=\"\\triangle CAB\"></span>","o":""}],[{"n":"7","s":[["m + 1 = 6","الأضلاع المتقابلة في متوازي الأضلاع متطابقة"],["m = 5","بطرح <span class=m dir=ltr>1</span> من الطرفين"],["n = 12","الضلعان المتقابلان متطابقان"]],"a":"<span class=\"tx\" data-t=\"m = 5,\\ n = 12\"></span>","o":""},{"n":"8","s":[["2f - 5 = 5f - 17","قطرا متوازي الأضلاع ينصّف كلٌّ منهما الآخر"],["12 = 3f","بطرح <span class=m dir=ltr>2f</span> من الطرفين وإضافة <span class=m dir=ltr>17</span>"],["f = 4","بقسمة الطرفين على <span class=m dir=ltr>3</span>"],["g = f + 2 = 4 + 2 = 6","القطر الآخر منصَّف أيضًا، وبالتعويض <span class=m dir=ltr>f = 4</span>"]],"a":"<span class=\"tx\" data-t=\"f = 4,\\ g = 6\"></span>","o":""},{"n":"9","s":[["4t - 20 = 3t","الزاويتان المتقابلتان متطابقتان"],["t = 20","بطرح <span class=m dir=ltr>3t</span> من الطرفين وإضافة <span class=m dir=ltr>20</span>"],["6t = 6(20) = 120","بالتعويض"],["3s = 120","الزاويتان المتقابلتان (العلوية والسفلية) متطابقتان"],["s = 40","بقسمة الطرفين على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"t = 20,\\ s = 40\"></span>","o":"تحقّق: <span class=\"tx\" data-t=\"120^\\circ + 60^\\circ = 180^\\circ\"></span> للزاويتين المتتاليتين"}],[{"n":"10","s":[["m\\angle A + m\\angle B = 180^\\circ","الزوايا المتتالية في متوازي الأضلاع متكاملة"],["m\\angle B = 180^\\circ - 120^\\circ = 60^\\circ","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"m\\angle B = 60^\\circ\"></span>","o":""},{"n":"11","s":[["m\\angle B = 180^\\circ - m\\angle A","∠<span class=m dir=ltr>A</span> و ∠<span class=m dir=ltr>B</span> متكاملتان"]],"a":"إذا قلّ قياس <span class=\"tx\" data-t=\"\\angle A\"></span> فإن قياس <span class=\"tx\" data-t=\"\\angle B\"></span> يزداد بالمقدار نفسه","o":""},{"n":"12","s":[["AB = BD = DC = CA","أطوال الأذرع ثابتة"],["m\\angle A \\downarrow \\Rightarrow AD \\uparrow","كلما صغرت الزاوية <span class=m dir=ltr>A</span> تقترب <span class=m dir=ltr>B</span> و <span class=m dir=ltr>C</span> من بعضهما ويستطيل القطر <span class=m dir=ltr>AD</span>"]],"a":"يزداد طول <span class=\"tx\" data-t=\"\\overline{AD}\"></span>","o":""},{"n":"13","s":[["AD \\uparrow","من الفرع السابق، القطر <span class=m dir=ltr>AD</span> رأسي ويحدد الارتفاع"]],"a":"يزداد ارتفاع الرافعة","o":""}],[{"n":"14","s":[["\\square GDKH","معطى: <span class=m dir=ltr>GDKH</span> متوازي أضلاع"],["\\overline{GH} \\cong \\overline{DK}","الأضلاع المتقابلة في متوازي الأضلاع متطابقة"],["\\angle G \\cong \\angle K","الزوايا المتقابلة في متوازي الأضلاع متطابقة"],["\\overline{DJ} \\perp \\overline{HK} \\Rightarrow m\\angle DJK = 90^\\circ","معطى (من الشكل)"],["\\overline{FH} \\perp \\overline{GD} \\Rightarrow m\\angle HFG = 90^\\circ","<span class=m dir=ltr>FH</span> ⊥ <span class=m dir=ltr>HK</span> و <span class=m dir=ltr>GD</span> ∥ <span class=m dir=ltr>HK</span>، والمستقيم العمودي على أحد مستقيمين متوازيين عمودي على الآخر"],["\\triangle DJK \\cong \\triangle HFG","<span class=m dir=ltr>AAS</span>: ∠<span class=m dir=ltr>DJK</span> ≅ ∠<span class=m dir=ltr>HFG</span>، ∠<span class=m dir=ltr>K</span> ≅ ∠<span class=m dir=ltr>G</span>، <span class=m dir=ltr>DK</span> ≅ <span class=m dir=ltr>HG</span>"]],"a":"<span class=\"tx\" data-t=\"\\triangle DJK \\cong \\triangle HFG\"></span> <span class=m dir=ltr>(AAS)</span>","o":""}],[{"n":"15","s":[["\\overline{AK} \\cong \\overline{MK}","معطى"],["\\angle A \\cong \\angle M","زاويتا القاعدة في المثلث المتطابق الضلعين <span class=m dir=ltr>AKM</span>"],["\\angle BCD \\cong \\angle A","الزوايا المتقابلة في متوازي الأضلاع <span class=m dir=ltr>ABCD</span> متطابقة"],["\\angle BCD \\cong \\angle M","خاصية التعدّي"],["\\angle BCD \\cong \\angle CMD","∠<span class=m dir=ltr>M</span> هي نفسها ∠<span class=m dir=ltr>CMD</span>"]],"a":"<span class=\"tx\" data-t=\"\\angle BCD \\cong \\angle CMD\"></span>","o":""}],[{"n":"16","s":[["GF \\ne FH","الخطأ: <span class=m dir=ltr>GF</span> نصف القطر <span class=m dir=ltr>GJ</span>، و <span class=m dir=ltr>FH</span> نصف القطر <span class=m dir=ltr>HK</span>، وقطرا متوازي الأضلاع غير متطابقين بالضرورة"],["\\overline{GF} \\cong \\overline{FJ},\\ \\overline{KF} \\cong \\overline{FH}","التصحيح: قطرا متوازي الأضلاع ينصّف كلٌّ منهما الآخر"]],"a":"الخطأ: ربط جزأين من قطرين مختلفين. الصحيح: <span class=\"tx\" data-t=\"\\overline{GF} \\cong \\overline{FJ}\"></span> و <span class=\"tx\" data-t=\"\\overline{KF} \\cong \\overline{FH}\"></span>","o":""}],[{"n":"17","s":[["4y + 5 = y + 14","<span class=m dir=ltr>MN</span> و <span class=m dir=ltr>QP</span> ضلعان متقابلان فهما متطابقان"],["3y = 9 \\Rightarrow y = 3","بطرح <span class=m dir=ltr>y</span> و <span class=m dir=ltr>5</span> من الطرفين، ثم القسمة على <span class=m dir=ltr>3</span>"],["x - 5 = -2x + 37","<span class=m dir=ltr>NP</span> و <span class=m dir=ltr>MQ</span> ضلعان متقابلان فهما متطابقان"],["3x = 42 \\Rightarrow x = 14","بإضافة <span class=m dir=ltr>2x</span> و <span class=m dir=ltr>5</span> للطرفين، ثم القسمة على <span class=m dir=ltr>3</span>"],["MN = QP = 17,\\ NP = MQ = 9","بالتعويض"],["P = 2(17 + 9) = 52","محيط متوازي الأضلاع"]],"a":"المحيط <span class=\"tx\" data-t=\"= 52\"></span> وحدة","o":""}],[{"n":"18","s":[["AB = CD,\\ AD = BC;\\ AB \\parallel CD,\\ AD \\parallel BC","الأضلاع: كل ضلعين متقابلين متوازيان ومتطابقان"],["\\angle A \\cong \\angle C,\\ m\\angle A + m\\angle B = 180^\\circ","الزوايا: كل زاويتين متقابلتين متطابقتان، وكل زاويتين متتاليتين متكاملتان"],["AM = MC,\\ BM = MD","الأقطار: ينصّف كلٌّ منهما الآخر <span class=m dir=ltr>(M</span> نقطة تقاطعهما)، وكل قطر يقسمه إلى مثلثين متطابقين"]],"a":"الأضلاع المتقابلة متوازية ومتطابقة، الزوايا المتقابلة متطابقة والمتتالية متكاملة، والقطران ينصّف كلٌّ منهما الآخر","o":""}],[{"n":"1","s":[["(3s+50)+(2s+30)=180","الزاويتان المتحالفتان في متوازي الأضلاع متكاملتان"],["5s+80=180","بالتبسيط"],["5s=100","بطرح <span class=m dir=ltr>80</span> من الطرفين"],["s=20","بقسمة الطرفين على <span class=m dir=ltr>5</span>"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"s=20\"></span>","o":""}],[{"n":"10","s":[["m\\angle AFD=180^\\circ-(49^\\circ+34^\\circ)","مجموع زوايا المثلث <span class=m dir=ltr>AFD</span>"],["m\\angle AFD=97^\\circ","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"m\\angle AFD=97^\\circ\"></span>","o":""},{"n":"11","s":[["m\\angle BCF=m\\angle CAD","زاويتان متبادلتان داخليًا لأن <span class=\"tx\" data-t=\"\\overline{BC}\\parallel\\overline{AD}\"></span>"],["m\\angle BCF=49^\\circ","بالتعويض"]],"a":"<span class=\"tx\" data-t=\"m\\angle BCF=49^\\circ\"></span>","o":""},{"n":"12","s":[["3y-4=29","الضلعان المتقابلان <span class=m dir=ltr>BC</span> و <span class=m dir=ltr>AD</span> متطابقان"],["3y=33\\ \\Rightarrow\\ y=11","بإضافة <span class=m dir=ltr>4</span> ثم القسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"y=11\"></span>","o":""},{"n":"13","s":[["5x=25","الضلعان المتقابلان <span class=m dir=ltr>AB</span> و <span class=m dir=ltr>CD</span> متطابقان"],["x=5","بقسمة الطرفين على <span class=m dir=ltr>5</span>"]],"a":"<span class=\"tx\" data-t=\"x=5\"></span>","o":""}],[{"n":"1","s":[["LM=QN=13","الأضلاع المتقابلة في متوازي الأضلاع متطابقة"]],"a":"<span class=\"tx\" data-t=\"LM=13\"></span>","o":""},{"n":"2","s":[["LP=PN=7","قطرا متوازي الأضلاع ينصف كل منهما الآخر"]],"a":"<span class=\"tx\" data-t=\"LP=7\"></span>","o":""},{"n":"3","s":[["LQ=MN=8","الأضلاع المتقابلة متطابقة"]],"a":"<span class=\"tx\" data-t=\"LQ=8\"></span>","o":""},{"n":"4","s":[["MQ=2\\times PM=2\\times8.2=16.4","القطر ينصفه القطر الآخر"]],"a":"<span class=\"tx\" data-t=\"MQ=16.4\"></span>","o":""},{"n":"5","s":[["m\\angle LMN=180^\\circ-100^\\circ=80^\\circ","الزاويتان المتحالفتان <span class=m dir=ltr>(L</span> و <span class=m dir=ltr>M)</span> متكاملتان"]],"a":"<span class=\"tx\" data-t=\"m\\angle LMN=80^\\circ\"></span>","o":""},{"n":"6","s":[["m\\angle NQL=m\\angle LMN=80^\\circ","الزوايا المتقابلة متطابقة"]],"a":"<span class=\"tx\" data-t=\"m\\angle NQL=80^\\circ\"></span>","o":""},{"n":"7","s":[["m\\angle MNQ=m\\angle QLM=100^\\circ","الزوايا المتقابلة متطابقة"]],"a":"<span class=\"tx\" data-t=\"m\\angle MNQ=100^\\circ\"></span>","o":""},{"n":"8","s":[["m\\angle LMQ=m\\angle MQN=29^\\circ","زاويتان متبادلتان داخليًا لأن <span class=\"tx\" data-t=\"\\overline{LM}\\parallel\\overline{QN}\"></span>"]],"a":"<span class=\"tx\" data-t=\"m\\angle LMQ=29^\\circ\"></span>","o":""}],[{"n":"9","s":[["PT=TR\\ \\Rightarrow\\ x+2=y","القطران ينصف كل منهما الآخر"],["QT=TS\\ \\Rightarrow\\ 2x=y+3","القطران ينصف كل منهما الآخر"],["2x=(x+2)+3","بالتعويض عن <span class=\"tx\" data-t=\"y\"></span>"],["x=5","بطرح <span class=\"tx\" data-t=\"x\"></span> من الطرفين"],["y=5+2=7","بالتعويض في المعادلة الأولى"]],"a":"<span class=\"tx\" data-t=\"x=5,\\ y=7\"></span>","o":""}],[{"n":"10","s":[["x=14,\\quad y=10","الأضلاع المتقابلة متطابقة"]],"a":"<span class=\"tx\" data-t=\"x=14,\\ y=10\"></span>","o":""},{"n":"11","s":[["x=12","الأضلاع المتقابلة متطابقة"],["3y+1=10\\ \\Rightarrow\\ y=3","بطرح <span class=m dir=ltr>1</span> ثم القسمة على <span class=m dir=ltr>3</span>"]],"a":"<span class=\"tx\" data-t=\"x=12,\\ y=3\"></span>","o":""},{"n":"12","s":[["r=6,\\quad s=3.5","قطرا متوازي الأضلاع ينصف كل منهما الآخر"]],"a":"<span class=\"tx\" data-t=\"r=6,\\ s=3.5\"></span>","o":""},{"n":"13","s":[["20a+30=17a+48","الزاويتان المتقابلتان <span class=m dir=ltr>G</span> و <span class=m dir=ltr>K</span> متطابقتان"],["3a=18\\ \\Rightarrow\\ a=6","بطرح <span class=\"tx\" data-t=\"17a\"></span> و <span class=m dir=ltr>30</span> ثم القسمة على <span class=m dir=ltr>3</span>"],["20(6)+30=150^\\circ","تحقق"]],"a":"<span class=\"tx\" data-t=\"a=6\"></span>","o":""},{"n":"14","s":[["a-3.5=18.5","الضلعان المتقابلان <span class=m dir=ltr>BC</span> و <span class=m dir=ltr>AD</span> متطابقان"],["a=22","بإضافة <span class=m dir=ltr>3.5</span> للطرفين"],["2(22)-20.4=23.6=22+1.6\\ \\checkmark","تحقق: <span class=m dir=ltr>AB = CD</span>"]],"a":"<span class=\"tx\" data-t=\"a=22\"></span>","o":""},{"n":"15","s":[["2r=4\\ \\Rightarrow\\ r=2","القطران ينصف كل منهما الآخر"],["y-1=6\\ \\Rightarrow\\ y=7","القطران ينصف كل منهما الآخر"]],"a":"<span class=\"tx\" data-t=\"r=2,\\ y=7\"></span>","o":""}],[{"n":"16","s":[["\\overline{HD}\\cong\\overline{FD}","معطى"],["\\angle H\\cong\\angle F","زاويتا القاعدة في المثلث المتطابق الضلعين <span class=m dir=ltr>DHF</span>"],["BCGH\\ \\text{متوازي أضلاع}","معطى"],["\\angle GCB\\cong\\angle H","الزوايا المتقابلة في متوازي الأضلاع متطابقة"],["\\angle GCB\\cong\\angle F","خاصية التعدي"]],"a":"<span class=\"tx\" data-t=\"\\angle GCB\\cong\\angle F\"></span>","o":"يُكتب البرهان في عمودين: العبارات والمبررات كما في الخطوات."}],[{"n":"17","s":[["XYTZ\\ \\text{متوازي أضلاع}","معطى"],["\\angle X\\cong\\angle T","الزوايا المتقابلة في متوازي الأضلاع متطابقة"],["RSTW\\ \\text{متوازي أضلاع}","معطى"],["\\angle R\\cong\\angle T","الزوايا المتقابلة في متوازي الأضلاع متطابقة"],["\\angle X\\cong\\angle R","خاصية التعدي"]],"a":"<span class=\"tx\" data-t=\"\\angle X\\cong\\angle R\"></span>","o":"يُكتب البرهان في عمودين: العبارات والمبررات."}]]