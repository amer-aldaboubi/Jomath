{bmatrix}6 & 15 & 9 \\\\ -8 & -20 & -12 \\\\ 2 & 5 & 3\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}6 &amp; 15 &amp; 9 \\\\ -8 &amp; -20 &amp; -12 \\\\ 2 &amp; 5 &amp; 3\\end{bmatrix}\"></span>","o":""},{"n":"12","s":[["2 \\times 3 \\;,\\; 3 \\times 3","الضرب ممكن، ورتبة الناتج <span class=m dir=ltr>2 × 3</span>"],["\\begin{bmatrix}0 + 2 + 8 & 9 - 1 + 14 & 6 - 5 + 4 \\\\ 0 - 4 + 0 & 12 + 2 + 0 & 8 + 10 + 0\\end{bmatrix}","بضرب عناصر كل صف في العناصر المناظرة في كل عمود وجمعها"],["\\begin{bmatrix}10 & 22 & 5 \\\\ -4 & 14 & 18\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}10 &amp; 22 &amp; 5 \\\\ -4 &amp; 14 &amp; 18\\end{bmatrix}\"></span>","o":""},{"n":"13","s":[["\\begin{bmatrix}3(5) + 0(0) & 3(0) + 0(4) \\\\ 0(5) + 2(0) & 0(0) + 2(4)\\end{bmatrix}","الضرب ممكن <span class=m dir=ltr>(2 × 2</span> في <span class=m dir=ltr>2 × 2)</span>"],["\\begin{bmatrix}15 & 0 \\\\ 0 & 8\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}15 &amp; 0 \\\\ 0 &amp; 8\\end{bmatrix}\"></span>","o":""},{"n":"14","s":[["1 \\times 3 \\;,\\; 3 \\times 1","الضرب ممكن، ورتبة الناتج <span class=m dir=ltr>1 × 1</span>"],["\\begin{bmatrix}8(1) + 10(-3) + (-7)(-5)\\end{bmatrix}","بضرب الصف في العمود"],["\\begin{bmatrix}8 - 30 + 35\\end{bmatrix} = \\begin{bmatrix}13\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}13\\end{bmatrix}\"></span>","o":""},{"n":"15","s":[["3 \\times 2 \\;,\\; 2 \\times 3","الضرب ممكن، ورتبة الناتج <span class=m dir=ltr>3 × 3</span>"],["\\begin{bmatrix}10 + 0 & -12 - 6 & 8 + 3 \\\\ -45 + 0 & 54 - 30 & -36 + 15 \\\\ -15 + 0 & 18 - 6 & -12 + 3\\end{bmatrix}","بضرب كل صف في كل عمود"],["\\begin{bmatrix}10 & -18 & 11 \\\\ -45 & 24 & -21 \\\\ -15 & 12 & -9\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}10 &amp; -18 &amp; 11 \\\\ -45 &amp; 24 &amp; -21 \\\\ -15 &amp; 12 &amp; -9\\end{bmatrix}\"></span>","o":""},{"n":"16","s":[["2 \\times 1 \\;,\\; 1 \\times 2","الضرب ممكن، ورتبة الناتج <span class=m dir=ltr>2 × 2</span>"],["\\begin{bmatrix}2(-1) & 2(4) \\\\ 5(-1) & 5(4)\\end{bmatrix}","بضرب كل صف في كل عمود"],["\\begin{bmatrix}-2 & 8 \\\\ -5 & 20\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}-2 &amp; 8 \\\\ -5 &amp; 20\\end{bmatrix}\"></span>","o":""},{"n":"17","s":[["\\begin{bmatrix}2(8) + 4(-4) & 2(-14) + 4(7) \\\\ 0(8) + 3(-4) & 0(-14) + 3(7)\\end{bmatrix}","الضرب ممكن <span class=m dir=ltr>(2 × 2</span> في <span class=m dir=ltr>2 × 2)</span>"],["\\begin{bmatrix}0 & 0 \\\\ -12 & 21\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}0 &amp; 0 \\\\ -12 &amp; 21\\end{bmatrix}\"></span>","o":""},{"n":"18","s":[["\\begin{bmatrix}3 & -1 \\\\ 2 & 5\\end{bmatrix}\\times\\begin{bmatrix}3 & -1 \\\\ 2 & 5\\end{bmatrix}","<span class=m dir=ltr>A² = A × A (</span>مصفوفة مربعة)"],["\\begin{bmatrix}9 - 2 & -3 - 5 \\\\ 6 + 10 & -2 + 25\\end{bmatrix}","بضرب كل صف في كل عمود"],["\\begin{bmatrix}7 & -8 \\\\ 16 & 23\\end{bmatrix}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\begin{bmatrix}7 &amp; -8 \\\\ 16 &amp; 23\\end{bmatrix}\"></span>","o":""},{"n":"19","s":[["2 \\times 3 \\;,\\; 2 \\times 3","عدد أعمدة المصفوفة <span class=m dir=ltr>(3) ≠</span> عدد صفوفها <span class=m dir=ltr>(2)</span>"]],"a":"لا يمكن إيجاد مربع المصفوفة؛ لأنها ليست مربعة","o":""}],[{"n":"20","s":[["P = \\begin{bmatrix}12 & 10 & 0 \\\\ 4 & 4 & 20 \\\\ 8 & 9 & 12\\end{bmatrix}","مصفوفة الإنتاج: الصفوف المدن <span class=m dir=ltr>A, B, C</span>، والأعمدة الطرازات <span class=m dir=ltr>X, D, R</span>"],["G = \\begin{bmatrix}1000 \\\\ 2000 \\\\ 1500\\end{bmatrix}","مصفوفة الربح لكل سيارة <span class=m dir=ltr>(JD)</span> بالترتيب <span class=m dir=ltr>X, D, R</span>"],["PG = \\begin{bmatrix}12(1000) + 10(2000) + 0(1500) \\\\ 4(1000) + 4(2000) + 20(1500) \\\\ 8(1000) + 9(2000) + 12(1500)\\end{bmatrix}","الضرب ممكن <span class=m dir=ltr>(3 × 3</span> في <span class=m dir=ltr>3 × 1)</