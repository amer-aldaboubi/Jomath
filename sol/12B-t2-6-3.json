[[{"n":"1","s":[["c = 95\\% \\Rightarrow z = 1.96","القيمة الحرجة (المجتمع طبيعي و <span class=\"tx\" data-t=\"\\sigma\"></span> معلوم)"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}}","صيغة الحدّ الأقصى لخطأ التقدير"],["= 1.96 \\times \\frac{5}{\\sqrt{10}}","بتعويض <span class=\"tx\" data-t=\"z = 1.96,\\ \\sigma = 5,\\ n = 10\"></span>"],["\\approx 3.10","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"E \\approx 3.10\"></span> مكالمة؛ أي إنني واثق بنسبة <span class=m dir=ltr>95%</span> أن الوسط الحسابي لعدد المكالمات اليومية لجميع موظفي القسم <span class=\"tx\" data-t=\"\\mu\"></span> لن يبتعد أكثر من <span class=m dir=ltr>3.10</span> مكالمة عن الوسط الحسابي للعيّنة البالغ <span class=m dir=ltr>30</span> مكالمة.","o":""}],[{"n":"2","s":[["c = 90\\% \\Rightarrow z = 1.64","القيمة الحرجة"],["E = z \\times \\frac{s}{\\sqrt{n}}","<span class=\"tx\" data-t=\"\\sigma\"></span> غير معلوم و <span class=\"tx\" data-t=\"n = 35 \\ge 30\"></span>"],["= 1.64 \\times \\frac{10}{\\sqrt{35}}","بتعويض <span class=\"tx\" data-t=\"z = 1.64,\\ s = 10,\\ n = 35\"></span>"],["\\approx 2.77","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"E \\approx 2.77\\text{ JD}\"></span>؛ أي إنني واثق بنسبة <span class=m dir=ltr>90%</span> أن الوسط الحسابي لإنفاق جميع مراجعي الصيدلية الشهري على الأدوية لن يبتعد أكثر من <span class=m dir=ltr>2.77 JD</span> عن الوسط الحسابي للعيّنة البالغ <span class=m dir=ltr>38 JD</span>.","o":""}],[{"n":"3","s":[["c = 94\\% \\Rightarrow P(Z < z) = 0.97 \\Rightarrow z = 1.88","القيمة الحرجة من الجدول"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}} = 1.88 \\times \\frac{0.3}{\\sqrt{50}} \\approx 0.08","الحدّ الأقصى لخطأ التقدير"],["\\overline{x} - E < \\mu < \\overline{x} + E","صيغة فترة الثقة"],["501 - 0.08 < \\mu < 501 + 0.08","بالتعويض"],["500.92 < \\mu < 501.08","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"500.92 &lt; \\mu &lt; 501.08\"></span>؛ أي إنني واثق بنسبة <span class=m dir=ltr>94%</span> أن الوسط الحسابي لأطوال جميع الحبال التي يُنتِجها المصنع يقع بين <span class=\"tx\" data-t=\"500.92\\text{ cm}\"></span> و <span class=\"tx\" data-t=\"501.08\\text{ cm}\"></span>.","o":""}],[{"n":"4","s":[["c = 96\\% \\Rightarrow P(Z < z) = 0.98 \\Rightarrow z = 2.05","القيمة الحرجة (المجتمع طبيعي فلا يُشترَط <span class=\"tx\" data-t=\"n \\ge 30\"></span>)"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}} = 2.05 \\times \\frac{20}{\\sqrt{12}} \\approx 11.84","الحدّ الأقصى لخطأ التقدير"],["\\overline{x} - E < \\mu < \\overline{x} + E","صيغة فترة الثقة"],["460 - 11.84 < \\mu < 460 + 11.84","بالتعويض"],["448.16 < \\mu < 471.84","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"448.16 &lt; \\mu &lt; 471.84\"></span>؛ أي إنني واثق بنسبة <span class=m dir=ltr>96%</span> أن الوسط الحسابي لكتل جميع كعكات الجوز التي يصنعها المحل يقع بين <span class=\"tx\" data-t=\"448.16\\text{ g}\"></span> و <span class=\"tx\" data-t=\"471.84\\text{ g}\"></span>.","o":""}],[{"n":"5","s":[["c = 98\\% \\Rightarrow P(Z < z) = 0.99 \\Rightarrow z = 2.33","القيمة الحرجة"],["E = z \\times \\frac{s}{\\sqrt{n}} = 2.33 \\times \\frac{5}{\\sqrt{125}} \\approx 1.04","<span class=\"tx\" data-t=\"\\sigma\"></span> غير معلوم و <span class=\"tx\" data-t=\"n = 125 \\ge 30\"></span>"],["\\overline{x} - E < \\mu < \\overline{x} + E","صيغة فترة الثقة"],["58 - 1.04 < \\mu < 58 + 1.04","بالتعويض"],["56.96 < \\mu < 59.04","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"56.96 &lt; \\mu &lt; 59.04\"></span>؛ أي إنني واثق بنسبة <span class=m dir=ltr>98%</span> أن الوسط الحسابي لكتل جميع البيض الذي تُنتِجه المزرعة يقع بين <span class=\"tx\" data-t=\"56.96\\text{ g}\"></span> و <span class=\"tx\" data-t=\"59.04\\text{ g}\"></span>.","o":""}],[{"n":"6","s":[["c = 90\\% \\Rightarrow z = 1.64,\\quad E = 1.5,\\quad \\sigma = 9","المعطيات"],["n = \\left(\\frac{z\\,\\sigma}{E}\\right)^2","صيغة الحدّ الأدنى لحجم العيّنة"],["= \\left(\\frac{1.64 \\times 9}{1.5}\\right)^2 = (9.84)^2","بالتعويض"],["= 96.8256 \\approx 97","نقرّب الناتج إلى الأعلى"]],"a":"حجم العيّنة اللازم: <span class=\"tx\" data-t=\"n = 97\"></span> عميلًا","o":"","k":[{"e":"97","a":null}]}],[{"n":"7","s":[["c = 95\\% \\Rightarrow z = 1.96,\\quad E = 0.8,\\quad \\sigma = 0.6","المعطيات"],["n = \\left(\\frac{z\\,\\sigma}{E}\\right)^2","صيغة الحدّ الأدنى لحجم العيّنة"],["= \\left(\\frac{1.96 \\times 0.6}{0.8}\\right)^2 = (1.47)^2","بالتعويض"],["= 2.1609 \\approx 3","نقرّب الناتج إلى الأعلى"]],"a":"الحدّ الأدنى لحجم العيّنة: <span class=\"tx\" data-t=\"n = 3\"></span> مرضى","o":"يكفي هذا العدد الصغير لأن المجتمع طبيعي و <span class=\"tx\" data-t=\"\\sigma\"></span> معلوم.","k":[{"e":"3","a":null}]}],[{"n":"8","s":[["\\overline{x} = \\frac{\\sum x_i}{n} = \\frac{3012}{50} = 60.24","الوسط الحسابي للعيّنة"],["s^2 = \\frac{\\sum x_i^2 - n\\overline{x}^2}{n-1} = \\frac{189354 - 50(60.24)^2}{49} = \\frac{7911.12}{49} \\approx 161.45","تباين العيّنة"],["s = \\sqrt{161.45} \\approx 12.71","الانحراف المعياري للعيّنة"],["E = z \\times \\frac{s}{\\sqrt{n}} = 2.57 \\times \\frac{12.71}{\\sqrt{50}} \\approx 4.62","<span class=\"tx\" data-t=\"c = 99\\% \\Rightarrow z = 2.57\"></span>"],["60.24 - 4.62 < \\mu < 60.24 + 4.62","صيغة فترة الثقة"],["55.62 < \\mu < 64.86","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"55.62 &lt; \\mu &lt; 64.86\"></span>؛ أي إنني واثق بنسبة <span class=m dir=ltr>99%</span> أن الوسط الحسابي لعدد الدقائق التي تقضيها جميع طالبات المعلّمة في أداء الواجبات أسبوعيًّا يقع بين <span class=m dir=ltr>55.62</span> دقيقة و <span class=m dir=ltr>64.86</span> دقيقة.","o":""}],[{"n":"9","s":[["\\overline{x} = \\frac{179.2 + 182.6}{2}","الوسط الحسابي للعيّنة يقع في منتصف فترة الثقة"],["= 180.9","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\overline{x} = 180.9\\text{ cm}\"></span>؛ لأن فترة الثقة متماثلة حول <span class=\"tx\" data-t=\"\\overline{x}\"></span> <span class=\"tx\" data-t=\"(\\overline{x} \\pm E)\"></span>.","o":""},{"n":"10","s":[["E = \\frac{182.6 - 179.2}{2} = 1.7","الحدّ الأقصى للخطأ <span class=m dir=ltr>=</span> نصف طول الفترة"],["c = 98\\% \\Rightarrow z = 2.33","القيمة الحرجة"],["1.7 = 2.33 \\times \\frac{\\sigma}{\\sqrt{200}}","صيغة <span class=\"tx\" data-t=\"E\"></span>"],["\\sigma = \\frac{1.7\\sqrt{200}}{2.33} \\approx 10.32","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\sigma \\approx 10.32\\text{ cm}\"></span>؛ لأن نصف طول فترة الثقة يساوي <span class=\"tx\" data-t=\"E = z\\frac{\\sigma}{\\sqrt{n}}\"></span>.","o":""},{"n":"11","s":[["E = 1.96 \\times \\frac{10.32}{\\sqrt{200}} \\approx 1.43","<span class=\"tx\" data-t=\"c = 95\\% \\Rightarrow z = 1.96\"></span>"],["180.9 - 1.43 < \\mu < 180.9 + 1.43","صيغة فترة الثقة"],["179.47 < \\mu < 182.33","بالتبسيط"]],"a":"فترة الثقة بمستوى <span class=m dir=ltr>95%</span>: <span class=\"tx\" data-t=\"179.47 &lt; \\mu &lt; 182.33\"></span>؛ وهي أضيق من فترة <span class=m dir=ltr>98%</span> لأن القيمة الحرجة أصغر.","o":""}],[{"n":"12","s":[["\\overline{m} = \\frac{15924}{50} = 318.48","الوسط الحسابي للعيّنة"],["s^2 = \\frac{5085213 - 50(318.48)^2}{49} = \\frac{13737.48}{49} \\approx 280.36","تباين العيّنة"],["s = \\sqrt{280.36} \\approx 16.74","الانحراف المعياري للعيّنة"],["c = 92\\% \\Rightarrow P(Z < z) = 0.96 \\Rightarrow z = 1.75","القيمة الحرجة من الجدول"],["E = 1.75 \\times \\frac{16.74}{\\sqrt{50}} \\approx 4.14","الحدّ الأقصى لخطأ التقدير"],["314.34 < \\mu < 322.62","<span class=\"tx\" data-t=\"318.48 \\pm 4.14\"></span>"]],"a":"فترة الثقة بمستوى <span class=m dir=ltr>92%</span>: <span class=\"tx\" data-t=\"314.34 &lt; \\mu &lt; 322.62\"></span> (بالغرام)","o":""},{"n":"13","s":[["2E = 10 \\Rightarrow E = 5","طول الفترة يساوي ضعف الحدّ الأقصى للخطأ"],["5 = z \\times \\frac{16.74}{\\sqrt{50}}","صيغة <span class=\"tx\" data-t=\"E\"></span>"],["z = \\frac{5\\sqrt{50}}{16.74} \\approx 2.11","بحل المعادلة"],["c = 2P(Z < 2.11) - 1 = 2(0.9826) - 1 = 0.9652","باستعمال الجدول"]],"a":"<span class=\"tx\" data-t=\"x \\approx 96.52\"></span>؛ أي إن مستوى الثقة نحو <span class=m dir=ltr>96.5%</span>","o":""}],[{"n":"6","s":[["z = 2.57","القيمة الحرجة المقابلة لمستوى الثقة <span class=m dir=ltr>99%</span>"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}} = 2.57 \\times \\frac{3}{\\sqrt{75}}","بتعويض <span class=\"tx\" data-t=\"\\sigma = 3,\\ n = 75\"></span>"],["\\approx 0.89","بالتبسيط"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"0.89\"></span> <span class=m dir=ltr>JD</span>","o":"","k":[{"e":"0.89","a":true}]}],[{"n":"8","s":[["E = z \\times \\frac{\\sigma}{\\sqrt{n}} \\Rightarrow n = \\left(\\frac{z\\sigma}{E}\\right)^2","صيغة الحدّ الأقصى لخطأ التقدير"],["n = \\left(\\frac{1.96 \\times 4.8}{1.2}\\right)^2 = (7.84)^2 \\approx 61.47","بتعويض <span class=\"tx\" data-t=\"z = 1.96,\\ \\sigma = 4.8,\\ E = 1.2\"></span>"],["n = 62","نقرّب دائمًا إلى العدد الصحيح الأكبر"]],"a":"<span class=m dir=ltr>b)</span> <span class=\"tx\" data-t=\"62\"></span>","o":"","k":[{"e":"62","a":null}]}],[{"n":"17","s":[["z = 2.57","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>99%</span>"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}} = 2.57 \\times \\frac{1.8}{\\sqrt{20}} \\approx 1.03","المجتمع طبيعي والانحراف المعياري معلوم"],["\\bar{x} - E \\le \\mu \\le \\bar{x} + E","صيغة فترة الثقة"],["4.2 - 1.03 \\le \\mu \\le 4.2 + 1.03 \\Rightarrow 3.17 \\le \\mu \\le 5.23","بالتعويض والتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"3.17 \\le \\mu \\le 5.23\"></span> <span class=m dir=ltr>kg</span>؛ أي أنني واثق بنسبة <span class=m dir=ltr>99%</span> أن الوسط الحسابي لكتل القطط المنزلية يقع بين <span class=\"tx\" data-t=\"3.17\"></span> <span class=m dir=ltr>kg</span> و <span class=\"tx\" data-t=\"5.23\"></span> <span class=m dir=ltr>kg</span>","o":""}],[{"n":"18","s":[["z = 1.28","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>80%</span>: <span class=\"tx\" data-t=\"P(Z &lt; z) = 0.90\"></span>"],["E = 1.28 \\times \\frac{100}{\\sqrt{50}} \\approx 18.10","صيغة الحدّ الأقصى لخطأ التقدير"],["870 - 18.10 \\le \\mu \\le 870 + 18.10","صيغة فترة الثقة"],["851.90 \\le \\mu \\le 888.10","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"851.9 \\le \\mu \\le 888.1\"></span> ساعة؛ أي أنني واثق بنسبة <span class=m dir=ltr>80%</span> أن الوسط الحسابي لمدة عمل مصابيح المصنع يقع بين <span class=\"tx\" data-t=\"851.9\"></span> و <span class=\"tx\" data-t=\"888.1\"></span> ساعة","o":""}],[{"n":"19","s":[["\\bar{x} = \\frac{35.2 + 39.6}{2}","الوسط الحسابي للعيّنة هو منتصف فترة الثقة"],["= 37.4","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\bar{x} = 37.4\"></span> <span class=m dir=ltr>m</span>","o":""},{"n":"20","s":[["E = \\frac{39.6 - 35.2}{2} = 2.2","الحدّ الأقصى لخطأ التقدير نصف طول الفترة"],["z = 2.33","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>98%</span>: <span class=\"tx\" data-t=\"P(Z &lt; z) = 0.99\"></span>"],["2.2 = 2.33 \\times \\frac{\\sigma}{\\sqrt{50}}","صيغة الحدّ الأقصى لخطأ التقدير"],["\\sigma = \\frac{2.2\\sqrt{50}}{2.33} \\approx 6.68","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\sigma \\approx 6.68\"></span> <span class=m dir=ltr>m</span>","o":""},{"n":"21","s":[["E = 2.57 \\times \\frac{6.68}{\\sqrt{50}} \\approx 2.43","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>99%</span> هي <span class=m dir=ltr>2.57</span>"],["37.4 - 2.43 \\le \\mu \\le 37.4 + 2.43","صيغة فترة الثقة"],["34.97 \\le \\mu \\le 39.83","بالتبسيط"]],"a":"فترة الثقة بمستوى <span class=m dir=ltr>99%</span>: <span class=\"tx\" data-t=\"34.97 \\le \\mu \\le 39.83\"></span>","o":""}],[{"n":"1","s":[["z = 1.64","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>90%</span>"],["E = z \\times \\frac{\\sigma}{\\sqrt{n}} = 1.64 \\times \\frac{1.2}{\\sqrt{50}}","بتعويض <span class=\"tx\" data-t=\"\\sigma = 1.2,\\ n = 50\"></span>"],["\\approx 0.28","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"E \\approx 0.28\"></span> ساعة؛ أي أنني واثق بنسبة <span class=m dir=ltr>90%</span> أن الوسط الحسابي لساعات الدراسة لطلبة المدرسة لن يبتعد أكثر من <span class=\"tx\" data-t=\"0.28\"></span> ساعة عن <span class=\"tx\" data-t=\"4.8\"></span> ساعات","o":""}],[{"n":"2","s":[["z = 2.57","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>99%</span>"],["E = z \\times \\frac{s}{\\sqrt{n}} = 2.57 \\times \\frac{1.8}{\\sqrt{30}}","<span class=\"tx\" data-t=\"n \\ge 30\"></span> فنستعمل <span class=\"tx\" data-t=\"s\"></span> بدلًا من <span class=\"tx\" data-t=\"\\sigma\"></span>"],["\\approx 0.84","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"E \\approx 0.84\"></span> كتاب؛ أي أنني واثق بنسبة <span class=m dir=ltr>99%</span> أن الوسط الحسابي لعدد الكتب المقروءة لن يبتعد أكثر من <span class=\"tx\" data-t=\"0.84\"></span> كتاب عن <span class=\"tx\" data-t=\"5\"></span> كتب","o":""}],[{"n":"3","s":[["E = 2.57 \\times \\frac{3.2}{\\sqrt{50}} \\approx 1.16","القيمة الحرجة لمستوى الثقة <span class=m dir=ltr>99%</span> هي <span class=m dir=ltr>2.57</span>"],["\\bar{x} - E \\le \\mu \\le \\bar{x} + E","صيغة فترة الثقة"],["502 - 1.16 \\le \\mu \\le 502 + 1.16","بالتعويض"],["500.84 \\le \\mu \\le 503.16","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"500.84 \\le \\mu \\le 503.16\"></span> <span class=m dir=ltr>g</span>؛ أي أنني واثق بنسبة <span class=m dir=ltr>99%</span> أن الوسط الحسابي لكتل أكياس السكّر يقع بين <span class=\"tx\" data-t=\"500.84\"></span> <span class=m dir=ltr>g</span> و <span class=\"tx\" data-t=\"503.16\"></span> <span class=m dir=ltr>g</span>","o":""}],[{"n":"4","s":[["E = 2.57 \\times \\frac{4.5}{\\sqrt{20}} \\approx 2.59","المجتمع طبيعي و <span class=\"tx\" data-t=\"\\sigma\"></span> معلوم"],["16.4 - 2.59 \\le \\mu \\le 16.4 + 2.59","صيغة فترة الثقة"],["13.81 \\le \\mu \\le 18.99","بالتبسيط"]],"a":"فترة الثقة: <span class=\"tx\" data-t=\"13.81 \\le \\mu \\le 18.99\"></span> <span class=m dir=ltr>m</span>؛ أي أنني واثق بنسبة <span class=m dir=ltr>99%</span> أن الوسط الحسابي لأطوال هذا النوع من النخيل يقع بين <span class=\"tx\" data-t=\"13.81\"></span> <span class=m dir=ltr>m</span> و <span class=\"tx\" data-t=\"18.99\"></span> <span class=m dir=ltr>m</span>","o":""}],[{"n":"5","s":[["n = \\left(\\frac{z\\sigma}{E}\\right)^2","من صيغة الحدّ الأقصى لخطأ التقدير"],["= \\left(\\frac{1.64 \\times 1600}{400}\\right)^2 = (6.56)^2 \\approx 43.03","بتعويض <span class=\"tx\" data-t=\"z = 1.64,\\ \\sigma = 1600,\\ E = 400\"></span>"],["n = 44","نقرّب إلى العدد الصحيح الأكبر"]],"a":"حجم العيّنة اللازم: <span class=\"tx\" data-t=\"44\"></span> بالغًا على الأقل","o":""}],[{"n":"6","s":[["\\bar{x} = \\frac{117.2}{10} = 11.72","الوسط الحسابي للعيّنة"],["E = 1.96 \\times \\frac{0.5}{\\sqrt{10}} \\approx 0.31","المجتمع طبيعي والانحراف المعياري معلوم"],["11.72 - 0.31 \\le \\mu \\le 11.72 + 0.31","صيغة فترة الثقة"],["11.41 \\le \\mu \\le 12.03","بالتبسيط"]],"a":"فترة الثقة بمستوى <span class=m dir=ltr>95%</span>: <span class=\"tx\" data-t=\"11.41 \\le \\mu \\le 12.03\"></span>","o":""}],[{"n":"7","s":[["1.96 \\times \\frac{0.5}{\\sqrt{10}} = z \\times \\frac{0.5}{\\sqrt{20}}","طول الفترتين متساوٍ، إذن الحدّ الأقصى لخطأ التقدير متساوٍ"],["z = 1.96 \\times \\frac{\\sqrt{20}}{\\sqrt{10}} = 1.96\\sqrt{2} \\approx 2.77","بحل المعادلة"],["c = 2P(Z < 2.77) - 1 = 2(0.9972) - 1","<span class=\"tx\" data-t=\"c = P(-z &lt; Z &lt; z)\"></span>"],["= 0.9944","باستعمال الجدول"]],"a":"مستوى الثقة <span class=\"tx\" data-t=\"\\approx 99.44\\%\"></span>","o":"","k":[{"e":"99.44","a":true}]}]]