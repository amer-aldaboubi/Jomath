[[{"n":"1","s":[["A\\cup\\overline{B}","المنطقة المظللة: الحادث <span class=m dir=ltr>A</span> مع كل ما هو خارج <span class=m dir=ltr>B</span>"]],"a":"<span class=\"tx\" data-t=\"A\\cup\\overline{B}\"></span> (أو <span class=\"tx\" data-t=\"\\overline{B-A}\"></span>)","o":""},{"n":"2","s":[["A-B","المظلل هو الجزء من <span class=m dir=ltr>A</span> غير المشترك مع <span class=m dir=ltr>B</span>"]],"a":"<span class=\"tx\" data-t=\"A-B\"></span>","o":""}],[{"n":"3","s":[["A\\cap B\\cap C","المظلل الجزء المشترك بين الحوادث الثلاثة"]],"a":"<span class=\"tx\" data-t=\"A\\cap B\\cap C\"></span>","o":""},{"n":"4","s":[["A\\cup B\\cup C","المظلل جميع مناطق الدوائر الثلاث"]],"a":"<span class=\"tx\" data-t=\"A\\cup B\\cup C\"></span>","o":""}],[{"n":"5","s":[["A=\\{2,4,6,8\\},\\ n(\\Omega)=10","من شكل فن"],["P(A)=\\frac{4}{10}=\\frac{2}{5}",""]],"a":"<span class=\"tx\" data-t=\"P(A)=\\frac{2}{5}\"></span>","o":""},{"n":"6","s":[["B=\\{6,7,8,9\\}",""],["P(B)=\\frac{4}{10}=\\frac{2}{5}",""]],"a":"<span class=\"tx\" data-t=\"P(B)=\\frac{2}{5}\"></span>","o":""},{"n":"7","s":[["A\\cap B=\\{6,8\\}",""],["P(A\\cap B)=\\frac{2}{10}=\\frac{1}{5}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}\"></span>","o":""},{"n":"8","s":[["A\\cup B=\\{2,4,6,7,8,9\\}",""],["P(A\\cup B)=\\frac{6}{10}=\\frac{3}{5}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5}\"></span>","o":""},{"n":"9","s":[["P(\\overline{A})=1-P(A)=1-\\frac{2}{5}=\\frac{3}{5}","صيغة احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5}\"></span>","o":""},{"n":"10","s":[["P(\\overline{B})=1-\\frac{2}{5}=\\frac{3}{5}","صيغة احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5}\"></span>","o":""},{"n":"11","s":[["P(\\overline{A\\cap B})=1-\\frac{1}{5}=\\frac{4}{5}","صيغة احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{4}{5}\"></span>","o":""},{"n":"12","s":[["P(\\overline{A\\cup B})=1-\\frac{3}{5}=\\frac{2}{5}","العناصر خارج الدائرتين: <span class=m dir=ltr>0, 1, 3, 5</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{5}\"></span>","o":""},{"n":"13","s":[["B-A=\\{7,9\\}","عناصر <span class=m dir=ltr>B</span> غير الموجودة في <span class=m dir=ltr>A</span>"],["P(B-A)=\\frac{2}{10}=\\frac{1}{5}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}\"></span>","o":""}],[{"n":"14","s":[["F=\\{15,30,45,60,75,90\\},\\ T=\\{10,20,\\dots,100\\}","مضاعفات <span class=m dir=ltr>15 (6</span> أعداد) ومضاعفات <span class=m dir=ltr>10 (10</span> أعداد)"],["F\\cap T=\\{30,60,90\\}","مضاعفات العددين معًا (في منطقة التقاطع بشكل فن)"],["P(F\\cap T)=\\frac{3}{100}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{100}\"></span>","o":"شكل فن: <span class=m dir=ltr>3</span> في التقاطع، <span class=m dir=ltr>3</span> في <span class=m dir=ltr>F</span> فقط، <span class=m dir=ltr>7</span> في <span class=m dir=ltr>T</span> فقط، <span class=m dir=ltr>87</span> خارج الدائرتين."},{"n":"15","s":[["n(F\\cup T)=3+3+7=13",""],["P(F\\cup T)=\\frac{13}{100}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{13}{100}\"></span>","o":""},{"n":"16","s":[["T-F=\\{10,20,40,50,70,80,100\\}","مضاعفات <span class=m dir=ltr>10</span> فقط"],["P(T-F)=\\frac{7}{100}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{7}{100}\"></span>","o":""},{"n":"17","s":[["P(\\overline{F\\cup T})=1-\\frac{13}{100}=\\frac{87}{100}","صيغة احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{87}{100}\"></span>","o":""}],[{"n":"18","s":[["N\\cap S=64","<span class=m dir=ltr>N</span>: يراجعون اختصاصيي التغذية، <span class=m dir=ltr>S</span>: يمارسون الرياضة"],["N\\ \\text{only}=130-64=66,\\quad S\\ \\text{only}=147-64=83",""],["P(N\\cap S)=\\frac{64}{320}=\\frac{1}{5}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{5}\"></span>","o":"شكل فن: <span class=m dir=ltr>66</span> في <span class=m dir=ltr>N</span> فقط، <span class=m dir=ltr>64</span> في التقاطع، <span class=m dir=ltr>83</span> في <span class=m dir=ltr>S</span> فقط، <span class=m dir=ltr>107</span> خارج الدائرتين."},{"n":"19","s":[["P(S-N)=\\frac{83}{320}","يمارسون الرياضة فقط"]],"a":"<span class=\"tx\" data-t=\"\\frac{83}{320}\"></span>","o":""},{"n":"20","s":[["320-(66+64+83)=107","لا يمارسون الرياضة ولا يراجعون"],["P(\\overline{N\\cup S})=\\frac{107}{320}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{107}{320}\"></span>","o":""}],[{"n":"21","s":[["n(\\Omega)=3+2+25=30","عدد الطالبات"],["P(G\\cap L)=\\frac{0}{30}=0","الحادثان متنافيان (الدائرتان منفصلتان)"]],"a":"<span class=\"tx\" data-t=\"0\"></span>","o":""},{"n":"22","s":[["P(G\\cup L)=\\frac{3+2}{30}=\\frac{5}{30}=\\frac{1}{6}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""},{"n":"23","s":[["P(\\overline{G})=1-\\frac{3}{30}=\\frac{27}{30}=\\frac{9}{10}","صيغة احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{9}{10}\"></span>","o":""}],[{"n":"24","s":[["0.2+0.25+0.15+x+0.15+0.1=1","مجموع احتمالات الحوادث المتنافية والشاملة يساوي <span class=m dir=ltr>1</span>"],["0.85+x=1","بجمع الثوابت"],["x=0.15","بطرح <span class=m dir=ltr>0.85</span> من الطرفين"]],"a":"<span class=\"tx\" data-t=\"x=0.15\"></span>","o":""}],[{"n":"25","s":[["75-10=65","عدد من يدرسون الكورية فقط"],["P=\\frac{65}{120}=\\frac{13}{24}","احتمال الكورية فقط"]],"a":"<span class=\"tx\" data-t=\"\\frac{13}{24}\\approx 0.54\"></span>","o":"مسألة اليوم: <span class=m dir=ltr>120</span> طالبًا، <span class=m dir=ltr>75</span> كورية، <span class=m dir=ltr>35</span> إسبانية، <span class=m dir=ltr>10</span> اللغتين. شكل فن: <span class=m dir=ltr>65</span> كورية فقط، <span class=m dir=ltr>10</span> تقاطع، <span class=m dir=ltr>25</span> إسبانية فقط، <span class=m dir=ltr>20</span> خارجهما."}],[{"n":"26","s":[["n(\\Omega)=16","النقاط <span class=m dir=ltr>(x, y)</span> حيث <span class=m dir=ltr>x</span> و <span class=m dir=ltr>y</span> من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>4</span>"],["A=\\{(1,1),(2,2),(3,3),(4,4)\\}","النقاط على المستقيم <span class=m dir=ltr>y = x</span>"],["B=\\{(1,3),(2,2),(3,1)\\}","النقاط على المستقيم <span class=m dir=ltr>y = 4 − x</span>"],["A\\cap B=\\{(2,2)\\}",""]],"a":"شكل فن: مستطيل <span class=\"tx\" data-t=\"\\Omega\"></span> فيه <span class=m dir=ltr>16</span> نقطة؛ في <span class=\"tx\" data-t=\"A\"></span> فقط: <span class=m dir=ltr>(1,1),(3,3),(4,4)</span>، في التقاطع: <span class=m dir=ltr>(2,2)</span>، في <span class=\"tx\" data-t=\"B\"></span> فقط: <span class=m dir=ltr>(1,3),(3,1)</span>، وخارج الدائرتين <span class=m dir=ltr>10</span> نقاط","o":""},{"n":"27","s":[["P(A\\cap B)=\\frac{1}{16}","النقطة <span class=m dir=ltr>(2,2)</span> هي الوحيدة الواقعة على المستقيمين معًا"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{16}\"></span>؛ لأن المستقيمين يتقاطعان في نقطة واحدة فقط من نقاط الفضاء العيني هي <span class=m dir=ltr>(2,2)</span>","o":""}],[{"n":"28","s":[["B\\subset A\\ \\Rightarrow\\ A\\cap B=B","<span class=m dir=ltr>B</span> داخل <span class=m dir=ltr>A</span>، فالمشترك بينهما هو <span class=m dir=ltr>B</span> نفسه"]],"a":"<span class=\"tx\" data-t=\"A\\cap B=B\"></span>","o":""},{"n":"29","s":[["A\\cup B=A","كل عناصر <span class=m dir=ltr>B</span> موجودة في <span class=m dir=ltr>A</span>"]],"a":"<span class=\"tx\" data-t=\"A\\cup B=A\"></span>","o":""},{"n":"30","s":[["B-A=\\varnothing","لا توجد عناصر في <span class=m dir=ltr>B</span> خارج <span class=m dir=ltr>A</span>"]],"a":"<span class=\"tx\" data-t=\"B-A=\\varnothing\"></span>","o":""}],[{"n":"31","s":[["\\Omega=\\{1,2,3,4,5,6\\}","تجربة رمي حجر نرد مرة واحدة"],["A=\\{1,2\\},\\ B=\\{3,4\\},\\ C=\\{5,6\\}","لا يوجد عنصر مشترك بين أي حادثين (متنافية)"],["A\\cup B\\cup C=\\Omega","اتحادها الفضاء العيني (شاملة)"],["P(A)+P(B)+P(C)=\\frac{2}{6}+\\frac{2}{6}+\\frac{2}{6}=1",""]],"a":"إجابة ممكنة: عند رمي حجر نرد: <span class=m dir=ltr>A</span> ظهور <span class=m dir=ltr>1</span> أو <span class=m dir=ltr>2</span>، <span class=m dir=ltr>B</span> ظهور <span class=m dir=ltr>3</span> أو <span class=m dir=ltr>4</span>، <span class=m dir=ltr>C</span> ظهور <span class=m dir=ltr>5</span> أو <span class=m dir=ltr>6</span>","o":""}],[{"n":"3","s":[["A\\cap C=\\varnothing","دائرتا <span class=m dir=ltr>A</span> و<span class=m dir=ltr>C</span> لا تتقاطعان في الشكل"],["A\\cup C\\ne\\Omega","توجد نواتج خارجهما (مثل منطقة <span class=m dir=ltr>B</span> فقط وخارج الدوائر)"]],"a":"<span class=\"tx\" data-t=\"A\"></span> و<span class=\"tx\" data-t=\"C\"></span> حادثان متنافيان وغير شاملين، رمز الإجابة: <span class=m dir=ltr>b</span>","o":""}],[{"n":"15","s":[["n(B\\cap F)=6,\\ n(B\\text{ only})=13-6=7,\\ n(F\\text{ only})=11-6=5","بتنظيم البيانات في شكل فن"],["n(\\overline{B\\cup F})=25-(7+6+5)=7","خارج الدائرتين"],["P(B\\cup F)=\\frac{7+6+5}{25}=\\frac{18}{25}","احتمال الاتحاد"]],"a":"<span class=\"tx\" data-t=\"P=\\frac{18}{25}=0.72\"></span>","o":""},{"n":"16","s":[["P(F-B)=\\frac{5}{25}=\\frac{1}{5}","كرة القدم فقط"]],"a":"<span class=\"tx\" data-t=\"P=\\frac{1}{5}=0.2\"></span>","o":""},{"n":"17","s":[["P(\\overline{B\\cup F})=\\frac{7}{25}","خارج الدائرتين"]],"a":"<span class=\"tx\" data-t=\"P=\\frac{7}{25}=0.28\"></span>","o":""}],[{"n":"22","s":[["X\\cap Y=\\{3\\}","من شكل فن"],["P(X\\cap Y)=\\frac{1}{6}","عدد عناصر الحادث <span class=m dir=ltr>÷ 6</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""},{"n":"23","s":[["X\\cup Y=\\{1,3,5,6\\}","من شكل فن"],["P(X\\cup Y)=\\frac{4}{6}=\\frac{2}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>","o":""},{"n":"24","s":[["\\overline{X\\cup Y}=\\{2,4\\}","خارج الدائرتين"],["P(\\overline{X\\cup Y})=\\frac{2}{6}=\\frac{1}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""},{"n":"25","s":[["X-Y=\\{1,5\\}","عناصر <span class=m dir=ltr>X</span> التي ليست في <span class=m dir=ltr>Y</span>"],["P(X-Y)=\\frac{2}{6}=\\frac{1}{3}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""}],[{"n":"1","s":[["S-T","عناصر <span class=m dir=ltr>S</span> التي ليست في <span class=m dir=ltr>T</span>"]],"a":"نظلل الجزء من دائرة <span class=\"tx\" data-t=\"S\"></span> خارج <span class=\"tx\" data-t=\"T\"></span> (الهلال الأيسر فقط)","o":""},{"n":"2","s":[["T-S","عناصر <span class=m dir=ltr>T</span> التي ليست في <span class=m dir=ltr>S</span>"]],"a":"نظلل الجزء من دائرة <span class=\"tx\" data-t=\"T\"></span> خارج <span class=\"tx\" data-t=\"S\"></span> (الهلال الأيمن فقط)","o":""},{"n":"3","s":[["\\overline{S}\\cap T=T-S","عناصر <span class=m dir=ltr>T</span> التي ليست في <span class=m dir=ltr>S</span>"]],"a":"نظلل الجزء من دائرة <span class=\"tx\" data-t=\"T\"></span> خارج <span class=\"tx\" data-t=\"S\"></span> (الهلال الأيمن)","o":""},{"n":"4","s":[["\\overline{S\\cup T}","متمم الاتحاد"]],"a":"نظلل كل المستطيل <span class=\"tx\" data-t=\"\\Omega\"></span> خارج الدائرتين","o":""},{"n":"5","s":[["A\\cap B\\cap C","المشترك بين الدوائر الثلاث"]],"a":"نظلل المنطقة الوسطى المشتركة بين الدوائر الثلاث فقط","o":""},{"n":"6","s":[["A\\cup B\\cup C","اتحاد الدوائر الثلاث"]],"a":"نظلل الدوائر الثلاث كاملة (كل ما داخل أي دائرة)","o":""}],[{"n":"7","s":[["P(X)=\\frac{3}{6}=\\frac{1}{2}","<span class=m dir=ltr>X = {1, 3, 5}</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>","o":""},{"n":"8","s":[["P(Y)=\\frac{2}{6}=\\frac{1}{3}","<span class=m dir=ltr>Y = {3, 6}</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""},{"n":"9","s":[["P(X\\cap Y)=\\frac{1}{6}","<span class=m dir=ltr>X</span> ∩ <span class=m dir=ltr>Y = {3}</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""},{"n":"10","s":[["P(X\\cup Y)=\\frac{4}{6}=\\frac{2}{3}","<span class=m dir=ltr>X</span> ∪ <span class=m dir=ltr>Y = {1, 3, 5, 6}</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>","o":""},{"n":"11","s":[["P(\\overline{X})=1-\\frac{1}{2}=\\frac{1}{2}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>","o":""},{"n":"12","s":[["P(\\overline{Y})=1-\\frac{1}{3}=\\frac{2}{3}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{2}{3}\"></span>","o":""},{"n":"13","s":[["P(\\overline{X\\cap Y})=1-\\frac{1}{6}=\\frac{5}{6}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{5}{6}\"></span>","o":""},{"n":"14","s":[["P(\\overline{X\\cup Y})=1-\\frac{2}{3}=\\frac{1}{3}","العنصران <span class=m dir=ltr>2</span> و<span class=m dir=ltr>4</span> خارج الدائرتين"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""},{"n":"15","s":[["Y-X=\\{6\\}\\Rightarrow P(Y-X)=\\frac{1}{6}","عناصر <span class=m dir=ltr>Y</span> التي ليست في <span class=m dir=ltr>X</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""}],[{"n":"16","s":[["E\\cap T\\cap F=\\{30\\}","المنطقة الوسطى"],["(E\\cap T)\\text{ only}=\\{6,12,18,24\\},\\ (E\\cap F)\\text{ only}=\\{10,20\\},\\ (T\\cap F)\\text{ only}=\\{15\\}","المناطق الثنائية فقط"],["E\\text{ only}=\\{2,4,8,14,16,22,26,28\\}","الزوجية فقط"],["T\\text{ only}=\\{3,9,21,27\\},\\ F\\text{ only}=\\{5,25\\}",""],["\\text{outside}=\\{1,7,11,13,17,19,23,29\\}","خارج الدوائر الثلاث"]],"a":"نكتب الأعداد أعلاه في مناطقها من شكل فن (<span class=\"tx\" data-t=\"n(E)=15,\\ n(T)=10,\\ n(F)=6\"></span>)","o":""},{"n":"17","s":[["P(T)=\\frac{10}{30}=\\frac{1}{3}","مضاعفات <span class=m dir=ltr>3</span> من <span class=m dir=ltr>1</span> إلى <span class=m dir=ltr>30</span> عددها <span class=m dir=ltr>10</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""},{"n":"18","s":[["T\\cap F=\\{15,30\\}\\Rightarrow P(T\\cap F)=\\frac{2}{30}=\\frac{1}{15}","مضاعفات <span class=m dir=ltr>3</span> و<span class=m dir=ltr>5</span> معًا"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{15}\"></span>","o":""},{"n":"19","s":[["P(F\\cup E)=P(F)+P(E)-P(F\\cap E)","احتمال اتحاد حادثين"],["=\\frac{6}{30}+\\frac{15}{30}-\\frac{3}{30}=\\frac{18}{30}=\\frac{3}{5}","<span class=m dir=ltr>F</span> ∩ <span class=m dir=ltr>E = {10, 20, 30}</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{5}\"></span>","o":""},{"n":"20","s":[["P(\\overline{E})=1-\\frac{15}{30}=\\frac{1}{2}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>","o":""}],[{"n":"21","s":[["S=\\{1,4,9\\},\\ E=\\{2,4,6,8,10,12\\}","المربعات الكاملة والأعداد الزوجية"],["S\\cap E=\\{4\\}","المنطقة المشتركة"],["S-E=\\{1,9\\},\\ E-S=\\{2,6,8,10,12\\}","داخل كل دائرة فقط"],["\\overline{S\\cup E}=\\{3,5,7,11\\}","خارج الدائرتين"]],"a":"نكتب العناصر أعلاه في مناطقها من شكل فن","o":""},{"n":"22","s":[["P(\\overline{E})=1-\\frac{6}{12}=\\frac{1}{2}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{2}\"></span>","o":""},{"n":"23","s":[["S\\cap\\overline{E}=\\{1,9\\}\\Rightarrow P=\\frac{2}{12}=\\frac{1}{6}","عناصر <span class=m dir=ltr>S</span> غير الزوجية"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{6}\"></span>","o":""},{"n":"24","s":[["\\overline{S\\cup E}=\\{3,5,7,11\\}\\Rightarrow P=\\frac{4}{12}=\\frac{1}{3}","خارج الدائرتين"]],"a":"<span class=\"tx\" data-t=\"\\frac{1}{3}\"></span>","o":""}],[{"n":"25","s":[["n(T\\cap C)=5,\\ n(T\\text{ only})=20-5=15,\\ n(C\\text{ only})=17-5=12","بتنظيم البيانات في شكل فن"],["P(T\\text{ only})=\\frac{15}{35}=\\frac{3}{7}","الشاي فقط"]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{7}\"></span>","o":""},{"n":"26","s":[["P(\\overline{C})=1-\\frac{17}{35}=\\frac{18}{35}","احتمال الحادث المتمم"]],"a":"<span class=\"tx\" data-t=\"\\frac{18}{35}\"></span>","o":""},{"n":"27","s":[["n(\\overline{T\\cup C})=35-(15+5+12)=3","خارج الدائرتين"],["P(\\overline{T\\cup C})=\\frac{3}{35}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{3}{35}\"></span>","o":""}],[{"n":"28","s":[["A\\cap B\\ne\\varnothing","المنحنيان <span class=m dir=ltr>A</span> و<span class=m dir=ltr>B</span> يتقاطعان قرب الطرف الأيسر"]],"a":"غير صحيحة؛ <span class=\"tx\" data-t=\"A\"></span> و<span class=\"tx\" data-t=\"B\"></span> غير متنافيين لوجود منطقة مشتركة بينهما","o":""},{"n":"29","s":[["A\\cap D=\\varnothing","منطقة <span class=m dir=ltr>A</span> في الركن العلوي الأيسر ومنطقة <span class=m dir=ltr>D</span> في الجهة اليمنى ولا يلتقيان"]],"a":"صحيحة؛ <span class=\"tx\" data-t=\"A\"></span> و<span class=\"tx\" data-t=\"D\"></span> متنافيان","o":""},{"n":"30","s":[["B\\cup C\\ne\\Omega","توجد نواتج خارجهما (مثل الركن العلوي الأيسر)"]],"a":"غير صحيحة؛ <span class=\"tx\" data-t=\"B\"></span> و<span class=\"tx\" data-t=\"C\"></span> غير شاملين","o":""},{"n":"31","s":[["A\\cup B\\cup C\\cup D\\cup E=\\Omega","كل نقطة في المستطيل تقع في منطقة واحدة على الأقل منها"]],"a":"صحيحة؛ الحوادث الخمسة شاملة لأن اتحادها يغطي الفضاء العيني كاملًا","o":""}]]