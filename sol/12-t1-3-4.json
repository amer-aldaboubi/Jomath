[[{"n":"1","s":[["2x-4y\\frac{dy}{dx}=0","باشتقاق الطرفين بالنسبة إلى <span class=m dir=ltr>x</span>"],["\\frac{dy}{dx}=\\frac{2x}{4y}=\\frac{x}{2y}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{x}{2y}\"></span>","o":"","k":[{"e":"x/(2*y)","a":null}]},{"n":"2","s":[["x^{-2}+y^{-2}=\\frac{1}{10}","بكتابة الحدود بأُسس سالبة"],["-2x^{-3}-2y^{-3}\\frac{dy}{dx}=0","باشتقاق الطرفين"],["\\frac{dy}{dx}=-\\frac{x^{-3}}{y^{-3}}=-\\frac{y^3}{x^3}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{y^3}{x^3}\"></span>","o":"","k":[{"e":"-y^3/x^3","a":null}]},{"n":"3","s":[["2(x^2+y^2)\\left(2x+2y\\frac{dy}{dx}\\right)=50\\left(2x-2y\\frac{dy}{dx}\\right)","قاعدة السلسلة"],["4x(x^2+y^2)+4y(x^2+y^2)\\frac{dy}{dx}=100x-100y\\frac{dy}{dx}","بالتوزيع"],["\\frac{dy}{dx}\\left(4y(x^2+y^2)+100y\\right)=100x-4x(x^2+y^2)","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{x\\left(25-x^2-y^2\\right)}{y\\left(25+x^2+y^2\\right)}","بالقسمة والتبسيط على <span class=m dir=ltr>4</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{x(25-x^2-y^2)}{y(25+x^2+y^2)}\"></span>","o":"","k":[{"e":"x*(-x^2 - y^2 + 25)/(y*(x^2 + y^2 + 25))","a":null}]},{"n":"4","s":[["e^x y+e^x\\frac{dy}{dx}=e^y+xe^y\\frac{dy}{dx}","مشتقة الضرب في الطرفين"],["\\frac{dy}{dx}(e^x-xe^y)=e^y-ye^x","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{e^y-ye^x}{e^x-xe^y}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{e^y-ye^x}{e^x-xe^y}\"></span>","o":"","k":[{"e":"(-e^x*y + exp(y))/(-e^y*x + exp(x))","a":null}]},{"n":"5","s":[["3^x\\ln 3=\\frac{dy}{dx}-2y-2x\\frac{dy}{dx}","مشتقة الاقتران الأسي ومشتقة الضرب"],["\\frac{dy}{dx}(1-2x)=3^x\\ln 3+2y","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{3^x\\ln 3+2y}{1-2x}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{3^x\\ln 3+2y}{1-2x}\"></span>","o":"","k":[{"e":"(3^x*log(3) + 2*y)/(1 - 2*x)","a":null}]},{"n":"6","s":[["\\frac{1}{2\\sqrt{x}}+\\frac{1}{2\\sqrt{y}}\\frac{dy}{dx}=0","باشتقاق الطرفين"],["\\frac{dy}{dx}=-\\frac{\\sqrt{y}}{\\sqrt{x}}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\sqrt{\\frac{y}{x}}\"></span>","o":"","k":[{"e":"-sqrt(y/x)","a":null}]},{"n":"7","s":[["1=\\sec\\frac{1}{y}\\tan\\frac{1}{y}\\cdot\\left(-\\frac{1}{y^2}\\right)\\frac{dy}{dx}","مشتقة <span class=m dir=ltr>sec</span> مع قاعدة السلسلة"],["\\frac{dy}{dx}=\\frac{-y^2}{\\sec\\frac{1}{y}\\tan\\frac{1}{y}}","بحل المعادلة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{y^2}{\\sec\\frac{1}{y}\\tan\\frac{1}{y}}=-y^2\\cos\\frac{1}{y}\\cot\\frac{1}{y}\"></span>","o":""},{"n":"8","s":[["2(\\sin\\pi x+\\cos\\pi y)\\left(\\pi\\cos\\pi x-\\pi\\sin\\pi y\\,\\frac{dy}{dx}\\right)=0","قاعدة السلسلة"],["\\sin\\pi x+\\cos\\pi y=\\pm\\sqrt{2}\\ne 0","من المعادلة الأصلية"],["\\pi\\cos\\pi x-\\pi\\sin\\pi y\\frac{dy}{dx}=0","بقسمة الطرفين على المقدار غير الصفري"],["\\frac{dy}{dx}=\\frac{\\cos\\pi x}{\\sin\\pi y}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{\\cos\\pi x}{\\sin\\pi y}\"></span>","o":"","k":[{"e":"cos(pi*x)/sin(pi*y)","a":null}]},{"n":"9","s":[["xy^{-2}+y^2x^{-1}=5",""],["y^{-2}-2xy^{-3}\\frac{dy}{dx}+\\frac{2y}{x}\\frac{dy}{dx}-\\frac{y^2}{x^2}=0","مشتقة الضرب"],["\\frac{dy}{dx}\\left(\\frac{2y}{x}-\\frac{2x}{y^3}\\right)=\\frac{y^2}{x^2}-\\frac{1}{y^2}","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{y^5-x^2y}{2xy^4-2x^3}=\\frac{y(y^4-x^2)}{2x(y^4-x^2)}","بضرب البسط والمقام في <span class=m dir=ltr>x^2y^3</span>"],["\\frac{dy}{dx}=\\frac{y}{2x}","بالاختصار <span class=m dir=ltr>(y^4 ≠ x^2)</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{y}{2x}\"></span>","o":"","k":[{"e":"y/(2*x)","a":null}]},{"n":"10","s":[["1+\\frac{dy}{dx}=-\\sin(xy)\\left(y+x\\frac{dy}{dx}\\right)","مشتقة <span class=m dir=ltr>cos</span> مع قاعدة السلسلة ومشتقة الضرب"],["\\frac{dy}{dx}\\left(1+x\\sin(xy)\\right)=-1-y\\sin(xy)","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=-\\frac{1+y\\sin(xy)}{1+x\\sin(xy)}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{1+y\\sin(xy)}{1+x\\sin(xy)}\"></span>","o":"","k":[{"e":"-(y*sin(x*y) + 1)/(x*sin(x*y) + 1)","a":null}]},{"n":"11","s":[["2x+2y\\frac{dy}{dx}=\\frac{2(x+y)\\left(1+\\frac{dy}{dx}\\right)}{(x+y)^2}=\\frac{2\\left(1+\\frac{dy}{dx}\\right)}{x+y}","مشتقة <span class=m dir=ltr>ln</span> مع قاعدة السلسلة"],["x(x+y)+y(x+y)\\frac{dy}{dx}=1+\\frac{dy}{dx}","بضرب الطرفين في <span class=m dir=ltr>(x+y)/2</span>"],["\\frac{dy}{dx}\\left(xy+y^2-1\\right)=1-x^2-xy","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{1-x^2-xy}{xy+y^2-1}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{1-x^2-xy}{xy+y^2-1}\"></span>","o":"","k":[{"e":"(-x^2 - x*y + 1)/(x*y + y^2 - 1)","a":null}]},{"n":"12","s":[["\\cos x\\cos y-\\sin x\\sin y\\frac{dy}{dx}=2x-5\\frac{dy}{dx}","مشتقة الضرب"],["\\frac{dy}{dx}(5-\\sin x\\sin y)=2x-\\cos x\\cos y","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{2x-\\cos x\\cos y}{5-\\sin x\\sin y}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{2x-\\cos x\\cos y}{5-\\sin x\\sin y}\"></span>","o":"","k":[{"e":"(2*x - cos(x)*cos(y))/(-sin(x)*sin(y) + 5)","a":null}]}],[{"n":"13","s":[["2y^2+y-1=0","بالتعويض <span class=m dir=ltr>x = 1/2</span> لإيجاد <span class=m dir=ltr>y</span>"],["(2y-1)(y+1)=0\\Rightarrow y=\\frac{1}{2}\\ \\text{or}\\ y=-1","بالتحليل"],["4y\\,y'+2y+2x\\,y'=0\\Rightarrow y'=\\frac{-y}{2y+x}","بالاشتقاق الضمني"],["\\left(\\tfrac12,\\tfrac12\\right):\\ y'=\\frac{-\\frac12}{\\frac32}=-\\frac{1}{3}",""],["\\left(\\tfrac12,-1\\right):\\ y'=\\frac{1}{-2+\\frac12}=-\\frac{2}{3}",""]],"a":"<span class=\"tx\" data-t=\"y&#x27;=-\\frac{1}{3}\"></span> عند <span class=\"tx\" data-t=\"\\left(\\frac12,\\frac12\\right)\"></span> ، و <span class=\"tx\" data-t=\"y&#x27;=-\\frac{2}{3}\"></span> عند <span class=\"tx\" data-t=\"\\left(\\frac12,-1\\right)\"></span>","o":"","k":[{"e":"-1/3","a":null},{"p":["1/2","1/2"]},{"e":"-2/3","a":null},{"p":["1/2","-1"]}]},{"n":"14","s":[["1+2x^2=11\\Rightarrow x=\\pm\\sqrt{5}","بالتعويض <span class=m dir=ltr>y = 1</span>"],["3y^2y'+4x=11y'","بالاشتقاق الضمني"],["y'=\\frac{4x}{11-3y^2}=\\frac{4x}{8}=\\frac{x}{2}","بالتعويض <span class=m dir=ltr>y = 1</span>"],["y'=\\pm\\frac{\\sqrt{5}}{2}",""]],"a":"<span class=\"tx\" data-t=\"y&#x27;=\\frac{\\sqrt5}{2}\"></span> عند <span class=\"tx\" data-t=\"(\\sqrt5,1)\"></span> ، و <span class=\"tx\" data-t=\"y&#x27;=-\\frac{\\sqrt5}{2}\"></span> عند <span class=\"tx\" data-t=\"(-\\sqrt5,1)\"></span>","o":"","k":[{"e":"sqrt(5)/2","a":null},{"p":["sqrt(5)","1"]},{"e":"-sqrt(5)/2","a":null},{"p":["-sqrt(5)","1"]}]}],[{"n":"15","s":[["2x+2y\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=-\\frac{x}{y}","الاشتقاق الضمني"],["\\frac{dy}{dx}\\Big|_{(3,-4)}=-\\frac{3}{-4}=\\frac{3}{4}","بالتعويض"]],"a":"الميل <span class=\"tx\" data-t=\"=\\frac{3}{4}\"></span>","o":""},{"n":"16","s":[["2xy+x^2\\frac{dy}{dx}=-4\\frac{dy}{dx}","مشتقة الضرب"],["\\frac{dy}{dx}=\\frac{-2xy}{x^2+4}","بحل المعادلة"],["\\frac{dy}{dx}\\Big|_{(2,1)}=\\frac{-4}{8}=-\\frac{1}{2}","بالتعويض"]],"a":"الميل <span class=\"tx\" data-t=\"=-\\frac{1}{2}\"></span>","o":""},{"n":"17","s":[["e^{\\sin x}\\cos x-e^{\\cos y}\\sin y\\frac{dy}{dx}=0","قاعدة السلسلة"],["\\frac{dy}{dx}=\\frac{e^{\\sin x}\\cos x}{e^{\\cos y}\\sin y}",""],["\\frac{dy}{dx}\\Big|_{(\\frac{\\pi}{2},\\frac{\\pi}{2})}=\\frac{e\\cdot 0}{1\\cdot 1}=0","بالتعويض"]],"a":"الميل <span class=\"tx\" data-t=\"=0\"></span>","o":""},{"n":"18","s":[["x^{\\frac23}+y^{\\frac23}=5",""],["\\frac23x^{-\\frac13}+\\frac23y^{-\\frac13}\\frac{dy}{dx}=0","باشتقاق الطرفين"],["\\frac{dy}{dx}=-\\frac{\\sqrt[3]{y}}{\\sqrt[3]{x}}",""],["\\frac{dy}{dx}\\Big|_{(8,1)}=-\\frac{1}{2}","بالتعويض"]],"a":"الميل <span class=\"tx\" data-t=\"=-\\frac{1}{2}\"></span>","o":""}],[{"n":"19","s":[["2x+y+x\\frac{dy}{dx}+2y\\frac{dy}{dx}=0","الاشتقاق الضمني"],["\\frac{dy}{dx}=-\\frac{2x+y}{x+2y}",""],["m=-\\frac{-8+3}{-4+6}=\\frac{5}{2}","بالتعويض <span class=m dir=ltr>(−4, 3)</span>"],["y-3=\\frac52(x+4)","معادلة المستقيم بصيغة الميل ونقطة"],["y=\\frac52x+13",""]],"a":"<span class=\"tx\" data-t=\"y=\\frac{5}{2}x+13\"></span>","o":"","k":[{"e":"5*x/2 + 13","a":null}]},{"n":"20","s":[["1+\\frac{dy}{dx}=\\frac{2x+2y\\frac{dy}{dx}}{x^2+y^2}","مشتقة <span class=m dir=ltr>ln</span> مع قاعدة السلسلة"],["1+\\frac{dy}{dx}=\\frac{2+0}{1}=2\\Rightarrow\\frac{dy}{dx}=1","بالتعويض <span class=m dir=ltr>(1, 0)</span>"],["y-0=1(x-1)",""],["y=x-1",""]],"a":"<span class=\"tx\" data-t=\"y=x-1\"></span>","o":"","k":[{"e":"x - 1","a":null}]}],[{"n":"21","s":[["1+\\frac{dy}{dx}=\\cos y\\frac{dy}{dx}\\Rightarrow\\frac{dy}{dx}=\\frac{1}{\\cos y-1}","الاشتقاق الضمني"],["\\frac{d^2y}{dx^2}=\\frac{-(-\\sin y)\\frac{dy}{dx}}{(\\cos y-1)^2}","مشتقة القسمة"],["\\frac{d^2y}{dx^2}=\\frac{\\sin y}{(\\cos y-1)^3}","بتعويض <span class=m dir=ltr>dy/dx</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=\\frac{\\sin y}{(\\cos y-1)^3}\"></span>","o":""},{"n":"22","s":[["12y^2\\frac{dy}{dx}=12x\\Rightarrow\\frac{dy}{dx}=\\frac{x}{y^2}","الاشتقاق الضمني"],["\\frac{d^2y}{dx^2}=\\frac{y^2-x\\cdot 2y\\frac{dy}{dx}}{y^4}","مشتقة القسمة"],["=\\frac{y^2-\\frac{2x^2}{y}}{y^4}=\\frac{y^3-2x^2}{y^5}","بتعويض <span class=m dir=ltr>dy/dx</span>"],["=\\frac{1-2x^2}{4y^5}","باستعمال <span class=m dir=ltr>y^3 = (6x^2+1)/4</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=\\frac{y^3-2x^2}{y^5}=\\frac{1-2x^2}{4y^5}\"></span>","o":"","k":[{"e":"(1 - 2*x^2)/(4*y^5)","a":null}]},{"n":"23","s":[["y+x\\frac{dy}{dx}+e^y\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=\\frac{-y}{x+e^y}","الاشتقاق الضمني"],["\\frac{d^2y}{dx^2}=-\\frac{\\frac{dy}{dx}(x+e^y)-y\\left(1+e^y\\frac{dy}{dx}\\right)}{(x+e^y)^2}","مشتقة القسمة"],["=-\\frac{-y-y+\\frac{y^2e^y}{x+e^y}}{(x+e^y)^2}","بتعويض <span class=m dir=ltr>dy/dx</span>"],["=\\frac{2y(x+e^y)-y^2e^y}{(x+e^y)^3}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=\\frac{2y(x+e^y)-y^2e^y}{(x+e^y)^3}\"></span>","o":""}],[{"n":"24","s":[["1+y^2=-3y+19\\Rightarrow y^2+3y-18=0\\Rightarrow y=3\\ \\text{or}\\ y=-6","بالتعويض <span class=m dir=ltr>x = −1</span>"],["2x+2yy'=3y+3xy'\\Rightarrow y'=\\frac{3y-2x}{2y-3x}","الاشتقاق الضمني"],["2+2(y')^2+2yy''=6y'+3xy''\\Rightarrow y''=\\frac{6y'-2-2(y')^2}{2y-3x}","باشتقاق المعادلة مرة ثانية"],["(-1,3):\\ y'=\\frac{11}{9},\\ y''=\\frac{\\frac{594-162-242}{81}}{9}=\\frac{190}{729}",""],["(-1,-6):\\ y'=\\frac{16}{9},\\ y''=\\frac{\\frac{864-162-512}{81}}{-9}=-\\frac{190}{729}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=\\frac{190}{729}\"></span> عند <span class=\"tx\" data-t=\"(-1,3)\"></span> ، و <span class=\"tx\" data-t=\"-\\frac{190}{729}\"></span> عند <span class=\"tx\" data-t=\"(-1,-6)\"></span>","o":""}],[{"n":"25","s":[["(y+4)+(x-6)\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=-\\frac{y+4}{x-6}","مشتقة الضرب"],["m_{\\text{tangent}}=-\\frac{2}{1}=-2","بالتعويض <span class=m dir=ltr>(7, −2)</span>"],["m_{\\text{normal}}=\\frac{1}{2}","ميل العمودي <span class=m dir=ltr>=</span> سالب مقلوب ميل المماس"],["y+2=\\frac12(x-7)\\Rightarrow y=\\frac12x-\\frac{11}{2}",""]],"a":"معادلة العمودي: <span class=\"tx\" data-t=\"y=\\frac{1}{2}x-\\frac{11}{2}\"></span>","o":"","k":[{"e":"x/2 - 11/2","a":null}]}],[{"n":"26","s":[["6x+2y+2x\\frac{dy}{dx}+2y\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=-\\frac{3x+y}{x+y}","الاشتقاق الضمني"],["3x+y=0\\Rightarrow y=-3x","المماس أفقي عندما <span class=m dir=ltr>dy/dx = 0</span>"],["3x^2+2x(-3x)+9x^2=6\\Rightarrow 6x^2=6\\Rightarrow x=\\pm1","بالتعويض في معادلة المنحنى"],["(1,-3),\\ (-1,3)","والمقام <span class=m dir=ltr>x + y =</span> ∓<span class=m dir=ltr>2 ≠ 0</span>"]],"a":"يوجد مماسان أفقيان عند النقطتين <span class=\"tx\" data-t=\"(1,-3)\"></span> و <span class=\"tx\" data-t=\"(-1,3)\"></span>","o":""}],[{"n":"27","s":[["1+2y\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=-\\frac{1}{2y}","الاشتقاق الضمني"],["x+2y=0\\Rightarrow y=-\\frac12x,\\ m=-\\frac12","ميل المستقيم"],["-\\frac{1}{2y}=-\\frac12\\Rightarrow y=1","المستقيمان المتوازيان ميلاهما متساويان"],["x=1-1^2=0","بالتعويض في معادلة المنحنى"]],"a":"النقطة <span class=\"tx\" data-t=\"(0,1)\"></span>","o":"","k":[{"p":["0","1"]}]}],[{"n":"28","s":[["3y^2\\frac{dy}{dx}=2x\\Rightarrow\\frac{dy}{dx}=\\frac{2x}{3y^2}","الاشتقاق الضمني"],["y=-3x+5\\Rightarrow m=-3,\\ m_{\\perp}=\\frac13","ميل المستقيم العمودي عليه"],["\\frac{2x}{3y^2}=\\frac13\\Rightarrow x=\\frac{y^2}{2}",""],["y^3=\\frac{y^4}{4}\\Rightarrow y=4\\ (y\\ne0)","بالتعويض في <span class=m dir=ltr>y^3 = x^2</span>"],["x=\\frac{16}{2}=8",""]],"a":"النقطة <span class=\"tx\" data-t=\"(8,4)\"></span>","o":"","k":[{"p":["8","4"]}]}],[{"n":"29","s":[["2x+2yy'=0\\Rightarrow y'=-\\frac{x}{y}","الاشتقاق الضمني"],["y''=-\\frac{y-xy'}{y^2}=-\\frac{y+\\frac{x^2}{y}}{y^2}","مشتقة القسمة وتعويض <span class=m dir=ltr>y&#x27;</span>"],["y''=-\\frac{x^2+y^2}{y^3}=-\\frac{25}{y^3}","بالتعويض <span class=m dir=ltr>x^2 + y^2 = 25</span>"]],"a":"<span class=\"tx\" data-t=\"y&#x27;&#x27;=-\\frac{25}{y^3}\"></span> (تم الإثبات)","o":""}],[{"n":"30","s":[["\\frac{x+y}{\\sqrt{xy}}=10\\Rightarrow x+y=10\\sqrt{xy}","بتوحيد المقامات"],["x^2+2xy+y^2=100xy\\Rightarrow x^2-98xy+y^2=0","بتربيع الطرفين"],["2x-98y-98x\\frac{dy}{dx}+2y\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=\\frac{49y-x}{y-49x}","الاشتقاق الضمني"],["\\frac{49y-x}{y-49x}=\\frac{y}{x}\\iff 49xy-x^2=y^2-49xy\\iff x^2-98xy+y^2=0","وهذه هي معادلة المنحنى، إذن المساواة صحيحة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{y}{x}\"></span> (تم الإثبات)","o":""}],[{"n":"31","s":[["\\frac{dy}{dx}=-\\frac{x}{y}=\\frac34\\Rightarrow x=-\\frac34y","الاشتقاق الضمني"],["\\frac{9}{16}y^2+y^2=100\\Rightarrow y^2=64\\Rightarrow y=\\pm8","بالتعويض في معادلة الدائرة"],["y=8\\Rightarrow x=-6,\\quad y=-8\\Rightarrow x=6",""]],"a":"النقطتان <span class=\"tx\" data-t=\"(-6,8)\"></span> و <span class=\"tx\" data-t=\"(6,-8)\"></span>","o":"","k":[{"p":["-6","8"]},{"p":["6","-8"]}]}],[{"n":"32","s":[["e^y=x","بالصورة الأسية"],["e^y\\frac{dy}{dx}=1","باشتقاق الطرفين ضمنيًا"],["\\frac{dy}{dx}=\\frac{1}{e^y}=\\frac{1}{x}","بالتعويض <span class=m dir=ltr>e^y = x</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{1}{x}\"></span> (تم الإثبات)","o":""}],[{"n":"33","s":[["\\frac{dy}{dx}=\\frac{-\\sin t}{\\cos t}=-\\tan t",""],["\\frac{d^2y}{dx^2}=\\frac{\\frac{d}{dt}(-\\tan t)}{dx/dt}=\\frac{-\\sec^2t}{\\cos t}=-\\sec^3t",""],["t=\\frac{\\pi}{4}:\\ -(\\sqrt2)^3=-2\\sqrt2",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=-2\\sqrt{2}\"></span>","o":""},{"n":"34","s":[["\\frac{dy}{dx}=\\frac{3t^2+1}{-e^{-t}}=-(3t^2+1)e^{t}",""],["\\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)=-e^t(3t^2+6t+1)","مشتقة الضرب"],["\\frac{d^2y}{dx^2}=\\frac{-e^t(3t^2+6t+1)}{-e^{-t}}=e^{2t}(3t^2+6t+1)",""],["t=0:\\ \\frac{d^2y}{dx^2}=1",""]],"a":"<span class=\"tx\" data-t=\"\\frac{d^2y}{dx^2}=1\"></span>","o":""}],[{"n":"35","s":[["2x^3=6x^2\\Rightarrow x=3","بالتعويض <span class=m dir=ltr>y = x (x ≠ 0</span> في الربع الأول)"],["3x^2+3y^2y'=6y+6xy'\\Rightarrow y'=\\frac{2y-x^2}{y^2-2x}","الاشتقاق الضمني"],["y'\\big|_{(3,3)}=\\frac{6-9}{9-6}=-1",""],["y-3=-(x-3)\\Rightarrow y=-x+6",""]],"a":"<span class=\"tx\" data-t=\"y=-x+6\"></span>","o":"","k":[{"e":"6 - x","a":null}]},{"n":"36","s":[["2y-x^2=0\\Rightarrow y=\\frac{x^2}{2}","المماس أفقي عندما البسط صفر"],["x^3+\\frac{x^6}{8}=3x^3\\Rightarrow x^3=16","بالتعويض في معادلة المنحنى"],["x=\\sqrt[3]{16}=2\\sqrt[3]{2}\\approx2.52",""],["y=\\frac{x^2}{2}=2\\sqrt[3]{4}\\approx3.17","والمقام <span class=m dir=ltr>y^2 − 2x ≠ 0</span>"]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(2\\sqrt[3]{2},\\,2\\sqrt[3]{4}\\right)\\approx(2.52,\\,3.17)\"></span>","o":"","k":[{"p":["2.52","3.17"]}]}],[{"n":"37","s":[["m_l=\\tan\\frac{3\\pi}{4}=-1","المستقيم يميل بزاوية <span class=m dir=ltr>π/4</span> مع المحور <span class=m dir=ltr>x</span> وهو متناقص"],["\\frac{dy}{dx}=-\\frac{x}{y}=-1\\Rightarrow y=x","الاشتقاق الضمني"],["2x^2=2\\Rightarrow x=1,\\ y=1","نقطة التماس في الربع الأول"],["y-1=-(x-1)\\Rightarrow y=-x+2",""]],"a":"<span class=\"tx\" data-t=\"l:\\ y=-x+2\"></span>","o":""}],[{"n":"38","s":[["2x-2y\\frac{dy}{dx}=0","الاشتقاق الضمني"],["\\frac{dy}{dx}=\\frac{x}{y}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{x}{y}\"></span>","o":"","k":[{"e":"x/y","a":null}]},{"n":"39","s":[["\\frac{dx}{dt}=\\sec t\\tan t,\\ \\frac{dy}{dt}=\\sec^2t",""],["\\frac{dy}{dx}=\\frac{\\sec^2t}{\\sec t\\tan t}=\\frac{\\sec t}{\\tan t}",""],["=\\frac{1/\\cos t}{\\sin t/\\cos t}=\\frac{1}{\\sin t}=\\csc t",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\csc t\"></span>","o":""},{"n":"40","s":[["\\frac{x}{y}=\\frac{\\sec t}{\\tan t}","بالتعويض <span class=m dir=ltr>x = sec t , y = tan t</span>"],["=\\frac{1}{\\sin t}=\\csc t",""]],"a":"المقداران متكافئان؛ لأنَّ <span class=\"tx\" data-t=\"\\frac{x}{y}\"></span> يساوي <span class=\"tx\" data-t=\"\\csc t\"></span> عند التعويض بالمعادلة الوسيطية، فهما يمثِّلان ميل المماس نفسه عند النقطة نفسها","o":""},{"n":"41","s":[["\\frac{x}{y}=2\\Rightarrow x=2y",""],["4y^2-y^2=1\\Rightarrow y=\\pm\\frac{1}{\\sqrt3}","بالتعويض في معادلة العلاقة"],["x=\\pm\\frac{2}{\\sqrt3}",""]],"a":"النقطتان <span class=\"tx\" data-t=\"\\left(\\frac{2\\sqrt3}{3},\\frac{\\sqrt3}{3}\\right)\"></span> و <span class=\"tx\" data-t=\"\\left(-\\frac{2\\sqrt3}{3},-\\frac{\\sqrt3}{3}\\right)\"></span>","o":"الفرع الذي تمثله المعادلة الوسيطية <span class=m dir=ltr>(x &gt; 0)</span> يحوي النقطة الأولى فقط","k":[{"p":["2*sqrt(3)/3","sqrt(3)/3"]},{"p":["-2*sqrt(3)/3","-sqrt(3)/3"]}]}],[{"n":"42","s":[["\\frac{1}{2\\sqrt x}+\\frac{1}{2\\sqrt y}\\frac{dy}{dx}=0\\Rightarrow\\frac{dy}{dx}=-\\frac{\\sqrt y}{\\sqrt x}","الاشتقاق الضمني"],["y-b=-\\frac{\\sqrt b}{\\sqrt a}(x-a)","مماس عند نقطة <span class=m dir=ltr>(a, b)</span> على المنحنى"],["y=0\\Rightarrow x=a+\\sqrt a\\sqrt b","المقطع <span class=m dir=ltr>x</span>"],["x=0\\Rightarrow y=b+\\sqrt a\\sqrt b","المقطع <span class=m dir=ltr>y</span>"],["a+b+2\\sqrt{ab}=(\\sqrt a+\\sqrt b)^2=(\\sqrt k)^2=k","بالجمع وباستعمال <span class=m dir=ltr>√a + √b = √k</span>"]],"a":"مجموع المقطعين يساوي <span class=\"tx\" data-t=\"k\"></span> (تم الإثبات)","o":""}],[{"n":"5","s":[["2y\\frac{dy}{dx}-2x=0\\Rightarrow\\frac{dy}{dx}=\\frac{x}{y}","الاشتقاق الضمني"],["\\frac{dy}{dx}\\Big|_{(1,\\sqrt2)}=\\frac{1}{\\sqrt2}",""]],"a":"<span class=m dir=ltr>c)</span> <span class=\"tx\" data-t=\"\\frac{1}{\\sqrt{2}}\"></span>","o":"","k":[{"e":"sqrt(2)/2","a":null}]}],[{"n":"29","s":[["x^2+xy=2y^2",""],["2x+y+x\\frac{dy}{dx}=4y\\frac{dy}{dx}","الاشتقاق الضمني"],["\\frac{dy}{dx}=\\frac{2x+y}{4y-x}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{2x+y}{4y-x}\"></span>","o":"","k":[{"e":"(2*x + y)/(-x + 4*y)","a":null}]},{"n":"30","s":[["x^3-xy=2y","بضرب الطرفين في المقام"],["3x^2-y-x\\frac{dy}{dx}=2\\frac{dy}{dx}","الاشتقاق الضمني"],["\\frac{dy}{dx}=\\frac{3x^2-y}{x+2}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{3x^2-y}{x+2}\"></span>","o":"","k":[{"e":"(3*x^2 - y)/(x + 2)","a":null}]},{"n":"31","s":[["\\frac{dy}{dx}\\cos x-y\\sin x=2x+2y\\frac{dy}{dx}","مشتقة الضرب"],["\\frac{dy}{dx}(\\cos x-2y)=2x+y\\sin x",""],["\\frac{dy}{dx}=\\frac{2x+y\\sin x}{\\cos x-2y}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{2x+y\\sin x}{\\cos x-2y}\"></span>","o":"","k":[{"e":"(2*x + y*sin(x))/(-2*y + cos(x))","a":null}]},{"n":"32","s":[["2e^y+2xe^y\\frac{dy}{dx}+e^x\\frac{dy}{dx}+ye^x=0","مشتقة الضرب"],["\\frac{dy}{dx}=-\\frac{2e^y+ye^x}{2xe^y+e^x}",""]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{2e^y+ye^x}{2xe^y+e^x}\"></span>","o":"","k":[{"e":"-(e^x*y + 2*e^y)/(2*e^y*x + exp(x))","a":null}]}],[{"n":"33","s":[["y^2(2-x)=x^3","بضرب الطرفين في المقام"],["2y\\frac{dy}{dx}(2-x)-y^2=3x^2","الاشتقاق الضمني"],["2(-1)\\frac{dy}{dx}(1)-1=3\\Rightarrow\\frac{dy}{dx}=-2","بالتعويض <span class=m dir=ltr>(1, −1)</span>"],["m_{\\text{normal}}=\\frac12",""],["y+1=\\frac12(x-1)\\Rightarrow y=\\frac12x-\\frac32",""]],"a":"معادلة العمودي: <span class=\"tx\" data-t=\"y=\\frac{1}{2}x-\\frac{3}{2}\"></span>","o":"","k":[{"e":"x/2 - 3/2","a":null}]}],[{"n":"34","s":[["2x+3y+3x\\frac{dy}{dx}+2y\\frac{dy}{dx}=1+3\\frac{dy}{dx}","باشتقاق الطرفين ضمنيًّا بالنسبة إلى <span class=m dir=ltr>x (</span>قاعدة الضرب للحد <span class=m dir=ltr>3xy)</span>"],["4-3+6\\frac{dy}{dx}-2\\frac{dy}{dx}=1+3\\frac{dy}{dx}","بالتعويض <span class=m dir=ltr>x = 2, y = −1</span>"],["1+4\\frac{dy}{dx}=1+3\\frac{dy}{dx}\\Rightarrow \\frac{dy}{dx}=0","بالتبسيط وحلّ المعادلة"],["y-(-1)=0(x-2)","معادلة المماس بصيغة الميل ونقطة"]],"a":"معادلة المماس: <span class=\"tx\" data-t=\"y=-1\"></span> (مماس أفقي)","o":"","k":[{"e":"-1","a":null}]},{"n":"35","s":[["2xe^{y}+x^{2}e^{y}\\frac{dy}{dx}=0","باشتقاق الطرفين ضمنيًّا (قاعدة الضرب)"],["\\frac{dy}{dx}=\\frac{-2xe^{y}}{x^{2}e^{y}}=-\\frac{2}{x}","بحلّ المعادلة لـ <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}\\Big|_{(1,0)}=-2","بالتعويض <span class=m dir=ltr>x = 1</span>"],["y-0=-2(x-1)\\Rightarrow y=-2x+2","معادلة المماس"]],"a":"معادلة المماس: <span class=\"tx\" data-t=\"y=-2x+2\"></span>","o":"","k":[{"e":"2 - 2*x","a":null}]}],[{"n":"1","s":[["3x^{2}y^{3}+x^{3}\\cdot 3y^{2}\\frac{dy}{dx}=0","باشتقاق الطرفين ضمنيًّا (مشتقة الضرب)"],["\\frac{dy}{dx}=\\frac{-3x^{2}y^{3}}{3x^{3}y^{2}}=-\\frac{y}{x}","بحلّ المعادلة لـ <span class=m dir=ltr>dy/dx</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{y}{x}\"></span>","o":"","k":[{"e":"-y/x","a":null}]},{"n":"2","s":[["y+x\\frac{dy}{dx}=\\cos(x+y)\\left(1+\\frac{dy}{dx}\\right)","باشتقاق الطرفين ضمنيًّا"],["x\\frac{dy}{dx}-\\cos(x+y)\\frac{dy}{dx}=\\cos(x+y)-y","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{\\cos(x+y)-y}{x-\\cos(x+y)}","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{\\cos(x+y)-y}{x-\\cos(x+y)}\"></span>","o":"","k":[{"e":"(-y + cos(x + y))/(x - cos(x + y))","a":null}]},{"n":"3","s":[["4y^{3}\\frac{dy}{dx}-2y\\frac{dy}{dx}=10","باشتقاق الطرفين ضمنيًّا"],["\\frac{dy}{dx}=\\frac{10}{4y^{3}-2y}=\\frac{5}{2y^{3}-y}","بالقسمة والتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{5}{2y^{3}-y}\"></span>","o":"","k":[{"e":"5/(2*y^3 - y)","a":null}]},{"n":"4","s":[["\\sin y+x\\cos y\\frac{dy}{dx}-\\left(\\frac{dy}{dx}\\cos x-y\\sin x\\right)=0","مشتقة الضرب لكل حد"],["\\frac{dy}{dx}(x\\cos y-\\cos x)=-\\sin y-y\\sin x","بتجميع حدود <span class=m dir=ltr>dy/dx</span>"],["\\frac{dy}{dx}=\\frac{\\sin y+y\\sin x}{\\cos x-x\\cos y}","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=\\frac{\\sin y+y\\sin x}{\\cos x-x\\cos y}\"></span>","o":"","k":[{"e":"(y*sin(x) + sin(y))/(-x*cos(y) + cos(x))","a":null}]},{"n":"5","s":[["-\\csc^{2}y\\frac{dy}{dx}=1-\\frac{dy}{dx}","باشتقاق الطرفين ضمنيًّا"],["\\frac{dy}{dx}(1-\\csc^{2}y)=1\\Rightarrow \\frac{dy}{dx}(-\\cot^{2}y)=1","المتطابقة <span class=m dir=ltr>1 + cot²y = csc²y</span>"],["\\frac{dy}{dx}=-\\frac{1}{\\cot^{2}y}=-\\tan^{2}y","بالقسمة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\tan^{2}y\"></span>","o":"","k":[{"e":"-tan(y)^2","a":null}]},{"n":"6","s":[["\\frac{y+x\\frac{dy}{dx}}{2\\sqrt{xy}}+1+2y\\frac{dy}{dx}=0","قاعدة السلسلة ومشتقة الضرب"],["y+x\\frac{dy}{dx}+2\\sqrt{xy}+4y\\sqrt{xy}\\frac{dy}{dx}=0","بضرب الطرفين في <span class=m dir=ltr>2√(xy)</span>"],["\\frac{dy}{dx}=-\\frac{y+2\\sqrt{xy}}{x+4y\\sqrt{xy}}","بتجميع حدود <span class=m dir=ltr>dy/dx</span> والقسمة"]],"a":"<span class=\"tx\" data-t=\"\\frac{dy}{dx}=-\\frac{y+2\\sqrt{xy}}{x+4y\\sqrt{xy}}\"></span>","o":""}],[{"n":"7","s":[["2x+3y+3x\\frac{dy}{dx}+2y\\frac{dy}{dx}=1+3\\frac{dy}{dx}","باشتقاق الطرفين ضمنيًّا"],["4-3+6\\frac{dy}{dx}-2\\frac{dy}{dx}=1+3\\frac{dy}{dx}\\Rightarrow \\frac{dy}{dx}=0","بالتعويض <span class=m dir=ltr>(2, −1)</span>"],["y-(-1)=0(x-2)","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=-1\"></span>","o":"","k":[{"e":"-1","a":null}]},{"n":"8","s":[["e^{y}+xe^{y}\\frac{dy}{dx}+\\frac{dy}{dx}\\ln x+\\frac{y}{x}=0","باشتقاق الطرفين ضمنيًّا (مشتقة الضرب)"],["2+2\\frac{dy}{dx}+0+\\ln 2=0","بالتعويض <span class=m dir=ltr>x = 1, y = ln 2 (e^{ln 2} = 2)</span>"],["\\frac{dy}{dx}=-\\frac{2+\\ln 2}{2}\\approx -1.35","بالحل"],["y-\\ln 2=-\\frac{2+\\ln 2}{2}(x-1)","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y-\\ln 2=-\\frac{2+\\ln 2}{2}(x-1)\"></span> أي <span class=\"tx\" data-t=\"y=-\\frac{2+\\ln 2}{2}x+1+\\frac{3}{2}\\ln 2\"></span>","o":"","k":[{"q":"y - (-1 - log(2)/2)*(x - 1) - log(2)"},{"e":"x*(-1 - log(2)/2) + 1 + 3*log(2)/2","a":null}]},{"n":"9","s":[["4y+4x\\frac{dy}{dx}=0\\Rightarrow \\frac{dy}{dx}=-\\frac{y}{x}","باشتقاق الطرفين ضمنيًّا"],["\\frac{dy}{dx}\\Big|_{(1,\\frac{9}{4})}=-\\frac{9}{4}","بالتعويض"],["y-\\frac{9}{4}=-\\frac{9}{4}(x-1)\\Rightarrow y=-\\frac{9}{4}x+\\frac{9}{2}","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=-\\frac{9}{4}x+\\frac{9}{2}\"></span>","o":"","k":[{"e":"9/2 - 9*x/4","a":null}]},{"n":"10","s":[["x+\\frac{y}{4}\\frac{dy}{dx}=0\\Rightarrow \\frac{dy}{dx}=-\\frac{4x}{y}","باشتقاق الطرفين ضمنيًّا"],["\\frac{dy}{dx}\\Big|_{(1,2)}=-\\frac{4}{2}=-2","بالتعويض"],["y-2=-2(x-1)\\Rightarrow y=-2x+4","معادلة المماس"]],"a":"<span class=\"tx\" data-t=\"y=-2x+4\"></span>","o":"","k":[{"e":"4 - 2*x","a":null}]}],[{"n":"11","s":[["2xy+x^{2}\\frac{dy}{dx}-4=0\\Rightarrow \\frac{dy}{dx}=\\frac{4-2xy}{x^{2}}","باشتقاق الطرفين ضمنيًّا"],["y=\\frac{5+4x}{x^{2}}\\Rightarrow \\frac{dy}{dx}=\\frac{4-\\frac{2(5+4x)}{x}}{x^{2}}=-\\frac{4x+10}{x^{3}}","بتعويض <span class=m dir=ltr>y</span> من العلاقة"],["\\frac{dy}{dx}=-4x^{-2}-10x^{-3}","بالتوزيع"],["\\frac{d^{2}y}{dx^{2}}=8x^{-3}+30x^{-4}=\\frac{8x+30}{x^{4}}","بالاشتقاق مرة ثانية"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^{2}y}{dx^{2}}=\\frac{8x+30}{x^{4}}\"></span>","o":""},{"n":"12","s":[["2x+2y\\frac{dy}{dx}=0\\Rightarrow \\frac{dy}{dx}=-\\frac{x}{y}","باشتقاق الطرفين ضمنيًّا"],["\\frac{d^{2}y}{dx^{2}}=-\\frac{y\\cdot 1-x\\frac{dy}{dx}}{y^{2}}=-\\frac{y+\\frac{x^{2}}{y}}{y^{2}}","مشتقة القسمة وتعويض <span class=m dir=ltr>dy/dx</span>"],["\\frac{d^{2}y}{dx^{2}}=-\\frac{x^{2}+y^{2}}{y^{3}}=-\\frac{8}{y^{3}}","<span class=m dir=ltr>x² + y² = 8</span>"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^{2}y}{dx^{2}}=-\\frac{8}{y^{3}}\"></span>","o":""},{"n":"13","s":[["2y\\frac{dy}{dx}=3x^{2}\\Rightarrow \\frac{dy}{dx}=\\frac{3x^{2}}{2y}","باشتقاق الطرفين ضمنيًّا"],["\\frac{d^{2}y}{dx^{2}}=\\frac{6x\\cdot 2y-3x^{2}\\cdot 2\\frac{dy}{dx}}{4y^{2}}=\\frac{12xy-\\frac{9x^{4}}{y}}{4y^{2}}","مشتقة القسمة وتعويض <span class=m dir=ltr>dy/dx</span>"],["=\\frac{12xy^{2}-9x^{4}}{4y^{3}}=\\frac{12x^{4}-9x^{4}}{4y^{3}}","<span class=m dir=ltr>y² = x³</span>"],["\\frac{d^{2}y}{dx^{2}}=\\frac{3x^{4}}{4y^{3}}","بالتبسيط"]],"a":"<span class=\"tx\" data-t=\"\\frac{d^{2}y}{dx^{2}}=\\frac{3x^{4}}{4y^{3}}\"></span>","o":""}],[{"n":"14","s":[["3(x+y)^{2}\\left(1+\\frac{dy}{dx}\\right)=2x+\\frac{dy}{dx}","باشتقاق الطرفين ضمنيًّا (قاعدة السلسلة)"],["3(1)^{2}\\left(1+\\frac{dy}{dx}\\right)=2+\\frac{dy}{dx}","بالتعويض <span class=m dir=ltr>(1, 0)</span>"],["3+3\\frac{dy}{dx}=2+\\frac{dy}{dx}\\Rightarrow \\frac{dy}{dx}=-\\frac{1}{2}","ميل المماس"],["m_{\\perp}=2","ميل العمودي <span class=m dir=ltr>=</span> سالب مقلوب ميل المماس"],["y-0=2(x-1)\\Rightarrow y=2x-2","معادلة العمودي"]],"a":"معادلة العمودي على المماس: <span class=\"tx\" data-t=\"y=2x-2\"></span>","o":"","k":[{"e":"2*x - 2","a":null}]}],[{"n":"15","s":[["\\frac{x}{2}+\\frac{2y}{9}\\frac{dy}{dx}=0\\Rightarrow \\frac{dy}{dx}=-\\frac{9x}{4y}","باشتقاق الطرفين ضمنيًّا"],["-\\frac{9x}{4y}=-0.5\\Rightarrow y=\\frac{9}{2}x","الميل يساوي <span class=m dir=ltr>−0.5</span>"],["\\frac{x^{2}}{4}+\\frac{81x^{2}}{36}=1\\Rightarrow \\frac{5}{2}x^{2}=1","بالتعويض في العلاقة"],["x=\\sqrt{\\frac{2}{5}}=\\frac{\\sqrt{10}}{5}\\approx 0.632,\\quad y=\\frac{9\\sqrt{10}}{10}\\approx 2.846","<span class=m dir=ltr>x &gt; 0</span> في الربع الأول"]],"a":"النقطة <span class=\"tx\" data-t=\"\\left(\\frac{\\sqrt{10}}{5},\\ \\frac{9\\sqrt{10}}{10}\\right)\\approx(0.632,\\ 2.846)\"></span>","o":"","k":[{"p":["0.632","2.846"]}]}],[{"n":"16","s":[["y=0\\Rightarrow x^{2}=7\\Rightarrow x=\\pm\\sqrt{7}","نقطتا التقاطع مع المحور <span class=m dir=ltr>x</span>: <span class=m dir=ltr>(√7, 0)</span> و <span class=m dir=ltr>(−√7, 0)</span>"],["2x+y+x\\frac{dy}{dx}+2y\\frac{dy}{dx}=0\\Rightarrow \\frac{dy}{dx}=-\\frac{2x+y}{x+2y}","باشتقاق الطرفين ضمنيًّا"],["\\frac{dy}{dx}\\Big|_{(\\sqrt{7},0)}=-\\frac{2\\sqrt{7}}{\\sqrt{7}}=-2","بالتعويض"],["\\frac{dy}{dx}\\Big|_{(-\\sqrt{7},0)}=-\\frac{-2\\sqrt{7}}{-\\sqrt{7}}=-2","بالتعويض"]],"a":"نقطتا التقاطع <span class=\"tx\" data-t=\"(\\sqrt{7},0)\"></span> و <span class=\"tx\" data-t=\"(-\\sqrt{7},0)\"></span>، وميل المماس عند كلٍّ منهما <span class=\"tx\" data-t=\"-2\"></span>، إذن المماسان متوازيان","o":""}]]